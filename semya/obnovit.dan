/// Обновление и проверка семени - готового кода C компилятора на Дане (semya/dan.c).
///
/// Запускается из корня репозитория уже собранным компилятором на Дане, Python не нужен:
///
///     semya/dan запустить semya/obnovit.dan                  - записать новое семя
///     semya/dan запустить semya/obnovit.dan --проверить      - только сверить, код 1 при расхождении
///     semya/dan запустить semya/obnovit.dan --проверить сам/дан
///                                                            - сверить код C, который даёт другой компилятор
///
/// Код C берётся командой «си сам/дан.dan» указанного компилятора (по умолчанию semya/dan).

функ windows() -> лог {
    пусть ос = переменная_среды("OS") иначе ""
    вернуть ос == "Windows_NT"
}

/// Команда для оболочки: cmd.exe снимает внешние кавычки, поэтому в Windows - ещё одни.
функ команда_си(компилятор: стр) -> стр {
    перем путь = компилятор
    если windows() {
        путь = путь.заменить("/", "\\")
        если не путь.оканчивается(".exe") { путь += ".exe" }
        вернуть "\"\"" + путь + "\" си \"сам\\дан.dan\"\""
    }
    если не путь.начинается("/") { путь = "./" + путь }
    вернуть "\"" + путь + "\" си \"сам/дан.dan\""
}

/// Первая строка, в которой тексты различаются (с единицы), или 0, если они одинаковы.
общий функ первое_различие(а: стр, б: стр) -> цел {
    если а == б { вернуть 0 }
    пусть строки_а = а.разбить("\n")
    пусть строки_б = б.разбить("\n")
    перем н = 0
    пока н < строки_а.длина и н < строки_б.длина и строки_а[н] == строки_б[н] { н += 1 }
    вернуть н + 1
}

функ главная(аргументы_: [стр]) -> цел {
    перем проверить = ложь
    перем компилятор = "semya/dan"
    для а в аргументы_ {
        если а == "--проверить" { проверить = истина } иначе { компилятор = а }
    }
    перем путь = "semya/dan.c"
    если windows() { путь = "semya\\dan.c" }
    перем новое = ""
    если пусть код = вывод_команды(команда_си(компилятор)) {
        новое = код + "\n"
    } иначе ошибка о {
        вывод("Не удалось получить код C компилятора: " + о)
        вернуть 2
    }
    если не проверить {
        записать(путь, новое)
        вывод("Семя обновлено: " + путь + " (" + стр(размер_файла(путь)) + " байт)")
        вернуть 0
    }
    перем старое = ""
    если существует(путь) { старое = прочитать(путь).заменить("\r\n", "\n") }
    пусть строка = первое_различие(старое, новое)
    если строка == 0 {
        вывод("Семя совпадает с кодом C, который даёт " + компилятор)
        вернуть 0
    }
    вывод("Семя устарело: " + путь + " расходится с кодом C от " + компилятор + " начиная со строки "
        + стр(строка) + ". Обновите его: semya/dan запустить semya/obnovit.dan")
    вернуть 1
}

тест "первое различие" {
    утвердить_равно(первое_различие("а\nб\n", "а\nб\n"), 0)
    утвердить_равно(первое_различие("а\nб\n", "а\nв\n"), 2)
    утвердить_равно(первое_различие("а\n", "а\nб\n"), 2)
}

завершить(главная(аргументы()))
