// Модуль «модели» (Дан 1.6): крошечная модель GGUF загружается через библиотеку llama.cpp.
// Путь к модели - первое значение после имени программы.
подключить "модели"

функ проба(путь: стр) -> ! {
    пусть м = модели.загрузить_с_настройками(путь, модели.Настройки(контекст = 64))!
    пусть ответ = м.ответ("привет", модели.Выборка(температура = 0.0, максимум_токенов = 4))!
    вывод("модель загружена, ответ получен")
    если ответ.длина >= 0 { вывод("готово") }
}

пусть арг = аргументы()
если арг.длина < 1 {
    вывод("нужен путь к модели")
} иначе если ошибка о = проба(арг[0]) {
    вывод("ошибка: " + о)
}
