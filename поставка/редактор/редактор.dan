// Редактор «Дан»: набрать программу, проверить её, запустить и собрать в .exe.
// Входит в поставку для Windows; ярлык передаёт путь к dan.exe:
//     редактор.exe --дан="C:\...\dan.exe" [файл.dan]
подключить "окна"

функ путь_к_дану(арг: [стр]) -> стр {
    для а в арг {
        если а.начинается("--дан=") { вернуть а[6..а.длина - 1] }
    }
    вернуть "dan"
}

функ файл_из_аргументов(арг: [стр]) -> стр {
    для а в арг {
        если не а.начинается("--") { вернуть а }
    }
    вернуть ""
}

функ папка_файла(путь: стр) -> стр {
    перем конец = -1
    для к в 0..путь.длина - 1 {
        если путь[к] == "\\" или путь[к] == "/" { конец = к }
    }
    если конец <= 0 { вернуть "." }
    вернуть путь[0..конец - 1]
}

функ имя_файла(путь: стр) -> стр {
    пусть папка = папка_файла(путь)
    если папка == "." { вернуть путь }
    вернуть путь[папка.длина + 1..путь.длина - 1]
}

// Команда для cmd /c с выводом сообщений об ошибках в тот же поток. Вся строка
// ещё раз берётся в кавычки: cmd снимает крайние кавычки, если их больше двух.
// «exit /b 0»: сообщения нужны и тогда, когда dan сообщил об ошибке.
функ команда(части: [стр]) -> стр {
    перем с = ""
    для ч в части {
        если с != "" { с = с + " " }
        с = с + "\"" + ч + "\""
    }
    вернуть "\"" + с + " 2>&1 & exit /b 0\""
}

функ заголовок_окна(файл: стр, изменён: лог) -> стр {
    перем имя = "без имени"
    если файл != "" { имя = имя_файла(файл) }
    если изменён { имя = имя + " *" }
    вернуть имя + " - Дан"
}

// Путь, под которым сохранить программу: прежний или выбранный человеком; "" - отказ
функ куда_сохранить(файл: стр) -> стр {
    если файл != "" { вернуть файл }
    если пусть п = окна.файл_для_сохранения("Сохранить программу", "Программа Дан (*.dan)|*.dan") {
        если п.оканчивается(".dan") { вернуть п }
        вернуть п + ".dan"
    }
    вернуть ""
}

функ выполнить_dan(дан: стр, действие: стр, файл: стр) -> стр {
    если пусть вывод_ = вывод_команды(команда([дан, действие, файл])) {
        если вывод_.обрезать() == "" { вернуть "Готово." }
        вернуть вывод_
    } иначе ошибка о {
        вернуть "Не удалось запустить dan: " + о
    }
}

пусть арг = аргументы()
пусть дан = путь_к_дану(арг)
пусть папка_дана = папка_файла(дан)
перем файл = файл_из_аргументов(арг)
перем начальный = "// Новая программа на Дане\nвывод(\"Здравствуй, мир!\")\n"
если файл != "" и существует(файл) {
    начальный = прочитать(файл)
}

пусть окно = окна.создать(заголовок_окна(файл, ложь), 960, 680)!
пусть кн_новый = окно.кнопка("Новый", 10, 10, 90, 32)
пусть кн_открыть = окно.кнопка("Открыть", 105, 10, 90, 32)
пусть кн_сохранить = окно.кнопка("Сохранить", 200, 10, 100, 32)
пусть кн_проверить = окно.кнопка("Проверить", 320, 10, 100, 32)
пусть кн_запустить = окно.кнопка("Запустить", 425, 10, 100, 32)
пусть кн_собрать = окно.кнопка("Собрать .exe", 530, 10, 120, 32)
пусть кн_учебник = окно.кнопка("Учебник", 670, 10, 100, 32)
пусть кн_справка = окно.кнопка("Справочник", 775, 10, 110, 32)
пусть текст = окно.многострочное_поле(начальный, 10, 50, 940, 450)
текст.задать_шрифт_кода(16)
пусть итог = окно.многострочное_поле("«Проверить» найдёт ошибки, «Запустить» откроет программу в отдельном окне.", 10, 510, 940, 160)
// моноширинный шрифт: знаки «^» в сообщении об ошибке стоят ровно под местом ошибки
итог.задать_шрифт_кода(14)
перем изменён = ложь

пока пусть событие = окно.ждать() {
    выбор событие {
        окна.Изменение(э) {
            если э == текст и не изменён {
                изменён = истина
                окно.задать_заголовок(заголовок_окна(файл, изменён))
            }
        }
        окна.Размер(ш, выс) {
            текст.переместить(10, 50, ш - 20, выс - 230)
            итог.переместить(10, выс - 170, ш - 20, 160)
        }
        окна.Нажатие(э) {
            если э == кн_новый {
                если не изменён или окна.вопрос("Дан", "Начать новую программу? Несохранённые изменения пропадут.") {
                    файл = ""
                    текст.задать_текст("")
                    изменён = ложь
                }
            } иначе если э == кн_открыть {
                если пусть п = окна.выбрать_файл("Открыть программу", "Программа Дан (*.dan)|*.dan|Все файлы|*.*") {
                    файл = п
                    текст.задать_текст(прочитать(п))
                    изменён = ложь
                }
            } иначе если э == кн_учебник {
                выполнить_команду("start \"\" \"" + папка_дана + "\\учебник\\index.html\"")
            } иначе если э == кн_справка {
                выполнить_команду("start \"\" \"" + папка_дана + "\\справочник.html\"")
            } иначе {
                // сохранить, проверить, запустить, собрать: сначала программа сохраняется
                пусть путь = куда_сохранить(файл)
                если путь != "" {
                    записать(путь, текст.текст())
                    файл = путь
                    изменён = ложь
                    если э == кн_сохранить {
                        итог.задать_текст("Сохранено: " + путь)
                    } иначе если э == кн_проверить {
                        итог.задать_текст(выполнить_dan(дан, "проверить", путь))
                    } иначе если э == кн_собрать {
                        итог.задать_текст(выполнить_dan(дан, "собрать", путь))
                    } иначе если э == кн_запустить {
                        итог.задать_текст("Программа запущена в отдельном окне.")
                        выполнить_команду("start \"" + имя_файла(путь) + "\" cmd /k \"\"" + дан + "\" запустить \"" + путь + "\"\"")
                    }
                }
            }
            окно.задать_заголовок(заголовок_окна(файл, изменён))
        }
        окна.Закрытие {
            если изменён и окна.вопрос("Дан", "Сохранить изменения в программе?") {
                пусть путь = куда_сохранить(файл)
                если путь != "" { записать(путь, текст.текст()) }
            }
        }
        иначе { }
    }
}
