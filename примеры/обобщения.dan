// Обобщённые функции и типы, методы на языке Дан.

функ подсчитать<К: Ключ>(с: [К]) -> {К: цел} {
    перем итог: {К: цел} = {}
    для х в с { итог[х] = итог.получить(х, 0) + 1 }
    вернуть итог
}

функ упорядочить_быстро<Т: Упорядоченное>(с: [Т]) -> [Т] {
    если с.длина <= 1 { вернуть с }
    пусть опорный = с[0]
    перем меньшие: [Т] = []
    перем большие: [Т] = []
    для к в 1..с.длина - 1 {
        если с[к] < опорный { меньшие.добавить(с[к]) } иначе { большие.добавить(с[к]) }
    }
    перем итог = упорядочить_быстро(меньшие)
    итог.добавить(опорный)
    для х в упорядочить_быстро(большие) { итог.добавить(х) }
    вернуть итог
}

функ наименьший_и_наибольший<Т: Упорядоченное>(с: [Т]) -> Пара<Т, Т> {
    пусть у = упорядочить_быстро(с)
    вернуть Пара(у[0], у[у.длина - 1])
}

тип Пара<А, Б> { первое: А, второе: Б }

тип Дерево<Т> {
    Лист
    Узел(значение: Т, левое: Дерево<Т>, правое: Дерево<Т>)
}

функ вставить<Т: Упорядоченное>(д: Дерево<Т>, х: Т) -> Дерево<Т> {
    выбор д {
        Лист { вернуть Узел(х, Лист, Лист) }
        Узел(з, л, п) {
            если х < з { вернуть Узел(з, вставить(л, х), п) }
            вернуть Узел(з, л, вставить(п, х))
        }
    }
}

функ обойти<Т>(д: Дерево<Т>) -> [Т] {
    выбор д {
        Лист { вернуть [] }
        Узел(з, л, п) {
            перем итог = обойти(л)
            итог.добавить(з)
            для х в обойти(п) { итог.добавить(х) }
            вернуть итог
        }
    }
}

тип Коробка<Т> { значение: Т, подпись: стр = "без подписи" }

тип Счёт { сумма: рац }
функ Счёт.с_процентами(ставка: рац) -> Счёт { вернуть Счёт(сам.сумма * (1 + ставка / 100)) }
функ Счёт.показать() -> стр { вернуть сумма_цифрами(сам.сумма) + " руб." }

тип Фигура { Круг(р: дроб)  Квадрат(с: дроб) }
функ Фигура.площадь() -> дроб {
    выбор сам {
        Круг(р) { вернуть 3.0 * р * р }
        Квадрат(с) { вернуть с * с }
    }
}

вывод(подсчитать(["а", "б", "а"]))
вывод(упорядочить_быстро([5, 3, 8, 1, 9, 2]))
вывод(упорядочить_быстро(["в", "а", "б"]))
вывод(наименьший_и_наибольший([4.5, 1.5, 3.0]))
перем д: Дерево<цел> = Лист
для х в [5, 2, 8, 1, 9] { д = вставить(д, х) }
вывод(обойти(д))
вывод(Коробка(5))
вывод(Коробка(подпись = "важное", значение = [1, 2]))
пусть счёт = Счёт(100000)
вывод(счёт.с_процентами(10).с_процентами(10).показать())
пусть фигуры = [Круг(1.0), Квадрат(2.0)]
вывод(фигуры.преобразовать(функ(ф) = ф.площадь()))
вывод(упорядочить_быстро(с = [3, 1, 2]))
пусть варианты: [Дерево<стр>] = [Лист, Узел("а", Лист, Лист)]
вывод(варианты.длина)
пусть смесь = [Узел(1, Лист, Лист), Лист]
вывод(смесь)
