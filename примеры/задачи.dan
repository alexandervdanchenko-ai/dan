// Параллельные задачи и каналы на языке Дан: подсчёт слов в нескольких
// документах одновременно. Тексты вымышлены.

функ слова(текст: стр) -> {стр: цел} {
    перем частоты: {стр: цел} = {}
    для слово в текст.строчные().разбить() {
        частоты[слово] = частоты.получить(слово, 0) + 1
    }
    вернуть частоты
}

функ разобрать(документы: канал<стр>, итоги: канал<{стр: цел}>) {
    для текст в документы {
        итоги.отправить(слова(текст))
    }
}

пусть тексты = [
    "Сумма углов треугольника равна ста восьмидесяти градусам",
    "Площадь квадрата равна квадрату стороны",
    "Сумма двух дробей с равными знаменателями равна дроби",
    "Площадь треугольника равна половине произведения основания на высоту"
]

пусть документы: канал<стр> = канал(2)
пусть итоги: канал<{стр: цел}> = канал(тексты.длина)
параллельно {
    // три задачи разбирают документы, пока канал не закрыт
    для к в 1..3 { запустить разобрать(документы, итоги) }
    для т в тексты { документы.отправить(т) }
    документы.закрыть()
}
итоги.закрыть()

перем всего: {стр: цел} = {}
для частоты в итоги {
    для слово в частоты { всего[слово] = всего.получить(слово, 0) + частоты[слово] }
}
для слово в ["равна", "сумма", "площадь", "треугольника"] {
    вывод(слово + ": " + стр(всего.получить(слово, 0)))
}
