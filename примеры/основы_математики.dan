// Основы математики на языке Дан.

вывод("Разряды")
пусть число = 1645832
вывод("Цифры числа " + стр(число) + ":")
вывод(цифры(число))
вывод("Разложение по разрядам:")
вывод(разряды(число))

вывод("")
вывод("Действия: × и : пишутся как в тетради")
вывод(12 + 5)
вывод(12 − 5)
вывод(12 × 5)
вывод(12 : 5)                // точное частное: 12/5
вывод(смешанное(12 : 5))     // 2 2/5

вывод("")
вывод("Деление с остатком: 227 492 : 331")
пусть делимое = 227492
пусть делитель = 331
пусть неполное = частное(делимое, делитель)
пусть остаток = делимое % делитель
вывод(стр(делимое) + " : " + стр(делитель) + " = " + стр(неполное) + " (" + стр(остаток) + " в остатке)")
вывод("Проверка: " + стр(неполное) + " × " + стр(делитель) + " + " + стр(остаток) + " = "
    + стр(неполное × делитель + остаток))

вывод("")
вывод("Порядок действий: 5 × 2 + (5 − 3) : 2 + 1")
вывод(5 × 2 + (5 − 3) : 2 + 1)

вывод("")
вывод("Законы математики выполняются для любых чисел:")
перем нарушений = 0
для а в 1..20 {
    для б в 1..20 {
        пусть в_ = а + б
        если а + б ≠ б + а { нарушений += 1 }              // переместительный
        если (а + б) + в_ ≠ а + (б + в_) { нарушений += 1 }  // сочетательный
        если (а + б) × в_ ≠ а × в_ + б × в_ { нарушений += 1 } // распределительный
    }
}
вывод("нарушений: " + стр(нарушений))

вывод("")
вывод("Делители, кратные, простые числа")
вывод("Делители 12:")
вывод(делители(12))
вывод("Первые кратные 5:")
вывод(кратные(5, 5))
вывод("180 на простые множители:")
вывод(простые_множители(180))
перем простые: [цел] = []
для ч в 1..50 {
    если простое(ч) { простые.добавить(ч) }
}
вывод("Простые числа до 50:")
вывод(простые)

вывод("")
вывод("Признаки делимости")
пусть н = 846
вывод("Сумма цифр " + стр(н) + " = " + стр(сумма_цифр(н)))
если делится(сумма_цифр(н), 9) {
    вывод(стр(н) + " делится на 9")
}
если чётное(н) {
    вывод(стр(н) + " - чётное число")
}

вывод("")
вывод("НОД и НОК")
вывод("НОД(12, 9) = " + стр(нод(12, 9)))
вывод("НОК(9, 12) = " + стр(нок(9, 12)))
вывод("НОД(18, 24, 36) = " + стр(нод([18, 24, 36])))
вывод("НОК(8, 15, 33) = " + стр(нок([8, 15, 33])))
вывод("Проверка: 36 × 48 = НОД × НОК: " + стр(36 × 48 == нод(36, 48) × нок(36, 48)))
