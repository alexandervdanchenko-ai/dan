// Память освобождается сама: программа создаёт миллионы временных строк,
// но занимает лишь несколько мегабайт.

перем всего_символов = 0
для к в 1..3000000 {
    пусть запись = "Дело № " + стр(к) + " от " + стр(к % 28 + 1) + ".10.2026"
    всего_символов += запись.длина
}
вывод("Обработано записей: 3 000 000, символов: " + стр(всего_символов))

// Длинная цепочка значений тоже освобождается без переполнения стека.
тип Звено { номер: цел, следующее: Звено? }
перем цепочка: Звено? = ничего
для к в 1..1000000 { цепочка = Звено(к, цепочка) }
если пусть первое = цепочка { вывод("Последнее звено: " + стр(первое.номер)) }
цепочка = ничего
вывод("Цепочка освобождена")
