// Дроби, проценты, единицы и статистика на языке Дан.

вывод("Обыкновенные дроби считаются точно")
пусть половина = рац(1, 2)
пусть треть = рац(1, 3)
вывод("1/2 + 1/3 = " + стр(половина + треть))
вывод("1/2 : 1/3 = " + стр(половина / треть) + " = " + смешанное(половина / треть))
вывод("Что больше, 3/7 или 4/9? " + стр(макс(рац(3, 7), рац(4, 9))))

вывод("")
вывод("Десятичные и периодические дроби, округление")
вывод("1/6 = " + периодическая(рац(1, 6)))
вывод("22/7 = " + периодическая(рац(22, 7)))
вывод("2,675 до сотых: " + стр(округлить(2.675, 2)))
вывод("1234 до сотен: " + стр(округлить(1234, -2)))

вывод("")
вывод("Единицы измерения")
вывод("1,5 км = " + стр(перевести(1.5, "км", "м")) + " м")
вывод("90 км/ч = " + стр(перевести(90, "км/ч", "м/с")) + " м/с")
вывод("6 соток = " + стр(перевести(6, "сотка", "м²")) + " м²")

вывод("")
вывод("Пропорции, скорость, время, расстояние")
// 3 кг яблок стоят 270 рублей. Сколько стоят 5 кг?
вывод("5 кг яблок стоят " + стр(пропорция(3, 270, 5)) + " руб.")
пусть путь = 240.0
пусть время = 3.0
вывод("Скорость: " + стр(путь / время) + " км/ч")

вывод("")
вывод("Проценты")
вывод("15% от 2000 = " + стр(процент(2000, 15)))
вывод("300 от 2000 - это " + стр(сколько_процентов(300, 2000)) + "%")
вывод("Если 15% числа равны 300, то число равно " + стр(число_по_проценту(300, 15)))

вывод("")
вывод("Множества")
пусть а = [1, 2, 3, 4]
пусть б = [3, 4, 5]
вывод(объединение(а, б))
вывод(пересечение(а, б))
вывод(разность(а, б))

вывод("")
вывод("Статистика")
пусть оценки = [5, 4, 4, 3, 5, 5, 2, 4]
вывод("Ряд: " + стр(оценки.длина) + " оценок")
вывод(упорядочить(оценки))
вывод("Среднее: " + стр(среднее(оценки)) + ", медиана: " + стр(медиана(оценки))
    + ", мода: " + стр(мода(оценки)) + ", размах: " + стр(размах(оценки)))

вывод("")
вывод("Степени, площади и объёмы")
вывод("2^10 = " + стр(2 ^ 10) + ", (2/3)² = " + стр(рац(2, 3)²))
вывод("Площадь треугольника с основанием 7 и высотой 3: " + стр(площадь_треугольника(7, 3)))
вывод("Объём куба с ребром 4: " + стр(объём_куба(4)))
вывод("Площадь круга радиусом 2: " + стр(округлить(площадь_круга(2), 2)))
