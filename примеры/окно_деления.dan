// Программа с окном: деление без потери точности. Результат показывается
// обыкновенной дробью, смешанным числом и десятичной дробью с периодом.
// Собирается для Windows:
//     python dan.py собрать примеры/окно_деления.dan
подключить "окна"

функ расчёт(делимое_текст: стр, делитель_текст: стр) -> стр! {
    пусть делимое = разобрать_цел(делимое_текст)!
    пусть делитель = разобрать_цел(делитель_текст)!
    если делитель == 0 { вернуть ошибка("на ноль делить нельзя") }
    пусть д = рац(делимое, делитель)
    вернуть "Дробь: " + стр(д) + "\nСмешанное число: " + смешанное(д) + "\nДесятичная запись: " + периодическая(д)
}

пусть окно = окна.создать("Точное деление", 460, 260)!
окно.надпись("Делимое:", 20, 22, 170, 24)
пусть делимое = окно.поле("22", 200, 20, 230, 26)
окно.надпись("Делитель:", 20, 57, 170, 24)
пусть делитель = окно.поле("7", 200, 55, 230, 26)
пусть кнопка = окно.кнопка("Разделить", 200, 95, 140, 32)
пусть итог = окно.надпись("", 20, 140, 420, 90)

пока пусть событие = окно.ждать() {
    выбор событие {
        окна.Нажатие(э) {
            если пусть текст = расчёт(делимое.текст(), делитель.текст()) {
                итог.задать_текст(текст)
            } иначе ошибка о {
                итог.задать_текст("Ошибка: " + о)
            }
        }
        иначе {}
    }
}
