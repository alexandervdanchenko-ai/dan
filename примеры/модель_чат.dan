// Чат с локальной языковой моделью в консоли: ответ выводится по словам, по мере появления.
//
//     dan запустить примеры/модель_чат.dan модель.gguf ["указание для модели"]
//
// Модель - любой файл GGUF (например, небольшая модель с huggingface.co). Нужна библиотека
// llama.cpp: её ставит команда «dan модели установить» (или укажите путь в переменной DAN_LLAMA).
// Пустая строка (или конец ввода) завершает разговор.

подключить "модели"

функ разговор(путь: стр, указание: стр) -> ! {
    пусть м = модели.загрузить(путь)!
    перем история: [модели.Сообщение] = []
    если указание != "" { история.добавить(модели.Сообщение("system", указание)) }
    пусть выборка = модели.Выборка(температура = 0.7, зерно = 1, максимум_токенов = 512)
    пока истина {
        пусть вопрос = ввод("Вы: ")
        если вопрос == "" { прервать }
        история.добавить(модели.Сообщение("user", вопрос))
        модели.напечатать("Модель: ")
        // кэш начала: прошлые сообщения модель не пересчитывает, только новое
        пусть поток = м.начать_чат(история, выборка)!
        перем ответ = ""
        пока истина {
            пусть часть = поток.следующая()!
            если часть == "" { прервать }
            модели.напечатать(часть)
            ответ += часть
        }
        вывод("")
        история.добавить(модели.Сообщение("assistant", ответ))
    }
    м.освободить()
}

пусть арг = аргументы()
если арг.длина == 0 {
    вывод("Укажите файл модели: dan запустить модель_чат.dan модель.gguf")
} иначе {
    перем указание = ""
    если арг.длина > 1 { указание = арг[1] }
    если ошибка о = разговор(арг[0], указание) {
        вывод_ошибки(о)
        завершить(1)
    }
}
