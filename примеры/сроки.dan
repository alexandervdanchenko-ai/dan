// Расчёт сроков: месяц на обжалование и пять рабочих дней на исполнение.
// Окончание срока, приходящееся на нерабочий день, переносится на ближайший
// следующий рабочий день. Переносы выходных по постановлениям Правительства
// РФ задаются словарём: в библиотеке их нет, потому что они меняются каждый год.

тип Календарь { переносы: {дата: лог} }

функ Календарь.рабочий(д: дата) -> лог {
    вернуть сам.переносы.получить(д, рабочий_день(д))
}

функ Календарь.ближайший_рабочий(д: дата) -> дата {
    перем р = д
    пока не сам.рабочий(р) { р += 1 }
    вернуть р
}

функ Календарь.через_рабочие_дни(д: дата, н: цел) -> дата {
    перем р = д
    перем осталось = н
    пока осталось > 0 {
        р += 1
        если сам.рабочий(р) { осталось -= 1 }
    }
    вернуть р
}

// пример переноса: 31.12.2026 объявлен выходным днём
пусть календарь = Календарь({дата(2026, 12, 31): ложь})

пусть даты_решений = ["26.10.2026", "31.03.2026", "26.12.2026", "29.12.2026", "первое мая"]
для запись в даты_решений {
    если пусть решение = разобрать_дату(запись) {
        пусть обжалование = календарь.ближайший_рабочий(добавить_месяцы(решение, 1))
        пусть исполнение = календарь.через_рабочие_дни(решение, 5)
        вывод("решение " + стр(решение) + ": жалоба до " + стр(обжалование)
            + ", исполнить до " + стр(исполнение))
    } иначе ошибка о {
        вывод(о)
    }
}
