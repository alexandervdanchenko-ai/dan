// Пример, в котором собраны все конструкции версии 0.1

функ площадь(ширина: дроб, высота: дроб) -> дроб {
    вернуть ширина * высота
}

функ знак(х: цел) -> стр {
    если х > 0 {
        вернуть "положительное"
    } иначе если х == 0 {
        вернуть "ноль"
    } иначе {
        вернуть "отрицательное"
    }
}

функ приветствие(имя: стр) {
    вывод("Здравствуйте, ")
    вывод(имя)
}

пусть миллион = 1_000_000
перем х: цел = 1
пока х < миллион {
    х *= 2
}
вывод(х)

для ч в 1..20 {
    если ч % 3 == 0 { продолжить }
    если ч > 15 или ч == 7 { прервать }
    вывод(ч)
}

пусть готово = не ложь и истина
вывод(знак(-5))
вывод(площадь(2.5,
    4.0))
приветствие("Дан")
