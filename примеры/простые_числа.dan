// Подсчёт простых чисел до заданной границы перебором делителей
функ простое(н: цел) -> лог {
    если н < 2 { вернуть ложь }
    если н % 2 == 0 { вернуть н == 2 }
    перем д = 3
    пока д * д <= н {
        если н % д == 0 { вернуть ложь }
        д += 2
    }
    вернуть истина
}

пусть граница = 5_000_000
перем количество = 0
для ч в 1..граница {
    если простое(ч) { количество += 1 }
}
вывод("Простых чисел до " + "5 000 000:")
вывод(количество)
