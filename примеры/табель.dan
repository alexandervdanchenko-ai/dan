// Табель учёта рабочего времени на языке Дан: словари.
// Данные вымышлены.

// Отработанные часы по дням: «сотрудник;часы» через запятую
пусть записи = "Иванов;8,Петров;9,Иванов;10,Сидорова;8,Петров;12,Иванов;8,Сидорова;7"

перем часы: {стр: цел} = {}
перем дней: {стр: цел} = {}
для запись в записи.разбить(",") {
    пусть части = запись.разбить(";")
    пусть фио = части[0]
    часы[фио] = часы.получить(фио, 0) + цел(части[1])
    дней[фио] = дней.получить(фио, 0) + 1
}

пусть норма_в_день = 8
вывод("Табель:")
для фио в часы {
    пусть переработка = часы[фио] - дней[фио] * норма_в_день
    перем строка = ("  " + фио + ": " + стр(часы[фио]) + " ч за " + стр(дней[фио]) + " "
                   + склонение(дней[фио], "день", "дня", "дней"))
    если переработка > 0 {
        строка += ", сверхурочно " + стр(переработка) + " ч"
    }
    вывод(строка)
}

// Поиск сотрудника, которого может не быть в табеле
для фио в ["Петров", "Кузнецов"] {
    если пусть ч = часы.найти(фио) {
        вывод(фио + " отработал " + стр(ч) + " ч")
    } иначе {
        вывод(фио + " в табеле не значится")
    }
}

// Словарь - значение: изменение копии не меняет табель
перем черновик = часы
черновик["Иванов"] = 0
вывод("В табеле у Иванова по-прежнему " + стр(часы["Иванов"]) + " ч")
