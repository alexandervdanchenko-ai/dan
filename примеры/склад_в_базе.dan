// Склад в базе данных SQLite: добавление, выборка, итоги и выгрузка в JSON.
// Файл базы склад.db создаётся в текущей папке; его можно открыть и другими
// программами, например DB Browser for SQLite.
подключить "sqlite"
подключить "json"

функ заполнить(база: sqlite.База) -> ! {
    база.выполнить("CREATE TABLE IF NOT EXISTS товары (код TEXT PRIMARY KEY, название TEXT, количество INTEGER, поступление TEXT)", [])!
    база.выполнить("DELETE FROM товары", [])!
    пусть товары = [
        ["А-001", "Тетрадь в клетку", "1500", "2026-10-26"],
        ["А-002", "Линейка \"30 см\"", "250", "2026-09-01"],
        ["Б-010", "Циркуль", "40", "2026-03-31"]
    ]
    база.выполнить("BEGIN", [])!
    для т в товары {
        база.выполнить("INSERT INTO товары VALUES (?, ?, ?, ?)",
            [sqlite.Текст(т[0]), sqlite.Текст(т[1]), sqlite.Целое(цел(т[2])), sqlite.Текст(т[3])])!
    }
    база.выполнить("COMMIT", [])!
}

пусть база = sqlite.открыть("склад.db")!
заполнить(база)!

вывод("Товары, которых больше 100:")
для товар в база.выбрать("SELECT * FROM товары WHERE количество > ? ORDER BY количество DESC", [sqlite.Целое(100)])! {
    пусть поступление = дата(товар["поступление"].текст())
    вывод("  " + товар["код"].текст() + ", " + товар["название"].текст() + ": "
        + стр(товар["количество"].как_цел() иначе 0) + " шт., на складе " + стр(дата("31.12.2026") - поступление) + " дн. к концу года")
}

пусть всего = база.значение("SELECT SUM(количество) FROM товары", [])!.как_цел() иначе 0
вывод("Всего единиц: " + прописью(всего))

// выгрузка в JSON
перем список: [json.Значение] = []
для товар в база.выбрать("SELECT код, название, количество FROM товары ORDER BY код", [])! {
    список.добавить(json.Объект({
        "код": json.Строка(товар["код"].текст()),
        "название": json.Строка(товар["название"].текст()),
        "количество": json.Целое(товар["количество"].как_цел() иначе 0)
    }))
}
вывод(json.записать_красиво(json.Массив(список)))
база.закрыть()
