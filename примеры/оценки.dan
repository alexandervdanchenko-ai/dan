// Учёт оценок: программа спрашивает оценки, пока не введена пустая строка,
// затем показывает список, средний балл, лучшую и худшую оценку.

функ среднее(оценки: [цел]) -> дроб {
    перем сумма = 0
    для о в оценки { сумма += о }
    вернуть дроб(сумма) / оценки.длина
}

функ наибольшая(оценки: [цел]) -> цел {
    перем лучшая = оценки[0]
    для о в оценки {
        если о > лучшая { лучшая = о }
    }
    вернуть лучшая
}

функ наименьшая(оценки: [цел]) -> цел {
    перем худшая = оценки[0]
    для о в оценки {
        если о < худшая { худшая = о }
    }
    вернуть худшая
}

вывод("Вводите оценки от 1 до 5, по одной в строке. Пустая строка - конец.")
перем оценки: [цел] = []
пока истина {
    пусть строка = ввод("Оценка: ")
    если строка == "" { прервать }
    пусть оценка = цел(строка)
    если оценка < 1 или оценка > 5 {
        вывод("Оценка должна быть от 1 до 5, попробуйте ещё раз")
        продолжить
    }
    оценки.добавить(оценка)
}

если оценки.длина == 0 {
    вывод("Оценок нет")
} иначе {
    вывод("Оценки: " + стр(оценки.длина))
    вывод(оценки)
    вывод("Средний балл: " + стр(среднее(оценки)))
    вывод("Лучшая: " + стр(наибольшая(оценки)) + ", худшая: " + стр(наименьшая(оценки)))
}
