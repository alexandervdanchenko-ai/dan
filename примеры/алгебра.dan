// Алгебра на языке Дан: многочлены, уравнения, неравенства, модуль.

вывод("Буквенные выражения: скобки раскрываются сами")
вывод((х + 3) * (х - 2))
вывод("Общий множитель: 6х² + 9х = " + вынести_общий_множитель(6*х² + 9*х))

вывод("")
вывод("Уравнения: 3х + 5 = 2х + 9")
вывод(решить(3*х + 5, 2*х + 9))
// Задача: сумма трёх последовательных чисел равна 72. Найдите числа.
пусть н = решить(х + (х + 1) + (х + 2), 72)[0]
вывод("Числа: " + стр(н) + ", " + стр(н + 1) + ", " + стр(н + 2))

вывод("")
вывод("Система: 2х + у = 5, х - у = 1")
вывод(решить_систему([[2, 1, 5], [1, -1, 1]]))

вывод("")
вывод("Неравенства")
вывод("3х - 6 > 0:  " + решить_неравенство(3*х - 6, ">", 0))
вывод("Система 2х - 4 > 0 и х ≤ 5:  "
      + решить_систему_неравенств([2*х - 4, х], [">", "<="], [0, 5]))

вывод("")
вывод("Многочлены")
вывод("(а + б)² при а = х, б = 2: " + стр((х + 2)²))
вывод("(х³ - 8) : (х - 2) = " + стр((х³ - 8) / (х - 2)))
вывод("х⁴ - 1 = " + разложить(х^4 - 1))

вывод("")
вывод("Квадратные корни и квадратные уравнения")
пусть к = х² - 7*х + 10
вывод("D = " + стр(дискриминант(к)))
пусть корни_к = решить(к)
вывод("Корни: " + стр(корни_к))
вывод("Теорема Виета: сумма = " + стр(корни_к[0] + корни_к[1]) + ", произведение = "
      + стр(корни_к[0] * корни_к[1]))
вывод("Разложение: " + разложить(к))
вывод("х² = 2:  " + стр(решить_приближённо(х², 2)))

вывод("")
вывод("Модуль")
вывод("|2х - 3| = 5:  " + решить_с_модулем(2*х - 3, 5))
вывод("|х - 1| < 2:  " + решить_неравенство_с_модулем(х - 1, "<", 2))
вывод("|х² - 5| < 4:  " + решить_неравенство_с_модулем(х² - 5, "<", 4))
вывод("Метод интервалов: (х + 2)(х - 1)(х - 3) ≥ 0:  "
      + решить_неравенство((х + 2) * (х - 1) * (х - 3), "≥", 0))
