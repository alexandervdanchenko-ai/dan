// Длинные целые и комплексные числа на языке Дан.

// Числа Фибоначчи любой длины
функ фибоначчи_длинное(н: цел) -> длинное {
    перем а = длинное(0)
    перем б = длинное(1)
    для к в 1..н {
        пусть с = а + б
        а = б
        б = с
    }
    вернуть а
}
вывод("F(200) = " + стр(фибоначчи_длинное(200)))

// Сумма вклада с ежегодной капитализацией за 100 лет в копейках, точно
перем копейки = длинное(100_000_00)
для год в 1..100 {
    копейки = копейки + копейки * 8 / 100
}
вывод("100 000 руб. под 8% через 100 лет: " + стр(копейки / 100) + " руб.")

// Корни уравнения четвёртой степени х⁴ = -4 среди комплексных чисел
пусть корень_из = корень(компл(-4))
вывод("√(-4) = " + стр(корень_из))
для з в [компл(1, 1), компл(1, -1), компл(-1, 1), компл(-1, -1)] {
    вывод("(" + стр(з) + ")⁴ = " + стр(з ^ 4))
}
