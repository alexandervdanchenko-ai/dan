// Файлы, сжатие, шифрование и архивы на языке Дан.
// Программа создаёт папку «пример_данные» рядом с собой.

создать_папку("пример_данные")

// 1. Текстовый файл
перем текст = ""
для н в 1..300 {
    текст += "Пункт " + стр(н) + ". Работник обязуется добросовестно исполнять трудовые обязанности.\n"
}
записать("пример_данные/договор.txt", текст)
пусть исходный = прочитать_байты("пример_данные/договор.txt")
вывод("Исходный файл: " + стр(исходный.длина) + " байт")

// 2. Сжатие: .xz (уровень 7-Zip) и .gz (уровень zip)
пусть xz = сжать(исходный)
пусть gz = сжать_gzip(исходный)
записать("пример_данные/договор.txt.xz", xz)
записать("пример_данные/договор.txt.gz", gz)
вывод("Сжато в .xz: " + стр(xz.длина) + " байт, в .gz: " + стр(gz.длина) + " байт")
вывод("Распаковано без потерь: " + стр(распаковать(xz) == исходный))

// 3. Сжатие с паролем: сначала сжатие, затем шифрование
пусть закрытый = сжать(исходный, "Пароль-2026")
записать("пример_данные/договор.dan", закрытый)
вывод("Сжато и зашифровано: " + стр(закрытый.длина) + " байт")
вывод("Расшифровано верно: " + стр(распаковать(закрытый, "Пароль-2026") == исходный))

// 4. Контрольная сумма и хеш для проверки подлинности
вывод("CRC-32: " + стр(контрольная_сумма(исходный)))
вывод("SHA-256: " + хеш(исходный))

// 5. Архив zip с паролем (открывается в 7-Zip и WinRAR)
создать_архив("пример_данные/документы.zip",
    ["пример_данные/договор.txt", "пример_данные/договор.txt.xz"], "Пароль-2026")
вывод("В архиве: " + стр(содержимое_архива("пример_данные/документы.zip")))
пусть извлечено = извлечь_архив("пример_данные/документы.zip", "пример_данные/извлечено", "Пароль-2026")
вывод("Извлечено: " + стр(извлечено))
вывод("Совпадает с исходным: "
    + стр(хеш(прочитать_байты("пример_данные/извлечено/договор.txt")) == хеш(исходный)))
вывод("Файлы в папке: " + стр(список_файлов("пример_данные")))
