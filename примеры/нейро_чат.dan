// Чат с языковой моделью на собственном движке Дана (модуль «нейро»): без llama.cpp, весь
// проход модели - на Дане и его векторных ядрах. Ответ выводится по частям, по мере появления.
//
//     dan запустить примеры/нейро_чат.dan модель.gguf ["указание для модели"]
//
// Модель - файл GGUF архитектуры llama или qwen2 (TinyLlama, Llama 2/3, Mistral, Qwen2.5)
// с весами F32, F16, BF16, Q8_0, Q4_0, Q4_1, Q5_0, Q5_1, Q4_K, Q5_K или Q6_K.
// Пустая строка (или конец ввода) завершает разговор.

подключить "нейро"
подключить "модели"

функ разговор(путь: стр, указание: стр) -> ! {
    вывод("Загрузка модели...")
    пусть м = нейро.загрузить(путь)!
    вывод("Модель: " + м.архитектура + ", слоёв " + стр(м.слоёв) + ", словарь " + стр(м.размер_словаря) + " токенов")
    перем история: [нейро.Сообщение] = []
    если указание != "" { история.добавить(нейро.Сообщение("system", указание)) }
    пусть выборка = нейро.Выборка(температура = 0.7, зерно = 1, максимум_токенов = 512)
    пока истина {
        пусть вопрос = ввод("Вы: ")
        если вопрос == "" { прервать }
        история.добавить(нейро.Сообщение("user", вопрос))
        модели.напечатать("Модель: ")
        пусть ответ = м.чат_по_частям(история, выборка, функ(часть: стр) -> лог {
            модели.напечатать(часть)
            вернуть истина
        })!
        вывод("")
        история.добавить(нейро.Сообщение("assistant", ответ))
    }
}

пусть арг = аргументы()
если арг.длина == 0 {
    вывод("Укажите файл модели: dan запустить нейро_чат.dan модель.gguf")
} иначе {
    перем указание = ""
    если арг.длина > 1 { указание = арг[1] }
    если ошибка о = разговор(арг[0], указание) {
        вывод_ошибки(о)
        завершить(1)
    }
}
