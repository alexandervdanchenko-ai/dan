// Высшая и прикладная математика на языке Дан.

вывод("Тригонометрия: точные значения в табличных углах")
для градусы в [0, 30, 45, 60, 90] {
    пусть у = в_радианы(градусы)
    вывод("  sin " + стр(градусы) + "° = " + стр(sin(у)) + ",  cos " + стр(градусы) + "° = " + стр(cos(у)))
}
вывод("  логарифм(2, 1024) = " + стр(логарифм(2, 1024)))

вывод("")
вывод("Начала анализа: функция f(х) = х³ - 3х + 1")
пусть ф = х³ - 3 * х + 1
вывод("  f'(х) = " + стр(производная(ф)))
вывод("  экстремумы при х = " + стр(критические_точки(ф)))
вывод("  касательная в точке 2: у = " + стр(касательная(ф, 2)))
вывод("  площадь под графиком х² на [0; 3] = " + стр(интеграл(х², 0, 3)))

вывод("")
вывод("Комбинаторика и вероятность")
вывод("  способов выбрать 5 карт из 36: " + стр(сочетания(36, 5)))
вывод("  выпадет ровно 2 орла из 4 бросков: " + стр(бернулли(4, 2, рац(1, 2))))
пусть оценки = [5, 4, 4, 3, 5, 5, 2, 4]
вывод("  оценки " + стр(оценки) + ": дисперсия " + стр(дисперсия(оценки))
    + ", отклонение " + стр(округлить(стандартное_отклонение(оценки), 3)))

вывод("")
вывод("Линейная алгебра")
пусть м = [[2, 1], [5, 3]]
вывод("  определитель " + стр(м) + " = " + стр(определитель(м)))
вывод("  обратная матрица = " + стр(обратная_матрица(м)))
вывод("  проверка: " + стр(умножить_матрицы(м, обратная_матрица(м))))

вывод("")
вывод("Координатная геометрия")
вывод("  прямая через (0; 1) и (2; 5): " + уравнение_прямой(0, 1, 2, 5))
если пусть т = пересечение_прямых(1, -1, 0, 1, 1, -4) {
    вывод("  прямые х - у = 0 и х + у = 4 пересекаются в точке " + стр(т))
}
вывод("  площадь треугольника со сторонами 13, 14, 15: " + стр(площадь_треугольника_по_сторонам(13, 14, 15)))

вывод("")
вывод("Числа и суммы прописью")
вывод("  " + стр(2026) + " = " + прописью(2026) + " = " + римское(2026) + " = " + в_систему(2026, 2) + " (в двоичной)")
пусть долг = рац(15750025, 100)
вывод("  " + сумма_цифрами(долг) + " руб. = " + сумма_прописью(долг))
пусть дней = 45
вывод("  срок: " + стр(дней) + " " + склонение(дней, "день", "дня", "дней"))

вывод("")
вывод("Финансовые расчёты")
вывод("  платёж по кредиту 1 000 000 под 12% на 24 месяца: "
    + сумма_цифрами(аннуитетный_платёж(1000000, 12, 24)))
вывод("  100 000 под 10% годовых через 3 года (сложные проценты): " + стр(сложные_проценты(100000, 10, 3)))
пусть компенсация = компенсация_за_задержку(долг, 21, дней)
вывод("  компенсация за задержку " + сумма_цифрами(долг) + " руб. на " + стр(дней) + " дней при ключевой ставке 21% "
    + "(ст. 236 ТК РФ): " + сумма_цифрами(компенсация) + " руб.")
если пусть ставка = внутренняя_норма_доходности([-1000, 300, 400, 500]) {
    вывод("  внутренняя норма доходности проекта: " + стр(округлить(ставка, 2)) + "%")
}

вывод("")
вывод("Линейное программирование: наибольшая прибыль 3х + 5у")
вывод("  при х ≤ 4, 2у ≤ 12, 3х + 2у ≤ 18: " + стр(максимизировать([3, 5], [[1, 0], [0, 2], [3, 2]], [4, 12, 18])))
