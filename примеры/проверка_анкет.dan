// Ошибки как значения: проверка анкет на языке Дан.
// Данные вымышлены.

тип Анкета {
    фио: стр
    возраст: цел
    оклад: цел
}

функ разобрать_анкету(строка: стр) -> Анкета! {
    пусть поля = строка.разбить(";")
    если поля.длина != 3 {
        вернуть ошибка("ожидалось 3 поля через «;», а найдено " + стр(поля.длина))
    }
    пусть фио = поля[0].обрезать()
    если фио.разбить().длина < 2 {
        вернуть ошибка("в ФИО должно быть хотя бы два слова: «" + фио + "»")
    }
    пусть возраст = разобрать_цел(поля[1])!        // ошибка разбора передаётся дальше
    если возраст < 14 {
        вернуть ошибка("возраст меньше 14: " + стр(возраст))
    }
    пусть оклад = разобрать_цел(поля[2])!
    вернуть Анкета(фио, возраст, оклад)
}

пусть строки = ["Иванов Иван; 35; 65000", "Петров; 40; 50000", "Сидорова Анна; сорок; 70000",
    "Кузнецов Пётр; 12; 10000", "Орлова Мария; 29; 81000", "без разделителей"]

перем принятые: [Анкета] = []
перем номер = 0
для строка в строки {
    номер += 1
    если пусть анкета = разобрать_анкету(строка) {
        принятые.добавить(анкета)
    } иначе ошибка о {
        вывод("Строка " + стр(номер) + ": " + о)
    }
}

вывод("")
вывод("Принято анкет: " + стр(принятые.длина))
перем фонд = 0
для а в принятые {
    вывод("  " + а.фио + ", " + стр(а.возраст) + " лет, оклад " + сумма_цифрами(рац(а.оклад)) + " руб.")
    фонд += а.оклад
}
вывод("Фонд оплаты труда: " + сумма_цифрами(рац(фонд)) + " руб. (" + сумма_прописью(рац(фонд)) + ")")

// Запасное значение вместо ошибки
вывод("Оклад по умолчанию: " + стр(разобрать_цел("не указан") иначе 0))
