// Реестр судебных дел на языке Дан: собственные типы и необязательные значения.
// Все номера дел, суды и стороны в этом примере вымышлены.

тип Сторона {
    наименование: стр
    роль: стр
}

тип Дело {
    номер: стр
    суд: стр
    стороны: [Сторона] = []
    цена_иска: цел = 0
    заседание: стр? = ничего     // дата ближайшего заседания, если назначено
    решение: стр? = ничего
}

функ найти_дело(реестр: [Дело], номер: стр) -> Дело? {
    для д в реестр {
        если д.номер == номер { вернуть д }
    }
    вернуть ничего
}

функ истец(д: Дело) -> стр? {
    для с в д.стороны {
        если с.роль == "истец" { вернуть с.наименование }
    }
    вернуть ничего
}

перем реестр: [Дело] = []
реестр.добавить(Дело(
    номер = "2-0001/2026",
    суд = "Первый районный суд",
    стороны = [Сторона("Иванов И.И.", "истец"), Сторона("ООО «Пример»", "ответчик")],
    цена_иска = 350000,
    заседание = "12.11.2026"))
реестр.добавить(Дело("2-0002/2026", "Второй районный суд", цена_иска = 120000))
реестр.добавить(Дело("2-0003/2026", "Первый районный суд",
    [Сторона("Петрова А.С.", "истец")], 90000, решение = "иск удовлетворён"))

// Изменение поля элемента списка
реестр[1].заседание = "20.11.2026"
реестр[1].стороны.добавить(Сторона("Сидоров П.П.", "истец"))

вывод("Реестр дел:")
перем всего = 0
для д в реестр {
    вывод("  " + д.номер + ", " + д.суд)
    вывод("    истец: " + (истец(д) иначе "не указан"))
    вывод("    заседание: " + (д.заседание иначе "не назначено"))
    если пусть р = д.решение {
        вывод("    решение: " + р)
    }
    всего += д.цена_иска
}
вывод("Общая цена исков: " + стр(всего) + " руб.")

// Поиск по номеру: результат может отсутствовать
для номер в ["2-0003/2026", "2-0999/2026"] {
    если пусть д = найти_дело(реестр, номер) {
        вывод("Найдено: " + номер + " в суде «" + д.суд + "»")
    } иначе {
        вывод("Дело " + номер + " в реестре не найдено")
    }
}

// Значения копируются: изменение копии не затрагивает реестр
перем черновик = реестр[0]
черновик.цена_иска = 1
вывод("В реестре цена иска осталась " + стр(реестр[0].цена_иска))
