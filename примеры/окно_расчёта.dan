// Программа с окном: расчёт процентов за пользование чужими денежными
// средствами (статья 395 ГК РФ) по одной ставке. Собирается для Windows:
//     python dan.py собрать примеры/окно_расчёта.dan
подключить "окна"

функ расчёт(сумма_текст: стр, ставка_текст: стр, начало_текст: стр, конец_текст: стр) -> стр! {
    пусть сумма = разобрать_дроб(сумма_текст)!
    пусть ставка = разобрать_дроб(ставка_текст)!
    пусть начало = разобрать_дату(начало_текст)!
    пусть конец = разобрать_дату(конец_текст)!
    если конец < начало { вернуть ошибка("дата окончания раньше даты начала") }
    пусть дней = конец - начало + 1
    перем дней_в_году = 365
    если дней_в_месяце(начало.год, 2) == 29 { дней_в_году = 366 }
    пусть проценты = рац(сумма) * рац(ставка) / 100 * дней / дней_в_году
    вернуть "Дней: " + стр(дней) + "\nПроценты: " + сумма_цифрами(проценты) + " руб.\n(" + сумма_прописью(проценты) + ")"
}

пусть окно = окна.создать("Проценты по статье 395 ГК РФ", 460, 300)!
окно.надпись("Сумма долга, руб.:", 20, 22, 170, 24)
пусть сумма = окно.поле("100000", 200, 20, 230, 26)
окно.надпись("Ключевая ставка, %:", 20, 57, 170, 24)
пусть ставка = окно.поле("16", 200, 55, 230, 26)
окно.надпись("Начало просрочки:", 20, 92, 170, 24)
пусть начало = окно.поле("01.03.2026", 200, 90, 230, 26)
окно.надпись("Окончание:", 20, 127, 170, 24)
пусть конец = окно.поле(стр(сегодня()), 200, 125, 230, 26)
пусть кнопка = окно.кнопка("Рассчитать", 200, 165, 140, 32)
пусть итог = окно.надпись("", 20, 210, 420, 75)

пока пусть событие = окно.ждать() {
    выбор событие {
        окна.Нажатие(э) {
            если пусть текст = расчёт(сумма.текст(), ставка.текст(), начало.текст(), конец.текст()) {
                итог.задать_текст(текст)
            } иначе ошибка о {
                итог.задать_текст("Ошибка: " + о)
            }
        }
        иначе {}
    }
}
