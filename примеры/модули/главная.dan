// Программа из двух файлов: расчёты вынесены в модуль.
// Запуск: python dan.py запустить примеры/модули/главная.dan

подключить "трудовые_расчёты.dan" как трудовые

пусть требования = [
    трудовые.Задолженность("задолженность по заработной плате", 185000),
    трудовые.Компенсация(185000, 21, 94),
    трудовые.МоральныйВред(50000)
]

вывод("Исковые требования:")
перем номер = 0
для т в требования {
    номер += 1
    вывод("  " + стр(номер) + ". " + трудовые.название(т) + ": " + сумма_цифрами(трудовые.размер(т)) + " руб.")
}

пусть итог = трудовые.подсчитать(требования)
вывод("Цена иска: " + сумма_цифрами(итог.цена_иска) + " руб. (" + сумма_прописью(итог.цена_иска) + ")")
вывод("Всего к взысканию: " + сумма_цифрами(итог.всего) + " руб.")
