// Программа из двух файлов: расчёты вынесены в модуль.
// Запуск: python dan.py запустить примеры/модули/главная.dan

подключить "геометрия.dan" как геометрия

пусть фигуры = [
    геометрия.Прямоугольник(рац(5, 2), 4),
    геометрия.Треугольник(3, рац(7, 3)),
    геометрия.Квадрат(рац(3, 2))
]

вывод("Фигуры:")
перем номер = 0
для ф в фигуры {
    номер += 1
    вывод("  " + стр(номер) + ". " + геометрия.название(ф) + ": площадь " + стр(геометрия.площадь(ф)))
}

пусть итог = геометрия.подсчитать(фигуры)
вывод("Общая площадь: " + стр(итог.площадь) + " = " + смешанное(итог.площадь))
вывод("Наибольшая площадь: " + стр(итог.наибольшая))
вывод("Четырёхугольников: " + стр(геометрия.четырёхугольники(фигуры)))
