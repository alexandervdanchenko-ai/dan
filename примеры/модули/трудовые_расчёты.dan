// Модуль расчётов по трудовым спорам. Снаружи видно только то,
// что помечено словом «общий». Суммы и сроки вымышлены.

общий тип Требование {
    Задолженность(описание: стр, сумма: рац)
    Компенсация(сумма: рац, ключевая_ставка: рац, дней: цел)    // ст. 236 ТК РФ
    МоральныйВред(сумма: рац)
}

общий тип Итог {
    цена_иска: рац
    всего: рац
}

// Внутренняя функция модуля: снаружи недоступна
функ имущественное(т: Требование) -> лог {
    выбор т {
        МоральныйВред { вернуть ложь }
        иначе { вернуть истина }
    }
}

общий функ размер(т: Требование) -> рац {
    выбор т {
        Задолженность(_, с) { вернуть с }
        Компенсация(с, ставка, дней) { вернуть компенсация_за_задержку(с, ставка, дней) }
        МоральныйВред(с) { вернуть с }
    }
}

общий функ название(т: Требование) -> стр {
    выбор т {
        Задолженность(описание, _) { вернуть описание }
        Компенсация(_, _, дней) { вернуть ("компенсация за задержку выплат (" + стр(дней) + " "
                                           + склонение(дней, "день", "дня", "дней") + ")") }
        МоральныйВред { вернуть "компенсация морального вреда" }
    }
}

общий функ подсчитать(требования: [Требование]) -> Итог {
    пусть цена = требования.отобрать(имущественное).преобразовать(размер).свернуть(рац(0), функ(итог, с) = итог + с)
    пусть всего = требования.преобразовать(размер).свернуть(рац(0), функ(итог, с) = итог + с)
    вернуть Итог(цена, всего)
}
