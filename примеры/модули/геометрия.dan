// Модуль геометрических расчётов. Снаружи видно только то,
// что помечено словом «общий». Площади считаются точно, обыкновенными дробями.

общий тип Фигура {
    Прямоугольник(ширина: рац, высота: рац)
    Треугольник(основание: рац, высота: рац)
    Квадрат(сторона: рац)
}

общий тип Итог {
    площадь: рац
    наибольшая: рац
}

// Внутренняя функция модуля: снаружи недоступна
функ четырёхугольник(ф: Фигура) -> лог {
    выбор ф {
        Треугольник { вернуть ложь }
        иначе { вернуть истина }
    }
}

общий функ площадь(ф: Фигура) -> рац {
    выбор ф {
        Прямоугольник(ш, в_) { вернуть ш * в_ }
        Треугольник(о, в_) { вернуть о * в_ / 2 }
        Квадрат(с) { вернуть с * с }
    }
}

общий функ название(ф: Фигура) -> стр {
    выбор ф {
        Прямоугольник { вернуть "прямоугольник" }
        Треугольник { вернуть "треугольник" }
        Квадрат { вернуть "квадрат" }
    }
}

общий функ подсчитать(фигуры: [Фигура]) -> Итог {
    пусть площади = фигуры.преобразовать(площадь)
    пусть сумма_ = площади.свернуть(рац(0), функ(итог, с) = итог + с)
    пусть наиб = площади.свернуть(рац(0), функ(итог, с) = макс(итог, с))
    вернуть Итог(сумма_, наиб)
}

общий функ четырёхугольники(фигуры: [Фигура]) -> цел {
    вернуть фигуры.отобрать(четырёхугольник).длина
}
