// Каталог книг на языке Дан: собственные типы и необязательные значения.
// Все книги и авторы в этом примере вымышлены.

тип Автор {
    имя: стр
    год_рождения: цел? = ничего
}

тип Книга {
    название: стр
    авторы: [Автор] = []
    страниц: цел = 0
    выдана: стр? = ничего      // кому выдана, если выдана
    оценка: рац? = ничего
}

функ найти_книгу(каталог: [Книга], название: стр) -> Книга? {
    для к в каталог {
        если к.название == название { вернуть к }
    }
    вернуть ничего
}

функ первый_автор(к: Книга) -> стр? {
    если к.авторы.длина == 0 { вернуть ничего }
    вернуть к.авторы[0].имя
}

перем каталог: [Книга] = []
каталог.добавить(Книга(
    название = "Задачи о дробях",
    авторы = [Автор("Иванов И.И.", 1950), Автор("Петрова А.С.")],
    страниц = 240,
    выдана = "читатель № 17"))
каталог.добавить(Книга("Геометрия на плоскости", страниц = 312))
каталог.добавить(Книга("Числа и многочлены", [Автор("Сидоров П.П.")], 180, оценка = рац(9, 2)))

// Изменение поля элемента списка
каталог[1].выдана = "читатель № 3"
каталог[1].авторы.добавить(Автор("Кузнецова Е.В.", 1975))

вывод("Каталог:")
перем всего = 0
для к в каталог {
    вывод("  " + к.название)
    вывод("    автор: " + (первый_автор(к) иначе "не указан"))
    вывод("    выдана: " + (к.выдана иначе "на месте"))
    если пусть о = к.оценка {
        вывод("    оценка: " + стр(о))
    }
    всего += к.страниц
}
вывод("Всего страниц: " + стр(всего))

// Поиск по названию: результат может отсутствовать
для название в ["Числа и многочлены", "Теория игр"] {
    если пусть к = найти_книгу(каталог, название) {
        вывод("Найдено: «" + название + "», страниц: " + стр(к.страниц))
    } иначе {
        вывод("Книги «" + название + "» в каталоге нет")
    }
}

// Значения копируются: изменение копии не затрагивает каталог
перем черновик = каталог[0]
черновик.страниц = 1
вывод("В каталоге осталось страниц: " + стр(каталог[0].страниц))
