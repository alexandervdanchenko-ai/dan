// Реестр дел в базе данных SQLite: добавление, поиск, сроки и выгрузка в JSON.
// Файл базы реестр.db создаётся в текущей папке; его можно открыть и другими
// программами, например DB Browser for SQLite.
подключить "sqlite"
подключить "json"

функ заполнить(база: sqlite.База) -> ! {
    база.выполнить("CREATE TABLE IF NOT EXISTS дела (номер TEXT PRIMARY KEY, истец TEXT, сумма INTEGER, решение TEXT)", [])!
    база.выполнить("DELETE FROM дела", [])!
    пусть дела = [
        ["А40-12345/2026", "Иванов И.И.", "150000", "2026-10-26"],
        ["А40-20000/2026", "ООО \"Ромашка\"", "2500000", "2026-12-26"],
        ["2-1234/2026", "Петрова А.А.", "45000", "2026-03-31"]
    ]
    база.выполнить("BEGIN", [])!
    для д в дела {
        база.выполнить("INSERT INTO дела VALUES (?, ?, ?, ?)",
            [sqlite.Текст(д[0]), sqlite.Текст(д[1]), sqlite.Целое(цел(д[2])), sqlite.Текст(д[3])])!
    }
    база.выполнить("COMMIT", [])!
}

пусть база = sqlite.открыть("реестр.db")!
заполнить(база)!

вывод("Дела с суммой больше 100 000:")
для дело в база.выбрать("SELECT * FROM дела WHERE сумма > ? ORDER BY сумма DESC", [sqlite.Целое(100000)])! {
    пусть решение = дата(дело["решение"].текст())
    // апелляционная жалоба - в течение месяца со дня решения
    перем срок = добавить_месяцы(решение, 1)
    пока не рабочий_день(срок) { срок += 1 }
    вывод("  " + дело["номер"].текст() + ", " + дело["истец"].текст() + ": " + сумма_цифрами(рац(дело["сумма"].как_цел() иначе 0))
        + " руб., жалоба до " + стр(срок))
}

пусть всего = база.значение("SELECT SUM(сумма) FROM дела", [])!.как_цел() иначе 0
вывод("Всего требований: " + сумма_прописью(рац(всего)))

// выгрузка реестра в JSON
перем список: [json.Значение] = []
для дело в база.выбрать("SELECT номер, истец, сумма FROM дела ORDER BY номер", [])! {
    список.добавить(json.Объект({
        "номер": json.Строка(дело["номер"].текст()),
        "истец": json.Строка(дело["истец"].текст()),
        "сумма": json.Целое(дело["сумма"].как_цел() иначе 0)
    }))
}
вывод(json.записать_красиво(json.Массив(список)))
база.закрыть()
