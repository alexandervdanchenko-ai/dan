// Монитор вопросов HARANT.RU - оконное приложение (панель управления).
//
// Программа следит за лентой вопросов https://harant.ru/questions/: через
// заданное число минут сама проверяет одну или несколько первых страниц ленты
// (всей или одного раздела), сохраняет новые вопросы в базу и отмечает
// звёздочкой те, что подходят под отбор (слова, «только без ответов»).
// Загрузка идёт в отдельной задаче, поэтому окно не замирает во время проверки.
//
// В окне:
//   - настройки отбора и расписания (запоминаются в файле монитор_harant.ini);
//   - кнопки «Запустить мониторинг», «Остановить», «Проверить сейчас»,
//     «Открыть на сайте», «Выгрузить в Excel», «Сбросить отметки»;
//   - строка состояния с лампой (серая - остановлен, зелёная - работает,
//     жёлтая - идёт проверка, красная - ошибка) и обратным отсчётом;
//   - список вопросов с поиском, полный текст выбранного вопроса и журнал.
//
// Запуск:   python dan.py запустить монитор_harant.dan
// Сборка:   python dan.py собрать монитор_harant.dan --для=windows
// База вопросы_harant.db и таблица вопросы_harant.xlsx создаются в папке,
// из которой запущена программа (общие с программой сбор_вопросов.dan).

подключить "harant.dan"
подключить "окна"
подключить "sqlite"

пусть ФАЙЛ_БАЗЫ = "вопросы_harant.db"
пусть ФАЙЛ_НАСТРОЕК = "монитор_harant.ini"
пусть ТАБЛИЦА = "вопросы_harant.xlsx"

тип Панель {
    окно: окна.Окно
    раздел: окна.Элемент
    слова: окна.Элемент
    без_ответов: окна.Элемент
    интервал: окна.Элемент
    страниц: окна.Элемент
    оповещать: окна.Элемент
    обновлять_excel: окна.Элемент
    запуск: окна.Элемент
    стоп: окна.Элемент
    проверить: окна.Элемент
    открыть: окна.Элемент
    выгрузить: окна.Элемент
    сбросить: окна.Элемент
    лампа: окна.Элемент
    состояние: окна.Элемент
    сводка: окна.Элемент
    полоса: окна.Элемент
    показ: окна.Элемент
    поиск: окна.Элемент
    показано: окна.Элемент
    список: окна.Элемент
    текст: окна.Элемент
    надпись_журнала: окна.Элемент
    журнал: окна.Элемент
}

тип Параметры {
    раздел: стр                // код раздела в адресе; "" - вся лента
    название_раздела: стр      // «Трудовое право»; "" - все разделы
    слова: [стр]
    без_ответов: лог
    интервал: цел              // минут между проверками
    страниц: цел               // сколько первых страниц ленты смотреть
    оповещать: лог
    обновлять_excel: лог
}

// ---------------------------------------------------------------------------
// Разделы в выпадающем списке: первая строка - вся лента

функ коды_разделов() -> [стр] {
    перем к: [стр] = [""]
    для код в harant.разделы() { к.добавить(код) }
    вернуть к
}

функ названия_разделов() -> [стр] {
    перем н: [стр] = ["Все разделы"]
    пусть р = harant.разделы()
    для код в р { н.добавить(р[код]) }
    вернуть н
}

// ---------------------------------------------------------------------------
// Окно

функ построить(окно: окна.Окно) -> Панель {
    окно.надпись("Раздел:", 12, 16, 64, 22)
    пусть раздел = окно.выпадающий_список(названия_разделов(), 78, 12, 270, 26)
    окно.надпись("Слова через запятую:", 362, 16, 170, 22)
    пусть слова = окно.поле("", 534, 12, 280, 26)
    пусть без_ответов = окно.флажок("Только вопросы без ответов", 828, 12, 250, 26)

    окно.надпись("Проверять каждые (мин.):", 12, 52, 205, 22)
    пусть интервал = окно.поле("5", 218, 48, 45, 26)
    окно.надпись("Страниц за проверку:", 274, 52, 178, 22)
    пусть страниц = окно.поле("3", 454, 48, 40, 26)
    пусть оповещать = окно.флажок("Сообщать окном о новых", 508, 48, 222, 26)
    пусть обновлять_excel = окно.флажок("Обновлять Excel после проверки", 735, 48, 340, 26)

    пусть запуск = окно.кнопка("Запустить мониторинг", 12, 86, 200, 32)
    пусть стоп = окно.кнопка("Остановить", 218, 86, 130, 32)
    пусть проверить = окно.кнопка("Проверить сейчас", 354, 86, 160, 32)
    пусть открыть = окно.кнопка("Открыть на сайте", 520, 86, 180, 32)
    пусть выгрузить = окно.кнопка("Выгрузить в Excel", 706, 86, 170, 32)
    пусть сбросить = окно.кнопка("Сбросить отметки ★", 882, 86, 190, 32)

    пусть лампа = окно.холст(12, 132, 18, 18)
    пусть состояние = окно.надпись("Мониторинг остановлен", 38, 130, 520, 22)
    пусть сводка = окно.надпись("", 570, 130, 505, 22)
    пусть полоса = окно.полоса(12, 158, 1060, 12)

    окно.надпись("Показать:", 12, 184, 76, 22)
    пусть показ = окно.выпадающий_список(["Подходящие под отбор", "Новые за этот сеанс (★)", "Все собранные"], 90, 180, 250, 26)
    окно.надпись("Поиск:", 356, 184, 54, 22)
    пусть поиск = окно.поле("", 412, 180, 300, 26)
    пусть показано = окно.надпись("", 725, 184, 350, 22)

    пусть список = окно.список([], 12, 216, 480, 324)
    пусть текст = окно.многострочное_поле("", 504, 216, 568, 324)
    пусть надпись_журнала = окно.надпись("Журнал:", 12, 548, 100, 20)
    пусть журнал = окно.многострочное_поле("", 12, 570, 1060, 110)

    стоп.сделать_доступным(ложь)
    вернуть Панель(окно, раздел, слова, без_ответов, интервал, страниц, оповещать, обновлять_excel,
        запуск, стоп, проверить, открыть, выгрузить, сбросить, лампа, состояние, сводка, полоса,
        показ, поиск, показано, список, текст, надпись_журнала, журнал)
}

// Растянуть список, текст и журнал по новому размеру окна
функ разместить(п: Панель, ширина: цел, высота: цел) {
    пусть ш = макс(ширина, 900)
    пусть выс = макс(высота, 560)
    пусть журнал_в = 110
    пусть низ_списка = выс - журнал_в - 50
    пусть левая = частное((ш - 36) * 45, 100)
    п.сводка.переместить(570, 130, ш - 582, 22)
    п.полоса.переместить(12, 158, ш - 24, 12)
    п.список.переместить(12, 216, левая, низ_списка - 216)
    п.текст.переместить(24 + левая, 216, ш - левая - 36, низ_списка - 216)
    п.надпись_журнала.переместить(12, низ_списка + 8, 100, 20)
    п.журнал.переместить(12, низ_списка + 30, ш - 24, журнал_в)
}

// Лампа: "серая", "зелёная", "жёлтая", "красная"
функ зажечь(п: Панель, цвет: стр) {
    перем з = окна.серый()
    если цвет == "зелёная" { з = окна.зелёный() }
    если цвет == "жёлтая" { з = окна.жёлтый() }
    если цвет == "красная" { з = окна.красный() }
    п.лампа.очистить(окна.без_цвета())
    п.лампа.эллипс(1, 1, 16, 16, окна.серый(), з)
}

функ кнопки_при_работе(п: Панель, работает: лог, идёт_проверка: лог) {
    п.запуск.сделать_доступным(не работает и не идёт_проверка)
    п.стоп.сделать_доступным(работает или идёт_проверка)
    п.проверить.сделать_доступным(не идёт_проверка)
    п.выгрузить.сделать_доступным(не идёт_проверка)
}

// ---------------------------------------------------------------------------
// Настройки

функ число_из(т: стр, запасное: цел, наименьшее: цел, наибольшее: цел) -> цел {
    пусть ч = разобрать_цел(т.обрезать()) иначе запасное
    вернуть мин(макс(ч, наименьшее), наибольшее)
}

функ прочитать_параметры(п: Панель) -> Параметры {
    пусть коды = коды_разделов()
    перем н = п.раздел.выбранный()
    если н < 0 или н >= коды.длина { н = 0 }
    пусть код = коды[н]
    вернуть Параметры(
        раздел = код,
        название_раздела = harant.разделы().получить(код, ""),
        слова = harant.разобрать_слова(п.слова.текст()),
        без_ответов = п.без_ответов.отмечен(),
        интервал = число_из(п.интервал.текст(), 5, 1, 1440),
        страниц = число_из(п.страниц.текст(), 3, 1, 50),
        оповещать = п.оповещать.отмечен(),
        обновлять_excel = п.обновлять_excel.отмечен()
    )
}

функ да(л: лог) -> стр {
    если л { вернуть "да" }
    вернуть "нет"
}

функ сохранить_настройки(путь: стр, п: Панель) {
    пусть пар = прочитать_параметры(п)
    пусть строки = [
        "раздел=" + пар.раздел,
        "слова=" + п.слова.текст(),
        "без_ответов=" + да(пар.без_ответов),
        "интервал=" + стр(пар.интервал),
        "страниц=" + стр(пар.страниц),
        "оповещать=" + да(пар.оповещать),
        "excel=" + да(пар.обновлять_excel),
        "показ=" + стр(макс(п.показ.выбранный(), 0))
    ]
    записать(путь, строки.соединить("\n") + "\n")
}

функ загрузить_настройки(путь: стр, п: Панель) {
    если не существует(путь) { вернуть }
    для строка в стр(прочитать_байты(путь)).заменить("\r", "").разбить("\n") {
        пусть к = строка.найти("=")
        если к <= 0 { продолжить }
        пусть имя = строка[0..к - 1]
        перем з = ""
        если к < строка.длина - 1 { з = строка[к + 1..строка.длина - 1] }
        выбор имя {
            "раздел" {
                пусть н = коды_разделов().найти(з)
                если н >= 0 { п.раздел.выбрать(н) }
            }
            "слова" { п.слова.задать_текст(з) }
            "без_ответов" { п.без_ответов.отметить(з == "да") }
            "интервал" { п.интервал.задать_текст(з) }
            "страниц" { п.страниц.задать_текст(з) }
            "оповещать" { п.оповещать.отметить(з == "да") }
            "excel" { п.обновлять_excel.отметить(з == "да") }
            "показ" {
                пусть н = разобрать_цел(з) иначе 0
                если н >= 0 и н <= 2 { п.показ.выбрать(н) }
            }
            иначе {}
        }
    }
}

// ---------------------------------------------------------------------------
// Список и карточка вопроса

функ строка_списка(вп: harant.Вопрос, новые: {цел: лог}) -> стр {
    перем знак = "    "
    если новые.содержит(вп.номер) { знак = "★ " }
    перем когда = вп.дата
    если когда.длина >= 16 { когда = когда[0..4] + " " + когда[11..15] }   // «26.10 17:32»
    вернуть знак + когда + "  [" + вп.раздел + "]  " + вп.заголовок + "  (ответов: " + стр(вп.ответов) + ")"
}

// Что показать: 0 - подходящие под отбор, 1 - новые за сеанс, 2 - все собранные; поиск - по тексту
функ для_показа(все: [harant.Вопрос], режим: цел, пар: Параметры, поиск: стр, новые: {цел: лог}) -> [harant.Вопрос] {
    пусть искомое = поиск.обрезать().строчные()
    перем итог: [harant.Вопрос] = []
    для вп в все {
        если режим == 0 {
            если пар.название_раздела != "" и вп.раздел != пар.название_раздела { продолжить }
            если не harant.подходит(вп, пар.без_ответов, пар.слова) { продолжить }
        }
        если режим == 1 и не новые.содержит(вп.номер) { продолжить }
        если искомое != "" {
            пусть где = (стр(вп.номер) + " " + вп.заголовок + " " + вп.текст + " " + вп.автор).строчные()
            если не где.содержит(искомое) { продолжить }
        }
        итог.добавить(вп)
    }
    вернуть итог
}

функ карточка(вп: harant.Вопрос) -> стр {
    перем т = "Вопрос № " + стр(вп.номер) + "    " + вп.дата + "    " + вп.раздел + "\n"
    т = т + "Автор: " + вп.автор + "    Ответов юристов: " + стр(вп.ответов) + "\n"
    т = т + "Найден программой: " + вп.найден + "\n"
    т = т + "Ссылка: " + вп.адрес + "\n\n"
    т = т + вп.заголовок.прописные() + "\n\n"
    вернуть т + вп.текст
}

// Открыть адрес вопроса в браузере системы. Адрес проверяется шаблоном,
// чтобы в команду не попало ничего, кроме ссылки на вопрос.
функ открыть_в_браузере(адрес: стр) -> лог {
    если не совпадает(адрес, "https?://[A-Za-z0-9.:-]+/questions/q-\\d+/") { вернуть ложь }
    перем команда = "xdg-open '" + адрес + "' >/dev/null 2>&1 &"
    если пусть система = переменная_среды("OS") {
        если система == "Windows_NT" { команда = "start \"\" \"" + адрес + "\"" }
    }
    вернуть выполнить_команду(команда) == 0
}

// ---------------------------------------------------------------------------
// Ожидание во время проверки: окно отвечает, кнопка «Остановить» работает.
// Результат: 0 - ничего особенного, 1 - нажата «Остановить», 2 - окно закрыто.

функ ждать_во_время_проверки(п: Панель, мс: цел) -> цел {
    если пусть с = п.окно.ждать_не_дольше(мс) {
        выбор с {
            окна.Нажатие(э) {
                если э == п.стоп { вернуть 1 }
            }
            окна.Размер(ш, выс) { разместить(п, ш, выс) }
            окна.Закрытие { вернуть 2 }
            иначе {}
        }
        вернуть 0
    }
    вернуть 2
}

функ минуты_секунды(секунд: цел) -> стр {
    пусть с = макс(секунд, 0)
    пусть ост = с % 60
    перем т = стр(ост)
    если ост < 10 { т = "0" + т }
    вернуть стр(частное(с, 60)) + ":" + т
}

функ время(момент: стр) -> стр {
    // «26.10.2026 18:30:05» -> «18:30:05»
    если момент.длина >= 19 { вернуть момент[11..18] }
    вернуть момент
}

// ---------------------------------------------------------------------------
// Главная часть

пусть окно = окна.создать("Монитор вопросов HARANT.RU", 1084, 690)!
пусть п = построить(окно)
загрузить_настройки(ФАЙЛ_НАСТРОЕК, п)
зажечь(п, "серая")

пусть база = harant.открыть_базу(ФАЙЛ_БАЗЫ)!
перем все = harant.из_базы(база, "", 3000)!
перем в_базе = harant.сколько_в_базе(база)!
перем новые_сеанса: {цел: лог} = {}
перем показанные: [harant.Вопрос] = []
перем журнал: [стр] = []

перем работает = ложь
перем нужна_проверка = ложь
перем нужно_обновить_список = истина
перем закрыть = ложь
перем следующая = 0.0
перем проверок = 0
перем последняя = ""
перем прошлая_сводка = ""

журнал.вставить(0, время(сейчас()) + "  Программа запущена. В базе вопросов: " + стр(в_базе) + ". База: " + ФАЙЛ_БАЗЫ)
если в_базе == 0 {
    журнал.вставить(0, "Чтобы начать, выберите раздел и нажмите «Запустить мониторинг».")
}
п.журнал.задать_строки(журнал)

пока не закрыть {
    // ---- события окна ----
    если пусть событие = п.окно.ждать_не_дольше(500) {
        выбор событие {
            окна.Нажатие(э) {
                если э == п.запуск {
                    сохранить_настройки(ФАЙЛ_НАСТРОЕК, п)
                    работает = истина
                    нужна_проверка = истина
                    пусть пар = прочитать_параметры(п)
                    перем что = "вся лента"
                    если пар.название_раздела != "" { что = "раздел «" + пар.название_раздела + "»" }
                    журнал.вставить(0, время(сейчас()) + "  Мониторинг запущен: " + что + ", каждые " + стр(пар.интервал) + " мин., страниц за проверку: " + стр(пар.страниц))
                    п.журнал.задать_строки(журнал)
                    кнопки_при_работе(п, работает, ложь)
                } иначе если э == п.стоп {
                    работает = ложь
                    журнал.вставить(0, время(сейчас()) + "  Мониторинг остановлен")
                    п.журнал.задать_строки(журнал)
                    зажечь(п, "серая")
                    п.состояние.задать_текст("Мониторинг остановлен")
                    кнопки_при_работе(п, работает, ложь)
                } иначе если э == п.проверить {
                    сохранить_настройки(ФАЙЛ_НАСТРОЕК, п)
                    нужна_проверка = истина
                } иначе если э == п.открыть {
                    пусть н = п.список.выбранный()
                    если н >= 0 и н < показанные.длина {
                        если не открыть_в_браузере(показанные[н].адрес) {
                            окна.предупреждение("Открыть на сайте", "Не удалось открыть браузер. Ссылка:\n" + показанные[н].адрес)
                        }
                    } иначе {
                        окна.сообщение("Открыть на сайте", "Сначала выберите вопрос в списке.")
                    }
                } иначе если э == п.выгрузить {
                    если пусть путь = окна.файл_для_сохранения("Сохранить таблицу вопросов", "Таблица Excel (*.xlsx)|*.xlsx") {
                        перем куда = путь
                        если не куда.строчные().оканчивается(".xlsx") { куда = куда + ".xlsx" }
                        // в таблицу - ровно то, что сейчас показано в списке
                        если ошибка о = harant.записать_таблицу(показанные, куда) {
                            журнал.вставить(0, время(сейчас()) + "  Ошибка выгрузки: " + стр(о))
                            окна.сообщение_об_ошибке("Выгрузка", "Не удалось сохранить таблицу (возможно, файл открыт в Excel):\n" + стр(о))
                        } иначе {
                            журнал.вставить(0, время(сейчас()) + "  Выгружено в " + куда + ": " + стр(показанные.длина) + " вопросов (и CSV рядом)")
                            окна.сообщение("Выгрузка", "Сохранено вопросов: " + стр(показанные.длина) + "\n" + куда)
                        }
                        п.журнал.задать_строки(журнал)
                    }
                } иначе если э == п.сбросить {
                    новые_сеанса = {}
                    п.окно.задать_заголовок("Монитор вопросов HARANT.RU")
                    нужно_обновить_список = истина
                }
            }
            окна.Изменение(э) {
                если э == п.список {
                    пусть н = п.список.выбранный()
                    если н >= 0 и н < показанные.длина { п.текст.задать_текст(карточка(показанные[н])) }
                } иначе если э == п.поиск {
                    нужно_обновить_список = истина
                } иначе {
                    // изменена одна из настроек: запомнить её и пересобрать список
                    сохранить_настройки(ФАЙЛ_НАСТРОЕК, п)
                    нужно_обновить_список = истина
                }
            }
            окна.Размер(ш, выс) { разместить(п, ш, выс) }
            окна.Закрытие { закрыть = истина }
            иначе {}
        }
    } иначе {
        закрыть = истина
    }
    если закрыть { прервать }

    если работает и метка_времени() >= следующая { нужна_проверка = истина }

    // ---- проверка ленты ----
    если нужна_проверка {
        нужна_проверка = ложь
        пусть пар = прочитать_параметры(п)
        кнопки_при_работе(п, работает, истина)
        зажечь(п, "жёлтая")
        перем новых_подходящих: [harant.Вопрос] = []
        перем новых_всего = 0
        перем сбой = ""
        перем отменено = ложь
        // при первом сборе в пустую базу вопросы не отмечаются как новые
        пусть первичный = в_базе == 0
        для страница в 1..пар.страниц {
            п.состояние.задать_текст("Идёт проверка: страница " + стр(страница) + " из " + стр(пар.страниц))
            п.полоса.задать_значение(частное((страница - 1) * 100, пар.страниц))
            пусть адрес = harant.адрес_страницы(пар.раздел, страница)
            пусть задача = запустить harant.загрузить_страницу(адрес, пар.название_раздела)
            пока не задача.готова {
                пусть итог = ждать_во_время_проверки(п, 100)
                если итог == 1 {
                    отменено = истина
                    работает = ложь
                } иначе если итог == 2 {
                    отменено = истина
                    закрыть = истина
                }
            }
            перем страница_ленты = harant.Страница(ложь, [])
            если пусть р = задача.дождаться() {
                страница_ленты = р
            } иначе ошибка о {
                сбой = стр(о)
            }
            если сбой != "" или отменено или не страница_ленты.есть { прервать }
            если страница_ленты.вопросы.длина == 0 {
                сбой = "на странице не найдено ни одного вопроса - возможно, сайт изменил вёрстку"
                прервать
            }
            перем новые: [harant.Вопрос] = []
            если пусть сохранённые = harant.сохранить(база, страница_ленты.вопросы) {
                новые = сохранённые
            } иначе ошибка о {
                сбой = "база: " + стр(о)
                прервать
            }
            новых_всего += новые.длина
            для вп в новые {
                пусть по_разделу = пар.название_раздела == "" или вп.раздел == пар.название_раздела
                если не первичный и по_разделу и harant.подходит(вп, пар.без_ответов, пар.слова) {
                    новых_подходящих.добавить(вп)
                    новые_сеанса[вп.номер] = истина
                }
            }
            // страница без новых вопросов: дальше по ленте всё уже собрано
            если новые.длина == 0 { прервать }
            если страница < пар.страниц {
                // пауза 2 секунды между запросами к сайту, окно при этом отвечает
                пусть до = метка_времени() + 2.0
                пока метка_времени() < до и не отменено {
                    пусть итог = ждать_во_время_проверки(п, 200)
                    если итог == 1 {
                        отменено = истина
                        работает = ложь
                    } иначе если итог == 2 {
                        отменено = истина
                        закрыть = истина
                    }
                }
                если отменено { прервать }
            }
        }
        п.полоса.задать_значение(100)
        проверок += 1
        последняя = сейчас()
        следующая = метка_времени() + 60.0 * пар.интервал

        если сбой != "" {
            журнал.вставить(0, время(последняя) + "  Ошибка проверки: " + сбой)
            зажечь(п, "красная")
        } иначе если отменено {
            журнал.вставить(0, время(последняя) + "  Проверка прервана")
            зажечь(п, "серая")
        } иначе {
            для вп в новых_подходящих {
                журнал.вставить(0, "      ★ № " + стр(вп.номер) + "  [" + вп.раздел + "]  " + вп.заголовок)
            }
            если первичный {
                журнал.вставить(0, время(последняя) + "  Первичный сбор: в базу сохранено вопросов " + стр(новых_всего) + ". Дальше новые вопросы будут отмечаться ★")
            } иначе {
                журнал.вставить(0, время(последняя) + "  Проверка выполнена: новых вопросов " + стр(новых_всего) + ", из них подходящих ★ " + стр(новых_подходящих.длина))
            }
            если работает { зажечь(п, "зелёная") } иначе { зажечь(п, "серая") }
        }
        пока журнал.длина > 300 { журнал.удалить(журнал.длина - 1) }
        п.журнал.задать_строки(журнал)

        если сбой == "" и не отменено {
            // список перечитывается после каждой проверки: меняется и число ответов
            все = harant.из_базы(база, "", 3000) иначе все
            в_базе = harant.сколько_в_базе(база) иначе в_базе
            нужно_обновить_список = истина
            если пар.обновлять_excel {
                если ошибка о = harant.выгрузить(база, ТАБЛИЦА, пар.название_раздела, пар.без_ответов, пар.слова) {
                    журнал.вставить(0, время(сейчас()) + "  Таблица " + ТАБЛИЦА + " не обновлена (возможно, открыта в Excel): " + стр(о))
                    п.журнал.задать_строки(журнал)
                }
            }
        }
        если новые_сеанса.длина > 0 {
            п.окно.задать_заголовок("(" + стр(новые_сеанса.длина) + " ★) Монитор вопросов HARANT.RU")
        }
        кнопки_при_работе(п, работает, ложь)
        прошлая_сводка = ""
        если пар.оповещать и новых_подходящих.длина > 0 и не закрыть {
            перем т = "Новых вопросов: " + стр(новых_подходящих.длина) + "\n"
            для к в 0..мин(новых_подходящих.длина, 10) - 1 {
                т = т + "\n• " + новых_подходящих[к].заголовок
            }
            окна.сообщение("HARANT: новые вопросы", т)
        }
    }

    // ---- список вопросов ----
    если нужно_обновить_список {
        нужно_обновить_список = ложь
        пусть пар = прочитать_параметры(п)
        пусть выбранный_номер = если_есть_номер(показанные, п.список.выбранный())
        показанные = для_показа(все, макс(п.показ.выбранный(), 0), пар, п.поиск.текст(), новые_сеанса)
        п.список.задать_строки(показанные.преобразовать(функ(вп: harant.Вопрос) = строка_списка(вп, новые_сеанса)))
        п.показано.задать_текст("Показано: " + стр(показанные.длина) + " из " + стр(все.длина))
        // оставить выбранным тот же вопрос, если он остался в списке
        перем выбрать = -1
        для к в 0..показанные.длина - 1 {
            если показанные[к].номер == выбранный_номер { выбрать = к }
        }
        если выбрать >= 0 {
            п.список.выбрать(выбрать)
        } иначе {
            п.текст.задать_текст("")
        }
    }

    // ---- строка состояния ----
    перем сводка = "В базе: " + стр(в_базе) + "   Проверок: " + стр(проверок) + "   Новых ★: " + стр(новые_сеанса.длина)
    если последняя != "" { сводка = сводка + "   Последняя проверка: " + время(последняя) }
    если сводка != прошлая_сводка {
        п.сводка.задать_текст(сводка)
        прошлая_сводка = сводка
    }
    если работает {
        пусть осталось = цел(следующая - метка_времени())
        пусть т = "Мониторинг работает. Следующая проверка через " + минуты_секунды(осталось)
        если п.состояние.текст() != т { п.состояние.задать_текст(т) }
    } иначе если п.состояние.текст().начинается("Идёт проверка") {
        п.состояние.задать_текст("Мониторинг остановлен")
    }
}

база.закрыть()

// Номер вопроса в строке списка «н» или 0
функ если_есть_номер(показанные: [harant.Вопрос], н: цел) -> цел {
    если н >= 0 и н < показанные.длина { вернуть показанные[н].номер }
    вернуть 0
}
