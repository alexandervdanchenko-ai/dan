// Сбор вопросов с сайта HARANT.RU из командной строки (оконная панель
// мониторинга - программа монитор_harant.dan).
//
// Программа листает общедоступную ленту вопросов https://harant.ru/questions/
// (или ленту одного раздела, например «Трудовое право»), выбирает из каждой
// карточки номер, дату, раздел, автора, заголовок, полный текст и число
// ответов юристов и складывает всё увиденное в базу SQLite без повторов.
// Вопросы, подходящие под отбор, выгружаются в таблицу Excel и в CSV и
// печатаются. Вход в личный кабинет не нужен.
//
// Запуск (все настройки необязательны, порядок любой):
//
//     python dan.py запустить сбор_вопросов.dan
//     python dan.py запустить сбор_вопросов.dan раздел=trudovye-spory страниц=10
//     python dan.py запустить сбор_вопросов.dan без_ответов=да слова=увольн,зарплат
//     python dan.py запустить сбор_вопросов.dan следить=10
//     python dan.py запустить сбор_вопросов.dan разделы
//
// Настройки:
//     раздел=код        только один раздел (список кодов - команда «разделы»)
//     страниц=5         сколько страниц ленты пройти (на странице 20 вопросов)
//     без_ответов=да    в таблицу - только вопросы, на которые ещё никто не ответил
//     слова=а,б         в таблицу - только вопросы, где в заголовке или тексте есть
//                       хотя бы одно из слов (без учёта регистра; можно начало слова)
//     следить=10        не завершаться, а проверять новые вопросы каждые 10 минут
//     база=файл.db      файл базы (по умолчанию вопросы_harant.db)
//     файл=стр.html     разобрать сохранённую страницу вместо загрузки с сайта
//
// В базу попадают все увиденные вопросы, поэтому число ответов обновляется
// у всех, а смена отбора не требует повторного сбора. Повторный запуск
// дописывает только новые вопросы. Между запросами к сайту - пауза 2 секунды;
// при наблюдении сбой связи не останавливает программу: она повторит попытку
// при следующей проверке.

подключить "harant.dan"
подключить "sqlite"

тип Настройки {
    раздел: стр = ""
    страниц: цел = 5
    без_ответов: лог = ложь
    слова: [стр] = []
    следить: цел = 0
    база: стр = "вопросы_harant.db"
    файл: стр = ""
}

функ да_или_нет(з: стр) -> лог {
    пусть м = з.строчные()
    вернуть м == "да" или м == "1" или м == "истина"
}

функ прочитать_настройки(значения: [стр]) -> Настройки! {
    перем н = Настройки()
    для а в значения {
        пусть к = а.найти("=")
        если к <= 0 { вернуть ошибка("непонятная настройка «" + а + "»: нужно имя=значение") }
        пусть имя = а[0..к - 1].строчные()
        перем значение = ""
        если к < а.длина - 1 { значение = а[к + 1..а.длина - 1] }
        выбор имя {
            "раздел" { н.раздел = значение }
            "страниц" {
                н.страниц = разобрать_цел(значение)!
                если н.страниц < 1 { вернуть ошибка("страниц должно быть не меньше 1") }
            }
            "без_ответов" { н.без_ответов = да_или_нет(значение) }
            "слова" { н.слова = harant.разобрать_слова(значение) }
            "следить" {
                н.следить = разобрать_цел(значение)!
                если н.следить < 0 { вернуть ошибка("следить - число минут, 0 или больше") }
            }
            "база" { н.база = значение }
            "файл" { н.файл = значение }
            иначе { вернуть ошибка("неизвестная настройка «" + имя + "»") }
        }
    }
    если н.раздел != "" и не harant.разделы().содержит(н.раздел) {
        вернуть ошибка("неизвестный раздел «" + н.раздел + "»; список: команда «разделы»")
    }
    вернуть н
}

функ показать(вп: harant.Вопрос) {
    вывод("")
    вывод("№ " + стр(вп.номер) + " | " + вп.дата + " | " + вп.раздел + " | ответов: " + стр(вп.ответов))
    вывод(вп.заголовок)
    перем кратко = вп.текст.заменить("\n", " ")
    если кратко.длина > 300 { кратко = кратко[0..299] + "..." }
    вывод(кратко)
    вывод(вп.адрес)
}

функ отобрать(вопросы: [harant.Вопрос], н: Настройки) -> [harant.Вопрос] {
    вернуть вопросы.отобрать(функ(вп: harant.Вопрос) = harant.подходит(вп, н.без_ответов, н.слова))
}

// Один проход по ленте; результат - число новых подходящих вопросов
функ проход(база: sqlite.База, н: Настройки, первый: лог) -> цел! {
    пусть название = harant.разделы().получить(н.раздел, "")
    перем всего_новых = 0
    для страница в 1..н.страниц {
        пусть адрес = harant.адрес_страницы(н.раздел, страница)
        вывод("Страница " + стр(страница) + ": " + адрес)
        пусть с = harant.загрузить_страницу(адрес, название)!
        если не с.есть {
            вывод("  страниц больше нет")
            прервать
        }
        если с.вопросы.длина == 0 {
            вывод("  на странице не найдено ни одного вопроса - возможно, сайт изменил вёрстку")
            прервать
        }
        // в базу - все вопросы страницы; отбор - только для показа и таблицы
        пусть новые = harant.сохранить(база, с.вопросы)!
        пусть новые_подходящие = отобрать(новые, н)
        вывод("  вопросов: " + стр(с.вопросы.длина) + ", новых: " + стр(новые.длина) + ", из них подходящих: " + стр(новые_подходящие.длина))
        если не первый { для вп в новые_подходящие { показать(вп) } }
        всего_новых += новые_подходящие.длина
        // при наблюдении страница без единого ранее не виденного номера значит, что дальше всё уже собрано
        если не первый и новые.длина == 0 { прервать }
        если страница < н.страниц { пауза(2) }
    }
    вернуть всего_новых
}

// ---------------------------------------------------------------------------
// Главная часть

пусть значения = аргументы()

если значения.длина == 1 и значения[0] == "разделы" {
    вывод("Разделы HARANT.RU (код для настройки раздел=...):")
    пусть р = harant.разделы()
    для код в р { вывод("  " + код + " - " + р[код]) }
    завершить(0)
}

перем н = Настройки()
если пусть прочитанные = прочитать_настройки(значения) {
    н = прочитанные
} иначе ошибка о {
    вывод("Ошибка: " + стр(о))
    вывод("Подсказка - в начале файла программы.")
    завершить(2)
}

перем таблица = н.база
если таблица.оканчивается(".db") { таблица = таблица[0..таблица.длина - 4] }
таблица = таблица + ".xlsx"

пусть название_раздела = harant.разделы().получить(н.раздел, "")
пусть база = harant.открыть_базу(н.база)!

если н.файл != "" {
    // разбор сохранённой страницы (Файл - Сохранить как - «Веб-страница, только HTML»)
    пусть html = стр(прочитать_байты(н.файл))
    пусть все = harant.разобрать_страницу(html, harant.разделы().получить(н.раздел, ""))
    пусть новые = harant.сохранить(база, все)!
    пусть подходящие = отобрать(новые, н)
    вывод("В файле вопросов: " + стр(все.длина) + ", новых в базе: " + стр(новые.длина) + ", из них подходящих: " + стр(подходящие.длина))
    для вп в подходящие { показать(вп) }
} иначе {
    перем первый = истина
    пока истина {
        вывод("== " + сейчас() + " ==")
        если пусть новых = проход(база, н, первый) {
            вывод("Новых подходящих вопросов за проход: " + стр(новых))
            первый = ложь
        } иначе ошибка о {
            вывод("Проход не удался: " + стр(о))
            если н.следить == 0 { завершить(1) }
            вывод("Повтор при следующей проверке")
        }
        если н.следить == 0 { прервать }
        // таблица обновляется после каждого прохода: в ней меняется и число ответов
        если пусть в_файле = harant.выгрузить(база, таблица, название_раздела, н.без_ответов, н.слова) {
            вывод("Таблица обновлена, в ней вопросов: " + стр(в_файле))
        } иначе ошибка о {
            вывод("Таблица не обновлена (возможно, открыта в Excel): " + стр(о))
        }
        вывод("Следующая проверка через " + стр(н.следить) + " мин. (остановить - Ctrl+C)")
        пауза(н.следить * 60)
    }
}

пусть в_таблице = harant.выгрузить(база, таблица, название_раздела, н.без_ответов, н.слова)!
вывод("")
вывод("В таблице вопросов (подходящих под отбор): " + стр(в_таблице) + ", всего в базе: " + стр(harant.сколько_в_базе(база)!))
вывод("Таблица: " + таблица + " и " + таблица.заменить(".xlsx", ".csv"))
база.закрыть()
