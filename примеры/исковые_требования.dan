// Расчёт исковых требований на языке Дан: перечисления, «выбор»,
// функции как значения. Суммы и сроки вымышлены.

тип Требование {
    Задолженность(описание: стр, сумма: рац)
    Компенсация(сумма: рац, ключевая_ставка: рац, дней: цел)    // ст. 236 ТК РФ
    Проценты(сумма: рац, ставка: рац, дней: цел)                // ст. 395 ГК РФ
    МоральныйВред(сумма: рац)
}

функ размер(т: Требование) -> рац {
    выбор т {
        Задолженность(_, с) { вернуть с }
        Компенсация(с, ставка, дней) { вернуть компенсация_за_задержку(с, ставка, дней) }
        Проценты(с, ставка, дней) { вернуть проценты_за_дни(с, ставка, дней, 365) }
        МоральныйВред(с) { вернуть с }
    }
}

функ название(т: Требование) -> стр {
    выбор т {
        Задолженность(описание, _) { вернуть описание }
        Компенсация(_, _, дней) { вернуть ("компенсация за задержку выплат (" + стр(дней) + " "
            + склонение(дней, "день", "дня", "дней") + ")") }
        Проценты(_, _, дней) { вернуть "проценты за пользование чужими средствами" }
        МоральныйВред(_) { вернуть "компенсация морального вреда" }
    }
}

// Моральный вред не входит в цену иска по имущественным требованиям
функ имущественное(т: Требование) -> лог {
    выбор т {
        МоральныйВред { вернуть ложь }
        иначе { вернуть истина }
    }
}

пусть требования = [
    Задолженность("задолженность по заработной плате", 185000),
    Задолженность("компенсация за неиспользованный отпуск", рац(4231250, 100)),
    Компенсация(рац(22731250, 100), 21, 94),
    МоральныйВред(50000)
]

вывод("Исковые требования:")
перем номер = 0
для т в требования {
    номер += 1
    вывод("  " + стр(номер) + ". " + название(т) + ": " + сумма_цифрами(округлить(размер(т), 2)) + " руб.")
}

пусть цена_иска = требования.отобрать(имущественное).преобразовать(размер).свернуть(рац(0), функ(итог, с) = итог + с)
вывод("Цена иска: " + сумма_цифрами(цена_иска) + " руб.")
вывод("(" + сумма_прописью(цена_иска) + ")")

пусть крупные = требования.отобрать(функ(т) = размер(т) > 100000)
вывод("Требований свыше 100 000 руб.: " + стр(крупные.длина))
