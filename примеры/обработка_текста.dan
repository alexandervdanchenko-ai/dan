// Обработка текста на языке Дан: разбор списка работников и подготовка
// данных для документа.

пусть исходный = "  иванов иван иванович; ВОДИТЕЛЬ; 65000\n" + "петров пётр петрович; кладовщик; 52000\n" + "  сидорова анна сергеевна; бухгалтер; 78000  "

функ с_заглавной(слово: стр) -> стр {
    если слово.длина == 0 { вернуть слово }
    вернуть слово[0].прописные() + слово[1..слово.длина - 1].строчные()
}

функ инициалы(фио: стр) -> стр {
    пусть части = фио.разбить()
    вернуть с_заглавной(части[0]) + " " + части[1][0].прописные() + "." + части[2][0].прописные() + "."
}

перем итого = 0
перем строки_таблицы: [стр] = []
для строка в исходный.разбить("\n") {
    пусть поля = строка.обрезать().разбить("; ")
    пусть фио = поля[0]
    пусть должность = поля[1].строчные()
    пусть оклад = цел(поля[2])
    итого += оклад
    строки_таблицы.добавить(инициалы(фио) + " - " + должность + ", оклад " + стр(оклад) + " руб.")
}

вывод("Список работников:")
для с в строки_таблицы { вывод("  " + с) }
вывод("Фонд оплаты труда: " + стр(итого) + " руб.")

// Поиск и замена в тексте документа
перем шаблон = "Работник {ФИО} принят на должность {ДОЛЖНОСТЬ}."
шаблон = шаблон.заменить("{ФИО}", "Иванов И.И.").заменить("{ДОЛЖНОСТЬ}", "водителя")
вывод(шаблон)
вывод("Слов в предложении: " + стр(шаблон.разбить().длина))
вывод("Есть ли слово «принят»: " + стр(шаблон.содержит("принят")))
