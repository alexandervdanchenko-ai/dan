функ ф1(а: цел, б: цел) -> цел {
    перем р = а
    вывод((рац(17, 2) + 7 / 3))
    р = 3
    вернуть р + частное(26, 10)
}
функ ф2(а: цел, б: цел) -> цел {
    перем р = а
    вывод(модуль((б + б)))
    если 0.2 < (1e-7 * 3.0 + 0.333) {
        р = (а + р)
        вывод(стр((0.1 - 100.0)))
    }
    вывод(((0.2 * 3.0 + 100.0) * 0.1))
    вернуть р + р
}
функ ф3(а: цел, б: цел) -> цел {
    перем р = а
    вывод((рац(-4, 4) + 100 / 3))
    для к4 в 1..2 {
        вывод(стр(1099511627779))
        р = ((б - 2) - (65 % 10))
    }
    вывод((не (р > 1) или (0.1 + 0.2) > (-2.25 - 1e10)))
    р = р
    вернуть р + 3
}
функ рек5(н: цел) -> цел {
    если н <= 0 { вернуть 1 }
    вернуть рек5(н - 1) * -1 + н % 9
}
