тип Зап {
    ч: цел
    сп: [цел]
}
функ ф1(а: цел, б: цел) -> цел {
    перем р = а
    для к2 в 0..2 {
        р = (модуль(б) - (-1 - р))
        вывод(частное((р + -5), (а * а)))
    }
    вывод("")
    вернуть р + (а + б)
}
функ ф3(а: цел, б: цел) -> цел {
    перем р = а
    если (ф1(р, а) <= б или 100 != ф1(б, -64)) {
    }
    вернуть р + (100 + 100)
}
перем ц6 = 11
перем ц7 = 0
перем с9 = ""
перем сп10: [цел] = [9, -6, 9]
перем з12 = Зап(8, [1, -2])
для х14 в сп10 {
    вывод(ф1(ц6, ц6))
    ц6 = (з12.ч + 100)
}
для х15 в сп10 {
    для х16 в сп10 {
        ц7 = ф3((х15 - х16), с9.длина)
    }
}
