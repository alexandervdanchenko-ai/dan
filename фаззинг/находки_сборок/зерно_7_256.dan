функ ф1(а: цел, б: цел) -> цел {
    перем р = а
    вывод((рац(-17, 5) + б / 3))
    вывод("привет")
    перем сч2 = 0
    пока сч2 < 5 {
        сч2 += 1
        вывод("")
        вывод(3)
        вывод(0.333)
    }
    вывод(((1 + б) + частное(0, 1000)))
    вернуть р + модуль(-5)
}
функ рек3(н: цел) -> цел {
    если н <= 0 { вернуть 1 }
    вернуть рек3(н - 1) * -1 + н % 5
}
