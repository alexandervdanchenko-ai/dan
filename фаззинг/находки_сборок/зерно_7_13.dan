функ ф1(а: цел, б: цел) -> цел {
    перем р = а
    р = частное(модуль(10), 1)
    вернуть р + (а + р)
}
функ ф2(а: цел, б: цел) -> цел {
    перем р = а
    р = ((р + б) * частное(-1, -1))
    если не (100 > р) {
        вывод(((а * 12345) + (б + р)))
        вывод((корень(модуль(1e10)) * (-2.25 * 1.5 + 1e-7) + 100.0))
    } иначе {
        вывод(р)
        вывод(не (1099511627779 > а))
        вывод(((б * б) * модуль(а)))
    }
    р = (10 - р)
    р = а
    вернуть р + модуль(р)
}
функ ф3(а: цел, б: цел) -> цел {
    перем р = а
    вывод("")
    вывод(ф1((а + 100), (-5 * р)))
    вернуть р + (б - 12345)
}
функ рек4(н: цел) -> цел {
    если н <= 0 { вернуть 1 }
    вернуть рек4(н - 1) * 3 + н % 5
}
перем ц5 = -11
перем ц6 = 0
перем д7 = 1.25
перем с8 = "дом"
перем сп9: [цел] = []
перем сл10: {стр: цел} = {"а": 1}
д7 = ((д7 / 0.333) + ц6)
сп9.добавить(ц5)
перем сч11 = 0
пока сч11 < 3 {
    сч11 += 1
    для х12 в сп9 {
        вывод(с8 + "ab")
    }
    сп9.добавить(ц6)
    д7 = ((0.2 + 0.333) * д7 + д7)
}
д7 = 1e-7
вывод(((д7 + 0.333) * 1e10 + д7))
ц6 = ((ц5 % 3) * (ц5 + ц6))
вывод(сп9)
ц5 = ((ц5 - 10) * 2)
ц5 = ц6
вывод(((д7 + 1) + 1099511627779))
ц6 = сп9.длина
вывод(ф2((ц6 - ц5), (ц6 + 2147483648)))
ц5 = ((1099511627779 + -5) + сп9.длина)
для к13 в -2..4 {
    сп9.добавить((ц6 + к13))
    перем сч14 = 0
    пока сч14 < 2 {
        сч14 += 1
        вывод((рац(3, 12) + сч14 / 9))
        вывод(сл10)
    }
    вывод(рек4(11))
}
вывод(ц5)
вывод(ц6)
вывод(д7)
вывод(с8)
вывод(сп9)
вывод(сл10)
