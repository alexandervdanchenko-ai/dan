функ ф1(а: цел, б: цел) -> цел {
    перем р = а
    вывод(((1.5 - 0.2) / 3.0))
    вывод(частное((-1 * 3), -4))
    вывод("привет")
    вывод("x y z")
    вернуть р + б
}
функ ф2(а: цел, б: цел) -> цел {
    перем р = а
    вывод((частное(2, 1000) % 7))
    вывод(а)
    вернуть р + (а * а)
}
функ ф3(а: цел, б: цел) -> цел {
    перем р = а
    вывод(модуль(-5) > (р - б))
    р = модуль(10)
    вывод((0.2 + р))
    вернуть р + а
}
функ рек4(н: цел) -> цел {
    если н <= 0 { вернуть 1 }
    вернуть рек4(н - 1) * 7 + н % 5
}
перем ц5 = -23
