функ ф1(а: цел, б: цел) -> цел {
    перем р = а
    для к2 в -1..3 {
        вывод(частное(12345, -5) <= модуль(б))
        р = ((2 + 2147483648) - 7)
    }
    р = а
    для к3 в 2..2 {
        р = (частное(к3, б) + (б % 0))
    }
    вывод((а % 10) <= (б % 7))
    вернуть р + модуль(-5)
}
функ ф4(а: цел, б: цел) -> цел {
    перем р = а
    если (не (а > р) или (б - 2147483648) >= (б - -27)) {
        вывод(стр((1e10 + 0.333)))
        вывод((рац(-1, 2) + б / 3))
    }
    вывод(модуль(б) == частное(7, 2))
    р = частное((р + а), 2)
    перем сч5 = 0
    пока сч5 < 3 {
        сч5 += 1
        вывод(корень(модуль((1e-7 * -2.25))))
        р = (-57 % 1)
        р = ((сч5 - а) * (сч5 % 100))
    }
    вернуть р + модуль(2)
}
функ ф6(а: цел, б: цел) -> цел {
    перем р = а
    вывод(((2147483648 % 2) % (2 + -5)))
    вывод(ф4((а - р), (2 % 1000)))
    вывод(ф1((б + р), (3 + б)))
    вывод(б)
    вернуть р + (7 - б)
}
функ рек7(н: цел) -> цел {
    если н <= 0 { вернуть 1 }
    вернуть рек7(н - 1) * 2 + н % 9
}
