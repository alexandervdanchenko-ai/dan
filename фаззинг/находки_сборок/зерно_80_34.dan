    с11 = стр(д10)
} иначе {
    вывод(ф4((-56 % 1000), (ц9 % 3)))
}
ц9 = ((ц8 + ц9) * частное(3, 1))
если сп12.длина > 0 { сп12[модуль(частное(ц8, 7)) % сп12.длина] = (86 - 12345) }
с11 = с11
