функ ф1(а: цел, б: цел) -> цел {
    перем р = а
    р = (модуль(12345) * модуль(а))
    если (не (3 > б) или (1e-7 - 0.2) < (100.0 + р)) {
        вывод((частное(1099511627779, -4) + а))
    }
    вернуть р + модуль(12345)
}
функ рек2(н: цел) -> цел {
    если н <= 0 { вернуть 1 }
    вернуть рек2(н - 1) * 7 + н % 2
}
перем ц3 = -3
перем ц4 = 0
перем д5 = 0.5
перем с6 = "а"
перем сп7: [цел] = [-8]
перем сл8: {стр: цел} = {"а": 1}
сп7.добавить(1)
вывод(ф1(-1, -5))
для к9 в 2..4 {
    д5 = ((1e10 * д5 + д5) + д5)
}
ц3 = ((ц3 * 1099511627779) + (7 * ц4))
сп7.добавить((ц3 + -26))
вывод(рек2(3))
вывод(ц3)
вывод(ц4)
вывод(д5)
вывод(с6)
вывод(сп7)
вывод(сл8)
