перем д10 = -3.0
перем с11 = ""
перем сп12: [цел] = [-6, -1]
перем сл13: {стр: цел} = {"а": 1}
если не (2147483648 > ц9) {
    если сп12.длина > 0 { сп12[модуль((ц8 + ц8)) % сп12.длина] = (3 + ц9) }
    если сп12.длина > 0 { сп12[модуль(с11.длина) % сп12.длина] = (ц8 + ц8) }
    д10 = (д10 * корень(модуль(100.0)))
} иначе {
    вывод(с11 < "а")
    сл13[с11] = сл13.получить(с11, 0) + 100
}
д10 = ((д10 * 3.0 + д10) * корень(модуль(0.2)) + д10)
сп12.добавить((ц8 % 10))
с11 = с11 + "ab"
ц9 = ц9
сл13["б"] = сл13.получить("б", 0) + ц9
ц8 = сп12.длина
ц8 = (2147483648 - с11.длина)
сп12.добавить(ц9)
перем сч14 = 0
пока сч14 < 1 {
    сч14 += 1
    ц9 = -1
    если с11 == "" {
        сп12.добавить(сп12.длина)
        ц9 = (ц9 + (сч14 - сч14))
        ц8 = ((ц9 * ц9) - 100)
    } иначе {
        сл13["б"] = сл13.получить("б", 0) + -5
    }
    если 12345 <= ц8 {
        д10 = (корень(модуль(д10)) * (д10 + д10))
        вывод(сп12)
        вывод(рек7(2))
    } иначе {
        вывод(ц8)
    }
}
сп12.добавить((ц9 + 2))
ц9 = ц8
вывод(ц8)
вывод(ц9)
вывод(д10)
вывод(с11)
вывод(сп12)
вывод(сл13)
