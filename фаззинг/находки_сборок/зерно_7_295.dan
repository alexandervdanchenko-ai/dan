функ ф1(а: цел, б: цел) -> цел {
    перем р = а
    если модуль(а) >= модуль(а) {
        вывод((0.333 / корень(модуль(0.333))))
        вывод((не (100 > 1099511627779) и не (б > а)))
    }
    р = р
    для к2 в 0..4 {
        вывод(к2)
        р = (частное(1099511627779, 3) * (р + к2))
    }
    вывод(10)
    вернуть р + (а + р)
}
функ ф3(а: цел, б: цел) -> цел {
    перем р = а
    вывод(не (а > р))
    для к4 в -2..5 {
        вывод((модуль(7) + модуль(12345)))
        вывод((48 - (12345 - 1)))
    }
    вывод(((-2.25 - 0.1) + 2147483648))
    вывод((рац(16, 1) + б / 9))
    вернуть р + а
}
функ ф5(а: цел, б: цел) -> цел {
    перем р = а
    для к6 в 1..5 {
        вывод(корень(модуль(1e10)))
        вывод((рац(1, 1) + 100 / 3))
    }
    вывод(ф1(частное(12345, 2), модуль(7)))
    вывод(1099511627779)
    вернуть р + (12345 + р)
}
функ рек7(н: цел) -> цел {
    если н <= 0 { вернуть 1 }
    вернуть рек7(н - 1) * 3 + н % 9
}
перем ц8 = -3
