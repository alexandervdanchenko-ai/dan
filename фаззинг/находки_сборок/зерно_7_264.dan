функ ф1(а: цел, б: цел) -> цел {
    перем р = а
    для к2 в 0..0 {
        вывод(не (3 > 1099511627779))
        вывод(стр(б))
    }
    вывод(не (а > р))
    р = 1099511627779
    вывод((рац(1, 7) + р / 7))
    вернуть р + модуль(р)
}
функ ф3(а: цел, б: цел) -> цел {
    перем р = а
    вывод(модуль((-1 * р)))
    вывод(ф1((2147483648 + -1), (-66 * р)))
    если 3.0 > (0.333 * 0.2) {
        вывод(модуль(а))
    } иначе {
        вывод(стр((а - б)))
        р = -1
    }
    р = модуль((100 + 7))
    вернуть р + (3 + -1)
}
функ ф4(а: цел, б: цел) -> цел {
    перем р = а
    если (2147483648 < (р + 2) и не (-1 > б)) {
        р = ((б + б) + б)
    }
    вернуть р + (а - б)
}
функ рек5(н: цел) -> цел {
    если н <= 0 { вернуть 1 }
    вернуть рек5(н - 1) * 2 + н % 2
}
перем ц6 = 1
перем ц7 = 0
перем д8 = 1.25
перем с9 = "дом"
перем сп10: [цел] = []
перем сл11: {стр: цел} = {"а": 1}
перем сч12 = 0
пока сч12 < 4 {
    сч12 += 1
    сл11[с9] = сл11.получить(с9, 0) + ц6
    если (-2.25 * 0.2) > корень(модуль(д8)) {
        ц6 = ц7
        вывод(с9.заменить("а", "ё"))
    } иначе {
        сп10.добавить((сч12 - ц6))
    }
    вывод(сп10)
}
если (1.5 + д8) > д8 {
    если сп10.длина > 0 { сп10[модуль((ц7 % ц6)) % сп10.длина] = ц7 }
    для к13 в -2..4 {
        ц7 = ((ц7 - 12345) - (к13 + ц7))
    }
    д8 = (д8 * (д8 + 0.2) + 0.1)
}
ц7 = с9.длина
если сп10.длина > 0 { сп10[модуль((ц6 - ц6)) % сп10.длина] = (ц6 + 2147483648) }
сп10.добавить(ц6)
вывод(((-2.25 + ц7) - (д8 - д8)))
вывод(ц6)
вывод(ц7)
вывод(д8)
вывод(с9)
вывод(сп10)
вывод(сл11)
