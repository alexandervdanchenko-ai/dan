функ ф1(а: цел, б: цел) -> цел {
    перем р = а
    если (б > а или не (б > 0)) {
        вывод(б)
        вывод((рац(9, 5) + 2 / 7))
        вывод((10 + р))
    }
    вывод(корень(модуль(-2.25)))
    вывод((не (12345 > б) или р != частное(-1, 3)))
    вернуть р + (р * -5)
}
функ ф2(а: цел, б: цел) -> цел {
    перем р = а
    вывод(р)
    вернуть р + модуль(р)
}
функ ф3(а: цел, б: цел) -> цел {
    перем р = а
    вывод(ф1((10 - а), р))
    вернуть р + (2147483648 - р)
}
функ рек4(н: цел) -> цел {
    если н <= 0 { вернуть 1 }
    вернуть рек4(н - 1) * 3 + н % 5
}
перем ц5 = 12
перем ц6 = 0
перем д7 = 0.5
перем с8 = "а"
перем сп9: [цел] = [-7, 7]
перем сл10: {стр: цел} = {"а": 1}
сл10["а"] = сл10.получить("а", 0) + -1
если сп9.длина > 0 { сп9[модуль((ц5 + ц5)) % сп9.длина] = (ц5 - ц5) }
сл10[с8] = сл10.получить(с8, 0) + 3
д7 = (корень(модуль(100.0)) * 1.5 + 0.1)
ц5 = ((12345 + -1) + (1099511627779 - ц5))
если сп9.длина > 0 { сп9[модуль((ц6 % 2)) % сп9.длина] = с8.длина }
вывод(не (ц5 > 12345))
ц6 = (-97 * (-5 + -1))
ц5 = (ц5 - (ц6 * 1099511627779))
для к11 в -2..2 {
    если (с8.длина < (ц5 - ц5) или ц5 == (-86 + 12345)) {
        ц6 = (с8.длина + (ц6 + 0))
    } иначе {
        д7 = ((д7 + 1099511627779) * (д7 + 0.1) + 1e10)
    }
    ц6 = 10
    д7 = (д7 - 1e10)
}
для к12 в -1..0 {
    ц6 = (ц5 - (1 * 0))
}
с8 = с8.заменить("а", "ё")
вывод(ц5)
вывод(ц6)
вывод(д7)
вывод(с8)
вывод(сп9)
вывод(сл10)
