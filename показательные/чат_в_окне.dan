// Локальный чат с языковой моделью в окне: модель работает на компьютере (движок «нейро» на Дане,
// без llama.cpp и без сети), ответ появляется по мере порождения, кнопка «Стоп» прерывает его.
//
//     dan собрать показательные/чат_в_окне.dan
//     чат_в_окне модель.gguf ["указание для модели"]
//
// Окна есть в Windows. Режим без окна (в любой системе) отвечает на вопросы из командной строки тем
// же пошаговым порождением, что и окно; с --сверить он проверяет, что ответ побайтно тот же, что
// у порождения без прерываний (нейро.Модель.чат):
//
//     чат_в_окне --без-окна [--сверить] модель.gguf "вопрос" ["вопрос" ...]
//
// Модель - файл GGUF архитектуры llama или qwen2 (раздел 11.30 описания языка). Порождение идёт
// шагами по 40 мс между событиями окна (нейро.Прерывание): окно не замирает, а после прерывания
// ответ продолжается с того же места.

подключить "нейро"
подключить "окна"

/// Разговор: сообщения и сеанс ответа, который сейчас порождается.
тип Разговор {
    указание: стр
    история: [нейро.Сообщение] = []
    /// ответ порождается
    идёт: лог = ложь
}

/// Сообщения для модели: указание (если есть) и история разговора.
функ сообщения(р: Разговор) -> [нейро.Сообщение] {
    перем итог: [нейро.Сообщение] = []
    если р.указание != "" { итог.добавить(нейро.Сообщение("system", р.указание)) }
    для с в р.история { итог.добавить(с) }
    вернуть итог
}

/// Текст ленты разговора: реплики по очереди и, пока ответ идёт, его начало.
функ лента(р: Разговор, начало_ответа: стр) -> стр {
    перем части: [стр] = []
    для с в р.история {
        если с.роль == "user" { части.добавить("Вы: " + с.текст) } иначе { части.добавить("Модель: " + с.текст) }
    }
    если р.идёт { части.добавить("Модель: " + начало_ответа + " ...") }
    вернуть части.соединить("\r\n\r\n")
}

/// Ответ закончен: шагов больше не будет, и его текст уходит в историю.
функ закончен(причина: стр) -> лог {
    вернуть причина == "конец" или причина == "предел" или причина == "получатель" или причина == "ошибка"
}

/// Пустая строка, если вопрос можно задать, иначе причина.
функ можно_спросить(р: Разговор, вопрос: стр) -> стр {
    если р.идёт { вернуть "модель ещё отвечает: дождитесь ответа или нажмите «Стоп»" }
    если вопрос.обрезать() == "" { вернуть "напишите вопрос" }
    вернуть ""
}

функ выборка() -> нейро.Выборка { вернуть нейро.Выборка(температура = 0.0, максимум_токенов = 512) }

/// Ответ на вопрос тем же пошаговым порождением, что в окне (по одному шагу за вызов).
функ ответ_по_шагам(м: нейро.Модель, р: Разговор) -> стр! {
    перем с = м.начать_ответ(м.запрос_чата(сообщения(р))!, выборка())
    пока истина {
        с = м.генерировать(с, нейро.Прерывание(шагов = 1), функ(ч: стр) -> лог { вернуть истина })
        если с.ход.причина == "ошибка" { вернуть ошибка(с.ошибка) }
        если закончен(с.ход.причина) { прервать }
    }
    вернуть с.ход.текст()
}

/// Режим без окна: вопросы из командной строки, ответы - в вывод.
функ без_окна(путь: стр, вопросы: [стр], сверить: лог) -> ! {
    пусть м = нейро.загрузить(путь)!
    перем р = Разговор("")
    для вопрос в вопросы {
        р.история.добавить(нейро.Сообщение("user", вопрос))
        пусть ответ = ответ_по_шагам(м, р)!
        если сверить {
            пусть сразу = м.чат(сообщения(р), выборка())!
            если сразу == ответ { вывод("совпадает: " + стр(ответ.длина) + " знаков") } иначе {
                вывод("РАЗЛИЧАЕТСЯ")
                вывод("по шагам: " + ответ)
                вывод("сразу: " + сразу)
            }
        } иначе {
            вывод("Модель: " + ответ)
        }
        р.история.добавить(нейро.Сообщение("assistant", ответ))
    }
}

/// Окно чата: лента, поле вопроса, кнопки «Отправить», «Стоп», «Новый разговор».
функ в_окне(путь: стр, указание: стр) -> ! {
    пусть окно = окна.создать("Чат с моделью", 760, 600)!
    пусть показ = окно.многострочное_поле("Загрузка модели...", 10, 10, 740, 440)
    пусть вопрос = окно.поле("", 10, 462, 590, 28)
    пусть отправить = окно.кнопка("Отправить", 610, 460, 140, 32)
    пусть стоп = окно.кнопка("Стоп", 610, 500, 140, 32)
    пусть заново = окно.кнопка("Новый разговор", 10, 500, 180, 32)
    пусть строка = окно.надпись("", 10, 545, 740, 40)
    пусть м = нейро.загрузить(путь)!
    строка.задать_текст("Модель: " + м.архитектура + ", слоёв " + стр(м.слоёв) + ", словарь " + стр(м.размер_словаря))
    показ.задать_текст("")
    стоп.сделать_доступным(ложь)
    вопрос.фокус()
    перем р = Разговор(указание)
    перем с = м.начать_ответ("", выборка())
    пока истина {
        // пока ответ идёт, окно спрашивается без ожидания, а между событиями считаются шаги
        перем событие = окна.Ожидание
        если р.идёт {
            если пусть е = окно.ждать_не_дольше(1) { событие = е } иначе { прервать }
        } иначе {
            если пусть е = окно.ждать() { событие = е } иначе { прервать }
        }
        выбор событие {
            окна.Нажатие(э) {
                если э == отправить {
                    пусть причина = можно_спросить(р, вопрос.текст())
                    если причина != "" {
                        строка.задать_текст(причина)
                    } иначе {
                        р.история.добавить(нейро.Сообщение("user", вопрос.текст().обрезать()))
                        вопрос.задать_текст("")
                        если пусть запрос = м.запрос_чата(сообщения(р)) {
                            с = м.начать_ответ(запрос, выборка())
                            р.идёт = истина
                            стоп.сделать_доступным(истина)
                            отправить.сделать_доступным(ложь)
                            строка.задать_текст("Модель отвечает...")
                        } иначе ошибка о {
                            строка.задать_текст("Ошибка: " + о)
                        }
                    }
                } иначе если э == стоп и р.идёт {
                    // прерванный ответ остаётся в истории таким, каким успел стать
                    р.история.добавить(нейро.Сообщение("assistant", с.ход.текст()))
                    р.идёт = ложь
                    строка.задать_текст("Ответ остановлен")
                } иначе если э == заново и не р.идёт {
                    р = Разговор(указание)
                    строка.задать_текст("Новый разговор")
                }
            }
            иначе {}
        }
        если р.идёт {
            с = м.генерировать(с, нейро.Прерывание(срок_мс = 40), функ(ч: стр) -> лог { вернуть истина })
            если закончен(с.ход.причина) {
                р.идёт = ложь
                если с.ход.причина == "ошибка" {
                    строка.задать_текст("Ошибка: " + с.ошибка)
                } иначе {
                    р.история.добавить(нейро.Сообщение("assistant", с.ход.текст()))
                    строка.задать_текст("Готово: " + стр(с.ход.порождено) + " токенов")
                }
            }
        }
        стоп.сделать_доступным(р.идёт)
        отправить.сделать_доступным(не р.идёт)
        показ.задать_текст(лента(р, с.ход.текст()))
    }
}

пусть арг = аргументы()
если арг.длина > 0 и арг[0] == "--без-окна" {
    перем сверить = ложь
    перем остальные: [стр] = []
    для а в арг[1..арг.длина - 1] {
        если а == "--сверить" { сверить = истина } иначе { остальные.добавить(а) }
    }
    если остальные.длина < 2 {
        вывод("Укажите модель и вопросы: чат_в_окне --без-окна [--сверить] модель.gguf \"вопрос\"")
        завершить(2)
    }
    если ошибка о = без_окна(остальные[0], остальные[1..остальные.длина - 1], сверить) {
        вывод_ошибки(о)
        завершить(1)
    }
} иначе если арг.длина == 0 или арг[0] == "--справка" {
    вывод("Чат с языковой моделью в окне: чат_в_окне модель.gguf [\"указание для модели\"]")
    вывод("Без окна: чат_в_окне --без-окна [--сверить] модель.gguf \"вопрос\" [\"вопрос\" ...]")
} иначе {
    перем указание = ""
    если арг.длина > 1 { указание = арг[1] }
    если ошибка о = в_окне(арг[0], указание) {
        вывод_ошибки(о)
        завершить(1)
    }
}

тест "лента разговора" {
    перем р = Разговор("")
    р.история.добавить(нейро.Сообщение("user", "Привет"))
    р.история.добавить(нейро.Сообщение("assistant", "Здравствуйте"))
    утвердить_равно(лента(р, ""), "Вы: Привет\r\n\r\nМодель: Здравствуйте")
    р.идёт = истина
    утвердить(лента(р, "Отве").оканчивается("Модель: Отве ..."))
}

тест "когда можно спросить" {
    перем р = Разговор("")
    утвердить_равно(можно_спросить(р, "  "), "напишите вопрос")
    утвердить_равно(можно_спросить(р, "Как дела?"), "")
    р.идёт = истина
    утвердить(можно_спросить(р, "Как дела?").начинается("модель ещё отвечает"))
}

тест "указание идёт первым" {
    перем р = Разговор("Отвечай кратко")
    р.история.добавить(нейро.Сообщение("user", "Вопрос"))
    пусть с = сообщения(р)
    утвердить_равно(с.длина, 2)
    утвердить_равно(с[0].роль, "system")
    утвердить(закончен("конец") и закончен("предел") и не закончен("срок"))
}
