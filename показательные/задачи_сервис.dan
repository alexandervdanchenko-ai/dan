// Веб-сервис «Список задач»: REST на модулях вебсервер, sqlite и json.
//
//     GET    /задачи              все задачи (?готово=да или ?готово=нет - отбор)
//     POST   /задачи              новая задача: {"title": "Позвонить"} -> 201 и задача
//     GET    /задачи/{номер}      одна задача
//     PATCH  /задачи/{номер}      изменить: {"title": "...", "done": true} (любое из полей)
//     DELETE /задачи/{номер}      удалить -> 204
//
// Задача в JSON: {"id": 1, "title": "Позвонить", "done": false, "created": "2026-11-11 10:00:00"}.
// Ошибки - {"error": "текст"} с кодом 400, 404, 405 или 500. Задачи хранятся в базе SQLite
// (файл задачи.db, ключ --база), каждый запрос пишется в журнал (поток ошибок).
//
// Запуск: dan запустить задачи_сервис.dan -- --порт 8080
// Проверка: curl -d '{"title":"Позвонить"}' http://127.0.0.1:8080/задачи
// Первой строкой вывода программа печатает номер порта (с --порт 0 - любой свободный).
подключить "вебсервер"
подключить "sqlite"
подключить "json"
подключить "журнал"
подключить "командная_строка"

тип Задача {
    номер "id": цел
    заголовок "title": стр
    готово "done": лог
    создана "created": стр
}

// Тело POST: без "title" разбор даёт ошибку «нет поля «title»».
тип НоваяЗадача {
    заголовок "title": стр
}

// Тело PATCH: каждое поле можно не указывать.
тип Изменение {
    заголовок "title": стр? = ничего
    готово "done": лог? = ничего
}

тип Ошибка {
    текст "error": стр
}

тип Сервис {
    база: стр            // путь к файлу базы
    ж: журнал.Журнал
}

функ ответ_json(код: цел, текст: стр) -> вебсервер.Ответ {
    вернуть вебсервер.ответ(код, "application/json; charset=utf-8", байты(текст))
}

функ ошибка_json(код: цел, текст: стр) -> вебсервер.Ответ {
    вернуть ответ_json(код, json.записать(Ошибка(текст)))
}

функ подготовить(путь: стр) -> ! {
    пусть б = sqlite.открыть(путь)!
    б.выполнить("CREATE TABLE IF NOT EXISTS задачи (номер INTEGER PRIMARY KEY, заголовок TEXT NOT NULL, " +
        "готово INTEGER NOT NULL DEFAULT 0, создана TEXT NOT NULL)", [])!
    б.закрыть()
}

функ из_строки(с: {стр: sqlite.Значение}) -> Задача {
    вернуть Задача(с["номер"].как_цел() иначе 0, с["заголовок"].текст(), (с["готово"].как_цел() иначе 0) != 0,
        с["создана"].текст())
}

функ найти_задачу(б: sqlite.База, номер: цел) -> Задача?! {
    пусть строки = б.выбрать("SELECT * FROM задачи WHERE номер = ?", [sqlite.Целое(номер)])!
    если строки.длина == 0 { вернуть ничего }
    вернуть из_строки(строки[0])
}

функ проверить_заголовок(т: стр) -> стр! {
    пусть з = т.обрезать()
    если з == "" { вернуть ошибка("пустой заголовок") }
    если з.длина > 200 { вернуть ошибка("заголовок длиннее 200 знаков") }
    вернуть з
}

функ список(з: вебсервер.Запрос, б: sqlite.База) -> вебсервер.Ответ! {
    перем запрос = "SELECT * FROM задачи"
    если пусть г = з.параметр("готово") {
        выбор г {
            "да" { запрос = запрос + " WHERE готово = 1" }
            "нет" { запрос = запрос + " WHERE готово = 0" }
            иначе { вернуть ошибка_json(400, "готово: нужно «да» или «нет»") }
        }
    }
    перем задачи: [Задача] = []
    для с в б.выбрать(запрос + " ORDER BY номер", [])! {
        задачи.добавить(из_строки(с))
    }
    вернуть ответ_json(200, json.записать(задачи))
}

/// Заголовок новой задачи из тела POST или ошибка для ответа 400.
функ заголовок_новой(тело: стр) -> стр! {
    пусть новая = json.разобрать_в(тело, НоваяЗадача)!
    вернуть проверить_заголовок(новая.заголовок)
}

функ создать(з: вебсервер.Запрос, б: sqlite.База) -> вебсервер.Ответ! {
    перем заголовок = ""
    если пусть з_ = заголовок_новой(з.текст()) {
        заголовок = з_
    } иначе ошибка о {
        вернуть ошибка_json(400, о)
    }
    пусть создана = журнал.время()
    пусть итог = б.выполнить("INSERT INTO задачи (заголовок, создана) VALUES (?, ?)",
        [sqlite.Текст(заголовок), sqlite.Текст(создана)])!
    пусть задача = Задача(итог.последний_номер, заголовок, ложь, создана)
    вернуть ответ_json(201, json.записать(задача)).с_заголовком("Location", "/задачи/" + стр(задача.номер))
}

функ изменить(з: вебсервер.Запрос, б: sqlite.База, номер: цел) -> вебсервер.Ответ! {
    перем и_ = Изменение()
    если пусть разобранное = json.разобрать_в(з.текст(), Изменение) {
        и_ = разобранное
    } иначе ошибка о {
        вернуть ошибка_json(400, о)
    }
    если пусть т = и_.заголовок {
        если ошибка о = проверить_заголовок(т) {
            вернуть ошибка_json(400, о)
        }
        б.выполнить("UPDATE задачи SET заголовок = ? WHERE номер = ?",
            [sqlite.Текст(т.обрезать()), sqlite.Целое(номер)])!
    }
    если пусть г = и_.готово {
        перем значение = 0
        если г { значение = 1 }
        б.выполнить("UPDATE задачи SET готово = ? WHERE номер = ?", [sqlite.Целое(значение), sqlite.Целое(номер)])!
    }
    если пусть задача = найти_задачу(б, номер)! {
        вернуть ответ_json(200, json.записать(задача))
    }
    вернуть ошибка_json(404, "нет задачи " + стр(номер))
}

функ одна(з: вебсервер.Запрос, б: sqlite.База, номер_: стр) -> вебсервер.Ответ! {
    пусть номер = разобрать_цел(номер_) иначе -1
    если номер < 0 {
        вернуть ошибка_json(400, "номер задачи - целое неотрицательное число, а не «" + номер_ + "»")
    }
    перем задача = Задача(0, "", ложь, "")
    если пусть найдена = найти_задачу(б, номер)! {
        задача = найдена
    } иначе {
        вернуть ошибка_json(404, "нет задачи " + стр(номер))
    }
    выбор з.метод {
        "GET" { вернуть ответ_json(200, json.записать(задача)) }
        "PATCH" { вернуть изменить(з, б, номер) }
        "DELETE" {
            б.выполнить("DELETE FROM задачи WHERE номер = ?", [sqlite.Целое(номер)])!
            вернуть вебсервер.ответ(204, "text/plain", байты(""))
        }
        иначе { вернуть ошибка_json(405, "метод " + з.метод + " не поддерживается") }
    }
}

функ направить(з: вебсервер.Запрос, б: sqlite.База) -> вебсервер.Ответ! {
    если з.путь == "/задачи" {
        выбор з.метод {
            "GET" { вернуть список(з, б) }
            "POST" { вернуть создать(з, б) }
            иначе { вернуть ошибка_json(405, "метод " + з.метод + " не поддерживается") }
        }
    }
    если пусть ч = з.шаблон("/задачи/{номер}") {
        вернуть одна(з, б, ч["номер"])
    }
    вернуть ошибка_json(404, "нет такого адреса: " + з.путь)
}

/// Обработчик сервера: свое соединение с базой на каждый запрос (работники выполняются
/// параллельно), ошибка базы - ответ 500, каждый запрос - строка журнала.
функ обслужить(с: Сервис, з: вебсервер.Запрос) -> вебсервер.Ответ {
    пусть начало = метка_времени()
    перем ответ = ошибка_json(500, "внутренняя ошибка")
    если пусть б = sqlite.открыть(с.база) {
        если пусть о = направить(з, б) {
            ответ = о
        } иначе ошибка е {
            с.ж.ошибка_с("сбой базы", {"путь": з.путь, "причина": е})
        }
        б.закрыть()
    } иначе ошибка е {
        с.ж.ошибка_с("база не открылась", {"причина": е})
    }
    пусть мс = округлить((метка_времени() - начало) * 1000.0)
    с.ж.сведения_с(з.метод + " " + з.путь, {"код": стр(ответ.код), "мс": стр(мс), "адрес": з.адрес})
    вернуть ответ
}

функ запустить_сервис(а: командная_строка.Аргументы, ж: журнал.Журнал) -> ! {
    пусть служба = Сервис(а.значение("база"), ж)
    подготовить(служба.база)!
    перем сервер = вебсервер.слушать(а.значение("адрес"), а.цел("порт")!)!
    сервер.предел_запросов = а.цел("запросов")!
    вывод(сервер.порт)
    ж.сведения_с("сервис запущен", {"адрес": а.значение("адрес"), "порт": стр(сервер.порт), "база": служба.база})
    // обработчик - безымянная функция с копией настроек службы
    сервер.обслуживать(функ(з: вебсервер.Запрос) = обслужить(служба, з))
    ж.сведения("сервис остановлен")
}

перем о = командная_строка.описание("задачи_сервис", "Веб-сервис списка задач (REST, JSON, SQLite)")
о = о.параметр("адрес", "а", "адрес IPv4 (0.0.0.0 - все сети)", "127.0.0.1")
о = о.параметр("порт", "п", "порт (0 - любой свободный)", "8080")
о = о.параметр("база", "б", "файл базы SQLite", "задачи.db")
о = о.параметр("запросов", "", "ответить на столько запросов и выйти (0 - без предела)", "0")

пусть ж = журнал.в_поток_ошибок("задачи").с_уровнем(журнал.уровень_из_среды("ЖУРНАЛ", журнал.СВЕДЕНИЯ()))
если пусть а = о.разобрать(аргументы()) {
    если а.нужна_справка {
        вывод(о.справка())
        завершить(0)
    }
    если ошибка е = запустить_сервис(а, ж) {
        ж.ошибка(е)
        завершить(1)
    }
} иначе ошибка е {
    вывод_ошибки(е)
    завершить(2)
}
