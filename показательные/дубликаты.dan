// Поиск дубликатов файлов: обходит папку со всеми вложенными папками, сравнивает файлы
// одинакового размера по хешу SHA-256 и печатает группы одинаковых файлов и сколько места
// они занимают зря. Файлы ничего не удаляет: решение остаётся за человеком.
//
// Сначала файлы делятся по размеру (файлы разного размера не бывают одинаковыми), хеш
// считается только для размеров, которые встречаются больше одного раза; две половины
// списка хешируются параллельно. Символические ссылки пропускаются.
//
// Запуск: dan запустить дубликаты.dan -- папка [--мин-размер 1024] [--json]
подключить "json"
подключить "журнал"
подключить "командная_строка"

тип Файл {
    путь: стр
    размер: цел
}

// Отчёт для --json: json.записать пишет поля под ключами из кавычек.
тип Группа {
    хеш "sha256": стр
    размер "size": цел
    файлы "files": [стр]
}

тип Отчёт {
    просмотрено "scanned": цел
    лишних_байтов "wasted_bytes": цел
    группы "groups": [Группа]
}

/// Все файлы папки и вложенных папок не меньше «наименьший» байтов.
функ обойти(папка: стр, наименьший: цел) -> [Файл] {
    перем итог: [Файл] = []
    перем очередь = [папка]
    пока очередь.длина > 0 {
        пусть текущая = очередь[очередь.длина - 1]
        очередь.удалить(очередь.длина - 1)
        для имя в список_файлов(текущая) {
            // у папок (и ссылок на папки) в конце имени «/»: путь без него, иначе это_ссылка
            // смотрит на папку, куда ведёт ссылка
            пусть папка_ = имя.оканчивается("/")
            перем путь = текущая + "/" + имя
            если папка_ { путь = текущая + "/" + имя[0..имя.длина - 2] }
            если это_ссылка(путь) { продолжить }
            если папка_ {
                очередь.добавить(путь)
            } иначе {
                пусть размер = размер_файла(путь)
                если размер >= наименьший { итог.добавить(Файл(путь, размер)) }
            }
        }
    }
    вернуть итог
}

/// Хеши SHA-256 файлов по порядку (шестнадцатеричной записью).
функ хеши(файлы: [Файл]) -> [стр] {
    вернуть файлы.преобразовать(функ(ф) = шестнадцатеричная(хеш_sha256(прочитать_байты(ф.путь))))
}

функ найти_дубликаты(файлы: [Файл]) -> [Группа] {
    // кандидаты: файлы, размер которых встречается не один раз
    перем по_размеру: {цел: цел} = {}
    для ф в файлы { по_размеру[ф.размер] = по_размеру.получить(ф.размер, 0) + 1 }
    пусть кандидаты = файлы.отобрать(функ(ф) = по_размеру[ф.размер] > 1)
    если кандидаты.длина == 0 { вернуть [] }
    // две задачи считают хеши половин списка одновременно
    пусть середина = частное(кандидаты.длина, 2)
    перем первая_половина: [Файл] = []
    если середина > 0 { первая_половина = кандидаты[0..середина - 1] }
    пусть первая = запустить хеши(первая_половина)
    пусть вторая = запустить хеши(кандидаты[середина..кандидаты.длина - 1])
    пусть все_хеши = склеить(первая.дождаться(), вторая.дождаться())
    перем по_хешу: {стр: Группа} = {}
    для к в 0..кандидаты.длина - 1 {
        пусть ф = кандидаты[к]
        пусть ключ = стр(ф.размер) + ":" + все_хеши[к]
        перем г = по_хешу.получить(ключ, Группа(все_хеши[к], ф.размер, []))
        г.файлы.добавить(ф.путь)
        по_хешу[ключ] = г
    }
    перем группы = по_хешу.значения().отобрать(функ(г) = г.файлы.длина > 1)
    // сначала группы, которые занимают больше всего лишнего места
    пусть упорядоченные = группы.преобразовать(функ(г) = Группа(г.хеш, г.размер, упорядочить(г.файлы)))
    вернуть упорядоченные.упорядочить_по(функ(г) = -г.размер * (г.файлы.длина - 1))
}

функ лишние(группы: [Группа]) -> цел {
    вернуть группы.свернуть(0, функ(итог, г) = итог + г.размер * (г.файлы.длина - 1))
}

функ размер_текстом(байт: цел) -> стр {
    если байт < 1024 { вернуть стр(байт) + " Б" }
    если байт < 1024 * 1024 { вернуть стр(округлить(дроб(байт) / 1024.0, 1)) + " КБ" }
    вернуть стр(округлить(дроб(байт) / 1048576.0, 1)) + " МБ"
}

перем о = командная_строка.описание("дубликаты", "Поиск одинаковых файлов по хешу SHA-256")
о = о.позиционный("папка", "где искать (со вложенными папками)")
о = о.параметр("мин-размер", "м", "не смотреть файлы меньше стольких байтов", "1")
о = о.флаг("json", "j", "напечатать отчёт в JSON")

пусть ж = журнал.в_поток_ошибок("дубликаты").с_уровнем(журнал.уровень_из_среды("ЖУРНАЛ", журнал.СВЕДЕНИЯ()))
если пусть а = о.разобрать(аргументы()) {
    если а.нужна_справка {
        вывод(о.справка())
        завершить(0)
    }
    перем папка = а.значение("папка")
    если папка.длина > 1 и папка.оканчивается("/") { папка = папка[0..папка.длина - 2] }
    если не это_папка(папка) {
        ж.ошибка("нет папки «" + папка + "»")
        завершить(1)
    }
    пусть наименьший = а.цел("мин-размер") иначе 1
    пусть начало = метка_времени()
    пусть файлы = обойти(папка, наименьший)
    пусть группы = найти_дубликаты(файлы)
    ж.сведения_с("поиск закончен", {"файлов": стр(файлы.длина), "групп": стр(группы.длина),
        "секунд": стр(округлить(метка_времени() - начало, 2))})
    если а.флаг("json") {
        вывод(json.записать(Отчёт(файлы.длина, лишние(группы), группы)))
    } иначе {
        для г в группы {
            вывод(стр(г.файлы.длина) + " одинаковых по " + размер_текстом(г.размер) + " (" + г.хеш[0..11] + "):")
            для п в г.файлы { вывод("  " + п) }
        }
        вывод("Просмотрено файлов: " + стр(файлы.длина) + ", групп одинаковых: " + стр(группы.длина) +
            ", лишнего места: " + размер_текстом(лишние(группы)))
    }
} иначе ошибка е {
    вывод_ошибки(е)
    завершить(2)
}

тест "группы и лишнее место" {
    пусть г = [Группа("а", 100, ["x", "y", "z"]), Группа("б", 5, ["p", "q"])]
    утвердить_равно(лишние(г), 205)
    утвердить_равно(размер_текстом(1536), "1.5 КБ")
    утвердить_равно(размер_текстом(10), "10 Б")
}
