// Бот для Telegram на длинном опросе: getUpdates ждёт новые сообщения, sendMessage отвечает.
//
// Команды: /start - приветствие, /помощь (/help) - список команд, /слова текст - подсчёт
// слов и самое частое слово; любой другой текст бот повторяет и говорит, сколько в нём слов.
//
// Токен берётся из переменной среды TELEGRAM_TOKEN или из файла настроек (по умолчанию
// бот.toml рядом с программой):
//
//     токен = "123456:ABC..."
//     адрес_api = "https://api.telegram.org"   # можно не указывать
//     ожидание = 30                            # секунд длинного опроса
//
// Запуск: dan запустить телеграм_бот.dan -- --настройки бот.toml
// Ключ --обновлений N - обработать N обновлений и завершиться (для проверок),
// --api адрес - другой адрес API (например, местный сервер в тесте).
// Журнал пишется в поток ошибок; уровень - переменная среды ЖУРНАЛ (отладка, сведения, ...).
подключить "http"
подключить "json"
подключить "журнал"
подключить "настройки"
подключить "командная_строка"

// Ответ Telegram разбирается прямо в эти типы: лишние ключи пропускаются,
// поле, которого нет в ответе, берёт значение по умолчанию или становится «ничего».
тип Чат {
    номер "id": цел
}

тип Отправитель {
    имя "first_name": стр = ""
}

тип Сообщение {
    номер "message_id": цел
    чат "chat": Чат
    отправитель "from": Отправитель?
    текст "text": стр?
}

тип Обновление {
    номер "update_id": цел
    сообщение "message": Сообщение?
}

тип ОтветОбновлений {
    успешно "ok": лог
    итог "result": [Обновление] = []
    описание "description": стр = ""
}

тип ОтветОтправки {
    успешно "ok": лог
    описание "description": стр = ""
}

// Тело запроса sendMessage: json.записать пишет поля под ключами из кавычек.
тип Отправка {
    чат "chat_id": цел
    текст "text": стр
    ответ_на "reply_to_message_id": цел
}

тип Бот {
    api: стр             // https://api.telegram.org
    токен: стр
    ожидание: цел
    ж: журнал.Журнал
}

/// Адрес метода API: https://api.telegram.org/bot<токен>/getUpdates
функ Бот.адрес(метод: стр) -> стр {
    вернуть сам.api + "/bot" + сам.токен + "/" + метод
}

/// Текст ошибки для журнала: сообщения модуля http называют адрес, а токен в журнал попадать не должен.
функ Бот.скрыть(т: стр) -> стр {
    вернуть т.заменить(сам.токен, "<токен>")
}

/// Ответ бота на текст сообщения.
функ ответ_на(текст: стр, имя: стр) -> стр {
    пусть слова = текст.разбить()
    если слова.длина == 0 {
        вернуть "Пришлите текст, и я посчитаю в нём слова."
    }
    пусть команда = слова[0].строчные()
    если команда == "/start" {
        вернуть "Здравствуйте, " + имя + "! Я считаю слова. Наберите /помощь, чтобы узнать команды."
    }
    если команда == "/помощь" или команда == "/help" {
        вернуть "/слова текст - сколько в тексте слов и какое встречается чаще всего\n" +
            "Любой другой текст я повторю и скажу, сколько в нём слов."
    }
    если команда == "/слова" {
        если слова.длина == 1 { вернуть "После /слова напишите текст." }
        вернуть разбор_слов(слова[1..слова.длина - 1])
    }
    если команда.начинается("/") {
        вернуть "Не знаю команды " + слова[0] + ". Наберите /помощь."
    }
    вернуть текст + "\n(" + стр(слова.длина) + " " + склонение(слова.длина, "слово", "слова", "слов") + ")"
}

/// Сколько слов и какое встречается чаще всего (без учёта регистра и знаков препинания).
функ разбор_слов(слова: [стр]) -> стр {
    перем счёт: {стр: цел} = {}
    для с в слова {
        пусть чистое = заменить_шаблон(с.строчные(), "[^\\w-]", "")
        если чистое != "" {
            счёт[чистое] = счёт.получить(чистое, 0) + 1
        }
    }
    перем частое = ""
    перем сколько = 0
    для с в счёт {
        если счёт[с] > сколько {
            частое = с
            сколько = счёт[с]
        }
    }
    перем итог = "Слов: " + стр(слова.длина) + ", разных: " + стр(счёт.длина)
    если сколько > 1 {
        итог = итог + "\nЧаще всего: «" + частое + "» (" + стр(сколько) + " " + склонение(сколько, "раз", "раза", "раз") + ")"
    }
    вернуть итог
}

/// Новые обновления начиная с номера «с» (длинный опрос: сервер держит запрос до ожидания).
функ получить_обновления(б: Бот, с: цел) -> [Обновление]! {
    пусть адрес = б.адрес("getUpdates") + "?offset=" + стр(с) + "&timeout=" + стр(б.ожидание)
    пусть о = http.запрос("GET", адрес, {}, байты(""), б.ожидание + 15)!
    пусть ответ = json.разобрать_в(о.текст(), ОтветОбновлений)!
    если не ответ.успешно {
        вернуть ошибка("getUpdates, код " + стр(о.код) + ": " + ответ.описание)
    }
    вернуть ответ.итог
}

функ отправить(б: Бот, о: Отправка) -> ! {
    пусть р = http.отправить(б.адрес("sendMessage"), json.записать(о), "application/json")!
    пусть ответ = json.разобрать_в(р.текст(), ОтветОтправки)!
    если не ответ.успешно {
        вернуть ошибка("sendMessage, код " + стр(р.код) + ": " + ответ.описание)
    }
}

функ обработать(б: Бот, о: Обновление) -> ! {
    // обновление без текстового сообщения (наклейка, изменение, вступление в группу) пропускается
    если пусть с = о.сообщение {
        если пусть текст = с.текст {
            перем имя = "друг"
            если пусть от = с.отправитель {
                если от.имя != "" { имя = от.имя }
            }
            б.ж.сведения_с("сообщение", {"чат": стр(с.чат.номер), "слов": стр(текст.разбить().длина)})
            отправить(б, Отправка(с.чат.номер, ответ_на(текст, имя), с.номер))!
        }
    }
}

/// Обрабатывает обновления, пока не наберётся «предел» (0 - без предела).
функ работать(б: Бот, предел: цел) {
    перем следующее = 0
    перем обработано = 0
    перем сбоев = 0
    пока предел == 0 или обработано < предел {
        если пусть обновления = получить_обновления(б, следующее) {
            сбоев = 0
            для о в обновления {
                следующее = о.номер + 1          // подтверждает обновление при следующем опросе
                если ошибка е = обработать(б, о) {
                    б.ж.ошибка_с("ответ не отправлен", {"обновление": стр(о.номер), "причина": б.скрыть(е)})
                }
                обработано += 1
                если предел > 0 и обработано >= предел { прервать }
            }
        } иначе ошибка е {
            // сеть пропала или сервер ответил ошибкой: ждём всё дольше, но не больше минуты
            сбоев += 1
            б.ж.предупреждение_с("опрос не удался", {"причина": б.скрыть(е), "попытка": стр(сбоев)})
            пауза(дроб(мин(60, 2 ^ мин(сбоев, 6))) / 10.0)
        }
    }
    б.ж.сведения_с("работа закончена", {"обработано": стр(обработано)})
}

функ настроить(а: командная_строка.Аргументы, ж: журнал.Журнал) -> Бот! {
    пусть путь = а.значение("настройки")
    перем н = json.Пусто
    если существует(путь) {
        н = настройки.загрузить(путь)!
    }
    пусть токен = переменная_среды("TELEGRAM_TOKEN") иначе (настройки.найти(н, "токен").как_стр() иначе "")
    если токен == "" {
        вернуть ошибка("нет токена: задайте TELEGRAM_TOKEN или «токен» в " + путь)
    }
    перем api = настройки.найти(н, "адрес_api").как_стр() иначе "https://api.telegram.org"
    если а.задан("api") { api = а.значение("api") }
    пусть ожидание = настройки.найти(н, "ожидание").как_цел() иначе 30
    вернуть Бот(api, токен, ожидание, ж)
}

перем о = командная_строка.описание("телеграм_бот", "Бот для Telegram: повторяет сообщения и считает слова")
о = о.параметр("настройки", "н", "файл настроек TOML или YAML", "бот.toml")
о = о.параметр("api", "", "адрес API вместо указанного в настройках", "")
о = о.параметр("обновлений", "", "обработать столько обновлений и выйти (0 - работать всегда)", "0")

пусть ж = журнал.в_поток_ошибок("бот").с_уровнем(журнал.уровень_из_среды("ЖУРНАЛ", журнал.СВЕДЕНИЯ()))
если пусть а = о.разобрать(аргументы()) {
    если а.нужна_справка {
        вывод(о.справка())
        завершить(0)
    }
    пусть предел = а.цел("обновлений") иначе 0
    если пусть б = настроить(а, ж) {
        ж.сведения("бот запущен")
        работать(б, предел)
    } иначе ошибка е {
        ж.ошибка(е)
        завершить(1)
    }
} иначе ошибка е {
    вывод_ошибки(е)
    завершить(2)
}

тест "ответы на команды" {
    утвердить(ответ_на("/start", "Анна").начинается("Здравствуйте, Анна!"))
    утвердить_равно(ответ_на("/слова Мама мыла раму, мама!", ""), "Слов: 4, разных: 3\nЧаще всего: «мама» (2 раза)")
    утвердить_равно(ответ_на("Привет всем", ""), "Привет всем\n(2 слова)")
    утвердить(ответ_на("/погода", "").начинается("Не знаю команды /погода"))
}

тест "разбор ответа Telegram" {
    пусть текст = "{\"ok\":true,\"result\":[{\"update_id\":7,\"message\":{\"message_id\":3,\"date\":1,\"chat\":{\"id\":-42,\"type\":\"group\"},\"text\":\"привет\"}},{\"update_id\":8,\"edited_message\":{}}]}"
    пусть о = json.разобрать_в(текст, ОтветОбновлений) иначе ОтветОбновлений(ложь)
    утвердить(о.успешно)
    утвердить_равно(о.итог.длина, 2)
    если пусть с = о.итог[0].сообщение {
        утвердить_равно(с.чат.номер, -42)
        утвердить_равно(с.текст иначе "", "привет")
    } иначе {
        утвердить(ложь, "нет сообщения")
    }
    утвердить(о.итог[1].сообщение == ничего)
    утвердить_равно(json.записать(Отправка(5, "да", 3)), "{\"chat_id\":5,\"text\":\"да\",\"reply_to_message_id\":3}")
}
