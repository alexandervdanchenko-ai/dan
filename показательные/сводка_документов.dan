// Сводка документов: из папки с таблицами Word (.docx), Excel (.xlsx) и CSV собирает одну
// книгу Excel - лист «Строки» (все строки с именем файла), «Итоги» (по наименованиям)
// и «Пропущено» (файлы и строки, которые не удалось прочитать, с причиной).
//
// В каждом файле ищется таблица, в шапке которой есть столбцы «Наименование» (или «Товар»),
// «Количество» и «Сумма»: регистр и порядок не важны, лишние столбцы и строки над шапкой
// пропускаются. Строки без наименования и строки «Итого» не учитываются. Суммы - в рублях,
// с точкой или запятой («1 250,50»); считаются в копейках, без ошибок округления.
//
// Запуск: dan запустить сводка_документов.dan -- папка --вывод сводка.xlsx
подключить "excel"
подключить "word"
подключить "csv"
подключить "журнал"
подключить "командная_строка"

тип Строка {
    файл: стр
    наименование: стр
    количество: цел
    копеек: цел
}

тип Итог {
    наименование: стр
    количество: цел = 0
    копеек: цел = 0
    файлов: цел = 0
}

тип Столбцы {
    наименование: цел = -1
    количество: цел = -1
    сумма: цел = -1
}

тип Сводка {
    строки: [Строка] = []
    пропущено: [[стр]] = []
    файлов: цел = 0
}

/// Номера нужных столбцов по шапке таблицы или ничего, если это не шапка.
функ столбцы(шапка: [стр]) -> Столбцы? {
    перем с = Столбцы()
    для к в 0..шапка.длина - 1 {
        пусть з = шапка[к].обрезать().строчные()
        если з.начинается("наимен") или з.начинается("товар") {
            с.наименование = к
        } иначе если з.начинается("кол") {
            с.количество = к
        } иначе если з.начинается("сумм") или з.начинается("стоим") {
            с.сумма = к
        }
    }
    если с.наименование < 0 или с.количество < 0 или с.сумма < 0 { вернуть ничего }
    вернуть с
}

/// Число из ячейки: пробелы между разрядами, «руб.» и «₽» не мешают, дробная часть - после точки или запятой.
функ число(т: стр) -> дроб! {
    пусть чистое = т.заменить(символ_по_коду(160), "").заменить(" ", "").заменить("руб.", "").заменить("₽", "")
    вернуть разобрать_дроб(чистое)
}

функ рубли(копеек: цел) -> стр {
    перем знак = ""
    если копеек < 0 { знак = "-" }
    пусть к = модуль(копеек)
    вернуть знак + стр(частное(к, 100)) + "." + стр(частное(к % 100, 10)) + стр(к % 10)
}

/// Таблицы файла по его расширению: все таблицы документа Word, все листы книги Excel, файл CSV.
функ таблицы(путь: стр) -> [[[стр]]]! {
    пусть имя = путь.строчные()
    если имя.оканчивается(".docx") {
        вернуть word.открыть(путь)!.таблицы()
    }
    если имя.оканчивается(".xlsx") {
        пусть к = excel.открыть(путь)!
        перем листы: [[[стр]]] = []
        для лист в к.листы() { листы.добавить(к.лист(лист)!) }
        вернуть листы
    }
    вернуть [csv.разобрать(прочитать(путь))!]
}

/// Строки всех подходящих таблиц файла; неверные строки - в «пропущено».
функ прочитать_файл(св: Сводка, папка: стр, имя: стр) -> Сводка! {
    перем итог = св
    перем найдена = ложь
    для таблица в таблицы(папка + "/" + имя)! {
        перем с = Столбцы()
        перем шапка = -1
        для н в 0..таблица.длина - 1 {
            пусть ряд = таблица[н]
            если шапка < 0 {
                если пусть найденные = столбцы(ряд) {
                    с = найденные
                    шапка = н
                    найдена = истина
                }
                продолжить
            }
            если ряд.длина <= макс([с.наименование, с.количество, с.сумма]) { продолжить }
            пусть наименование = ряд[с.наименование].обрезать()
            если наименование == "" или наименование.строчные().начинается("итог") { продолжить }
            если пусть количество = число(ряд[с.количество]) {
                если пусть сумма = число(ряд[с.сумма]) {
                    итог.строки.добавить(Строка(имя, наименование, округлить(количество), округлить(сумма * 100.0)))
                    продолжить
                }
            }
            итог.пропущено.добавить([имя, "строка " + стр(н + 1) + ": не число в столбце количества или суммы"])
        }
    }
    если не найдена {
        итог.пропущено.добавить([имя, "нет таблицы со столбцами «Наименование», «Количество», «Сумма»"])
    }
    итог.файлов += 1
    вернуть итог
}

функ итоги(строки: [Строка]) -> [Итог] {
    перем по_имени: {стр: Итог} = {}
    перем файлы: {стр: цел} = {}
    для с в строки {
        пусть ключ = с.наименование.строчные()
        перем и_ = по_имени.получить(ключ, Итог(с.наименование))
        и_.количество += с.количество
        и_.копеек += с.копеек
        если не файлы.содержит(ключ + "\n" + с.файл) {
            файлы[ключ + "\n" + с.файл] = 1
            и_.файлов += 1
        }
        по_имени[ключ] = и_
    }
    вернуть по_имени.значения().упорядочить_по(функ(и_) = -и_.копеек)
}

функ записать_сводку(св: Сводка, путь: стр) -> ! {
    перем строки = [["Файл", "Наименование", "Количество", "Сумма"]]
    для с в св.строки {
        строки.добавить([с.файл, с.наименование, стр(с.количество), рубли(с.копеек)])
    }
    перем по_наименованиям = [["Наименование", "Количество", "Сумма", "Файлов"]]
    перем всего = 0
    для и_ в итоги(св.строки) {
        по_наименованиям.добавить([и_.наименование, стр(и_.количество), рубли(и_.копеек), стр(и_.файлов)])
        всего += и_.копеек
    }
    по_наименованиям.добавить(["Итого", "", рубли(всего), стр(св.файлов)])
    перем листы = [excel.Лист("Итоги", по_наименованиям), excel.Лист("Строки", строки)]
    если св.пропущено.длина > 0 {
        перем пропущено = [["Файл", "Причина"]]
        для п в св.пропущено { пропущено.добавить(п) }
        листы.добавить(excel.Лист("Пропущено", пропущено))
    }
    excel.создать(путь, листы)!
}

функ подходит(имя: стр, вывод_: стр) -> лог {
    пусть м = имя.строчные()
    если м.начинается("~$") или м.оканчивается("/") или имя == вывод_ { вернуть ложь }
    вернуть м.оканчивается(".docx") или м.оканчивается(".xlsx") или м.оканчивается(".csv")
}

функ свести(папка: стр, путь: стр, ж: журнал.Журнал) -> Сводка! {
    если не это_папка(папка) { вернуть ошибка("нет папки «" + папка + "»") }
    перем св = Сводка()
    // имя книги-итога в той же папке пропускается, чтобы повторный запуск не учёл её
    перем своё = путь
    если путь.начинается(папка + "/") { своё = путь[папка.длина + 1..путь.длина - 1] }
    для имя в список_файлов(папка) {
        если не подходит(имя, своё) { продолжить }
        пусть было = св.строки.длина
        если пусть новая = прочитать_файл(св, папка, имя) {
            св = новая
            ж.сведения_с("прочитан", {"файл": имя, "строк": стр(св.строки.длина - было)})
        } иначе ошибка е {
            св.пропущено.добавить([имя, е])
            св.файлов += 1
            ж.предупреждение_с("не прочитан", {"файл": имя, "причина": е})
        }
    }
    вернуть св
}

перем о = командная_строка.описание("сводка_документов", "Сводная таблица Excel по таблицам Word, Excel и CSV из папки")
о = о.позиционный("папка", "папка с документами")
о = о.параметр("вывод", "в", "файл сводки", "сводка.xlsx")

пусть ж = журнал.в_поток_ошибок("сводка").с_уровнем(журнал.уровень_из_среды("ЖУРНАЛ", журнал.СВЕДЕНИЯ()))
если пусть а = о.разобрать(аргументы()) {
    если а.нужна_справка {
        вывод(о.справка())
        завершить(0)
    }
    если пусть св = свести(а.значение("папка"), а.значение("вывод"), ж) {
        если ошибка е = записать_сводку(св, а.значение("вывод")) {
            ж.ошибка(е)
            завершить(1)
        }
        перем всего = 0
        для с в св.строки { всего += с.копеек }
        вывод("Файлов: " + стр(св.файлов) + ", строк: " + стр(св.строки.длина) + ", пропущено: " + стр(св.пропущено.длина))
        вывод("Всего: " + сумма_цифрами(рац(всего, 100)))
        вывод("Сводка: " + а.значение("вывод"))
    } иначе ошибка е {
        ж.ошибка(е)
        завершить(1)
    }
} иначе ошибка е {
    вывод_ошибки(е)
    завершить(2)
}

тест "числа и рубли" {
    утвердить_равно(число("1 250,50") иначе 0.0, 1250.5)
    утвердить_равно(число("300 руб.") иначе 0.0, 300.0)
    утвердить_равно(число("много") иначе -1.0, -1.0)
    утвердить_равно(рубли(125050), "1250.50")
    утвердить_равно(рубли(-7), "-0.07")
}

тест "шапка таблицы" {
    утвердить(столбцы(["№", "Товар", "Цена", "Кол-во", "Сумма, руб."]) != ничего)
    утвердить(столбцы(["Наименование", "Цена"]) == ничего)
}
