пусть путь = аргументы()[0]
если не существует(путь) {
    вывод("нет файла: " + путь)
    завершить(1)
}
пусть т = прочитать(путь)
перем строк = 0
для б в т {
    если б == "\n" { строк += 1 }
}
если т.длина > 0 и не т.оканчивается("\n") { строк += 1 }
вывод("строк: " + стр(строк))
вывод("слов: " + стр(т.заменить("\n", " ").разбить().длина))
вывод("символов: " + стр(т.длина))
