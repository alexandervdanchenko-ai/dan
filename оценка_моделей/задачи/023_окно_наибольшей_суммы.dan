пусть числа = ввод().разбить().преобразовать(функ(с) = цел(с))
пусть к = цел(ввод())
если к < 1 или к > числа.длина {
    вывод("нет")
} иначе {
    перем сумма_окна = 0
    для н в 0..к - 1 { сумма_окна += числа[н] }
    перем лучшая = сумма_окна
    для н в к..числа.длина - 1 {
        сумма_окна += числа[н] - числа[н - к]
        если сумма_окна > лучшая { лучшая = сумма_окна }
    }
    вывод(лучшая)
}
