тип Выражение {
    Число(значение: цел)
    Действие(знак: стр, аргументы: [Выражение])
}

тип Разбор {
    выражение: Выражение
    дальше: цел
}

функ разобрать(слова: [стр], н: цел) -> Разбор! {
    если н >= слова.длина { вернуть ошибка("конец записи") }
    если слова[н] != "(" {
        вернуть Разбор(Число(разобрать_цел(слова[н])!), н + 1)
    }
    если н + 1 >= слова.длина { вернуть ошибка("конец записи") }
    пусть знак = слова[н + 1]
    если знак != "+" и знак != "-" и знак != "*" { вернуть ошибка("неизвестный знак") }
    перем аргументы: [Выражение] = []
    перем к = н + 2
    пока к < слова.длина и слова[к] != ")" {
        пусть р = разобрать(слова, к)!
        аргументы.добавить(р.выражение)
        к = р.дальше
    }
    если к >= слова.длина { вернуть ошибка("нет закрывающей скобки") }
    если аргументы.длина == 0 { вернуть ошибка("нет аргументов") }
    вернуть Разбор(Действие(знак, аргументы), к + 1)
}

функ значение(в_: Выражение) -> цел {
    выбор в_ {
        Число(з) { вернуть з }
        Действие(знак, аргументы) {
            пусть числа = аргументы.преобразовать(функ(а) = значение(а))
            если знак == "+" { вернуть сумма(числа) }
            если знак == "*" { вернуть числа.свернуть(1, функ(итог_, х) = итог_ * х) }
            если числа.длина == 1 { вернуть -числа[0] }
            вернуть числа[0] - сумма(числа[1..числа.длина - 1])
        }
    }
}

пусть слова = ввод().заменить("(", " ( ").заменить(")", " ) ").разбить()
если пусть р = разобрать(слова, 0) {
    если р.дальше == слова.длина {
        вывод(значение(р.выражение))
    } иначе {
        вывод("ошибка")
    }
} иначе {
    вывод("ошибка")
}
