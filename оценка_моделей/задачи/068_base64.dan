пусть действие = аргументы()[0]
пусть строка = ввод()
если действие == "закодировать" {
    вывод(в_base64(строка))
} иначе если действие == "раскодировать" {
    если пусть данные = из_base64(строка) {
        вывод(стр(данные))
    } иначе {
        вывод("неверная запись")
        завершить(1)
    }
} иначе {
    вывод("неизвестное действие")
    завершить(2)
}
