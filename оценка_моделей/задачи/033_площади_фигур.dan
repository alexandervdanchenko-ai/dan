тип Фигура {
    Квадрат(а: цел)
    Прямоугольник(а: цел, б: цел)
    Треугольник(а: цел, б: цел)
}

функ площадь(ф: Фигура) -> рац {
    выбор ф {
        Квадрат(а) { вернуть рац(а * а, 1) }
        Прямоугольник(а, б) { вернуть рац(а * б, 1) }
        Треугольник(а, б) { вернуть рац(а * б, 2) }
    }
}

перем итого = рац(0, 1)
перем строка = ввод()
пока строка != "" {
    пусть ч = строка.разбить()
    перем ф: Фигура? = ничего
    если ч[0] == "квадрат" {
        ф = Квадрат(цел(ч[1]))
    } иначе если ч[0] == "прямоугольник" {
        ф = Прямоугольник(цел(ч[1]), цел(ч[2]))
    } иначе если ч[0] == "треугольник" {
        ф = Треугольник(цел(ч[1]), цел(ч[2]))
    }
    если пусть фигура = ф {
        пусть с = площадь(фигура)
        вывод(с)
        итого += с
    } иначе {
        вывод("неизвестная фигура: " + ч[0])
    }
    строка = ввод()
}
вывод("итого: " + стр(итого))
