пусть алфавит = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя"
пусть сдвиг = цел(ввод())
пусть т = ввод()
перем итог = ""
для б в т {
    пусть м = б.строчные()
    пусть н = алфавит.найти(м)
    если н < 0 {
        итог = итог + б
    } иначе {
        пусть новая = алфавит[(н + сдвиг) % 33]
        если м != б {
            итог = итог + новая.прописные()
        } иначе {
            итог = итог + новая
        }
    }
}
вывод(итог)
