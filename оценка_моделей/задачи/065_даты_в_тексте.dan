перем даты: [дата] = []
перем строка = ввод()
пока строка != "" {
    для запись в найти_все(строка, "\\b\\d{2}\\.\\d{2}\\.\\d{4}\\b") {
        если пусть д = разобрать_дату(запись) {
            если не даты.содержит(д) { даты.добавить(д) }
        }
    }
    строка = ввод()
}
для д в даты.упорядочить_по(функ(д) = д) {
    вывод(д)
}
