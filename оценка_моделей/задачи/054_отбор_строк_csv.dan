подключить "csv"

пусть арг = аргументы()
пусть таблица = csv.разобрать(прочитать(арг[0]))!
пусть столбец = таблица[0].найти(арг[1])
если столбец < 0 {
    вывод("нет столбца «" + арг[1] + "»")
    завершить(1)
}
перем итог: [[стр]] = [таблица[0]]
для н в 1..таблица.длина - 1 {
    если таблица[н][столбец] == арг[2] { итог.добавить(таблица[н]) }
}
напечатать(csv.записать(итог))
