перем группы: {стр: [стр]} = {}
перем строка = ввод()
пока строка != "" {
    пусть н = строка.найти("=")
    пусть ключ = строка[0..н - 1]
    пусть значение = строка[н + 1..строка.длина - 1]
    перем список = группы.получить(значение, [])
    список.добавить(ключ)
    группы[значение] = список
    строка = ввод()
}
для значение в группы {
    вывод(значение + ": " + группы[значение].соединить(", "))
}
