функ проверить_пароль(п: стр) -> ! {
    если п.длина < 8 { вернуть ошибка("короче 8 символов") }
    если п.содержит(" ") { вернуть ошибка("есть пробел") }
    если не п.символы().любой(функ(б) = "0123456789".содержит(б)) { вернуть ошибка("нет цифры") }
    если не п.символы().любой(функ(б) = б.строчные() != б) { вернуть ошибка("нет прописной буквы") }
    если не п.символы().любой(функ(б) = б.прописные() != б) { вернуть ошибка("нет строчной буквы") }
}

перем строка = ввод()
пока строка != "" {
    если ошибка о = проверить_пароль(строка) {
        вывод("ненадёжный: " + о)
    } иначе {
        вывод("надёжный")
    }
    строка = ввод()
}
