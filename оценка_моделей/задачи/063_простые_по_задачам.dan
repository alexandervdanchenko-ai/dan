тип Итог {
    номер: цел
    простых: цел
}

функ простых(номер: цел, а: цел, б: цел, выход: канал<Итог>) {
    перем н = 0
    для к в а..б {
        если простое(к) { н += 1 }
    }
    выход.отправить(Итог(номер, н))
}

перем диапазоны: [[цел]] = []
перем строка = ввод()
пока строка != "" {
    диапазоны.добавить(строка.разбить().преобразовать(функ(с) = цел(с)))
    строка = ввод()
}
пусть итоги: канал<Итог> = канал(диапазоны.длина + 1)
параллельно {
    для н в 0..диапазоны.длина - 1 {
        запустить простых(н, диапазоны[н][0], диапазоны[н][1], итоги)
    }
}
итоги.закрыть()
перем счёт: {цел: цел} = {}
для р в итоги { счёт[р.номер] = р.простых }
для н в 0..диапазоны.длина - 1 {
    вывод(стр(диапазоны[н][0]) + "-" + стр(диапазоны[н][1]) + ": " + стр(счёт[н]))
}
