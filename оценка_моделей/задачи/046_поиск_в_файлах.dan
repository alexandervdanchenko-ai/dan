пусть арг = аргументы()
пусть слово = арг[0]
для к в 1..арг.длина - 1 {
    пусть путь = арг[к]
    если не существует(путь) {
        вывод("нет файла: " + путь)
        продолжить
    }
    пусть строки = прочитать(путь).разбить("\n")
    для н в 0..строки.длина - 1 {
        если строки[н].содержит(слово) {
            вывод(путь + ":" + стр(н + 1) + ":" + строки[н])
        }
    }
}
