перем голоса: {стр: цел} = {}
перем строка = ввод()
пока строка != "" {
    пусть имя = строка.обрезать()
    голоса[имя] = голоса.получить(имя, 0) + 1
    строка = ввод()
}
если голоса.длина == 0 {
    вывод("голосов нет")
} иначе {
    пусть имена = упорядочить(голоса.ключи()).упорядочить_по(функ(и_) = -голоса[и_])
    для имя в имена {
        вывод(имя + ": " + стр(голоса[имя]))
    }
    пусть лучшие = имена.отобрать(функ(и_) = голоса[и_] == голоса[имена[0]])
    если лучшие.длина == 1 {
        вывод("победитель: " + лучшие[0])
    } иначе {
        вывод("ничья: " + лучшие.соединить(", "))
    }
}
