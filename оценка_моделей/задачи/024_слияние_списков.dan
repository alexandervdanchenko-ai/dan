пусть а = ввод().разбить().преобразовать(функ(с) = цел(с))
пусть б = ввод().разбить().преобразовать(функ(с) = цел(с))
перем итог: [стр] = []
перем и_ = 0
перем к = 0
пока и_ < а.длина или к < б.длина {
    если к >= б.длина или (и_ < а.длина и а[и_] <= б[к]) {
        итог.добавить(стр(а[и_]))
        и_ += 1
    } иначе {
        итог.добавить(стр(б[к]))
        к += 1
    }
}
вывод(итог.соединить(" "))
