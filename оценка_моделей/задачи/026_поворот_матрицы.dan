перем таблица: [[цел]] = []
перем строка = ввод()
пока строка != "" {
    таблица.добавить(строка.разбить().преобразовать(функ(с) = цел(с)))
    строка = ввод()
}
если таблица.длина > 0 {
    для с в 0..таблица[0].длина - 1 {
        перем выход: [стр] = []
        для р в 0..таблица.длина - 1 {
            выход.добавить(стр(таблица[таблица.длина - 1 - р][с]))
        }
        вывод(выход.соединить(" "))
    }
}
