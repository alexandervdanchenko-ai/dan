перем книга: {стр: стр} = {}
перем строка = ввод()
пока строка != "" {
    пусть ч = строка.разбить()
    если ч[0] == "добавить" и ч.длина == 3 {
        если книга.содержит(ч[1]) {
            вывод("обновлено")
        } иначе {
            вывод("добавлено")
        }
        книга[ч[1]] = ч[2]
    } иначе если ч[0] == "найти" и ч.длина == 2 {
        вывод(книга.найти(ч[1]) иначе "не найдено")
    } иначе если ч[0] == "удалить" и ч.длина == 2 {
        если книга.содержит(ч[1]) {
            книга.удалить(ч[1])
            вывод("удалено")
        } иначе {
            вывод("не найдено")
        }
    } иначе если ч[0] == "список" и ч.длина == 1 {
        если книга.длина == 0 { вывод("пусто") }
        для имя в упорядочить(книга.ключи()) {
            вывод(имя + ": " + книга[имя])
        }
    } иначе {
        вывод("неизвестная команда")
    }
    строка = ввод()
}
