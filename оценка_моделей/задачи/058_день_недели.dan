пусть дни = ["понедельник", "вторник", "среда", "четверг", "пятница", "суббота", "воскресенье"]
перем строка = ввод()
пока строка != "" {
    если пусть д = разобрать_дату(строка.обрезать()) {
        вывод(дни[д.день_недели - 1])
    } иначе {
        вывод("неверная дата")
    }
    строка = ввод()
}
