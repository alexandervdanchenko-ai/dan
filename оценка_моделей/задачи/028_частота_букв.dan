пусть алфавит = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя"
перем счёт: {стр: цел} = {}
перем строка = ввод()
пока строка != "" {
    для б в строка.строчные() {
        если алфавит.содержит(б) {
            счёт[б] = счёт.получить(б, 0) + 1
        }
    }
    строка = ввод()
}
пусть буквы = упорядочить(счёт.ключи()).упорядочить_по(функ(б) = -счёт[б])
для б в буквы {
    вывод(б + ": " + стр(счёт[б]))
}
