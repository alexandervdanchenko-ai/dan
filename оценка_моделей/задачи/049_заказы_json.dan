подключить "json"

тип Товар {
    название: стр
    цена: цел
    количество: цел
}

тип Заказ {
    номер "id": цел
    клиент: стр
    товары: [Товар] = []
}

если пусть заказы = json.разобрать_в(прочитать(аргументы()[0]), [Заказ]) {
    перем итого = 0
    для з в заказы {
        перем сумма_заказа = 0
        для т в з.товары { сумма_заказа += т.цена * т.количество }
        вывод(стр(з.номер) + " " + з.клиент + ": " + стр(сумма_заказа))
        итого += сумма_заказа
    }
    вывод("итого: " + стр(итого))
} иначе {
    вывод("неверные данные")
    завершить(1)
}
