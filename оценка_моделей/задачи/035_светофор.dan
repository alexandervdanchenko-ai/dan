тип Свет {
    Красный
    Зелёный
    Жёлтый
    Мигает
}

функ название(с: Свет) -> стр {
    выбор с {
        Красный { вернуть "красный" }
        Зелёный { вернуть "зелёный" }
        Жёлтый { вернуть "жёлтый" }
        Мигает { вернуть "мигает" }
    }
}

функ далее(с: Свет) -> Свет {
    выбор с {
        Красный { вернуть Зелёный }
        Зелёный { вернуть Жёлтый }
        Жёлтый { вернуть Красный }
        Мигает { вернуть Красный }
    }
}

перем свет = Красный
перем событие = ввод()
пока событие != "" {
    если событие == "далее" {
        свет = далее(свет)
        вывод(название(свет))
    } иначе если событие == "авария" {
        свет = Мигает
        вывод(название(свет))
    } иначе если событие == "сброс" {
        свет = Красный
        вывод(название(свет))
    } иначе {
        вывод("неизвестное событие")
    }
    событие = ввод()
}
