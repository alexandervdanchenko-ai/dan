подключить "csv"

пусть таблица = csv.разобрать_с_разделителем(прочитать(аргументы()[0]), ";")!
перем суммы: {стр: цел} = {}
перем всего = 0
для н в 1..таблица.длина - 1 {
    пусть отдел = таблица[н][0]
    пусть с = цел(таблица[н][2])
    суммы[отдел] = суммы.получить(отдел, 0) + с
    всего += с
}
для отдел в упорядочить(суммы.ключи()) {
    вывод(отдел + ": " + стр(суммы[отдел]))
}
вывод("всего: " + стр(всего))
