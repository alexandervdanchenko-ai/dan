тип Счёт {
    остаток: цел = 0
}

функ Счёт.пополнить(сумма: цел) -> Счёт! {
    если сумма <= 0 { вернуть ошибка("сумма должна быть больше нуля") }
    вернуть Счёт(сам.остаток + сумма)
}

функ Счёт.снять(сумма: цел) -> Счёт! {
    если сумма <= 0 { вернуть ошибка("сумма должна быть больше нуля") }
    если сумма > сам.остаток { вернуть ошибка("недостаточно средств") }
    вернуть Счёт(сам.остаток - сумма)
}

функ выполнить(с: Счёт, строка: стр) -> Счёт! {
    пусть ч = строка.разбить()
    если ч.длина == 2 и ч[0] == "пополнить" {
        вернуть с.пополнить(цел(ч[1]))
    }
    если ч.длина == 2 и ч[0] == "снять" {
        вернуть с.снять(цел(ч[1]))
    }
    если ч.длина == 1 и ч[0] == "баланс" {
        вывод(с.остаток)
        вернуть с
    }
    вернуть ошибка("неизвестная команда")
}

перем счёт = Счёт()
перем строка = ввод()
пока строка != "" {
    если пусть новый = выполнить(счёт, строка) {
        счёт = новый
    } иначе ошибка о {
        вывод("отказ: " + о)
    }
    строка = ввод()
}
вывод("итог: " + стр(счёт.остаток))
