пусть путь = аргументы()[0]
если не существует(путь) {
    вывод("нет файла")
    завершить(1)
}
пусть данные = прочитать_байты(путь)
записать(путь + ".gz", сжать_gzip(данные))
пусть распакованные = распаковать(прочитать_байты(путь + ".gz"))
если распакованные == данные {
    вывод("совпадает")
} иначе {
    вывод("не совпадает")
}
вывод("crc32: " + стр(контрольная_сумма(данные)))
