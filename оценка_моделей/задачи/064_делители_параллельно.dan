пусть числа = ввод().разбить().преобразовать(функ(с) = цел(с))
перем делителей: [цел] = []
для _ в числа { делителей.добавить(0) }
параллельно для к в 0..числа.длина - 1 {
    перем н = 0
    перем д = 1
    пока д * д <= числа[к] {
        если числа[к] % д == 0 {
            н += 1
            если д * д != числа[к] { н += 1 }
        }
        д += 1
    }
    делителей[к] = н
}
для к в 0..числа.длина - 1 {
    вывод(стр(числа[к]) + ": " + стр(делителей[к]))
}
