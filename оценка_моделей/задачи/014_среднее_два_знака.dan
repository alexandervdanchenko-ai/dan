перем сумма = 0
перем н = 0
перем строка = ввод()
пока строка != "" {
    сумма += цел(строка)
    н += 1
    строка = ввод()
}
если н == 0 {
    вывод("нет данных")
} иначе {
    пусть сотых = округлить(сумма * 100 / н)
    пусть дробная = сотых % 100
    перем хвост = стр(дробная)
    если дробная < 10 { хвост = "0" + хвост }
    вывод(стр(частное(сотых, 100)) + "." + хвост)
}
