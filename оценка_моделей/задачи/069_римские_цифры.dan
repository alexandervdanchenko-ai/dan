функ из_записи(т: стр) -> цел? {
    // каноническая запись: только буквы I, V, X, L, C, D, M, и обратный перевод даёт ту же запись
    если т.длина == 0 или не совпадает(т, "[IVXLCDM]+") { вернуть ничего }
    перем значения: {стр: цел} = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}
    перем итог = 0
    для к в 0..т.длина - 1 {
        пусть з = значения[т[к]]
        если к + 1 < т.длина и значения[т[к + 1]] > з {
            итог -= з
        } иначе {
            итог += з
        }
    }
    если итог < 1 или итог > 3999 или римское(итог) != т { вернуть ничего }
    вернуть итог
}

перем строка = ввод()
пока строка != "" {
    пусть т = строка.обрезать()
    если пусть ч = разобрать_цел(т) {
        если ч >= 1 и ч <= 3999 {
            вывод(римское(ч))
        } иначе {
            вывод("ошибка")
        }
    } иначе если пусть ч = из_записи(т) {
        вывод(ч)
    } иначе {
        вывод("ошибка")
    }
    строка = ввод()
}
