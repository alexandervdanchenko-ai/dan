функ разделить(а: рац, б: цел) -> рац! {
    если б == 0 { вернуть ошибка("деление на ноль") }
    вернуть а / б
}

функ число(т: стр) -> цел! {
    если пусть ч = разобрать_цел(т) { вернуть ч }
    вернуть ошибка("«" + т + "» не число")
}

функ вычислить(строка: стр) -> рац! {
    пусть части = строка.разбить(" / ")
    перем итог = рац(число(части[0].обрезать())!, 1)
    для к в 1..части.длина - 1 {
        итог = разделить(итог, число(части[к].обрезать())!)!
    }
    вернуть итог
}

если пусть р = вычислить(ввод()) {
    вывод(р)
} иначе ошибка о {
    вывод("ошибка: " + о)
}
