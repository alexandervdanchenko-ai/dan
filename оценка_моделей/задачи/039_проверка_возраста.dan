функ возраст(т: стр) -> цел! {
    если ошибка _ = разобрать_цел(т) { вернуть ошибка("не число") }
    пусть ч = разобрать_цел(т)!
    если ч < 0 { вернуть ошибка("меньше нуля") }
    если ч > 150 { вернуть ошибка("больше 150") }
    вернуть ч
}

перем строка = ввод()
пока строка != "" {
    если пусть лет = возраст(строка) {
        вывод("ок " + стр(лет))
    } иначе ошибка о {
        вывод("ошибка: " + о)
    }
    строка = ввод()
}
