[{"id": 7, "клиент": "Ким", "адрес": "Тверь"}, {"id": 8, "клиент": "Ли", "товары": [{"название": "мёд", "цена": 500, "количество": 3, "сорт": "липовый"}]}]
=== вывод
7 Ким: 0
8 Ли: 1500
итого: 1500
