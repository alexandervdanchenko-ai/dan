пусть папка = аргументы()[0]
если не существует(папка) или не это_папка(папка) {
    вывод("нет папки: " + папка)
    завершить(1)
}
перем всего = 0
для имя в список_файлов(папка) {
    если имя.оканчивается("/") { продолжить }
    пусть размер = размер_файла(папка + "/" + имя)
    всего += размер
    вывод(имя + " " + стр(размер))
}
вывод("всего: " + стр(всего) + " байт")
