функ очистить(с: стр) -> стр {
    перем итог = ""
    для б в с {
        если не ".,!?;:".содержит(б) { итог = итог + б }
    }
    вернуть итог
}

перем лучшее = ""
для с в ввод().разбить() {
    пусть слово = очистить(с)
    если слово.длина > лучшее.длина { лучшее = слово }
}
если лучшее.длина == 0 {
    вывод("нет слов")
} иначе {
    вывод(лучшее + " " + стр(лучшее.длина))
}
