подключить "json"

функ найти_по_пути(корень: json.Значение, путь: стр) -> json.Значение? {
    перем з = корень
    для часть в путь.разбить(".") {
        перем следующее: json.Значение? = ничего
        выбор з {
            json.Массив(элементы) {
                если пусть н = разобрать_цел(часть) {
                    если н >= 0 и н < элементы.длина { следующее = элементы[н] }
                }
            }
            json.Объект(поля) {
                следующее = поля.найти(часть)
            }
            иначе {}
        }
        если пусть с = следующее {
            з = с
        } иначе {
            вернуть ничего
        }
    }
    вернуть з
}

пусть корень = json.разобрать(прочитать(аргументы()[0])) иначе json.Пусто
перем путь = ввод()
пока путь != "" {
    если пусть з = найти_по_пути(корень, путь) {
        вывод(json.записать(з))
    } иначе {
        вывод("нет")
    }
    путь = ввод()
}
