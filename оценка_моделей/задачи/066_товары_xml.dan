подключить "xml"

если пусть корень = xml.разобрать(прочитать(аргументы()[0])) {
    перем итого = 0
    для т в корень.все("товар") {
        пусть стоимость = цел(т.значение("цена").обрезать()) * цел(т.значение("количество").обрезать())
        вывод((т.атрибут("код") иначе "") + " " + т.значение("название").обрезать() + ": " + стр(стоимость))
        итого += стоимость
    }
    вывод("итого: " + стр(итого))
} иначе {
    вывод("неверный XML")
    завершить(1)
}
