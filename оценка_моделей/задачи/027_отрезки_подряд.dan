пусть числа = ввод().разбить().преобразовать(функ(с) = цел(с))
перем части: [стр] = []
перем н = 0
пока н < числа.длина {
    перем к = н
    пока к + 1 < числа.длина и числа[к + 1] == числа[к] + 1 { к += 1 }
    если к > н {
        части.добавить(стр(числа[н]) + "-" + стр(числа[к]))
    } иначе {
        части.добавить(стр(числа[н]))
    }
    н = к + 1
}
вывод(части.соединить(", "))
