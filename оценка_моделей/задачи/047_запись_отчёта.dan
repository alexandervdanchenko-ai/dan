перем числа: [цел] = []
перем строка = ввод()
пока строка != "" {
    числа.добавить(цел(строка))
    строка = ввод()
}
перем текст = "количество: " + стр(числа.длина) + "\n"
если числа.длина > 0 {
    текст = текст + "сумма: " + стр(сумма(числа)) + "\n"
    текст = текст + "наименьшее: " + стр(мин(числа)) + "\n"
    текст = текст + "наибольшее: " + стр(макс(числа)) + "\n"
}
записать("отчёт.txt", текст)
вывод("отчёт записан")
