функ обработчик(вход: канал<стр>, выход: канал<стр>) {
    перем номер = 0
    для строка в вход {
        номер += 1
        выход.отправить(стр(номер) + ": " + строка.прописные())
    }
    выход.закрыть()
}

функ отправитель(строки: [стр], вход: канал<стр>) {
    для с в строки { вход.отправить(с) }
    вход.закрыть()
}

перем строки: [стр] = []
перем строка = ввод()
пока строка != "" {
    строки.добавить(строка)
    строка = ввод()
}
пусть вход: канал<стр> = канал(4)
пусть выход: канал<стр> = канал(4)
параллельно {
    запустить обработчик(вход, выход)
    запустить отправитель(строки, вход)
    для с в выход { вывод(с) }
}
