пусть т = ввод().обрезать()
перем знак = 1
перем с = т
если т.начинается("-") {
    знак = -1
    с = т[1..т.длина - 1]
}
пусть части = с.разбить(".")
перем итог = рац(цел(части[0]), 1)
если части.длина == 2 и части[1].длина > 0 {
    итог += рац(цел(части[1]), 10 ^ части[1].длина)
}
вывод(итог * знак)
