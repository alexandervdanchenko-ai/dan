пусть т = ввод().строчные().заменить("ё", "е")
перем знаки: [стр] = []
для б в т {
    если б.прописные() != б или "0123456789".содержит(б) {
        знаки.добавить(б)
    }
}
перем да = истина
для к в 0..знаки.длина - 1 {
    если знаки[к] != знаки[знаки.длина - 1 - к] { да = ложь }
}
если да {
    вывод("да")
} иначе {
    вывод("нет")
}
