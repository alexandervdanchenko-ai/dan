перем настройки: {стр: стр} = {}
перем ошибки: [стр] = []
перем номер = 0
перем строка = ввод()
пока строка != "" {
    номер += 1
    пусть т = строка.обрезать()
    если не т.начинается("#") {
        пусть н = т.найти("=")
        если н < 0 {
            ошибки.добавить("строка " + стр(номер) + ": нет знака =")
        } иначе {
            перем ключ = ""
            если н > 0 { ключ = т[0..н - 1].обрезать() }
            перем значение = ""
            если н < т.длина - 1 { значение = т[н + 1..т.длина - 1].обрезать() }
            если ключ == "" {
                ошибки.добавить("строка " + стр(номер) + ": пустой ключ")
            } иначе если настройки.содержит(ключ) {
                ошибки.добавить("строка " + стр(номер) + ": повтор ключа «" + ключ + "»")
            } иначе {
                настройки[ключ] = значение
            }
        }
    }
    строка = ввод()
}
если ошибки.длина > 0 {
    для о в ошибки { вывод(о) }
    завершить(2)
}
для ключ в упорядочить(настройки.ключи()) {
    вывод(ключ + "=" + настройки[ключ])
}
