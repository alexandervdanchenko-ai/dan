перем отделы: {стр: стр?} = {}
пусть н = цел(ввод())
для к в 1..н {
    пусть строка = ввод()
    пусть д = строка.найти(":")
    пусть имя = строка[0..д - 1].обрезать()
    перем отдел: стр? = ничего
    если д < строка.длина - 1 и строка[д + 1..строка.длина - 1].обрезать() != "" {
        отдел = строка[д + 1..строка.длина - 1].обрезать()
    }
    отделы[имя] = отдел
}
перем имя = ввод()
пока имя != "" {
    если отделы.содержит(имя.обрезать()) {
        вывод(отделы[имя.обрезать()] иначе "без отдела")
    } иначе {
        вывод("нет такого сотрудника")
    }
    имя = ввод()
}
