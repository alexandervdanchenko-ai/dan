тип Отрезок {
    начало: цел
    конец: цел
}

перем отрезки: [Отрезок] = []
перем строка = ввод()
пока строка != "" {
    пусть ч = строка.разбить()
    отрезки.добавить(Отрезок(цел(ч[0]), цел(ч[1])))
    строка = ввод()
}
пусть по_порядку = отрезки.упорядочить_по(функ(о) = о.начало)
перем итог: [Отрезок] = []
для о в по_порядку {
    если итог.длина > 0 и о.начало <= итог[итог.длина - 1].конец {
        итог[итог.длина - 1].конец = макс(итог[итог.длина - 1].конец, о.конец)
    } иначе {
        итог.добавить(о)
    }
}
для о в итог {
    вывод(стр(о.начало) + " " + стр(о.конец))
}
