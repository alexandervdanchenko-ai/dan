тип Человек {
    фамилия: стр
    возраст: цел
    город: стр
}

перем люди: [Человек] = []
перем строка = ввод()
пока строка != "" {
    пусть ч = строка.разбить()
    люди.добавить(Человек(ч[0], цел(ч[1]), ч[2]))
    строка = ввод()
}
// упорядочивание устойчиво: сначала по последнему признаку, затем по первому
пусть итог = люди.упорядочить_по(функ(ч) = ч.фамилия).упорядочить_по(функ(ч) = -ч.возраст).упорядочить_по(функ(ч) = ч.город)
для ч в итог {
    вывод(ч.фамилия + " " + стр(ч.возраст) + " " + ч.город)
}
