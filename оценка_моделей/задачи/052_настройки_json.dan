подключить "json"

тип Настройки {
    порт: цел
    адрес: стр = "127.0.0.1"
    отладка: лог = ложь
    пользователи: [стр] = []
}

функ загрузить() -> Настройки! {
    если не существует("настройки.json") { вернуть ошибка("нет файла") }
    вернуть json.разобрать_в(прочитать("настройки.json"), Настройки)
}

если пусть н = загрузить() {
    вывод(н.адрес + ":" + стр(н.порт))
    если н.отладка {
        вывод("отладка: да")
    } иначе {
        вывод("отладка: нет")
    }
    вывод("пользователей: " + стр(н.пользователи.длина))
} иначе {
    вывод("неверные настройки")
    завершить(1)
}
