редакция 2026
// Обобщённые типы: пара значений и двоичное дерево поиска.
тип Пара<А, Б> { первое: А, второе: Б }

тип Дерево<Т> {
    Лист
    Узел(значение: Т, левое: Дерево<Т>, правое: Дерево<Т>)
}

функ вставить<Т: Упорядоченное>(д: Дерево<Т>, х: Т) -> Дерево<Т> {
    выбор д {
        Лист { вернуть Узел(х, Лист, Лист) }
        Узел(з, л, п) {
            если х < з { вернуть Узел(з, вставить(л, х), п) }
            вернуть Узел(з, л, вставить(п, х))
        }
    }
}

функ по_порядку<Т>(д: Дерево<Т>) -> [Т] {
    выбор д {
        Лист { вернуть [] }
        Узел(з, л, п) {
            перем итог = по_порядку(л)
            итог.добавить(з)
            для х в по_порядку(п) { итог.добавить(х) }
            вернуть итог
        }
    }
}

вывод(Пара("Иванов", 65000))
перем дерево: Дерево<стр> = Лист
для фио в ["Сидоров", "Антонов", "Петров", "Борисов"] {
    дерево = вставить(дерево, фио)
}
вывод(по_порядку(дерево))
