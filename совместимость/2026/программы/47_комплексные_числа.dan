// Комплексные числа: корни квадратного уравнения с отрицательным дискриминантом.
вывод("x² + 2x + 5 = 0: " + стр(комплексные_корни(1, 2, 5)))
пусть з = компл(3, 4)
вывод("|3 + 4i| = " + стр(з.модуль))
вывод("(3 + 4i)(3 - 4i) = " + стр(з * з.сопряжённое))
вывод("i² = " + стр(компл(0, 1) ^ 2))
вывод("√(-9) = " + стр(корень(компл(-9))))
