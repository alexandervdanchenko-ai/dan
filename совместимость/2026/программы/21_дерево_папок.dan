редакция 2026
// Задача: посчитать все папки в дереве, построенном через список вложенных значений.
тип Папка {
    имя: стр
    вложенные: [Папка] = []
}

функ количество(п: Папка) -> цел {
    перем всего = 1
    для в_ в п.вложенные {
        всего += количество(в_)
    }
    вернуть всего
}

пусть дела = Папка("Дела", [Папка("2025"), Папка("2026", [Папка("Иванов"), Папка("Петров")])])
вывод(количество(дела))
