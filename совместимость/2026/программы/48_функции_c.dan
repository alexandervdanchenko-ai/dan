// Вызов функций, написанных на C: стандартная библиотека C и математическая.
внешняя "" {
    функ длина_в_байтах(с: стр) -> цел = "strlen"
}
внешняя "m" {
    функ гипотенуза_c(а: дроб, б: дроб) -> дроб = "hypot"
}

вывод("«Привет» занимает " + стр(длина_в_байтах("Привет")) + " байтов, символов - " + стр("Привет".длина))
вывод("гипотенуза треугольника 3, 4: " + стр(гипотенуза_c(3, 4)))
