редакция 2026
// Задача: сгруппировать названия книг по авторам (словарь со списками).
тип Книга {
    название: стр
    автор: стр
}

пусть книги = [Книга("Задачи о дробях", "Иванов"), Книга("Геометрия", "Петрова"),
               Книга("Многочлены", "Иванов")]
перем по_авторам: {стр: [стр]} = {}
для к в книги {
    если не по_авторам.содержит(к.автор) {
        по_авторам[к.автор] = []
    }
    по_авторам[к.автор].добавить(к.название)
}
вывод(по_авторам)
для автор в по_авторам {
    вывод(автор + ": " + стр(по_авторам[автор].длина))
}
