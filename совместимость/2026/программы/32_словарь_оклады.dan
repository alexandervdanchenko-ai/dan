редакция 2026
// Задача: добавить, изменить, найти и перебрать значения словаря.
перем оклады = {"Иванов": 65000, "Петров": 52000}
оклады["Сидорова"] = 78000
оклады["Иванов"] += 5000
оклады.удалить("Петров")
вывод(оклады)
вывод(оклады.найти("Петров") иначе 0)
перем фонд = 0
для фамилия в оклады {
    фонд += оклады[фамилия]
}
вывод(фонд)
вывод(оклады.ключи())
