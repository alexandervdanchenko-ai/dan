редакция 2026
// Регулярные выражения (шаблоны): проверка, поиск, группы, замена, разбиение.
пусть текст = "Иск от 12.03.2026 на сумму 150000 руб., пени 2500 руб."
вывод(совпадает("2026-10-26", "\\d{4}-\\d{2}-\\d{2}"))
вывод(найти_шаблон(текст, "\\d{2}\\.\\d{2}\\.\\d{4}") иначе "дата не найдена")
вывод(найти_все(текст, "\\d+ руб"))
пусть г = группы("Иванов Иван Иванович", "(\\w+) (\\w)\\w* (\\w)\\w*")
вывод(г[1] + " " + г[2] + "." + г[3] + ".")
вывод(заменить_шаблон("Иванов Иван", "(\\w+) (\\w+)", "$2 $1"))
вывод(разбить_по_шаблону("яблоки, груши;сливы ;  вишня", "\\s*[,;]\\s*"))
вывод(совпадает("ПРИВЕТ", "(?i)привет"))
вывод(найти_все("кот, котёнок, скот", "\\bкот\\w*"))
