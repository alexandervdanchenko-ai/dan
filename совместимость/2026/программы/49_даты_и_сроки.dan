редакция 2026
// Даты: арифметика дней, месяцы, рабочие дни и сравнение.
пусть решение = дата("26.10.2026")
// срок обжалования - месяц со дня принятия решения
пусть последний_день = добавить_месяцы(решение, 1)
вывод("решение от " + стр(решение) + ", обжаловать до " + стр(последний_день))
вывод("на подготовку дней: " + стр(последний_день - решение))
// срок в рабочих днях: выходные и праздники пропускаются
вывод("5 рабочих дней с 30.12.2026: " + стр(добавить_рабочие_дни(дата(2026, 12, 30), 5)))
пусть дни = ["пн", "вт", "ср", "чт", "пт", "сб", "вс"]
вывод("26.10.2026 - " + дни[решение.день_недели - 1] + ", день года " + стр(решение.день_года))
вывод(добавить_месяцы(дата(2026, 1, 31), 1))
вывод(дата(2024, 2, 28) + 1 < дата("2024-03-01"))
перем д = дата(2026, 5, 1)
перем праздники = 0
пока д.месяц == 5 {
    если праздник(д) { праздники += 1 }
    д += 1
}
вывод("нерабочих праздничных дней в мае: " + стр(праздники))
вывод(разобрать_дату("31.06.2026") иначе дата(1, 1, 1))
