// Ошибка: тип не выполняет интерфейс - у него нет одного из методов.
интерфейс Документ {
    функ заголовок() -> стр
    функ страниц() -> цел
}

тип Отчёт { автор: стр }
функ Отчёт.заголовок() -> стр { вернуть "Отчёт о вычислениях, автор " + сам.автор }

функ показать<Д: Документ>(д: Д) -> стр {
    вернуть д.заголовок() + ", страниц: " + стр(д.страниц())
}
вывод(показать(Отчёт("Иванова И.И.")))
