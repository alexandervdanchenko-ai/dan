// Исправлено: объявлен недостающий метод «страниц».
интерфейс Документ {
    функ заголовок() -> стр
    функ страниц() -> цел
}

тип Иск { истец: стр }
функ Иск.заголовок() -> стр { вернуть "Исковое заявление " + сам.истец }
функ Иск.страниц() -> цел { вернуть 4 }

функ показать<Д: Документ>(д: Д) -> стр {
    вернуть д.заголовок() + ", страниц: " + стр(д.страниц())
}
вывод(показать(Иск("Иванова И.И.")))
