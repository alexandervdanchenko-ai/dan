/// Документация из комментариев «///», написанная на Дане: страницы HTML.
///
/// Делает то же, что dokumentaciya.py, и для каждого набора файлов создаёт
/// те же страницы (проверяет test_sam.py).
///
///     подключить "сам/документация"
///     пусть модуль = документация.извлечь(текст, путь, редакции, версия)!
///     пусть файлы = документация.создать([модуль], "документация", "/")
///
/// Комментарий из трёх косых черт, стоящий в строках прямо над объявлением,
/// - описание этого объявления; блок «///» в самом начале файла, отделённый
/// от кода пустой строкой, - описание модуля. Текст описания записывается
/// упрощённой разметкой Markdown: абзацы, заголовки «# », списки «* » и «- »,
/// `код`, блоки кода между строками ``` или с отступом в четыре пробела,
/// **жирный**, _курсив_, ссылки [текст](адрес) и ссылки на объявления [имя].

подключить "лексер"
подключить "разбор"

/// Описание объявления: функции, метода, типа, интерфейса, варианта, поля или переменной.
общий тип Описание {
    вид: стр
    /// как в программе: «площадь», «Точка.длина», «Фигура.Круг»
    имя: стр
    /// строка объявления
    подпись: стр
    /// текст описания без «///»
    текст: стр
    строка: цел
    открытое: лог = ложь
    /// поля, варианты, методы интерфейса
    части: [Описание] = []
}

/// Описания одного файла программы.
общий тип Модуль {
    имя: стр
    путь: стр
    /// описание модуля
    текст: стр
    описания: [Описание]
    строка_описания: цел = 0
}

тип Комментарий {
    текст: стр
    первая: цел
}

// ---------- строки ----------

функ пробельный(з: стр) -> лог {
    вернуть з == " " или з == "\t" или з == "\n" или з == "\r" или код_символа(з) == 12 или код_символа(з) == 11
}

функ без_пробелов_слева(текст: стр) -> стр {
    пусть с = текст.символы()
    перем н = 0
    пока н < с.длина и пробельный(с[н]) { н += 1 }
    вернуть кусок(с, н, с.длина)
}

функ пустая(текст: стр) -> лог {
    для з в текст.символы() {
        если не пробельный(з) { вернуть ложь }
    }
    вернуть истина
}

функ кусок(с: [стр], от: цел, до: цел) -> стр {
    перем итог: [стр] = []
    для н в от..до - 1 { итог.добавить(с[н]) }
    вернуть итог.соединить("")
}

/// Текст без переводов строк в начале и в конце.
функ без_крайних_переводов(текст: стр) -> стр {
    пусть с = текст.символы()
    перем от = 0
    перем до = с.длина
    пока от < до и с[от] == "\n" { от += 1 }
    пока до > от и с[до - 1] == "\n" { до -= 1 }
    вернуть кусок(с, от, до)
}

/// Текст без пробелов с обоих концов.
функ обрезать_всё(текст: стр) -> стр {
    пусть с = текст.символы()
    перем от = 0
    перем до = с.длина
    пока от < до и пробельный(с[от]) { от += 1 }
    пока до > от и пробельный(с[до - 1]) { до -= 1 }
    вернуть кусок(с, от, до)
}

функ знак_слова(з: стр) -> лог {
    вернуть лексер.буква(з) или лексер.цифра(з) или з == "_"
}

/// Замена «&», «<», «>» (и кавычек, если «кавычки») на обозначения HTML, как html.escape.
общий функ экранировать(текст: стр, кавычки: лог) -> стр {
    перем итог = текст.заменить("&", "&amp;").заменить("<", "&lt;").заменить(">", "&gt;")
    если кавычки { итог = итог.заменить("\"", "&quot;").заменить("'", "&#x27;") }
    вернуть итог
}

// ---------- извлечение ----------

функ без_черт(строки: [стр]) -> стр {
    перем итог: [стр] = []
    для с_ в строки {
        пусть с = без_пробелов_слева(с_).символы()
        перем от = 3
        если от > с.длина { от = с.длина }
        если от < с.длина и с[от] == " " { от += 1 }
        итог.добавить(кусок(с, от, с.длина))
    }
    вернуть без_крайних_переводов(итог.соединить("\n"))
}

функ тройной(строка: стр) -> лог { вернуть без_пробелов_слева(строка).начинается("///") }

/// Строки «///» прямо над строкой номер (от 1): текст и номер первой строки.
функ комментарий(строки: [стр], номер: цел) -> Комментарий {
    перем собрано: [стр] = []
    перем н = номер - 2
    пока н >= 0 и н < строки.длина и тройной(строки[н]) {
        собрано.вставить(0, строки[н])
        н -= 1
    }
    если собрано.длина == 0 { вернуть Комментарий("", 0) }
    вернуть Комментарий(без_черт(собрано), н + 2)
}

/// Блок «///» в начале файла (после пустых строк и обычных комментариев), за которым пустая строка.
функ описание_модуля(строки: [стр]) -> Комментарий {
    перем н = 0
    пока (н < строки.длина и (пустая(строки[н])
            или (без_пробелов_слева(строки[н]).начинается("//") и не тройной(строки[н])))) {
        н += 1
    }
    пусть начало = н
    пока н < строки.длина и тройной(строки[н]) { н += 1 }
    если н == начало или (н < строки.длина и не пустая(строки[н])) { вернуть Комментарий("", 0) }
    перем блок: [стр] = []
    для к в начало..н - 1 { блок.добавить(строки[к]) }
    вернуть Комментарий(без_черт(блок), начало + 1)
}

функ св(у: разбор.Узел, имя: стр) -> стр { вернуть разбор.свойство(у, имя) }
функ гр(у: разбор.Узел, имя: стр) -> [разбор.Узел] { вернуть разбор.часть_группы(у, имя) }

функ написание(у: разбор.Узел) -> стр {
    если св(у, "написание") != "" { вернуть св(у, "написание") }
    вернуть св(у, "имя")
}

функ параметры_типа(у: разбор.Узел) -> стр {
    пусть п = гр(у, "параметры_типа")
    если п.длина == 0 { вернуть "" }
    перем части: [стр] = []
    для т в п {
        перем ограничения: [стр] = []
        для о в гр(т, "ограничения") { ограничения.добавить(о.простые[0].значение) }
        если ограничения.длина > 0 {
            части.добавить(св(т, "имя") + ": " + ограничения.соединить(" и "))
        } иначе {
            части.добавить(св(т, "имя"))
        }
    }
    вернуть "<" + части.соединить(", ") + ">"
}

функ подпись_функции(ф: разбор.Узел, имя: стр) -> стр {
    // у метода «функ Тип.имя(...)» первый параметр «сам» добавлен разбором, в программе его не пишут
    перем параметры: [стр] = []
    для п в гр(ф, "параметры") {
        если не (св(ф, "метод_типа") != "" и св(п, "имя") == "сам") {
            параметры.добавить(св(п, "имя") + ": " + св(п, "тип"))
        }
    }
    перем результат = ""
    если св(ф, "тип_результата") != "" { результат = " -> " + св(ф, "тип_результата") }
    вернуть "функ " + имя + параметры_типа(ф) + "(" + параметры.соединить(", ") + ")" + результат
}

функ основа_имени(путь: стр) -> стр {
    перем имя = путь
    для р в ["/", "\\"] {
        пусть части = имя.разбить(р)
        имя = части[части.длина - 1]
    }
    пусть с = имя.символы()
    перем точка = -1
    для н в 0..с.длина - 1 {
        если с[н] == "." { точка = н }
    }
    // как os.path.splitext: точки в начале имени («.скрытый») не отделяют расширение
    перем начало = 0
    пока начало < с.длина и с[начало] == "." { начало += 1 }
    если точка <= начало - 1 или точка < начало { вернуть имя }
    вернуть кусок(с, 0, точка)
}

/// Описания объявлений файла; ошибки записи программы передаются вызывающему.
общий функ извлечь(исходник: стр, путь: стр, редакции: [стр], версия: стр) -> Модуль! {
    перем дерево = разбор.Узел("?")
    если пусть токены = лексер.разобрать(исходник) {
        если пусть д = разбор.разобрать(токены, редакции, версия) { дерево = д } иначе ошибка о { вернуть ошибка(о) }
    } иначе ошибка о {
        вернуть ошибка(о)
    }
    пусть строки = исходник.разбить("\n")
    пусть модуль_ = описание_модуля(строки)
    перем описания: [Описание] = []
    для у_ в гр(дерево, "инструкции") {
        пусть открытое = у_.открытый
        если у_.вид == "Функция" {
            если у_.текст != "" { продолжить }     // тест или замер
            перем имя = св(у_, "имя")
            перем вид = "функция"
            если св(у_, "метод_типа") != "" {
                имя = св(у_, "метод_типа") + "." + имя
                вид = "метод"
            }
            описания.добавить(Описание(вид, имя, подпись_функции(у_, имя), док(строки, у_, модуль_.первая), у_.строка, открытое))
        } иначе если у_.вид == "ОбъявлениеТипа" {
            пусть имя = написание(у_)
            перем части: [Описание] = []
            для п в гр(у_, "поля") {
                части.добавить(Описание("поле", имя + "." + написание(п), написание(п) + ": " + св(п, "тип"),
                    док(строки, п, модуль_.первая), п.строка))
            }
            описания.добавить(Описание("тип", имя, "тип " + имя + параметры_типа(у_), док(строки, у_, модуль_.первая),
                у_.строка, открытое, части))
        } иначе если у_.вид == "ОбъявлениеВариантов" {
            пусть имя = написание(у_)
            перем части: [Описание] = []
            для в_ в гр(у_, "варианты") {
                перем поля: [стр] = []
                для п в гр(в_, "поля") { поля.добавить(написание(п) + ": " + св(п, "тип")) }
                перем запись = ""
                если поля.длина > 0 { запись = "(" + поля.соединить(", ") + ")" }
                части.добавить(Описание("вариант", имя + "." + написание(в_), написание(в_) + запись,
                    док(строки, в_, модуль_.первая), в_.строка))
            }
            описания.добавить(Описание("тип", имя, "тип " + имя + параметры_типа(у_), док(строки, у_, модуль_.первая),
                у_.строка, открытое, части))
        } иначе если у_.вид == "ОбъявлениеИнтерфейса" {
            пусть имя = написание(у_)
            перем части: [Описание] = []
            для м в гр(у_, "методы") {
                части.добавить(Описание("метод", имя + "." + св(м, "имя"), подпись_функции(м, св(м, "имя")),
                    док(строки, м, модуль_.первая), м.строка))
            }
            описания.добавить(Описание("интерфейс", имя, "интерфейс " + имя, док(строки, у_, модуль_.первая), у_.строка,
                открытое, части))
        } иначе если у_.вид == "ОбъявлениеПеременной" {
            перем тип_ = ""
            если св(у_, "тип") != "" { тип_ = ": " + св(у_, "тип") }
            перем слово = "пусть"
            если св(у_, "изменяемая") == "True" { слово = "перем" }
            описания.добавить(Описание("переменная", св(у_, "имя"), слово + " " + св(у_, "имя") + тип_,
                док(строки, у_, модуль_.первая), у_.строка))
        }
    }
    вернуть Модуль(основа_имени(путь), путь, модуль_.текст, описания, модуль_.первая)
}

/// Описание объявления; блок в начале файла с пустой строкой после него - описание модуля, а не объявления.
функ док(строки: [стр], у: разбор.Узел, строка_модуля: цел) -> стр {
    пусть к = комментарий(строки, у.строка)
    если к.текст != "" и к.первая == строка_модуля { вернуть "" }
    вернуть к.текст
}

/// Что попадает на страницу: общие объявления и объявления с описанием.
общий функ показываемые(модуль: Модуль) -> [Описание] {
    перем итог: [Описание] = []
    для о в модуль.описания {
        перем есть = о.открытое или о.текст != ""
        для ч в о.части {
            если ч.текст != "" { есть = истина }
        }
        если есть { итог.добавить(о) }
    }
    вернуть итог
}

/// Первый абзац описания одной строкой.
общий функ кратко(текст: стр) -> стр {
    перем абзац: [стр] = []
    для с в текст.разбить("\n") {
        пусть начало = без_пробелов_слева(с)
        если пустая(с) или с.начинается("    ") или начало.начинается("#") или начало.начинается("```") { прервать }
        абзац.добавить(обрезать_всё(с))
    }
    вернуть абзац.соединить(" ")
}

// ---------- разметка ----------

тип Ссылки {
    /// имена объявлений этого файла -> якорь
    свои: {стр: стр}
    /// «модуль.имя» -> адрес на странице модуля
    имена: {стр: стр}
}

функ найти_ссылку(с: Ссылки, имя: стр) -> стр {
    если с.свои.содержит(имя) и с.свои[имя] != "" { вернуть с.свои[имя] }
    если с.имена.содержит(имя) { вернуть с.имена[имя] }
    вернуть ""
}

/// «**жирный**» -> <b>жирный</b>, как re.sub(r"\*\*(.+?)\*\*", ...).
функ жирный(текст: стр) -> стр {
    пусть с = текст.символы()
    перем итог: [стр] = []
    перем н = 0
    пока н < с.длина {
        если н + 1 < с.длина и с[н] == "*" и с[н + 1] == "*" {
            перем к = н + 3
            перем найдено = -1
            пока к + 1 < с.длина {
                если с[к] == "*" и с[к + 1] == "*" {
                    найдено = к
                    прервать
                }
                к += 1
            }
            если найдено >= 0 {
                итог.добавить("<b>" + кусок(с, н + 2, найдено) + "</b>")
                н = найдено + 2
                продолжить
            }
        }
        итог.добавить(с[н])
        н += 1
    }
    вернуть итог.соединить("")
}

/// «_курсив_» -> <i>курсив</i>, как re.sub(r"(?<![\w])_(.+?)_(?![\w])", ...).
функ курсив(текст: стр) -> стр {
    пусть с = текст.символы()
    перем итог: [стр] = []
    перем н = 0
    пока н < с.длина {
        если с[н] == "_" и (н == 0 или не знак_слова(с[н - 1])) {
            перем к = н + 2
            перем найдено = -1
            пока к < с.длина {
                если с[к] == "_" и (к + 1 >= с.длина или не знак_слова(с[к + 1])) {
                    найдено = к
                    прервать
                }
                к += 1
            }
            если найдено >= 0 {
                итог.добавить("<i>" + кусок(с, н + 1, найдено) + "</i>")
                н = найдено + 1
                продолжить
            }
        }
        итог.добавить(с[н])
        н += 1
    }
    вернуть итог.соединить("")
}

/// Подходит ли адрес ссылки: https://, http://, mailto:, # или имя страницы .html.
функ годный_адрес(адрес: стр) -> лог {
    если (адрес.начинается("https://") или адрес.начинается("http://") или адрес.начинается("mailto:")
            или адрес.начинается("#")) {
        вернуть истина
    }
    пусть с = адрес.символы()
    перем длина = 0
    пока длина < с.длина и (знак_слова(с[длина]) или с[длина] == "." или с[длина] == "/" или с[длина] == "-") {
        длина += 1
    }
    для п в 1..длина - 5 {
        если кусок(с, п, п + 5) == ".html" { вернуть истина }
    }
    вернуть ложь
}

/// «[текст](адрес)» -> ссылка, как re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)", ...).
функ ссылки_с_адресом(текст: стр) -> стр {
    пусть с = текст.символы()
    перем итог: [стр] = []
    перем н = 0
    пока н < с.длина {
        если с[н] == "[" {
            перем к = н + 1
            пока к < с.длина и с[к] != "]" { к += 1 }
            если к > н + 1 и к + 1 < с.длина и с[к] == "]" и с[к + 1] == "(" {
                перем а = к + 2
                пока а < с.длина и с[а] != ")" и не пробельный(с[а]) { а += 1 }
                если а > к + 2 и а < с.длина и с[а] == ")" {
                    пусть подпись = кусок(с, н + 1, к)
                    пусть адрес = кусок(с, к + 2, а)
                    если годный_адрес(адрес) {
                        итог.добавить("<a href=\"" + экранировать(адрес, истина) + "\">" + подпись + "</a>")
                    } иначе {
                        итог.добавить(кусок(с, н, а + 1))
                    }
                    н = а + 1
                    продолжить
                }
            }
        }
        итог.добавить(с[н])
        н += 1
    }
    вернуть итог.соединить("")
}

/// «[имя]» -> ссылка на объявление, как re.sub(r"\[([^\W\d][\w.]*)\](?!\()", ...).
функ ссылки_на_имена(текст: стр, ссылки: Ссылки) -> стр {
    пусть с = текст.символы()
    перем итог: [стр] = []
    перем н = 0
    пока н < с.длина {
        если с[н] == "[" и н + 1 < с.длина и знак_слова(с[н + 1]) и не лексер.цифра(с[н + 1]) {
            перем к = н + 2
            пока к < с.длина и (знак_слова(с[к]) или с[к] == ".") { к += 1 }
            если к < с.длина и с[к] == "]" и не (к + 1 < с.длина и с[к + 1] == "(") {
                пусть имя = кусок(с, н + 1, к)
                пусть цель = найти_ссылку(ссылки, имя)
                если цель != "" {
                    итог.добавить("<a href=\"" + цель + "\"><code>" + имя + "</code></a>")
                } иначе {
                    итог.добавить(кусок(с, н, к + 1))
                }
                н = к + 1
                продолжить
            }
        }
        итог.добавить(с[н])
        н += 1
    }
    вернуть итог.соединить("")
}

/// Разметка внутри строки: `код`, **жирный**, _курсив_, [текст](адрес), [имя].
функ строчная(текст: стр, ссылки: Ссылки) -> стр {
    пусть с = текст.символы()
    перем итог: [стр] = []
    перем обычный: [стр] = []
    перем н = 0
    пока н < с.длина {
        если с[н] == "`" {
            перем к = н + 1
            пока к < с.длина и с[к] != "`" { к += 1 }
            если к < с.длина и к > н + 1 {
                итог.добавить(обычная_часть(обычный.соединить(""), ссылки))
                обычный = []
                итог.добавить("<code>" + экранировать(кусок(с, н + 1, к), истина) + "</code>")
                н = к + 1
                продолжить
            }
        }
        обычный.добавить(с[н])
        н += 1
    }
    итог.добавить(обычная_часть(обычный.соединить(""), ссылки))
    вернуть итог.соединить("")
}

функ обычная_часть(текст: стр, ссылки: Ссылки) -> стр {
    вернуть ссылки_на_имена(ссылки_с_адресом(курсив(жирный(экранировать(текст, ложь)))), ссылки)
}

функ заголовок_разметки(с: стр) -> лог {
    пусть з = с.символы()
    перем н = 0
    пока н < з.длина и з[н] == "#" { н += 1 }
    вернуть н >= 1 и н <= 4 и н < з.длина и з[н] == " "
}

функ пункт_списка(с: стр) -> лог {
    пусть з = с.символы()
    перем н = 0
    пока н < з.длина и пробельный(з[н]) { н += 1 }
    вернуть н + 1 < з.длина и (з[н] == "*" или з[н] == "-") и з[н + 1] == " "
}

тип Сборка {
    итог: [стр]
    абзац: [стр]
    список: [стр]
}

функ закрыть(исх: Сборка, ссылки: Ссылки) -> Сборка {
    перем с = исх
    если с.абзац.длина > 0 {
        перем части: [стр] = []
        для а в с.абзац { части.добавить(обрезать_всё(а)) }
        с.итог.добавить("<p>" + строчная(части.соединить(" "), ссылки) + "</p>")
        с.абзац = []
    }
    если с.список.длина > 0 {
        перем пункты = ""
        для п в с.список { пункты += "<li>" + строчная(п, ссылки) + "</li>" }
        с.итог.добавить("<ul>" + пункты + "</ul>")
        с.список = []
    }
    вернуть с
}

функ без_решёток(с: стр) -> стр {
    пусть з = с.символы()
    перем н = 0
    пока н < з.длина и з[н] == "#" { н += 1 }
    вернуть обрезать_всё(кусок(з, н, з.длина))
}

/// Упрощённый Markdown -> HTML.
функ в_html(текст: стр, ссылки: Ссылки) -> стр {
    пусть строки = текст.разбить("\n")
    перем с = Сборка([], [], [])
    перем н = 0
    пока н < строки.длина {
        пусть строка = строки[н]
        если обрезать_всё(строка).начинается("```") {
            с = закрыть(с, ссылки)
            перем код: [стр] = []
            н += 1
            пока н < строки.длина и не обрезать_всё(строки[н]).начинается("```") {
                код.добавить(строки[н])
                н += 1
            }
            с.итог.добавить("<pre><code>" + экранировать(код.соединить("\n"), истина) + "</code></pre>")
        } иначе если строка.начинается("    ") и с.список.длина == 0 {
            // строки с отступом в четыре пробела - код, даже сразу после абзаца
            с = закрыть(с, ссылки)
            перем код: [стр] = []
            пока н < строки.длина и (строки[н].начинается("    ") или пустая(строки[н])) {
                пусть з = строки[н].символы()
                перем от = 4
                если от > з.длина { от = з.длина }
                код.добавить(кусок(з, от, з.длина))
                н += 1
            }
            пока код.длина > 0 и пустая(код[код.длина - 1]) { код.удалить(код.длина - 1) }
            с.итог.добавить("<pre><code>" + экранировать(код.соединить("\n"), истина) + "</code></pre>")
            продолжить
        } иначе если пустая(строка) {
            с = закрыть(с, ссылки)
        } иначе если заголовок_разметки(строка) {
            с = закрыть(с, ссылки)
            с.итог.добавить("<h4>" + строчная(без_решёток(строка), ссылки) + "</h4>")
        } иначе если пункт_списка(строка) {
            если с.абзац.длина > 0 { с = закрыть(с, ссылки) }
            пусть з = обрезать_всё(строка).символы()
            с.список.добавить(обрезать_всё(кусок(з, 2, з.длина)))
        } иначе если с.список.длина > 0 и строка.начинается("  ") {
            с.список[с.список.длина - 1] = с.список[с.список.длина - 1] + " " + обрезать_всё(строка)
        } иначе {
            если с.список.длина > 0 { с = закрыть(с, ссылки) }
            с.абзац.добавить(строка)
        }
        н += 1
    }
    с = закрыть(с, ссылки)
    вернуть с.итог.соединить("\n")
}

// ---------- страницы ----------

функ стиль() -> стр {
    вернуть (":root { --фон: #fbfaf7; --текст: #1d1d1f; --тихий: #6b6b70; --рамка: #e3e1da; --код: #f1efe8; --ссылка: #1f5fbf; }\n"
        + "@media (prefers-color-scheme: dark) {\n"
        + "  :root { --фон: #18181a; --текст: #e8e6e1; --тихий: #a0a0a6; --рамка: #34343a; --код: #232327; --ссылка: #7fb0ff; }\n"
        + "}\n"
        + "* { box-sizing: border-box; }\n"
        + "body { margin: 0; background: var(--фон); color: var(--текст); font: 16px/1.55 system-ui, sans-serif; }\n"
        + "main { max-width: 860px; margin: 0 auto; padding: 24px 16px 64px; }\n"
        + "a { color: var(--ссылка); text-decoration: none; } a:hover { text-decoration: underline; }\n"
        + "h1 { font-size: 28px; margin: 8px 0 4px; } h2 { font-size: 20px; margin: 32px 0 8px; }\n"
        + "h4 { font-size: 15px; margin: 16px 0 4px; }\n"
        + "code, pre { font: 14px/1.45 ui-monospace, Consolas, monospace; background: var(--код); border-radius: 4px; }\n"
        + "code { padding: 1px 4px; } pre { padding: 10px 12px; overflow-x: auto; } pre code { padding: 0; }\n"
        + ".путь { color: var(--тихий); font-size: 14px; }\n"
        + ".объявление { border-top: 1px solid var(--рамка); padding: 12px 0; }\n"
        + ".подпись { font-weight: 600; background: none; padding: 0; font-size: 15px; word-break: break-word; }\n"
        + ".вид { color: var(--тихий); font-size: 13px; margin-left: 6px; }\n"
        + ".части { margin: 8px 0 0 16px; } .части .подпись { font-weight: 500; }\n"
        + ".нет { color: var(--тихий); font-style: italic; }\n"
        + "#поиск { width: 100%; padding: 8px 10px; font-size: 16px; border: 1px solid var(--рамка); border-radius: 6px;\n"
        + "         background: var(--фон); color: var(--текст); margin: 12px 0; }\n"
        + "ul.список { list-style: none; padding: 0; } ul.список li { padding: 4px 0; border-bottom: 1px solid var(--рамка); }\n")
}

функ поиск() -> стр {
    вернуть ("\nconst поле = document.getElementById(\"поиск\"), итоги = document.getElementById(\"найдено\");\n"
        + "поле.addEventListener(\"input\", () => {\n"
        + "  const ч = поле.value.trim().toLowerCase().replaceAll(\"ё\", \"е\");\n"
        + "  итоги.innerHTML = \"\";\n"
        + "  if (!ч) { итоги.hidden = true; document.getElementById(\"модули\").hidden = false; return; }\n"
        + "  итоги.hidden = false; document.getElementById(\"модули\").hidden = true;\n"
        + "  for (const з of ИНДЕКС.filter(з => (з.имя + \" \" + з.кратко).toLowerCase().replaceAll(\"ё\", \"е\").includes(ч)).slice(0, 200)) {\n"
        + "    const li = document.createElement(\"li\"), a = document.createElement(\"a\");\n"
        + "    a.href = з.адрес; a.textContent = з.модуль + \".\" + з.имя;\n"
        + "    li.append(a, document.createTextNode(з.кратко ? \" - \" + з.кратко : \"\"));\n"
        + "    итоги.append(li);\n"
        + "  }\n"
        + "});\n")
}

функ страница(заголовок: стр, тело: стр, скрипт: стр) -> стр {
    вернуть ("<!doctype html>\n<html lang=\"ru\"><head><meta charset=\"utf-8\">"
        + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
        + "<title>" + экранировать(заголовок, истина) + "</title><link rel=\"stylesheet\" href=\"стиль.css\"></head>"
        + "<body><main>" + тело + "</main>" + скрипт + "</body></html>\n")
}

функ файл_страницы(модуль: Модуль) -> стр { вернуть модуль.имя + ".html" }

функ объявление(о: Описание, ссылки: Ссылки) -> стр {
    перем вид = ""
    если о.вид == "тип" или о.вид == "интерфейс" или о.вид == "переменная" {
        вид = "<span class=\"вид\">" + о.вид + "</span>"
    }
    перем части = ["<div class=\"объявление\" id=\"" + экранировать(о.имя, истина) + "\">",
                   "<code class=\"подпись\">" + экранировать(о.подпись, истина) + "</code>" + вид]
    если о.текст != "" { части.добавить(в_html(о.текст, ссылки)) }
    если о.части.длина > 0 {
        части.добавить("<div class=\"части\">")
        для ч в о.части {
            перем описание = ""
            если ч.текст != "" { описание = в_html(ч.текст, ссылки) }
            части.добавить("<div id=\"" + экранировать(ч.имя, истина) + "\"><code class=\"подпись\">"
                + экранировать(ч.подпись, истина) + "</code>" + описание + "</div>")
        }
        части.добавить("</div>")
    }
    части.добавить("</div>")
    вернуть части.соединить("\n")
}

/// Строка в записи JSON, как json.dumps(..., ensure_ascii=False).
функ строка_json(текст: стр) -> стр {
    перем итог: [стр] = ["\""]
    для з в текст.символы() {
        пусть к = код_символа(з)
        если з == "\"" {
            итог.добавить("\\\"")
        } иначе если з == "\\" {
            итог.добавить("\\\\")
        } иначе если з == "\n" {
            итог.добавить("\\n")
        } иначе если з == "\r" {
            итог.добавить("\\r")
        } иначе если з == "\t" {
            итог.добавить("\\t")
        } иначе если к == 8 {
            итог.добавить("\\b")
        } иначе если к == 12 {
            итог.добавить("\\f")
        } иначе если к < 32 {
            пусть цифры = "0123456789abcdef".символы()
            итог.добавить("\\u00" + цифры[частное(к, 16)] + цифры[к % 16])
        } иначе {
            итог.добавить(з)
        }
    }
    итог.добавить("\"")
    вернуть итог.соединить("")
}

функ в_папке(папка: стр, имя: стр, разделитель: стр) -> стр {
    если папка.оканчивается("/") или папка.оканчивается(разделитель) { вернуть папка + имя }
    вернуть папка + разделитель + имя
}

/// Записать страницы в папку; результат - список созданных файлов (первый - index.html).
общий функ создать(модули: [Модуль], папка: стр, разделитель: стр) -> [стр] {
    если не существует(папка) { создать_папку(папка) }
    перем имена: {стр: стр} = {}                  // «модуль.имя» -> адрес
    для м в модули {
        для о в показываемые(м) {
            имена[м.имя + "." + о.имя] = файл_страницы(м) + "#" + о.имя
            для ч в о.части { имена[м.имя + "." + ч.имя] = файл_страницы(м) + "#" + ч.имя }
        }
    }
    перем файлы: [стр] = []
    перем индекс: [стр] = []
    для м в модули {
        перем свои: {стр: стр} = {}
        для о в показываемые(м) { свои[о.имя] = "#" + о.имя }
        для о в показываемые(м) {
            для ч в о.части { свои[ч.имя] = "#" + ч.имя }
        }
        пусть ссылки = Ссылки(свои, имена)
        перем тело = ["<p class=\"путь\"><a href=\"index.html\">Все модули</a></p><h1>" + экранировать(м.имя, истина) + "</h1>",
                      "<p class=\"путь\">" + экранировать(м.путь, истина) + "</p>"]
        если м.текст != "" { тело.добавить(в_html(м.текст, ссылки)) }
        пусть показ = показываемые(м)
        если показ.длина == 0 { тело.добавить("<p class=\"нет\">В файле нет общих объявлений и описаний.</p>") }
        для о в показ {
            тело.добавить(объявление(о, ссылки))
            индекс.добавить("{\"модуль\": " + строка_json(м.имя) + ", \"имя\": " + строка_json(о.имя) + ", \"кратко\": "
                + строка_json(кратко(о.текст)) + ", \"адрес\": " + строка_json(файл_страницы(м) + "#" + о.имя) + "}")
        }
        пусть путь = в_папке(папка, файл_страницы(м), разделитель)
        записать(путь, страница(м.имя + " - документация", тело.соединить("\n"), ""))
        файлы.добавить(путь)
    }
    перем строки = ""
    для м в модули {
        строки += "<li><a href=\"" + экранировать(файл_страницы(м), истина) + "\">" + экранировать(м.имя, истина) + "</a>"
        если м.текст != "" { строки += " - " + экранировать(кратко(м.текст), истина) }
        строки += "</li>"
    }
    пусть тело = ("<h1>Документация</h1><input id=\"поиск\" type=\"search\" placeholder=\"Найти функцию или тип\" autofocus>"
        + "<ul class=\"список\" id=\"найдено\" hidden></ul><ul class=\"список\" id=\"модули\">" + строки + "</ul>")
    пусть данные = ("[" + индекс.соединить(", ") + "]").заменить("</", "<\\/")
    пусть скрипт = "<script>const ИНДЕКС = " + данные + ";" + поиск() + "</script>"
    пусть путь = в_папке(папка, "index.html", разделитель)
    записать(путь, страница("Документация", тело, скрипт))
    записать(в_папке(папка, "стиль.css", разделитель), стиль())
    перем итог = [путь]
    для ф в файлы { итог.добавить(ф) }
    вернуть итог
}

// ---------- проверка ----------

/// Блок кода на Дане в описании: номер строки внутри описания и код.
общий тип Пример {
    номер: цел
    код: стр
}

/// Блоки кода на Дане в описании (``` без языка или с языком dan).
общий функ примеры(текст: стр) -> [Пример] {
    перем итог: [Пример] = []
    пусть строки = текст.разбить("\n")
    перем н = 0
    пока н < строки.длина {
        пусть с = обрезать_всё(строки[н])
        если с.начинается("```") {
            пусть з = с.символы()
            пусть язык = обрезать_всё(кусок(з, 3, з.длина)).строчные()
            пусть начало = н
            перем код: [стр] = []
            н += 1
            пока н < строки.длина и не обрезать_всё(строки[н]).начинается("```") {
                код.добавить(строки[н])
                н += 1
            }
            если язык == "" или язык == "dan" или язык == "дан" { итог.добавить(Пример(начало, код.соединить("\n"))) }
        }
        н += 1
    }
    вернуть итог
}

/// Исходник файла с тестами из примеров описаний и соответствие строк
/// (строка в тексте -> строка примера в файле); пустой текст, если примеров нет.
общий тип Проверочный {
    текст: стр
    соответствие: {цел: цел}
}

функ без_переводов_справа(текст: стр) -> стр {
    пусть с = текст.символы()
    перем до = с.длина
    пока до > 0 и с[до - 1] == "\n" { до -= 1 }
    вернуть кусок(с, 0, до)
}

общий функ текст_проверки(исходник: стр, модуль: Модуль) -> Проверочный {
    пусть строки_файла = исходник.разбить("\n")
    перем итог = без_переводов_справа(исходник).разбить("\n")
    перем соответствие: {цел: цел} = {}
    для о в модуль.описания {
        перем все = [о]
        для ч в о.части { все.добавить(ч) }
        для з в все {
            если з.текст == "" { продолжить }
            пусть первая = комментарий(строки_файла, з.строка).первая
            перем сдвиг = 0
            пока без_черт([строки_файла[первая - 1 + сдвиг]]) == "" { сдвиг += 1 }
            для пример в примеры(з.текст) {
                если пустая(пример.код) { продолжить }
                пусть название = ("пример к " + з.имя).заменить("\"", "'").заменить("\\", "/")
                итог.добавить("")
                итог.добавить("тест \"" + название + "\" {")
                пусть строки_примера = пример.код.разбить("\n")
                для н в 0..строки_примера.длина - 1 {
                    итог.добавить("    " + строки_примера[н])
                    соответствие[итог.длина] = первая + сдвиг + пример.номер + 1 + н
                }
                итог.добавить("}")
            }
        }
    }
    если соответствие.длина == 0 { вернуть Проверочный("", {}) }
    вернуть Проверочный(итог.соединить("\n") + "\n", соответствие)
}

/// Номера строк проверочного текста в сообщениях («Строка 12», «строка 12») -> номера строк исходного файла.
общий функ переписать_строки(текст: стр, соответствие: {цел: цел}) -> стр {
    пусть с = текст.символы()
    перем итог: [стр] = []
    перем н = 0
    пока н < с.длина {
        если (с[н] == "С" или с[н] == "с") и кусок(с, н + 1, мин_(н + 7, с.длина)) == "трока " {
            перем к = н + 7
            пока к < с.длина и лексер.цифра(с[к]) { к += 1 }
            если к > н + 7 {
                пусть номер = разобрать_цел(кусок(с, н + 7, к)) иначе -1
                если соответствие.содержит(номер) {
                    итог.добавить(с[н] + "трока " + стр(соответствие[номер]))
                } иначе {
                    итог.добавить(кусок(с, н, к))
                }
                н = к
                продолжить
            }
        }
        итог.добавить(с[н])
        н += 1
    }
    вернуть итог.соединить("")
}

функ мин_(а: цел, б: цел) -> цел {
    если а < б { вернуть а }
    вернуть б
}

/// Общие объявления без описания: строки «строка N: подпись».
общий функ без_описания(модуль: Модуль) -> [стр] {
    перем итог: [стр] = []
    для о в модуль.описания {
        если о.открытое и о.текст == "" { итог.добавить("строка " + стр(о.строка) + ": " + о.подпись) }
    }
    вернуть итог
}

// ---------- команда ----------

/// Есть ли такая папка (а не файл).
функ это_папка(путь: стр) -> лог {
    если путь == "." или путь == ".." или путь.оканчивается("/") или путь.оканчивается("\\") {
        вернуть существует(путь)
    }
    пусть с = путь.символы()
    перем конец = -1
    для н в 0..с.длина - 1 {
        если с[н] == "/" или с[н] == "\\" { конец = н }
    }
    перем родитель = "."
    если конец == 0 { родитель = кусок(с, 0, 1) }
    если конец > 0 { родитель = кусок(с, 0, конец) }
    пусть имя = кусок(с, конец + 1, с.длина)
    если не существует(путь) или не существует(родитель) { вернуть ложь }
    вернуть список_файлов(родитель).содержит(имя + "/")
}

/// Файлы .dan из перечисленных файлов и папок (без целей - текущая папка).
общий функ файлы_целей(цели_: [стр], разделитель: стр) -> [стр] {
    перем цели = цели_
    если цели.длина == 0 { цели = ["."] }
    перем файлы: [стр] = []
    для цель в цели {
        если это_папка(цель) {
            для имя_ в список_файлов(цель) {
                если имя_.оканчивается(".dan") { файлы.добавить(в_папке(цель, имя_, разделитель)) }
            }
        } иначе {
            файлы.добавить(цель)
        }
    }
    вернуть файлы
}

/// «дан документация [файл|папка ...] [--в=папка]»: страницы HTML; сообщения - как у dan.py.
общий функ команда(аргументы: [стр], редакции: [стр], версия: стр, разделитель: стр) -> цел {
    перем папка = "документация"
    перем цели: [стр] = []
    для а в аргументы {
        если а.начинается("--в=") {
            пусть с = а.символы()
            папка = кусок(с, 4, с.длина)
        } иначе если а.начинается("--") {
            вывод("Неизвестный параметр: " + а)
            вернуть 2
        } иначе {
            цели.добавить(а)
        }
    }
    перем модули: [Модуль] = []
    перем плохо = 0
    для путь в файлы_целей(цели, разделитель) {
        если не существует(путь) {
            вывод("Не удалось открыть файл «" + путь + "»: файл не найден")
            плохо += 1
            продолжить
        }
        если пусть м = извлечь(прочитать(путь), путь, редакции, версия) {
            модули.добавить(м)
        } иначе ошибка о {
            вывод(путь + ": " + о)
            плохо += 1
        }
    }
    если модули.длина == 0 {
        вывод("Файлов программ не найдено")
        вернуть 1
    }
    пусть файлы = создать(модули, папка, разделитель)
    вывод("Готово: " + файлы[0] + " (страниц: " + стр(файлы.длина) + ")")
    если плохо > 0 { вернуть 1 }
    вернуть 0
}
