/// Программа сверки: объясняет каждую строку файлов объяснением на Дане.
///
///     python dan.py запустить сам/объяснения.dan программа.dan итог.txt [другая.dan итог2.txt ...]
///
/// Для каждой пары файлов во второй записываются объяснения всех строк первого,
/// разделённые строкой «=====», или «ОШИБКА » с сообщением.

подключить "объяснение"
подключить "модули"
подключить "среда"

пусть папка = переменная_среды("DAN_HOME") иначе "."
перем разделитель = "/"
если (переменная_среды("OS") иначе "") == "Windows_NT" { разделитель = "\\" }
перем настройки = модули.Настройки(папка + разделитель + "библиотека", разделитель)
перем редакции: [стр] = []
для р в среда.редакции() { редакции.добавить(р[0]) }
настройки.редакции = редакции
настройки.версия = среда.версия()
пусть файлы = аргументы()
перем н = 0
пока н + 1 < файлы.длина {
    пусть текст = прочитать(файлы[н])
    перем части: [стр] = []
    для номер в 1..текст.разбить("\n").длина + 1 {
        если пусть о = объяснение.объяснить(текст, файлы[н], номер, настройки) {
            части.добавить(о)
        } иначе ошибка о {
            части.добавить("ОШИБКА " + о)
        }
    }
    записать(файлы[н + 1], части.соединить("\n=====\n"))
    н += 2
}
