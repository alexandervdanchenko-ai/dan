/// Типы в записи строкой: свойства и совместимость (как в proverka.py), разбор записи типа в
/// дерево, подстановка параметров типа и сопоставление (как obobshchenie.py).
///
/// Проверка хранит типы строками: «цел», «[стр]», «{стр: цел}», «Т?», «Т!»,
/// «функ(цел) -> цел», «Пара<цел, стр>».

подключить "лексер"

// ---------- особые типы ----------

общий функ НЕИЗВ() -> стр { вернуть "<неизвестный>" }
общий функ ОТЛОЖЕННАЯ() -> стр { вернуть "<функция>" }

/// Встроенные типы в порядке, в котором их называют сообщения.
общий функ встроенные_типы() -> [стр] {
    вернуть ["цел", "дроб", "рац", "стр", "лог", "мн", "байты", "длинное", "компл", "дата"]
}

/// Числа в порядке «расширения»: цел -> рац -> дроб.
общий функ числа() -> [стр] { вернуть ["цел", "рац", "дроб"] }

общий функ ключи_словаря() -> [стр] { вернуть ["цел", "стр", "лог", "рац", "дата"] }

// ---------- строки ----------

/// Часть строки с номерами от «от» до «до» (не включая «до»), как текст[от:до] в Python.
общий функ срез(текст: стр, от: цел, до: цел) -> стр {
    перем конец = до
    если конец > текст.длина { конец = текст.длина }
    если от >= конец { вернуть "" }
    вернуть текст[от..конец - 1]
}

/// Номер первого вхождения части или -1.
общий функ позиция(текст: стр, часть: стр) -> цел {
    вернуть текст.найти(часть)
}

// ---------- свойства типов ----------

общий функ это_список(т: стр) -> лог {
    вернуть т.начинается("[") и т.оканчивается("]") и т != "[]"
}

общий функ элемент(т: стр) -> стр {
    вернуть срез(т, 1, т.длина - 1)
}

общий функ это_словарь(т: стр) -> лог {
    вернуть т.начинается("{") и т.оканчивается("}") и т != "{}"
}

/// Тип ключей: для «{стр: [цел]}» это «стр» (ключи - простые типы без двоеточий).
общий функ ключ_словаря(т: стр) -> стр {
    вернуть срез(т, 1, позиция(т, ": "))
}

общий функ значение_словаря(т: стр) -> стр {
    вернуть срез(т, позиция(т, ": ") + 2, т.длина - 1)
}

общий функ словарь(ключ: стр, значение: стр) -> стр {
    вернуть "{" + ключ + ": " + значение + "}"
}

общий функ это_функция(т: стр) -> лог {
    вернуть т.начинается("функ(")
}

общий функ это_необяз(т: стр) -> лог {
    вернуть т.оканчивается("?") и не это_функция(т)
}

общий функ это_результат(т: стр) -> лог {
    вернуть т.оканчивается("!") и не это_функция(т)
}

общий функ это_особое(т: стр) -> лог {
    вернуть это_необяз(т) или это_результат(т)
}

общий функ основа(т: стр) -> стр {
    вернуть срез(т, 0, т.длина - 1)
}

общий функ это_задача(т: стр) -> лог {
    вернуть т.начинается("задача<")
}

общий функ это_канал(т: стр) -> лог {
    вернуть т.начинается("канал<") и т != "канал<>"
}

общий функ элемент_канала(т: стр) -> стр {
    вернуть срез(т, 6, т.длина - 1)
}

/// Номер числового типа в порядке расширения или -1.
общий функ номер_числа(т: стр) -> цел {
    вернуть числа().найти(т)
}

/// Самый «широкий» из числовых типов.
общий функ общий_числовой(типы: [стр]) -> стр {
    перем итог = типы[0]
    для т в типы {
        если номер_числа(т) > номер_числа(итог) { итог = т }
    }
    вернуть итог
}

/// Делит текст по запятым вне круглых, квадратных и фигурных скобок (как в proverka.py).
общий функ части_верхнего_уровня(текст: стр) -> [стр] {
    пусть с = текст.символы()
    перем итог: [стр] = []
    перем глубина = 0
    перем начало = 0
    для н в 0..с.длина - 1 {
        пусть з = с[н]
        если з == "(" или з == "[" или з == "{" {
            глубина += 1
        } иначе если з == ")" или з == "]" или з == "}" {
            глубина -= 1
        } иначе если з == "," и глубина == 0 {
            итог.добавить(срез(текст, начало, н).обрезать())
            начало = н + 1
        }
    }
    если текст.обрезать() != "" { итог.добавить(срез(текст, начало, с.длина).обрезать()) }
    вернуть итог
}

/// Типы параметров и результат типа функции «функ(цел, стр) -> лог»; без «->» результат «пусто».
общий тип ТипФункции {
    параметры: [стр]
    результат: стр
}

общий функ разобрать_тип_функции(т: стр) -> ТипФункции {
    пусть с = т.символы()
    перем глубина = 0
    для н в 0..с.длина - 1 {
        если с[н] == "(" {
            глубина += 1
        } иначе если с[н] == ")" {
            глубина -= 1
            если глубина == 0 {
                пусть параметры = части_верхнего_уровня(срез(т, 5, н))
                пусть остаток = срез(т, н + 1, с.длина).обрезать()
                перем результат = "пусто"
                если остаток.начинается("->") { результат = срез(остаток, 2, остаток.длина).обрезать() }
                вернуть ТипФункции(параметры, результат)
            }
        }
    }
    вернуть ТипФункции([], "пусто")
}

общий функ тип_функции(параметры: [стр], результат: стр) -> стр {
    пусть т = "функ(" + параметры.соединить(", ") + ")"
    если результат == "пусто" { вернуть т }
    вернуть т + " -> " + результат
}

/// Список чисел расширяется так же, как число: [цел] -> [рац] -> [дроб], [[цел]] -> [[рац]].
общий функ расширяемый_список(откуда: стр, куда: стр) -> лог {
    если не (это_список(откуда) и это_список(куда)) { вернуть ложь }
    пусть а = элемент(откуда)
    пусть б = элемент(куда)
    если номер_числа(а) >= 0 и номер_числа(б) >= 0 { вернуть номер_числа(а) < номер_числа(б) }
    вернуть расширяемый_список(а, б)
}

/// Можно ли значение типа «откуда» использовать там, где ждут «куда».
общий функ совместим(откуда: стр, куда: стр) -> лог {
    если откуда == НЕИЗВ() или куда == НЕИЗВ() { вернуть истина }
    если откуда.оканчивается("<>") и куда.начинается(основа(откуда)) и куда.оканчивается(">") {
        вернуть истина      // «Нет» обобщённого перечисления подходит к Ответ<цел>
    }
    если откуда == "[]" { вернуть это_список(куда) или (это_необяз(куда) и это_список(основа(куда))) }
    если откуда == "{}" { вернуть это_словарь(куда) или (это_необяз(куда) и это_словарь(основа(куда))) }
    если это_результат(куда) и откуда != куда { вернуть откуда == "ошибка" или совместим(откуда, основа(куда)) }
    если это_необяз(куда) и откуда != куда { вернуть откуда == "ничего" или совместим(откуда, основа(куда)) }
    если номер_числа(откуда) >= 0 и номер_числа(куда) >= 0 { вернуть номер_числа(откуда) <= номер_числа(куда) }
    если куда == "длинное" { вернуть откуда == "цел" или откуда == "длинное" }
    если куда == "компл" { вернуть номер_числа(откуда) >= 0 или откуда == "компл" }
    если расширяемый_список(откуда, куда) { вернуть истина }
    если куда == "мн" { вернуть откуда == "цел" или откуда == "рац" или откуда == "мн" }
    вернуть откуда == куда
}

// ---------- типы как деревья (obobshchenie.py) ----------

/// Дерево записи типа: «имя» (имя, дети - аргументы), «список», «словарь» (ключ и значение),
/// «необяз», «результат», «функ» (дети - параметры, последний - результат).
общий тип Дерево {
    вид: стр
    имя: стр = ""
    дети: [Дерево] = []
}

функ открывающая(з: стр) -> лог {
    вернуть з == "(" или з == "[" или з == "{" или з == "<"
}

/// Номер закрывающей скобки для открывающей в позиции «начало».
функ закрывающая(с: [стр], начало: цел) -> цел {
    перем глубина = 0
    для н в начало..с.длина - 1 {
        пусть з = с[н]
        если открывающая(з) {
            глубина += 1
        } иначе если з == ")" или з == "]" или з == "}" или (з == ">" и н > 0 и с[н - 1] != "-") {
            глубина -= 1
            если глубина == 0 { вернуть н }
        }
    }
    вернуть с.длина - 1
}

/// Делит текст по запятым вне всех скобок (в том числе угловых).
общий функ части(текст: стр) -> [стр] {
    пусть с = текст.символы()
    перем итог: [стр] = []
    перем глубина = 0
    перем начало = 0
    для н в 0..с.длина - 1 {
        пусть з = с[н]
        если открывающая(з) {
            глубина += 1
        } иначе если з == ")" или з == "]" или з == "}" или (з == ">" и н > 0 и с[н - 1] != "-") {
            глубина -= 1
        } иначе если з == "," и глубина == 0 {
            итог.добавить(срез(текст, начало, н).обрезать())
            начало = н + 1
        }
    }
    если текст.обрезать() != "" { итог.добавить(срез(текст, начало, с.длина).обрезать()) }
    вернуть итог
}

общий функ разобрать(исходный: стр) -> Дерево {
    пусть т = исходный.обрезать()
    пусть с = т.символы()
    если т.начинается("функ(") {
        пусть конец = закрывающая(с, 4)
        перем дети: [Дерево] = []
        для п в части(срез(т, 5, конец)) { дети.добавить(разобрать(п)) }
        пусть остаток = срез(т, конец + 1, с.длина).обрезать()
        если остаток.начинается("->") {
            дети.добавить(разобрать(срез(остаток, 2, остаток.длина)))
        } иначе {
            дети.добавить(Дерево("имя", "пусто"))
        }
        вернуть Дерево("функ", "", дети)
    }
    если с.длина > 1 и т.оканчивается("?") { вернуть Дерево("необяз", "", [разобрать(срез(т, 0, с.длина - 1))]) }
    если с.длина > 1 и т.оканчивается("!") { вернуть Дерево("результат", "", [разобрать(срез(т, 0, с.длина - 1))]) }
    если т.начинается("[") и т.оканчивается("]") и т != "[]" {
        вернуть Дерево("список", "", [разобрать(срез(т, 1, с.длина - 1))])
    }
    если т.начинается("{") и т.оканчивается("}") и т != "{}" {
        пусть внутри = срез(т, 1, с.длина - 1)
        пусть к = позиция(внутри, ": ")
        вернуть Дерево("словарь", "", [разобрать(срез(внутри, 0, к)), разобрать(срез(внутри, к + 2, внутри.длина))])
    }
    если т.оканчивается(">") и т.содержит("<") и не т.начинается("<") {
        пусть н = позиция(т, "<")
        перем аргументы: [Дерево] = []
        для а в части(срез(т, н + 1, с.длина - 1)) { аргументы.добавить(разобрать(а)) }
        вернуть Дерево("имя", срез(т, 0, н), аргументы)
    }
    вернуть Дерево("имя", т)
}

общий функ собрать(д: Дерево) -> стр {
    выбор д.вид {
        "имя" {
            если д.дети.длина == 0 { вернуть д.имя }
            перем аргументы: [стр] = []
            для а в д.дети { аргументы.добавить(собрать(а)) }
            вернуть д.имя + "<" + аргументы.соединить(", ") + ">"
        }
        "список" { вернуть "[" + собрать(д.дети[0]) + "]" }
        "словарь" { вернуть "{" + собрать(д.дети[0]) + ": " + собрать(д.дети[1]) + "}" }
        "необяз" { вернуть собрать(д.дети[0]) + "?" }
        "результат" { вернуть собрать(д.дети[0]) + "!" }
        иначе {
            перем параметры: [стр] = []
            для н в 0..д.дети.длина - 2 { параметры.добавить(собрать(д.дети[н])) }
            пусть т = "функ(" + параметры.соединить(", ") + ")"
            пусть результат = собрать(д.дети[д.дети.длина - 1])
            если результат == "пусто" { вернуть т }
            вернуть т + " -> " + результат
        }
    }
}

функ подставить_в_дерево(д: Дерево, связи: {стр: стр}) -> Дерево {
    если д.вид == "имя" и д.дети.длина == 0 и связи.содержит(д.имя) { вернуть разобрать(связи[д.имя]) }
    перем дети: [Дерево] = []
    для ребёнок в д.дети { дети.добавить(подставить_в_дерево(ребёнок, связи)) }
    вернуть Дерево(д.вид, д.имя, дети)
}

/// Заменяет параметры типа их значениями: подставить("[Т]", {"Т": "цел"}) = "[цел]".
общий функ подставить(т: стр, связи: {стр: стр}) -> стр {
    если связи.длина == 0 { вернуть т }
    вернуть собрать(подставить_в_дерево(разобрать(т), связи))
}

/// Все имена в записи типа (с точками внутри, без «функ»), без повторов.
общий функ имена_в_типе(т: стр) -> [стр] {
    пусть с = т.символы()
    перем итог: [стр] = []
    перем н = 0
    пока н < с.длина {
        если лексер.буква(с[н]) или с[н] == "_" {
            перем слово = ""
            пока н < с.длина и (лексер.буква(с[н]) или лексер.цифра(с[н]) или с[н] == "_" или с[н] == ".") {
                слово += с[н]
                н += 1
            }
            если слово != "функ" и не итог.содержит(слово) { итог.добавить(слово) }
        } иначе {
            н += 1
        }
    }
    вернуть итог
}

общий функ содержит_имена(т: стр, имена: [стр]) -> лог {
    для имя в имена_в_типе(т) {
        если имена.содержит(имя) { вернуть истина }
    }
    вернуть ложь
}

/// Значение параметра типа по нескольким аргументам: цел и дроб дают дроб; "" - несовместимы.
общий функ объединить(старое: стр, новое: стр) -> стр {
    если старое == новое или совместим(новое, старое) { вернуть старое }
    если совместим(старое, новое) { вернуть новое }
    вернуть ""
}

/// Итог сопоставления: найденные значения параметров и успех (ложь - только при противоречии).
общий тип Связи {
    успех: лог
    связи: {стр: стр}
}

/// Находит значения параметров, при которых тип подходит к шаблону (как obobshchenie.сопоставить).
общий функ сопоставить(шаблон: стр, т: стр, параметры: [стр], связи: {стр: стр}) -> Связи {
    вернуть сопоставить_дерево(разобрать(шаблон), т, параметры, связи)
}

функ сопоставить_дерево(ш: Дерево, т: стр, параметры: [стр], исходные: {стр: стр}) -> Связи {
    перем связи = исходные
    если ["[]", "{}", "ничего", "ошибка", "<неизвестный>", "<функция>"].содержит(т) или т.оканчивается("<>") {
        вернуть Связи(истина, связи)       // о параметрах ничего не известно; решит обычная проверка
    }
    если ш.вид == "имя" и параметры.содержит(ш.имя) и ш.дети.длина == 0 {
        если связи.содержит(ш.имя) {
            пусть новое = объединить(связи[ш.имя], т)
            если новое == "" { вернуть Связи(ложь, связи) }
            связи[ш.имя] = новое
        } иначе {
            связи[ш.имя] = т
        }
        вернуть Связи(истина, связи)
    }
    пусть д = разобрать(т)
    если (ш.вид == "необяз" и д.вид != "необяз") или (ш.вид == "результат" и д.вид != "результат") {
        вернуть сопоставить_дерево(ш.дети[0], т, параметры, связи)
    }
    если д.вид != ш.вид { вернуть Связи(истина, связи) }
    если ш.вид == "имя" и (ш.имя != д.имя или ш.дети.длина != д.дети.длина) { вернуть Связи(истина, связи) }
    если ш.вид == "функ" и ш.дети.длина != д.дети.длина { вернуть Связи(истина, связи) }
    // остальные виды: дети по порядку (у функции последний ребёнок - результат)
    для н в 0..ш.дети.длина - 1 {
        пусть р = сопоставить_дерево(ш.дети[н], собрать(д.дети[н]), параметры, связи)
        связи = р.связи
        если не р.успех { вернуть Связи(ложь, связи) }
    }
    вернуть Связи(истина, связи)
}
