/// Сервер Model Context Protocol (MCP) для программ-агентов: команда «дан mcp».
///
/// Агент (Claude Code, Codex и любой другой клиент MCP) запускает «дан mcp» и обменивается с ним
/// сообщениями JSON-RPC 2.0 через стандартный ввод и вывод: одно сообщение - одна строка, без
/// заголовков. Сервер даёт инструменты:
/// - proverit - ошибки программы, как у «дан проверить --json» (коды, места, готовые исправления);
/// - ispravit - применить готовые исправления и вернуть исправленный текст;
/// - zapustit - собрать и выполнить программу с ограничением времени (и памяти в Linux и macOS);
/// - testirovat - выполнить блоки «тест» программы;
/// - formatirovat - привести текст к единому виду;
/// - spravka - описание встроенной функции, ключевого слова, модуля или раздела, целиком llms-full.txt.
/// Программа собирается и выполняется во временной папке, которая удаляется после выполнения.
/// Выполнение - обычная программа на этом компьютере: ей доступны сеть и файлы пользователя.

подключить "среда"
подключить "машинный"
подключить "формат"
подключить "подсказки"
подключить "песочница"
подключить "json"

/// Что серверу MCP нужно от компилятора (это знает дан.dan).
общий тип Компилятор {
    /// ошибки (или, если их нет, предупреждения) программы: путь и текст -> замечания
    замечания: функ(стр, стр) -> [машинный.Замечание]
    /// готовые исправления: путь и текст -> [исправленный текст, описания сделанных правок...]
    исправить: функ(стр, стр) -> [стр]
    /// собрать: путь, текст, режим ("" или "тесты"), основа имени исполняемого файла ->
    /// путь к исполняемому файлу или сообщение об ошибке, как у «дан запустить»
    собрать: функ(стр, стр, стр, стр) -> стр!
    /// разделитель папок
    р: стр
    /// папка Дана (в ней llms-full.txt)
    папка: стр
}

/// Версии протокола, которые понимает сервер (первая - новейшая).
функ версии_протокола() -> [стр] { вернуть ["2025-06-18", "2025-03-26", "2024-11-05"] }

функ время_по_умолчанию() -> цел { вернуть 10 }

функ наибольшее_время() -> цел { вернуть 300 }

функ память_по_умолчанию() -> цел { вернуть 1024 }

функ windows(к: Компилятор) -> лог { вернуть к.р == "\\" }

функ в_кавычках(т: стр) -> стр { вернуть "\"" + т + "\"" }

// ---------- чтение и запись сообщений ----------

тип Поток {
    данные: байты = байты("")
    поз: цел = 0
    конец: лог = ложь
}

тип Строка {
    поток: Поток
    /// ложь - ввод кончился
    есть: лог
    текст: стр
}

/// Следующая строка ввода (без «\n» и «\r» в конце).
функ прочитать_строку(п_: Поток) -> Строка {
    перем п = п_
    перем к = п.поз
    пока истина {
        пока к < п.данные.длина {
            если п.данные[к] == 10 {
                перем текст = ""
                если к > п.поз { текст = песочница.текст_utf8(п.данные[п.поз..к - 1]) }
                п.поз = к + 1
                если текст.оканчивается("\r") { текст = текст[0..текст.длина - 2] }
                вернуть Строка(п, истина, текст)
            }
            к += 1
        }
        если п.конец {
            // последняя строка без «\n»
            если п.поз < п.данные.длина {
                пусть текст = песочница.текст_utf8(п.данные[п.поз..п.данные.длина - 1])
                п.поз = п.данные.длина
                вернуть Строка(п, истина, текст)
            }
            вернуть Строка(п, ложь, "")
        }
        пусть часть = ввод_байтов(65536)
        если часть.длина == 0 {
            п.конец = истина
        } иначе {
            если п.поз >= п.данные.длина {
                п.данные = часть
            } иначе {
                п.данные = п.данные[п.поз..п.данные.длина - 1] + часть
            }
            к = к - п.поз
            п.поз = 0
        }
    }
    вернуть Строка(п, ложь, "")
}

функ отправить(текст: стр) { вывести_байты(байты(текст + "\n")) }

функ ответить(номер: стр, результат: стр) {
    отправить("{\"jsonrpc\":\"2.0\",\"id\":" + номер + ",\"result\":" + результат + "}")
}

функ ответить_ошибкой(номер: стр, код: цел, текст: стр) {
    отправить("{\"jsonrpc\":\"2.0\",\"id\":" + номер + ",\"error\":{\"code\":" + стр(код) + ",\"message\":"
        + строка_json(текст) + "}}")
}

функ это_объект(з: json.Значение) -> лог {
    выбор з {
        json.Объект(п) { вернуть истина }
        иначе { вернуть ложь }
    }
}

// ---------- описание сервера и инструментов ----------

функ возможности(запрошенная: стр) -> стр {
    перем версия = версии_протокола()[0]
    если версии_протокола().содержит(запрошенная) { версия = запрошенная }
    вернуть ("{\"protocolVersion\":" + строка_json(версия) + ",\"capabilities\":{\"tools\":{\"listChanged\":false}},"
        + "\"serverInfo\":{\"name\":\"dan\",\"title\":\"Дан\",\"version\":" + строка_json(среда.версия()) + "},"
        + "\"instructions\":" + строка_json(указания()) + "}")
}

функ указания() -> стр {
    вернуть ("Сервер языка программирования Дан " + среда.версия() + " (русские ключевые слова, программа переводится "
        + "в C). Перед тем как писать программу, прочитайте правила языка: инструмент spravka с vsyo=true даёт "
        + "llms-full.txt этой версии. После каждой правки вызывайте proverit; готовые исправления применяет ispravit; "
        + "zapustit собирает и выполняет программу с ограничением времени, testirovat выполняет блоки «тест», "
        + "formatirovat приводит текст к единому виду. Программу можно передать текстом (tekst) или путём к файлу (put).")
}

функ свойство(имя: стр, тип_: стр, описание: стр) -> стр {
    вернуть строка_json(имя) + ":{\"type\":" + строка_json(тип_) + ",\"description\":" + строка_json(описание) + "}"
}

функ свойства_программы() -> [стр] {
    вернуть [свойство("tekst", "string", "Текст программы на Дане. Если не задан, программа читается из файла put."),
        свойство("put", "string", "Путь к файлу .dan (от папки, в которой запущен сервер). С tekst - имя файла для "
            + "сообщений и папка, от которой ищутся подключённые файлы.")]
}

функ ограничения() -> [стр] {
    вернуть [свойство("vremya", "integer", "Сколько секунд может выполняться программа (по умолчанию "
            + стр(время_по_умолчанию()) + ", не больше " + стр(наибольшее_время()) + "); затем она останавливается."),
        свойство("pamyat_mb", "integer", "Предел памяти программы в мегабайтах (по умолчанию "
            + стр(память_по_умолчанию()) + "; действует в Linux и macOS, 0 - без предела).")]
}

функ инструмент(имя: стр, описание: стр, свойства: [стр], только_чтение: лог) -> стр {
    перем пометки = "{\"readOnlyHint\":true,\"openWorldHint\":false}"
    если не только_чтение { пометки = "{\"readOnlyHint\":false,\"destructiveHint\":false,\"openWorldHint\":true}" }
    вернуть ("{\"name\":" + строка_json(имя) + ",\"description\":" + строка_json(описание)
        + ",\"inputSchema\":{\"type\":\"object\",\"properties\":{" + свойства.соединить(",") + "}}"
        + ",\"annotations\":" + пометки + "}")
}

/// Имена инструментов в порядке списка.
общий функ имена_инструментов() -> [стр] {
    вернуть ["proverit", "ispravit", "zapustit", "testirovat", "formatirovat", "spravka"]
}

функ список_инструментов() -> стр {
    перем запуск = свойства_программы()
    запуск.добавить(свойство("vvod", "string", "Стандартный ввод программы: строки для ввод() через «\\n»."))
    запуск.добавить(строка_json("argumenty") + ":{\"type\":\"array\",\"items\":{\"type\":\"string\"},"
        + "\"description\":" + строка_json("Значения для программы (их даёт аргументы()).") + "}")
    для о в ограничения() { запуск.добавить(о) }
    перем тесты = свойства_программы()
    для о в ограничения() { тесты.добавить(о) }
    пусть инструменты = [
        инструмент("proverit", "Проверить программу на Дане, не собирая её: все ошибки сразу (или, если ошибок нет, "
            + "предупреждения) в записи JSON, как у «дан проверить --json»: вид, постоянный код Д…, файл, строка, "
            + "позиция и длина места, текст и, если есть, готовое исправление.", свойства_программы(), истина),
        инструмент("ispravit", "Применить к программе готовые исправления из сообщений об ошибках (опечатки в именах, "
            + "привычки Python), как «дан исправить», и вернуть исправленный текст, список правок и оставшиеся "
            + "ошибки. Файл не изменяется.", свойства_программы(), истина),
        инструмент("zapustit", "Собрать и выполнить программу во временной папке (она удаляется после выполнения) "
            + "с ограничением времени и памяти: вывод, поток ошибок, код завершения. Программа выполняется на этом "
            + "компьютере как обычная: ей доступны сеть и файлы.", запуск, ложь),
        инструмент("testirovat", "Выполнить блоки «тест \"...\" { }» программы, как «дан тестировать»: отчёт о "
            + "пройденных и проваленных тестах и код завершения (0 - все тесты прошли).", тесты, ложь),
        инструмент("formatirovat", "Привести текст программы к единому виду, как «дан формат»: вернуть новый текст. "
            + "Файл не изменяется.", свойства_программы(), истина),
        инструмент("spravka", "Справка по Дану: описание встроенной функции, ключевого слова, модуля библиотеки "
            + "(json, csv, http, ...) или раздела llms-full.txt по имени; без имени - список разделов; vsyo=true - "
            + "весь llms-full.txt этой версии Дана (правила языка на одной странице).",
            [свойство("imya", "string", "Имя функции, ключевого слова, модуля или раздела, например «частное», «если», "
                + "«json», «Python - Дан»."), свойство("vsyo", "boolean", "Вернуть весь llms-full.txt.")], истина)]
    вернуть "{\"tools\":[" + инструменты.соединить(",") + "]}"
}

// ---------- итог инструмента ----------

/// Итог вызова инструмента: текст (и, если «данные» не пусты, те же данные как structuredContent).
функ итог(текст: стр, данные: стр, сбой: лог) -> стр {
    перем ответ = "{\"content\":[{\"type\":\"text\",\"text\":" + строка_json(текст) + "}]"
    если данные != "" {
        // сообщение - одна строка: данные записываются без переводов строк
        если пусть з = json.разобрать(данные) { ответ += ",\"structuredContent\":" + json.записать(з) }
    }
    если сбой { ответ += ",\"isError\":true" } иначе { ответ += ",\"isError\":false" }
    вернуть ответ + "}"
}

функ поле(имя: стр, значение: стр) -> стр { вернуть строка_json(имя) + ":" + строка_json(значение) }

/// Программа для инструмента: путь (для сообщений и подключений) и текст; «ошибка» - причина, по которой её нет.
тип Программа {
    путь: стр = "программа.dan"
    текст: стр = ""
    из_текста: лог = ложь
    ошибка: стр = ""
}

функ программа(п: json.Значение) -> Программа {
    перем итог_ = Программа()
    пусть путь = п.поле("put").как_стр() иначе ""
    если путь != "" { итог_.путь = путь }
    если пусть т = п.поле("tekst").как_стр() {
        итог_.текст = т
        итог_.из_текста = истина
        вернуть итог_
    }
    если путь == "" {
        итог_.ошибка = "нужен текст программы (tekst) или путь к файлу (put)"
        вернуть итог_
    }
    если не существует(путь) или это_папка(путь) {
        итог_.ошибка = "не удалось открыть файл «" + путь + "»: файл не найден"
        вернуть итог_
    }
    итог_.текст = прочитать(путь)
    вернуть итог_
}

функ проверить(п: Программа, к: Компилятор) -> стр {
    пусть найдено = к.замечания(п.путь, п.текст)
    пусть запись = машинный.запись_json(п.путь, найдено)
    вернуть итог(запись, запись, ложь)
}

функ исправить(п: Программа, к: Компилятор) -> стр {
    пусть сделано = к.исправить(п.путь, п.текст)
    пусть текст = сделано[0]
    перем правки: [стр] = []
    для н в 1..сделано.длина - 1 { правки.добавить(строка_json(сделано[н])) }
    пусть осталось = машинный.запись_json(п.путь, к.замечания(п.путь, текст))
    перем пояснение = "Исправлено мест: " + стр(сделано.длина - 1)
    если сделано.длина == 1 { пояснение = "Готовых исправлений нет" }
    пусть данные = ("{" + поле("текст", текст) + ",\"правки\":[" + правки.соединить(",") + "],\"осталось\":" + осталось
        + "}")
    вернуть итог(пояснение + ".\n" + данные, данные, ложь)
}

функ форматировать(п: Программа) -> стр {
    если пусть т = формат.отформатировать(п.текст) {
        вернуть итог(т, "", ложь)
    } иначе ошибка о {
        вернуть итог("Текст не приведён к единому виду: " + о, "", истина)
    }
}

функ число_в_пределах(з: json.Значение, по_умолчанию: цел, от: цел, до: цел) -> цел {
    перем ч = з.как_цел() иначе по_умолчанию
    если ч < от { ч = от }
    если ч > до { ч = до }
    вернуть ч
}

/// Собрать и выполнить (режим "" - программа, "тесты" - её тесты) во временной папке.
функ выполнить(п: Программа, параметры: json.Значение, режим: стр, к: Компилятор) -> стр {
    пусть секунд = число_в_пределах(параметры.поле("vremya"), время_по_умолчанию(), 1, наибольшее_время())
    пусть память = число_в_пределах(параметры.поле("pamyat_mb"), память_по_умолчанию(), 0, 1048576)
    пусть папка = создать_временную_папку()
    перем путь = п.путь
    если п.из_текста и не существует(путь) {
        // текст без своего файла: файл во временной папке (подключённые файлы ищутся рядом с ним)
        путь = папка + к.р + "программа.dan"
        записать(путь, п.текст)
    }
    перем основа = папка + к.р + "программа"
    если режим == "тесты" { основа += "_тесты" }
    перем исполняемый = ""
    пусть начало_сборки = метка_времени()
    если пусть г = к.собрать(путь, п.текст, режим, основа) {
        исполняемый = г
    } иначе ошибка о_ {
        убрать_папку(папка, к)
        перем о = о_
        // у текста без файла в сообщениях - короткое имя, а не путь во временной папке
        если путь != п.путь { о = о.заменить(путь, п.путь) }
        пусть данные = "{" + [поле("состояние", "в программе ошибка"), поле("ошибки", о)].соединить(",") + "}"
        вернуть итог("Программа не собрана:\n" + о, данные, истина)
    }
    пусть собрана = метка_времени() - начало_сборки
    пусть файл_ввода = папка + к.р + "ввод.txt"
    пусть файл_вывода = папка + к.р + "вывод.txt"
    пусть файл_ошибок = папка + к.р + "ошибки.txt"
    записать(файл_ввода, параметры.поле("vvod").как_стр() иначе "")
    перем значения = ""
    для а в параметры.поле("argumenty").элементы() {
        если пусть с = а.как_стр() { значения += " " + в_кавычках(с) }
    }
    перем строка_ = ""
    пусть перенаправление = (" <" + в_кавычках(файл_ввода) + " >" + в_кавычках(файл_вывода) + " 2>"
        + в_кавычках(файл_ошибок))
    если windows(к) {
        строка_ = "\"cd /d " + в_кавычках(папка) + " && " + в_кавычках(исполняемый) + значения + перенаправление + "\""
    } иначе {
        перем предел = ""
        если память > 0 { предел = "ulimit -v " + стр(память * 1024) + " 2>/dev/null; " }
        строка_ = ("cd " + в_кавычках(папка) + " && { " + предел + в_кавычках(исполняемый) + значения + перенаправление
            + "; }")
    }
    пусть начало = метка_времени()
    пусть код = выполнить_команду(строка_, дроб(секунд))
    пусть прошло = метка_времени() - начало
    пусть вывод_ = песочница.прочитать_вывод(файл_вывода)
    пусть ошибки = песочница.прочитать_вывод(файл_ошибок)
    убрать_папку(папка, к)
    перем текст_вывода = вывод_[0]
    если вывод_[1] != "" { текст_вывода += "\n... вывод длиннее мегабайта и показан не полностью\n" }
    перем состояние = ""
    если код == -1 {
        состояние = "программа остановлена: она работала дольше " + стр(секунд) + " с"
    } иначе если код != 0 {
        состояние = "программа завершилась с кодом " + стр(код) + " (" + песочница.секунды(прошло) + " с)"
    } иначе {
        состояние = ("готово: сборка " + песочница.секунды(собрана) + " с, выполнение " + песочница.секунды(прошло)
            + " с")
    }
    пусть данные = ("{" + [поле("состояние", состояние), поле("вывод", текст_вывода), поле("ошибки", ошибки[0])].соединить(",")
        + ",\"код\":" + стр(код) + "}")
    перем текст = состояние + "\n"
    если текст_вывода != "" { текст += "--- вывод:\n" + текст_вывода }
    если ошибки[0] != "" {
        если не текст.оканчивается("\n") { текст += "\n" }
        текст += "--- поток ошибок:\n" + ошибки[0]
    }
    вернуть итог(текст, данные, код != 0)
}

/// Удаляет временную папку командой системы (как в песочнице).
функ убрать_папку(папка: стр, к: Компилятор) {
    для попытка в 1..10 {
        если не существует(папка) { вернуть }
        если windows(к) {
            выполнить_команду("\"rmdir /s /q " + в_кавычках(папка) + " >NUL 2>&1\"")
        } иначе {
            выполнить_команду("rm -rf '" + папка.заменить("'", "'\\''") + "' >/dev/null 2>&1")
        }
        если существует(папка) { пауза(0.3) }
    }
}

/// Есть ли в тексте блок «тест» (слово в начале строки).
функ есть_тесты(текст: стр) -> лог {
    для строка в текст.разбить("\n") {
        пусть с = строка.обрезать()
        если с.начинается("тест ") или с.начинается("тест\"") { вернуть истина }
    }
    вернуть ложь
}

// ---------- справка ----------

функ адрес_llms() -> стр {
    вернуть "https://raw.githubusercontent.com/alexandervdanchenko-ai/dan/v" + среда.версия() + "/llms-full.txt"
}

функ текст_llms(к: Компилятор) -> стр {
    пусть путь = к.папка + к.р + "llms-full.txt"
    если существует(путь) { вернуть прочитать(путь) }
    вернуть ""
}

функ заголовок(строка: стр) -> стр {
    если строка.начинается("### ") { вернуть строка[4..строка.длина - 1].обрезать() }
    если строка.начинается("## ") { вернуть строка[3..строка.длина - 1].обрезать() }
    вернуть ""
}

функ уровень(строка: стр) -> цел {
    если строка.начинается("### ") { вернуть 3 }
    если строка.начинается("## ") { вернуть 2 }
    если строка.начинается("# ") { вернуть 1 }
    вернуть 0
}

/// Раздел llms-full.txt с заголовком «имя» (без учёта прописных букв) или "".
функ раздел(текст: стр, имя: стр) -> стр {
    пусть строки = текст.разбить("\n")
    пусть искомое = имя.строчные()
    для н в 0..строки.длина - 1 {
        пусть з = заголовок(строки[н])
        если з == "" или з.строчные() != искомое { продолжить }
        пусть свой = уровень(строки[н])
        перем часть = [строки[н]]
        перем к = н + 1
        пока к < строки.длина {
            пусть у = уровень(строки[к])
            если у > 0 и у <= свой { прервать }
            часть.добавить(строки[к])
            к += 1
        }
        вернуть часть.соединить("\n").обрезать()
    }
    вернуть ""
}

функ справка(п: json.Значение, к: Компилятор) -> стр {
    пусть llms = текст_llms(к)
    если п.поле("vsyo").как_лог() иначе ложь {
        если llms == "" {
            вернуть итог("Файла llms-full.txt нет в папке Дана (" + к.папка + "); он есть в сети: " + адрес_llms(), "",
                истина)
        }
        вернуть итог(llms, "", ложь)
    }
    пусть имя = (п.поле("imya").как_стр() иначе "").обрезать()
    если имя == "" {
        перем разделы: [стр] = []
        для строка в llms.разбить("\n") {
            если заголовок(строка) != "" { разделы.добавить("- " + заголовок(строка)) }
        }
        вернуть итог("Разделы llms-full.txt (Дан " + среда.версия() + "): справка по разделу - imya=название, "
            + "весь файл - vsyo=true.\n" + разделы.соединить("\n"), "", ложь)
    }
    перем описание = подсказки.описания_библиотеки().получить(имя, "")
    если описание == "" { описание = подсказки.описания_встроенных().получить(имя, "") }
    если описание == "" { описание = подсказки.описания_ключевых().получить(имя, "") }
    пусть часть = раздел(llms, имя)
    если описание != "" и часть != "" { вернуть итог(описание + "\n\n" + часть, "", ложь) }
    если описание != "" { вернуть итог(описание, "", ложь) }
    если часть != "" { вернуть итог(часть, "", ложь) }
    // похожие имена: содержат запрос
    перем похожие: [стр] = []
    пусть искомое = имя.строчные()
    для список_ в [подсказки.библиотечные(), подсказки.встроенные(), подсказки.ключевые_слова()] {
        для слово в список_ {
            если слово.строчные().содержит(искомое) и не похожие.содержит(слово) и похожие.длина < 20 { похожие.добавить(слово) }
        }
    }
    для строка в llms.разбить("\n") {
        пусть з = заголовок(строка)
        если з != "" и з.строчные().содержит(искомое) и не похожие.содержит(з) и похожие.длина < 20 { похожие.добавить(з) }
    }
    перем текст = "Справки о «" + имя + "» нет"
    если похожие.длина > 0 { текст += "; похожие имена: " + похожие.соединить(", ") }
    вернуть итог(текст + ". Список разделов - spravka без imya.", "", истина)
}

// ---------- главный цикл ----------

функ вызвать(п: json.Значение, к: Компилятор) -> стр {
    пусть имя = п.поле("name").как_стр() иначе ""
    пусть параметры = п.поле("arguments")
    если имя == "spravka" { вернуть справка(параметры, к) }
    пусть программа_ = программа(параметры)
    если программа_.ошибка != "" { вернуть итог(программа_.ошибка, "", истина) }
    выбор имя {
        "proverit" { вернуть проверить(программа_, к) }
        "ispravit" { вернуть исправить(программа_, к) }
        "formatirovat" { вернуть форматировать(программа_) }
        "zapustit" { вернуть выполнить(программа_, параметры, "", к) }
        "testirovat" {
            если не есть_тесты(программа_.текст) {
                вернуть итог("В программе нет тестов; тест пишется так: тест \"что проверяется\" { утвердить(...) }",
                    "", истина)
            }
            вернуть выполнить(программа_, параметры, "тесты", к)
        }
        иначе { }
    }
    вернуть ""
}

/// «дан mcp»: обмен сообщениями с агентом до конца ввода.
общий функ работать(к: Компилятор) -> цел {
    перем поток = Поток()
    пока истина {
        пусть с = прочитать_строку(поток)
        поток = с.поток
        если не с.есть { прервать }
        если с.текст.обрезать() == "" { продолжить }
        перем сообщение = json.Пусто
        если пусть з = json.разобрать(с.текст) {
            сообщение = з
        } иначе ошибка о {
            ответить_ошибкой("null", -32700, "сообщение не разобрано: " + о)
            продолжить
        }
        если не это_объект(сообщение) {
            ответить_ошибкой("null", -32600, "сообщение JSON-RPC - объект с полями jsonrpc, method и id")
            продолжить
        }
        перем номер = ""
        если сообщение.есть_поле("id") { номер = json.записать(сообщение.поле("id")) }
        пусть метод = сообщение.поле("method").как_стр() иначе ""
        если метод == "" {
            // ответ клиента на запрос сервера (сервер запросов не посылает) или неверное сообщение
            если номер != "" и не сообщение.есть_поле("result") и не сообщение.есть_поле("error") {
                ответить_ошибкой(номер, -32600, "нет поля method")
            }
            продолжить
        }
        если номер == "" {
            // уведомления (notifications/initialized, notifications/cancelled и другие) ответа не ждут
            продолжить
        }
        пусть п = сообщение.поле("params")
        выбор метод {
            "initialize" { ответить(номер, возможности(п.поле("protocolVersion").как_стр() иначе "")) }
            "ping" { ответить(номер, "{}") }
            "tools/list" { ответить(номер, список_инструментов()) }
            "tools/call" {
                пусть имя = п.поле("name").как_стр() иначе ""
                если не имена_инструментов().содержит(имя) {
                    ответить_ошибкой(номер, -32602, "нет инструмента «" + имя + "»; есть: "
                        + имена_инструментов().соединить(", "))
                } иначе если не п.поле("arguments").пусто() и не это_объект(п.поле("arguments")) {
                    ответить_ошибкой(номер, -32602, "arguments - объект с параметрами инструмента")
                } иначе {
                    ответить(номер, вызвать(п, к))
                }
            }
            иначе { ответить_ошибкой(номер, -32601, "метод " + метод + " не поддерживается") }
        }
    }
    вернуть 0
}
