/// Привычки из других языков: слова и знаки, которые по привычке пишут в программе на Дане.
///
/// Файл создан сценарием сам/создать_привычки.py из таблиц privychki.py компилятора на Python;
/// изменять его вручную не нужно.

/// слово -> [замена, пояснение]
общий функ слова() -> {стр: [стр]} {
    перем т: {стр: [стр]} = {}
    т["def"] = ["функ", ""]
    т["function"] = ["функ", ""]
    т["fn"] = ["функ", ""]
    т["func"] = ["функ", ""]
    т["fun"] = ["функ", ""]
    т["if"] = ["если", ""]
    т["elif"] = ["иначе если", ""]
    т["else"] = ["иначе", ""]
    т["while"] = ["пока", ""]
    т["for"] = ["для", ""]
    т["foreach"] = ["для", ""]
    т["in"] = ["в", ""]
    т["return"] = ["вернуть", ""]
    т["break"] = ["прервать", ""]
    т["continue"] = ["продолжить", ""]
    т["let"] = ["пусть", ""]
    т["const"] = ["пусть", ""]
    т["val"] = ["пусть", ""]
    т["var"] = ["перем", ""]
    т["class"] = ["тип", ""]
    т["struct"] = ["тип", ""]
    т["enum"] = ["тип", ""]
    т["interface"] = ["интерфейс", ""]
    т["import"] = ["подключить", ""]
    т["from"] = ["подключить", ""]
    т["include"] = ["подключить", ""]
    т["require"] = ["подключить", ""]
    т["using"] = ["подключить", ""]
    т["switch"] = ["выбор", ""]
    т["match"] = ["выбор", ""]
    т["and"] = ["и", ""]
    т["or"] = ["или", ""]
    т["not"] = ["не", ""]
    т["try"] = ["", "в Дане нет исключений: функция с результатом «Т!» возвращает ошибка(текст), а вызывающий пишет «если пусть з = ф() { ... } иначе ошибка о { ... }» или «ф()!»"]
    т["catch"] = ["", "в Дане нет исключений: функция с результатом «Т!» возвращает ошибка(текст), а вызывающий пишет «если пусть з = ф() { ... } иначе ошибка о { ... }» или «ф()!»"]
    т["except"] = ["", "в Дане нет исключений: функция с результатом «Т!» возвращает ошибка(текст), а вызывающий пишет «если пусть з = ф() { ... } иначе ошибка о { ... }» или «ф()!»"]
    т["finally"] = ["", "в Дане нет исключений: функция с результатом «Т!» возвращает ошибка(текст), а вызывающий пишет «если пусть з = ф() { ... } иначе ошибка о { ... }» или «ф()!»"]
    т["throw"] = ["", "в Дане нет исключений: функция с результатом «Т!» возвращает ошибка(текст), а вызывающий пишет «если пусть з = ф() { ... } иначе ошибка о { ... }» или «ф()!»"]
    т["raise"] = ["", "в Дане нет исключений: функция с результатом «Т!» возвращает ошибка(текст), а вызывающий пишет «если пусть з = ф() { ... } иначе ошибка о { ... }» или «ф()!»"]
    вернуть т
}

/// знак -> замена
общий функ знаки() -> {стр: стр} {
    перем т: {стр: стр} = {}
    т["&&"] = "и"
    т["||"] = "или"
    т["++"] = "+= 1"
    т["--"] = "-= 1"
    т["**"] = "^"
    вернуть т
}

/// имя -> [замена, пояснение]
общий функ имена() -> {стр: [стр]} {
    перем т: {стр: [стр]} = {}
    т["print"] = ["вывод", ""]
    т["println"] = ["вывод", ""]
    т["printf"] = ["вывод", ""]
    т["puts"] = ["вывод", ""]
    т["input"] = ["ввод", ""]
    т["readline"] = ["ввод", ""]
    т["scanf"] = ["ввод", ""]
    т["str"] = ["стр", ""]
    т["int"] = ["цел", ""]
    т["float"] = ["дроб", ""]
    т["double"] = ["дроб", ""]
    т["bool"] = ["лог", ""]
    т["parseInt"] = ["цел", ""]
    т["parseFloat"] = ["дроб", ""]
    т["atoi"] = ["цел", ""]
    т["abs"] = ["модуль", ""]
    т["sum"] = ["сумма", ""]
    т["max"] = ["макс", ""]
    т["min"] = ["мин", ""]
    т["sorted"] = ["упорядочить", ""]
    т["round"] = ["округлить", ""]
    т["sqrt"] = ["корень", ""]
    т["pow"] = ["", "степень пишется знаком «^»: а ^ б"]
    т["len"] = ["", "длина - свойство без скобок: с.длина"]
    т["range"] = ["", "диапазон пишется а..б, оба конца включительно: для к в 0..н - 1"]
    т["True"] = ["истина", ""]
    т["true"] = ["истина", ""]
    т["False"] = ["ложь", ""]
    т["false"] = ["ложь", ""]
    т["None"] = ["ничего", ""]
    т["null"] = ["ничего", ""]
    т["nil"] = ["ничего", ""]
    т["undefined"] = ["ничего", ""]
    т["NULL"] = ["ничего", ""]
    т["break"] = ["прервать", ""]
    т["continue"] = ["продолжить", ""]
    т["pass"] = ["", "пустой блок пишется { }"]
    т["self"] = ["сам", ""]
    т["this"] = ["сам", ""]
    т["exit"] = ["завершить", ""]
    т["open"] = ["", "файл читает прочитать(путь), записывает записать(путь, текст)"]
    вернуть т
}

/// метод или свойство -> замена
общий функ методы() -> {стр: стр} {
    перем т: {стр: стр} = {}
    т["append"] = "добавить"
    т["push"] = "добавить"
    т["add"] = "добавить"
    т["split"] = "разбить"
    т["join"] = "соединить"
    т["strip"] = "обрезать"
    т["trim"] = "обрезать"
    т["upper"] = "прописные"
    т["toUpperCase"] = "прописные"
    т["lower"] = "строчные"
    т["toLowerCase"] = "строчные"
    т["replace"] = "заменить"
    т["startswith"] = "начинается"
    т["startsWith"] = "начинается"
    т["endswith"] = "оканчивается"
    т["endsWith"] = "оканчивается"
    т["find"] = "найти"
    т["indexOf"] = "найти"
    т["index"] = "найти"
    т["contains"] = "содержит"
    т["includes"] = "содержит"
    т["has"] = "содержит"
    т["keys"] = "ключи"
    т["values"] = "значения"
    т["get"] = "получить"
    т["copy"] = "копия"
    т["clone"] = "копия"
    т["reverse"] = "обратный"
    т["reversed"] = "обратный"
    т["insert"] = "вставить"
    т["remove"] = "удалить"
    т["pop"] = "удалить"
    т["delete"] = "удалить"
    т["erase"] = "удалить"
    т["map"] = "преобразовать"
    т["filter"] = "отобрать"
    т["reduce"] = "свернуть"
    т["any"] = "любой"
    т["some"] = "любой"
    т["all"] = "все"
    т["every"] = "все"
    т["length"] = "длина"
    т["size"] = "длина"
    т["len"] = "длина"
    т["count"] = "длина"
    вернуть т
}

общий функ сообщение_слова(слово: стр) -> стр {
    пусть з = слова()[слово]
    если з[0] != "" { вернуть "«" + слово + "» - не слово Дана: напишите «" + з[0] + "»" }
    вернуть "«" + слово + "» - не слово Дана: " + з[1]
}

общий функ сообщение_знака(знак: стр) -> стр {
    вернуть "«" + знак + "» - не знак Дана: напишите «" + знаки()[знак] + "»"
}

/// Окончание сообщения о необъявленном имени или "".
общий функ подсказка_имени(имя: стр) -> стр {
    пусть т = имена()
    если не т.содержит(имя) { вернуть "" }
    пусть з = т[имя]
    если з[0] != "" { вернуть "; в Дане: напишите «" + з[0] + "»" }
    вернуть "; в Дане " + з[1]
}

/// Окончание сообщения об отсутствующем методе (вызов) или свойстве.
общий функ подсказка_метода(имя: стр, вызов: лог) -> стр {
    пусть замена = методы().получить(имя, "")
    если замена == "" { вернуть "" }
    если замена == "длина" и вызов { вернуть "; в Дане длина - свойство без скобок: с.длина" }
    вернуть "; в Дане: напишите «" + замена + "»"
}
