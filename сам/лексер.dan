/// Лексер Дана, написанный на Дане: первая часть компилятора на самом Дане.
///
/// Делает то же, что lexer.py: разбивает текст программы на токены. Для
/// каждой программы каталога, примеров и библиотеки токены и сообщения об
/// ошибках совпадают с токенами lexer.py (проверяет test_sam.py).
///
///     подключить "сам/лексер"
///     пусть токены = лексер.разобрать(текст)!
///
/// Буквы и их алфавиты - из таблицы Юникода закреплённой версии (сам/буквы.dan, сценарий
/// сам/создать_буквы.py), той же, что у lexer.py на Python 3.12 (test_bukvy.py).

/// Токен: вид, значение (текстом), место в программе.
подключить "привычки"
подключить "буквы"

общий тип Токен {
    /// ИМЯ, КЛЮЧ, ЦЕЛОЕ, ДРОБНОЕ, СТРОКА, ЗНАК, КОНЕЦ_СТРОКИ или КОНЕЦ_ФАЙЛА
    вид: стр
    /// имя без «ё», число цифрами (у дробного - запись с «e»), текст строки, знак
    значение: стр
    строка: цел
    столбец: цел
    /// имя так, как оно написано (с «ё»)
    написание: стр = ""
}

/// Является ли символ буквой (без «_»).
общий функ буква(с: стр) -> лог {
    пусть к = код_символа(с)
    если к < 128 {
        вернуть (к >= 65 и к <= 90) или (к >= 97 и к <= 122)
    }
    вернуть буквы.номер_алфавита(к) > 0
}

/// Цифра 0-9.
общий функ цифра(с: стр) -> лог {
    вернуть с != "" и "0123456789".содержит(с)
}

функ буква_или_цифра(с: стр) -> лог {
    вернуть буква(с) или цифра(с) или с == "_"
}

/// Замена «ё» на «е»: «счётчик» и «счетчик» - одно имя.
общий функ без_ё(слово: стр) -> стр {
    вернуть слово.заменить("ё", "е").заменить("Ё", "Е")
}

/// Алфавит буквы (первое слово её названия в Юникоде): LATIN, CYRILLIC, GREEK...; не буква - "".
функ алфавит(с: стр) -> стр {
    пусть к = код_символа(с)
    если к < 128 {
        если буква(с) { вернуть "LATIN" }
        вернуть ""
    }
    пусть н = буквы.номер_алфавита(к)
    если н == 0 { вернуть "" }
    вернуть буквы.название(н)
}

функ название_алфавита(а: стр) -> стр {
    выбор а {
        "CYRILLIC" { вернуть "русские" }
        "LATIN" { вернуть "латинские" }
        "GREEK" { вернуть "греческие" }
        иначе { вернуть а.строчные() }
    }
}

функ название_буквы(а: стр) -> стр {
    выбор а {
        "CYRILLIC" { вернуть "русская" }
        "LATIN" { вернуть "латинская" }
        "GREEK" { вернуть "греческая" }
        иначе { вернуть а.строчные() }
    }
}

/// Смешение алфавитов внутри одной части имени («сoк» с латинской «o»):
/// описание ошибки или "". Части, разделённые «_» или цифрами, могут быть
/// написаны разными алфавитами: «хеш_sha256».
общий функ смешение_алфавитов(слово: стр) -> стр {
    пусть символы = (слово + "_").символы()
    перем часть: [стр] = []
    перем номера: [цел] = []
    перем номер = 0
    для с в символы {
        номер += 1
        если алфавит(с) != "" {
            часть.добавить(с)
            номера.добавить(номер)
            продолжить
        }
        пусть о = смешение_в_части(слово, часть, номера)
        если о != "" { вернуть о }
        часть = []
        номера = []
    }
    вернуть ""
}

функ смешение_в_части(слово: стр, часть: [стр], номера: [цел]) -> стр {
    перем алфавиты: [стр] = []
    перем счёт: [цел] = []
    для с в часть {
        пусть а = алфавит(с)
        пусть н = алфавиты.найти(а)
        если н < 0 {
            алфавиты.добавить(а)
            счёт.добавить(1)
        } иначе {
            счёт[н] = счёт[н] + 1
        }
    }
    если алфавиты.длина < 2 { вернуть "" }
    // основной алфавит - самый частый; при равенстве - русский, затем встреченный раньше
    перем лучший = 0
    для н в 1..алфавиты.длина - 1 {
        пусть больше = счёт[н] > счёт[лучший]
        пусть равно_но_русский = счёт[н] == счёт[лучший] и алфавиты[н] == "CYRILLIC" и алфавиты[лучший] != "CYRILLIC"
        если больше или равно_но_русский { лучший = н }
    }
    пусть основной = алфавиты[лучший]
    перем чужие: [стр] = []
    для н в 0..часть.длина - 1 {
        пусть а = алфавит(часть[н])
        если а != основной {
            чужие.добавить("«" + часть[н] + "» (" + стр(номера[н]) + "-я буква, " + название_буквы(а) + ")")
        }
    }
    вернуть ("в имени «" + слово + "» смешаны буквы разных алфавитов: " + чужие.соединить(", ")
        + "; остальные буквы " + название_алфавита(основной) + ". Вероятно, включена не та раскладка клавиатуры")
}

функ шестнадцатеричное(число: цел, знаков: цел) -> стр {
    пусть цифры = "0123456789ABCDEF".символы()
    перем итог = ""
    перем ч = число
    пока ч > 0 {
        итог = цифры[ч % 16] + итог
        ч = частное(ч, 16)
    }
    пока итог.длина < знаков { итог = "0" + итог }
    вернуть итог
}

/// Название невидимого символа или "".
функ название_невидимого(к: цел) -> стр {
    выбор к {
        1564 { вернуть "арабский знак направления" }
        8206 { вернуть "знак направления слева направо" }
        8207 { вернуть "знак направления справа налево" }
        8234 { вернуть "встраивание слева направо" }
        8235 { вернуть "встраивание справа налево" }
        8236 { вернуть "конец встраивания или смены направления" }
        8237 { вернуть "смена направления на слева направо" }
        8238 { вернуть "смена направления на справа налево" }
        8294 { вернуть "изоляция слева направо" }
        8295 { вернуть "изоляция справа налево" }
        8296 { вернуть "изоляция по первому сильному символу" }
        8297 { вернуть "конец изоляции" }
        160 { вернуть "неразрывный пробел" }
        173 { вернуть "мягкий перенос" }
        8203 { вернуть "пробел нулевой ширины" }
        8204 { вернуть "разделитель нулевой ширины" }
        8205 { вернуть "соединитель нулевой ширины" }
        8288 { вернуть "соединитель слов" }
        65279 { вернуть "метка порядка байтов" }
        иначе { вернуть "" }
    }
}

/// Символ управления направлением текста (атака Trojan Source).
функ символ_направления(к: цел) -> лог {
    вернуть к == 1564 или к == 8206 или к == 8207 или (к >= 8234 и к <= 8238) или (к >= 8294 и к <= 8297)
}

функ невидимый(к: цел) -> лог {
    вернуть (к < 32 или (к >= 127 и к <= 160) или к == 173 или к == 1564 или (к >= 8192 и к <= 8207)
        или (к >= 8232 и к <= 8239) или (к >= 8287 и к <= 8303) или к == 12288 или к == 65279
        или (к >= 65529 и к <= 65531) или (к >= 57344 и к <= 63743))
}

/// Видимое описание символа для сообщения об ошибке.
общий функ описание_символа(с: стр) -> стр {
    пусть к = код_символа(с)
    пусть код = "U+" + шестнадцатеричное(к, 4)
    пусть название = название_невидимого(к)
    если название != "" { вернуть "невидимый символ " + код + " (" + название + ")" }
    если невидимый(к) { вернуть "невидимый символ " + код }
    вернуть "символ «" + с + "» (" + код + ")"
}

функ место(строка: цел, столбец: цел, сообщение: стр) -> стр {
    вернуть "Строка " + стр(строка) + ", позиция " + стр(столбец) + ": " + сообщение
}

функ отступ_строки(с: [стр], поз: цел) -> цел {
    перем начало = поз
    пока начало > 0 и с[начало - 1] != "\n" { начало -= 1 }
    перем отступ = 0
    перем н = начало
    пока н < поз {
        выбор с[н] {
            " " { отступ += 1 }
            "\t" { отступ += 4 }
            "\r" { }
            иначе { прервать }
        }
        н += 1
    }
    вернуть отступ
}

функ символ_в(с: [стр], н: цел) -> стр {
    если н < с.длина { вернуть с[н] }
    вернуть ""
}

функ число_без_нулей(цифры: стр) -> стр {
    перем н = 0
    пусть с = цифры.символы()
    пока н < с.длина - 1 и с[н] == "0" { н += 1 }
    вернуть цифры[н..цифры.длина - 1]
}

/// Число по основанию 16 или 2: значение (десятичной записью), запись в тексте, конец, ошибка.
тип ЧислоПоОснованию {
    значение: стр
    запись: стр
    конец: цел
    ошибка: стр
}

/// Значение цифры по основанию или -1; «А», «В», «С», «Е» русские - -2 (похожи на латинские).
функ значение_цифры(з: стр, основание: цел) -> цел {
    пусть к = код_символа(з)
    перем д = -1
    если к >= 48 и к <= 57 { д = к - 48 }
    если к >= 65 и к <= 70 { д = к - 55 }
    если к >= 97 и к <= 102 { д = к - 87 }
    если д >= 0 и д < основание { вернуть д }
    если основание == 16 и "АВСЕавсе".содержит(з) { вернуть -2 }
    вернуть -1
}

/// Разбирает 0x1F, 0х1F (русская «х»), 0b1010, 0д1010 с позиции «0»; «_» допускается между цифрами.
функ число_по_основанию(с: [стр], начало: цел) -> ЧислоПоОснованию {
    пусть буква_ = с[начало + 1]
    перем основание = 16
    перем название = "шестнадцатеричн"
    перем цифры_ = "0-9 и латинские A-F"
    если "bBдД".содержит(буква_) {
        основание = 2
        название = "двоичн"
        цифры_ = "0 и 1"
    }
    если буква_ == "o" или буква_ == "O" {
        вернуть ЧислоПоОснованию("", "", начало, "в Дане нет восьмеричной записи «0o»: число пишется десятичным, "
            + "шестнадцатеричным (0x1F) или двоичным (0b1010)")
    }
    перем поз = начало + 2
    перем значение = 0
    перем цифр = 0
    перем слишком_велико = ложь
    пока поз < с.длина {
        пусть з = с[поз]
        если з == "_" и цифр > 0 и поз + 1 < с.длина и значение_цифры(с[поз + 1], основание) >= 0 {
            поз += 1
            продолжить
        }
        пусть д = значение_цифры(з, основание)
        если д == -2 {
            вернуть ЧислоПоОснованию("", "", поз, "в шестнадцатеричном числе русская буква «" + з
                + "»: цифры A-F пишутся латинскими буквами")
        }
        если д < 0 { прервать }
        если значение > частное(9223372036854775807 - д, основание) {
            слишком_велико = истина
        } иначе {
            значение = значение * основание + д
        }
        цифр += 1
        поз += 1
    }
    пусть запись = типы_срез(с, начало, поз)
    если цифр == 0 {
        вернуть ЧислоПоОснованию("", "", поз, "после «" + типы_срез(с, начало, начало + 2) + "» нужны " + название
            + "ые цифры: " + цифры_)
    }
    если поз < с.длина и (буква_или_цифра(с[поз])) {
        вернуть ЧислоПоОснованию("", "", поз, "«" + с[поз] + "» - не " + название + "ая цифра: в " + название
            + "ом числе только цифры " + цифры_)
    }
    если слишком_велико {
        вернуть ЧислоПоОснованию("", "", поз, название + "ое число не помещается в цел: наибольшее - "
            + "0x7FFF_FFFF_FFFF_FFFF (63 единицы); число из 64 единиц - это -1 или биты_не(0)")
    }
    вернуть ЧислоПоОснованию(стр(значение), запись, поз, "")
}

функ типы_срез(с: [стр], от: цел, до: цел) -> стр {
    перем итог = ""
    для н в от..до - 1 { итог += с[н] }
    вернуть итог
}

/// Знаки действий, после которых строка продолжается следующей. Нет «>»: им оканчивается и тип
/// («поле: массив<цел>»); нет «=», «..», «->» и унарного «не».
общий функ знак_переноса(т: Токен) -> лог {
    если т.вид == "КЛЮЧ" { вернуть т.значение == "и" или т.значение == "или" }
    вернуть т.вид == "ЗНАК" и ["+", "-", "*", "/", "%", "^", "==", "!=", "<", "<=", ">="].содержит(т.значение)
}

/// Оканчивает ли токен значение: имя, число, строка, «истина», «ложь», «ничего», «)», «]», «!», «?».
общий функ конец_значения(т: Токен) -> лог {
    если т.вид == "ИМЯ" или т.вид == "ЦЕЛОЕ" или т.вид == "ДРОБНОЕ" или т.вид == "СТРОКА" { вернуть истина }
    если т.вид == "КЛЮЧ" { вернуть т.значение == "истина" или т.значение == "ложь" или т.значение == "ничего" }
    вернуть т.вид == "ЗНАК" и [")", "]", "!", "?"].содержит(т.значение)
}

/// Продолжается ли инструкция на следующей строке: последний токен - знак действия, стоящий после значения
/// (прежде такая строка всегда была ошибкой). Знак после знака («х++», «х--») - привычка другого языка, а
/// не перенос: его сообщение остаётся прежним.
функ переносит_строку(токены: [Токен]) -> лог {
    если токены.длина < 2 { вернуть ложь }
    вернуть знак_переноса(токены[токены.длина - 1]) и конец_значения(токены[токены.длина - 2])
}

/// Многострочная или сырая строка, прочитанная лексером: текст и место сразу после неё.
тип ПрочитаннаяСтрока {
    текст: стр
    поз: цел
    строка: цел
    столбец: цел
}

/// Последовательность «\» в строке: знак, который она означает, или "" для неизвестной.
функ знак_последовательности(п: стр) -> стр {
    выбор п {
        "n" { вернуть "\n" }
        "t" { вернуть "\t" }
        "r" { вернуть "\r" }
        "\"" { вернуть "\"" }
        "\\" { вернуть "\\" }
        иначе { вернуть "" }
    }
}

/// Многострочная строка (раздел 2.6 spec.md): «"""» в конце строки, текст со следующей строки,
/// закрывающие «"""» на своей строке; их отступ убирается из каждой строки текста. У сырой строки
/// («#"""» ... «"""#») последовательности «\» не обрабатываются. поз - место первой кавычки.
функ многострочная(с: [стр], поз: цел, строка: цел, столбец: цел, сырая: лог) -> ПрочитаннаяСтрока! {
    пусть всего = с.длина
    перем н = поз + 3
    перем стлб = столбец + 3
    пока н < всего и с[н] != "\n" {
        если с[н] != " " и с[н] != "\t" и с[н] != "\r" {
            вернуть ошибка(место(строка, стлб, "после «\"\"\"» текст многострочной строки пишется со следующей строки"))
        }
        н += 1
        стлб += 1
    }
    перем строки_текста: [стр] = []
    перем номера: [цел] = []
    перем номер = строка
    пока истина {
        если н >= всего {
            вернуть ошибка(место(строка, столбец, "многострочная строка не закрыта: закрывающие «\"\"\"» пишутся "
                + "на отдельной строке"))
        }
        н += 1                                  // перевод строки
        номер += 1
        перем начало = н
        пока н < всего и с[н] != "\n" { н += 1 }
        перем конец = н
        если конец > начало и с[конец - 1] == "\r" { конец -= 1 }
        перем отступ = 0
        пока начало + отступ < конец и (с[начало + отступ] == " " или с[начало + отступ] == "\t") { отступ += 1 }
        пусть к = начало + отступ
        если к + 2 < всего и с[к] == "\"" и с[к + 1] == "\"" и с[к + 2] == "\"" и (не сырая или символ_в(с, к + 3) == "#") {
            // закрывающие кавычки: их отступ убирается из каждой строки текста
            перем итог: [стр] = []
            для ск в 0..строки_текста.длина - 1 {
                пусть л = строки_текста[ск].символы()
                перем пустая = истина
                для з в л { если з != " " и з != "\t" { пустая = ложь } }
                если пустая {
                    итог.добавить("")
                    продолжить
                }
                для о в 0..отступ - 1 {
                    если о >= л.длина или л[о] != с[начало + о] {
                        вернуть ошибка(место(номера[ск], о + 1, "строка многострочной строки начинается левее "
                            + "закрывающих «\"\"\"»: их отступ убирается из каждой строки текста"))
                    }
                }
                перем часть = ""
                перем ч = отступ
                пока ч < л.длина {
                    если л[ч] == "\\" и не сырая {
                        пусть знак = знак_последовательности(символ_в(л, ч + 1))
                        если знак == "" {
                            вернуть ошибка(место(номера[ск], ч + 2, "неизвестная последовательность \\" + символ_в(л, ч + 1)))
                        }
                        часть += знак
                        ч += 2
                    } иначе {
                        часть += л[ч]
                        ч += 1
                    }
                }
                итог.добавить(часть)
            }
            перем длина = 3
            если сырая { длина = 4 }
            вернуть ПрочитаннаяСтрока(итог.соединить("\n"), к + длина, номер, отступ + длина + 1)
        }
        перем текст_строки = ""
        для ин в начало..конец - 1 { текст_строки += с[ин] }
        строки_текста.добавить(текст_строки)
        номера.добавить(номер)
    }
    вернуть ошибка("недостижимо")
}

/// Сырая строка в одну строку: «#"..."#», внутри «\» не обрабатывается. поз - место знака «#».
функ сырая_строка(с: [стр], поз: цел, строка: цел, столбец: цел) -> ПрочитаннаяСтрока! {
    перем н = поз + 2
    перем текст = ""
    пока н < с.длина и с[н] != "\n" {
        если с[н] == "\"" и символ_в(с, н + 1) == "#" {
            вернуть ПрочитаннаяСтрока(текст, н + 2, строка, столбец + (н + 2 - поз))
        }
        текст += с[н]
        н += 1
    }
    вернуть ошибка(место(строка, столбец, "сырая строка не закрыта: она кончается знаками «\"#» на той же строке"))
}

/// Разбивает текст программы на токены; ошибка записи - ошибка-значение с номером строки и позиции.
общий функ разобрать(исходный: стр) -> [Токен]! {
    перем с = исходный.символы()
    // Блокнот Windows может сохранить UTF-8 с меткой порядка байтов в начале файла
    если с.длина > 0 и код_символа(с[0]) == 65279 { с.удалить(0) }
    пусть всего = с.длина
    пусть ключевые = ["функ", "вернуть", "пусть", "перем", "если", "иначе", "пока", "для", "в", "прервать",
                      "продолжить", "и", "или", "не", "истина", "ложь", "тип", "ничего", "выбор", "подключить",
                      "как", "общий", "интерфейс", "запустить", "параллельно", "внешняя"]
    пусть двойные = ["==", "!=", "<=", ">=", "+=", "-=", "*=", "/=", "->", ".."]
    пусть одиночные = "+-*/%<>=:,.(){}[]^?!№"

    // символы управления направлением запрещены во всём тексте, включая строки и комментарии
    перем стр_н = 1
    перем стлб_н = 1
    для знак в с {
        если символ_направления(код_символа(знак)) {
            вернуть ошибка(место(стр_н, стлб_н, описание_символа(знак) + ": такие символы меняют порядок "
                + "показа текста на экране и позволяют скрыть настоящий смысл программы; удалите его"))
        }
        если знак == "\n" {
            стр_н += 1
            стлб_н = 1
        } иначе {
            стлб_н += 1
        }
    }

    перем токены: [Токен] = []
    перем скобки: [стр] = []
    перем отступы: [цел] = []
    перем ждём_блок = -1          // отступ строки с «:», если тело блока ещё не началось; -1 - не ждём
    перем начало_строки = истина
    перем отступ_тек = 0
    перем поз = 0
    перем строка = 1
    перем столбец = 1

    пока поз < всего {
        пусть ч = с[поз]
        пусть след = символ_в(с, поз + 1)
        если начало_строки и ч != " " и ч != "\t" и ч != "\r" и ч != "\n" и не (ч == "/" и след == "/") {
            // первое значимое в строке: открыть ожидаемый блок, закрыть законченные
            начало_строки = ложь
            пусть в_скобках = скобки.длина > 0 и (скобки[скобки.длина - 1] == "(" или скобки[скобки.длина - 1] == "[")
            если не в_скобках {
                пусть отступ = отступ_строки(с, поз)
                если ждём_блок >= 0 {
                    если отступ <= ждём_блок {
                        вернуть ошибка(место(строка, столбец, "после «:» в конце строки ожидается блок: эта строка "
                            + "должна быть записана с бо́льшим отступом, чем строка с «:»"))
                    }
                    отступы.добавить(ждём_блок)
                    ждём_блок = -1
                }
                пока отступы.длина > 0 и отступ <= отступы[отступы.длина - 1] {
                    отступы.удалить(отступы.длина - 1)
                    если скобки.длина > 0 и скобки[скобки.длина - 1] == "{" { скобки.удалить(скобки.длина - 1) }
                    если токены.длина > 0 и токены[токены.длина - 1].вид != "КОНЕЦ_СТРОКИ" {
                        токены.добавить(Токен("КОНЕЦ_СТРОКИ", "", строка, столбец))
                    }
                    токены.добавить(Токен("ЗНАК", "}", строка, столбец))
                    токены.добавить(Токен("КОНЕЦ_СТРОКИ", "", строка, столбец))
                }
                отступ_тек = отступ
            }
        }

        если ч == " " или ч == "\t" или ч == "\r" {
            поз += 1
            столбец += 1
        } иначе если ч == "\n" {
            пусть в_скобках = скобки.длина > 0 и (скобки[скобки.длина - 1] == "(" или скобки[скобки.длина - 1] == "[")
            // «:» последним в строке (вне круглых и квадратных скобок) открывает блок
            если не в_скобках и токены.длина > 0 {
                пусть последний = токены[токены.длина - 1]
                если последний.вид == "ЗНАК" и последний.значение == ":" и последний.строка == строка {
                    токены[токены.длина - 1] = Токен("ЗНАК", "{", последний.строка, последний.столбец)
                    скобки.добавить("{")
                    ждём_блок = отступ_тек
                }
            }
            пусть стр_кон = строка
            пусть стлб_кон = столбец
            поз += 1
            строка += 1
            столбец = 1
            пусть в_скобках2 = скобки.длина > 0 и (скобки[скобки.длина - 1] == "(" или скобки[скобки.длина - 1] == "[")
            // строка, которая оканчивается знаком действия после значения («а +», «х и»), продолжается следующей
            пусть продолжение = не в_скобках2 и переносит_строку(токены)
            если не в_скобках2 и не продолжение и токены.длина > 0 и токены[токены.длина - 1].вид != "КОНЕЦ_СТРОКИ" {
                токены.добавить(Токен("КОНЕЦ_СТРОКИ", "", стр_кон, стлб_кон))
            }
            если не в_скобках2 и не продолжение { начало_строки = истина }
        } иначе если ч == "/" и след == "/" {
            пока поз < всего и с[поз] != "\n" {
                поз += 1
                столбец += 1
            }
        } иначе если ч == "0" и след != "" и "xXхХbBдДoO".содержит(след) {
            // шестнадцатеричное (0x1F, 0х1F) и двоичное (0b1010, 0д1010) число
            пусть нач = столбец
            пусть р = число_по_основанию(с, поз)
            если р.ошибка != "" { вернуть ошибка(место(строка, нач, р.ошибка)) }
            столбец += р.конец - поз
            токены.добавить(Токен("ЦЕЛОЕ", р.значение, строка, нач, р.запись))
            поз = р.конец
        } иначе если цифра(ч) {
            пусть нач = столбец
            перем запись = ""
            перем дробное = ложь
            // цифры, «_» между цифрами пропускается
            пока поз < всего и (цифра(с[поз]) или (с[поз] == "_" и поз + 1 < всего и цифра(с[поз + 1]) и запись != "")) {
                если с[поз] != "_" { запись += с[поз] }
                поз += 1
                столбец += 1
            }
            // точка - часть дроби, только если за ней цифра (а не «..»)
            если символ_в(с, поз) == "." и цифра(символ_в(с, поз + 1)) {
                дробное = истина
                запись += "."
                поз += 1
                столбец += 1
                // «_» пропускается только между цифрами: сразу после точки - нет
                перем после_цифры = ложь
                пока поз < всего и (цифра(с[поз]) или (с[поз] == "_" и цифра(символ_в(с, поз + 1)) и после_цифры)) {
                    если с[поз] != "_" { запись += с[поз] }
                    после_цифры = цифра(с[поз])
                    поз += 1
                    столбец += 1
                }
            }
            // порядок числа: 1e30, 6.02e23, 1.5е-7 (буква «e» латинская или русская)
            если поз < всего и (с[поз] == "e" или с[поз] == "E" или с[поз] == "е" или с[поз] == "Е") {
                пусть п1 = символ_в(с, поз + 1)
                пусть п2 = символ_в(с, поз + 2)
                если цифра(п1) или ((п1 == "+" или п1 == "-") и цифра(п2)) {
                    дробное = истина
                    запись += "e"
                    поз += 1
                    столбец += 1
                    если с[поз] == "+" или с[поз] == "-" {
                        запись += с[поз]
                        поз += 1
                        столбец += 1
                    }
                    пока поз < всего и цифра(с[поз]) {
                        запись += с[поз]
                        поз += 1
                        столбец += 1
                    }
                }
            }
            если поз < всего и (буква(с[поз]) или с[поз] == "_") {
                вернуть ошибка(место(строка, нач, "число не может переходить в имя без пробела"))
            }
            если дробное {
                токены.добавить(Токен("ДРОБНОЕ", запись, строка, нач))
            } иначе {
                токены.добавить(Токен("ЦЕЛОЕ", число_без_нулей(запись), строка, нач))
            }
        } иначе если буква(ч) или ч == "_" {
            пусть нач = столбец
            перем слово = ""
            пока поз < всего и буква_или_цифра(с[поз]) {
                слово += с[поз]
                поз += 1
                столбец += 1
            }
            пусть смешение = смешение_алфавитов(слово)
            если смешение != "" { вернуть ошибка(место(строка, нач, смешение)) }
            пусть имя = без_ё(слово)
            перем вид = "ИМЯ"
            если ключевые.содержит(имя) { вид = "КЛЮЧ" }
            токены.добавить(Токен(вид, имя, строка, нач, слово))
        } иначе если ч == "#" и след == "\"" {
            // сырая строка: #"..."# в одну строку или #"""..."""# на несколько
            пусть нач = столбец
            перем прочитано = ПрочитаннаяСтрока("", 0, 0, 0)
            если символ_в(с, поз + 2) == "\"" и символ_в(с, поз + 3) == "\"" {
                прочитано = многострочная(с, поз + 1, строка, столбец + 1, истина)!
            } иначе {
                прочитано = сырая_строка(с, поз, строка, столбец)!
            }
            токены.добавить(Токен("СТРОКА", прочитано.текст, строка, нач))
            поз = прочитано.поз
            строка = прочитано.строка
            столбец = прочитано.столбец
        } иначе если ч == "\"" и след == "\"" и символ_в(с, поз + 2) == "\"" {
            пусть нач = столбец
            пусть прочитано = многострочная(с, поз, строка, столбец, ложь)!
            токены.добавить(Токен("СТРОКА", прочитано.текст, строка, нач))
            поз = прочитано.поз
            строка = прочитано.строка
            столбец = прочитано.столбец
        } иначе если ч == "\"" {
            пусть нач = столбец
            поз += 1
            столбец += 1
            перем текст = ""
            перем закрыта = ложь
            пока поз < всего и с[поз] != "\n" {
                пусть з = с[поз]
                если з == "\"" {
                    поз += 1
                    столбец += 1
                    закрыта = истина
                    прервать
                }
                если з == "\\" {
                    поз += 1
                    столбец += 1
                    пусть п = символ_в(с, поз)
                    выбор п {
                        "n" { текст += "\n" }
                        "t" { текст += "\t" }
                        "r" { текст += "\r" }
                        "\"" { текст += "\"" }
                        "\\" { текст += "\\" }
                        иначе { вернуть ошибка(место(строка, столбец, "неизвестная последовательность \\" + п)) }
                    }
                    поз += 1
                    столбец += 1
                } иначе {
                    текст += з
                    поз += 1
                    столбец += 1
                }
            }
            если не закрыта { вернуть ошибка(место(строка, нач, "строка не закрыта кавычкой")) }
            токены.добавить(Токен("СТРОКА", текст, строка, нач))
        } иначе {
            пусть нач = столбец
            пусть пара = ч + след
            если двойные.содержит(пара) {
                поз += 2
                столбец += 2
                токены.добавить(Токен("ЗНАК", пара, строка, нач))
            } иначе если ч == "²" или ч == "³" {
                поз += 1
                столбец += 1
                токены.добавить(Токен("ЗНАК", "^", строка, нач))
                перем степень = "3"
                если ч == "²" { степень = "2" }
                токены.добавить(Токен("ЦЕЛОЕ", степень, строка, нач))
            } иначе если "×·÷−≤≥≠".содержит(ч) {
                поз += 1
                столбец += 1
                пусть знак = выбор_знака(ч)
                токены.добавить(Токен("ЗНАК", знак, строка, нач))
            } иначе если одиночные.содержит(ч) {
                поз += 1
                столбец += 1
                если ч == "(" или ч == "[" или ч == "{" {
                    скобки.добавить(ч)
                } иначе если ч == ")" или ч == "]" {
                    если не (скобки.содержит("(") или скобки.содержит("[")) {
                        вернуть ошибка(место(строка, нач, "лишняя закрывающая скобка «" + ч + "»"))
                    }
                    // незакрытые «{» внутри скобок найдёт разбор
                    перем снято = "{"
                    пока снято == "{" {
                        снято = скобки[скобки.длина - 1]
                        скобки.удалить(скобки.длина - 1)
                    }
                } иначе если ч == "}" и скобки.длина > 0 и скобки[скобки.длина - 1] == "{" {
                    скобки.удалить(скобки.длина - 1)
                }
                токены.добавить(Токен("ЗНАК", ч, строка, нач))
            } иначе если (ч == "&" или ч == "|") и поз + 1 < всего и с[поз + 1] == ч {
                // привычка из других языков: «&&», «||»
                вернуть ошибка(место(строка, нач, привычки.сообщение_знака(ч + ч)))
            } иначе если ч == "&" или ч == "|" или ч == "~" {
                // привычка из других языков: побитовые «&», «|», «~»
                вернуть ошибка(место(строка, нач, привычки.сообщение_побитового(ч)))
            } иначе {
                вернуть ошибка(место(строка, нач, "недопустимый " + описание_символа(ч)))
            }
        }
    }

    // конец текста: как перевод строки
    пусть в_скобках = скобки.длина > 0 и (скобки[скобки.длина - 1] == "(" или скобки[скобки.длина - 1] == "[")
    если не в_скобках и токены.длина > 0 {
        пусть последний = токены[токены.длина - 1]
        если последний.вид == "ЗНАК" и последний.значение == ":" и последний.строка == строка {
            токены[токены.длина - 1] = Токен("ЗНАК", "{", последний.строка, последний.столбец)
            скобки.добавить("{")
            ждём_блок = отступ_тек
        }
    }
    пусть в_скобках2 = скобки.длина > 0 и (скобки[скобки.длина - 1] == "(" или скобки[скобки.длина - 1] == "[")
    если не в_скобках2 и токены.длина > 0 и токены[токены.длина - 1].вид != "КОНЕЦ_СТРОКИ" {
        токены.добавить(Токен("КОНЕЦ_СТРОКИ", "", строка, столбец))
    }
    если ждём_блок >= 0 {
        вернуть ошибка(место(строка, столбец, "после «:» в конце строки ожидается блок: следующая строка пишется с отступом"))
    }
    пока отступы.длина > 0 {
        отступы.удалить(отступы.длина - 1)
        если скобки.длина > 0 и скобки[скобки.длина - 1] == "{" { скобки.удалить(скобки.длина - 1) }
        если токены.длина > 0 и токены[токены.длина - 1].вид != "КОНЕЦ_СТРОКИ" {
            токены.добавить(Токен("КОНЕЦ_СТРОКИ", "", строка, столбец))
        }
        токены.добавить(Токен("ЗНАК", "}", строка, столбец))
        токены.добавить(Токен("КОНЕЦ_СТРОКИ", "", строка, столбец))
    }
    токены.добавить(Токен("КОНЕЦ_ФАЙЛА", "", строка, столбец))
    вернуть токены
}

/// Школьная запись действий (× · ÷ − ≤ ≥ ≠) -> основная.
функ выбор_знака(ч: стр) -> стр {
    выбор ч {
        "×" { вернуть "*" }
        "·" { вернуть "*" }
        "÷" { вернуть "/" }
        "−" { вернуть "-" }
        "≤" { вернуть "<=" }
        "≥" { вернуть ">=" }
        иначе { вернуть "!=" }
    }
}

/// Строка для сверки с lexer.py: вид, место и значение (переводы строк и «\» записаны знаками).
общий функ показать(т: Токен) -> стр {
    перем значение = т.значение.заменить("\\", "\\\\").заменить("\n", "\\n").заменить("\r", "\\r").заменить("\t", "\\t")
    если т.написание != "" и т.написание != т.значение { значение += " | " + т.написание }
    вернуть т.вид + " " + стр(т.строка) + ":" + стр(т.столбец) + " " + значение
}
