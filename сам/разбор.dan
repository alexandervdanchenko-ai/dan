/// Разбор (парсер) Дана, написанный на Дане: вторая часть компилятора на самом Дане.
///
/// Делает то же, что parser.py: строит из токенов дерево программы методом
/// рекурсивного спуска. Дерево печатается так же, как uzly.показать, и для
/// каждой программы репозитория совпадает с деревом parser.py, как и тексты
/// ошибок (проверяет test_sam.py).
///
///     подключить "лексер"
///     подключить "разбор"
///     пусть дерево = разбор.разобрать(лексер.разобрать(текст)!, ["2026"], "1.3")!
///     вывод(разбор.показать(дерево))
///
/// Функции Дана получают копии значений и не меняют общих переменных, поэтому
/// место в списке токенов передаётся из функции в функцию явно: функция
/// разбора получает номер текущего токена и возвращает узел и номер токена
/// после него. Признак «кс» (внутри ключа словаря) - то же, что
/// Парсер.ключ_словаря: там «:» отделяет значение, а не делит.

подключить "лексер"

/// Простое поле узла: имя и значение; «строкой» - значение печатается в кавычках.
общий тип Свойство {
    имя: стр
    значение: стр
    строкой: лог = истина
}

/// Узел дерева: вид (как класс в uzly.py), простые поля и вложенные поля - группы узлов.
/// Элемент списка строк (привязки образца, ограничения параметра типа, имена
/// аргументов) - узел вида «=» с одним простым полем.
общий тип Узел {
    вид: стр
    простые: [Свойство] = []
    /// вложенные поля: у группы вид - имя поля, поля - её содержимое
    поля: [Узел] = []
    строка: цел = 0
    столбец: цел = 0
    /// имя (у Имя и Поле) - для разбора присваиваний
    текст: стр = ""
    /// имя так, как оно написано (с «ё»)
    написание: стр = ""
    /// объявление со словом «общий» (видно из других файлов)
    открытый: лог = ложь
    /// пометки проверки смысла: тип выражения, приведение и т. п. (имя -> значение)
    пометки: {стр: стр} = {}
}

/// Узел и номер токена после него.
общий тип Итог {
    узел: Узел
    поз: цел
}

тип ИтогТекст {
    текст: стр
    поз: цел
}

// ---------- запись значений, как repr в Python ----------

функ шестн(число: цел, знаков: цел) -> стр {
    пусть цифры = "0123456789abcdef".символы()
    перем итог = ""
    перем ч = число
    пока ч > 0 {
        итог = цифры[ч % 16] + итог
        ч = частное(ч, 16)
    }
    пока итог.длина < знаков { итог = "0" + итог }
    вернуть итог
}

/// Строка в записи Python (repr).
общий функ питон(с: стр) -> стр {
    перем кавычка = "'"
    если с.содержит("'") и не с.содержит("\"") { кавычка = "\"" }
    перем итог = кавычка
    для ч в с.символы() {
        пусть к = код_символа(ч)
        если ч == "\\" {
            итог += "\\\\"
        } иначе если ч == кавычка {
            итог += "\\" + ч
        } иначе если ч == "\n" {
            итог += "\\n"
        } иначе если ч == "\r" {
            итог += "\\r"
        } иначе если ч == "\t" {
            итог += "\\t"
        } иначе если к < 32 или (к >= 127 и к <= 160) или к == 173 {
            итог += "\\x" + шестн(к, 2)
        } иначе если (к >= 8192 и к <= 8207) или (к >= 8232 и к <= 8239) или (к >= 8287 и к <= 8303) или к == 65279 {
            итог += "\\u" + шестн(к, 4)
        } иначе {
            итог += ч
        }
    }
    вернуть итог + кавычка
}

функ лог_питон(л: лог) -> стр {
    если л { вернуть "True" }
    вернуть "False"
}

/// Дробное число в записи Python.
функ дробное_питон(запись: стр) -> стр {
    пусть ч = разобрать_дроб(запись) иначе 0.0
    вернуть стр(ч)
}

// ---------- построение узлов ----------

функ узел(вид: стр, простые: [Свойство], поля: [Узел], т: лексер.Токен) -> Узел {
    вернуть Узел(вид, простые, поля, т.строка, т.столбец)
}

общий функ группа(имя: стр, содержимое: [Узел]) -> Узел {
    вернуть Узел(имя, [], содержимое)
}

функ одно(имя: стр, у: Узел) -> Узел {
    вернуть Узел(имя, [], [у])
}

/// Элемент списка строк (привязки образца, ограничения параметра типа, имя аргумента).
общий функ элемент(текст: стр) -> Узел {
    вернуть Узел("=", [Свойство("", текст)])
}

/// Элемент списка без кавычек (None у позиционного аргумента).
функ элемент_сырой(запись: стр) -> Узел {
    вернуть Узел("=", [Свойство("", запись, ложь)])
}

/// Простое поле узла по имени (значение без кавычек) или "".
общий функ свойство(у: Узел, имя: стр) -> стр {
    для с в у.простые {
        если с.имя == имя { вернуть с.значение }
    }
    вернуть ""
}

/// Первый узел вложенного поля по имени.
/// Содержимое вложенного поля по имени.
общий функ часть_группы(у: Узел, имя: стр) -> [Узел] {
    для г в у.поля {
        если г.вид == имя { вернуть г.поля }
    }
    вернуть []
}

общий функ часть(у: Узел, имя: стр) -> Узел {
    для г в у.поля {
        если г.вид == имя и г.поля.длина > 0 { вернуть г.поля[0] }
    }
    вернуть Узел("?")
}

функ простое(имя: стр, значение_: стр) -> Свойство {
    вернуть Свойство(имя, значение_)
}

функ сырое(имя: стр, запись: стр) -> Свойство {
    вернуть Свойство(имя, запись, ложь)
}

функ записать(с: Свойство) -> стр {
    перем з = с.значение
    если с.строкой { з = питон(з) }
    если с.имя == "" { вернуть з }
    вернуть с.имя + "=" + з
}

// ---------- печать дерева, как uzly.показать ----------

/// Дерево в виде текста с отступами (как uzly.показать).
общий функ показать(у: Узел) -> стр {
    вернуть строки_узла(у, 0).соединить("\n")
}

функ строки_узла(у: Узел, отступ: цел) -> [стр] {
    пусть пробелы = "  ".повторить(отступ)
    если у.вид == "=" { вернуть [пробелы + записать(у.простые[0])] }
    перем заголовок = пробелы + у.вид
    если у.простые.длина > 0 {
        перем части: [стр] = []
        для с в у.простые { части.добавить(записать(с)) }
        заголовок += " (" + части.соединить(", ") + ")"
    }
    перем итог = [заголовок]
    для г в у.поля {
        если г.поля.длина == 0 { продолжить }
        итог.добавить(пробелы + "  " + г.вид + ":")
        для вложенный в г.поля {
            для с в строки_узла(вложенный, отступ + 2) { итог.добавить(с) }
        }
    }
    вернуть итог
}

// ---------- токены ----------

функ след(т: [лексер.Токен], поз: цел, на: цел) -> лексер.Токен {
    если поз + на >= т.длина { вернуть т[т.длина - 1] }
    вернуть т[поз + на]
}

функ взять(т: [лексер.Токен], поз: цел) -> цел {
    если т[поз].вид == "КОНЕЦ_ФАЙЛА" { вернуть поз }
    вернуть поз + 1
}

функ это(т: [лексер.Токен], поз: цел, вид: стр) -> лог {
    вернуть т[поз].вид == вид
}

функ знак(т: [лексер.Токен], поз: цел, з: стр) -> лог {
    вернуть т[поз].вид == "ЗНАК" и т[поз].значение == з
}

функ знак_из(т: [лексер.Токен], поз: цел, знаки: [стр]) -> лог {
    вернуть т[поз].вид == "ЗНАК" и знаки.содержит(т[поз].значение)
}

функ ключ(т: [лексер.Токен], поз: цел, слово: стр) -> лог {
    вернуть т[поз].вид == "КЛЮЧ" и т[поз].значение == слово
}

функ имя_слово(т: [лексер.Токен], поз: цел, слово: стр) -> лог {
    вернуть т[поз].вид == "ИМЯ" и т[поз].значение == слово
}

функ знак_токена(ток: лексер.Токен, з: стр) -> лог {
    вернуть ток.вид == "ЗНАК" и ток.значение == з
}

функ на_месте(ток: лексер.Токен, сообщение: стр) -> стр {
    вернуть "Строка " + стр(ток.строка) + ", позиция " + стр(ток.столбец) + ": " + сообщение
}

/// Описание токена для сообщения об ошибке.
функ описать(ток: лексер.Токен) -> стр {
    выбор ток.вид {
        "КОНЕЦ_СТРОКИ" { вернуть "конец строки" }
        "КОНЕЦ_ФАЙЛА" { вернуть "конец файла" }
        "СТРОКА" { вернуть "строка \"" + ток.значение + "\"" }
        "ЦЕЛОЕ" { вернуть "число " + ток.значение }
        "ДРОБНОЕ" { вернуть "число " + дробное_питон(ток.значение) }
        иначе { вернуть "«" + ток.значение + "»" }
    }
}

функ ожидать_знак(т: [лексер.Токен], поз: цел, з: стр, что: стр) -> цел! {
    если не знак(т, поз, з) {
        перем совет = ""
        если т[поз].значение == "=" и т[поз].вид == "ЗНАК" и что.содержит("условия") {
            совет = "; для сравнения используйте «==», а «=» означает присваивание"
        }
        вернуть ошибка(на_месте(т[поз], "ожидалось «" + з + "»" + что + ", а найдено " + описать(т[поз]) + совет))
    }
    вернуть взять(т, поз)
}

функ ожидать_имя(т: [лексер.Токен], поз: цел, что: стр) -> цел! {
    если т[поз].вид != "ИМЯ" {
        если т[поз].вид == "КЛЮЧ" {
            вернуть ошибка(на_месте(т[поз], "ожидалось " + что + ", а найдено ключевое слово «" + т[поз].значение
                + "», его нельзя использовать как имя"))
        }
        вернуть ошибка(на_месте(т[поз], "ожидалось " + что + ", а найдено " + описать(т[поз])))
    }
    вернуть взять(т, поз)
}

функ пропустить_концы(т: [лексер.Токен], поз: цел) -> цел {
    перем н = поз
    пока это(т, н, "КОНЕЦ_СТРОКИ") { н = взять(т, н) }
    вернуть н
}

/// После инструкции должен быть конец строки, «}» или конец файла.
функ конец_инструкции(т: [лексер.Токен], поз: цел) -> цел! {
    если это(т, поз, "КОНЕЦ_СТРОКИ") { вернуть взять(т, поз) }
    если знак(т, поз, "}") или это(т, поз, "КОНЕЦ_ФАЙЛА") { вернуть поз }
    вернуть ошибка(на_месте(т[поз], "ожидался конец строки, а найдено " + описать(т[поз])
        + "; каждая инструкция пишется на отдельной строке"))
}

// ---------- типы ----------

функ начало_типа_результата(т: [лексер.Токен], поз: цел) -> лог {
    вернуть т[поз].вид == "ИМЯ" или знак_из(т, поз, ["[", "(", "!"])
}

/// Имя или «модуль.Имя».
функ составное_имя(т: [лексер.Токен], поз: цел, что: стр) -> ИтогТекст! {
    перем н = ожидать_имя(т, поз, что)!
    перем имя = т[поз].значение
    если знак(т, н, ".") и след(т, н, 1).вид == "ИМЯ" {
        н = взять(т, н)
        имя += "." + т[н].значение
        н = взять(т, н)
    }
    вернуть ИтогТекст(имя, н)
}

/// Тип: имя, список «[тип]», словарь «{К: З}», тип функции, «тип?», «тип!». Возвращает запись типа.
функ тип_(т: [лексер.Токен], поз: цел, что: стр) -> ИтогТекст! {
    перем н = поз
    перем запись = ""
    если ключ(т, н, "функ") {
        // тип функции: функ(цел, стр) -> лог
        н = взять(т, н)
        н = ожидать_знак(т, н, "(", " после «функ» в типе функции")!
        перем параметры: [стр] = []
        пока не знак(т, н, ")") {
            пусть п = тип_(т, н, "тип параметра функции")!
            параметры.добавить(п.текст)
            н = п.поз
            если знак(т, н, ",") {
                н = взять(т, н)
            } иначе если не знак(т, н, ")") {
                вернуть ошибка(на_месте(т[н], "ожидалась «,» или «)» в типе функции, а найдено " + описать(т[н])))
            }
        }
        н = взять(т, н)
        запись = "функ(" + параметры.соединить(", ") + ")"
        если знак(т, н, "->") или начало_типа_результата(т, н) {
            если знак(т, н, "->") { н = взять(т, н) }
            если знак(т, н, "!") {
                н = взять(т, н)
                запись += " -> пусто!"
            } иначе {
                пусть р = тип_(т, н, "тип результата функции")!
                запись += " -> " + р.текст
                н = р.поз
            }
        }
        вернуть ИтогТекст(запись, н)
    }
    если знак(т, н, "[") {
        н = взять(т, н)
        пусть внутр = тип_(т, н, "тип элементов списка")!
        н = ожидать_знак(т, внутр.поз, "]", " после типа элементов списка")!
        запись = "[" + внутр.текст + "]"
    } иначе если знак(т, н, "(") {
        // запись без латинской раскладки: (цел) - список, (стр: цел) - словарь
        н = взять(т, н)
        пусть первый = тип_(т, н, "тип элементов списка или ключей словаря")!
        н = первый.поз
        если знак(т, н, ":") {
            н = взять(т, н)
            пусть зн = тип_(т, н, "тип значений словаря")!
            н = ожидать_знак(т, зн.поз, ")", " после типа значений словаря")!
            запись = "{" + первый.текст + ": " + зн.текст + "}"
        } иначе {
            н = ожидать_знак(т, н, ")", " после типа элементов списка")!
            запись = "[" + первый.текст + "]"
        }
    } иначе если знак(т, н, "{") {
        н = взять(т, н)
        пусть кл = тип_(т, н, "тип ключей словаря")!
        н = ожидать_знак(т, кл.поз, ":", " между типом ключей и типом значений словаря (например, {стр: цел})")!
        пусть зн = тип_(т, н, "тип значений словаря")!
        н = ожидать_знак(т, зн.поз, "}", " после типа значений словаря")!
        запись = "{" + кл.текст + ": " + зн.текст + "}"
    } иначе {
        пусть имя = составное_имя(т, н, что)!
        запись = имя.текст
        н = имя.поз
        если знак(т, н, "<") {
            // обобщённый тип: Пара<цел, стр>
            н = взять(т, н)
            перем аргументы: [стр] = []
            пусть первый = тип_(т, н, "тип в угловых скобках")!
            аргументы.добавить(первый.текст)
            н = первый.поз
            пока знак(т, н, ",") {
                н = взять(т, н)
                пусть ещё = тип_(т, н, "тип в угловых скобках")!
                аргументы.добавить(ещё.текст)
                н = ещё.поз
            }
            н = ожидать_знак(т, н, ">", " после типов в угловых скобках у «" + запись + "»")!
            запись += "<" + аргументы.соединить(", ") + ">"
        }
    }
    если знак(т, н, "?") {
        н = взять(т, н)
        запись += "?"
        если знак(т, н, "?") { вернуть ошибка(на_месте(т[н], "знак «?» после типа ставится один раз")) }
    }
    если знак(т, н, "!") {
        н = взять(т, н)
        запись += "!"
        если знак(т, н, "!") или знак(т, н, "?") {
            вернуть ошибка(на_месте(т[н], "знак «!» (результат может быть ошибкой) ставится один раз, в конце типа"))
        }
    }
    вернуть ИтогТекст(запись, н)
}

// ---------- программа и блоки ----------

функ это_редакция(т: [лексер.Токен], поз: цел) -> лог {
    пусть второй = след(т, поз, 2).вид
    вернуть (имя_слово(т, поз, "редакция") и след(т, поз, 1).вид == "ЦЕЛОЕ"
        и (второй == "КОНЕЦ_СТРОКИ" или второй == "КОНЕЦ_ФАЙЛА"))
}

/// «тест "название" {» или «замер "название" {»: слово, строка и блок.
функ это_тест(т: [лексер.Токен], поз: цел, слово: стр) -> лог {
    вернуть имя_слово(т, поз, слово) и след(т, поз, 1).вид == "СТРОКА" и знак_токена(след(т, поз, 2), "{")
}

функ проверить_редакцию(год: стр, редакции: [стр], версия: стр) -> стр {
    если редакции.содержит(год) { вернуть "" }
    пусть известные = редакции.соединить(", ")
    пусть последняя = редакции[редакции.длина - 1]
    пусть число = разобрать_цел(год) иначе -1
    если число > (разобрать_цел(последняя) иначе 0) {
        вернуть ("программа написана для редакции языка " + год + ", а этот компилятор (Дан " + версия
            + ") знает только редакции: " + известные + "; обновите компилятор Дана")
    }
    вернуть "неизвестная редакция языка «" + год + "»; известные редакции: " + известные
}

/// Дерево программы из токенов; редакции - известные компилятору редакции языка, версия - его версия.
общий функ разобрать(т: [лексер.Токен], редакции: [стр], версия: стр) -> Узел! {
    пусть начало = т[0]
    перем инструкции: [Узел] = []
    перем простые: [Свойство] = []
    перем тестов = 0
    перем замеров = 0
    перем н = пропустить_концы(т, 0)
    если это_редакция(т, н) {
        н = взять(т, н)
        пусть число = т[н]
        н = взять(т, н)
        пусть о = проверить_редакцию(число.значение, редакции, версия)
        если о != "" { вернуть ошибка(на_месте(число, о)) }
        н = конец_инструкции(т, н)!
        н = пропустить_концы(т, н)
        простые.добавить(простое("редакция", число.значение))
    }
    пока не это(т, н, "КОНЕЦ_ФАЙЛА") {
        если знак(т, н, "}") { вернуть ошибка(на_месте(т[н], "лишняя закрывающая скобка «}»")) }
        если это_редакция(т, н) {
            вернуть ошибка(на_месте(т[н], "указание редакции языка пишется первой строкой файла, до остальных инструкций"))
        }
        если это_тест(т, н, "тест") {
            пусть нач = т[н]
            н = взять(т, н)
            пусть название = т[н].значение
            н = взять(т, н)
            если название.обрезать() == "" {
                вернуть ошибка(на_месте(нач, "у теста должно быть название: тест \"что проверяется\" { ... }"))
            }
            пусть тело = блок(т, н, " теста")!
            тестов += 1
            перем тест = узел("Функция", [простое("имя", "тест__" + стр(тестов))], [одно("тело", тело.узел)], нач)
            тест.текст = название         // название теста (в Python - поле «тест» функции)
            инструкции.добавить(тест)
            н = пропустить_концы(т, тело.поз)
            продолжить
        }
        если это_тест(т, н, "замер") {
            пусть нач = т[н]
            н = взять(т, н)
            пусть название = т[н].значение
            н = взять(т, н)
            если название.обрезать() == "" {
                вернуть ошибка(на_месте(нач, "у замера должно быть название: замер \"что замеряется\" { ... }"))
            }
            пусть тело = блок(т, н, " замера")!
            замеров += 1
            перем замер = узел("Функция", [простое("имя", "замер__" + стр(замеров))], [одно("тело", тело.узел)], нач)
            замер.текст = название        // название замера (в Python - поле «замер» функции)
            замер.пометки["замер"] = "да"
            инструкции.добавить(замер)
            н = пропустить_концы(т, тело.поз)
            продолжить
        }
        пусть и_ = инструкция(т, н)!
        инструкции.добавить(и_.узел)
        н = конец_инструкции(т, и_.поз)!
        н = пропустить_концы(т, н)
    }
    вернуть узел("Программа", простые, [группа("инструкции", инструкции)], начало)
}

функ блок(т: [лексер.Токен], поз: цел, что: стр) -> Итог! {
    пусть открытие = т[поз]
    перем н = ожидать_знак(т, поз, "{", что)!
    перем инструкции: [Узел] = []
    н = пропустить_концы(т, н)
    пока не знак(т, н, "}") {
        если это(т, н, "КОНЕЦ_ФАЙЛА") {
            вернуть ошибка(на_месте(открытие, "блок не закрыт: не хватает «}» для скобки, открытой в строке "
                + стр(открытие.строка)))
        }
        пусть и_ = инструкция(т, н)!
        инструкции.добавить(и_.узел)
        н = конец_инструкции(т, и_.поз)!
        н = пропустить_концы(т, н)
    }
    н = взять(т, н)
    вернуть Итог(узел("Блок", [], [группа("инструкции", инструкции)], открытие), н)
}

// ---------- инструкции ----------

функ инструкция(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть ток = т[поз]
    если ток.вид == "КЛЮЧ" {
        выбор ток.значение {
            "общий" {
                пусть н = взять(т, поз)
                если не (ключ(т, н, "функ") или ключ(т, н, "тип") или ключ(т, н, "интерфейс") или ключ(т, н, "внешняя")) {
                    вернуть ошибка(на_месте(т[н], "«общий» ставится перед «функ», «тип», «интерфейс» или «внешняя»: "
                        + "так их можно использовать в программах, подключающих этот файл"))
                }
                пусть объявление_ = инструкция(т, н)!
                перем у = объявление_.узел
                у.открытый = истина
                вернуть Итог(у, объявление_.поз)
            }
            "подключить" { вернуть подключение(т, поз) }
            "функ" { вернуть функция(т, поз) }
            "тип" { вернуть объявление_типа(т, поз) }
            "интерфейс" { вернуть разбор_интерфейса(т, поз) }
            "внешняя" { вернуть разбор_внешней(т, поз) }
            "выбор" { вернуть разбор_выбора(т, поз) }
            "параллельно" {
                пусть тело = блок(т, взять(т, поз), " после «параллельно»")!
                вернуть Итог(узел("Параллельно", [], [одно("тело", тело.узел)], ток), тело.поз)
            }
            "пусть" { вернуть объявление(т, поз) }
            "перем" { вернуть объявление(т, поз) }
            "если" { вернуть разбор_если(т, поз) }
            "пока" { вернуть разбор_пока(т, поз) }
            "для" { вернуть разбор_для(т, поз) }
            "вернуть" { вернуть разбор_вернуть(т, поз) }
            "прервать" { вернуть Итог(узел("Прервать", [], [], ток), взять(т, поз)) }
            "продолжить" { вернуть Итог(узел("Продолжить", [], [], ток), взять(т, поз)) }
            "иначе" { вернуть ошибка(на_месте(ток, "«иначе» без предшествующего «если»")) }
            иначе { }
        }
    }
    вернуть выражение_или_присваивание(т, поз)
}

/// <Т, К: Упорядоченное и Ключ> после имени обобщённой функции или типа.
функ параметры_типа(т: [лексер.Токен], поз: цел) -> Итог! {
    если не знак(т, поз, "<") { вернуть Итог(группа("параметры_типа", []), поз) }
    перем н = взять(т, поз)
    перем параметры: [Узел] = []
    перем имена: [стр] = []
    пока истина {
        пусть ток = т[н]
        н = ожидать_имя(т, н, "имя параметра типа (например, Т)")!
        перем ограничения: [Узел] = []
        если знак(т, н, ":") {
            н = взять(т, н)
            пусть первое = составное_имя(т, н, "название интерфейса после «:»")!
            ограничения.добавить(элемент(первое.текст))
            н = первое.поз
            пока ключ(т, н, "и") {
                н = взять(т, н)
                пусть ещё = составное_имя(т, н, "название интерфейса после «и»")!
                ограничения.добавить(элемент(ещё.текст))
                н = ещё.поз
            }
        }
        если имена.содержит(ток.значение) {
            вернуть ошибка(на_месте(ток, "параметр типа «" + ток.значение + "» указан дважды"))
        }
        имена.добавить(ток.значение)
        перем пт = узел("ПараметрТипа", [простое("имя", ток.значение)], [группа("ограничения", ограничения)], ток)
        пт.текст = ток.значение
        параметры.добавить(пт)
        если знак(т, н, ",") {
            н = взять(т, н)
            продолжить
        }
        прервать
    }
    н = ожидать_знак(т, н, ">", " после параметров типа")!
    вернуть Итог(группа("параметры_типа", параметры), н)
}

функ параметр(ток: лексер.Токен, тип_записью: стр) -> Узел {
    вернуть параметр_с_именем(ток.значение, тип_записью, ток)
}

функ параметр_с_именем(имя: стр, тип_записью: стр, ток: лексер.Токен) -> Узел {
    перем простые = [простое("имя", имя)]
    если тип_записью != "" { простые.добавить(простое("тип", тип_записью)) }
    вернуть узел("Параметр", простые, [], ток)
}


/// Параметры в скобках «(имя: тип, ...)» без значений по умолчанию (внешние функции, методы интерфейса).
функ простые_параметры(т: [лексер.Токен], поз: цел) -> Итог! {
    перем н = поз
    перем параметры: [Узел] = []
    пока не знак(т, н, ")") {
        пусть ток = т[н]
        н = ожидать_имя(т, н, "имя параметра")!
        н = ожидать_знак(т, н, ":", " и тип после параметра «" + ток.значение + "»")!
        пусть тп = тип_(т, н, "тип параметра")!
        н = тп.поз
        параметры.добавить(параметр(ток, тп.текст))
        если знак(т, н, ",") {
            н = взять(т, н)
        } иначе если не знак(т, н, ")") {
            вернуть ошибка(на_месте(т[н], "ожидалась «,» или «)», а найдено " + описать(т[н])))
        }
    }
    вернуть Итог(группа("параметры", параметры), взять(т, н))
}

функ функция(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    перем н = взять(т, поз)
    пусть т_имя = т[н]
    н = ожидать_имя(т, н, "имя функции после «функ»")!
    перем имя = т_имя.значение
    перем метод_типа = ""
    пусть пт = параметры_типа(т, н)!
    н = пт.поз
    перем тип_сам = ""
    если знак(т, н, ".") {
        // метод собственного типа: функ Круг.площадь() -> дроб;
        // метод обобщённого типа: функ Пара<А, Б>.поменять() -> Пара<Б, А>
        н = взять(т, н)
        метод_типа = имя
        тип_сам = имя
        если пт.узел.поля.длина > 0 {
            перем имена: [стр] = []
            для п в пт.узел.поля { имена.добавить(п.текст) }
            тип_сам += "<" + имена.соединить(", ") + ">"
        }
        пусть т_метод = т[н]
        н = ожидать_имя(т, н, "имя метода после «" + метод_типа + ".»")!
        имя = т_метод.значение
        если знак(т, н, "<") {
            вернуть ошибка(на_месте(т[н], "метод не может иметь своих параметров типа; объявите обобщённую функцию: функ "
                + имя + "<...>(значение: " + метод_типа + ", ...)"))
        }
    }
    н = ожидать_знак(т, н, "(", " после имени функции")!
    перем параметры: [Узел] = []
    перем имена: [стр] = []
    если метод_типа != "" {
        параметры.добавить(параметр_с_именем("сам", тип_сам, т_имя))
        имена.добавить("сам")
    }
    если не знак(т, н, ")") {
        пока истина {
            пусть ток = т[н]
            н = ожидать_имя(т, н, "имя параметра")!
            н = ожидать_знак(т, н, ":", " и тип после параметра «" + ток.значение + "» (например, «" + ток.значение + ": цел»)")!
            пусть тп = тип_(т, н, "название типа")!
            н = тп.поз
            если имена.содержит(ток.значение) {
                если ток.значение != "сам" {
                    вернуть ошибка(на_месте(ток, "параметр «" + ток.значение + "» указан дважды"))
                }
                вернуть ошибка(на_месте(ток, "«сам» - значение, у которого вызван метод; объявлять его не нужно"))
            }
            имена.добавить(ток.значение)
            параметры.добавить(параметр(ток, тп.текст))
            если знак(т, н, ",") {
                н = взять(т, н)
                если знак(т, н, ")") { прервать }      // запятая после последнего параметра
                продолжить
            }
            прервать
        }
    }
    н = ожидать_знак(т, н, ")", " после списка параметров")!
    перем простые = [простое("имя", имя)]
    если знак(т, н, "->") или начало_типа_результата(т, н) {
        если знак(т, н, "->") { н = взять(т, н) }
        если знак(т, н, "!") {
            // -> ! : функция ничего не возвращает, но может завершиться ошибкой
            н = взять(т, н)
            простые.добавить(простое("тип_результата", "пусто!"))
        } иначе {
            пусть р = тип_(т, н, "тип результата после «->»")!
            н = р.поз
            простые.добавить(простое("тип_результата", р.текст))
        }
    }
    если метод_типа != "" { простые.добавить(простое("метод_типа", метод_типа)) }
    пусть тело = блок(т, н, " перед телом функции")!
    вернуть Итог(узел("Функция", простые, [группа("параметры", параметры), одно("тело", тело.узел), пт.узел], начало),
                 тело.поз)
}

функ разбор_внешней(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    перем н = взять(т, поз)
    если т[н].вид != "СТРОКА" {
        вернуть ошибка(на_месте(т[н], "после «внешняя» пишется название библиотеки C в кавычках: внешняя \"m\" { ... } "
            + "(пустые кавычки - функции стандартной библиотеки C)"))
    }
    пусть библиотека = т[н].значение
    н = взять(т, н)
    пусть открытие = т[н]
    н = ожидать_знак(т, н, "{", " после названия библиотеки")!
    перем функции: [Узел] = []
    пока истина {
        н = пропустить_концы(т, н)
        если знак(т, н, "}") {
            н = взять(т, н)
            прервать
        }
        если это(т, н, "КОНЕЦ_ФАЙЛА") {
            вернуть ошибка(на_месте(открытие, "описание внешней библиотеки не закрыто: не хватает «}»"))
        }
        если не ключ(т, н, "функ") {
            вернуть ошибка(на_месте(т[н], "во внешней библиотеке перечисляются функции: функ имя(параметры) -> тип"))
        }
        пусть т_функ = т[н]
        н = взять(т, н)
        пусть т_имя = т[н]
        н = ожидать_имя(т, н, "имя функции")!
        н = ожидать_знак(т, н, "(", " после имени функции")!
        пусть пар = простые_параметры(т, н)!
        н = пар.поз
        перем простые = [простое("имя", т_имя.значение)]
        если знак(т, н, "->") {
            н = взять(т, н)
            пусть р = тип_(т, н, "тип результата после «->»")!
            н = р.поз
            простые.добавить(простое("тип_результата", р.текст))
        }
        перем имя_c = т_имя.значение
        если знак(т, н, "=") {
            н = взять(т, н)
            если т[н].вид != "СТРОКА" {
                вернуть ошибка(на_месте(т[н], "после «=» пишется имя функции в библиотеке C в кавычках: = \"cbrt\""))
            }
            имя_c = т[н].значение
            н = взять(т, н)
        }
        простые.добавить(простое("имя_c", имя_c))
        функции.добавить(узел("ВнешняяФункция", простые, [пар.узел], т_функ))
    }
    вернуть Итог(узел("ВнешнийБлок", [простое("библиотека", библиотека)], [группа("функции", функции)], начало), н)
}

функ разбор_интерфейса(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    перем н = взять(т, поз)
    пусть т_имя = т[н]
    н = ожидать_имя(т, н, "название интерфейса после «интерфейс»")!
    пусть открытие = т[н]
    н = ожидать_знак(т, н, "{", " после названия интерфейса «" + т_имя.значение + "»")!
    перем методы: [Узел] = []
    перем имена: [стр] = []
    пока истина {
        н = пропустить_концы(т, н)
        если знак(т, н, "}") {
            н = взять(т, н)
            прервать
        }
        если это(т, н, "КОНЕЦ_ФАЙЛА") {
            вернуть ошибка(на_месте(открытие, "описание интерфейса «" + т_имя.значение + "» не закрыто: не хватает «}»"))
        }
        если не ключ(т, н, "функ") {
            вернуть ошибка(на_месте(т[н], "в интерфейсе перечисляются методы: функ имя(параметры) -> тип"))
        }
        пусть т_функ = т[н]
        н = взять(т, н)
        пусть имя = т[н].значение
        н = ожидать_имя(т, н, "имя метода")!
        н = ожидать_знак(т, н, "(", " после имени метода")!
        пусть пар = простые_параметры(т, н)!
        н = пар.поз
        перем простые = [простое("имя", имя)]
        если знак(т, н, "->") {
            н = взять(т, н)
            пусть р = тип_(т, н, "тип результата после «->»")!
            н = р.поз
            простые.добавить(простое("тип_результата", р.текст))
        }
        если имена.содержит(имя) { вернуть ошибка(на_месте(т_функ, "метод «" + имя + "» указан дважды")) }
        имена.добавить(имя)
        методы.добавить(узел("МетодИнтерфейса", простые, [пар.узел], т_функ))
    }
    если методы.длина == 0 {
        вернуть ошибка(на_месте(начало, "в интерфейсе «" + т_имя.значение + "» нет ни одного метода"))
    }
    вернуть Итог(узел("ОбъявлениеИнтерфейса", [простое("имя", т_имя.значение), простое("написание", т_имя.написание)],
                      [группа("методы", методы)], начало), н)
}

функ объявление_типа(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    перем н = взять(т, поз)
    пусть т_имя = т[н]
    н = ожидать_имя(т, н, "название типа после «тип»")!
    пусть имя = т_имя.значение
    пусть пт = параметры_типа(т, н)!
    н = пт.поз
    пусть открытие = т[н]
    н = ожидать_знак(т, н, "{", " после названия типа «" + имя + "»")!
    // перечисление: внутри не поля «имя: тип», а варианты «Имя(...)» или «Имя»
    пусть после = пропустить_концы(т, н)
    если т[после].вид == "ИМЯ" и не знак_токена(след(т, после, 1), ":") {
        вернуть варианты(т, после, начало, т_имя, открытие, пт.узел)
    }
    перем поля: [Узел] = []
    перем имена: [стр] = []
    пока истина {
        пока это(т, н, "КОНЕЦ_СТРОКИ") или знак(т, н, ",") { н = взять(т, н) }
        если знак(т, н, "}") {
            н = взять(т, н)
            прервать
        }
        если это(т, н, "КОНЕЦ_ФАЙЛА") {
            вернуть ошибка(на_месте(открытие, "описание типа «" + имя + "» не закрыто: не хватает «}» для скобки, открытой в строке "
                + стр(открытие.строка)))
        }
        пусть ток = т[н]
        н = ожидать_имя(т, н, "имя поля типа «" + имя + "»")!
        если имена.содержит(ток.значение) { вернуть ошибка(на_месте(ток, "поле «" + ток.значение + "» указано дважды")) }
        имена.добавить(ток.значение)
        н = ожидать_знак(т, н, ":", " и тип после поля «" + ток.значение + "» (например, «" + ток.значение + ": стр»)")!
        пусть тп = тип_(т, н, "тип поля")!
        н = тп.поз
        перем вложенные: [Узел] = []
        если знак(т, н, "=") {
            н = взять(т, н)
            пусть зн = выражение(т, н, ложь)!
            н = зн.поз
            вложенные.добавить(одно("по_умолчанию", зн.узел))
        }
        поля.добавить(узел("ПолеТипа", [простое("имя", ток.значение), простое("тип", тп.текст),
                                       простое("написание", ток.написание)], вложенные, ток))
        если не (это(т, н, "КОНЕЦ_СТРОКИ") или знак(т, н, ",") или знак(т, н, "}")) {
            вернуть ошибка(на_месте(т[н], "после поля «" + ток.значение + "» ожидался перевод строки, «,» или «}», а найдено "
                + описать(т[н])))
        }
    }
    если поля.длина == 0 { вернуть ошибка(на_месте(начало, "у типа «" + имя + "» должно быть хотя бы одно поле")) }
    вернуть Итог(узел("ОбъявлениеТипа", [простое("имя", имя), простое("написание", т_имя.написание)],
                      [группа("поля", поля), пт.узел], начало), н)
}

функ варианты(т: [лексер.Токен], поз: цел, начало: лексер.Токен, т_имя: лексер.Токен, открытие: лексер.Токен,
              пт: Узел) -> Итог! {
    перем н = поз
    перем список_: [Узел] = []
    перем имена: [стр] = []
    пока истина {
        пока это(т, н, "КОНЕЦ_СТРОКИ") или знак(т, н, ",") { н = взять(т, н) }
        если знак(т, н, "}") {
            н = взять(т, н)
            прервать
        }
        если это(т, н, "КОНЕЦ_ФАЙЛА") {
            вернуть ошибка(на_месте(открытие, "описание типа «" + т_имя.значение + "» не закрыто: не хватает «}»"))
        }
        пусть ток = т[н]
        н = ожидать_имя(т, н, "название варианта типа «" + т_имя.значение + "»")!
        если имена.содержит(ток.значение) { вернуть ошибка(на_месте(ток, "вариант «" + ток.значение + "» указан дважды")) }
        имена.добавить(ток.значение)
        перем поля: [Узел] = []
        перем имена_полей: [стр] = []
        если знак(т, н, "(") {
            н = взять(т, н)
            пока не знак(т, н, ")") {
                пусть п = т[н]
                н = ожидать_имя(т, н, "имя поля варианта «" + ток.значение + "»")!
                н = ожидать_знак(т, н, ":", " и тип после поля «" + п.значение + "»")!
                пусть тп = тип_(т, н, "тип поля")!
                н = тп.поз
                если имена_полей.содержит(п.значение) { вернуть ошибка(на_месте(п, "поле «" + п.значение + "» указано дважды")) }
                имена_полей.добавить(п.значение)
                поля.добавить(узел("ПолеТипа", [простое("имя", п.значение), простое("тип", тп.текст),
                                               простое("написание", п.написание)], [], п))
                если знак(т, н, ",") {
                    н = взять(т, н)
                } иначе если не знак(т, н, ")") {
                    вернуть ошибка(на_месте(т[н], "ожидалась «,» или «)» в полях варианта, а найдено " + описать(т[н])))
                }
            }
            н = взять(т, н)
        }
        список_.добавить(узел("ВариантТипа", [простое("имя", ток.значение), простое("написание", ток.написание)],
                              [группа("поля", поля)], ток))
    }
    вернуть Итог(узел("ОбъявлениеВариантов", [простое("имя", т_имя.значение), простое("написание", т_имя.написание)],
                      [группа("варианты", список_), пт], начало), н)
}

функ подключение(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    перем н = взять(т, поз)
    если т[н].вид != "СТРОКА" {
        вернуть ошибка(на_месте(т[н], "после «подключить» пишется путь к файлу в кавычках: подключить \"расчёты.dan\""))
    }
    перем простые = [простое("путь", т[н].значение)]
    н = взять(т, н)
    перем написание = ""
    если ключ(т, н, "как") {
        н = взять(т, н)
        пусть ток = т[н]
        н = ожидать_имя(т, н, "имя модуля после «как»")!
        простые.добавить(простое("имя", ток.значение))
        написание = ток.написание
    }
    перем у = узел("Подключение", простые, [], начало)
    у.написание = написание
    вернуть Итог(у, н)
}

функ разбор_выбора(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    пусть зн = выражение(т, взять(т, поз), ложь)!
    перем н = зн.поз
    пусть открытие = т[н]
    н = ожидать_знак(т, н, "{", " после значения в «выбор»")!
    перем ветви: [Узел] = []
    перем иначе_: [Узел] = []
    пока истина {
        н = пропустить_концы(т, н)
        если знак(т, н, "}") {
            н = взять(т, н)
            прервать
        }
        если это(т, н, "КОНЕЦ_ФАЙЛА") { вернуть ошибка(на_месте(открытие, "«выбор» не закрыт: не хватает «}»")) }
        если ключ(т, н, "иначе") {
            пусть ток = т[н]
            если иначе_.длина > 0 { вернуть ошибка(на_месте(ток, "ветвь «иначе» в «выбор» может быть только одна")) }
            пусть б = блок(т, взять(т, н), " после «иначе» в «выбор»")!
            иначе_.добавить(б.узел)
            н = б.поз
            продолжить
        }
        если иначе_.длина > 0 { вернуть ошибка(на_месте(т[н], "ветвь «иначе» должна быть последней в «выбор»")) }
        пусть ветвь_начало = т[н]
        перем образцы: [Узел] = []
        пусть первый = образец(т, н)!
        образцы.добавить(первый.узел)
        н = первый.поз
        пока знак(т, н, ",") {
            пусть ещё = образец(т, взять(т, н))!
            образцы.добавить(ещё.узел)
            н = ещё.поз
        }
        пусть тело = блок(т, н, " после образца в «выбор»")!
        н = тело.поз
        ветви.добавить(узел("ВетвьВыбора", [], [группа("образцы", образцы), одно("тело", тело.узел)], ветвь_начало))
    }
    если ветви.длина == 0 и иначе_.длина == 0 { вернуть ошибка(на_месте(начало, "в «выбор» нет ни одной ветви")) }
    вернуть Итог(узел("Выбор", [], [одно("значение", зн.узел), группа("ветви", ветви), группа("иначе", иначе_)], начало), н)
}

функ образец(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть ток = т[поз]
    если ток.вид == "ИМЯ" и не знак_токена(след(т, поз, 1), "..") {
        пусть имя = составное_имя(т, поз, "вариант")!
        перем н = имя.поз
        перем привязки: [Узел] = []
        если знак(т, н, "(") {
            н = взять(т, н)
            пока не знак(т, н, ")") {
                пусть п = т[н]
                н = ожидать_имя(т, н, "имя для поля варианта (или «_»)")!
                привязки.добавить(элемент(п.значение))
                если знак(т, н, ",") {
                    н = взять(т, н)
                } иначе если не знак(т, н, ")") {
                    вернуть ошибка(на_месте(т[н], "ожидалась «,» или «)», а найдено " + описать(т[н])))
                }
            }
            н = взять(т, н)
        }
        вернуть Итог(узел("ОбразецВарианта", [простое("имя", имя.текст)], [группа("привязки", привязки)], ток), н)
    }
    // значение: число, строка, логическое значение или диапазон из них
    вернуть диапазон(т, поз, ложь)
}

функ объявление(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    перем н = взять(т, поз)
    пусть т_имя = т[н]
    н = ожидать_имя(т, н, "имя переменной после «" + начало.значение + "»")!
    перем простые = [простое("имя", т_имя.значение), сырое("изменяемая", лог_питон(начало.значение == "перем"))]
    если знак(т, н, ":") {
        н = взять(т, н)
        пусть тп = тип_(т, н, "название типа")!
        н = тп.поз
        простые.добавить(простое("тип", тп.текст))
    }
    н = ожидать_знак(т, н, "=", ": переменной «" + т_имя.значение + "» нужно сразу задать значение")!
    пусть зн = выражение(т, н, ложь)!
    вернуть Итог(узел("ОбъявлениеПеременной", простые, [одно("значение", зн.узел)], начало), зн.поз)
}

функ разбор_если(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    перем н = взять(т, поз)
    если имя_слово(т, н, "ошибка") и след(т, н, 1).вид == "ИМЯ" и знак_токена(след(т, н, 2), "=") {
        // если ошибка о = значение { ... }
        пусть имя = след(т, н, 1).значение
        н = взять(т, взять(т, взять(т, н)))
        пусть зн = выражение(т, н, ложь)!
        пусть тогда = блок(т, зн.поз, " после «если ошибка " + имя + " = ...»")!
        пусть ин = иначе_после_если(т, тогда.поз)!
        вернуть Итог(узел("ЕслиОшибка", [простое("имя", имя)],
                          [одно("значение", зн.узел), одно("тогда", тогда.узел), группа("иначе", ин.узел.поля)], начало), ин.поз)
    }
    если ключ(т, н, "пусть") {
        // если пусть имя = значение { ... }: значение необязательного типа есть
        н = взять(т, н)
        пусть т_имя = т[н]
        н = ожидать_имя(т, н, "имя после «если пусть»")!
        пусть имя = т_имя.значение
        н = ожидать_знак(т, н, "=", " после «если пусть " + имя + "»")!
        пусть зн = выражение(т, н, ложь)!
        пусть тогда = блок(т, зн.поз, " после «если пусть " + имя + " = ...»")!
        н = тогда.поз
        // иначе ошибка о { ... }: в ветви доступен текст ошибки
        пусть после = пропустить_концы(т, н)
        если ключ(т, после, "иначе") и имя_слово(т, после + 1, "ошибка") и след(т, после, 2).вид == "ИМЯ" {
            пусть имя_ошибки = след(т, после, 2).значение
            пусть ин = блок(т, после + 3, " после «иначе ошибка " + имя_ошибки + "»")!
            вернуть Итог(узел("ЕслиЕсть", [простое("имя", имя), простое("имя_ошибки", имя_ошибки)],
                              [одно("значение", зн.узел), одно("тогда", тогда.узел), одно("иначе", ин.узел)], начало), ин.поз)
        }
        пусть ин = иначе_после_если(т, н)!
        вернуть Итог(узел("ЕслиЕсть", [простое("имя", имя)],
                          [одно("значение", зн.узел), одно("тогда", тогда.узел), группа("иначе", ин.узел.поля)], начало), ин.поз)
    }
    пусть условие = выражение(т, н, ложь)!
    пусть тогда = блок(т, условие.поз, " после условия «если»")!
    пусть ин = иначе_после_если(т, тогда.поз)!
    вернуть Итог(узел("Если", [], [одно("условие", условие.узел), одно("тогда", тогда.узел), группа("иначе", ин.узел.поля)],
                      начало), ин.поз)
}

/// Ветвь «иначе» после «если»: группа из одного узла (Блок или Если) или пустая.
функ иначе_после_если(т: [лексер.Токен], поз: цел) -> Итог! {
    // «иначе» может стоять на той же строке после «}» или на следующей
    пусть после = пропустить_концы(т, поз)
    если ключ(т, после, "иначе") {
        пусть н = взять(т, после)
        если ключ(т, н, "если") {
            пусть вложенное = разбор_если(т, н)!
            вернуть Итог(группа("иначе", [вложенное.узел]), вложенное.поз)
        }
        пусть б = блок(т, н, " или «если» после «иначе»")!
        вернуть Итог(группа("иначе", [б.узел]), б.поз)
    }
    вернуть Итог(группа("иначе", []), поз)
}

функ разбор_пока(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    перем н = взять(т, поз)
    если ключ(т, н, "пусть") {
        // пока пусть имя = значение { ... }: записывается как
        // «пока истина { если пусть имя = значение { ... } иначе { прервать } }»
        н = взять(т, н)
        пусть т_имя = т[н]
        н = ожидать_имя(т, н, "имя после «пока пусть»")!
        пусть имя = т_имя.значение
        н = ожидать_знак(т, н, "=", " после «пока пусть " + имя + "»")!
        пусть зн = выражение(т, н, ложь)!
        пусть тело = блок(т, зн.поз, " после «пока пусть " + имя + " = ...»")!
        пусть выход = узел("Блок", [], [группа("инструкции", [узел("Прервать", [], [], начало)])], начало)
        пусть проверка = узел("ЕслиЕсть", [простое("имя", имя)],
                              [одно("значение", зн.узел), одно("тогда", тело.узел), одно("иначе", выход)], начало)
        пусть условие = узел("Логическое", [сырое("значение", "True")], [], начало)
        пусть блок_ = узел("Блок", [], [группа("инструкции", [проверка])], начало)
        вернуть Итог(узел("Пока", [], [одно("условие", условие), одно("тело", блок_)], начало), тело.поз)
    }
    пусть условие = выражение(т, н, ложь)!
    пусть тело = блок(т, условие.поз, " после условия «пока»")!
    вернуть Итог(узел("Пока", [], [одно("условие", условие.узел), одно("тело", тело.узел)], начало), тело.поз)
}

функ разбор_для(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    перем н = взять(т, поз)
    пусть т_имя = т[н]
    н = ожидать_имя(т, н, "имя переменной цикла после «для»")!
    если не ключ(т, н, "в") {
        вернуть ошибка(на_месте(т[н], "ожидалось «в» после «для " + т_имя.значение + "», а найдено " + описать(т[н])))
    }
    пусть источник = выражение(т, взять(т, н), ложь)!
    пусть тело = блок(т, источник.поз, " перед телом цикла")!
    вернуть Итог(узел("Для", [простое("переменная", т_имя.значение)],
                      [одно("источник", источник.узел), одно("тело", тело.узел)], начало), тело.поз)
}

функ разбор_вернуть(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    пусть н = взять(т, поз)
    если это(т, н, "КОНЕЦ_СТРОКИ") или знак(т, н, "}") или это(т, н, "КОНЕЦ_ФАЙЛА") {
        вернуть Итог(узел("Вернуть", [], [], начало), н)
    }
    пусть зн = выражение(т, н, ложь)!
    вернуть Итог(узел("Вернуть", [], [одно("значение", зн.узел)], начало), зн.поз)
}

функ выражение_или_присваивание(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    пусть выр = выражение(т, поз, ложь)!
    перем н = выр.поз
    если знак_из(т, н, ["=", "+=", "-=", "*=", "/="]) {
        пусть оп = т[н]
        пусть зн = выражение(т, взять(т, н), ложь)!
        пусть у = выр.узел
        выбор у.вид {
            "Имя" {
                перем присв = узел("Присваивание", [простое("имя", у.текст), простое("оператор", оп.значение)],
                                   [одно("значение", зн.узел)], начало)
                присв.написание = у.написание
                вернуть Итог(присв, зн.поз)
            }
            "Индекс" {
                вернуть Итог(узел("ПрисваиваниеЭлемента", [простое("оператор", оп.значение)],
                                  [одно("объект", часть(у, "объект")), одно("индекс", часть(у, "индекс")),
                                   одно("значение", зн.узел)], начало), зн.поз)
            }
            "Поле" {
                вернуть Итог(узел("ПрисваиваниеПоля", [простое("имя", у.текст), простое("оператор", оп.значение)],
                                  [одно("объект", часть(у, "объект")), одно("значение", зн.узел)], начало), зн.поз)
            }
            иначе {
                вернуть ошибка(на_месте(оп, "присваивать значение можно только переменной, элементу списка или полю"))
            }
        }
    }
    вернуть Итог(узел("Выражение", [], [одно("выражение", выр.узел)], начало), н)
}

// ---------- выражения ----------

функ выражение(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    вернуть иначе_выр(т, поз, кс)
}

/// а иначе б - самая слабая операция; выполняется справа налево.
функ иначе_выр(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    пусть зн = или_выр(т, поз, кс)!
    если ключ(т, зн.поз, "иначе") {
        пусть оп = т[зн.поз]
        пусть запасное = иначе_выр(т, взять(т, зн.поз), кс)!
        вернуть Итог(узел("Иначе", [], [одно("значение", зн.узел), одно("запасное", запасное.узел)], оп), запасное.поз)
    }
    вернуть зн
}

функ или_выр(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    пусть первый = и_выр(т, поз, кс)!
    перем левый = первый.узел
    перем н = первый.поз
    пока ключ(т, н, "или") {
        пусть оп = т[н]
        пусть правый = и_выр(т, взять(т, н), кс)!
        левый = бинарная("или", левый, правый.узел, оп)
        н = правый.поз
    }
    вернуть Итог(левый, н)
}

функ и_выр(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    пусть первый = не_выр(т, поз, кс)!
    перем левый = первый.узел
    перем н = первый.поз
    пока ключ(т, н, "и") {
        пусть оп = т[н]
        пусть правый = не_выр(т, взять(т, н), кс)!
        левый = бинарная("и", левый, правый.узел, оп)
        н = правый.поз
    }
    вернуть Итог(левый, н)
}

функ бинарная(оп: стр, левый: Узел, правый: Узел, т: лексер.Токен) -> Узел {
    вернуть узел("Бинарная", [простое("оператор", оп)], [одно("левый", левый), одно("правый", правый)], т)
}

функ не_выр(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    если ключ(т, поз, "не") {
        пусть оп = т[поз]
        пусть операнд = не_выр(т, взять(т, поз), кс)!
        вернуть Итог(узел("Унарная", [простое("оператор", "не")], [одно("операнд", операнд.узел)], оп), операнд.поз)
    }
    вернуть сравнение(т, поз, кс)
}

функ сравнение(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    пусть первый = диапазон(т, поз, кс)!
    перем н = первый.поз
    перем оп = ""
    перем т_оп = т[н]
    если знак_из(т, н, ["==", "!=", "<", "<=", ">", ">="]) {
        оп = т[н].значение
        н = взять(т, н)
    } иначе если имя_слово(т, н, "больше") или имя_слово(т, н, "меньше") {
        // сравнение словами (набирается в русской раскладке): больше, меньше, не больше, не меньше
        если т[н].значение == "больше" { оп = ">" } иначе { оп = "<" }
        н = взять(т, н)
    } иначе если ключ(т, н, "не") и след(т, н, 1).вид == "ИМЯ" и (след(т, н, 1).значение == "больше" или след(т, н, 1).значение == "меньше") {
        если след(т, н, 1).значение == "больше" { оп = "<=" } иначе { оп = ">=" }
        н = взять(т, взять(т, н))
    }
    если оп == "" { вернуть первый }
    пусть правый = диапазон(т, н, кс)!
    н = правый.поз
    если знак_из(т, н, ["==", "!=", "<", "<=", ">", ">="]) или имя_слово(т, н, "больше") или имя_слово(т, н, "меньше") {
        вернуть ошибка(на_месте(т[н], "сравнения нельзя записывать цепочкой; используйте «и», например: а < б и б < в"))
    }
    вернуть Итог(бинарная(оп, первый.узел, правый.узел, т_оп), н)
}

функ диапазон(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    пусть левый = сложение(т, поз, кс)!
    если знак(т, левый.поз, "..") {
        пусть оп = т[левый.поз]
        пусть правый = сложение(т, взять(т, левый.поз), кс)!
        вернуть Итог(узел("Диапазон", [], [одно("начало", левый.узел), одно("конец", правый.узел)], оп), правый.поз)
    }
    вернуть левый
}

функ сложение(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    пусть первый = умножение(т, поз, кс)!
    перем левый = первый.узел
    перем н = первый.поз
    пока знак(т, н, "+") или знак(т, н, "-") {
        пусть оп = т[н]
        пусть правый = умножение(т, взять(т, н), кс)!
        левый = бинарная(оп.значение, левый, правый.узел, оп)
        н = правый.поз
    }
    вернуть Итог(левый, н)
}

функ умножение(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    пусть первый = унарный(т, поз, кс)!
    перем левый = первый.узел
    перем н = первый.поз
    // двоеточие внутри выражения - деление, как в школьной записи: 10 : 2
    пока знак_из(т, н, ["*", "/", "%"]) или (знак(т, н, ":") и не кс) {
        пусть оп = т[н]
        перем з = оп.значение
        если з == ":" { з = "/" }
        пусть правый = унарный(т, взять(т, н), кс)!
        левый = бинарная(з, левый, правый.узел, оп)
        н = правый.поз
    }
    вернуть Итог(левый, н)
}

функ унарный(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    если знак(т, поз, "-") {
        пусть оп = т[поз]
        пусть операнд = унарный(т, взять(т, поз), кс)!
        вернуть Итог(узел("Унарная", [простое("оператор", "-")], [одно("операнд", операнд.узел)], оп), операнд.поз)
    }
    вернуть степень(т, поз, кс)
}

/// а ^ н: раньше унарного минуса (-2^2 = -4) и справа налево (2^3^2 = 2^9).
функ степень(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    пусть основание = постфикс(т, поз, кс)!
    если знак(т, основание.поз, "^") {
        пусть оп = т[основание.поз]
        пусть показатель = унарный(т, взять(т, основание.поз), кс)!
        вернуть Итог(бинарная("^", основание.узел, показатель.узел, оп), показатель.поз)
    }
    вернуть основание
}

функ постфикс(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    пусть первое = первичное(т, поз, кс)!
    перем выр = первое.узел
    перем н = первое.поз
    пока истина {
        если знак(т, н, "(") {
            пусть скобка = т[н]
            н = взять(т, н)
            перем аргументы: [Узел] = []
            перем имена: [Узел] = []
            перем есть_имена = ложь
            перем имена_текстом: [стр] = []
            если не знак(т, н, ")") {
                пока истина {
                    // именованный аргумент: имя = значение
                    если т[н].вид == "ИМЯ" и знак_токена(след(т, н, 1), "=") {
                        пусть ток = т[н]
                        н = взять(т, взять(т, н))
                        если имена_текстом.содержит(ток.значение) {
                            вернуть ошибка(на_месте(ток, "аргумент «" + ток.значение + "» указан дважды"))
                        }
                        имена_текстом.добавить(ток.значение)
                        имена.добавить(элемент(ток.значение))
                        есть_имена = истина
                    } иначе {
                        если есть_имена {
                            вернуть ошибка(на_месте(т[н], "после именованных аргументов («имя = значение») "
                                + "позиционные указывать нельзя"))
                        }
                        имена.добавить(элемент_сырой("None"))
                    }
                    пусть арг = выражение(т, н, ложь)!
                    аргументы.добавить(арг.узел)
                    н = арг.поз
                    если не знак(т, н, ",") { прервать }
                    н = взять(т, н)
                    если знак(т, н, ")") { прервать }       // запятая после последнего аргумента
                }
            }
            н = ожидать_знак(т, н, ")", " после аргументов функции")!
            если не есть_имена { имена = [] }
            выр = узел("Вызов", [], [одно("функция", выр), группа("аргументы", аргументы), группа("имена", имена)], скобка)
        } иначе если знак(т, н, "[") {
            пусть скобка = т[н]
            пусть индекс = выражение(т, взять(т, н), ложь)!
            н = ожидать_знак(т, индекс.поз, "]", " после индекса")!
            выр = узел("Индекс", [], [одно("объект", выр), одно("индекс", индекс.узел)], скобка)
        } иначе если знак(т, н, "№") {
            // номер элемента без латинской раскладки: оценки№0, строка№(к + 1), с№(1..3)
            пусть з = т[н]
            н = взять(т, н)
            перем индекс = Узел("?")
            если знак(т, н, "(") {
                пусть и_ = выражение(т, взять(т, н), ложь)!
                н = ожидать_знак(т, и_.поз, ")", " после номера элемента")!
                индекс = и_.узел
            } иначе {
                пусть и_ = первичное(т, н, ложь)!
                н = и_.поз
                индекс = и_.узел
            }
            выр = узел("Индекс", [], [одно("объект", выр), одно("индекс", индекс)], з)
        } иначе если знак(т, н, "!") {
            пусть з = т[н]
            н = взять(т, н)
            выр = узел("Передать", [], [одно("значение", выр)], з)
        } иначе если знак(т, н, ".") {
            пусть точка = т[н]
            н = взять(т, н)
            пусть т_имя = т[н]
            н = ожидать_имя(т, н, "имя после точки")!
            перем поле = узел("Поле", [простое("имя", т_имя.значение)], [одно("объект", выр)], точка)
            поле.текст = т_имя.значение
            выр = поле
        } иначе {
            вернуть Итог(выр, н)
        }
    }
    вернуть Итог(выр, н)
}

функ лямбда(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть начало = т[поз]
    перем н = ожидать_знак(т, взять(т, поз), "(", " после «функ»: безымянная функция записывается как функ(х: цел) = х * 2")!
    перем параметры: [Узел] = []
    перем имена: [стр] = []
    пока не знак(т, н, ")") {
        пусть ток = т[н]
        н = ожидать_имя(т, н, "имя параметра")!
        перем тип_записью = ""
        если знак(т, н, ":") {
            пусть тп = тип_(т, взять(т, н), "тип параметра")!
            тип_записью = тп.текст
            н = тп.поз
        }
        если имена.содержит(ток.значение) { вернуть ошибка(на_месте(ток, "параметр «" + ток.значение + "» указан дважды")) }
        имена.добавить(ток.значение)
        параметры.добавить(параметр(ток, тип_записью))
        если знак(т, н, ",") {
            н = взять(т, н)
        } иначе если не знак(т, н, ")") {
            вернуть ошибка(на_месте(т[н], "ожидалась «,» или «)» в параметрах, а найдено " + описать(т[н])))
        }
    }
    н = взять(т, н)
    перем простые: [Свойство] = []
    если знак(т, н, "->") {
        н = взять(т, н)
        если знак(т, н, "!") {
            н = взять(т, н)
            простые.добавить(простое("тип_результата", "пусто!"))
        } иначе {
            пусть р = тип_(т, н, "тип результата после «->»")!
            н = р.поз
            простые.добавить(простое("тип_результата", р.текст))
        }
    }
    если знак(т, н, "=") {
        пусть выр = выражение(т, взять(т, н), ложь)!
        вернуть Итог(узел("Лямбда", простые, [группа("параметры", параметры), одно("выражение", выр.узел)], начало), выр.поз)
    }
    пусть тело = блок(т, н, " или «=» после параметров безымянной функции")!
    вернуть Итог(узел("Лямбда", простые, [группа("параметры", параметры), одно("тело", тело.узел)], начало), тело.поз)
}

функ словарь(т: [лексер.Токен], поз: цел) -> Итог! {
    пусть открытие = т[поз]
    перем н = взять(т, поз)
    перем ключи: [Узел] = []
    перем значения: [Узел] = []
    пока истина {
        н = пропустить_концы(т, н)
        если знак(т, н, "}") {
            н = взять(т, н)
            прервать
        }
        если это(т, н, "КОНЕЦ_ФАЙЛА") { вернуть ошибка(на_месте(открытие, "словарь не закрыт: не хватает «}»")) }
        пусть кл = выражение(т, н, истина)!
        н = ожидать_знак(т, кл.поз, ":", " между ключом и значением словаря")!
        пусть зн = выражение(т, н, ложь)!
        ключи.добавить(кл.узел)
        значения.добавить(зн.узел)
        н = пропустить_концы(т, зн.поз)
        если знак(т, н, ",") {
            н = взять(т, н)
        } иначе если не знак(т, н, "}") {
            вернуть ошибка(на_месте(т[н], "ожидалась «,» или «}» в словаре, а найдено " + описать(т[н])))
        }
    }
    вернуть Итог(узел("Словарь", [], [группа("ключи", ключи), группа("значения", значения)], открытие), н)
}

функ словарь_в_скобках(т: [лексер.Токен], поз: цел, открытие: лексер.Токен, первый_ключ: Узел) -> Итог! {
    перем ключи = [первый_ключ]
    перем значения: [Узел] = []
    перем н = поз
    пока истина {
        н = ожидать_знак(т, н, "=", " между ключом и значением словаря: (\"а\" = 1, \"б\" = 2)")!
        пусть зн = выражение(т, н, ложь)!
        значения.добавить(зн.узел)
        н = зн.поз
        если не знак(т, н, ",") { прервать }
        н = взять(т, н)
        если знак(т, н, ")") { прервать }
        пусть кл = выражение(т, н, ложь)!
        ключи.добавить(кл.узел)
        н = кл.поз
    }
    н = ожидать_знак(т, н, ")", " после словаря")!
    вернуть Итог(узел("Словарь", [], [группа("ключи", ключи), группа("значения", значения)], открытие), н)
}

функ первичное(т: [лексер.Токен], поз: цел, кс: лог) -> Итог! {
    пусть ток = т[поз]
    пусть н = взять(т, поз)
    выбор ток.вид {
        "ЦЕЛОЕ" { вернуть Итог(узел("ЦелоеЧисло", [сырое("значение", ток.значение)], [], ток), н) }
        "ДРОБНОЕ" { вернуть Итог(узел("ДробноеЧисло", [сырое("значение", дробное_питон(ток.значение))], [], ток), н) }
        "СТРОКА" { вернуть Итог(узел("Строка", [простое("значение", ток.значение)], [], ток), н) }
        "ИМЯ" {
            перем имя = узел("Имя", [простое("имя", ток.значение)], [], ток)
            имя.текст = ток.значение
            имя.написание = ток.написание
            вернуть Итог(имя, н)
        }
        иначе { }
    }
    если ключ(т, поз, "истина") или ключ(т, поз, "ложь") {
        вернуть Итог(узел("Логическое", [сырое("значение", лог_питон(ток.значение == "истина"))], [], ток), н)
    }
    если ключ(т, поз, "ничего") { вернуть Итог(узел("Ничего", [], [], ток), н) }
    если ключ(т, поз, "функ") { вернуть лямбда(т, поз) }
    если ключ(т, поз, "запустить") {
        пусть вызов = постфикс(т, н, кс)!
        если вызов.узел.вид != "Вызов" {
            вернуть ошибка(на_месте(ток, "после «запустить» пишется вызов функции: запустить посчитать(данные)"))
        }
        вернуть Итог(узел("Запуск", [], [одно("вызов", вызов.узел)], ток), вызов.поз)
    }
    если знак(т, поз, "(") {
        // (выражение); без латинской раскладки ещё и список (1, 2, 3), (5,), () и словарь ("а" = 1), пустой словарь (=)
        если знак(т, н, ")") { вернуть Итог(узел("Список", [], [], ток), взять(т, н)) }
        если знак(т, н, "=") {
            пусть к = ожидать_знак(т, взять(т, н), ")", ": пустой словарь записывается как (=)")!
            вернуть Итог(узел("Словарь", [], [], ток), к)
        }
        пусть выр = выражение(т, н, ложь)!
        если знак(т, выр.поз, "=") { вернуть словарь_в_скобках(т, выр.поз, ток, выр.узел) }
        если знак(т, выр.поз, ",") {
            перем элементы = [выр.узел]
            перем м = выр.поз
            пока знак(т, м, ",") {
                м = взять(т, м)
                если знак(т, м, ")") { прервать }
                пусть эл = выражение(т, м, ложь)!
                элементы.добавить(эл.узел)
                м = эл.поз
            }
            м = ожидать_знак(т, м, ")", " после элементов списка")!
            вернуть Итог(узел("Список", [], [группа("элементы", элементы)], ток), м)
        }
        пусть к = ожидать_знак(т, выр.поз, ")", " для закрытия скобки")!
        вернуть Итог(выр.узел, к)
    }
    если знак(т, поз, "{") { вернуть словарь(т, поз) }
    если знак(т, поз, "[") {
        перем м = н
        перем элементы: [Узел] = []
        пока не знак(т, м, "]") {
            пусть эл = выражение(т, м, ложь)!
            элементы.добавить(эл.узел)
            м = эл.поз
            если знак(т, м, ",") {
                м = взять(т, м)
            } иначе если не знак(т, м, "]") {
                вернуть ошибка(на_месте(т[м], "ожидалась «,» или «]» в списке, а найдено " + описать(т[м])))
            }
        }
        вернуть Итог(узел("Список", [], [группа("элементы", элементы)], ток), взять(т, м))
    }
    если ток.вид == "КЛЮЧ" {
        вернуть ошибка(на_месте(ток, "ключевое слово «" + ток.значение + "» не может стоять внутри выражения"))
    }
    вернуть ошибка(на_месте(ток, "ожидалось значение, а найдено " + описать(ток)))
}
