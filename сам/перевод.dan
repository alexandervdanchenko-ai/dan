/// Программа сверки: код C, порождённый компилятором на Дане.
///
///     сам/перевод --версия=1.3 --редакции=2026 --библиотека=папка --среда=папка --разделитель=/
///                 [--отладка] [--тесты] [--профиль] программа.dan итог.c [...]
///
/// Для каждой пары «программа итог» загружает программу, проверяет её и записывает
/// код C в файл «итог»; при ошибках разбора или проверки - печатает «ОШИБКА путь».

подключить "модули"
подключить "проверка"
подключить "встроенные"
подключить "порождение"

перем настройки = модули.Настройки("")
перем порождение_ = порождение.Настройки()
перем файлы: [стр] = []
для а в аргументы() {
    если а.начинается("--версия=") {
        настройки.версия = а[9..а.длина - 1]
    } иначе если а.начинается("--редакции=") {
        настройки.редакции = а[11..а.длина - 1].разбить(",")
    } иначе если а.начинается("--библиотека=") {
        настройки.библиотека = а[13..а.длина - 1]
    } иначе если а.начинается("--среда=") {
        порождение_.среда = а[8..а.длина - 1]
    } иначе если а.начинается("--разделитель=") {
        настройки.разделитель = а[14..а.длина - 1]
        порождение_.разделитель = настройки.разделитель
    } иначе если а == "--отладка" {
        порождение_.отладка = истина
    } иначе если а == "--тесты" {
        порождение_.тесты = истина
    } иначе если а == "--профиль" {
        порождение_.профиль = истина
    } иначе {
        файлы.добавить(а)
    }
}
пусть таблицы = встроенные.таблицы()
перем н = 0
пока н + 1 < файлы.длина {
    пусть путь = файлы[н]
    пусть итог = файлы[н + 1]
    н += 2
    если пусть программа = модули.загрузить(прочитать(путь), путь, настройки) {
        пусть проверено = проверка.проверить(программа.дерево, таблицы)
        если проверено.ошибки.длина > 0 {
            вывод("ОШИБКА " + путь)
            продолжить
        }
        записать(итог, порождение.сгенерировать(проверено, программа.файлы, программа.тексты, порождение_))
    } иначе ошибка о {
        вывод("ОШИБКА " + путь)
    }
}
