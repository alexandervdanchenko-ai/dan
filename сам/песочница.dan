/// Песочница: страница в браузере, где можно написать программу на Дане и сразу выполнить
/// (команда «дан песочница», то же, что pesochnica.py компилятора на Python).
///
/// Сервер слушает только адрес 127.0.0.1 и отвечает только своей странице: она получает
/// случайный ключ, без которого программы не выполняются; запросы с чужим именем сервера в
/// заголовке Host (подмена имени, DNS rebinding) отклоняются. Запросы обслуживаются по одному.
/// Программа собирается так же, как командой «дан запустить», в отдельной временной папке; на
/// выполнение даётся 10 секунд, вывод ограничен мегабайтом.

подключить "страницы"
подключить "формат"
подключить "json"

/// Что песочнице нужно от компилятора (это знает дан.dan).
общий тип Среда {
    /// разделитель папок
    р: стр
    /// папка с примерами программ ("" - примеров нет)
    примеры: стр
    /// собрать программу: путь к файлу .dan -> путь к исполняемому файлу или текст ошибки
    собрать: функ(стр) -> стр!
    /// команда, открывающая адрес в браузере ("" - не открывать)
    браузер: стр
}

функ время() -> цел { вернуть 10 }

функ наибольший_вывод() -> цел { вернуть 1048576 }

функ windows(с: Среда) -> лог { вернуть с.р == "\\" }

функ в_кавычках(т: стр) -> стр { вернуть "\"" + т + "\"" }

функ для_оболочки(строка_: стр, с: Среда) -> стр {
    если windows(с) { вернуть "\"" + строка_ + "\"" }
    вернуть строка_
}

/// Случайный ключ из 32 знаков латиницы, цифр, «-» и «_» (случайные числа даёт система).
функ новый_ключ() -> стр {
    пусть знаки = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    перем ключ = ""
    для н в 1..32 { ключ += знаки[случайное(0, 63)] }
    вернуть ключ
}

/// Текст из байтов UTF-8; неверные последовательности заменяются знаком U+FFFD (как decode(errors="replace")).
общий функ текст_utf8(б: байты) -> стр {
    перем части: [стр] = []
    перем начало = 0
    перем н = 0
    пусть всего = б.длина
    пока н < всего {
        пусть п = б[н]
        перем длина = 0
        если п < 128 {
            длина = 1
        } иначе если п >= 194 и п <= 223 {
            длина = 2
        } иначе если п >= 224 и п <= 239 {
            длина = 3
        } иначе если п >= 240 и п <= 244 {
            длина = 4
        }
        перем верно = длина > 0 и н + длина <= всего
        если верно и длина > 1 {
            пусть второй = б[н + 1]
            перем нижняя = 128
            перем верхняя = 191
            если п == 224 { нижняя = 160 }
            если п == 237 { верхняя = 159 }
            если п == 240 { нижняя = 144 }
            если п == 244 { верхняя = 143 }
            если второй < нижняя или второй > верхняя { верно = ложь }
            для к в 2..длина - 1 {
                если б[н + к] < 128 или б[н + к] > 191 { верно = ложь }
            }
        }
        если верно {
            н += длина
        } иначе {
            если н > начало { части.добавить(стр(б[начало..н - 1])) }
            части.добавить(символ_по_коду(65533))
            // как Python: пропускается наибольшее начало верной последовательности, но хотя бы байт
            перем пропуск = 1
            если длина > 1 {
                перем к = 1
                пока к < длина и н + к < всего и б[н + к] >= 128 и б[н + к] <= 191 {
                    если к == 1 {
                        перем нижняя = 128
                        перем верхняя = 191
                        если п == 224 { нижняя = 160 }
                        если п == 237 { верхняя = 159 }
                        если п == 240 { нижняя = 144 }
                        если п == 244 { верхняя = 143 }
                        если б[н + к] < нижняя или б[н + к] > верхняя { прервать }
                    }
                    к += 1
                }
                пропуск = к
            }
            н += пропуск
            начало = н
        }
    }
    если всего > начало { части.добавить(стр(б[начало..всего - 1])) }
    вернуть части.соединить("")
}

/// Дробь с двумя знаками после запятой: 1,25.
общий функ секунды(с: дроб) -> стр {
    перем сотые = цел(округлить(с * 100.0))
    если сотые < 0 { сотые = 0 }
    пусть дробная = сотые % 100
    перем хвост = стр(дробная)
    если дробная < 10 { хвост = "0" + хвост }
    вернуть стр(частное(сотые, 100)) + "," + хвост
}

/// Вывод программы из файла: не больше мегабайта, «\r\n» -> «\n»; второе значение - обрезан ли.
общий функ прочитать_вывод(путь: стр) -> [стр] {
    если не существует(путь) { вернуть ["", ""] }
    перем б = прочитать_байты(путь)
    перем обрезан = ""
    если б.длина > наибольший_вывод() {
        б = б[0..наибольший_вывод() - 1]
        обрезан = "да"
    }
    вернуть [текст_utf8(б).заменить("\r\n", "\n"), обрезан]
}

функ поле(имя: стр, значение: стр) -> стр { вернуть строка_json(имя) + ": " + строка_json(значение) }

/// Удаляет временную папку командой системы: остановленная программа в Windows может ещё недолго
/// держать свои файлы, и неудача удаления не должна останавливать песочницу (папка остаётся в
/// папке временных файлов).
функ убрать_папку(папка: стр, с: Среда) {
    для попытка в 1..10 {
        если не существует(папка) { вернуть }
        если windows(с) {
            выполнить_команду(для_оболочки("rmdir /s /q " + в_кавычках(папка) + " >NUL 2>&1", с))
        } иначе {
            выполнить_команду("rm -rf '" + папка.заменить("'", "'\\''") + "' >/dev/null 2>&1")
        }
        если существует(папка) { пауза(0.3) }
    }
}

/// Собирает и выполняет программу во временной папке: ответ JSON для страницы.
функ выполнить(с: Среда, текст: стр, ввод_: стр) -> стр {
    пусть папка = создать_временную_папку()
    пусть путь = папка + с.р + "программа.dan"
    записать(путь, текст)
    перем начало = метка_времени()
    перем исполняемый = ""
    если пусть г = с.собрать(путь) {
        исполняемый = г
    } иначе ошибка о {
        убрать_папку(папка, с)
        вернуть "{" + [поле("вывод", ""), поле("ошибки", о), поле("состояние", "в программе ошибка")].соединить(", ") + "}"
    }
    пусть собрана = метка_времени() - начало
    пусть файл_ввода = папка + с.р + "ввод.txt"
    пусть файл_вывода = папка + с.р + "вывод.txt"
    пусть файл_ошибок = папка + с.р + "ошибки.txt"
    записать(файл_ввода, ввод_)
    перем строка_ = ""
    если windows(с) {
        строка_ = "cd /d " + в_кавычках(папка) + " && " + в_кавычках(исполняемый)
    } иначе {
        строка_ = "cd " + в_кавычках(папка) + " && " + в_кавычках(исполняемый)
    }
    строка_ += " <" + в_кавычках(файл_ввода) + " >" + в_кавычках(файл_вывода) + " 2>" + в_кавычках(файл_ошибок)
    начало = метка_времени()
    пусть код = выполнить_команду(для_оболочки(строка_, с), дроб(время()))
    пусть прошло = метка_времени() - начало
    пусть вывод_ = прочитать_вывод(файл_вывода)
    пусть ошибки = прочитать_вывод(файл_ошибок)
    убрать_папку(папка, с)
    перем текст_вывода = вывод_[0]
    если вывод_[1] != "" { текст_вывода += "\n... вывод длиннее мегабайта и показан не полностью\n" }
    перем состояние = ""
    если код == -1 {
        состояние = "программа остановлена: она работала дольше " + стр(время()) + " секунд"
    } иначе если код != 0 {
        состояние = "программа завершилась с кодом " + стр(код) + " (" + секунды(прошло) + " с)"
    } иначе {
        состояние = "готово: сборка " + секунды(собрана) + " с, выполнение " + секунды(прошло) + " с"
    }
    вернуть ("{" + [поле("вывод", текст_вывода), поле("ошибки", ошибки[0]), поле("состояние", состояние)].соединить(", ")
        + ", \"код\": " + стр(код) + "}")
}

функ список_примеров(с: Среда) -> [стр] {
    перем итог: [стр] = []
    если с.примеры == "" или не это_папка(с.примеры) { вернуть итог }
    для имя в список_файлов(с.примеры) {
        если имя.оканчивается(".dan") { итог.добавить(имя[0..имя.длина - 5]) }
    }
    вернуть итог
}

функ цифра16(п: цел) -> цел {
    если п >= 48 и п <= 57 { вернуть п - 48 }
    если п >= 65 и п <= 70 { вернуть п - 55 }
    если п >= 97 и п <= 102 { вернуть п - 87 }
    вернуть -1
}

/// Раскодирование «%D0%BF» в адресе (браузер кодирует русские буквы).
функ из_адреса(адрес: стр) -> стр {
    пусть б = байты(адрес)
    перем числа: [цел] = []
    перем н = 0
    пока н < б.длина {
        если б[н] == 37 и н + 2 < б.длина и цифра16(б[н + 1]) >= 0 и цифра16(б[н + 2]) >= 0 {
            числа.добавить(цифра16(б[н + 1]) * 16 + цифра16(б[н + 2]))
            н += 3
        } иначе {
            числа.добавить(б[н])
            н += 1
        }
    }
    вернуть текст_utf8(байты(числа))
}

/// Запрос HTTP: метод, путь, заголовки (имена строчными буквами) и тело.
тип Запрос {
    метод: стр = ""
    путь: стр = ""
    заголовки: {стр: стр} = {}
    тело: байты = байты("")
    /// "" - запрос прочитан; иначе причина, по которой он не принят
    ошибка: стр = ""
}

функ найти_конец_заголовков(б: байты) -> цел {
    если б.длина < 4 { вернуть -1 }
    для н в 0..б.длина - 4 {
        если б[н] == 13 и б[н + 1] == 10 и б[н + 2] == 13 и б[н + 3] == 10 { вернуть н }
    }
    вернуть -1
}

функ прочитать_запрос(соединение: цел) -> Запрос {
    перем з = Запрос()
    перем данные = байты("")
    перем конец = -1
    пока конец < 0 {
        пусть часть = прочитать_соединение(соединение, 65536)
        если часть.длина == 0 {
            з.ошибка = "соединение закрыто"
            вернуть з
        }
        данные = данные + часть
        конец = найти_конец_заголовков(данные)
        если конец < 0 и данные.длина > 65536 {
            з.ошибка = "слишком длинные заголовки"
            вернуть з
        }
    }
    пусть строки = текст_utf8(данные[0..конец - 1]).разбить("\r\n")
    пусть первая = строки[0].разбить()
    если первая.длина < 2 {
        з.ошибка = "неверный запрос"
        вернуть з
    }
    з.метод = первая[0]
    з.путь = первая[1]
    для к в 1..строки.длина - 1 {
        пусть н = строки[к].найти(":")
        если н > 0 {
            з.заголовки[строки[к][0..н - 1].обрезать().строчные()] = строки[к][н + 1..строки[к].длина - 1].обрезать()
        }
    }
    перем длина = 0
    если пусть д = з.заголовки.найти("content-length") {
        если пусть ч = разобрать_цел(д) { длина = ч } иначе ошибка о { длина = 0 }
    }
    если длина > 3 * наибольший_вывод() {
        з.ошибка = "слишком длинный запрос"
        вернуть з
    }
    перем тело = байты("")
    если данные.длина > конец + 4 { тело = данные[конец + 4..данные.длина - 1] }
    пока тело.длина < длина {
        пусть часть = прочитать_соединение(соединение, 65536)
        если часть.длина == 0 { прервать }
        тело = тело + часть
    }
    если тело.длина > длина {
        если длина == 0 { тело = байты("") } иначе { тело = тело[0..длина - 1] }
    }
    з.тело = тело
    вернуть з
}

функ ответить(соединение: цел, код: цел, тип_: стр, тело: стр) {
    перем причина = "OK"
    если код == 400 { причина = "Bad Request" }
    если код == 403 { причина = "Forbidden" }
    если код == 404 { причина = "Not Found" }
    пусть данные = байты(тело)
    пусть голова = ("HTTP/1.0 " + стр(код) + " " + причина + "\r\n"
        + "Content-Type: " + тип_ + "\r\n"
        + "Content-Length: " + стр(данные.длина) + "\r\n"
        + "Cache-Control: no-store\r\n"
        + "X-Content-Type-Options: nosniff\r\n"
        + "Content-Security-Policy: default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
        + "frame-ancestors 'none'\r\n"
        + "Connection: close\r\n\r\n")
    записать_соединение(соединение, байты(голова) + данные)
}

функ ответ_json(ключ: стр, значение: стр) -> стр { вернуть "{" + поле(ключ, значение) + "}" }

/// Имя сервера из заголовка Host без порта: только 127.0.0.1 и localhost - свой адрес.
функ свой_адрес(з: Запрос) -> лог {
    перем хост = з.заголовки.найти("host") иначе ""
    перем последнее = -1
    перем к = 0
    для знак в хост.символы() {
        если знак == ":" { последнее = к }
        к += 1
    }
    если последнее >= 0 { хост = хост[0..последнее - 1] }
    вернуть хост == "127.0.0.1" или хост == "localhost"
}

функ обслужить(с: Среда, соединение: цел, ключ: стр, страница: стр) {
    пусть з = прочитать_запрос(соединение)
    если з.ошибка == "соединение закрыто" { вернуть }
    если з.ошибка != "" {
        ответить(соединение, 400, "application/json", ответ_json("ошибка", з.ошибка))
        вернуть
    }
    если з.метод == "GET" {
        если не свой_адрес(з) {
            ответить(соединение, 403, "text/plain; charset=utf-8", "доступ только с этого компьютера")
        } иначе если з.путь == "/" или з.путь == "/index.html" {
            ответить(соединение, 200, "text/html; charset=utf-8", страница)
        } иначе {
            ответить(соединение, 404, "text/plain; charset=utf-8", "нет такой страницы")
        }
        вернуть
    }
    если з.метод != "POST" {
        ответить(соединение, 404, "text/plain; charset=utf-8", "нет такой страницы")
        вернуть
    }
    если не свой_адрес(з) или (з.заголовки.найти("x-dan-key") иначе "") != ключ {
        ответить(соединение, 403, "application/json", ответ_json("ошибка", "нет доступа"))
        вернуть
    }
    перем данные = json.Пусто
    перем текст_тела = текст_utf8(з.тело)
    если текст_тела.обрезать() == "" { текст_тела = "{}" }
    если пусть д = json.разобрать(текст_тела) {
        данные = д
    } иначе ошибка о {
        ответить(соединение, 400, "application/json", ответ_json("ошибка", о))
        вернуть
    }
    перем путь = з.путь
    пусть вопрос = путь.найти("?")
    если вопрос >= 0 {
        если вопрос == 0 { путь = "" } иначе { путь = путь[0..вопрос - 1] }
    }
    путь = из_адреса(путь)
    перем итог = ""
    если путь == "/выполнить" {
        итог = выполнить(с, данные.поле("текст").как_стр() иначе "", данные.поле("ввод").как_стр() иначе "")
    } иначе если путь == "/формат" {
        если пусть т = формат.отформатировать(данные.поле("текст").как_стр() иначе "") {
            итог = ответ_json("текст", т)
        } иначе ошибка о {
            итог = ответ_json("ошибка", "текст не приведён к единому виду: " + о)
        }
    } иначе если путь == "/примеры" {
        перем имена: [стр] = []
        для имя в список_примеров(с) { имена.добавить(строка_json(имя)) }
        итог = "{\"примеры\": [" + имена.соединить(", ") + "]}"
    } иначе если путь == "/пример" {
        пусть имя = данные.поле("имя").как_стр() иначе ""
        если список_примеров(с).содержит(имя) {
            итог = ответ_json("текст", прочитать(с.примеры + с.р + имя + ".dan"))
        } иначе {
            итог = ответ_json("ошибка", "нет такого примера")
        }
    } иначе {
        ответить(соединение, 404, "application/json", ответ_json("ошибка", "нет такого запроса"))
        вернуть
    }
    ответить(соединение, 200, "application/json; charset=utf-8", итог)
}

/// «дан песочница [--порт=8080] [--без-браузера]».
общий функ команда(аргументы: [стр], с: Среда) -> цел {
    перем порт = 8080
    перем браузер = истина
    для а в аргументы {
        если а.начинается("--порт=") {
            если пусть п = разобрать_цел(а[7..а.длина - 1]) {
                порт = п
            } иначе ошибка о {
                вывод("Порт - число, например --порт=8080")
                вернуть 2
            }
            если порт < 0 или порт > 65535 {
                вывод("Порт - число, например --порт=8080")
                вернуть 2
            }
        } иначе если а == "--без-браузера" {
            браузер = ложь
        } иначе {
            вывод(страницы.песочница_справка())
            вернуть 2
        }
    }
    перем слушатель = слушать_порт(порт)
    если слушатель < 0 {
        если порт == 8080 {
            слушатель = слушать_порт(0)               // порт занят: любой свободный
        }
        если слушатель < 0 {
            вывод("Порт " + стр(порт) + " занят; укажите другой: --порт=8081")
            вернуть 1
        }
    }
    пусть ключ = новый_ключ()
    пусть начало = строка_json(страницы.песочница_начало()).заменить("</", "<\\/")
    пусть страница = страницы.песочница_страница().заменить("__КЛЮЧ__", ключ).заменить("__НАЧАЛО__", начало)
    пусть адрес = "http://127.0.0.1:" + стр(порт_слушателя(слушатель)) + "/"
    вывод("Песочница Дана: " + адрес + "\nЧтобы остановить её, закройте это окно или нажмите Ctrl+C")
    если браузер и с.браузер != "" {
        выполнить_команду(с.браузер.заменить("@@АДРЕС@@", адрес))
    }
    пока истина {
        пусть соединение = принять_соединение(слушатель)
        если соединение < 0 {
            пауза(0.1)
            продолжить
        }
        обслужить(с, соединение, ключ, страница)
        закрыть_соединение(соединение)
    }
    вернуть 0
}
