/// Подключение модулей, написанное на Дане: третья часть компилятора на самом Дане.
///
/// Делает то же, что moduli.py: разбирает основную программу и все
/// подключённые файлы, даёт объявлениям модулей полные имена «модуль.имя»,
/// заменяет обращения «псевдоним.имя» полными именами и собирает всё в одно
/// дерево. Дерево и тексты ошибок совпадают с moduli.py (проверяет test_sam.py).
///
/// Функции Дана не меняют общих переменных, поэтому состояние загрузки
/// (загруженные модули, порядок, цепочка подключений) передаётся из функции
/// в функцию и возвращается обратно.

подключить "лексер"
подключить "разбор"

/// Где искать файлы и что знает компилятор.
общий тип Настройки {
    /// папка стандартной библиотеки
    библиотека: стр
    /// разделитель частей пути: "/" или "\"
    разделитель: стр = "/"
    редакции: [стр] = ["2026"]
    версия: стр = ""
}

тип Модуль {
    путь: стр
    номер: цел
    /// приставка полных имён ("" у основной программы)
    канон: стр
    /// имя объявления -> полное имя
    имена: {стр: стр} = {}
    /// имена, видимые снаружи
    общие: {стр: лог} = {}
    инструкции: [разбор.Узел] = []
    /// имя модуля в этом файле -> путь подключённого файла
    псевдонимы: {стр: стр} = {}
    /// имя модуля -> как оно написано (с «ё»)
    написания: {стр: стр} = {}
}

тип Загрузчик {
    настройки: Настройки
    каталог: стр
    основной: стр
    модули: {стр: Модуль} = {}
    /// модули в порядке готовности (зависимости раньше)
    порядок: [стр] = []
    /// цепочка загружаемых сейчас файлов
    в_работе: [стр] = []
    каноны: [стр] = []
    /// файлы программы для сообщений (номер - номер файла)
    файлы: [стр] = []
    /// тексты файлов в том же порядке (для отладчика)
    тексты: [стр] = []
}

/// Дерево всей программы и её файлы.
общий тип Программа {
    дерево: разбор.Узел
    файлы: [стр]
    тексты: [стр] = []
}

тип ИтогЗагрузки {
    загрузчик: Загрузчик
    путь: стр
}

тип ИтогПодготовки {
    загрузчик: Загрузчик
    модуль: Модуль
}

тип ИтогУзла {
    загрузчик: Загрузчик
    узел: разбор.Узел
}

// ---------- пути ----------

функ части_пути(путь: стр) -> [стр] {
    вернуть путь.заменить("\\", "/").разбить("/")
}

/// Путь без «.» и «..» (как os.path.normpath для полного пути).
функ нормализовать(путь: стр, р: стр) -> стр {
    пусть части = части_пути(путь)
    перем итог: [стр] = []
    перем н = 0
    для ч в части {
        если ч == "." или (ч == "" и н > 0) {
            н += 1
            продолжить
        }
        если ч == ".." и итог.длина > 1 {
            итог.удалить(итог.длина - 1)
        } иначе {
            итог.добавить(ч)
        }
        н += 1
    }
    пусть склеено = итог.соединить(р)
    если склеено == "" { вернуть р }
    вернуть склеено
}

функ папка_пути(путь: стр, р: стр) -> стр {
    пусть части = части_пути(путь)
    если части.длина <= 1 { вернуть "" }
    перем итог: [стр] = []
    для н в 0..части.длина - 2 { итог.добавить(части[н]) }
    пусть склеено = итог.соединить(р)
    если склеено == "" { вернуть р }
    вернуть склеено
}

функ имя_файла(путь: стр) -> стр {
    пусть части = части_пути(путь)
    вернуть части[части.длина - 1]
}

/// Имя файла без расширения.
функ основа_имени(путь: стр) -> стр {
    пусть имя = имя_файла(путь)
    пусть с = имя.символы()
    перем н = с.длина - 1
    пока н > 0 и с[н] != "." { н -= 1 }
    если н <= 0 { вернуть имя }
    вернуть имя[0..н - 1]
}

функ есть_расширение(путь: стр) -> лог {
    вернуть основа_имени(путь) != имя_файла(путь)
}

функ склеить(папка: стр, имя: стр, р: стр) -> стр {
    если папка.оканчивается(р) { вернуть папка + имя }
    вернуть папка + р + имя
}

/// Путь для сообщений: относительно папки основной программы.
функ показать_путь(з: Загрузчик, путь: стр) -> стр {
    пусть р = з.настройки.разделитель
    если нормализовать(папка_пути(путь, р), р) == нормализовать(з.настройки.библиотека, р) {
        вернуть "библиотека/" + имя_файла(путь)
    }
    пусть начало = склеить(з.каталог, "", р)
    если путь.начинается(начало) { вернуть путь[начало.длина..путь.длина - 1] }
    вернуть путь
}

/// Папка «пакеты» проекта (ближайшая вверх папка с файлом пакеты.json) или "".
функ папка_пакетов(основной: стр, р: стр) -> стр {
    перем папка = папка_пути(основной, р)
    пока истина {
        если существует(склеить(папка, "пакеты.json", р)) {
            пусть пакеты = склеить(папка, "пакеты", р)
            если существует(пакеты) { вернуть пакеты }
            вернуть ""
        }
        пусть выше = папка_пути(папка, р)
        если выше == "" или выше == папка { вернуть "" }
        папка = выше
    }
    вернуть ""
}

// ---------- ошибки ----------

функ ошибка_в(з: Загрузчик, модуль: Модуль, у: разбор.Узел, текст: стр) -> стр {
    перем место = ""
    если у.строка % 1000000 > 0 {
        место = "Строка " + стр(у.строка % 1000000) + ", позиция " + стр(у.столбец) + ": "
    }
    вернуть з.файлы[модуль.номер] + ": " + место + текст
}

// ---------- загрузка ----------

/// Дерево программы со всеми подключёнными файлами.
общий функ загрузить(исходник: стр, путь: стр, настройки: Настройки) -> Программа! {
    пусть р = настройки.разделитель
    перем з = Загрузчик(настройки, папка_пути(путь, р), путь)
    з.файлы = [показать_путь(з, путь)]
    з.тексты = [исходник]
    пусть токены = лексер.разобрать(исходник)!
    пусть дерево = разбор.разобрать(токены, настройки.редакции, настройки.версия)!
    пусть модуль = Модуль(путь, 0, "")
    пусть готово = подготовить(з, модуль, дерево, истина)!
    з = готово.загрузчик
    перем итог: [разбор.Узел] = []
    для п в з.порядок {
        для у в з.модули[п].инструкции { итог.добавить(у) }
    }
    для у в готово.модуль.инструкции { итог.добавить(у) }
    перем программа = дерево
    программа.поля = [разбор.группа("инструкции", итог)]
    вернуть Программа(программа, з.файлы, з.тексты)
}

функ найти_файл(з: Загрузчик, откуда: Модуль, у: разбор.Узел) -> стр! {
    пусть р = з.настройки.разделитель
    пусть записано = разбор.свойство(у, "путь")
    перем путь = нормализовать(склеить(папка_пути(откуда.путь, р), записано, р), р)
    если не существует(путь) и не есть_расширение(путь) и существует(путь + ".dan") { путь += ".dan" }
    если не существует(путь) {
        // пакеты проекта: пакеты/имя/имя.dan или пакеты/имя/файл.dan
        пусть пакеты = папка_пакетов(з.основной, р)
        если пакеты != "" {
            перем части = части_пути(записано)
            если части.длина == 1 { части = [части[0], части[0]] }
            перем кандидат = пакеты
            для ч в части { кандидат = склеить(кандидат, ч, р) }
            если не есть_расширение(кандидат) { кандидат += ".dan" }
            если существует(кандидат) { путь = кандидат }
        }
    }
    если не существует(путь) и не записано.содержит("/") и не записано.содержит("\\") {
        перем в_библиотеке = склеить(з.настройки.библиотека, записано, р)
        если не есть_расширение(в_библиотеке) { в_библиотеке += ".dan" }
        если существует(в_библиотеке) { путь = в_библиотеке }
    }
    если не существует(путь) {
        вернуть ошибка(ошибка_в(з, откуда, у, "не найден подключаемый файл «" + записано + "» (путь считается от "
            + "каталога файла, в котором записано подключение; в стандартной библиотеке такого модуля тоже нет)"))
    }
    вернуть путь
}

функ годится_как_имя(имя: стр) -> лог {
    пусть с = имя.символы()
    если с.длина == 0 { вернуть ложь }
    если не (лексер.буква(с[0]) или с[0] == "_") { вернуть ложь }
    для ч в с {
        если не (лексер.буква(ч) или лексер.цифра(ч) или ч == "_") { вернуть ложь }
    }
    вернуть истина
}

функ ключевое(слово: стр) -> лог {
    пусть слова = ["функ", "вернуть", "пусть", "перем", "если", "иначе", "пока", "для", "в", "прервать", "продолжить",
                   "и", "или", "не", "истина", "ложь", "тип", "ничего", "выбор", "подключить", "как", "общий",
                   "интерфейс", "запустить", "параллельно", "внешняя"]
    вернуть слова.содержит(слово)
}

функ загрузить_модуль(загрузчик: Загрузчик, откуда: Модуль, у: разбор.Узел) -> ИтогЗагрузки! {
    перем з = загрузчик
    пусть путь = найти_файл(з, откуда, у)!
    если з.модули.содержит(путь) { вернуть ИтогЗагрузки(з, путь) }
    если з.в_работе.содержит(путь) или путь == з.основной {
        перем имена: [стр] = []
        если путь == з.основной и не з.в_работе.содержит(путь) {
            имена.добавить(показать_путь(з, з.основной))
            для п в з.в_работе { имена.добавить(показать_путь(з, п)) }
        } иначе {
            перем начато = ложь
            для п в з.в_работе {
                если п == путь { начато = истина }
                если начато { имена.добавить(показать_путь(з, п)) }
            }
        }
        имена.добавить(показать_путь(з, путь))
        вернуть ошибка(ошибка_в(з, откуда, у, "файлы подключают друг друга по кругу: " + имена.соединить(" -> ")
            + ". Вынесите общие объявления в отдельный файл и подключите его в обоих"))
    }
    пусть исходник = прочитать(путь)
    пусть номер = з.файлы.длина
    з.файлы.добавить(показать_путь(з, путь))
    з.тексты.добавить(исходник)
    перем основа = лексер.без_ё(основа_имени(путь))
    если не годится_как_имя(основа) { основа = "модуль" }
    перем канон = основа
    перем н = 2
    пока з.каноны.содержит(канон) {
        канон = основа + "_" + стр(н)
        н += 1
    }
    з.каноны.добавить(канон)
    пусть модуль = Модуль(путь, номер, канон)
    перем дерево = разбор.Узел("?")
    если пусть токены = лексер.разобрать(исходник) {
        если пусть д = разбор.разобрать(токены, з.настройки.редакции, з.настройки.версия) {
            дерево = д
        } иначе ошибка о {
            вернуть ошибка(з.файлы[номер] + ": ошибка в записи программы\n  " + о)
        }
    } иначе ошибка о {
        вернуть ошибка(з.файлы[номер] + ": ошибка в записи программы\n  " + о)
    }
    з.в_работе.добавить(путь)
    // номер строки узла из подключённого файла хранит и номер файла: строка + номер * 1 000 000
    пусть готово = подготовить(з, модуль, сдвинуть_строки(дерево, номер * 1000000), ложь)!
    з = готово.загрузчик
    з.в_работе.удалить(з.в_работе.длина - 1)
    з.модули[путь] = готово.модуль
    з.порядок.добавить(путь)
    вернуть ИтогЗагрузки(з, путь)
}

функ объявление(у: разбор.Узел) -> лог {
    вернуть (у.вид == "Функция" или у.вид == "ОбъявлениеТипа" или у.вид == "ОбъявлениеВариантов"
        или у.вид == "ОбъявлениеИнтерфейса")
}

функ полное_имя(модуль: Модуль, имя: стр) -> стр {
    если модуль.канон == "" { вернуть имя }
    вернуть модуль.канон + "." + имя
}

функ подготовить(загрузчик: Загрузчик, исходный: Модуль, программа: разбор.Узел, основной: лог) -> ИтогПодготовки! {
    перем з = загрузчик
    перем модуль = исходный
    пусть инструкции = программа.поля[0].поля
    // подключения
    для у в инструкции {
        если у.вид != "Подключение" { продолжить }
        пусть подключённый = загрузить_модуль(з, модуль, у)!
        з = подключённый.загрузчик
        перем имя = разбор.свойство(у, "имя")
        перем написание = у.написание
        если написание == "" { написание = имя }
        если имя == "" {
            написание = основа_имени(разбор.свойство(у, "путь"))
            имя = лексер.без_ё(написание)
            если не годится_как_имя(имя) или ключевое(имя) {
                пусть записано = разбор.свойство(у, "путь")
                вернуть ошибка(ошибка_в(з, модуль, у, "название файла «" + записано + "» не годится как имя модуля; "
                    + "укажите имя: подключить \"" + записано + "\" как имя"))
            }
        }
        если модуль.псевдонимы.содержит(имя) {
            пусть записано = разбор.свойство(у, "путь")
            вернуть ошибка(ошибка_в(з, модуль, у, "имя модуля «" + имя + "» уже занято другим подключением; "
                + "укажите другое: подключить \"" + записано + "\" как другое_имя"))
        }
        модуль.псевдонимы[имя] = подключённый.путь
        модуль.написания[имя] = написание
    }
    // объявления
    для у в инструкции {
        если у.вид == "Подключение" { продолжить }
        если у.вид == "Функция" и разбор.свойство(у, "метод_типа") != "" { продолжить }     // метод виден там же, где тип
        если у.вид == "ВнешнийБлок" {
            для ф в разбор.часть_группы(у, "функции") {
                пусть имя = разбор.свойство(ф, "имя")
                модуль.имена[имя] = полное_имя(модуль, имя)
                если у.открытый { модуль.общие[имя] = истина }
            }
            продолжить
        }
        если объявление(у) {
            пусть имя = разбор.свойство(у, "имя")
            если модуль.псевдонимы.содержит(имя) {
                вернуть ошибка(ошибка_в(з, модуль, у, "имя «" + имя + "» уже занято подключённым модулем"))
            }
            модуль.имена[имя] = полное_имя(модуль, имя)
            если у.открытый { модуль.общие[имя] = истина }
            если у.вид == "ОбъявлениеВариантов" {
                для в_ в разбор.часть_группы(у, "варианты") {
                    пусть вариант = разбор.свойство(в_, "имя")
                    модуль.имена[вариант] = полное_имя(модуль, вариант)
                    если у.открытый { модуль.общие[вариант] = истина }
                }
            }
        } иначе если не основной {
            вернуть ошибка(ошибка_в(з, модуль, у, "в подключаемом файле могут быть только объявления функций и типов "
                + "(и подключения других файлов); выполняемые инструкции переносятся в основную программу"))
        }
    }
    // переименование
    для исходное в инструкции {
        если исходное.вид == "Подключение" { продолжить }
        перем у = исходное
        // параметры типа: имя не совпадает с именами файла, ограничения - полные имена интерфейсов
        перем группы: [разбор.Узел] = []
        для г в у.поля {
            если г.вид != "параметры_типа" {
                группы.добавить(г)
                продолжить
            }
            перем параметры: [разбор.Узел] = []
            для пт в г.поля {
                пусть имя = разбор.свойство(пт, "имя")
                если модуль.имена.содержит(имя) или модуль.псевдонимы.содержит(имя) {
                    вернуть ошибка(ошибка_в(з, модуль, пт, "имя параметра типа «" + имя + "» совпадает с именем из этого "
                        + "файла; выберите другое, например Т"))
                }
                перем ограничения: [разбор.Узел] = []
                для о в разбор.часть_группы(пт, "ограничения") {
                    пусть новое = переписать_тип(з, модуль, пт, о.простые[0].значение)!
                    ограничения.добавить(разбор.элемент(новое))
                }
                перем новый = пт
                новый.поля = [разбор.группа("ограничения", ограничения)]
                параметры.добавить(новый)
            }
            группы.добавить(разбор.группа("параметры_типа", параметры))
        }
        у.поля = группы
        если у.вид == "ВнешнийБлок" {
            перем функции: [разбор.Узел] = []
            для ф в разбор.часть_группы(у, "функции") {
                функции.добавить(заменить_свойство(ф, "имя", модуль.имена[разбор.свойство(ф, "имя")]))
            }
            у = заменить_группу(у, "функции", функции)
            модуль.инструкции.добавить(у)
            продолжить
        }
        пусть метод_типа = разбор.свойство(у, "метод_типа")
        если у.вид == "Функция" и метод_типа != "" {
            если метод_типа.содержит(".") {
                вернуть ошибка(ошибка_в(з, модуль, у, "метод объявляется в том же файле, что и его тип"))
            }
            если модуль.имена.содержит(метод_типа) {
                у = заменить_свойство(у, "метод_типа", модуль.имена[метод_типа])
            }
            пусть переписанный = переписать(з, модуль, у)!
            модуль.инструкции.добавить(переписанный)
            продолжить
        }
        если не основной {
            если у.вид == "ОбъявлениеВариантов" {
                перем варианты: [разбор.Узел] = []
                для в_ в разбор.часть_группы(у, "варианты") {
                    варианты.добавить(заменить_свойство(в_, "имя", модуль.имена[разбор.свойство(в_, "имя")]))
                }
                у = заменить_группу(у, "варианты", варианты)
            }
            если объявление(у) {
                у = заменить_свойство(у, "имя", модуль.имена[разбор.свойство(у, "имя")])
            }
        }
        пусть переписанный = переписать(з, модуль, у)!
        модуль.инструкции.добавить(переписанный)
    }
    вернуть ИтогПодготовки(з, модуль)
}

// ---------- обход дерева ----------

функ сдвинуть_строки(у: разбор.Узел, сдвиг: цел) -> разбор.Узел {
    перем новый = у
    если новый.строка != 0 { новый.строка += сдвиг }
    перем группы: [разбор.Узел] = []
    для г в у.поля {
        перем содержимое: [разбор.Узел] = []
        для вложенный в г.поля { содержимое.добавить(сдвинуть_строки(вложенный, сдвиг)) }
        группы.добавить(разбор.группа(г.вид, содержимое))
    }
    новый.поля = группы
    вернуть новый
}

функ заменить_свойство(у: разбор.Узел, имя: стр, значение_: стр) -> разбор.Узел {
    перем новый = у
    перем простые: [разбор.Свойство] = []
    для с в у.простые {
        если с.имя == имя {
            простые.добавить(разбор.Свойство(имя, значение_, с.строкой))
        } иначе {
            простые.добавить(с)
        }
    }
    новый.простые = простые
    вернуть новый
}

функ заменить_группу(у: разбор.Узел, имя: стр, содержимое: [разбор.Узел]) -> разбор.Узел {
    перем новый = у
    перем группы: [разбор.Узел] = []
    для г в у.поля {
        если г.вид == имя {
            группы.добавить(разбор.группа(имя, содержимое))
        } иначе {
            группы.добавить(г)
        }
    }
    новый.поля = группы
    вернуть новый
}

/// Полное имя для «псевдоним.имя».
функ внешнее(з: Загрузчик, модуль: Модуль, у: разбор.Узел, псевдоним: стр, имя: стр) -> стр! {
    пусть другой = з.модули[модуль.псевдонимы[псевдоним]]
    если не другой.имена.содержит(имя) {
        вернуть ошибка(ошибка_в(з, модуль, у, "в модуле «" + модуль.написания[псевдоним] + "» нет функции или типа «"
            + имя + "»"))
    }
    если не другой.общие.содержит(имя) {
        вернуть ошибка(ошибка_в(з, модуль, у, "«" + имя + "» в модуле «" + модуль.написания[псевдоним]
            + "» не помечено словом «общий», поэтому снаружи модуля недоступно"))
    }
    вернуть другой.имена[имя]
}

/// Имена в записи типа («Точка», «расчёты.Счёт», «[Точка]?») заменяются полными.
функ переписать_тип(з: Загрузчик, модуль: Модуль, у: разбор.Узел, запись: стр) -> стр! {
    пусть с = запись.символы()
    перем итог = ""
    перем н = 0
    пока н < с.длина {
        если не (лексер.буква(с[н]) или с[н] == "_") {
            итог += с[н]
            н += 1
            продолжить
        }
        перем слово = ""
        пока н < с.длина и (лексер.буква(с[н]) или лексер.цифра(с[н]) или с[н] == "_") {
            слово += с[н]
            н += 1
        }
        перем после_точки = ""
        если н + 1 < с.длина и с[н] == "." и (лексер.буква(с[н + 1]) или с[н + 1] == "_") {
            перем м = н + 1
            пока м < с.длина и (лексер.буква(с[м]) или лексер.цифра(с[м]) или с[м] == "_") {
                после_точки += с[м]
                м += 1
            }
            н = м
        }
        если после_точки != "" {
            если не модуль.псевдонимы.содержит(слово) {
                вернуть ошибка(ошибка_в(з, модуль, у, "неизвестный модуль «" + слово + "» в типе «" + запись + "»"))
            }
            итог += внешнее(з, модуль, у, слово, после_точки)!
        } иначе если модуль.имена.содержит(слово) {
            итог += модуль.имена[слово]
        } иначе {
            итог += слово
        }
    }
    вернуть итог
}

/// Имя переменной или параметра не должно совпадать с объявлением или модулем.
функ проверить_имя(з: Загрузчик, модуль: Модуль, у: разбор.Узел, имя: стр) -> лог! {
    если имя == "" { вернуть истина }
    если модуль.псевдонимы.содержит(имя) {
        вернуть ошибка(ошибка_в(з, модуль, у, "имя «" + модуль.написания[имя] + "» уже занято подключённым модулем"))
    }
    если модуль.канон != "" и модуль.имена.содержит(имя) {
        вернуть ошибка(ошибка_в(з, модуль, у, "имя «" + имя + "» уже занято функцией или типом этого модуля"))
    }
    вернуть истина
}

функ переписать(з: Загрузчик, модуль: Модуль, исходный: разбор.Узел) -> разбор.Узел! {
    перем у = исходный
    выбор у.вид {
        "=" { вернуть у }
        "Подключение" {
            вернуть ошибка(ошибка_в(з, модуль, у, "«подключить» пишется в начале файла, вне функций и блоков"))
        }
        "Поле" {
            пусть объект = разбор.часть(у, "объект")
            если объект.вид == "Имя" и модуль.псевдонимы.содержит(объект.текст) {
                пусть полное = внешнее(з, модуль, у, объект.текст, у.текст)!
                перем имя = разбор.Узел("Имя", [разбор.Свойство("имя", полное)], [], у.строка, у.столбец)
                имя.текст = полное
                вернуть имя
            }
        }
        "Имя" {
            если модуль.псевдонимы.содержит(у.текст) {
                вернуть ошибка(ошибка_в(з, модуль, у, "«" + у.текст + "» - подключённый модуль; обращаться нужно к его "
                    + "функциям и типам: " + у.текст + ".имя"))
            }
            если модуль.имена.содержит(у.текст) {
                у = заменить_свойство(у, "имя", модуль.имена[у.текст])
                у.текст = модуль.имена[исходный.текст]
            }
            вернуть у
        }
        "ОбразецВарианта" {
            пусть имя = разбор.свойство(у, "имя")
            если имя.содержит(".") {
                пусть части = имя.разбить(".")
                если не модуль.псевдонимы.содержит(части[0]) {
                    вернуть ошибка(ошибка_в(з, модуль, у, "неизвестный модуль «" + части[0] + "»"))
                }
                у = заменить_свойство(у, "имя", внешнее(з, модуль, у, части[0], имя[части[0].длина + 1..имя.длина - 1])!)
            } иначе если модуль.имена.содержит(имя) {
                у = заменить_свойство(у, "имя", модуль.имена[имя])
            }
            для п в разбор.часть_группы(у, "привязки") {
                если п.простые[0].значение != "_" { проверить_имя(з, модуль, у, п.простые[0].значение)! }
            }
            вернуть у
        }
        "Параметр" { проверить_имя(з, модуль, у, разбор.свойство(у, "имя"))! }
        "ОбъявлениеПеременной" { проверить_имя(з, модуль, у, разбор.свойство(у, "имя"))! }
        "Для" { проверить_имя(з, модуль, у, разбор.свойство(у, "переменная"))! }
        "ЕслиЕсть" {
            проверить_имя(з, модуль, у, разбор.свойство(у, "имя"))!
            проверить_имя(з, модуль, у, разбор.свойство(у, "имя_ошибки"))!
        }
        "ЕслиОшибка" { проверить_имя(з, модуль, у, разбор.свойство(у, "имя"))! }
        иначе { }
    }
    // поля в порядке объявления (как в uzly.py): у функций параметры идут раньше типа результата
    перем параметры_раньше = у.вид == "Функция" или у.вид == "Лямбда" или у.вид == "МетодИнтерфейса"
    перем готовые: {стр: [разбор.Узел]} = {}
    если параметры_раньше {
        перем содержимое: [разбор.Узел] = []
        для вложенный в разбор.часть_группы(у, "параметры") { содержимое.добавить(переписать(з, модуль, вложенный)!) }
        готовые["параметры"] = содержимое
    }
    перем простые: [разбор.Свойство] = []
    для с в у.простые {
        если с.имя == "тип" или с.имя == "тип_результата" {
            простые.добавить(разбор.Свойство(с.имя, переписать_тип(з, модуль, у, с.значение)!, с.строкой))
        } иначе {
            простые.добавить(с)
        }
    }
    перем группы: [разбор.Узел] = []
    для г в у.поля {
        если готовые.содержит(г.вид) {
            группы.добавить(разбор.группа(г.вид, готовые[г.вид]))
            продолжить
        }
        перем содержимое: [разбор.Узел] = []
        для вложенный в г.поля { содержимое.добавить(переписать(з, модуль, вложенный)!) }
        группы.добавить(разбор.группа(г.вид, содержимое))
    }
    у.простые = простые
    у.поля = группы
    вернуть у
}
