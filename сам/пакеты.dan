/// Менеджер пакетов для компилятора на Дане: команды «дан пакеты ...».
///
/// Делает то же, что paketi.py, с теми же сообщениями и той же защитой от подменённых
/// и вредоносных пакетов: из репозитория копируются только файлы .dan, LICENSE, README
/// и пакеты.json, ссылки не копируются, установка по замку берёт записанный коммит и
/// сверяет контрольную сумму SHA-256 всех файлов пакета. Файлы пакеты.json и
/// пакеты.замок.json записываются так же, как их записывает Python (ключи по алфавиту,
/// отступ в два пробела), поэтому обе версии работают с одним проектом.

подключить "json"

/// Как выполнить команду «дан пакеты» без действия или с неверными значениями.
общий функ справка() -> стр {
    вернуть ("Менеджер пакетов языка Дан.\n\n"
        + "    дан пакеты добавить имя адрес [версия]   - добавить пакет в проект\n"
        + "    дан пакеты установить                   - поставить пакеты по файлу пакеты.замок.json\n"
        + "    дан пакеты установить --заморожено      - то же, но ошибка, если замок не согласован\n"
        + "                                                        с пакеты.json (для автоматических проверок)\n"
        + "    дан пакеты обновить [имя]               - перейти на версию из пакеты.json заново\n"
        + "    дан пакеты удалить имя                  - убрать пакет из проекта\n"
        + "    дан пакеты список                       - показать пакеты проекта\n"
        + "    дан пакеты проверить                    - сверить пакеты с контрольными суммами\n"
        + "                                                        и замок с пакеты.json\n\n"
        + "Пакет - это репозиторий git (на GitHub, другом сервере или в папке на\n"
        + "диске) с файлами .dan. Версия - метка (tag) репозитория, например v1.2.0,\n"
        + "или полный номер коммита; без версии берётся последний коммит основной ветки.\n\n"
        + "Проект описывают два файла в его папке:\n"
        + "- пакеты.json - какие пакеты нужны: {\"зависимости\": {\"имя\": {\"адрес\": ..., \"версия\": ...}}};\n"
        + "- пакеты.замок.json - что именно поставлено: номер коммита и контрольная\n"
        + "  сумма SHA-256 всех файлов каждого пакета.\n"
        + "Пакеты лежат в папке «пакеты» проекта: пакеты/имя/имя.dan подключается\n"
        + "командой подключить \"имя\", пакеты/имя/другой.dan - подключить \"имя/другой\".\n\n"
        + "Защита от атак через пакеты (подменённые и вредоносные библиотеки):\n"
        + "- при установке никакой код пакета не выполняется: из репозитория\n"
        + "  копируются только файлы .dan, LICENSE и README; ссылки (symlink) не копируются;\n"
        + "- установка по замку берёт ровно записанный коммит и сверяет контрольную\n"
        + "  сумму: если содержимое пакета изменилось (например, метку версии\n"
        + "  передвинули на другой коммит), установка останавливается с ошибкой;\n"
        + "- поставленный пакет запоминается в папке пользователя (кэш Дана, папка\n"
        + "  «пакеты») под своей контрольной суммой; установка по замку на том же\n"
        + "  компьютере берёт его оттуда без сети, сверив сумму (DAN_NO_CACHE=1 отключает);\n"
        + "- зависимости пакетов (их файлы пакеты.json) ставятся в ту же папку; если\n"
        + "  двум пакетам нужны разные версии одного пакета, это ошибка, а не\n"
        + "  молчаливый выбор одной из них.")
}

функ ФАЙЛ() -> стр { вернуть "пакеты.json" }
функ ЗАМОК() -> стр { вернуть "пакеты.замок.json" }
функ ПАПКА() -> стр { вернуть "пакеты" }

// ---------- пути ----------

функ windows(р: стр) -> лог { вернуть р == "\\" }

функ склеить(а: стр, б: стр, р: стр) -> стр {
    если а == "" { вернуть б }
    если а.оканчивается(р) или а.оканчивается("/") { вернуть а + б }
    вернуть а + р + б
}

/// Полный путь без «.», «..» и повторных разделителей (как os.path.abspath).
общий функ полный_путь(путь_: стр, р: стр) -> стр {
    перем путь = путь_
    если windows(р) { путь = путь.заменить("/", "\\") }
    перем диск = ""
    если windows(р) и путь.длина >= 2 и путь[1] == ":" {
        диск = путь[0..1]
        путь = путь[2..путь.длина - 1]
    }
    если не путь.начинается(р) {
        путь = текущая_папка() + р + путь
        если windows(р) {
            путь = путь.заменить("/", "\\")
            если путь.длина >= 2 и путь[1] == ":" {
                диск = путь[0..1]
                путь = путь[2..путь.длина - 1]
            }
        }
    }
    перем части: [стр] = []
    для ч в путь.разбить(р) {
        если ч == "" или ч == "." { продолжить }
        если ч == ".." {
            если части.длина > 0 { части.удалить(части.длина - 1) }
            продолжить
        }
        части.добавить(ч)
    }
    вернуть диск + р + части.соединить(р)
}

/// Папка, в которой лежит путь (как os.path.dirname); у корня - сам корень.
функ родитель(путь: стр, р: стр) -> стр {
    перем диск = ""
    перем остаток = путь
    если windows(р) и путь.длина >= 2 и путь[1] == ":" {
        диск = путь[0..1]
        остаток = путь[2..путь.длина - 1]
    }
    перем последний = -1
    для н в 0..остаток.длина - 1 {
        если остаток[н] == р { последний = н }
    }
    если последний < 0 { вернуть диск }
    перем голова = остаток[0..последний]
    если голова != р.повторить(голова.длина) {
        пока голова.оканчивается(р) { голова = голова[0..голова.длина - 2] }
    }
    вернуть диск + голова
}

функ это_файл(путь: стр) -> лог { вернуть существует(путь) и не это_папка(путь) }

/// Папка проекта: ближайшая (вверх от «откуда») папка с файлом пакеты.json, или "".
общий функ найти_проект(откуда: стр, р: стр) -> стр {
    перем папка = полный_путь(откуда, р)
    если не это_папка(папка) { папка = родитель(папка, р) }
    пока истина {
        если это_файл(склеить(папка, ФАЙЛ(), р)) { вернуть папка }
        пусть выше = родитель(папка, р)
        если выше == папка { вернуть "" }
        папка = выше
    }
    вернуть ""
}

// ---------- файлы JSON ----------

функ читать(путь: стр, имя: стр) -> json.Значение! {
    если не существует(путь) { вернуть json.Пусто }
    если пусть з = json.разобрать(прочитать(путь)) { вернуть з } иначе ошибка о {
        вернуть ошибка("файл " + имя + " повреждён: " + о)
    }
}

/// Строка JSON так, как её записывает Python с ensure_ascii=False.
функ строка_json(с: стр) -> стр {
    перем части: [стр] = ["\""]
    для з в с.символы() {
        выбор з {
            "\"" { части.добавить("\\\"") }
            "\\" { части.добавить("\\\\") }
            "\n" { части.добавить("\\n") }
            "\r" { части.добавить("\\r") }
            "\t" { части.добавить("\\t") }
            иначе {
                пусть к = код_символа(з)
                если к == 8 {
                    части.добавить("\\b")
                } иначе если к == 12 {
                    части.добавить("\\f")
                } иначе если к < 32 {
                    пусть цифры = "0123456789abcdef"
                    части.добавить("\\u00" + цифры[частное(к, 16)] + цифры[к % 16])
                } иначе {
                    части.добавить(з)
                }
            }
        }
    }
    части.добавить("\"")
    вернуть части.соединить("")
}

/// Текст JSON как у json.dump(..., ensure_ascii=False, indent=2, sort_keys=True).
функ текст_json(з: json.Значение, уровень: цел) -> стр {
    пусть отступ = "\n" + "  ".повторить(уровень + 1)
    выбор з {
        json.Пусто { вернуть "null" }
        json.Логическое(л) {
            если л { вернуть "true" }
            вернуть "false"
        }
        json.Целое(ч) { вернуть стр(ч) }
        json.Число(ч) { вернуть стр(ч) }
        json.Строка(с) { вернуть строка_json(с) }
        json.Массив(э) {
            если э.длина == 0 { вернуть "[]" }
            перем части: [стр] = []
            для х в э { части.добавить(отступ + текст_json(х, уровень + 1)) }
            вернуть "[" + части.соединить(",") + "\n" + "  ".повторить(уровень) + "]"
        }
        json.Объект(п) {
            если п.длина == 0 { вернуть "{}" }
            перем части: [стр] = []
            для к в п.ключи().упорядочить_по(функ(с: стр) = с) {
                части.добавить(отступ + строка_json(к) + ": " + текст_json(п[к], уровень + 1))
            }
            вернуть "{" + части.соединить(",") + "\n" + "  ".повторить(уровень) + "}"
        }
    }
}

функ записать_json(путь: стр, з: json.Значение) {
    записать(путь, текст_json(з, 0) + "\n")
}

функ поля(з: json.Значение) -> {стр: json.Значение} {
    выбор з {
        json.Объект(п) { вернуть п }
        иначе { вернуть {} }
    }
}

функ текст_поля(з: json.Значение, имя: стр) -> стр {
    вернуть з.поле(имя).как_стр() иначе ""
}

// ---------- git ----------

функ в_кавычках(с: стр, р: стр) -> стр {
    если windows(р) { вернуть "\"" + с + "\"" }
    вернуть "'" + с.заменить("'", "'\\''") + "'"
}

/// Удаляет папку, не останавливая программу, если удалить не удалось (как shutil.rmtree с
/// ignore_errors в paketi.py): в Windows файл может быть ещё занят только что завершившимся git.
функ убрать(папка: стр, р: стр) {
    если не существует(папка) { вернуть }
    если windows(р) {
        выполнить_команду("\"rmdir /s /q " + в_кавычках(папка, р) + " >NUL 2>&1\"")
    } иначе {
        выполнить_команду("rm -rf " + в_кавычках(папка, р) + " >/dev/null 2>&1")
    }
}

/// Выполняет git; результат - его вывод без пробелов по краям, ошибка - сообщение git.
/// Хуки репозитория отключены, вопросы о пароле запрещены.
функ git(аргументы: [стр], папка: стр, р: стр) -> стр! {
    перем тихо = " >/dev/null 2>&1"
    если windows(р) { тихо = " >NUL 2>&1" }
    перем проверка_ = "git --version" + тихо
    если windows(р) { проверка_ = "\"" + проверка_ + "\"" }
    если выполнить_команду(проверка_) != 0 {
        вернуть ошибка("для работы с пакетами нужна программа git (в Windows: winget install Git.Git)")
    }
    пусть временная = создать_временную_папку()
    пусть файл_вывода = склеить(временная, "вывод.txt", р)
    пусть файл_ошибок = склеить(временная, "ошибки.txt", р)
    перем команда_ = ""
    если папка != "" {
        если windows(р) { команда_ = "cd /d " } иначе { команда_ = "cd " }
        команда_ += в_кавычках(папка, р) + " && "
    }
    перем пусто_ = "/dev/null"
    если windows(р) {
        команда_ += "set \"GIT_TERMINAL_PROMPT=0\" && set \"GIT_CONFIG_NOSYSTEM=1\" && git"
        пусто_ = "nul"
    } иначе {
        команда_ += "GIT_TERMINAL_PROMPT=0 GIT_CONFIG_NOSYSTEM=1 git"
    }
    команда_ += " -c core.hooksPath=" + пусто_ + " -c protocol.file.allow=always"
    для а в аргументы { команда_ += " " + в_кавычках(а, р) }
    команда_ += " >" + в_кавычках(файл_вывода, р) + " 2>" + в_кавычках(файл_ошибок, р)
    если windows(р) { команда_ = "\"" + команда_ + "\"" }
    пусть код = выполнить_команду(команда_)
    перем вывод_ = ""
    перем ошибки = ""
    если существует(файл_вывода) { вывод_ = прочитать(файл_вывода) }
    если существует(файл_ошибок) { ошибки = прочитать(файл_ошибок) }
    убрать(временная, р)
    если код != 0 {
        если ошибки.обрезать() != "" { вернуть ошибка(ошибки.обрезать()) }
        если вывод_.обрезать() != "" { вернуть ошибка(вывод_.обрезать()) }
        вернуть ошибка("ошибка git")
    }
    вернуть вывод_.обрезать()
}

// ---------- файлы пакета ----------

/// SHA-256 от имён и содержимого всех файлов папки (в порядке имён, как os.walk).
общий функ контрольная_сумма(папка: стр, р: стр) -> стр {
    вернуть хеш(данные_папки(папка, "", байты(""), р))
}

функ данные_папки(папка: стр, отн: стр, исх: байты, р: стр) -> байты {
    перем данные = исх
    перем папки: [стр] = []
    для имя в список_файлов(папка) {
        если имя.оканчивается("/") {
            папки.добавить(имя[0..имя.длина - 2])
            продолжить
        }
        перем относительный = имя
        если отн != "" { относительный = отн + "/" + имя }
        данные = данные + байты(относительный) + байты([0]) + прочитать_байты(склеить(папка, имя, р)) + байты([0])
    }
    для имя в папки {
        пусть путь = склеить(папка, имя, р)
        если это_ссылка(путь) { продолжить }      // ссылки на папки os.walk не обходит
        перем относительный = имя
        если отн != "" { относительный = отн + "/" + имя }
        данные = данные_папки(путь, относительный, данные, р)
    }
    вернуть данные
}

функ копируемое(имя: стр) -> лог {
    пусть н = имя.строчные()
    вернуть (н.оканчивается(".dan") или н == "license" или н.начинается("license.") или н == "readme"
        или н.начинается("readme.") или н == "пакеты.json")
}

/// Только файлы .dan, LICENSE, README и пакеты.json; ссылки и служебная папка .git пропускаются.
функ скопировать(откуда: стр, куда: стр, р: стр) {
    если существует(куда) { удалить_папку(куда) }
    создать_папку(куда)
    скопировать_часть(откуда, куда, р)
}

функ скопировать_часть(откуда: стр, куда: стр, р: стр) {
    перем папки: [стр] = []
    для имя в список_файлов(откуда) {
        пусть путь = склеить(откуда, имя, р)
        если имя.оканчивается("/") {
            пусть чистое = имя[0..имя.длина - 2]
            если чистое != ".git" и не это_ссылка(склеить(откуда, чистое, р)) { папки.добавить(чистое) }
            продолжить
        }
        если это_ссылка(путь) или не это_файл(путь) или не копируемое(имя) { продолжить }
        создать_папку(куда)
        записать(склеить(куда, имя, р), прочитать_байты(путь))
    }
    для имя в папки { скопировать_часть(склеить(откуда, имя, р), склеить(куда, имя, р), р) }
}

/// Копия всей папки со всеми файлами и вложенными папками.
функ скопировать_всё(откуда: стр, куда: стр, р: стр) {
    создать_папку(куда)
    для имя в список_файлов(откуда) {
        если имя.оканчивается("/") {
            пусть чистое = имя[0..имя.длина - 2]
            скопировать_всё(склеить(откуда, чистое, р), склеить(куда, чистое, р), р)
        } иначе {
            записать(склеить(куда, имя, р), прочитать_байты(склеить(откуда, имя, р)))
        }
    }
}

// ---------- хранилище (кэш Дана) ----------

функ среда(имя: стр) -> стр { вернуть переменная_среды(имя) иначе "" }

/// Папка запомненных пакетов в кэше Дана или "", если кэш отключён.
общий функ хранилище(р: стр) -> стр {
    если среда("DAN_NO_CACHE") == "1" { вернуть "" }
    перем кэш = ""
    если среда("DAN_CACHE") != "" {
        кэш = среда("DAN_CACHE")
    } иначе если windows(р) {
        перем основа = среда("LOCALAPPDATA")
        если основа == "" { основа = среда("USERPROFILE") }
        кэш = склеить(склеить(основа, "Dan", р), "cache", р)
    } иначе {
        перем основа = среда("XDG_CACHE_HOME")
        если основа == "" { основа = склеить(среда("HOME"), ".cache", р) }
        кэш = склеить(основа, "dan", р)
    }
    вернуть склеить(кэш, ПАПКА(), р)
}

функ сумма_годится(с: стр) -> лог {
    если с.длина != 64 { вернуть ложь }
    для з в с.символы() {
        если не "0123456789abcdef".содержит(з) { вернуть ложь }
    }
    вернуть истина
}

функ взять_из_хранилища(сумма: стр, куда: стр, р: стр) -> лог {
    пусть папка = хранилище(р)
    если папка == "" или не сумма_годится(сумма) { вернуть ложь }
    пусть откуда = склеить(папка, сумма, р)
    если не это_папка(откуда) или контрольная_сумма(откуда, р) != сумма { вернуть ложь }
    если существует(куда) { удалить_папку(куда) }
    скопировать_всё(откуда, куда, р)
    вернуть контрольная_сумма(куда, р) == сумма
}

функ запомнить(сумма: стр, откуда: стр, р: стр) {
    пусть папка = хранилище(р)
    если папка == "" { вернуть }
    пусть цель = склеить(папка, сумма, р)
    если это_папка(цель) { вернуть }
    пусть временная = цель + "." + стр(случайное(100000, 999999)) + ".tmp"
    создать_папку(папка)
    скопировать_всё(откуда, временная, р)
    переименовать(временная, цель)
}

// ---------- проект ----------

/// Проект: описание (пакеты.json), замок (пакеты.замок.json) и сообщения для вывода.
/// Ошибка не прерывает работу исключением: она записывается в поле «ошибка», а сообщения,
/// накопленные до неё, выводятся, как в dan.py.
тип Проект {
    папка: стр
    р: стр
    описание: json.Значение = json.Пусто
    замок: {стр: {стр: стр}} = {}
    сообщения: [стр] = []
    ошибка: стр = ""
}

функ открыть(папка: стр, р: стр) -> Проект {
    перем п = Проект(полный_путь(папка, р), р)
    если пусть о = читать(склеить(п.папка, ФАЙЛ(), р), ФАЙЛ()) {
        п.описание = о
    } иначе ошибка т {
        п.ошибка = т
        вернуть п
    }
    перем поля_ = поля(п.описание)
    если не поля_.содержит("зависимости") { поля_["зависимости"] = json.Объект({}) }
    п.описание = json.Объект(поля_)
    если пусть з = читать(склеить(п.папка, ЗАМОК(), р), ЗАМОК()) {
        для имя в з.ключи() {
            перем запись: {стр: стр} = {}
            пусть значение = з.поле(имя)
            для к в значение.ключи() {
                если пусть с = значение.поле(к).как_стр() { запись[к] = с }
            }
            п.замок[имя] = запись
        }
    } иначе ошибка т {
        п.ошибка = т
    }
    вернуть п
}

функ зависимости(п: Проект) -> {стр: json.Значение} {
    вернуть поля(п.описание.поле("зависимости"))
}

функ с_зависимостями(п_: Проект, з: {стр: json.Значение}) -> Проект {
    перем п = п_
    перем поля_ = поля(п.описание)
    поля_["зависимости"] = json.Объект(з)
    п.описание = json.Объект(поля_)
    вернуть п
}

функ сохранить(п: Проект) {
    записать_json(склеить(п.папка, ФАЙЛ(), п.р), п.описание)
    перем замок: {стр: json.Значение} = {}
    для имя в п.замок.ключи() {
        перем запись: {стр: json.Значение} = {}
        для к в п.замок[имя].ключи() { запись[к] = json.Строка(п.замок[имя][к]) }
        замок[имя] = json.Объект(запись)
    }
    записать_json(склеить(п.папка, ЗАМОК(), п.р), json.Объект(замок))
}

функ папка_пакета(п: Проект, имя: стр) -> стр {
    вернуть склеить(склеить(п.папка, ПАПКА(), п.р), имя, п.р)
}

функ буква(з: стр) -> лог { вернуть з == "_" или з.прописные() != з.строчные() }

функ годное_имя(имя: стр) -> лог {
    если имя == "" или не буква(имя[0]) { вернуть ложь }
    для з в имя.символы() {
        если не буква(з) и не (з >= "0" и з <= "9") { вернуть ложь }
    }
    вернуть истина
}

функ или_последняя(версия: стр, слово: стр) -> стр {
    если версия == "" { вернуть слово }
    вернуть версия
}

функ отсортировано(ключи: [стр]) -> [стр] { вернуть ключи.упорядочить_по(функ(с: стр) = с) }

/// Копия репозитория во временной папке: [папка, коммит]. Ничего из репозитория не выполняется.
функ загрузить(адрес: стр, версия: стр, коммит: стр, р: стр) -> [стр]! {
    пусть временная = создать_временную_папку()
    если пусть итог = загрузить_в(временная, адрес, версия, коммит, р) {
        вернуть итог
    } иначе ошибка о {
        убрать(временная, р)
        вернуть ошибка("не удалось получить пакет из " + адрес + " (версия " + или_последняя(версия, "последняя")
            + "): " + о)
    }
}

функ загрузить_в(временная: стр, адрес: стр, версия: стр, коммит: стр, р: стр) -> [стр]! {
    git(["init", "-q", временная], "", р)!
    git(["remote", "add", "origin", адрес], временная, р)!
    перем цель = "HEAD"
    если коммит != "" { цель = коммит } иначе если версия != "" { цель = версия }
    если ошибка о = git(["fetch", "-q", "--depth", "1", "--no-recurse-submodules", "origin", цель], временная, р) {
        если версия != "" и коммит == "" {
            git(["fetch", "-q", "--depth", "1", "--no-recurse-submodules", "origin", "refs/tags/" + версия], временная, р)!
        } иначе {
            вернуть ошибка(о)
        }
    }
    git(["checkout", "-q", "FETCH_HEAD"], временная, р)!
    пусть полученный = git(["rev-parse", "HEAD"], временная, р)!
    если коммит != "" и полученный != коммит {
        вернуть ошибка("вместо коммита " + коммит + " получен " + полученный)
    }
    вернуть [временная, полученный]
}

функ начало(с: стр, н: цел) -> стр {
    если с.длина <= н { вернуть с }
    вернуть с[0..н - 1]
}

/// Получает пакет, кладёт его в папку «пакеты» и записывает в замок; затем его зависимости.
функ поставить(п_: Проект, имя: стр, адрес: стр, версия: стр, коммит: стр, сумма: стр, нужен_для: стр) -> Проект {
    перем п = п_
    пусть р = п.р
    если не годное_имя(имя) {
        п.ошибка = "«" + имя + "» не годится как имя пакета: оно должно быть именем Дана (буквы, цифры, «_»)"
        вернуть п
    }
    если нужен_для != "" и п.замок.содержит(имя) {
        пусть прежний = п.замок[имя]
        если прежний.получить("адрес", "") != адрес или версия != прежний.получить("версия", "") {
            п.ошибка = ("пакету «" + нужен_для + "» нужен «" + имя + "» версии " + или_последняя(версия, "последней")
                + " из " + адрес + ", а в проекте уже есть «" + имя + "» версии "
                + или_последняя(прежний.получить("версия", ""), "последней") + " из " + прежний.получить("адрес", "")
                + "; согласуйте версии")
            вернуть п
        }
    }
    пусть папка = папка_пакета(п, имя)
    перем полученный = ""
    перем откуда = ""
    если коммит != "" и сумма != "" и взять_из_хранилища(сумма, папка, р) {
        полученный = коммит                  // тот же коммит уже ставился на этом компьютере
        откуда = " (из кэша)"
    } иначе {
        если пусть з = загрузить(адрес, версия, коммит, р) {
            скопировать(з[0], папка, р)
            убрать(з[0], р)
            полученный = з[1]
        } иначе ошибка о {
            п.ошибка = о
            вернуть п
        }
    }
    пусть новая_сумма = контрольная_сумма(папка, р)
    если сумма != "" и новая_сумма != сумма {
        убрать(папка, р)
        п.ошибка = ("содержимое пакета «" + имя + "» не совпадает с записанным в " + ЗАМОК() + ": коммит " + полученный
            + " даёт другую контрольную сумму. Возможно, пакет подменили; установка остановлена")
        вернуть п
    }
    если не это_файл(склеить(папка, имя + ".dan", р)) {
        п.сообщения.добавить("предупреждение: в пакете «" + имя + "» нет файла " + имя + ".dan; подключайте его файлы "
            + "так: подключить \"" + имя + "/файл\"")
    }
    перем запись = {"адрес": адрес, "версия": версия, "коммит": полученный, "сумма": новая_сумма}
    если нужен_для != "" { запись["нужен_для"] = нужен_для }
    п.замок[имя] = запись
    запомнить(новая_сумма, папка, р)
    п.сообщения.добавить(имя + ": " + или_последняя(версия, "последняя версия") + ", коммит " + начало(полученный, 12)
        + откуда)
    // зависимости самого пакета
    перем описание = json.Пусто
    если пусть о = читать(склеить(папка, ФАЙЛ(), р), ФАЙЛ()) { описание = о } иначе ошибка т {
        п.ошибка = т
        вернуть п
    }
    пусть свои = поля(описание.поле("зависимости"))
    для зависимость в отсортировано(свои.ключи()) {
        пусть о = свои[зависимость]
        пусть нужный_адрес = текст_поля(о, "адрес")
        пусть нужная_версия = текст_поля(о, "версия")
        если п.замок.содержит(зависимость) {
            пусть уже = п.замок[зависимость]
            если уже.получить("адрес", "") == нужный_адрес и уже.получить("версия", "") == нужная_версия { продолжить }
        }
        п = поставить(п, зависимость, нужный_адрес, нужная_версия, "", "", имя)
        если п.ошибка != "" { вернуть п }
    }
    вернуть п
}

функ добавить(п_: Проект, имя: стр, адрес_: стр, версия: стр) -> Проект {
    перем адрес = адрес_
    если это_папка(адрес) { адрес = полный_путь(адрес, п_.р) }
    перем п = поставить(п_, имя, адрес, версия, "", "", "")
    если п.ошибка != "" { вернуть п }
    перем з = зависимости(п)
    з[имя] = json.Объект({"адрес": json.Строка(адрес), "версия": json.Строка(версия)})
    п = с_зависимостями(п, з)
    сохранить(п)
    вернуть п
}

/// Расхождения между пакеты.json и замком.
функ несогласованность(п: Проект) -> [стр] {
    перем итог: [стр] = []
    пусть нужные = зависимости(п)
    для имя в отсортировано(нужные.ключи()) {
        пусть о = нужные[имя]
        если не п.замок.содержит(имя) {
            итог.добавить(имя + ": есть в " + ФАЙЛ() + ", но не записан в " + ЗАМОК())
        } иначе {
            пусть з = п.замок[имя]
            если з.получить("адрес", "") != текст_поля(о, "адрес") или з.получить("версия", "") != текст_поля(о, "версия") {
                итог.добавить(имя + ": в " + ФАЙЛ() + " версия " + или_последняя(текст_поля(о, "версия"), "последняя")
                    + " из " + текст_поля(о, "адрес") + ", а в " + ЗАМОК() + " - "
                    + или_последняя(з.получить("версия", ""), "последняя") + " из " + з.получить("адрес", ""))
            }
        }
    }
    для имя в отсортировано(п.замок.ключи()) {
        если не нужные.содержит(имя) и п.замок[имя].получить("нужен_для", "") == "" {
            итог.добавить(имя + ": записан в " + ЗАМОК() + ", но его нет в " + ФАЙЛ())
        }
    }
    вернуть итог
}

функ установить(п_: Проект, заморожено: лог) -> Проект {
    перем п = п_
    если заморожено {
        пусть расхождения = несогласованность(п)
        если расхождения.длина > 0 {
            п.ошибка = ("замок не согласован с " + ФАЙЛ() + " (выполните: дан пакеты обновить):\n  "
                + расхождения.соединить("\n  "))
            вернуть п
        }
    }
    пусть нужные = зависимости(п)
    для имя в отсортировано(нужные.ключи()) {
        если не п.замок.содержит(имя) {
            п = поставить(п, имя, текст_поля(нужные[имя], "адрес"), текст_поля(нужные[имя], "версия"), "", "", "")
            если п.ошибка != "" { вернуть п }
        }
    }
    пусть снимок = п.замок          // как в paketi.py: записи замка на начало обхода
    для имя в отсортировано(снимок.ключи()) {
        пусть з = снимок[имя]
        пусть папка = папка_пакета(п, имя)
        если это_папка(папка) и контрольная_сумма(папка, п.р) == з.получить("сумма", "") {
            п.сообщения.добавить(имя + ": уже поставлен")
            продолжить
        }
        п = поставить(п, имя, з.получить("адрес", ""), з.получить("версия", ""), з.получить("коммит", ""),
            з.получить("сумма", ""), з.получить("нужен_для", ""))
        если п.ошибка != "" { вернуть п }
    }
    сохранить(п)
    вернуть п
}

функ обновить(п_: Проект, только: стр) -> Проект {
    перем п = п_
    пусть нужные = зависимости(п)
    для имя в отсортировано(нужные.ключи()) {
        если только != "" и имя != только { продолжить }
        перем прежний = ""
        если п.замок.содержит(имя) {
            прежний = п.замок[имя].получить("коммит", "")
            п.замок.удалить(имя)
        }
        п = поставить(п, имя, текст_поля(нужные[имя], "адрес"), текст_поля(нужные[имя], "версия"), "", "", "")
        если п.ошибка != "" { вернуть п }
        перем итог = "обновлён"
        если п.замок[имя].получить("коммит", "") == прежний { итог = "без изменений" }
        п.сообщения.добавить(имя + ": " + итог)
    }
    если только != "" и не нужные.содержит(только) {
        п.ошибка = "в проекте нет пакета «" + только + "»"
        вернуть п
    }
    сохранить(п)
    вернуть п
}

функ удалить(п_: Проект, имя: стр) -> Проект {
    перем п = п_
    перем нужные = зависимости(п)
    если не нужные.содержит(имя) и не п.замок.содержит(имя) {
        п.ошибка = "в проекте нет пакета «" + имя + "»"
        вернуть п
    }
    нужные.удалить(имя)
    п = с_зависимостями(п, нужные)
    п.замок.удалить(имя)
    // зависимости, которые были нужны только ему
    для другое в п.замок.ключи() {
        если п.замок[другое].получить("нужен_для", "") == имя и не нужные.содержит(другое) {
            п.замок.удалить(другое)
            убрать(папка_пакета(п, другое), п.р)
        }
    }
    убрать(папка_пакета(п, имя), п.р)
    сохранить(п)
    вернуть п
}

/// Расхождения между папкой «пакеты» и замком.
функ проверить(п: Проект) -> [стр] {
    перем расхождения = несогласованность(п)
    для имя в отсортировано(п.замок.ключи()) {
        пусть папка = папка_пакета(п, имя)
        если не это_папка(папка) {
            расхождения.добавить(имя + ": не поставлен (выполните: дан пакеты установить)")
        } иначе если контрольная_сумма(папка, п.р) != п.замок[имя].получить("сумма", "") {
            расхождения.добавить(имя + ": файлы пакета изменены после установки")
        }
    }
    вернуть расхождения
}

/// «дан пакеты ...»: выполняет команду в текущей папке; результат - код завершения.
общий функ команда(аргументы: [стр], р: стр) -> цел {
    если аргументы.длина == 0 {
        вывод(справка())
        вернуть 2
    }
    пусть действие = аргументы[0]
    перем остальное: [стр] = []
    для н в 1..аргументы.длина - 1 { остальное.добавить(аргументы[н]) }
    перем папка = найти_проект(текущая_папка(), р)
    если папка == "" { папка = текущая_папка() }
    перем п = открыть(папка, р)
    если п.ошибка == "" {
        если действие == "добавить" и (остальное.длина == 2 или остальное.длина == 3) {
            перем версия = ""
            если остальное.длина == 3 { версия = остальное[2] }
            п = добавить(п, остальное[0], остальное[1], версия)
        } иначе если действие == "установить" и (остальное.длина == 0 или остальное == ["--заморожено"]) {
            п = установить(п, остальное.длина == 1)
        } иначе если действие == "обновить" и остальное.длина <= 1 {
            перем только = ""
            если остальное.длина == 1 { только = остальное[0] }
            п = обновить(п, только)
        } иначе если действие == "удалить" и остальное.длина == 1 {
            п = удалить(п, остальное[0])
            если п.ошибка == "" { п.сообщения.добавить(остальное[0] + ": удалён") }
        } иначе если действие == "список" и остальное.длина == 0 {
            если п.замок.длина == 0 { вывод("В проекте нет пакетов") }
            для имя в отсортировано(п.замок.ключи()) {
                пусть з = п.замок[имя]
                перем откуда = ""
                если з.получить("нужен_для", "") != "" { откуда = " (нужен для " + з["нужен_для"] + ")" }
                вывод(имя + "  " + или_последняя(з.получить("версия", ""), "последняя") + "  "
                    + начало(з.получить("коммит", ""), 12) + "  " + з.получить("адрес", "") + откуда)
            }
            вернуть 0
        } иначе если действие == "проверить" и остальное.длина == 0 {
            пусть расхождения = проверить(п)
            для с в расхождения { вывод(с) }
            если расхождения.длина == 0 { вывод("Пакеты совпадают с контрольными суммами замка") }
            если расхождения.длина > 0 { вернуть 1 }
            вернуть 0
        } иначе {
            вывод(справка())
            вернуть 2
        }
    }
    для с в п.сообщения { вывод(с) }
    если п.ошибка != "" {
        вывод("Ошибка: " + п.ошибка)
        вернуть 1
    }
    вернуть 0
}
