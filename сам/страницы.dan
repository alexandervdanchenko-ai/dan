/// Тексты страниц и справок команд «собрать --веб», «песочница» и «обновить».
///
/// Файл создан сценарием сам/создать_страницы.py из veb.py, pesochnica.py и obnovlenie.py;
/// изменять его вручную не нужно.

/// Страница программы для браузера: на место @@ЗАГОЛОВОК@@, @@WASM@@ и @@СЦЕНАРИЙ@@ вставляются заголовок, модуль WebAssembly (base64) и сценарий.
общий функ веб_страница() -> стр {
    вернуть ("<!doctype html>\n"
    + "<html lang=\"ru\">\n"
    + "<head>\n"
    + "<meta charset=\"utf-8\">\n"
    + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    + "<title>@@ЗАГОЛОВОК@@</title>\n"
    + "<style>\n"
    + "  :root { --фон: #fbfaf7; --текст: #1d1d1b; --тихий: #6b6a66; --ошибка: #b3261e; --рамка: #e4e1da; }\n"
    + "  @media (prefers-color-scheme: dark) {\n"
    + "    :root { --фон: #161614; --текст: #e9e7e2; --тихий: #9b998f; --ошибка: #f2b8b5; --рамка: #2e2d29; }\n"
    + "  }\n"
    + "  body { margin: 0; background: var(--фон); color: var(--текст); font: 16px/1.5 system-ui, sans-serif; }\n"
    + "  main { max-width: 860px; margin: 0 auto; padding: 24px 16px; }\n"
    + "  h1 { font-size: 20px; font-weight: 600; margin: 0 0 4px; }\n"
    + "  #состояние { color: var(--тихий); font-size: 14px; margin-bottom: 16px; }\n"
    + "  pre { margin: 0; padding: 16px; border: 1px solid var(--рамка); border-radius: 8px; white-space: pre-wrap;\n"
    + "        word-break: break-word; font: 15px/1.45 ui-monospace, \"Cascadia Mono\", Consolas, monospace; min-height: 4em; }\n"
    + "  .ошибка { color: var(--ошибка); }\n"
    + "</style>\n"
    + "</head>\n"
    + "<body>\n"
    + "<main>\n"
    + "<h1>@@ЗАГОЛОВОК@@</h1>\n"
    + "<div id=\"состояние\">Программа выполняется...</div>\n"
    + "<pre id=\"вывод\"></pre>\n"
    + "</main>\n"
    + "<script type=\"application/octet-stream\" id=\"программа\">@@WASM@@</script>\n"
    + "<script>@@СЦЕНАРИЙ@@</script>\n"
    + "</body>\n"
    + "</html>\n")
}

/// Сценарий страницы программы для браузера: функции WASI на JavaScript.
общий функ веб_сценарий() -> стр {
    вернуть ("\n"
    + "\"use strict\";\n"
    + "const вывод = document.getElementById(\"вывод\");\n"
    + "const состояние = document.getElementById(\"состояние\");\n"
    + "const декодер = { 1: new TextDecoder(\"utf-8\"), 2: new TextDecoder(\"utf-8\") };\n"
    + "const кодер = new TextEncoder();\n"
    + "let память = null;\n"
    + "let ввод = new Uint8Array(0);\n"
    + "let конецВвода = false;\n"
    + "\n"
    + "class Завершение { constructor(код) { this.код = код; } }\n"
    + "\n"
    + "function показать(fd, байты) {\n"
    + "  const текст = декодер[fd].decode(байты, { stream: true });\n"
    + "  if (!текст) return;\n"
    + "  const часть = document.createElement(\"span\");\n"
    + "  if (fd === 2) часть.className = \"ошибка\";\n"
    + "  часть.textContent = текст;\n"
    + "  вывод.appendChild(часть);\n"
    + "}\n"
    + "\n"
    + "const ENOSYS = 52, EBADF = 8, ENOENT = 44, ESUCCESS = 0;\n"
    + "function вид() { return new DataView(память.buffer); }\n"
    + "\n"
    + "const wasi = {\n"
    + "  args_sizes_get(argc, size) { вид().setUint32(argc, 1, true); вид().setUint32(size, 2, true); return 0; },\n"
    + "  args_get(argv, buf) { вид().setUint32(argv, buf, true); new Uint8Array(память.buffer).set([0x70, 0], buf); return 0; },\n"
    + "  environ_sizes_get(count, size) { вид().setUint32(count, 0, true); вид().setUint32(size, 0, true); return 0; },\n"
    + "  environ_get() { return 0; },\n"
    + "  clock_res_get(id, out) { вид().setBigUint64(out, 1000n, true); return 0; },\n"
    + "  clock_time_get(id, precision, out) {\n"
    + "    const нс = id === 0 ? BigInt(Date.now()) * 1000000n : BigInt(Math.round(performance.now() * 1e6));\n"
    + "    вид().setBigUint64(out, нс, true);\n"
    + "    return 0;\n"
    + "  },\n"
    + "  fd_write(fd, iovs, count, written) {\n"
    + "    if (fd !== 1 && fd !== 2) return EBADF;\n"
    + "    let всего = 0;\n"
    + "    for (let i = 0; i < count; i++) {\n"
    + "      const адрес = вид().getUint32(iovs + i * 8, true), длина = вид().getUint32(iovs + i * 8 + 4, true);\n"
    + "      показать(fd, new Uint8Array(память.buffer, адрес, длина));\n"
    + "      всего += длина;\n"
    + "    }\n"
    + "    вид().setUint32(written, всего, true);\n"
    + "    return 0;\n"
    + "  },\n"
    + "  fd_read(fd, iovs, count, read) {\n"
    + "    if (fd !== 0) return EBADF;\n"
    + "    if (ввод.length === 0 && !конецВвода) {\n"
    + "      const строка = window.prompt(\"Программа ждёт ввода:\", \"\");\n"
    + "      if (строка === null) конецВвода = true;\n"
    + "      else {\n"
    + "        ввод = кодер.encode(строка + \"\\n\");\n"
    + "        показать(1, ввод);\n"
    + "      }\n"
    + "    }\n"
    + "    let всего = 0;\n"
    + "    for (let i = 0; i < count && ввод.length; i++) {\n"
    + "      const адрес = вид().getUint32(iovs + i * 8, true), длина = вид().getUint32(iovs + i * 8 + 4, true);\n"
    + "      const n = Math.min(длина, ввод.length);\n"
    + "      new Uint8Array(память.buffer, адрес, n).set(ввод.subarray(0, n));\n"
    + "      ввод = ввод.subarray(n);\n"
    + "      всего += n;\n"
    + "    }\n"
    + "    вид().setUint32(read, всего, true);\n"
    + "    return 0;\n"
    + "  },\n"
    + "  fd_fdstat_get(fd, out) {\n"
    + "    if (fd > 2) return EBADF;\n"
    + "    new Uint8Array(память.buffer, out, 24).fill(0);\n"
    + "    вид().setUint8(out, 2, true);            // символьное устройство\n"
    + "    return 0;\n"
    + "  },\n"
    + "  fd_fdstat_set_flags() { return 0; },\n"
    + "  fd_prestat_get() { return EBADF; },        // папок нет\n"
    + "  fd_prestat_dir_name() { return EBADF; },\n"
    + "  fd_close() { return 0; },\n"
    + "  fd_seek() { return 70; },                  // ESPIPE\n"
    + "  path_open() { return ENOENT; },\n"
    + "  random_get(buf, len) { crypto.getRandomValues(new Uint8Array(память.buffer, buf, len)); return 0; },\n"
    + "  sched_yield() { return 0; },\n"
    + "  poll_oneoff(inp, out, n, nevents) { вид().setUint32(nevents, 0, true); return 0; },\n"
    + "  proc_exit(код) { throw new Завершение(код); },\n"
    + "};\n"
    + "const импорт = { wasi_snapshot_preview1: new Proxy(wasi, { get: (ц, имя) => ц[имя] || (() => ENOSYS) }) };\n"
    + "\n"
    + "async function запустить() {\n"
    + "  const байты = Uint8Array.from(atob(document.getElementById(\"программа\").textContent.trim()), (с) => с.charCodeAt(0));\n"
    + "  const { instance } = await WebAssembly.instantiate(байты, импорт);\n"
    + "  память = instance.exports.memory;\n"
    + "  let код = 0;\n"
    + "  try {\n"
    + "    instance.exports._start();\n"
    + "  } catch (о) {\n"
    + "    if (о instanceof Завершение) код = о.код;\n"
    + "    else if (о instanceof RangeError) {\n"
    + "      показать(2, кодер.encode(\"\\nОшибка выполнения: слишком глубокая рекурсия (стек браузера исчерпан)\\n\")); код = 1;\n"
    + "    } else { показать(2, кодер.encode(\"\\nОшибка выполнения: \" + о + \"\\n\")); код = 1; }\n"
    + "  }\n"
    + "  показать(1, new Uint8Array(0));\n"
    + "  состояние.textContent = код === 0 ? \"Программа завершена\" : \"Программа завершена с кодом \" + код;\n"
    + "}\n"
    + "запустить();\n")
}

/// Страница песочницы: на место __КЛЮЧ__ вставляется ключ, на место __НАЧАЛО__ - начальная программа (строка JSON).
общий функ песочница_страница() -> стр {
    вернуть ("<!doctype html>\n"
    + "<html lang=\"ru\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
    + "<title>Песочница Дана</title>\n"
    + "<style>\n"
    + ":root { --фон: #fbfaf7; --текст: #1d1d1f; --тихий: #6b6b70; --рамка: #d9d6cc; --поле: #ffffff; --кнопка: #1f5fbf; --ошибка: #b3261e; }\n"
    + "@media (prefers-color-scheme: dark) {\n"
    + "  :root { --фон: #18181a; --текст: #e8e6e1; --тихий: #a0a0a6; --рамка: #3a3a40; --поле: #222226; --кнопка: #5d95ef; --ошибка: #ff8a80; }\n"
    + "}\n"
    + "* { box-sizing: border-box; }\n"
    + "body { margin: 0; background: var(--фон); color: var(--текст); font: 15px/1.5 system-ui, sans-serif; }\n"
    + "header { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; padding: 10px 16px; border-bottom: 1px solid var(--рамка); }\n"
    + "header b { font-size: 17px; margin-right: 8px; }\n"
    + "button, select { font: inherit; padding: 5px 12px; border-radius: 6px; border: 1px solid var(--рамка); background: var(--поле); color: var(--текст); cursor: pointer; }\n"
    + "button.главная { background: var(--кнопка); color: #fff; border-color: var(--кнопка); }\n"
    + "button:disabled { opacity: .6; cursor: default; }\n"
    + "main { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 12px 16px; height: calc(100vh - 58px); }\n"
    + "@media (max-width: 800px) { main { grid-template-columns: 1fr; height: auto; } textarea#код { min-height: 50vh; } }\n"
    + ".столбец { display: flex; flex-direction: column; gap: 8px; min-height: 0; }\n"
    + "textarea { width: 100%; font: 14px/1.5 ui-monospace, Consolas, monospace; background: var(--поле); color: var(--текст);\n"
    + "           border: 1px solid var(--рамка); border-radius: 6px; padding: 10px; resize: none; tab-size: 4; }\n"
    + "#код { flex: 1; white-space: pre; overflow-wrap: normal; overflow: auto; }\n"
    + "#ввод { height: 70px; }\n"
    + "pre#вывод { flex: 1; margin: 0; overflow: auto; white-space: pre-wrap; word-break: break-word; background: var(--поле);\n"
    + "            border: 1px solid var(--рамка); border-radius: 6px; padding: 10px; font: 14px/1.5 ui-monospace, Consolas, monospace; }\n"
    + ".ошибка { color: var(--ошибка); }\n"
    + ".тихо { color: var(--тихий); font-size: 13px; }\n"
    + "</style></head>\n"
    + "<body>\n"
    + "<header>\n"
    + "  <b>Песочница Дана</b>\n"
    + "  <button class=\"главная\" id=\"выполнить\" title=\"Ctrl+Enter\">Выполнить</button>\n"
    + "  <button id=\"формат\">Единый вид</button>\n"
    + "  <select id=\"примеры\"><option value=\"\">Примеры...</option></select>\n"
    + "  <span class=\"тихо\" id=\"состояние\"></span>\n"
    + "</header>\n"
    + "<main>\n"
    + "  <div class=\"столбец\">\n"
    + "    <textarea id=\"код\" spellcheck=\"false\" aria-label=\"Текст программы\"></textarea>\n"
    + "    <label class=\"тихо\" for=\"ввод\">Ввод (по строке на каждый вызов ввод())</label>\n"
    + "    <textarea id=\"ввод\" spellcheck=\"false\"></textarea>\n"
    + "  </div>\n"
    + "  <div class=\"столбец\">\n"
    + "    <pre id=\"вывод\" aria-live=\"polite\"></pre>\n"
    + "  </div>\n"
    + "</main>\n"
    + "<script>\n"
    + "\"use strict\";\n"
    + "const КЛЮЧ = \"__КЛЮЧ__\";\n"
    + "const код = document.getElementById(\"код\"), ввод = document.getElementById(\"ввод\"), вывод = document.getElementById(\"вывод\");\n"
    + "const состояние = document.getElementById(\"состояние\"), кнопка = document.getElementById(\"выполнить\");\n"
    + "let сохранено = null;\n"
    + "try { сохранено = localStorage.getItem(\"песочница-код\"); } catch (e) {}\n"
    + "код.value = сохранено || __НАЧАЛО__;\n"
    + "\n"
    + "async function запрос(путь, данные) {\n"
    + "  const ответ = await fetch(путь, { method: \"POST\", headers: { \"Content-Type\": \"application/json\", \"X-Dan-Key\": КЛЮЧ },\n"
    + "                                    body: JSON.stringify(данные) });\n"
    + "  return ответ.json();\n"
    + "}\n"
    + "\n"
    + "async function выполнить() {\n"
    + "  кнопка.disabled = true; состояние.textContent = \"сборка и выполнение...\";\n"
    + "  вывод.textContent = \"\";\n"
    + "  try { localStorage.setItem(\"песочница-код\", код.value); } catch (e) {}\n"
    + "  try {\n"
    + "    const р = await запрос(\"/выполнить\", { текст: код.value, ввод: ввод.value });\n"
    + "    вывод.textContent = р.вывод;\n"
    + "    if (р.ошибки) { const с = document.createElement(\"span\"); с.className = \"ошибка\"; с.textContent = р.ошибки; вывод.append(с); }\n"
    + "    состояние.textContent = р.состояние;\n"
    + "  } catch (e) {\n"
    + "    состояние.textContent = \"песочница не отвечает: возможно, её окно командной строки закрыто\";\n"
    + "  }\n"
    + "  кнопка.disabled = false;\n"
    + "}\n"
    + "\n"
    + "кнопка.onclick = выполнить;\n"
    + "document.getElementById(\"формат\").onclick = async () => {\n"
    + "  const р = await запрос(\"/формат\", { текст: код.value });\n"
    + "  if (р.текст !== undefined) код.value = р.текст; else состояние.textContent = р.ошибка;\n"
    + "};\n"
    + "код.addEventListener(\"keydown\", (с) => {\n"
    + "  if (с.key === \"Enter\" && (с.ctrlKey || с.metaKey)) { с.preventDefault(); выполнить(); }\n"
    + "  else if (с.key === \"Tab\") {\n"
    + "    с.preventDefault();\n"
    + "    const н = код.selectionStart;\n"
    + "    код.setRangeText(\"    \", н, код.selectionEnd, \"end\");\n"
    + "  }\n"
    + "});\n"
    + "const выбор = document.getElementById(\"примеры\");\n"
    + "запрос(\"/примеры\", {}).then((р) => {\n"
    + "  for (const имя of р.примеры) { const в = document.createElement(\"option\"); в.value = в.textContent = имя; выбор.append(в); }\n"
    + "});\n"
    + "выбор.onchange = async () => {\n"
    + "  if (!выбор.value) return;\n"
    + "  const р = await запрос(\"/пример\", { имя: выбор.value });\n"
    + "  if (р.текст !== undefined) { код.value = р.текст; вывод.textContent = \"\"; состояние.textContent = выбор.value; }\n"
    + "  выбор.value = \"\";\n"
    + "};\n"
    + "</script>\n"
    + "</body></html>\n")
}

/// Начальная программа песочницы.
общий функ песочница_начало() -> стр {
    вернуть ("// Программа на Дане. Ctrl+Enter - выполнить.\n"
    + "пусть имя = \"мир\"\n"
    + "вывод(\"Привет, \" + имя + \"!\")\n"
    + "\n"
    + "для н в 1..5 {\n"
    + "    вывод(стр(н) + \" в квадрате = \" + стр(н * н))\n"
    + "}\n")
}

/// Справка команды «песочница».
общий функ песочница_справка() -> стр {
    вернуть ("Песочница: страница в браузере, где можно написать программу на Дане и сразу выполнить.\n"
    + "\n"
    + "    python dan.py песочница [--порт=8080] [--без-браузера]\n"
    + "\n"
    + "Запускается небольшой сервер только для этого компьютера (адрес 127.0.0.1);\n"
    + "страница открывается в браузере. Программа собирается и выполняется так же,\n"
    + "как командой «dan запустить», в отдельной временной папке; на выполнение\n"
    + "даётся 10 секунд, вывод ограничен мегабайтом. Значения для ввод() задаются в\n"
    + "поле «Ввод» (по строке на каждый вызов).\n"
    + "\n"
    + "Защита: сервер отвечает только на адрес 127.0.0.1 и только запросам со\n"
    + "своей страницы. Страница получает случайный ключ, без которого сервер не\n"
    + "выполняет программы, поэтому сайт, открытый в том же браузере, не может\n"
    + "заставить песочницу выполнить свою программу. Программа в песочнице - обычная\n"
    + "программа на компьютере: она может читать и писать файлы, как любая другая.")
}

/// Справка команды «обновить».
общий функ обновление_справка() -> стр {
    вернуть ("Обновление Дана: dan обновить.\n"
    + "\n"
    + "    python dan.py обновить                   - узнать о новой версии и поставить её\n"
    + "    python dan.py обновить --проверить       - только узнать, есть ли новая версия\n"
    + "    python dan.py обновить --канал=пробный   - получать и пробные выпуски (запоминается)\n"
    + "    python dan.py обновить --канал=стабильный - только стабильные выпуски (так по умолчанию)\n"
    + "\n"
    + "Выпуски берутся со страницы выпусков репозитория Дана на GitHub - это\n"
    + "единственный официальный источник. Канал «стабильный» - обычные выпуски,\n"
    + "канал «пробный» - также пробные выпуски (их номер содержит букву: 1.4b1),\n"
    + "в которых новое можно попробовать до стабильного выпуска.\n"
    + "\n"
    + "Скачанный файл сверяется с контрольной суммой из файла SHA256SUMS.txt\n"
    + "выпуска; без совпадения ничего не запускается и не распаковывается.\n"
    + "Дан, поставленный установщиком, обновляется установщиком новой версии\n"
    + "(он запускается сам после выхода из команды). Переносной архив\n"
    + "распаковывается в новую папку рядом с прежней: старая версия остаётся на\n"
    + "месте, пока не станет не нужна.")
}
