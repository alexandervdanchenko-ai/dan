/// Программа сверки вспомогательных частей проверки: читает из файла задания по одному в
/// строке (части через табуляцию) и печатает ответы. Сверяет их test_sam.py.
///
///     похожее <имя> <кандидаты через |>
///     совместим <тип> <тип>
///     разобрать <тип>                       - запись типа после разбора и сборки
///     подставить <тип> <П=тип;П=тип>
///     имена <тип>
///     сопоставить <шаблон> <тип> <параметры через ,> <связи П=тип;...>
///     функция <тип функции>

подключить "типы"
подключить "похожее"

функ связи_из(текст: стр) -> {стр: стр} {
    перем итог: {стр: стр} = {}
    если текст == "" { вернуть итог }
    для пара в текст.разбить(";") {
        пусть н = пара.найти("=")
        итог[типы.срез(пара, 0, н)] = типы.срез(пара, н + 1, пара.длина)
    }
    вернуть итог
}

функ связи_текстом(связи: {стр: стр}) -> стр {
    перем части: [стр] = []
    для к в похожее.упорядочить(связи.ключи()) { части.добавить(к + "=" + связи[к]) }
    вернуть части.соединить(";")
}

функ список_из(текст: стр, разделитель: стр) -> [стр] {
    если текст == "" { вернуть [] }
    вернуть текст.разбить(разделитель)
}

для строка в прочитать(аргументы()[0]).разбить("\n") {
    если строка == "" { продолжить }
    пусть ч = строка.разбить("\t")
    выбор ч[0] {
        "похожее" { вывод(похожее.похожее_имя(ч[1], список_из(ч[2], "|"))) }
        "совместим" { вывод(стр(типы.совместим(ч[1], ч[2]))) }
        "разобрать" { вывод(типы.собрать(типы.разобрать(ч[1]))) }
        "подставить" { вывод(типы.подставить(ч[1], связи_из(ч[2]))) }
        "имена" { вывод(похожее.упорядочить(типы.имена_в_типе(ч[1])).соединить(",")) }
        "сопоставить" {
            пусть р = типы.сопоставить(ч[1], ч[2], список_из(ч[3], ","), связи_из(ч[4]))
            вывод(стр(р.успех) + " " + связи_текстом(р.связи))
        }
        "функция" {
            пусть ф = типы.разобрать_тип_функции(ч[1])
            вывод(ф.параметры.соединить("|") + " -> " + ф.результат)
        }
        иначе { вывод("?") }
    }
}
