/// Ближайшее по написанию имя для подсказки «возможно, имелось в виду»: то же, что
/// difflib.get_close_matches(имя, кандидаты, n=1, cutoff=0.7) в Python, поэтому
/// подсказки компилятора на Дане и на Python совпадают.
///
/// Сходство двух строк - 2 * M / T, где T - их общая длина, а M - число символов в
/// совпадающих частях, найденных так же, как в difflib.SequenceMatcher: самая длинная
/// общая часть, затем то же слева и справа от неё.

/// Сравнение строк по кодам символов, как в Python: -1, 0 или 1.
общий функ сравнить_строки(а: стр, б: стр) -> цел {
    пусть са = а.символы()
    пусть сб = б.символы()
    перем н = 0
    пока н < са.длина и н < сб.длина {
        пусть ка = код_символа(са[н])
        пусть кб = код_символа(сб[н])
        если ка < кб { вернуть -1 }
        если ка > кб { вернуть 1 }
        н += 1
    }
    если са.длина < сб.длина { вернуть -1 }
    если са.длина > сб.длина { вернуть 1 }
    вернуть 0
}

/// Строки по возрастанию кодов символов, без повторов.
общий функ упорядочить(строки: [стр]) -> [стр] {
    перем итог: [стр] = []
    для с в строки {
        если итог.содержит(с) { продолжить }
        перем место = итог.длина
        пока место > 0 и сравнить_строки(итог[место - 1], с) > 0 { место -= 1 }
        итог.вставить(место, с)
    }
    вернуть итог
}

/// Длина самой длинной общей части а[от_а..до_а) и б[от_б..до_б) и где она начинается.
тип Часть {
    н_а: цел
    н_б: цел
    длина: цел
}

функ самая_длинная(а: [стр], б: [стр], от_а: цел, до_а: цел, от_б: цел, до_б: цел) -> Часть {
    перем лучшая = Часть(от_а, от_б, 0)
    // длины совпадений, оканчивающихся в б[j] для предыдущей буквы а
    перем прежние: {цел: цел} = {}
    для i в от_а..до_а - 1 {
        перем новые: {цел: цел} = {}
        для j в от_б..до_б - 1 {
            если б[j] != а[i] { продолжить }
            пусть к = прежние.получить(j - 1, 0) + 1
            новые[j] = к
            если к > лучшая.длина { лучшая = Часть(i - к + 1, j - к + 1, к) }
        }
        прежние = новые
    }
    вернуть лучшая
}

/// Число символов в совпадающих частях (сумма длин блоков difflib).
функ совпадений(а: [стр], б: [стр], от_а: цел, до_а: цел, от_б: цел, до_б: цел) -> цел {
    если от_а >= до_а или от_б >= до_б { вернуть 0 }
    пусть ч = самая_длинная(а, б, от_а, до_а, от_б, до_б)
    если ч.длина == 0 { вернуть 0 }
    вернуть (ч.длина + совпадений(а, б, от_а, ч.н_а, от_б, ч.н_б)
        + совпадений(а, б, ч.н_а + ч.длина, до_а, ч.н_б + ч.длина, до_б))
}

/// Сходство строк от 0 до 1 (SequenceMatcher(None, а, б).ratio()).
общий функ сходство(а: стр, б: стр) -> дроб {
    пусть са = а.символы()
    пусть сб = б.символы()
    пусть всего = са.длина + сб.длина
    если всего == 0 { вернуть 1.0 }
    вернуть 2.0 * дроб(совпадений(са, сб, 0, са.длина, 0, сб.длина)) / дроб(всего)
}

/// Верхняя оценка сходства по общему набору символов (quick_ratio).
функ быстрая_оценка(а: [стр], б: [стр]) -> дроб {
    перем счёт: {стр: цел} = {}
    для с в б { счёт[с] = счёт.получить(с, 0) + 1 }
    перем общих = 0
    для с в а {
        пусть есть = счёт.получить(с, 0)
        если есть > 0 {
            общих += 1
        }
        счёт[с] = есть - 1
    }
    вернуть 2.0 * дроб(общих) / дроб(а.длина + б.длина)
}

/// Ближайшее к «имя» из кандидатов со сходством не меньше 0,7 или "" (difflib.get_close_matches, n=1).
общий функ похожее_имя(имя: стр, кандидаты: [стр]) -> стр {
    пусть сб = имя.символы()
    перем лучшее = ""
    перем лучшая_оценка = -1.0
    для х в упорядочить(кандидаты) {
        пусть са = х.символы()
        пусть всего = са.длина + сб.длина
        если всего == 0 { продолжить }
        перем меньшая = са.длина
        если сб.длина < меньшая { меньшая = сб.длина }
        если 2.0 * дроб(меньшая) / дроб(всего) < 0.7 { продолжить }
        если быстрая_оценка(са, сб) < 0.7 { продолжить }
        пусть оценка = сходство(х, имя)
        если оценка < 0.7 { продолжить }
        если оценка > лучшая_оценка или (оценка == лучшая_оценка и сравнить_строки(х, лучшее) > 0) {
            лучшее = х
            лучшая_оценка = оценка
        }
    }
    вернуть лучшее
}
