/// Программа сверки: печатает токены файлов, разобранные лексером на Дане.
///
///     python dan.py запустить сам/токены.dan программа.dan [другая.dan ...]
///
/// Для каждого файла - строка «== путь», затем токены по одному в строке
/// или «ОШИБКА» с сообщением.

подключить "лексер"

для путь в аргументы() {
    вывод("== " + путь)
    пусть текст = прочитать(путь)
    если пусть токены = лексер.разобрать(текст) {
        для т в токены { вывод(лексер.показать(т)) }
    } иначе ошибка о {
        вывод("ОШИБКА " + о.заменить("\n", "\\n"))
    }
}
