/// Новый проект: команда «дан новый имя».
///
/// Создаёт папку проекта с программой «главная.dan» (функция, тест и вывод), инструкцией для
/// программ-агентов «AGENTS.md» (как проверять, запускать и тестировать, где правила языка
/// llms-full.txt этой версии), «CLAUDE.md» со ссылкой на неё и «.gitignore» для собранных файлов.

подключить "среда"

функ последняя_часть(путь: стр) -> стр {
    перем имя = путь
    пока имя.длина > 1 и (имя.оканчивается("/") или имя.оканчивается("\\")) { имя = имя[0..имя.длина - 2] }
    для р в ["/", "\\"] {
        пусть части = имя.разбить(р)
        имя = части[части.длина - 1]
    }
    вернуть имя
}

общий функ программа(имя: стр) -> стр {
    вернуть ("/// Программа «" + имя + "».\n\n"
        + "функ приветствие(кому: стр) -> стр {\n"
        + "    вернуть \"Привет, \" + кому + \"!\"\n"
        + "}\n\n"
        + "тест \"приветствие\" {\n"
        + "    утвердить_равно(приветствие(\"мир\"), \"Привет, мир!\")\n"
        + "}\n\n"
        + "вывод(приветствие(\"мир\"))\n")
}

/// Адрес llms-full.txt этой версии Дана в репозитории (по метке версии).
общий функ адрес_llms() -> стр {
    вернуть "https://github.com/alexandervdanchenko-ai/dan/blob/v" + среда.версия() + "/llms-full.txt"
}

/// AGENTS.md проекта; «местный» - путь к llms-full.txt установленного Дана ("" - его нет).
общий функ инструкция(имя: стр, местный: стр) -> стр {
    перем где = "в сети - " + адрес_llms()
    если местный != "" { где = "в установленном Дане - `" + местный + "`, " + где }
    вернуть ("# Инструкция для агентов\n\n"
        + "Проект «" + имя + "» на языке Дан " + среда.версия() + ". Главная программа - `главная.dan`.\n\n"
        + "## Язык\n\n"
        + "Перед тем как писать код, прочитайте правила Дана на одной странице - файл `llms-full.txt` версии "
        + среда.версия() + ": " + где + ". Главное: ключевые слова только русские (`функ`, `пусть`, `перем`, "
        + "`если`, `пока`, `для`, `вернуть`), тело блока всегда в `{ }`, деление `/` точное (целое частное - "
        + "`частное(а, б)`), строка не складывается с числом (`\"итог: \" + стр(х)`), нет `null` и исключений "
        + "(`Т?` и `Т!`).\n\n"
        + "## Команды\n\n"
        + "```\n"
        + "dan проверить главная.dan          # все ошибки сразу; --json - для программ\n"
        + "dan исправить главная.dan          # применить готовые исправления из сообщений\n"
        + "dan запустить главная.dan          # собрать и выполнить\n"
        + "dan тестировать главная.dan        # блоки тест \"...\" { }\n"
        + "dan формат главная.dan             # привести к единому виду\n"
        + "```\n\n"
        + "После каждой правки - `dan проверить`, затем `dan тестировать`; перед сдачей - `dan формат`. "
        + "Каждую новую функцию сопровождайте блоком `тест`.\n\n"
        + "## Инструменты MCP\n\n"
        + "`dan mcp` - сервер Model Context Protocol с инструментами proverit, ispravit, zapustit, testirovat, "
        + "formatirovat и spravka (spravka с vsyo=true даёт llms-full.txt). Подключение к Claude Code: "
        + "`claude mcp add dan -- dan mcp`.\n")
}

общий функ исключения() -> стр {
    вернуть ("# собранные программы и код C, который Дан записывает рядом с исходным файлом\n"
        + "# (уберите строку *.c, если в проекте есть свои файлы C)\n"
        + "*.c\n*.exe\n*.wasm\nглавная\n*_тесты\n*_отладка\n*_профиль\n*_замеры\n"
        + "# покрытие и замеры\n.*_*.txt\n"
        + "# пакеты ставит «dan пакеты установить» по файлу пакеты.замок.json\n"
        + "пакеты/\n")
}

/// «дан новый имя»; «р» - разделитель папок, «папка_дана» - папка установленного Дана.
общий функ создать(путь: стр, р: стр, папка_дана: стр) -> цел {
    если путь == "" или путь.начинается("--") {
        вывод("Как создать проект: дан новый имя (папка «имя» с главная.dan, AGENTS.md, CLAUDE.md и .gitignore)")
        вернуть 2
    }
    если существует(путь) {
        если не это_папка(путь) {
            вывод("Не удалось создать проект: «" + путь + "» - это файл")
            вернуть 1
        }
        если список_файлов(путь).длина > 0 {
            вывод("Не удалось создать проект: папка «" + путь + "» уже есть и не пуста")
            вернуть 1
        }
    } иначе {
        создать_папку(путь)
        если не существует(путь) {
            вывод("Не удалось создать папку «" + путь + "»")
            вернуть 1
        }
    }
    пусть имя = последняя_часть(путь)
    перем местный = папка_дана + р + "llms-full.txt"
    если не существует(местный) { местный = "" }
    записать(путь + р + "главная.dan", программа(имя))
    записать(путь + р + "AGENTS.md", инструкция(имя, местный))
    записать(путь + р + "CLAUDE.md", "@AGENTS.md\n")
    записать(путь + р + ".gitignore", исключения())
    вывод("Создан проект «" + имя + "»: " + путь + р + "главная.dan, AGENTS.md, CLAUDE.md, .gitignore")
    вывод("Дальше: dan запустить " + путь + р + "главная.dan")
    вернуть 0
}
