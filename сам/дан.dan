/// Компилятор Дана, написанный на самом Дане: проверяет программу, переводит её в C
/// и собирает компилятором C (gcc, clang или cc).
///
///     дан проверить программа.dan
///     дан си программа.dan                 - код C в обычный вывод
///     дан собрать программа.dan [--малый]
///     дан запустить программа.dan [значения для программы]
///     дан формат программа.dan [--проверить]
///     дан документация [файл|папка ...] [--в=папка] [--проверить]
///     дан --версия
///
/// Папку установки Дана (в ней папки «библиотека» и «sreda») задаёт переменная
/// среды DAN_HOME, иначе берётся текущая папка. Компилятор C - из переменной
/// DAN_COMPILER или первый найденный из gcc, clang, cc.

подключить "лексер"
подключить "разбор"
подключить "модули"
подключить "проверка"
подключить "встроенные"
подключить "порождение"
подключить "среда"
подключить "формат"
подключить "документация"

функ windows() -> лог {
    пусть ос = переменная_среды("OS") иначе ""
    вернуть ос == "Windows_NT"
}

функ разделитель() -> стр {
    если windows() { вернуть "\\" }
    вернуть "/"
}

функ в_кавычках(с: стр) -> стр { вернуть "\"" + с + "\"" }

/// Команда для оболочки системы: cmd.exe в Windows снимает внешние кавычки, поэтому команда
/// с несколькими частями в кавычках заключается в ещё одни.
функ для_оболочки(команда: стр) -> стр {
    если windows() { вернуть "\"" + команда + "\"" }
    вернуть команда
}

/// Без вывода команды: в обычном выводе и в потоке ошибок.
функ тихо() -> стр {
    если windows() { вернуть " >NUL 2>&1" }
    вернуть " >/dev/null 2>&1"
}

функ справка() -> стр {
    вернуть ("Компилятор языка Дан, написанный на Дане.\n\n"
        + "Команды:\n"
        + "    дан проверить программа.dan     - проверить программу, не собирая её\n"
        + "    дан си программа.dan            - показать код на C\n"
        + "    дан собрать программа.dan       - собрать исполняемый файл\n"
        + "    дан запустить программа.dan ... - собрать и запустить; значения после имени файла получает программа\n"
        + "    дан формат программа.dan        - привести текст программы к единому виду (с --проверить - только проверить)\n"
        + "    дан документация [файл|папка]   - страницы HTML из описаний «///» (--в=папка - в другую папку;\n"
        + "                                      --проверить - выполнить примеры из описаний)\n"
        + "    дан --версия\n\n"
        + "Параметры для «собрать» и «запустить»:\n"
        + "    --малый   оптимизировать программу по размеру, а не по скорости\n\n"
        + "Папку установки (с папками «библиотека» и «sreda») задаёт переменная среды DAN_HOME.\n"
        + "Компилятор C задаёт переменная DAN_COMPILER, иначе берётся gcc, clang или cc.")
}

функ компилятор() -> стр? {
    если пусть заданный = переменная_среды("DAN_COMPILER") {
        если заданный.обрезать() != "" { вернуть заданный.обрезать() }
    }
    для имя в ["gcc", "clang", "cc"] {
        если выполнить_команду(для_оболочки(имя + " --version" + тихо())) == 0 { вернуть имя }
    }
    вернуть ничего
}

функ macos() -> лог {
    если windows() { вернуть ложь }
    пусть система = вывод_команды("uname" + " 2>/dev/null") иначе ""
    вернуть система.обрезать() == "Darwin"
}

/// Библиотеки C, которые подключает программа («внешняя "m" { ... }»): параметры компоновщика.
функ библиотеки_c(код_c: стр, папка: стр) -> [стр] {
    перем итог: [стр] = []
    для строка в код_c.разбить("\n") {
        если не строка.начинается("/* DAN_LINK: ") или не строка.оканчивается(" */") { продолжить }
        пусть имя = строка[13..строка.длина - 4]
        перем параметр = "-l" + имя
        если (имя.оканчивается(".a") или имя.оканчивается(".so") или имя.оканчивается(".dll") или имя.оканчивается(".lib")
                или имя.оканчивается(".o") или имя.содержит("/") или имя.содержит("\\")) {
            если имя.начинается("/") или (имя.длина > 1 и имя[1] == ":") {
                параметр = имя
            } иначе {
                параметр = папка + разделитель() + имя
            }
        }
        если не итог.содержит(параметр) { итог.добавить(параметр) }
    }
    вернуть итог
}

функ папка_файла(путь: стр) -> стр {
    перем конец = -1
    перем н = 0
    для з в путь.символы() {
        если з == "/" или з == "\\" { конец = н }
        н += 1
    }
    если конец < 0 { вернуть "." }
    если конец == 0 { вернуть путь[0..0] }
    вернуть путь[0..конец - 1]
}

функ латиница(с: стр) -> лог {
    для з в с.символы() {
        если код_символа(з) > 127 { вернуть ложь }
    }
    вернуть истина
}

/// Временная папка с латинским именем (для MinGW в Windows) или "".
функ латинская_папка() -> стр {
    перем места: [стр] = []
    для имя в ["TEMP", "PUBLIC"] {
        если пусть м = переменная_среды(имя) { места.добавить(м) }
    }
    места.добавить((переменная_среды("SystemDrive") иначе "C:") + "\\")
    для м в места {
        если м == "" или не латиница(м) или не существует(м) { продолжить }
        перем основа = м
        если не основа.оканчивается("\\") { основа += "\\" }
        пусть папка = основа + "dan" + стр(случайное(100000, 999999))
        если существует(папка) { продолжить }
        создать_папку(папка)
        если существует(папка) { вернуть папка }
    }
    вернуть ""
}

/// Собирает исполняемый файл рядом с исходным; результат - путь к нему.
/// Компилятор MinGW в Windows передаёт имена файлов в кодировке системы и не может
/// записать файл с русскими буквами в имени, если система не русская; поэтому в Windows
/// такие файлы собираются во временной папке с латинским именем и переносятся на место.
функ собрать(путь: стр, код_c: стр, малый: лог) -> стр! {
    перем основа = путь
    если основа.оканчивается(".dan") { основа = основа[0..основа.длина - 5] }
    пусть путь_c = основа + ".c"
    перем путь_exe = основа
    если windows() { путь_exe += ".exe" }
    если документация.это_папка(путь_exe) {
        вернуть ошибка("собранная программа должна называться «" + путь_exe + "», но так называется папка; "
            + "переименуйте папку или файл программы")
    }
    записать(путь_c, код_c)
    пусть команда = компилятор() иначе ""
    если команда == "" {
        вернуть ошибка("не найден компилятор C (gcc, clang или cc); задайте его переменной среды DAN_COMPILER")
    }
    перем удалить_ненужное = "-Wl,--gc-sections"
    если macos() { удалить_ненужное = "-Wl,-dead_strip" }
    перем флаги = ["-std=c11", "-fwrapv", "-ffp-contract=off", "-w", "-s", "-ffunction-sections", "-fdata-sections",
                   удалить_ненужное, "-fno-asynchronous-unwind-tables", "-fno-ident"]
    если малый { флаги.добавить("-Os") } иначе { флаги.добавить("-O2") }
    перем библиотеки = ["-lm"]
    если windows() { библиотеки.добавить("-Wl,--stack,67108864") }
    если код_c.содержит("DAN_TASKS") и не windows() { библиотеки.добавить("-pthread") }
    для б в библиотеки_c(код_c, папка_файла(путь)) { библиотеки.добавить(в_кавычках(б)) }
    если код_c.содержит("#define DAN_GUI 1") и windows() { библиотеки.добавить("-mwindows") }
    если код_c.содержит("#define DAN_NET 1") и не windows() { библиотеки.добавить("-ldl") }
    перем цель_c = путь_c
    перем цель_exe = путь_exe
    перем временная = ""
    если windows() и не латиница(путь_c + путь_exe) {
        временная = латинская_папка()
        если временная != "" {
            цель_c = временная + "\\p.c"
            цель_exe = временная + "\\p.exe"
            записать(цель_c, код_c)
        }
    }
    пусть строка_команды = (в_кавычках(команда) + " " + флаги.соединить(" ") + " " + в_кавычках(цель_c) + " -o "
        + в_кавычках(цель_exe) + " " + библиотеки.соединить(" "))
    перем сбой = ""
    если ошибка о = вывод_команды(для_оболочки(строка_команды + " 2>&1")) { сбой = о }
    если временная != "" {
        если сбой == "" {
            // файл переносится средствами Дана: они работают с русскими буквами в пути на любой системе
            записать(путь_exe, прочитать_байты(цель_exe))
            если не существует(путь_exe) { сбой = "не удалось записать файл " + путь_exe }
        }
        выполнить_команду(для_оболочки("rmdir /s /q " + в_кавычках(временная) + тихо()))
    }
    если сбой != "" {
        вернуть ошибка("компилятор C сообщил об ошибке. Это ошибка самого компилятора Дан, а не вашей программы; "
            + "сохраните файл " + путь_c + " для разбора.\n" + сбой)
    }
    вернуть путь_exe
}

/// Переводит программу в C; при ошибках печатает их и даёт ничего.
/// Итог перевода программы в C.
тип Перевод {
    код: стр = ""
    /// текст ошибки, как его даёт str() исключения в dan.py ("" - ошибок нет)
    ошибка: стр = ""
    /// сообщение об ошибке для вывода, как у «dan проверить»
    сообщение: [стр] = []
    /// итог проверки (дерево программы с пометками): держится, пока нужен переводу
    итог: [проверка.Итог] = []
}

/// Переводит программу в C («тесты» - сборка, выполняющая тесты программы); предупреждения
/// выводятся в поток ошибок, ошибки возвращаются в итоге.
функ перевести_программу(путь: стр, исходник: стр, настройки: модули.Настройки, тесты: лог) -> Перевод {
    // ошибки записи основного файла показываются отдельно от ошибок подключённых файлов
    если пусть токены = лексер.разобрать(исходник) {
        если ошибка о = разбор.разобрать(токены, настройки.редакции, настройки.версия) {
            вернуть Перевод(ошибка = о, сообщение = строки_ошибки_записи(путь, исходник, о))
        }
    } иначе ошибка о {
        вернуть Перевод(ошибка = о, сообщение = строки_ошибки_записи(путь, исходник, о))
    }
    перем дерево = разбор.Узел("?")
    перем файлы: [стр] = []
    перем тексты: [стр] = []
    если пусть программа = модули.загрузить(исходник, путь, настройки) {
        дерево = программа.дерево
        файлы = программа.файлы
        тексты = программа.тексты
    } иначе ошибка о {
        вернуть Перевод(ошибка = о, сообщение = [о])
    }
    пусть итог = проверка.проверить(дерево, встроенные.таблицы())
    если итог.ошибки.длина > 0 {
        перем сообщение_ = [путь + ": найдено ошибок: " + стр(итог.ошибки.длина)]
        перем тексты_ошибок: [стр] = []
        для с в итог.ошибки {
            тексты_ошибок.добавить(сообщение(с, файлы))
            сообщение_.добавить("  " + сообщение(с, файлы))
            пусть показ = фрагмент_места(с.строка, с.столбец, тексты)
            если показ != "" { сообщение_.добавить(показ) }
        }
        вернуть Перевод(ошибка = тексты_ошибок.соединить("\n"), сообщение = сообщение_)
    }
    для п в итог.предупреждения {
        вывод_ошибки(путь + ": предупреждение: " + сообщение(п, файлы))
        пусть показ = фрагмент_места(п.строка, п.столбец, тексты)
        если показ != "" { вывод_ошибки(показ) }
    }
    пусть папка = переменная_среды("DAN_HOME") иначе "."
    пусть порождение_ = порождение.Настройки(среда = папка + разделитель() + "sreda", разделитель = разделитель(),
        тесты = тесты)
    вернуть Перевод(код = порождение.сгенерировать(итог, файлы, тексты, порождение_), итог = [итог])
}

функ строки_ошибки_записи(путь: стр, исходник: стр, о: стр) -> [стр] {
    перем итог = [путь + ": ошибка в записи программы", "  " + о]
    пусть место = модули.место_ошибки(о)
    пусть показ = модули.фрагмент(исходник, место[0], место[1])
    если показ != "" { итог.добавить(показ) }
    вернуть итог
}

/// Фрагмент по номеру строки узла (номер файла хранится в номере строки).
функ фрагмент_места(строка: цел, столбец: цел, тексты: [стр]) -> стр {
    пусть номер = частное(строка, 1000000)
    если номер >= тексты.длина { вернуть "" }
    вернуть модули.фрагмент(тексты[номер], строка % 1000000, столбец)
}

функ сообщение(с: проверка.Сообщение, файлы: [стр]) -> стр {
    пусть номер = частное(с.строка, 1000000)
    если с.строка >= 1000000 и номер < файлы.длина {
        вернуть "Файл " + файлы[номер] + ", строка " + стр(с.строка % 1000000) + ", позиция " + стр(с.столбец) + ": " + с.текст
    }
    вернуть "Строка " + стр(с.строка) + ", позиция " + стр(с.столбец) + ": " + с.текст
}

/// Приводит файл к единому виду (или только проверяет его); сообщения - как у dan.py.
функ форматировать_файл(путь: стр, исходник: стр, только_проверить: лог) -> цел {
    перем новый = ""
    если пусть н = формат.отформатировать(исходник) { новый = н } иначе ошибка о {
        вывод(путь + ": файл не отформатирован: " + о)
        вернуть 1
    }
    если новый == исходник {
        вывод(путь + ": уже в едином виде")
        вернуть 0
    }
    если только_проверить {
        вывод(путь + ": текст отличается от единого вида; выполните: дан формат " + путь)
        вернуть 1
    }
    записать(путь, новый)
    вывод(путь + ": отформатирован")
    вернуть 0
}

функ настройки_модулей() -> модули.Настройки {
    пусть папка = переменная_среды("DAN_HOME") иначе "."
    перем настройки = модули.Настройки(папка + разделитель() + "библиотека", разделитель())
    перем редакции: [стр] = []
    для р в среда.редакции() { редакции.добавить(р[0]) }
    настройки.редакции = редакции
    настройки.версия = среда.версия()
    вернуть настройки
}

функ без_последнего_перевода(текст: стр) -> стр {
    если текст.оканчивается("\n") { вернуть текст[0..текст.длина - 2] }
    вернуть текст
}

функ имя_в_пути(путь: стр) -> стр {
    перем имя = путь
    для р в ["/", "\\"] {
        пусть части = имя.разбить(р)
        имя = части[части.длина - 1]
    }
    вернуть имя
}

/// «дан документация [файл|папка ...] [--в=папка] [--проверить]»: страницы HTML или проверка
/// примеров из описаний; сообщения - как у dan.py.
функ команда_документация(аргументы: [стр]) -> цел {
    пусть настройки = настройки_модулей()
    если не аргументы.содержит("--проверить") {
        вернуть документация.команда(аргументы, настройки.редакции, настройки.версия, разделитель())
    }
    перем цели: [стр] = []
    для а в аргументы {
        если а == "--проверить" или а.начинается("--в=") { продолжить }
        если а.начинается("--") {
            вывод("Неизвестный параметр: " + а)
            вернуть 2
        }
        цели.добавить(а)
    }
    перем модули_: [документация.Модуль] = []
    перем исходники: [стр] = []
    перем плохо = 0
    для путь в документация.файлы_целей(цели, разделитель()) {
        если не существует(путь) {
            вывод("Не удалось открыть файл «" + путь + "»: файл не найден")
            плохо += 1
            продолжить
        }
        пусть исходник = прочитать(путь)
        если пусть м = документация.извлечь(исходник, путь, настройки.редакции, настройки.версия) {
            модули_.добавить(м)
            исходники.добавить(исходник)
        } иначе ошибка о {
            вывод(путь + ": " + о)
            плохо += 1
        }
    }
    если модули_.длина == 0 {
        вывод("Файлов программ не найдено")
        вернуть 1
    }
    перем примеров = 0
    для н в 0..модули_.длина - 1 {
        пусть м = модули_[н]
        для строка в документация.без_описания(м) { вывод(м.путь + ": нет описания: " + строка) }
        пусть пр = документация.текст_проверки(исходники[н], м)
        если пр.текст == "" { продолжить }
        вывод("== " + м.путь + ": примеры")
        // отдельный файл рядом с исходным: подключённые модули находятся так же
        пусть папка = папка_файла(м.путь)
        пусть временный = папка + разделитель() + "." + м.имя + "_примеры.dan"
        записать(временный, пр.текст)
        пусть п = перевести_программу(временный, пр.текст, настройки, истина)
        если п.ошибка != "" {
            вывод(м.путь + ": пример не собирается: " + документация.переписать_строки(п.ошибка, пр.соответствие))
            плохо += 1
            удалить_файл(временный)
            продолжить
        }
        перем исполняемый = ""
        если пусть готовый = собрать(временный, п.код, ложь) {
            исполняемый = готовый
        } иначе ошибка о {
            вывод(м.путь + ": пример не собирается: " + документация.переписать_строки(о, пр.соответствие))
            плохо += 1
            удалить_файл(временный)
            продолжить
        }
        // программа примеров выполняется в папке файла; её вывод собирается в файлы рядом с ней
        пусть файл_вывода = "." + м.имя + "_примеры_вывод.txt"
        пусть файл_ошибок = "." + м.имя + "_примеры_ошибки.txt"
        перем команда_ = ""
        если windows() {
            команда_ = ("cd /d " + в_кавычках(папка) + " && " + в_кавычках(имя_в_пути(исполняемый)) + " >"
                + в_кавычках(файл_вывода) + " 2>" + в_кавычках(файл_ошибок))
        } иначе {
            команда_ = ("cd " + в_кавычках(папка) + " && " + в_кавычках("./" + имя_в_пути(исполняемый)) + " >"
                + в_кавычках(файл_вывода) + " 2>" + в_кавычках(файл_ошибок))
        }
        пусть код = выполнить_команду(для_оболочки(команда_))
        пусть путь_вывода = папка + разделитель() + файл_вывода
        пусть путь_ошибок = папка + разделитель() + файл_ошибок
        перем вывод_ = ""
        если существует(путь_вывода) { вывод_ = прочитать(путь_вывода).заменить("\r\n", "\n") }
        перем ошибки_ = ""
        если существует(путь_ошибок) { ошибки_ = прочитать(путь_ошибок).заменить("\r\n", "\n") }
        если вывод_ != "" { вывод(без_последнего_перевода(документация.переписать_строки(вывод_, пр.соответствие))) }
        если ошибки_ != "" { вывод_ошибки(без_последнего_перевода(ошибки_)) }
        примеров += 1
        если код != 0 { плохо += 1 }
        для лишний в [исполняемый, временный[0..временный.длина - 5] + ".c", временный, путь_вывода, путь_ошибок] {
            если существует(лишний) { удалить_файл(лишний) }
        }
    }
    если примеров == 0 и плохо == 0 { вывод("Примеров кода в описаниях не найдено") }
    если плохо > 0 { вернуть 1 }
    вернуть 0
}

функ главная(аргументы_: [стр]) -> цел {
    если аргументы_ == ["--версия"] {
        перем описания: [стр] = []
        для р в среда.редакции() { описания.добавить(р[0] + " - " + р[1]) }
        вывод("Дан " + среда.версия() + "; редакции языка: " + описания.соединить(", "))
        вернуть 0
    }
    если аргументы_.длина >= 1 и аргументы_[0] == "документация" {
        перем остальные: [стр] = []
        для н в 1..аргументы_.длина - 1 { остальные.добавить(аргументы_[н]) }
        вернуть команда_документация(остальные)
    }
    // параметры стоят до имени файла программы; после него при «запустить» - значения для программы
    перем аргументы = аргументы_
    перем для_программы: [стр] = []
    если аргументы.длина >= 2 и аргументы[0] == "запустить" {
        для н в 1..аргументы.длина - 1 {
            если не аргументы[н].начинается("--") {
                для к в н + 1..аргументы.длина - 1 { для_программы.добавить(аргументы[к]) }
                перем начало: [стр] = []
                для к в 0..н { начало.добавить(аргументы[к]) }
                аргументы = начало
                прервать
            }
        }
    }
    перем параметры: [стр] = []
    перем слова: [стр] = []
    для а в аргументы {
        если а.начинается("--") { параметры.добавить(а) } иначе { слова.добавить(а) }
    }
    перем неизвестные: [стр] = []
    для п в параметры {
        если п != "--малый" и п != "--проверить" { неизвестные.добавить(п) }
    }
    если слова.длина != 2 или не ["проверить", "си", "собрать", "запустить", "формат"].содержит(слова[0]) или неизвестные.длина > 0 {
        если неизвестные.длина > 0 { вывод("Неизвестный параметр: " + неизвестные.соединить(", ") + "\n") }
        вывод(справка())
        вернуть 2
    }
    пусть команда = слова[0]
    пусть путь = слова[1]
    если не существует(путь) {
        вывод("Не удалось открыть файл «" + путь + "»: файл не найден")
        вернуть 2
    }
    пусть исходник = прочитать(путь)
    если команда == "формат" { вернуть форматировать_файл(путь, исходник, параметры.содержит("--проверить")) }
    пусть настройки = настройки_модулей()
    // Перевод держит дерево программы и итог проверки до выхода: программа завершается сразу
    // («завершить»), не освобождая их - освобождать память перед выходом незачем, а на больших
    // программах это занимает заметную долю времени.
    пусть перевод = перевести_программу(путь, исходник, настройки, ложь)
    если перевод.ошибка != "" {
        для с в перевод.сообщение { вывод(с) }
        вернуть 1
    }
    пусть код_c = перевод.код
    если команда == "проверить" {
        вывод(путь + ": ошибок не найдено")
        завершить(0)
    }
    если команда == "си" {
        вывод(код_c[0..код_c.длина - 2])
        завершить(0)
    }
    перем исполняемый = ""
    если пусть готовый = собрать(путь, код_c, параметры.содержит("--малый")) {
        исполняемый = готовый
    } иначе ошибка о {
        вывод("Сборка не удалась: " + о)
        завершить(1)
    }
    если команда == "собрать" {
        вывод("Готово: " + исполняемый + " (" + стр(размер_файла(исполняемый)) + " байт)")
        завершить(0)
    }
    перем запуск = исполняемый
    если не windows() и не запуск.начинается("/") { запуск = "./" + запуск }
    перем строка_команды = в_кавычках(запуск)
    для з в для_программы { строка_команды += " " + в_кавычках(з) }
    завершить(выполнить_команду(для_оболочки(строка_команды)))
    вернуть 0
}

завершить(главная(аргументы()))
