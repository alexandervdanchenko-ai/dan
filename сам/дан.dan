/// Компилятор Дана, написанный на самом Дане: проверяет программу, переводит её в C
/// и собирает компилятором C (gcc, clang или cc).
///
///     дан проверить программа.dan [--json]
///     дан исправить программа.dan
///     дан си программа.dan                 - код C в обычный вывод
///     дан собрать программа.dan [--малый]
///     дан запустить программа.dan [значения для программы]
///     дан формат программа.dan [--проверить]
///     дан документация [файл|папка ...] [--в=папка] [--проверить]
///     дан объяснить программа.dan:строка
///     дан тестировать [файл|папка ...] [--покрытие]
///     дан замерить [файл|папка ...]
///     дан профиль программа.dan [значения для программы]
///     дан отладка программа.dan [значения для программы]
///     дан редакция программа.dan [год]
///     дан пакеты добавить имя адрес [версия]
///     дан задачи
///     дан задача 3
///     дан --версия
///
/// Папку установки Дана (в ней папки «библиотека» и «sreda») задаёт переменная
/// среды DAN_HOME, иначе берётся текущая папка. Компилятор C - из переменной
/// DAN_COMPILER или первый найденный из gcc, clang, cc.

подключить "лексер"
подключить "разбор"
подключить "модули"
подключить "проверка"
подключить "встроенные"
подключить "порождение"
подключить "среда"
подключить "формат"
подключить "документация"
подключить "объяснение"
подключить "отчёты"
подключить "задачник"
подключить "машинный"
подключить "пакеты"
подключить "готовая_среда"

функ windows() -> лог {
    пусть ос = переменная_среды("OS") иначе ""
    вернуть ос == "Windows_NT"
}

функ разделитель() -> стр {
    если windows() { вернуть "\\" }
    вернуть "/"
}

функ в_кавычках(с: стр) -> стр { вернуть "\"" + с + "\"" }

/// Команда для оболочки системы: cmd.exe в Windows снимает внешние кавычки, поэтому команда
/// с несколькими частями в кавычках заключается в ещё одни.
функ для_оболочки(команда: стр) -> стр {
    если windows() { вернуть "\"" + команда + "\"" }
    вернуть команда
}

/// Без вывода команды: в обычном выводе и в потоке ошибок.
функ тихо() -> стр {
    если windows() { вернуть " >NUL 2>&1" }
    вернуть " >/dev/null 2>&1"
}

функ справка() -> стр {
    вернуть ("Компилятор языка Дан, написанный на Дане.\n\n"
        + "Команды:\n"
        + "    дан проверить программа.dan     - проверить программу, не собирая её (--json - для программ)\n"
        + "    дан исправить программа.dan     - применить готовые исправления из сообщений об ошибках\n"
        + "    дан си программа.dan            - показать код на C (--строки-дан - с указаниями «#line» для gdb)\n"
        + "    дан собрать программа.dan       - собрать исполняемый файл\n"
        + "    дан запустить программа.dan ... - собрать и запустить; значения после имени файла получает программа\n"
        + "    дан формат программа.dan        - привести текст программы к единому виду (с --проверить - только проверить)\n"
        + "    дан объяснить программа.dan:12  - объяснить по-русски, что делает строка 12 программы\n"
        + "    дан тестировать [файл|папка]    - выполнить тесты программы (--покрытие - и показать невыполненные строки)\n"
        + "    дан замерить [файл|папка]       - замерить время блоков «замер» и сравнить с прошлым разом\n"
        + "    дан профиль программа.dan ...   - время каждой функции и число её вызовов\n"
        + "    дан отладка программа.dan ...   - выполнить программу по шагам в отладчике\n"
        + "    дан токены программа.dan        - показать токены (слова и знаки) программы\n"
        + "    дан дерево программа.dan        - показать дерево программы\n"
        + "    дан документация [файл|папка]   - страницы HTML из описаний «///» (--в=папка - в другую папку;\n"
        + "                                      --проверить - выполнить примеры из описаний)\n"
        + "    дан редакция программа.dan      - показать, для какой редакции языка написана программа\n"
        + "    дан редакция программа.dan 2026 - перевести программу в редакцию и указать её в файле\n"
        + "    дан пакеты добавить имя адрес [версия] - добавить пакет (репозиторий git) в проект;\n"
        + "                                      также: пакеты установить, обновить [имя], удалить имя, список, проверить\n"
        + "    дан задачи                      - задачник: скопировать задачи в папку «задачи» и показать список\n"
        + "    дан задача 3                    - проверить решение задачи 3\n"
        + "    дан --версия\n\n"
        + "Параметры для «собрать» и «запустить»:\n"
        + "    --малый   оптимизировать программу по размеру, а не по скорости\n\n"
        + "Папку установки (с папками «библиотека» и «sreda») задаёт переменная среды DAN_HOME.\n"
        + "Компилятор C задаёт переменная DAN_COMPILER, иначе берётся gcc, clang или cc.")
}

функ компилятор() -> стр? {
    если пусть заданный = переменная_среды("DAN_COMPILER") {
        если заданный.обрезать() != "" { вернуть заданный.обрезать() }
    }
    для имя в ["gcc", "clang", "cc"] {
        если выполнить_команду(для_оболочки(имя + " --version" + тихо())) == 0 { вернуть имя }
    }
    вернуть ничего
}

функ macos() -> лог {
    если windows() { вернуть ложь }
    пусть система = вывод_команды("uname" + " 2>/dev/null") иначе ""
    вернуть система.обрезать() == "Darwin"
}

/// Библиотеки C, которые подключает программа («внешняя "m" { ... }»): параметры компоновщика.
функ библиотеки_c(код_c: стр, папка: стр) -> [стр] {
    перем итог: [стр] = []
    для строка в код_c.разбить("\n") {
        если не строка.начинается("/* DAN_LINK: ") или не строка.оканчивается(" */") { продолжить }
        пусть имя = строка[13..строка.длина - 4]
        перем параметр = "-l" + имя
        если (имя.оканчивается(".a") или имя.оканчивается(".so") или имя.оканчивается(".dll") или имя.оканчивается(".lib")
            или имя.оканчивается(".o") или имя.содержит("/") или имя.содержит("\\")) {
            если имя.начинается("/") или (имя.длина > 1 и имя[1] == ":") {
                параметр = имя
            } иначе {
                параметр = папка + разделитель() + имя
            }
        }
        если не итог.содержит(параметр) { итог.добавить(параметр) }
    }
    вернуть итог
}

функ папка_файла(путь: стр) -> стр {
    перем конец = -1
    перем н = 0
    для з в путь.символы() {
        если з == "/" или з == "\\" { конец = н }
        н += 1
    }
    если конец < 0 { вернуть "." }
    если конец == 0 { вернуть путь[0..0] }
    вернуть путь[0..конец - 1]
}

функ латиница(с: стр) -> лог {
    для з в с.символы() {
        если код_символа(з) > 127 { вернуть ложь }
    }
    вернуть истина
}

/// Временная папка с латинским именем (для MinGW в Windows) или "".
функ латинская_папка() -> стр {
    перем места: [стр] = []
    для имя в ["TEMP", "PUBLIC"] {
        если пусть м = переменная_среды(имя) { места.добавить(м) }
    }
    места.добавить((переменная_среды("SystemDrive") иначе "C:") + "\\")
    для м в места {
        если м == "" или не латиница(м) или не существует(м) { продолжить }
        перем основа = м
        если не основа.оканчивается("\\") { основа += "\\" }
        пусть папка = основа + "dan" + стр(случайное(100000, 999999))
        если существует(папка) { продолжить }
        создать_папку(папка)
        если существует(папка) { вернуть папка }
    }
    вернуть ""
}

/// Собирает исполняемый файл рядом с исходным; результат - путь к нему.
/// Компилятор MinGW в Windows передаёт имена файлов в кодировке системы и не может
/// записать файл с русскими буквами в имени, если система не русская; поэтому в Windows
/// такие файлы собираются во временной папке с латинским именем и переносятся на место.
/// «выпуск» - сборка с -O3 (команды «собрать» и «замерить»), иначе -O2: программу при правке
/// собирают часто, а сборка с -O3 заметно дольше.
функ собрать(путь: стр, код_c: стр, малый: лог, выпуск: лог) -> стр! {
    перем основа = путь
    если основа.оканчивается(".dan") { основа = основа[0..основа.длина - 5] }
    вернуть собрать_как(основа, путь, код_c, малый, ложь, выпуск)
}

/// Собирает исполняемый файл «основа[.exe]»; «путь» - программа (рядом ищутся её библиотеки C).
функ собрать_как(основа: стр, путь: стр, код_c: стр, малый: лог, отладка: лог, выпуск: лог) -> стр! {
    пусть путь_c = основа + ".c"
    перем путь_exe = основа
    если windows() { путь_exe += ".exe" }
    если документация.это_папка(путь_exe) {
        вернуть ошибка("собранная программа должна называться «" + путь_exe + "», но так называется папка; "
            + "переименуйте папку или файл программы")
    }
    записать(путь_c, код_c)
    пусть команда = компилятор() иначе ""
    если команда == "" {
        вернуть ошибка("не найден компилятор C (gcc, clang или cc); задайте его переменной среды DAN_COMPILER")
    }
    перем удалить_ненужное = "-Wl,--gc-sections"
    если macos() { удалить_ненужное = "-Wl,-dead_strip" }
    перем флаги = ["-std=c11", "-fwrapv", "-ffp-contract=off", "-w", "-s", "-ffunction-sections", "-fdata-sections",
        удалить_ненужное, "-fno-asynchronous-unwind-tables", "-fno-ident"]
    если отладка {
        // сборка для отладчика: без оптимизации и со сведениями для отладки
        перем без_s: [стр] = []
        для ф в флаги {
            если ф != "-s" { без_s.добавить(ф) }
        }
        флаги = без_s
        флаги.добавить("-O0")
        флаги.добавить("-g")
    } иначе если малый {
        флаги.добавить("-Os")
    } иначе если выпуск {
        флаги.добавить("-O3")
    } иначе {
        флаги.добавить("-O2")
    }
    перем библиотеки = ["-lm"]
    если windows() { библиотеки.добавить("-Wl,--stack,67108864") }
    если код_c.содержит("DAN_TASKS") и не windows() { библиотеки.добавить("-pthread") }
    для б в библиотеки_c(код_c, папка_файла(путь)) { библиотеки.добавить(в_кавычках(б)) }
    если код_c.содержит("#define DAN_GUI 1") и windows() { библиотеки.добавить("-mwindows") }
    если код_c.содержит("#define DAN_NET 1") и не windows() { библиотеки.добавить("-ldl") }
    если не отладка и собрать_с_готовой_средой(команда, флаги, библиотеки, путь_c, путь_exe, код_c) {
        вернуть путь_exe
    }
    перем цель_c = путь_c
    перем цель_exe = путь_exe
    перем временная = ""
    если windows() и не латиница(путь_c + путь_exe) {
        временная = латинская_папка()
        если временная != "" {
            цель_c = временная + "\\p.c"
            цель_exe = временная + "\\p.exe"
            записать(цель_c, код_c)
        }
    }
    пусть строка_команды = (в_кавычках(команда) + " " + флаги.соединить(" ") + " " + в_кавычках(цель_c) + " -o "
        + в_кавычках(цель_exe) + " " + библиотеки.соединить(" "))
    перем сбой = ""
    если ошибка о = вывод_команды(для_оболочки(строка_команды + " 2>&1")) { сбой = о }
    если временная != "" {
        если сбой == "" {
            // файл переносится средствами Дана: они работают с русскими буквами в пути на любой системе
            записать(путь_exe, прочитать_байты(цель_exe))
            если не существует(путь_exe) { сбой = "не удалось записать файл " + путь_exe }
        }
        выполнить_команду(для_оболочки("rmdir /s /q " + в_кавычках(временная) + тихо()))
    }
    если сбой != "" {
        вернуть ошибка("компилятор C сообщил об ошибке. Это ошибка самого компилятора Дан, а не вашей программы; "
            + "сохраните файл " + путь_c + " для разбора.\n" + сбой)
    }
    вернуть путь_exe
}

// ---------- заранее собранная среда выполнения (сам/готовая_среда.dan) ----------

/// Пары [группа, текст библиотеки] в порядке кода C: тексты те же, что вставляет порождение.
функ группы_среды() -> [[стр]] {
    пусть папка = (переменная_среды("DAN_HOME") иначе ".") + разделитель() + "sreda" + разделитель()
    вернуть [["данные", прочитать(папка + "dannye.c")], ["pdf", прочитать(папка + "pdf.c")],
        ["система", прочитать(папка + "sistema.c")], ["сеть", прочитать(папка + "set.c")],
        ["база", прочитать(папка + "baza.c")],
        ["математика", [среда.математика(), среда.математика_дополнения(), среда.многочлены_строки(),
            среда.многочлены(), среда.высшая()].соединить("\n")]]
}

функ система_для_кэша() -> стр {
    если windows() { вернуть "windows" }
    если macos() { вернуть "macos" }
    вернуть "unix"
}

/// Объектный файл готовой части (собирается при первом обращении) или "".
функ готовая_часть(текст: стр, команда: стр, флаги: [стр]) -> стр {
    пусть ключ = хеш(среда.версия() + "\n" + система_для_кэша() + "\n" + команда + "\n" + флаги.соединить(" ")
        + "\n" + текст)
    пусть папка = папка_кэша() + разделитель() + "среда"
    пусть готовый = папка + разделитель() + ключ + ".o"
    если существует(готовый) { вернуть готовый }
    создать_папку(папка)
    пусть временный = папка + разделитель() + ключ + "." + стр(случайное(100000, 999999))
    // MinGW в Windows не открывает файлы с русскими буквами в пути, если система не русская:
    // тогда часть собирается во временной папке с латинским именем и переносится средствами Дана
    перем латинская = ""
    перем цель = временный
    если windows() и не латиница(временный) {
        латинская = латинская_папка()
        если латинская == "" { вернуть "" }
        цель = латинская + "\\p"
    }
    записать(цель + ".c", текст)
    пусть строка_команды = (в_кавычках(команда) + " " + флаги.соединить(" ") + " -c " + в_кавычках(цель + ".c")
        + " -o " + в_кавычках(цель + ".o"))
    перем удалось = истина
    если ошибка о = вывод_команды(для_оболочки(строка_команды + " 2>&1")) { удалось = ложь }
    если латинская != "" {
        если удалось и существует(цель + ".o") { записать(временный + ".o", прочитать_байты(цель + ".o")) }
        выполнить_команду(для_оболочки("rmdir /s /q " + в_кавычках(латинская) + тихо()))
    } иначе {
        удалить_файл(временный + ".c")
    }
    если не удалось или не существует(временный + ".o") {
        если существует(временный + ".o") { удалить_файл(временный + ".o") }
        вернуть ""
    }
    если существует(готовый) {
        удалить_файл(временный + ".o")             // другая сборка успела раньше: файл тот же
    } иначе {
        переименовать(временный + ".o", готовый)
    }
    вернуть готовый
}

/// Сборка части программы с готовыми частями среды; ложь - готовая среда не подошла
/// (тогда программа собирается обычным образом).
функ собрать_с_готовой_средой(команда: стр, флаги: [стр], библиотеки: [стр], путь_c: стр, путь_exe: стр,
    код_c: стр) -> лог {
    если (переменная_среды("DAN_NO_CACHE") иначе "") == "1" или (переменная_среды("DAN_GOTOVAYA_SREDA") иначе "") == "0" {
        вернуть ложь
    }
    пусть все_группы = группы_среды()
    пусть среда_ = среда.среда()
    пусть нужные = готовая_среда.группы_программы(код_c, среда_, все_группы)
    если нужные.длина == 0 { вернуть ложь }
    перем выбранные: [[стр]] = []
    для г в все_группы {
        если нужные.содержит(г[0]) { выбранные.добавить(г) }
    }
    перем видимые: [стр] = []
    перем объекты: [стр] = []
    для г в нужные {
        пусть п = перевести_программу("образец.dan", готовая_среда.образец(г), настройки_модулей(), "")
        если п.ошибка != "" { вернуть ложь }
        если пусть часть = готовая_среда.часть_библиотеки(п.код, среда_, г, все_группы) {
            для имя_ в часть.имена {
                если не видимые.содержит(имя_) { видимые.добавить(имя_) }
            }
            пусть объект = готовая_часть(часть.текст, команда, флаги)
            если объект == "" { вернуть ложь }
            объекты.добавить(объект)
        } иначе {
            вернуть ложь
        }
    }
    перем путь_части = путь_c[0..путь_c.длина - 3] + ".часть.c"
    перем цель_exe = путь_exe
    перем входы: [стр] = []
    перем латинская = ""
    если windows() и не латиница(путь_части + путь_exe + объекты.соединить("")) {
        // как в собрать_как: сборка во временной папке с латинским именем
        латинская = латинская_папка()
        если латинская == "" { вернуть ложь }
        путь_части = латинская + "\\p.c"
        цель_exe = латинская + "\\p.exe"
        для н в 0..объекты.длина - 1 {
            пусть копия = латинская + "\\o" + стр(н) + ".o"
            записать(копия, прочитать_байты(объекты[н]))
            входы.добавить(в_кавычках(копия))
        }
    } иначе {
        для о в объекты { входы.добавить(в_кавычках(о)) }
    }
    записать(путь_части, готовая_среда.часть_программы(код_c, среда_, выбранные, видимые).текст)
    пусть строка_команды = (в_кавычках(команда) + " " + флаги.соединить(" ") + " " + в_кавычках(путь_части) + " -o "
        + в_кавычках(цель_exe) + " " + входы.соединить(" ") + " " + библиотеки.соединить(" "))
    перем удалось = истина
    если ошибка о = вывод_команды(для_оболочки(строка_команды + " 2>&1")) { удалось = ложь }
    если латинская != "" {
        если удалось {
            записать(путь_exe, прочитать_байты(цель_exe))
            удалось = существует(путь_exe)
        }
        выполнить_команду(для_оболочки("rmdir /s /q " + в_кавычках(латинская) + тихо()))
    } иначе {
        удалить_файл(путь_части)
    }
    вернуть удалось
}

/// Итог перевода программы в C.
тип Перевод {
    код: стр = ""
    /// текст ошибки, как его даёт str() исключения в dan.py ("" - ошибок нет)
    ошибка: стр = ""
    /// сообщение об ошибке для вывода, как у «dan проверить»
    сообщение: [стр] = []
    /// итог проверки (дерево программы с пометками): держится, пока нужен переводу
    итог: [проверка.Итог] = []
    /// файлы программы и их тексты (для отчёта о покрытии)
    файлы: [стр] = []
    тексты: [стр] = []
}

/// Переводит программу в C; предупреждения выводятся в поток ошибок, ошибки возвращаются в итоге.
/// Режим: "" - программа, "тесты" - сборка, выполняющая тесты, "покрытие" - тесты с учётом
/// выполненных строк, "замеры" - сборка, замеряющая блоки «замер», "профиль" - с замером функций,
/// "отладка" - сборка для отладчика.
функ перевести_программу(путь: стр, исходник: стр, настройки: модули.Настройки, режим: стр) -> Перевод {
    // ошибки записи основного файла показываются отдельно от ошибок подключённых файлов
    если пусть токены = лексер.разобрать(исходник) {
        если ошибка о = разбор.разобрать(токены, настройки.редакции, настройки.версия) {
            вернуть Перевод(ошибка = о, сообщение = строки_ошибки_записи(путь, исходник, о))
        }
    } иначе ошибка о {
        вернуть Перевод(ошибка = о, сообщение = строки_ошибки_записи(путь, исходник, о))
    }
    перем дерево = разбор.Узел("?")
    перем файлы: [стр] = []
    перем тексты: [стр] = []
    если пусть программа = модули.загрузить(исходник, путь, настройки) {
        дерево = программа.дерево
        файлы = программа.файлы
        тексты = программа.тексты
    } иначе ошибка о {
        вернуть Перевод(ошибка = о, сообщение = [о])
    }
    пусть итог = проверка.проверить(дерево, встроенные.таблицы())
    если итог.ошибки.длина > 0 {
        перем сообщение_ = [путь + ": найдено ошибок: " + стр(итог.ошибки.длина)]
        перем тексты_ошибок: [стр] = []
        для с в итог.ошибки {
            тексты_ошибок.добавить(сообщение(с, файлы))
            сообщение_.добавить("  " + сообщение(с, файлы))
            пусть показ = фрагмент_места(с.строка, с.столбец, тексты)
            если показ != "" { сообщение_.добавить(показ) }
        }
        вернуть Перевод(ошибка = тексты_ошибок.соединить("\n"), сообщение = сообщение_)
    }
    для п в итог.предупреждения {
        вывод_ошибки(путь + ": предупреждение: " + сообщение(п, файлы))
        пусть показ = фрагмент_места(п.строка, п.столбец, тексты)
        если показ != "" { вывод_ошибки(показ) }
    }
    пусть папка = переменная_среды("DAN_HOME") иначе "."
    пусть порождение_ = порождение.Настройки(среда = папка + разделитель() + "sreda", разделитель = разделитель(),
        тесты = режим == "тесты" или режим == "покрытие", покрытие = режим == "покрытие", замеры = режим == "замеры",
        профиль = режим == "профиль", отладка = режим == "отладка", строки_дан = режим == "строки")
    вернуть Перевод(код = порождение.сгенерировать(итог, файлы, тексты, порождение_), итог = [итог], файлы = файлы,
        тексты = тексты)
}

функ строки_ошибки_записи(путь: стр, исходник: стр, о: стр) -> [стр] {
    перем итог = [путь + ": ошибка в записи программы", "  " + о]
    пусть место = модули.место_ошибки(о)
    пусть показ = модули.фрагмент(исходник, место[0], место[1])
    если показ != "" { итог.добавить(показ) }
    вернуть итог
}

/// Фрагмент по номеру строки узла (номер файла хранится в номере строки).
функ фрагмент_места(строка: цел, столбец: цел, тексты: [стр]) -> стр {
    пусть номер = частное(строка, 1000000)
    если номер >= тексты.длина { вернуть "" }
    вернуть модули.фрагмент(тексты[номер], строка % 1000000, столбец)
}

функ сообщение(с: проверка.Сообщение, файлы: [стр]) -> стр {
    пусть номер = частное(с.строка, 1000000)
    если с.строка >= 1000000 и номер < файлы.длина {
        вернуть "Файл " + файлы[номер] + ", строка " + стр(с.строка % 1000000) + ", позиция " + стр(с.столбец) + ": " + с.текст
    }
    вернуть "Строка " + стр(с.строка) + ", позиция " + стр(с.столбец) + ": " + с.текст
}

/// Приводит файл к единому виду (или только проверяет его); сообщения - как у dan.py.
функ форматировать_файл(путь: стр, исходник: стр, только_проверить: лог) -> цел {
    перем новый = ""
    если пусть н = формат.отформатировать(исходник) { новый = н } иначе ошибка о {
        вывод(путь + ": файл не отформатирован: " + о)
        вернуть 1
    }
    если новый == исходник {
        вывод(путь + ": уже в едином виде")
        вернуть 0
    }
    если только_проверить {
        вывод(путь + ": текст отличается от единого вида; выполните: дан формат " + путь)
        вернуть 1
    }
    записать(путь, новый)
    вывод(путь + ": отформатирован")
    вернуть 0
}

функ настройки_модулей() -> модули.Настройки {
    пусть папка = переменная_среды("DAN_HOME") иначе "."
    перем настройки = модули.Настройки(папка + разделитель() + "библиотека", разделитель())
    перем редакции: [стр] = []
    для р в среда.редакции() { редакции.добавить(р[0]) }
    настройки.редакции = редакции
    настройки.версия = среда.версия()
    вернуть настройки
}

функ без_последнего_перевода(текст: стр) -> стр {
    если текст.оканчивается("\n") { вернуть текст[0..текст.длина - 2] }
    вернуть текст
}

функ имя_в_пути(путь: стр) -> стр {
    перем имя = путь
    для р в ["/", "\\"] {
        пусть части = имя.разбить(р)
        имя = части[части.длина - 1]
    }
    вернуть имя
}

/// «дан документация [файл|папка ...] [--в=папка] [--проверить]»: страницы HTML или проверка
/// примеров из описаний; сообщения - как у dan.py.
функ команда_документация(аргументы: [стр]) -> цел {
    пусть настройки = настройки_модулей()
    если не аргументы.содержит("--проверить") {
        вернуть документация.команда(аргументы, настройки.редакции, настройки.версия, разделитель())
    }
    перем цели: [стр] = []
    для а в аргументы {
        если а == "--проверить" или а.начинается("--в=") { продолжить }
        если а.начинается("--") {
            вывод("Неизвестный параметр: " + а)
            вернуть 2
        }
        цели.добавить(а)
    }
    перем модули_: [документация.Модуль] = []
    перем исходники: [стр] = []
    перем плохо = 0
    для путь в документация.файлы_целей(цели, разделитель()) {
        если не существует(путь) {
            вывод("Не удалось открыть файл «" + путь + "»: файл не найден")
            плохо += 1
            продолжить
        }
        пусть исходник = прочитать(путь)
        если пусть м = документация.извлечь(исходник, путь, настройки.редакции, настройки.версия) {
            модули_.добавить(м)
            исходники.добавить(исходник)
        } иначе ошибка о {
            вывод(путь + ": " + о)
            плохо += 1
        }
    }
    если модули_.длина == 0 {
        вывод("Файлов программ не найдено")
        вернуть 1
    }
    перем примеров = 0
    для н в 0..модули_.длина - 1 {
        пусть м = модули_[н]
        для строка в документация.без_описания(м) { вывод(м.путь + ": нет описания: " + строка) }
        пусть пр = документация.текст_проверки(исходники[н], м)
        если пр.текст == "" { продолжить }
        вывод("== " + м.путь + ": примеры")
        // отдельный файл рядом с исходным: подключённые модули находятся так же
        пусть папка = папка_файла(м.путь)
        пусть временный = папка + разделитель() + "." + м.имя + "_примеры.dan"
        записать(временный, пр.текст)
        пусть п = перевести_программу(временный, пр.текст, настройки, "тесты")
        если п.ошибка != "" {
            вывод(м.путь + ": пример не собирается: " + документация.переписать_строки(п.ошибка, пр.соответствие))
            плохо += 1
            удалить_файл(временный)
            продолжить
        }
        перем исполняемый = ""
        если пусть готовый = собрать(временный, п.код, ложь, ложь) {
            исполняемый = готовый
        } иначе ошибка о {
            вывод(м.путь + ": пример не собирается: " + документация.переписать_строки(о, пр.соответствие))
            плохо += 1
            удалить_файл(временный)
            продолжить
        }
        // программа примеров выполняется в папке файла; её вывод собирается в файлы рядом с ней
        пусть файл_вывода = "." + м.имя + "_примеры_вывод.txt"
        пусть файл_ошибок = "." + м.имя + "_примеры_ошибки.txt"
        перем команда_ = ""
        если windows() {
            команда_ = ("cd /d " + в_кавычках(папка) + " && " + в_кавычках(имя_в_пути(исполняемый)) + " >"
                + в_кавычках(файл_вывода) + " 2>" + в_кавычках(файл_ошибок))
        } иначе {
            команда_ = ("cd " + в_кавычках(папка) + " && " + в_кавычках("./" + имя_в_пути(исполняемый)) + " >"
                + в_кавычках(файл_вывода) + " 2>" + в_кавычках(файл_ошибок))
        }
        пусть код = выполнить_команду(для_оболочки(команда_))
        пусть путь_вывода = папка + разделитель() + файл_вывода
        пусть путь_ошибок = папка + разделитель() + файл_ошибок
        перем вывод_ = ""
        если существует(путь_вывода) { вывод_ = прочитать(путь_вывода).заменить("\r\n", "\n") }
        перем ошибки_ = ""
        если существует(путь_ошибок) { ошибки_ = прочитать(путь_ошибок).заменить("\r\n", "\n") }
        если вывод_ != "" { вывод(без_последнего_перевода(документация.переписать_строки(вывод_, пр.соответствие))) }
        если ошибки_ != "" { вывод_ошибки(без_последнего_перевода(ошибки_)) }
        примеров += 1
        если код != 0 { плохо += 1 }
        для лишний в [исполняемый, временный[0..временный.длина - 5] + ".c", временный, путь_вывода, путь_ошибок] {
            если существует(лишний) { удалить_файл(лишний) }
        }
    }
    если примеров == 0 и плохо == 0 { вывод("Примеров кода в описаниях не найдено") }
    если плохо > 0 { вернуть 1 }
    вернуть 0
}

/// «дан объяснить программа.dan:строка» (или «программа.dan строка»): объяснение строки по-русски.
функ команда_объяснить(аргументы: [стр]) -> цел {
    если аргументы.длина == 0 {
        вывод("Укажите программу и строку: дан объяснить программа.dan:12")
        вернуть 2
    }
    перем путь = аргументы[0]
    перем номер = ""
    если аргументы.длина > 1 {
        номер = аргументы[1]
    } иначе {
        пусть части = путь.разбить(":")
        пусть последняя = части[части.длина - 1]
        если части.длина > 1 и последняя != "" и (разобрать_цел(последняя) иначе -1) >= 0 и не последняя.содержит("-") {
            номер = последняя
            путь = путь[0..путь.длина - последняя.длина - 2]
        }
    }
    пусть число = разобрать_цел(номер) иначе -1
    если номер == "" или число < 0 или номер.содержит("-") или номер.содержит("+") {
        вывод("Укажите номер строки: дан объяснить программа.dan:12")
        вернуть 2
    }
    если не существует(путь) {
        вывод("Не удалось открыть файл «" + путь + "»: файл не найден")
        вернуть 2
    }
    пусть исходник = прочитать(путь)
    если пусть текст = объяснение.объяснить(исходник, путь, число, настройки_модулей()) {
        вывод(текст)
        вернуть 0
    } иначе ошибка о {
        если о.начинается("Строка ") {
            для с в строки_ошибки_записи(путь, исходник, о) { вывод(с) }
        } иначе {
            вывод(о)
        }
        вывод("Объяснить строку можно, когда программа записана без ошибок записи.")
        вернуть 1
    }
}

/// Выполняет собранную программу в папке «папка» («.» - текущая); «переменная» и «значение» -
/// переменная среды для неё ("" - не нужна). Результат - код завершения.
функ выполнить_в_папке(исполняемый: стр, папка: стр, переменная: стр, значение: стр, аргументы: [стр]) -> цел {
    перем команда_ = ""
    если windows() {
        если папка != "." { команда_ = "cd /d " + в_кавычках(папка) + " && " }
        если переменная != "" { команда_ += "set " + в_кавычках(переменная + "=" + значение) + " && " }
        если папка != "." { команда_ += в_кавычках(имя_в_пути(исполняемый)) } иначе { команда_ += в_кавычках(исполняемый) }
    } иначе {
        если папка != "." { команда_ = "cd " + в_кавычках(папка) + " && " }
        если переменная != "" { команда_ += переменная + "=" + в_кавычках(значение) + " " }
        если папка != "." {
            команда_ += в_кавычках("./" + имя_в_пути(исполняемый))
        } иначе если исполняемый.начинается("/") {
            команда_ += в_кавычках(исполняемый)
        } иначе {
            команда_ += в_кавычках("./" + исполняемый)
        }
    }
    для а в аргументы { команда_ += " " + в_кавычках(а) }
    вернуть выполнить_команду(для_оболочки(команда_))
}

/// Собирает программу в режиме («тесты», «покрытие», «замеры», «профиль») под именем «основа_окончание»;
/// при ошибке печатает её и даёт "".
функ собрать_в_режиме(путь: стр, исходник: стр, режим: стр, окончание: стр) -> Перевод {
    перем п = перевести_программу(путь, исходник, настройки_модулей(), режим)
    если п.ошибка != "" {
        для с в п.сообщение { вывод(с) }
        вернуть п
    }
    перем основа = путь
    если основа.оканчивается(".dan") { основа = основа[0..основа.длина - 5] }
    если пусть готовый = собрать_как(основа + окончание, путь, п.код, ложь, режим == "отладка", режим == "замеры") {
        п.код = готовый                 // дальше нужен путь к собранной программе, а не её код
    } иначе ошибка о {
        вывод("Сборка не удалась: " + о)
        п.ошибка = о
    }
    вернуть п
}

функ файл_данных(путь: стр, что: стр) -> стр {
    пусть папка = папка_файла(путь)
    вернуть папка + разделитель() + "." + основа_имени(путь) + "_" + что + ".txt"
}

функ основа_имени(путь: стр) -> стр {
    перем имя = имя_в_пути(путь)
    если имя.оканчивается(".dan") { имя = имя[0..имя.длина - 5] }
    вернуть имя
}

/// «дан тестировать [файл|папка ...] [--покрытие]»: тесты программ; сообщения - как у dan.py.
функ команда_тестировать(аргументы: [стр]) -> цел {
    пусть покрытие = аргументы.содержит("--покрытие")
    перем цели: [стр] = []
    для а в аргументы {
        если а != "--покрытие" { цели.добавить(а) }
    }
    пусть файлы = документация.файлы_целей(цели, разделитель())
    перем провалено = 0
    перем нет_тестов = 0
    для путь в файлы {
        если не существует(путь) {
            вывод("Не удалось открыть файл «" + путь + "»: файл не найден")
            провалено += 1
            продолжить
        }
        пусть исходник = прочитать(путь)
        если не отчёты.есть_блок(исходник, "тест") {
            нет_тестов += 1
            если цели.длина > 0 и не документация.это_папка(цели[0]) {
                вывод(путь + ": в программе нет тестов; тест пишется так: тест \"что проверяется\" { утвердить(...) }")
            }
            продолжить
        }
        вывод("== " + путь)
        перем режим = "тесты"
        если покрытие { режим = "покрытие" }
        пусть п = собрать_в_режиме(путь, исходник, режим, "_тесты")
        если п.ошибка != "" {
            провалено += 1
            продолжить
        }
        перем данные = ""
        перем переменная = ""
        если покрытие {
            данные = файл_данных(путь, "покрытие")
            переменная = "DAN_COVERAGE"
            если существует(данные) { удалить_файл(данные) }
        }
        если выполнить_в_папке(п.код, папка_файла(путь), переменная, данные, []) != 0 { провалено += 1 }
        если покрытие {
            если существует(данные) {
                перем тексты: {стр: стр} = {}
                для н в 0..п.файлы.длина - 1 {
                    если н < п.тексты.длина { тексты[п.файлы[н]] = п.тексты[н] }
                }
                вывод(отчёты.отчёт_покрытия(прочитать(данные), тексты))
                удалить_файл(данные)
            } иначе {
                вывод("Покрытие не записано: программа тестов завершилась аварийно")
            }
        }
    }
    если нет_тестов == файлы.длина {
        вывод("Тестов не найдено")
        вернуть 1
    }
    если провалено > 0 { вернуть 1 }
    вернуть 0
}

функ папка_кэша() -> стр {
    если пусть задано = переменная_среды("DAN_CACHE") {
        если задано != "" { вернуть задано }
    }
    если windows() {
        пусть основа = переменная_среды("LOCALAPPDATA") иначе (переменная_среды("USERPROFILE") иначе ".")
        вернуть основа + "\\Dan\\cache"
    }
    если пусть кэш = переменная_среды("XDG_CACHE_HOME") {
        если кэш != "" { вернуть кэш + "/dan" }
    }
    вернуть (переменная_среды("HOME") иначе ".") + "/.cache/dan"
}

/// «дан замерить [файл|папка ...]»: время блоков «замер» и сравнение с прошлым замером.
функ команда_замерить(цели: [стр]) -> цел {
    пусть файлы = документация.файлы_целей(цели, разделитель())
    перем сбоев = 0
    перем нет_замеров = 0
    для путь в файлы {
        если не существует(путь) {
            вывод("Не удалось открыть файл «" + путь + "»: файл не найден")
            сбоев += 1
            продолжить
        }
        пусть исходник = прочитать(путь)
        если не отчёты.есть_блок(исходник, "замер") {
            нет_замеров += 1
            если цели.длина > 0 и не документация.это_папка(цели[0]) {
                вывод(путь + ": в программе нет замеров; замер пишется так: замер \"что замеряется\" { ... }")
            }
            продолжить
        }
        вывод("== " + путь)
        пусть п = собрать_в_режиме(путь, исходник, "замеры", "_замеры")
        если п.ошибка != "" {
            сбоев += 1
            продолжить
        }
        пусть данные = файл_данных(путь, "замеры")
        если существует(данные) { удалить_файл(данные) }
        пусть код = выполнить_в_папке(п.код, папка_файла(путь), "DAN_BENCH", данные, [])
        пусть папка = папка_кэша() + разделитель() + "замеры"
        пусть файл_прошлых = папка + разделитель() + хеш(путь)[0..31] + ".json"
        пусть прошлые = отчёты.прочитать_замеры(файл_прошлых)
        перем строки = ["  программа замеров была прервана"]
        перем новые: {стр: [дроб]} = {}
        если существует(данные) {
            пусть з = отчёты.отчёт_замеров(прочитать(данные), прошлые)
            строки = з.строки
            новые = з.новые
            удалить_файл(данные)
        }
        перем ошибка_ = код != 0
        для с в строки {
            вывод(с)
            если с.содержит(" ОШИБКА ") { ошибка_ = истина }
        }
        если ошибка_ { сбоев += 1 }
        если новые.длина > 0 {
            создать_папку(папка)
            отчёты.записать_замеры(файл_прошлых, прошлые, новые)
        }
    }
    если нет_замеров == файлы.длина {
        вывод("Замеров не найдено")
        вернуть 1
    }
    если сбоев > 0 { вернуть 1 }
    вернуть 0
}

/// «дан профиль программа.dan [значения]»: время каждой функции и число её вызовов.
функ команда_профиль(аргументы: [стр]) -> цел {
    если аргументы.длина == 0 {
        вывод("Укажите программу: дан профиль программа.dan [значения для программы]")
        вернуть 2
    }
    пусть путь = аргументы[0]
    если не существует(путь) {
        вывод("Не удалось открыть файл «" + путь + "»: файл не найден")
        вернуть 2
    }
    перем для_программы: [стр] = []
    для н в 1..аргументы.длина - 1 { для_программы.добавить(аргументы[н]) }
    пусть п = собрать_в_режиме(путь, прочитать(путь), "профиль", "_профиль")
    если п.ошибка != "" { вернуть 1 }
    пусть данные = файл_данных(путь, "профиль")
    если существует(данные) { удалить_файл(данные) }
    пусть код = выполнить_в_папке(п.код, ".", "DAN_PROFILE", данные, для_программы)
    если не существует(данные) {
        вывод_ошибки("Программа не записала профиль (она была прервана)")
        если код != 0 { вернуть код }
        вернуть 1
    }
    пусть текст = прочитать(данные)
    удалить_файл(данные)
    если пусть отчёт = отчёты.отчёт_профиля(текст) {
        вывод_ошибки("\n" + отчёт)
    } иначе {
        вывод_ошибки("Программа не записала профиль (она была прервана)")
        если код != 0 { вернуть код }
        вернуть 1
    }
    вернуть код
}

// ---------- редакции ----------

/// Номер строки и год указания «редакция ГОД» в начале текста или [] (как строка_редакции в versiya.py):
/// указание - первая строка, кроме пустых строк и комментариев.
функ строка_редакции(текст: стр) -> [стр] {
    перем номер = 0
    для строка в текст.разбить("\n") {
        номер += 1
        перем с = строка.обрезать()
        если с.начинается(символ_по_коду(65279)) { с = с[1..с.длина - 1] }
        если с == "" или с.начинается("//") { продолжить }
        пусть части = с.разбить("//")[0].разбить()
        если части.длина == 2 и части[0] == "редакция" { вернуть [стр(номер), части[1]] }
        вернуть []
    }
    вернуть []
}

функ номер_в(список: [стр], что: стр) -> цел {
    для н в 0..список.длина - 1 {
        если список[н] == что { вернуть н }
    }
    вернуть -1
}

функ только_цифры(с: стр) -> лог {
    если с == "" { вернуть ложь }
    для з в с.символы() {
        если з < "0" или з > "9" { вернуть ложь }
    }
    вернуть истина
}

/// Сообщение об ошибке для неизвестной редакции или "".
функ ошибка_редакции(год: стр) -> стр {
    перем известные: [стр] = []
    для р в среда.редакции() {
        если р[0] == год { вернуть "" }
        известные.добавить(р[0])
    }
    пусть последняя = известные[известные.длина - 1]
    если только_цифры(год) и (разобрать_цел(год) иначе 0) > цел(последняя) {
        вернуть ("программа написана для редакции языка " + год + ", а этот компилятор (Дан " + среда.версия()
            + ") знает только редакции: " + известные.соединить(", ") + "; обновите компилятор Дана")
    }
    вернуть "неизвестная редакция языка «" + год + "»; известные редакции: " + известные.соединить(", ")
}

функ описание_редакции(год: стр) -> стр {
    для р в среда.редакции() {
        если р[0] == год { вернуть р[1] }
    }
    вернуть ""
}

/// «дан редакция программа.dan [год]»: показать редакцию программы или перевести её в редакцию;
/// сообщения - как у dan.py. Переводов между редакциями пока нет: редакция одна.
функ команда_редакция(путь: стр, год: стр) -> цел {
    если не существует(путь) или документация.это_папка(путь) {
        вывод("Не удалось прочитать файл «" + путь + "» (нужен текст в кодировке UTF-8)")
        вернуть 2
    }
    пусть текст = прочитать(путь)
    пусть указание = строка_редакции(текст)
    перем первая = среда.редакции()[0][0]
    если год == "" {
        если указание.длина == 0 {
            вывод(путь + ": редакция не указана; программа выполняется по правилам первой редакции (" + первая
                + "). Чтобы закрепить её, выполните: дан редакция " + путь + " "
                + среда.редакции()[среда.редакции().длина - 1][0])
            вернуть 0
        }
        пусть ошибка_ = ошибка_редакции(указание[1])
        если ошибка_ != "" {
            вывод(путь + ": " + ошибка_)
            вернуть 1
        }
        вывод(путь + ": редакция " + указание[1] + ", " + описание_редакции(указание[1]))
        вернуть 0
    }
    если ошибка_редакции(год) != "" {
        вывод(путь + ": " + ошибка_редакции(год))
        вернуть 1
    }
    перем из_редакции = первая
    если указание.длина > 0 {
        из_редакции = указание[1]
        если ошибка_редакции(из_редакции) != "" {
            вывод(путь + ": " + ошибка_редакции(из_редакции))
            вернуть 1
        }
    }
    перем порядок: [стр] = []
    для р в среда.редакции() { порядок.добавить(р[0]) }
    если номер_в(порядок, год) < номер_в(порядок, из_редакции) {
        вывод(путь + ": перевод в более раннюю редакцию (" + год + ") невозможен: программа написана для редакции "
            + из_редакции)
        вернуть 1
    }
    перем строки_ = текст.разбить("\n")
    если указание.длина > 0 {
        строки_[цел(указание[0]) - 1] = "редакция " + год
    } иначе {
        перем новые = ["редакция " + год]
        для с в строки_ { новые.добавить(с) }
        строки_ = новые
    }
    пусть новый = строки_.соединить("\n")
    если новый == текст {
        вывод(путь + ": программа уже написана для редакции " + год)
        вернуть 0
    }
    записать(путь, новый)
    вывод(путь + ": переведена в редакцию " + год)
    вернуть 0
}

// ---------- задачник ----------

функ папка_задач() -> стр {
    пусть папка = переменная_среды("DAN_HOME") иначе "."
    вернуть папка + разделитель() + "учебник" + разделитель() + "задачи"
}

/// «дан задачи»: скопировать задачи в папку «задачи» (если их там ещё нет) и показать список.
функ команда_задачи() -> цел {
    пусть рабочая = "задачи"
    создать_папку(рабочая)
    перем скопировано = 0
    для з в задачник.задачи(папка_задач()) {
        для окончание в [".dan", ".проверки"] {
            пусть цель = рабочая + разделитель() + з.имя + окончание
            если не существует(цель) {
                записать(цель, прочитать_байты(папка_задач() + разделитель() + з.имя + окончание))
                если окончание == ".dan" { скопировано += 1 }
            }
        }
    }
    если скопировано > 0 {
        вывод("Задачи скопированы в папку «" + текущая_папка() + разделитель() + рабочая + "».")
    }
    вывод("Задачи (откройте файл, допишите решение и проверьте командой «дан задача номер»):\n")
    для з в задачник.задачи(рабочая) {
        вывод(отчёты.справа(стр(з.номер), 3) + ". " + задачник.условие(прочитать(рабочая + разделитель() + з.имя + ".dan")))
    }
    вернуть 0
}

/// Выполняет собранную программу в её папке не дольше 10 секунд: ввод из «ввод_», вывод и ошибки -
/// в файлы рядом. Результат - [код завершения (-1 - не уложилась), вывод, ошибки].
функ выполнить_с_вводом(исполняемый: стр, путь: стр, ввод_: стр) -> [стр] {
    пусть папка = папка_файла(путь)
    // ввод, вывод и ошибки - во временной папке: в Windows файлы остановленной программы
    // могут быть ещё открыты, поэтому папка удаляется без остановки при неудаче
    пусть временная = создать_временную_папку()
    пусть файлы = [временная + разделитель() + "ввод.txt", временная + разделитель() + "вывод.txt",
                   временная + разделитель() + "ошибки.txt"]
    записать(файлы[0], ввод_)
    перем команда_ = ""
    если windows() {
        команда_ = "cd /d " + в_кавычках(папка) + " && " + в_кавычках(имя_в_пути(исполняемый))
    } иначе {
        команда_ = "cd " + в_кавычках(папка) + " && " + в_кавычках("./" + имя_в_пути(исполняемый))
    }
    команда_ += " <" + в_кавычках(файлы[0]) + " >" + в_кавычках(файлы[1]) + " 2>" + в_кавычках(файлы[2])
    пусть код = выполнить_команду(для_оболочки(команда_), 10.0)
    перем итог = [стр(код), "", ""]
    для н в 1..2 {
        если существует(файлы[н]) { итог[н] = прочитать(файлы[н]) }
    }
    если windows() {
        выполнить_команду(для_оболочки("rmdir /s /q " + в_кавычках(временная) + тихо()))
    } иначе {
        выполнить_команду("rm -rf " + в_кавычках(временная) + тихо())
    }
    вернуть итог
}

/// «дан задача N»: собрать решение задачи N и проверить его на всех наборах; сообщения - как у dan.py.
функ команда_задача(номер_текст: стр) -> цел {
    перем номер = 0
    если пусть н = разобрать_цел(номер_текст.обрезать()) { номер = н } иначе {
        вывод("Номер задачи - число, например: дан задача 3")
        вернуть 2
    }
    пусть рабочая = "задачи"
    перем имя = ""
    для з в задачник.задачи(рабочая) {
        если з.номер == номер и имя == "" { имя = з.имя }
    }
    если имя == "" {
        вывод("Задача " + стр(номер) + " не найдена в папке «" + рабочая + "». Сначала выполните: дан задачи")
        вернуть 2
    }
    пусть путь = рабочая + разделитель() + имя + ".dan"
    перем путь_проверок = рабочая + разделитель() + имя + ".проверки"
    если не существует(путь_проверок) { путь_проверок = папка_задач() + разделитель() + имя + ".проверки" }
    пусть исходник = прочитать(путь)
    пусть наборы = задачник.проверки(прочитать(путь_проверок))
    пусть п = перевести_программу(путь, исходник, настройки_модулей(), "")
    перем исполняемый = ""
    перем сбой = п.ошибка
    если сбой == "" {
        если пусть готовый = собрать(путь, п.код, ложь, ложь) { исполняемый = готовый } иначе ошибка о { сбой = о }
    }
    если сбой != "" {
        вывод("Задача " + стр(номер) + ": программа не собирается.\n" + сбой)
        вернуть 1
    }
    перем пройдено = 0
    перем первое = ""
    перем н = 0
    для набор в наборы {
        н += 1
        пусть р = выполнить_с_вводом(исполняемый, путь, набор[0])
        если р[0] == "-1" {
            если первое == "" {
                первое = "проверка " + стр(н) + ": программа работала дольше 10 секунд (зациклилась?)"
            }
            продолжить
        }
        если р[0] == "0" и задачник.строки(р[1]) == задачник.строки(набор[1]) {
            пройдено += 1
            продолжить
        }
        если первое == "" {
            первое = задачник.расхождение(н, набор[0], набор[1], р[1], р[2], цел(р[0]))
        }
    }
    если пройдено == наборы.длина {
        вывод("Задача " + стр(номер) + " решена: пройдены все проверки (" + стр(наборы.длина) + ").")
        вернуть 0
    }
    вывод("Задача " + стр(номер) + ": пройдено проверок " + стр(пройдено) + " из " + стр(наборы.длина) + ".\n" + первое)
    вернуть 1
}

// ---------- машинный вывод ----------

функ только_цифры_(с: стр) -> лог {
    если с == "" { вернуть ложь }
    для з в с.символы() {
        если з < "0" или з > "9" { вернуть ложь }
    }
    вернуть истина
}

/// Текст сообщения без «Строка N, позиция M: » в начале.
функ без_места(текст: стр) -> стр {
    если текст.начинается("Строка ") и текст.содержит(": ") {
        пусть н = текст.найти(": ")
        вернуть текст[н + 2..текст.длина - 1]
    }
    вернуть текст
}

/// Замечание из сообщения об ошибке подключённого файла (как _разобрать_ошибку_модуля в dan.py).
функ замечание_модуля(текст: стр) -> машинный.Замечание {
    пусть строки = текст.разбить("\n")
    пусть голова = строки[0]
    пусть н = голова.найти(": ")
    перем файл = ""
    перем остаток = голова
    если н >= 0 {
        если н > 0 { файл = голова[0..н - 1] }
        остаток = голова[н + 2..голова.длина - 1]
    }
    перем следующая = 1
    если остаток == "ошибка в записи программы" и строки.длина > 1 {
        остаток = строки[1].обрезать()
        следующая = 2
    }
    перем строка = 0
    перем столбец = 0
    если остаток.начинается("Строка ") и остаток.содержит(": ") {
        пусть место_ = остаток[7..остаток.найти(": ") - 1]
        если место_.содержит(", позиция ") {
            пусть к = место_.найти(", позиция ")
            перем а = ""
            если к > 0 { а = место_[0..к - 1] }
            пусть б = место_[к + 10..место_.длина - 1]
            если только_цифры_(а) и только_цифры_(б) {
                строка = цел(а)
                столбец = цел(б)
                остаток = без_места(остаток)
            }
        }
    }
    перем остальные: [стр] = []
    для к в следующая..строки.длина - 1 { остальные.добавить(строки[к]) }
    вернуть машинный.Замечание("ошибка", файл, строка, столбец, остаток, остальные.соединить("\n"))
}

функ замечание_записи(путь: стр, исходник: стр, о: стр) -> машинный.Замечание {
    пусть место_ = модули.место_ошибки(о)
    вернуть машинный.Замечание("ошибка", путь, место_[0], место_[1], без_места(о),
        модули.фрагмент(исходник, место_[0], место_[1]))
}

/// Ошибки или (если ошибок нет) предупреждения программы для машинного вывода (как замечания в dan.py).
функ замечания(путь: стр, исходник: стр, настройки: модули.Настройки) -> [машинный.Замечание] {
    перем итог: [машинный.Замечание] = []
    перем программа = модули.Программа(разбор.Узел("?"), [])
    если пусть п = модули.загрузить(исходник, путь, настройки) {
        программа = п
    } иначе ошибка о {
        если о.начинается("Строка ") {
            итог.добавить(замечание_записи(путь, исходник, о))
        } иначе {
            итог.добавить(замечание_модуля(о))
        }
        вернуть итог
    }
    пусть проверено = проверка.проверить(программа.дерево, встроенные.таблицы())
    перем вид = "ошибка"
    перем сообщения = проверено.ошибки
    если сообщения.длина == 0 {
        вид = "предупреждение"
        сообщения = проверено.предупреждения
    }
    для с в сообщения {
        пусть номер = частное(с.строка, 1000000)
        перем файл = путь
        если с.строка >= 1000000 и номер < программа.файлы.длина { файл = программа.файлы[номер] }
        итог.добавить(машинный.Замечание(вид, файл, с.строка % 1000000, с.столбец, с.текст,
            фрагмент_места(с.строка, с.столбец, программа.тексты)))
    }
    вернуть итог
}

// ---------- исправить ----------

/// Правка: строка, начало (с нуля, в символах), длина и замена.
тип Правка {
    строка: цел
    начало: цел
    длина: цел
    замена: стр
}

/// Сделанная правка для отчёта.
тип Сделано {
    строка: цел
    было: стр
    стало: стр
}

тип ИтогПравок {
    текст: стр
    сделано: [Сделано]
}

/// Правка «а» идёт раньше «б» при обратном порядке (как sorted(..., reverse=True) в dan.py).
функ позже(а: Правка, б: Правка) -> лог {
    если а.строка != б.строка { вернуть а.строка > б.строка }
    если а.начало != б.начало { вернуть а.начало > б.начало }
    если а.длина != б.длина { вернуть а.длина > б.длина }
    вернуть а.замена > б.замена
}

/// Готовые исправления сообщений об этом файле, начиная с конца (как применить_исправления в dan.py).
функ применить_исправления(путь: стр, исходник: стр, найдено: [машинный.Замечание]) -> ИтогПравок {
    перем правки: [Правка] = []
    для з в найдено {
        пусть м = машинный.место(з.фрагмент, з.столбец)
        если з.файл != путь или м[1] == 0 { продолжить }
        пусть замена = машинный.исправление(з.текст)
        если замена != "" { правки.добавить(Правка(з.строка, м[0], м[1], замена)) }
    }
    // упорядочить по убыванию (строка, позиция, длина, замена)
    для н в 1..правки.длина - 1 {
        перем к = н
        пока к > 0 и позже(правки[к], правки[к - 1]) {
            пусть т_ = правки[к]
            правки[к] = правки[к - 1]
            правки[к - 1] = т_
            к -= 1
        }
    }
    перем строки = исходник.разбить("\n")
    перем сделано: [Сделано] = []
    перем занято: [[цел]] = []          // [строка, начало, конец]
    для п в правки {
        пусть с = строки[п.строка - 1]
        перем сдвиг = 0
        если п.строка == 1 и с.длина > 0 и код_символа(с[0]) == 65279 { сдвиг = 1 }
        пусть начало = п.начало - 1 + сдвиг
        перем было = ""
        если п.длина > 0 и начало < с.длина {
            перем конец = начало + п.длина - 1
            если конец > с.длина - 1 { конец = с.длина - 1 }
            было = с[начало..конец]
        }
        перем пересекается = ложь
        если было == п.замена { продолжить }
        для з в занято {
            если з[0] == п.строка и начало < з[2] и з[1] < начало + п.длина { пересекается = истина }
        }
        если пересекается { продолжить }
        перем до_ = ""
        перем н_ = начало
        если н_ > с.длина { н_ = с.длина }
        если н_ > 0 { до_ = с[0..н_ - 1] }
        перем после = ""
        если начало + п.длина < с.длина { после = с[начало + п.длина..с.длина - 1] }
        строки[п.строка - 1] = до_ + п.замена + после
        занято.добавить([п.строка, начало, начало + п.длина])
        сделано.добавить(Сделано(п.строка, было, п.замена))
    }
    вернуть ИтогПравок(строки.соединить("\n"), сделано)
}

функ раньше(а: Сделано, б: Сделано) -> лог {
    если а.строка != б.строка { вернуть а.строка < б.строка }
    если а.было != б.было { вернуть а.было < б.было }
    вернуть а.стало < б.стало
}

/// «дан исправить файл.dan»: применить все готовые исправления (сообщения - как у dan.py).
функ команда_исправить(путь: стр, настройки: модули.Настройки) -> цел {
    если не существует(путь) {
        вывод("Не удалось открыть файл «" + путь + "»: файл не найден")
        вернуть 2
    }
    если документация.это_папка(путь) {
        вывод("Не удалось открыть файл «" + путь + "»: это папка, а не файл")
        вернуть 2
    }
    пусть исходник = прочитать(путь)
    перем текст = исходник
    перем всего = 0
    перем найдено: [машинный.Замечание] = []
    перем проходов = 0
    пока истина {
        найдено = замечания(путь, текст, настройки)
        если проходов == 20 { прервать }
        проходов += 1
        пусть итог = применить_исправления(путь, текст, найдено)
        если итог.сделано.длина == 0 { прервать }
        перем по_порядку = итог.сделано
        для н в 1..по_порядку.длина - 1 {
            перем к = н
            пока к > 0 и раньше(по_порядку[к], по_порядку[к - 1]) {
                пусть т_ = по_порядку[к]
                по_порядку[к] = по_порядку[к - 1]
                по_порядку[к - 1] = т_
                к -= 1
            }
        }
        для с в по_порядку { вывод("  строка " + стр(с.строка) + ": «" + с.было + "» -> «" + с.стало + "»") }
        всего += итог.сделано.длина
        текст = итог.текст
    }
    если текст != исходник { записать(путь, текст) }
    если всего > 0 {
        вывод(путь + ": исправлено мест: " + стр(всего))
    } иначе {
        вывод(путь + ": готовых исправлений нет")
    }
    перем ошибок = 0
    для з в найдено {
        если з.вид == "ошибка" { ошибок += 1 }
    }
    если ошибок > 0 {
        вывод(путь + ": осталось ошибок: " + стр(ошибок) + "; подробности - команда «проверить»")
        вернуть 1
    }
    вывод(путь + ": ошибок не найдено")
    вернуть 0
}

/// Токен в записи lexer.py (как его печатает «dan токены»): ВИД('значение') строка:столбец.
функ токен_питон(т: лексер.Токен) -> стр {
    перем значение = разбор.питон(т.значение)
    если т.вид == "КОНЕЦ_СТРОКИ" или т.вид == "КОНЕЦ_ФАЙЛА" { значение = "None" }
    если т.вид == "ЦЕЛОЕ" или т.вид == "ДРОБНОЕ" { значение = т.значение }
    вернуть т.вид + "(" + значение + ") " + стр(т.строка) + ":" + стр(т.столбец)
}

функ главная(аргументы_: [стр]) -> цел {
    если аргументы_ == ["--версия"] {
        перем описания: [стр] = []
        для р в среда.редакции() { описания.добавить(р[0] + " - " + р[1]) }
        вывод("Дан " + среда.версия() + "; редакции языка: " + описания.соединить(", "))
        вернуть 0
    }
    если аргументы_.длина == 2 и аргументы_[0] == "исправить" { вернуть команда_исправить(аргументы_[1], настройки_модулей()) }
    если аргументы_.длина >= 2 и аргументы_.длина <= 3 и аргументы_[0] == "редакция" {
        перем год = ""
        если аргументы_.длина == 3 { год = аргументы_[2] }
        вернуть команда_редакция(аргументы_[1], год)
    }
    если аргументы_.длина >= 1 и аргументы_[0] == "пакеты" {
        перем остальные: [стр] = []
        для н в 1..аргументы_.длина - 1 { остальные.добавить(аргументы_[н]) }
        вернуть пакеты.команда(остальные, разделитель())
    }
    если аргументы_ == ["задачи"] { вернуть команда_задачи() }
    если аргументы_.длина == 2 и аргументы_[0] == "задача" { вернуть команда_задача(аргументы_[1]) }
    если аргументы_.длина >= 1 и (аргументы_[0] == "тестировать" или аргументы_[0] == "замерить"
        или аргументы_[0] == "профиль") {
        перем остальные: [стр] = []
        для н в 1..аргументы_.длина - 1 { остальные.добавить(аргументы_[н]) }
        если аргументы_[0] == "тестировать" { вернуть команда_тестировать(остальные) }
        если аргументы_[0] == "замерить" { вернуть команда_замерить(остальные) }
        вернуть команда_профиль(остальные)
    }
    если аргументы_.длина >= 2 и аргументы_[0] == "отладка" {
        // значения после имени файла передаются программе, как у «запустить»
        пусть путь = аргументы_[1]
        если не существует(путь) {
            вывод("Не удалось открыть файл «" + путь + "»: файл не найден")
            вернуть 2
        }
        перем для_программы: [стр] = []
        для н в 2..аргументы_.длина - 1 { для_программы.добавить(аргументы_[н]) }
        пусть п = собрать_в_режиме(путь, прочитать(путь), "отладка", "_отладка")
        если п.ошибка != "" { вернуть 1 }
        вернуть выполнить_в_папке(п.код, ".", "", "", для_программы)
    }
    если аргументы_.длина >= 1 и аргументы_[0] == "объяснить" {
        перем остальные: [стр] = []
        для н в 1..аргументы_.длина - 1 { остальные.добавить(аргументы_[н]) }
        вернуть команда_объяснить(остальные)
    }
    если аргументы_.длина >= 1 и аргументы_[0] == "документация" {
        перем остальные: [стр] = []
        для н в 1..аргументы_.длина - 1 { остальные.добавить(аргументы_[н]) }
        вернуть команда_документация(остальные)
    }
    // параметры стоят до имени файла программы; после него при «запустить» - значения для программы
    перем аргументы = аргументы_
    перем для_программы: [стр] = []
    если аргументы.длина >= 2 и аргументы[0] == "запустить" {
        для н в 1..аргументы.длина - 1 {
            если не аргументы[н].начинается("--") {
                для к в н + 1..аргументы.длина - 1 { для_программы.добавить(аргументы[к]) }
                перем начало: [стр] = []
                для к в 0..н { начало.добавить(аргументы[к]) }
                аргументы = начало
                прервать
            }
        }
    }
    перем параметры: [стр] = []
    перем слова: [стр] = []
    для а в аргументы {
        если а.начинается("--") { параметры.добавить(а) } иначе { слова.добавить(а) }
    }
    перем неизвестные: [стр] = []
    для п в параметры {
        если п != "--малый" и п != "--проверить" и п != "--json" и п != "--строки-дан" { неизвестные.добавить(п) }
    }
    если слова.длина != 2 или не ["проверить", "си", "собрать", "запустить", "формат", "токены", "дерево"].содержит(слова[0]) или неизвестные.длина > 0 {
        если неизвестные.длина > 0 { вывод("Неизвестный параметр: " + неизвестные.соединить(", ") + "\n") }
        вывод(справка())
        вернуть 2
    }
    пусть команда = слова[0]
    пусть путь = слова[1]
    если не существует(путь) {
        вывод("Не удалось открыть файл «" + путь + "»: файл не найден")
        вернуть 2
    }
    пусть исходник = прочитать(путь)
    если команда == "формат" { вернуть форматировать_файл(путь, исходник, параметры.содержит("--проверить")) }
    если команда == "токены" {
        если пусть токены = лексер.разобрать(исходник) {
            для т в токены { вывод(токен_питон(т)) }
            вернуть 0
        } иначе ошибка о {
            для с в строки_ошибки_записи(путь, исходник, о) { вывод(с) }
            вернуть 1
        }
    }
    если команда == "дерево" {
        если пусть программа = модули.загрузить(исходник, путь, настройки_модулей()) {
            вывод(разбор.показать(программа.дерево))
            вернуть 0
        } иначе ошибка о {
            если о.начинается("Строка ") {
                для с в строки_ошибки_записи(путь, исходник, о) { вывод(с) }
            } иначе {
                вывод(о)
            }
            вернуть 1
        }
    }
    пусть настройки = настройки_модулей()
    если команда == "проверить" и параметры.содержит("--json") {
        пусть найдено = замечания(путь, исходник, настройки)
        вывод(машинный.запись_json(путь, найдено))
        для з в найдено {
            если з.вид == "ошибка" { завершить(1) }
        }
        завершить(0)
    }
    // Перевод держит дерево программы и итог проверки до выхода: программа завершается сразу
    // («завершить»), не освобождая их - освобождать память перед выходом незачем, а на больших
    // программах это занимает заметную долю времени.
    перем режим = ""
    если команда == "си" и параметры.содержит("--строки-дан") { режим = "строки" }
    пусть перевод = перевести_программу(путь, исходник, настройки, режим)
    если перевод.ошибка != "" {
        для с в перевод.сообщение { вывод(с) }
        вернуть 1
    }
    пусть код_c = перевод.код
    если команда == "проверить" {
        вывод(путь + ": ошибок не найдено")
        завершить(0)
    }
    если команда == "си" {
        вывод(код_c[0..код_c.длина - 2])
        завершить(0)
    }
    перем исполняемый = ""
    если пусть готовый = собрать(путь, код_c, параметры.содержит("--малый"), команда == "собрать") {
        исполняемый = готовый
    } иначе ошибка о {
        вывод("Сборка не удалась: " + о)
        завершить(1)
    }
    если команда == "собрать" {
        вывод("Готово: " + исполняемый + " (" + стр(размер_файла(исполняемый)) + " байт)")
        завершить(0)
    }
    перем запуск = исполняемый
    если не windows() и не запуск.начинается("/") { запуск = "./" + запуск }
    перем строка_команды = в_кавычках(запуск)
    для з в для_программы { строка_команды += " " + в_кавычках(з) }
    завершить(выполнить_команду(для_оболочки(строка_команды)))
    вернуть 0
}

завершить(главная(аргументы()))
