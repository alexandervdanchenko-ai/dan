/// Объяснение строки программы по-русски, написанное на Дане: «дан объяснить программа.dan:строка».
///
/// Делает то же, что objasnenie.py, и для каждой строки даёт тот же текст
/// (проверяет test_sam.py). Программа разбирается и проверяется, как при
/// сборке, затем для каждой инструкции, записанной в указанной строке,
/// составляется объяснение: что объявляется, что вычисляется и какого типа
/// значения получаются.

подключить "лексер"
подключить "разбор"
подключить "модули"
подключить "проверка"
подключить "встроенные"
подключить "документация"

функ св(у: разбор.Узел, имя: стр) -> стр { вернуть разбор.свойство(у, имя) }
функ ч(у: разбор.Узел, имя: стр) -> разбор.Узел { вернуть разбор.часть(у, имя) }
функ гр(у: разбор.Узел, имя: стр) -> [разбор.Узел] { вернуть разбор.часть_группы(у, имя) }
функ есть(у: разбор.Узел, имя: стр) -> лог { вернуть гр(у, имя).длина > 0 }
функ тип_(у: разбор.Узел) -> стр { вернуть у.пометки.получить("тип_выр", "") }

функ действие(оп: стр) -> стр {
    выбор оп {
        "+" { вернуть "сумма" }
        "-" { вернуть "разность" }
        "*" { вернуть "произведение" }
        "/" { вернуть "частное" }
        "%" { вернуть "остаток от деления" }
        "^" { вернуть "степень" }
        иначе { вернуть "" }
    }
}

функ сравнение(оп: стр) -> стр {
    выбор оп {
        "==" { вернуть "равно" }
        "!=" { вернуть "не равно" }
        "<" { вернуть "меньше" }
        "<=" { вернуть "меньше или равно" }
        ">" { вернуть "больше" }
        ">=" { вернуть "больше или равно" }
        иначе { вернуть "" }
    }
}

функ присваивание(оп: стр) -> стр {
    выбор оп {
        "+=" { вернуть "увеличивается на" }
        "-=" { вернуть "уменьшается на" }
        "*=" { вернуть "умножается на" }
        "/=" { вернуть "делится на" }
        иначе { вернуть "" }
    }
}

функ встроенная(имя: стр) -> стр {
    выбор имя {
        "вывод" { вернуть "выводит значение на экран и переводит строку" }
        "ввод" { вернуть "читает строку, введённую с клавиатуры" }
        "ошибка" { вернуть "создаёт ошибку-значение для результата «Т!»" }
        "канал" { вернуть "создаёт канал для обмена значениями между задачами" }
        "цел" { вернуть "преобразует значение в целое число" }
        "дроб" { вернуть "преобразует значение в дробное число" }
        "рац" { вернуть "создаёт обыкновенную дробь" }
        "стр" { вернуть "записывает значение строкой" }
        "байты" { вернуть "создаёт последовательность байтов" }
        "длинное" { вернуть "создаёт целое число любой длины" }
        "компл" { вернуть "создаёт комплексное число" }
        "дата" { вернуть "создаёт календарную дату" }
        иначе { вернуть "" }
    }
}

функ метод_словами(имя: стр) -> стр {
    выбор имя {
        "добавить" { вернуть "добавляет элемент в конец списка" }
        "вставить" { вернуть "вставляет элемент в список на место с указанным номером" }
        "удалить" { вернуть "удаляет элемент (из списка - по номеру, из словаря - по ключу)" }
        "содержит" { вернуть "проверяет, есть ли такой элемент" }
        "найти" { вернуть "ищет элемент и даёт его номер" }
        "соединить" { вернуть "соединяет строки списка в одну через разделитель" }
        "разбить" { вернуть "разбивает строку на части" }
        "заменить" { вернуть "заменяет в строке одну часть на другую" }
        "обрезать" { вернуть "убирает пробелы в начале и в конце строки" }
        "ключи" { вернуть "даёт список ключей словаря" }
        иначе { вернуть "" }
    }
}

функ слово_типа(т_: стр) -> стр {
    выбор т_ {
        "цел" { вернуть "целое число" }
        "дроб" { вернуть "дробное число" }
        "рац" { вернуть "обыкновенная дробь" }
        "стр" { вернуть "строка" }
        "лог" { вернуть "логическое значение (истина или ложь)" }
        "мн" { вернуть "многочлен" }
        "байты" { вернуть "байты" }
        "длинное" { вернуть "целое число любой длины" }
        "компл" { вернуть "комплексное число" }
        "дата" { вернуть "дата" }
        иначе { вернуть "" }
    }
}

/// Тип по-русски: «цел» - «целое число (тип цел)», «[стр]» - «список (тип [стр])».
общий функ тип_словами(т_: стр) -> стр {
    если т_ == "" { вернуть "" }
    если слово_типа(т_) != "" { вернуть слово_типа(т_) + " (тип " + т_ + ")" }
    если т_.оканчивается("?") {
        вернуть "необязательное значение: " + тип_словами(т_[0..т_.длина - 2]) + " или «ничего»"
    }
    если т_.оканчивается("!") { вернуть "результат, который может оказаться ошибкой (тип " + т_ + ")" }
    если т_.начинается("[") и т_.оканчивается("]") { вернуть "список (тип " + т_ + ")" }
    если т_.начинается("{") и т_.оканчивается("}") { вернуть "словарь (тип " + т_ + ")" }
    если т_.начинается("функ") { вернуть "функция (тип " + т_ + ")" }
    вернуть "значение типа " + т_
}

/// Аргументы вызова словами: «с аргументом «х»», «с аргументами «х», «у»» или «без аргументов».
функ аргументы_словами(у: разбор.Узел) -> стр {
    пусть аргументы = гр(у, "аргументы")
    если аргументы.длина == 0 { вернуть " без аргументов" }
    перем части: [стр] = []
    для а в аргументы { части.добавить("«" + код(а) + "»") }
    если аргументы.длина == 1 { вернуть " с аргументом " + части.соединить(", ") }
    вернуть " с аргументами " + части.соединить(", ")
}

функ строка_кодом(текст: стр) -> стр {
    вернуть "\"" + текст.заменить("\\", "\\\\").заменить("\"", "\\\"").заменить("\n", "\\n") + "\""
}

/// Запись выражения, восстановленная по дереву (для показа частей выражения).
общий функ код(у: разбор.Узел) -> стр {
    выбор у.вид {
        "ЦелоеЧисло" { вернуть св(у, "значение") }
        "ДробноеЧисло" { вернуть св(у, "значение") }
        "Строка" { вернуть строка_кодом(св(у, "значение")) }
        "Логическое" {
            если св(у, "значение") == "True" { вернуть "истина" }
            вернуть "ложь"
        }
        "Ничего" { вернуть "ничего" }
        "Имя" {
            если у.написание != "" { вернуть у.написание }
            вернуть св(у, "имя")
        }
        "Унарная" {
            перем знак = св(у, "оператор")
            если знак == "не" { знак = "не " }
            вернуть знак + в_скобках(ч(у, "операнд"), старшинство(у))
        }
        "Бинарная" {
            пусть с = старшинство(у)
            перем л = в_скобках(ч(у, "левый"), с)
            перем п = в_скобках(ч(у, "правый"), с + 1)
            если св(у, "оператор") == "^" {
                // степень вычисляется справа налево
                л = в_скобках(ч(у, "левый"), с + 1)
                п = в_скобках(ч(у, "правый"), с)
            }
            вернуть л + " " + св(у, "оператор") + " " + п
        }
        "Диапазон" { вернуть код(ч(у, "начало")) + ".." + код(ч(у, "конец")) }
        "Вызов" {
            пусть аргументы = гр(у, "аргументы")
            пусть имена = гр(у, "имена")
            перем части: [стр] = []
            для н в 0..аргументы.длина - 1 {
                если н < имена.длина и имена[н].простые[0].строкой {
                    части.добавить(имена[н].простые[0].значение + " = " + код(аргументы[н]))
                } иначе {
                    части.добавить(код(аргументы[н]))
                }
            }
            вернуть код(ч(у, "функция")) + "(" + части.соединить(", ") + ")"
        }
        "Запуск" { вернуть "запустить " + код(ч(у, "вызов")) }
        "Иначе" { вернуть код(ч(у, "значение")) + " иначе " + код(ч(у, "запасное")) }
        "Поле" { вернуть код(ч(у, "объект")) + "." + св(у, "имя") }
        "Список" {
            перем части: [стр] = []
            для э в гр(у, "элементы") { части.добавить(код(э)) }
            вернуть "[" + части.соединить(", ") + "]"
        }
        "Словарь" {
            пусть ключи = гр(у, "ключи")
            пусть значения = гр(у, "значения")
            перем части: [стр] = []
            для н в 0..ключи.длина - 1 { части.добавить(код(ключи[н]) + ": " + код(значения[н])) }
            вернуть "{" + части.соединить(", ") + "}"
        }
        "Индекс" { вернуть код(ч(у, "объект")) + "[" + код(ч(у, "индекс")) + "]" }
        "Передать" { вернуть код(ч(у, "значение")) + "!" }
        "Лямбда" {
            перем имена: [стр] = []
            для п в гр(у, "параметры") { имена.добавить(св(п, "имя")) }
            если есть(у, "выражение") { вернуть "функ(" + имена.соединить(", ") + ") = " + код(ч(у, "выражение")) }
            вернуть "функ(" + имена.соединить(", ") + ") { ... }"
        }
        иначе { вернуть "..." }
    }
}

/// Чем больше число, тем раньше выполняется действие («иначе» - позже всех).
функ старшинство(у: разбор.Узел) -> цел {
    если у.вид == "Иначе" { вернуть 0 }
    если у.вид == "Бинарная" {
        выбор св(у, "оператор") {
            "или" { вернуть 1 }
            "и" { вернуть 2 }
            "==" { вернуть 4 }
            "!=" { вернуть 4 }
            "<" { вернуть 4 }
            "<=" { вернуть 4 }
            ">" { вернуть 4 }
            ">=" { вернуть 4 }
            "+" { вернуть 5 }
            "-" { вернуть 5 }
            "*" { вернуть 6 }
            "/" { вернуть 6 }
            "%" { вернуть 6 }
            "^" { вернуть 8 }
            иначе { вернуть 5 }
        }
    }
    если у.вид == "Унарная" {
        если св(у, "оператор") == "не" { вернуть 3 }
        вернуть 7
    }
    вернуть 9
}

/// Запись части выражения; в скобках, если её действие выполняется позже, чем нужно.
функ в_скобках(у: разбор.Узел, нужно: цел) -> стр {
    пусть текст = код(у)
    если старшинство(у) < нужно { вернуть "(" + текст + ")" }
    вернуть текст
}

/// Сведения о программе, нужные объяснению.
тип Знания {
    /// описания функций программы (из комментариев «///»)
    функции: {стр: стр} = {}
    /// имена собственных типов программы
    типы: {стр: лог} = {}
    таблицы: встроенные.Таблицы = встроенные.Таблицы()
    описания: {стр: стр} = {}
}

функ с_маленькой(текст: стр) -> стр {
    если текст == "" { вернуть "" }
    пусть с = текст.символы()
    перем итог = с[0].строчные()
    для н в 1..с.длина - 1 { итог += с[н] }
    вернуть итог
}

/// Что делает функция: встроенная, библиотечная или функция программы (её описание ///).
функ описание_функции(имя: стр, з: Знания) -> стр {
    если встроенная(имя) != "" { вернуть встроенная(имя) }
    пусть поиск = лексер.без_ё(имя)
    если з.таблицы.поиск.содержит(поиск) {
        пусть каноническое = з.таблицы.поиск[поиск]
        если з.описания.содержит(каноническое) и з.описания[каноническое] != "" {
            перем текст = з.описания[каноническое].обрезать()
            пока текст.оканчивается(".") { текст = текст[0..текст.длина - 2] }
            вернуть с_маленькой(текст)
        }
    }
    вернуть з.функции.получить(имя, "")
}

функ имя_функции(функция: разбор.Узел) -> стр {
    если функция.вид == "Имя" { вернуть св(функция, "имя") }
    вернуть код(функция)
}

/// Что вычисляет выражение: одна фраза, части выражения показаны записью «...».
общий функ значение_словами(у: разбор.Узел, з: Знания) -> стр {
    пусть т_ = тип_(у)
    выбор у.вид {
        "ЦелоеЧисло" { вернуть ("число " + код(у)).заменить(".", ",") }
        "ДробноеЧисло" { вернуть ("число " + код(у)).заменить(".", ",") }
        "Строка" { вернуть "строка " + код(у) }
        "Логическое" { вернуть "логическое значение «" + код(у) + "»" }
        "Ничего" { вернуть "«ничего» (значения нет)" }
        "Имя" { вернуть "значение «" + код(у) + "»" }
        "Унарная" {
            если св(у, "оператор") == "не" {
                вернуть "отрицание условия «" + код(ч(у, "операнд")) + "» (истина, если оно ложно)"
            }
            вернуть "число «" + код(ч(у, "операнд")) + "» с обратным знаком"
        }
        "Бинарная" {
            пусть л = код(ч(у, "левый"))
            пусть п = код(ч(у, "правый"))
            пусть о = св(у, "оператор")
            если сравнение(о) != "" { вернуть "условие: «" + л + "» " + сравнение(о) + " «" + п + "»" }
            если о == "и" { вернуть "условие: выполнено и «" + л + "», и «" + п + "»" }
            если о == "или" { вернуть "условие: выполнено «" + л + "» или «" + п + "» (хотя бы одно)" }
            если о == "+" и т_ == "стр" { вернуть "строка «" + л + "», к которой приписана строка «" + п + "»" }
            если о == "/" и (у.пометки.получить("деление_целых", "") != "" или т_ == "рац") {
                вернуть ("частное «" + л + "» и «" + п + "»; деление целых чисел «/» точное и даёт обыкновенную дробь "
                    + "(частное без остатка - функция частное(а, б))")
            }
            если о == "^" { вернуть "«" + л + "» в степени «" + п + "»" }
            если о == "%" { вернуть "остаток от деления «" + л + "» на «" + п + "»" }
            если действие(о) != "" { вернуть действие(о) + " «" + л + "» и «" + п + "»" }
        }
        "Диапазон" {
            вернуть "числа от «" + код(ч(у, "начало")) + "» до «" + код(ч(у, "конец")) + "» включительно"
        }
        "Вызов" {
            пусть функция = ч(у, "функция")
            если функция.вид == "Поле" {
                пусть метод = св(функция, "имя")
                перем текст = "результат метода «" + метод + "» значения «" + код(ч(функция, "объект")) + "»"
                если гр(у, "аргументы").длина > 0 { текст += аргументы_словами(у) }
                если метод_словами(метод) != "" { текст += " (метод " + метод_словами(метод) + ")" }
                вернуть текст
            }
            пусть имя = код(функция)
            если з.типы.содержит(имя) {
                перем текст = "новое значение типа «" + имя + "»"
                пусть аргументы = гр(у, "аргументы")
                если аргументы.длина > 0 {
                    перем части: [стр] = []
                    для а в аргументы { части.добавить("«" + код(а) + "»") }
                    текст += ", поля: " + части.соединить(", ")
                }
                вернуть текст
            }
            пусть что = описание_функции(имя_функции(функция), з)
            перем текст = "результат вызова функции «" + имя + "»" + аргументы_словами(у)
            если что != "" { текст += " (функция " + что + ")" }
            вернуть текст
        }
        "Запуск" { вернуть "задача, в которой параллельно выполняется «" + код(ч(у, "вызов")) + "»" }
        "Иначе" {
            вернуть ("значение «" + код(ч(у, "значение")) + "», а если его нет (или вместо него ошибка) - «"
                + код(ч(у, "запасное")) + "»")
        }
        "Поле" {
            если св(у, "имя") == "длина" { вернуть "длина «" + код(ч(у, "объект")) + "»" }
            вернуть "поле «" + св(у, "имя") + "» значения «" + код(ч(у, "объект")) + "»"
        }
        "Список" {
            пусть элементы = гр(у, "элементы")
            если элементы.длина > 0 { вернуть "список из " + стр(элементы.длина) + " элементов" }
            вернуть "пустой список"
        }
        "Словарь" {
            пусть ключи = гр(у, "ключи")
            если ключи.длина > 0 { вернуть "словарь из " + стр(ключи.длина) + " пар «ключ: значение»" }
            вернуть "пустой словарь"
        }
        "Индекс" {
            если т_ != "" и тип_(ч(у, "объект")).начинается("{") {
                вернуть "значение словаря «" + код(ч(у, "объект")) + "» по ключу «" + код(ч(у, "индекс")) + "»"
            }
            вернуть "элемент «" + код(ч(у, "объект")) + "» с номером «" + код(ч(у, "индекс")) + "» (номера начинаются с 0)"
        }
        "Передать" {
            вернуть ("значение «" + код(ч(у, "значение")) + "»; если вместо него ошибка, функция сразу завершается "
                + "и передаёт ошибку тому, кто её вызвал")
        }
        "Лямбда" { вернуть "безымянная функция" }
        иначе { }
    }
    вернуть "значение «" + код(у) + "»"
}

функ ветви(у: разбор.Узел) -> стр {
    если есть(у, "иначе") { вернуть " Иначе выполняется ветвь после «иначе»." }
    вернуть ""
}

функ место_элемента(инстр: разбор.Узел) -> стр {
    если тип_(ч(инстр, "объект")).начинается("{") {
        вернуть "Значение словаря «" + код(ч(инстр, "объект")) + "» по ключу «" + код(ч(инстр, "индекс")) + "»"
    }
    вернуть "Элемент «" + код(ч(инстр, "объект")) + "» с номером «" + код(ч(инстр, "индекс")) + "»"
}

/// Объяснение одной инструкции (или объявления).
общий функ инструкция_словами(инстр: разбор.Узел, з: Знания) -> стр {
    выбор инстр.вид {
        "ОбъявлениеПеременной" {
            пусть изменяемая = св(инстр, "изменяемая") == "True"
            перем текст = "Объявляется постоянная «" + св(инстр, "имя") + "» (её значение нельзя изменить; для изменяемой пишут «перем»)"
            если изменяемая { текст = "Объявляется переменная «" + св(инстр, "имя") + "» (её значение можно менять)" }
            перем т_ = св(инстр, "тип")
            если т_ == "" { т_ = инстр.пометки.получить("тип_итог", "") }
            если т_ == "" { т_ = тип_(ч(инстр, "значение")) }
            если т_ != "" {
                текст += "; тип - " + тип_словами(т_)
                если св(инстр, "тип") == "" { текст += ", он выведен из значения" }
            }
            вернуть текст + ". Значение - " + значение_словами(ч(инстр, "значение"), з) + "."
        }
        "Присваивание" {
            перем имя = инстр.написание
            если имя == "" { имя = св(инстр, "имя") }
            если св(инстр, "оператор") == "=" {
                вернуть "Переменная «" + имя + "» получает новое значение: " + значение_словами(ч(инстр, "значение"), з) + "."
            }
            вернуть "Переменная «" + имя + "» " + присваивание(св(инстр, "оператор")) + " «" + код(ч(инстр, "значение")) + "»."
        }
        "ПрисваиваниеЭлемента" {
            пусть место = место_элемента(инстр)
            если св(инстр, "оператор") == "=" {
                вернуть место + " получает новое значение: " + значение_словами(ч(инстр, "значение"), з) + "."
            }
            вернуть место + " " + присваивание(св(инстр, "оператор")) + " «" + код(ч(инстр, "значение")) + "»."
        }
        "ПрисваиваниеПоля" {
            пусть место = "Поле «" + св(инстр, "имя") + "» значения «" + код(ч(инстр, "объект")) + "»"
            если св(инстр, "оператор") == "=" {
                вернуть место + " получает новое значение: " + значение_словами(ч(инстр, "значение"), з) + "."
            }
            вернуть место + " " + присваивание(св(инстр, "оператор")) + " «" + код(ч(инстр, "значение")) + "»."
        }
        "Выражение" {
            пусть в_ = ч(инстр, "выражение")
            если в_.вид == "Вызов" и ч(в_, "функция").вид == "Поле" {
                пусть функция = ч(в_, "функция")
                пусть метод = св(функция, "имя")
                перем текст = "Вызывается метод «" + метод + "» значения «" + код(ч(функция, "объект")) + "»"
                если гр(в_, "аргументы").длина > 0 { текст += аргументы_словами(в_) }
                если метод_словами(метод) != "" { вернуть текст + ": он " + метод_словами(метод) + "." }
                вернуть текст + "."
            }
            если в_.вид == "Вызов" {
                пусть функция = ч(в_, "функция")
                пусть что = описание_функции(имя_функции(функция), з)
                пусть текст = "Вызывается функция «" + код(функция) + "»" + аргументы_словами(в_)
                если что != "" { вернуть текст + ": она " + что + "." }
                вернуть текст + "."
            }
            вернуть "Вычисляется " + значение_словами(в_, з) + "."
        }
        "Если" {
            вернуть ("Проверяется " + значение_словами(ч(инстр, "условие"), з) + ". Если оно истинно, выполняется блок "
                + "в фигурных скобках." + ветви(инстр))
        }
        "ЕслиЕсть" {
            пусть текст = ("Вычисляется «" + код(ч(инстр, "значение")) + "». Если значение есть (не «ничего» и не ошибка), "
                + "оно получает имя «" + св(инстр, "имя") + "» и выполняется блок в фигурных скобках.")
            если св(инстр, "имя_ошибки") != "" {
                вернуть (текст + " Если вместо значения ошибка, она получает имя «" + св(инстр, "имя_ошибки")
                    + "» и выполняется ветвь «иначе».")
            }
            вернуть текст + ветви(инстр)
        }
        "ЕслиОшибка" {
            вернуть ("Вычисляется «" + код(ч(инстр, "значение")) + "». Если вместо значения получилась ошибка, она получает имя "
                + "«" + св(инстр, "имя") + "» и выполняется блок в фигурных скобках." + ветви(инстр))
        }
        "Пока" {
            вернуть ("Цикл «пока»: блок повторяется, пока истинно " + значение_словами(ч(инстр, "условие"), з) + ". "
                + "Условие проверяется перед каждым повторением.")
        }
        "Для" {
            пусть источник = ч(инстр, "источник")
            перем что = ""
            если источник.вид == "Диапазон" {
                что = "числа от «" + код(ч(источник, "начало")) + "» до «" + код(ч(источник, "конец")) + "» включительно"
            } иначе {
                пусть т_ = тип_(источник)
                если т_ == "стр" {
                    что = "символы строки «" + код(источник) + "»"
                } иначе если т_.начинается("{") {
                    что = "ключи словаря «" + код(источник) + "»"
                } иначе если т_.начинается("канал") {
                    что = "значения из канала «" + код(источник) + "» (пока канал не закрыт)"
                } иначе {
                    что = "элементы «" + код(источник) + "»"
                }
            }
            вернуть ("Цикл «для»: переменная «" + св(инстр, "переменная") + "» по очереди принимает " + что
                + ", и для каждого выполняется блок.")
        }
        "Вернуть" {
            если не есть(инстр, "значение") { вернуть "Функция завершается." }
            вернуть "Функция завершается и возвращает " + значение_словами(ч(инстр, "значение"), з) + "."
        }
        "Прервать" { вернуть "Цикл прерывается: выполнение продолжается с инструкции после него." }
        "Продолжить" { вернуть "Остаток блока пропускается: цикл сразу переходит к следующему повторению." }
        "Выбор" {
            вернуть ("Выбор по значению «" + код(ч(инстр, "значение")) + "»: выполняется первая ветвь, образец которой совпал "
                + "со значением.")
        }
        "Параллельно" {
            вернуть "Блок «параллельно»: задачи, запущенные в нём, выполняются одновременно, а блок ждёт, пока все они закончатся."
        }
        "Функция" {
            если инстр.текст != "" и инстр.пометки.получить("замер", "") != "" {
                вернуть "Замер «" + инстр.текст + "»: его время измеряет команда «dan замерить»; при обычном запуске он не выполняется."
            }
            если инстр.текст != "" {
                вернуть "Тест «" + инстр.текст + "»: его выполняет команда «dan тестировать»; при обычном запуске он не выполняется."
            }
            перем параметры: [стр] = []
            для п в гр(инстр, "параметры") { параметры.добавить("«" + св(п, "имя") + "» типа " + св(п, "тип")) }
            перем имя = св(инстр, "имя")
            перем вид = "функция"
            если св(инстр, "метод_типа") != "" {
                пусть части = имя.разбить(".")
                имя = св(инстр, "метод_типа") + "." + части[части.длина - 1]
                вид = "метод"
            }
            перем текст = "Объявляется " + вид + " «" + имя + "»"
            если параметры.длина == 0 {
                текст += " без параметров"
            } иначе если параметры.длина == 1 {
                текст += " с параметром " + параметры.соединить(", ")
            } иначе {
                текст += " с параметрами " + параметры.соединить(", ")
            }
            пусть результат = св(инстр, "тип_результата")
            если результат != "" и результат != "пусто" {
                текст += "; она возвращает " + тип_словами(результат)
            } иначе {
                текст += "; она ничего не возвращает"
            }
            вернуть текст + ". Тело функции - блок в фигурных скобках; оно выполняется при каждом вызове."
        }
        "ОбъявлениеТипа" {
            перем поля: [стр] = []
            для п в гр(инстр, "поля") {
                перем имя = св(п, "написание")
                если имя == "" { имя = св(п, "имя") }
                поля.добавить("«" + имя + "» типа " + св(п, "тип"))
            }
            перем текст = "Объявляется собственный тип «" + св(инстр, "имя") + "»"
            если поля.длина > 0 { текст += " с полями " + поля.соединить(", ") }
            вернуть текст + "."
        }
        "ОбъявлениеВариантов" {
            перем варианты: [стр] = []
            для в_ в гр(инстр, "варианты") { варианты.добавить("«" + св(в_, "имя") + "»") }
            вернуть ("Объявляется тип «" + св(инстр, "имя") + "» с вариантами " + варианты.соединить(", ")
                + ": значение этого типа - один из вариантов.")
        }
        "ОбъявлениеИнтерфейса" {
            вернуть ("Объявляется интерфейс «" + св(инстр, "имя")
                + "»: набор методов, которые должен иметь тип, чтобы подходить к нему.")
        }
        "Подключение" {
            вернуть "Подключается модуль «" + св(инстр, "путь") + "»: его общие функции и типы доступны через точку (модуль.имя)."
        }
        "ВнешнийБлок" {
            вернуть "Объявляются функции библиотеки C «" + св(инстр, "библиотека") + "», которые программа может вызывать."
        }
        иначе { вернуть "Инструкция «" + инстр.вид + "»." }
    }
}

функ выражение_или_часть(вид: стр) -> лог {
    вернуть ["ЦелоеЧисло", "ДробноеЧисло", "Строка", "Логическое", "Имя", "Унарная", "Бинарная", "Диапазон", "Вызов",
             "Запуск", "Ничего", "Иначе", "Поле", "Лямбда", "Список", "Словарь", "Индекс", "Передать", "Параметр",
             "ПараметрТипа", "ПолеТипа", "ВариантТипа", "МетодИнтерфейса", "ОбразецВарианта", "ВетвьВыбора",
             "ВнешняяФункция", "Программа", "Блок", "="].содержит(вид)
}

/// Инструкции и объявления дерева, записанные в строке «номер» (вглубь блоков, ветвей и безымянных функций).
функ инструкции_строки(у: разбор.Узел, номер: цел, найдено: [разбор.Узел]) -> [разбор.Узел] {
    перем итог = найдено
    если не выражение_или_часть(у.вид) и у.строка == номер { итог.добавить(у) }
    для г в у.поля {
        // группы с пометками проверки (не поля узла в uzly.py) не обходятся
        если г.вид == "значения_полей" или г.вид == "захваты" { продолжить }
        для вложенный в г.поля { итог = инструкции_строки(вложенный, номер, итог) }
    }
    вернуть итог
}

функ без_точек_справа(текст: стр) -> стр {
    перем т = текст
    пока т.оканчивается(".") { т = т[0..т.длина - 2] }
    вернуть т
}

/// Текст объяснения строки «номер» программы (несколько абзацев) или ошибка записи программы.
общий функ объяснить(исходник: стр, путь: стр, номер: цел, настройки: модули.Настройки) -> стр! {
    пусть строки = исходник.разбить("\n")
    если номер < 1 или номер > строки.длина {
        вернуть "В программе " + стр(строки.длина) + " строк, строки " + стр(номер) + " в ней нет"
    }
    пусть линия = строки[номер - 1].обрезать()
    если линия == "" { вернуть "Строка " + стр(номер) + " пустая" }
    если линия.начинается("//") {
        вернуть "Строка " + стр(номер) + " - комментарий: компьютер его пропускает, он написан для человека"
    }
    пусть программа = модули.загрузить(исходник, путь, настройки)!
    пусть таблицы = встроенные.таблицы()
    пусть итог_проверки = проверка.проверить(программа.дерево, таблицы)
    перем з = Знания(таблицы = таблицы, описания = встроенные.описания())
    пусть инструкции = разбор.часть_группы(итог_проверки.дерево, "инструкции")
    для инстр в инструкции {
        если инстр.вид == "Функция" и инстр.текст == "" и инстр.строка < 1000000 {
            пусть описание = без_точек_справа(документация.комментарий_над(строки, инстр.строка).обрезать())
            если описание != "" { з.функции[св(инстр, "имя")] = с_маленькой(описание) }
        }
        если инстр.вид == "ОбъявлениеТипа" { з.типы[св(инстр, "имя")] = истина }
    }
    перем найдено: [разбор.Узел] = []
    для инстр в инструкции { найдено = инструкции_строки(инстр, номер, найдено) }
    если найдено.длина == 0 и линия.начинается("подключить") {
        если пусть токены = лексер.разобрать(линия) {
            если пусть д = разбор.разобрать(токены, настройки.редакции, настройки.версия) {
                для инстр в разбор.часть_группы(д, "инструкции") {
                    если инстр.вид == "Подключение" { найдено.добавить(инстр) }
                }
            }
        }
    }
    если найдено.длина == 0 {
        если линия == "}" или линия == "} иначе {" или линия.начинается("}") {
            вернуть "Строка " + стр(номер) + ": «" + линия + "» закрывает блок, открытый выше"
        }
        вернуть "Строка " + стр(номер) + ": «" + линия + "» - продолжение инструкции, начатой выше"
    }
    перем абзацы = ["Строка " + стр(номер) + ": " + линия]
    для инстр в найдено { абзацы.добавить(инструкция_словами(инстр, з)) }
    если итог_проверки.ошибки.длина > 0 {
        абзацы.добавить("В программе есть ошибки (их показывает «dan проверить»), поэтому типы значений "
            + "указаны не везде.")
    }
    вернуть абзацы.соединить("\n\n")
}
