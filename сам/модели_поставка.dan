/// Поставка библиотеки llama.cpp для модуля «модели»: команды «дан модели установить» и
/// «дан модели проверить».
///
/// Модуль «модели» не собирает llama.cpp вместе с программой: программа загружает готовую
/// разделяемую библиотеку закреплённой версии (среда.версия_llama(), из modeli.ВЕРСИЯ_LLAMA) при
/// выполнении (sreda/modeli.c). «Проверить» ищет её так же, как программа (spec.md, раздел 11.29):
/// 1. переменная среды DAN_LLAMA - файл библиотеки или папка с ним; если задана, только она;
/// 2. (у программы - её папка и её папка llama; для этой команды не нужно);
/// 3. папка Дана DAN_HOME: её папка llama, затем она сама;
/// 4. папка данных пользователя, куда её кладёт «дан модели установить»:
///    Windows - %LOCALAPPDATA%\Dan\llama, Linux и macOS - $XDG_DATA_HOME/dan/llama или
///    ~/.local/share/dan/llama;
/// 5. системные папки: имя файла без папки (в Windows - также папки из PATH, куда установщик
///    Дана добавляет свою папку с llama.dll).
///
/// «Установить» скачивает архив llama-<метка>-<система>.zip из выпуска Дана той же версии,
/// сверяет SHA-256 по файлу SHA256SUMS.txt выпуска и распаковывает в папку пользователя.
/// «Проверить» находит библиотеку, загружает её маленькой программой на C (собирается тем же
/// компилятором C, что и программы Дана) и печатает версию, найденный вариант для процессора
/// и его возможности.

подключить "среда"

/// Что командам нужно знать о системе (это знает дан.dan).
общий тип Система {
    /// разделитель папок: "\\" в Windows, иначе "/"
    р: стр
    мак: лог
    /// команда компилятора C или "", если его нет
    компилятор: стр
    /// папка для сборки проверочной программы (в Windows - с латинским именем) или ""
    сборка: стр
}

/// Место, где ищется библиотека, и как оно называется в сообщениях.
тип Место {
    путь: стр
    откуда: стр
}

общий функ справка() -> стр {
    вернуть ("Библиотека llama.cpp для модуля «модели» (локальные языковые модели).\n\n"
        + "    дан модели установить   - скачать библиотеку из выпуска Дана этой версии в папку пользователя\n"
        + "    дан модели проверить    - найти библиотеку, загрузить её и показать версию и возможности процессора\n\n"
        + "Нужна llama.cpp " + среда.версия_llama() + ". Где ищется библиотека (по порядку):\n"
        + "  1. переменная среды DAN_LLAMA - файл библиотеки или папка с ним (если задана - только она);\n"
        + "  2. папка программы и её папка llama;\n"
        + "  3. папка Дана (переменная DAN_HOME): её папка llama, затем она сама;\n"
        + "  4. папка данных пользователя, куда её кладёт «дан модели установить»;\n"
        + "  5. системные папки (в Windows - также папки из PATH, в том числе папка Дана).")
}

функ windows(с: Система) -> лог { вернуть с.р == "\\" }

функ переменная(имя: стр) -> стр { вернуть (переменная_среды(имя) иначе "").обрезать() }

функ склеить(а: стр, б: стр, р: стр) -> стр {
    если а == "" { вернуть б }
    если а.оканчивается("/") или а.оканчивается("\\") { вернуть а + б }
    вернуть а + р + б
}

функ в_кавычках(т: стр, с: Система) -> стр {
    если windows(с) { вернуть "\"" + т + "\"" }
    вернуть "'" + т.заменить("'", "'\\''") + "'"
}

/// Команда для оболочки: cmd.exe снимает внешние кавычки, поэтому команда заключается в ещё одни.
функ для_оболочки(команда: стр, с: Система) -> стр {
    если windows(с) { вернуть "\"" + команда + "\"" }
    вернуть команда
}

функ тихо(с: Система) -> стр {
    если windows(с) { вернуть " >NUL 2>&1" }
    вернуть " >/dev/null 2>&1"
}

/// Имя файла библиотеки llama в этой системе.
общий функ имя_библиотеки(с: Система) -> стр {
    если windows(с) { вернуть "llama.dll" }
    если с.мак { вернуть "libllama.dylib" }
    вернуть "libllama.so"
}

/// Папка пользователя, куда «дан модели установить» кладёт библиотеку.
общий функ папка_пользователя(с: Система) -> стр {
    если windows(с) {
        перем основа = переменная("LOCALAPPDATA")
        если основа == "" { основа = переменная("USERPROFILE") }
        вернуть склеить(склеить(основа, "Dan", с.р), "llama", с.р)
    }
    перем основа = переменная("XDG_DATA_HOME")
    если основа == "" { основа = склеить(склеить(переменная("HOME"), ".local", с.р), "share", с.р) }
    вернуть склеить(склеить(основа, "dan", с.р), "llama", с.р)
}

/// Система и процессор так, как они записаны в именах архивов выпуска: linux-x64 и т.д.
общий функ платформа(с: Система) -> стр! {
    перем процессор = ""
    если windows(с) {
        перем имя = переменная("PROCESSOR_ARCHITEW6432")
        если имя == "" { имя = переменная("PROCESSOR_ARCHITECTURE") }
        процессор = имя.строчные()
    } иначе {
        процессор = (вывод_команды("uname -m 2>/dev/null") иначе "").обрезать().строчные()
    }
    перем вид = ""
    если процессор == "x86_64" или процессор == "amd64" или процессор == "x64" { вид = "x64" }
    если процессор == "aarch64" или процессор == "arm64" { вид = "arm64" }
    перем ос = "linux"
    если windows(с) { ос = "windows" }
    если с.мак { ос = "macos" }
    пусть итог = ос + "-" + вид
    если не ["linux-x64", "linux-arm64", "macos-arm64", "windows-x64"].содержит(итог) {
        перем название = процессор
        если название == "" { название = "неизвестный" }
        вернуть ошибка("для этой системы (" + ос + ", процессор " + название + ") готовой библиотеки llama.cpp нет; "
            + "соберите её сами сценарием поставка/собрать_llama.py из исходников Дана и укажите путь к ней "
            + "в переменной среды DAN_LLAMA")
    }
    вернуть итог
}

/// Места поиска после DAN_LLAMA и до системных папок: папка Дана и папка данных пользователя.
функ места(с: Система) -> [Место] {
    пусть имя = имя_библиотеки(с)
    перем итог: [Место] = []
    пусть дом = переменная("DAN_HOME")
    если дом != "" {
        итог.добавить(Место(склеить(склеить(дом, "llama", с.р), имя, с.р), "папка Дана (DAN_HOME)"))
        итог.добавить(Место(склеить(дом, имя, с.р), "папка Дана (DAN_HOME)"))
    }
    итог.добавить(Место(склеить(папка_пользователя(с), имя, с.р), "папка данных пользователя (dan модели установить)"))
    вернуть итог
}

/// Папка, в которой лежит файл.
функ папка_файла(путь: стр) -> стр {
    перем конец = -1
    перем н = 0
    для з в путь.символы() {
        если з == "/" или з == "\\" { конец = н }
        н += 1
    }
    если конец <= 0 { вернуть "." }
    вернуть путь[0..конец - 1]
}

/// Имя файла без папки.
функ имя_файла(путь: стр) -> стр {
    пусть папка = папка_файла(путь)
    если папка == "." и не путь.начинается(".") { вернуть путь }
    вернуть путь[папка.длина + 1..путь.длина - 1]
}

/// Текст программы на C, которая загружает библиотеку (путь - в файле path.txt рядом с ней)
/// и печатает строки «ключ=значение»: загрузка, путь, ggml, коммит, устройство, вариант,
/// сбой, возможности, причина.
функ текст_пробы() -> стр {
    вернуть [
        "#ifndef _WIN32",
        "#define _GNU_SOURCE",
        "#endif",
        "#include <stdio.h>",
        "#include <stdlib.h>",
        "#include <string.h>",
        "#ifdef _WIN32",
        "#include <windows.h>",
        "#define SEP 92",
        "#define GGML \"ggml.dll\"",
        "#define GGML_BASE \"ggml-base.dll\"",
        "typedef HMODULE lib_t;",
        "static lib_t open_lib(const char *p) {",
        "    static wchar_t w[4096];",
        "    if (!MultiByteToWideChar(CP_UTF8, 0, p, -1, w, 4096)) return NULL;",
        "    return LoadLibraryExW(w, NULL, (strchr(p, 92) || strchr(p, 47)) ? LOAD_WITH_ALTERED_SEARCH_PATH : 0);",
        "}",
        "static void *find(lib_t h, const char *n) { return h ? (void *)GetProcAddress(h, n) : NULL; }",
        "static void say_error(void) { printf(\"причина=код ошибки Windows %lu\", (unsigned long)GetLastError()); putchar(10); }",
        "static void lib_path(lib_t h, void *any, char *out, int n) {",
        "    static wchar_t w[4096];",
        "    DWORD k = GetModuleFileNameW(h, w, 4096);",
        "    (void)any;",
        "    out[0] = 0;",
        "    if (k == 0 || k >= 4096) return;",
        "    if (!WideCharToMultiByte(CP_UTF8, 0, w, -1, out, n, NULL, NULL)) out[0] = 0;",
        "}",
        "#else",
        "#include <dlfcn.h>",
        "#define SEP 47",
        "#ifdef __APPLE__",
        "#define GGML \"libggml.dylib\"",
        "#define GGML_BASE \"libggml-base.dylib\"",
        "#else",
        "#define GGML \"libggml.so\"",
        "#define GGML_BASE \"libggml-base.so\"",
        "#endif",
        "typedef void *lib_t;",
        "static lib_t open_lib(const char *p) { return dlopen(p, RTLD_NOW | RTLD_LOCAL); }",
        "static void *find(lib_t h, const char *n) { return h ? dlsym(h, n) : NULL; }",
        "static void say_error(void) { const char *e = dlerror(); printf(\"причина=%s\", e ? e : \"?\"); putchar(10); }",
        "static void lib_path(lib_t h, void *any, char *out, int n) {",
        "    Dl_info i;",
        "    (void)h;",
        "    out[0] = 0;",
        "    if (any && dladdr(any, &i) && i.dli_fname) {",
        "        strncpy(out, i.dli_fname, n - 1);",
        "        out[n - 1] = 0;",
        "    }",
        "}",
        "#endif",
        "",
        "typedef const char *(*text_fn)(void);",
        "typedef void (*path_fn)(const char *);",
        "typedef size_t (*count_fn)(void);",
        "typedef void *(*get_fn)(size_t);",
        "typedef const char *(*name_fn)(void *);",
        "typedef void (*log_fn)(int, const char *, void *);",
        "typedef void (*log_set_fn)(log_fn, void *);",
        "",
        "static const char crlf[] = {13, 10, 0};",
        "static char variant[1024];",
        "static char failure[1024];",
        "",
        "static void on_log(int level, const char *text, void *data) {",
        "    const char *p;",
        "    size_t k;",
        "    (void)level;",
        "    (void)data;",
        "    if (!text) return;",
        "    p = strstr(text, \"backend from \");",
        "    if (p) {",
        "        p += 13;",
        "        k = strcspn(p, crlf);",
        "        if (k >= sizeof variant) k = sizeof variant - 1;",
        "        memcpy(variant, p, k);",
        "        variant[k] = 0;",
        "    } else if (strstr(text, \"failed\") && !failure[0]) {",
        "        k = strcspn(text, crlf);",
        "        if (k >= sizeof failure) k = sizeof failure - 1;",
        "        memcpy(failure, text, k);",
        "        failure[k] = 0;",
        "    }",
        "}",
        "",
        "static lib_t h1, h2, h3;",
        "",
        "static void *sym(const char *n) {",
        "    void *s = find(h1, n);",
        "    if (!s) s = find(h2, n);",
        "    if (!s) s = find(h3, n);",
        "    return s;",
        "}",
        "",
        "static void line(const char *key, const char *value) {",
        "    fputs(key, stdout);",
        "    putchar(61);",
        "    fputs(value ? value : \"\", stdout);",
        "    putchar(10);",
        "}",
        "",
        "int main(void) {",
        "    static char path[4096], where[4096], folder[4096], other[4600];",
        "    size_t k, i;",
        "    void *info;",
        "    log_set_fn log_set;",
        "    path_fn load_all;",
        "    text_fn text;",
        "    count_fn dev_count;",
        "    get_fn dev_get;",
        "    name_fn dev_desc;",
        "    FILE *f = fopen(\"path.txt\", \"rb\");",
        "    if (!f) { line(\"загрузка\", \"нет файла path.txt\"); return 2; }",
        "    k = fread(path, 1, sizeof path - 1, f);",
        "    fclose(f);",
        "    path[k] = 0;",
        "    while (k > 0 && (path[k - 1] == 10 || path[k - 1] == 13)) path[--k] = 0;",
        "    h1 = open_lib(path);",
        "    if (!h1) { line(\"загрузка\", \"нет\"); say_error(); return 2; }",
        "    info = find(h1, \"llama_print_system_info\");",
        "    if (!info) { line(\"загрузка\", \"не llama\"); return 3; }",
        "    lib_path(h1, info, where, sizeof where);",
        "    if (!where[0]) { strncpy(where, path, sizeof where - 1); }",
        "    strcpy(folder, where);",
        "    for (i = strlen(folder); i > 0; i--) {",
        "        if (folder[i - 1] == 47 || folder[i - 1] == 92) { folder[i - 1] = 0; break; }",
        "    }",
        "    if (i == 0) strcpy(folder, \".\");",
        "    snprintf(other, sizeof other, \"%s%c%s\", folder, SEP, GGML);",
        "    h2 = open_lib(other);",
        "    snprintf(other, sizeof other, \"%s%c%s\", folder, SEP, GGML_BASE);",
        "    h3 = open_lib(other);",
        "    log_set = (log_set_fn)sym(\"ggml_log_set\");",
        "    if (log_set) log_set(on_log, NULL);",
        "    load_all = (path_fn)sym(\"ggml_backend_load_all_from_path\");",
        "    if (!load_all) { line(\"загрузка\", \"нет ggml\"); return 3; }",
        "    load_all(folder);",
        "    line(\"загрузка\", \"да\");",
        "    line(\"путь\", where);",
        "    text = (text_fn)sym(\"ggml_version\");",
        "    if (text) line(\"ggml\", text());",
        "    text = (text_fn)sym(\"ggml_commit\");",
        "    if (text) line(\"коммит\", text());",
        "    dev_count = (count_fn)sym(\"ggml_backend_dev_count\");",
        "    dev_get = (get_fn)sym(\"ggml_backend_dev_get\");",
        "    dev_desc = (name_fn)sym(\"ggml_backend_dev_description\");",
        "    if (dev_count && dev_get && dev_desc) {",
        "        for (i = 0; i < dev_count(); i++) line(\"устройство\", dev_desc(dev_get(i)));",
        "    }",
        "    line(\"вариант\", variant);",
        "    if (failure[0]) line(\"сбой\", failure);",
        "    line(\"возможности\", ((text_fn)info)());",
        "    return 0;",
        "}",
    ].соединить("\n") + "\n"
}

/// Собирает и выполняет пробу для библиотеки «путь»; результат - пары «ключ=значение».
функ пробовать(с: Система, путь: стр) -> [[стр]]! {
    если с.компилятор == "" {
        вернуть ошибка("не найден компилятор C (gcc, clang или cc), которым собирается проверка; "
            + "задайте его переменной среды DAN_COMPILER")
    }
    перем папка = с.сборка
    если папка == "" { папка = создать_временную_папку() }
    пусть исходник = склеить(папка, "proba.c", с.р)
    перем программа = склеить(папка, "proba", с.р)
    если windows(с) { программа += ".exe" }
    пусть ошибки_сборки = склеить(папка, "sborka.txt", с.р)
    пусть вывод_пробы = склеить(папка, "vyvod.txt", с.р)
    записать(исходник, текст_пробы())
    записать(склеить(папка, "path.txt", с.р), путь)
    перем библиотеки = ""
    если не windows(с) и не с.мак { библиотеки = " -ldl" }
    пусть сборка = (с.компилятор + " -std=c11 -O1 -w -o " + в_кавычках(программа, с) + " " + в_кавычках(исходник, с)
        + библиотеки + " >" + в_кавычках(ошибки_сборки, с) + " 2>&1")
    если выполнить_команду(для_оболочки(сборка, с)) != 0 {
        перем текст = ""
        если существует(ошибки_сборки) { текст = прочитать(ошибки_сборки).обрезать() }
        если с.сборка == "" { удалить_папку(папка) }
        вернуть ошибка("не удалось собрать проверочную программу компилятором C «" + с.компилятор + "»: " + текст)
    }
    перем переход = "cd "
    если windows(с) { переход = "cd /d " }
    пусть запуск = переход + в_кавычках(папка, с) + " && " + в_кавычках(программа, с) + " >" + в_кавычках(вывод_пробы, с) + " 2>&1"
    пусть код = выполнить_команду(для_оболочки(запуск, с), 300)
    перем итог: [[стр]] = []
    если существует(вывод_пробы) {
        для строка в прочитать(вывод_пробы).разбить("\n") {
            пусть н = строка.найти("=")
            если н > 0 { итог.добавить([строка[0..н - 1], строка[н + 1..строка.длина - 1].обрезать()]) }
        }
    }
    если с.сборка == "" { удалить_папку(папка) }
    если код != 0 и значение(итог, "загрузка") == "" {
        вернуть ошибка("проверочная программа завершилась с кодом " + стр(код) + " при загрузке библиотеки «" + путь + "»")
    }
    вернуть итог
}

функ значение(пары: [[стр]], ключ: стр) -> стр {
    для п в пары {
        если п[0] == ключ { вернуть п[1] }
    }
    вернуть ""
}

функ все(пары: [[стр]], ключ: стр) -> [стр] {
    перем итог: [стр] = []
    для п в пары {
        если п[0] == ключ { итог.добавить(п[1]) }
    }
    вернуть итог
}

функ что_делать(с: Система) -> [стр] {
    перем итог = ["Что сделать:"]
    если windows(с) {
        итог.добавить("  - переустановите Дан установщиком dan-<версия>-setup.exe (он кладёт llama.dll рядом с dan.exe)")
        итог.добавить("    или выполните: dan модели установить")
    } иначе {
        итог.добавить("  - выполните: dan модели установить (скачает библиотеку из выпуска Дана)")
    }
    итог.добавить("  - или соберите библиотеку сами: python поставка/собрать_llama.py (в исходниках Дана)")
    итог.добавить("    и укажите полный путь к файлу " + имя_библиотеки(с) + " в переменной среды DAN_LLAMA")
    вернуть итог
}

/// «дан модели проверить»: 0 - библиотека найдена, загружена и нужной версии.
общий функ проверить(с: Система) -> цел {
    пусть имя = имя_библиотеки(с)
    перем найдено = ""
    перем откуда = ""
    перем осмотрено: [стр] = []
    пусть заданное = переменная("DAN_LLAMA")
    если заданное != "" {
        перем путь = заданное
        если это_папка(путь) { путь = склеить(путь, имя, с.р) }
        если не существует(путь) {
            вывод("Переменная среды DAN_LLAMA указывает на «" + заданное + "», но библиотеки llama.cpp там нет.")
            вывод("Укажите в DAN_LLAMA полный путь к файлу " + имя + " или уберите эту переменную.")
            вернуть 1
        }
        найдено = путь
        откуда = "переменная среды DAN_LLAMA"
    } иначе {
        для м в места(с) {
            осмотрено.добавить(м.путь)
            если существует(м.путь) {
                найдено = м.путь
                откуда = м.откуда
                прервать
            }
        }
    }
    перем пары: [[стр]] = []
    если найдено != "" {
        если пусть п = пробовать(с, найдено) {
            пары = п
        } иначе ошибка о {
            вывод("Не удалось проверить библиотеку llama.cpp: " + о)
            вернуть 1
        }
        если значение(пары, "загрузка") != "да" {
            вывод("Библиотека llama.cpp найдена (" + откуда + "): " + найдено)
            вывод("но не загружается: " + значение(пары, "причина") + " " + значение(пары, "загрузка"))
            вывод("Возможно, она для другой системы или процессора, или рядом нет библиотек ggml. ")
            для строка в что_делать(с) { вывод(строка) }
            вернуть 1
        }
    } иначе {
        // системные пути: загрузка по имени файла без папки
        если пусть п = пробовать(с, имя) {
            пары = п
        } иначе ошибка о {
            вывод("Не удалось проверить библиотеку llama.cpp: " + о)
            вернуть 1
        }
        если значение(пары, "загрузка") != "да" {
            вывод("Библиотека llama.cpp не найдена.")
            вывод("Где искалась:")
            для п в осмотрено { вывод("  " + п) }
            вывод("  системные пути (" + имя + ")")
            для строка в что_делать(с) { вывод(строка) }
            вернуть 1
        }
        найдено = значение(пары, "путь")
        откуда = "системные пути"
    }
    перем путь = значение(пары, "путь")
    если путь == "" { путь = найдено }
    вывод("Библиотека llama.cpp: " + путь)
    вывод("Где найдена: " + откуда)
    перем код = 0
    пусть файл_версии = склеить(папка_файла(путь), "version.txt", с.р)
    перем метка = ""
    если существует(файл_версии) { метка = прочитать(файл_версии).разбить("\n")[0].обрезать() }
    перем строка_версии = метка
    если метка == "" { строка_версии = "неизвестна (рядом нет файла version.txt)" }
    если значение(пары, "ggml") != "" {
        строка_версии += " (ggml " + значение(пары, "ggml")
        если значение(пары, "коммит") != "" { строка_версии += ", коммит " + значение(пары, "коммит") }
        строка_версии += ")"
    }
    вывод("Версия: " + строка_версии)
    для у в все(пары, "устройство") { вывод("Процессор: " + у) }
    пусть вариант = значение(пары, "вариант")
    если вариант != "" {
        вывод("Вариант для процессора: " + имя_файла(вариант))
    } иначе {
        вывод("Вариант для процессора не загружен: рядом с библиотекой нет подходящего файла ggml-cpu-*")
        если значение(пары, "сбой") != "" { вывод("  " + значение(пары, "сбой")) }
        код = 1
    }
    вывод("Возможности: " + значение(пары, "возможности"))
    если метка != "" и метка != среда.версия_llama() {
        вывод("Эта версия Дана рассчитана на llama.cpp " + среда.версия_llama() + ", а найдена " + метка + ".")
        если windows(с) {
            вывод("Обновите библиотеку: переустановите Дан этой версии или выполните dan модели установить.")
        } иначе {
            вывод("Обновите библиотеку: dan модели установить")
        }
        код = 1
    }
    если код == 0 { вывод("Библиотека готова к работе.") }
    вернуть код
}

/// Скачивает адрес в файл программой curl; ошибка - её сообщение.
функ скачать(с: Система, адрес: стр, куда: стр) -> ! {
    пусть ошибки = куда + ".ошибки"
    пусть команда = ("curl -fsSL --retry 3 --connect-timeout 30 -o " + в_кавычках(куда, с) + " " + в_кавычках(адрес, с)
        + " 2>" + в_кавычках(ошибки, с))
    если выполнить_команду(для_оболочки(команда, с)) != 0 {
        перем текст = ""
        если существует(ошибки) { текст = прочитать(ошибки).обрезать() }
        если текст == "" { текст = "curl завершился с ошибкой" }
        вернуть ошибка(текст)
    }
}

/// «дан модели установить»: скачать архив библиотеки из выпуска Дана и распаковать в папку пользователя.
общий функ установить(с: Система) -> цел {
    перем плат = ""
    если пусть п = платформа(с) {
        плат = п
    } иначе ошибка о {
        вывод("Не удалось установить библиотеку llama.cpp: " + о)
        вернуть 1
    }
    если выполнить_команду(для_оболочки("curl --version" + тихо(с), с)) != 0 {
        вывод("Для загрузки нужна программа curl (в Linux: sudo apt install curl).")
        вернуть 1
    }
    пусть метка = среда.версия_llama()
    пусть имя_архива = "llama-" + метка + "-" + плат + ".zip"
    перем адрес = переменная("DAN_VYPUSKI")
    если адрес == "" {
        адрес = "https://github.com/alexandervdanchenko-ai/dan/releases/download/v" + среда.версия()
    }
    пока адрес.оканчивается("/") { адрес = адрес[0..адрес.длина - 2] }
    // в Windows curl получает имена файлов в кодировке системы: загрузка - в папку с латинским именем
    перем временная = с.сборка
    если временная == "" { временная = создать_временную_папку() }
    пусть суммы = склеить(временная, "SHA256SUMS.txt", с.р)
    вывод("Загрузка " + адрес + "/" + имя_архива)
    если ошибка о = скачать(с, адрес + "/SHA256SUMS.txt", суммы) {
        удалить_папку(временная)
        вывод("Не удалось скачать список контрольных сумм выпуска (" + адрес + "/SHA256SUMS.txt): " + о)
        вывод("Проверьте подключение к интернету. Если выпуска Дана " + среда.версия() + " нет или в нём нет библиотеки llama.cpp,")
        вывод("соберите её сами: python поставка/собрать_llama.py, и укажите путь к ней в переменной среды DAN_LLAMA.")
        вернуть 1
    }
    перем ожидается = ""
    для строка в прочитать(суммы).разбить("\n") {
        перем части: [стр] = []
        для ч в строка.разбить() { части.добавить(ч) }
        если части.длина == 2 и части[1].заменить("*", "") == имя_архива { ожидается = части[0].строчные() }
    }
    если ожидается == "" {
        удалить_папку(временная)
        вывод("В выпуске Дана " + среда.версия() + " нет архива " + имя_архива + " (его нет в SHA256SUMS.txt).")
        вывод("Соберите библиотеку сами: python поставка/собрать_llama.py, и укажите путь к ней в переменной среды DAN_LLAMA.")
        вернуть 1
    }
    пусть архив = склеить(временная, имя_архива, с.р)
    если ошибка о = скачать(с, адрес + "/" + имя_архива, архив) {
        удалить_папку(временная)
        вывод("Не удалось скачать " + имя_архива + ": " + о)
        вернуть 1
    }
    пусть сумма = хеш(прочитать_байты(архив)).строчные()
    если сумма != ожидается {
        удалить_папку(временная)
        вывод("Контрольная сумма архива " + имя_архива + " не совпадает с SHA256SUMS.txt выпуска:")
        вывод("  ожидалась " + ожидается)
        вывод("  получена  " + сумма)
        вывод("Архив повреждён или подменён; ничего не установлено.")
        вернуть 1
    }
    пусть папка = папка_пользователя(с)
    пусть новая = папка + ".новая"
    удалить_папку(новая)
    создать_папку(новая)
    извлечь_архив(архив, новая)
    удалить_папку(временная)
    если не существует(склеить(новая, имя_библиотеки(с), с.р)) {
        удалить_папку(новая)
        вывод("В архиве " + имя_архива + " нет файла " + имя_библиотеки(с) + "; ничего не установлено.")
        вернуть 1
    }
    удалить_папку(папка)
    переименовать(новая, папка)
    вывод("Готово: библиотека llama.cpp " + метка + " (" + плат + ") установлена в " + папка)
    если переменная("DAN_LLAMA") != "" {
        вывод("Внимание: задана переменная среды DAN_LLAMA, и программы берут библиотеку по ней, а не из этой папки.")
    }
    вывод("Проверка: dan модели проверить")
    вернуть 0
}

/// «дан модели ...»: разбор действия.
общий функ выполнить(аргументы: [стр], с: Система) -> цел {
    если аргументы == ["установить"] { вернуть установить(с) }
    если аргументы == ["проверить"] { вернуть проверить(с) }
    вывод(справка())
    вернуть 2
}
