/// Форматирование программ на Дане, написанное на Дане: единый вид текста.
///
/// Делает то же, что formatirovanie.py, и даёт для каждой программы тот же
/// текст и те же сообщения об ошибках (проверяет test_sam.py).
///
///     подключить "сам/формат"
///     пусть новый = формат.отформатировать(текст)!
///
/// Правила: отступ - четыре пробела на каждый уровень вложенности фигурных,
/// круглых и квадратных скобок; вокруг знаков действий, сравнения и
/// присваивания - по одному пробелу (кроме унарного минуса: -5); после запятой
/// - пробел, перед ней - нет; внутри круглых и квадратных скобок, а также
/// фигурных скобок словаря у краёв пробелов нет, а у фигурных скобок блока -
/// есть: «{ вернуть х }»; пробелы в конце строк удаляются; подряд не больше
/// одной пустой строки; файл оканчивается одним переводом строки.
/// Форматирование меняет только пробелы и переводы строк: это проверяется
/// сравнением токенов до и после.

подключить "лексер"

/// Часть строки исходного текста: слово, число, строка, знак или комментарий.
тип Часть {
    вид: стр
    текст: стр
    /// перед частью был пробел
    пробел: лог
    начало: цел
    конец: цел
}

функ двойные() -> [стр] { вернуть ["==", "!=", "<=", ">=", "+=", "-=", "*=", "/=", "->", ".."] }

функ ключевые() -> [стр] {
    вернуть ["функ", "вернуть", "пусть", "перем", "если", "иначе", "пока", "для", "в", "прервать",
             "продолжить", "и", "или", "не", "истина", "ложь", "тип", "ничего", "выбор", "подключить",
             "как", "общий", "интерфейс", "запустить", "параллельно", "внешняя"]
}

функ часть_текста(с: [стр], от: цел, до: цел) -> стр {
    перем итог: [стр] = []
    для н в от..до - 1 { итог.добавить(с[н]) }
    вернуть итог.соединить("")
}

функ обрезать_справа(текст: стр) -> стр {
    перем с = текст.символы()
    пока с.длина > 0 и (с[с.длина - 1] == " " или с[с.длина - 1] == "\t" или с[с.длина - 1] == "\r"
            или с[с.длина - 1] == "\n") {
        с.удалить(с.длина - 1)
    }
    вернуть с.соединить("")
}

/// Строка исходного текста -> список частей: слово, число, строка, знак, комментарий.
функ части_строки(строка: стр) -> [Часть] {
    пусть с = строка.символы()
    перем итог: [Часть] = []
    перем н = 0
    перем пробел = ложь
    пока н < с.длина {
        пусть з = с[н]
        если з == " " или з == "\t" или з == "\r" {
            пробел = истина
            н += 1
            продолжить
        }
        пусть начало = н
        перем вид = ""
        если з == "/" и н + 1 < с.длина и с[н + 1] == "/" {
            итог.добавить(Часть("комментарий", обрезать_справа(часть_текста(с, н, с.длина)), пробел, н, с.длина))
            прервать
        }
        если з == "\"" {
            перем к = н + 1
            пока к < с.длина и с[к] != "\"" {
                если с[к] == "\\" { к += 2 } иначе { к += 1 }
            }
            н = к + 1
            вид = "строка"
        } иначе если лексер.цифра(з) {
            перем к = н
            пока (к < с.длина и (лексер.цифра(с[к]) или с[к] == "_"
                    или (с[к] == "." и к + 1 < с.длина и лексер.цифра(с[к + 1])
                        и не (к + 1 < с.длина и с[к + 1] == ".")))) {
                к += 1
            }
            // порядок числа: 1e30, 1.5е-7
            если к < с.длина и "eEеЕ".содержит(с[к]) {
                перем д = к + 1
                если д < с.длина и (с[д] == "+" или с[д] == "-") { д += 1 }
                если д < с.длина и лексер.цифра(с[д]) {
                    к = д
                    пока к < с.длина и лексер.цифра(с[к]) { к += 1 }
                }
            }
            н = к
            вид = "число"
        } иначе если лексер.буква(з) или з == "_" {
            перем к = н
            пока к < с.длина и (лексер.буква(с[к]) или лексер.цифра(с[к]) или с[к] == "_") { к += 1 }
            н = к
            вид = "слово"
        } иначе {
            если н + 1 < с.длина и двойные().содержит(с[н] + с[н + 1]) { н += 2 } иначе { н += 1 }
            вид = "знак"
        }
        если н > с.длина { н = с.длина }
        итог.добавить(Часть(вид, часть_текста(с, начало, н), пробел, начало, н))
        пробел = ложь
    }
    вернуть итог
}

функ ключевое(ч: Часть) -> лог {
    вернуть ч.вид == "слово" и ключевые().содержит(лексер.без_ё(ч.текст))
}

функ знак_из(ч: Часть, знаки: [стр]) -> лог {
    вернуть ч.вид == "знак" и знаки.содержит(ч.текст)
}

/// Начинается ли после этой части новое выражение (тогда «-» - унарный минус).
функ начало_выражения(части: [Часть], н: цел) -> лог {
    если н < 0 { вернуть истина }
    пусть п = части[н]
    если п.вид == "знак" { вернуть не [")", "]", "}", "?", "!", "²", "³"].содержит(п.текст) }
    вернуть ключевое(п) и не ["истина", "ложь", "ничего"].содержит(лексер.без_ё(п.текст))
}

/// Открывает ли «{» после этой части словарь или тип словаря (а не блок).
функ словарная(части: [Часть], н: цел) -> лог {
    если н < 0 { вернуть ложь }
    пусть п = части[н]
    если п.вид == "знак" { вернуть [":", "=", "(", ",", "[", "{", "->", "+", "==", "!=", "+=", "<"].содержит(п.текст) }
    вернуть п.вид == "слово" и лексер.без_ё(п.текст) == "вернуть"
}

/// Номера частей «<» и «>», которые служат скобками типа (Пара<цел, стр>), а не сравнением.
функ угловые_скобки(части: [Часть]) -> {цел: лог} {
    перем скобки: {цел: лог} = {}
    для н в 0..части.длина - 1 {
        пусть ч = части[н]
        если не (ч.вид == "знак" и ч.текст == "<" и н > 0 и части[н - 1].вид == "слово" и не ключевое(части[н - 1])) {
            продолжить
        }
        перем глубина = 1
        перем было_двоеточие = ложь
        перем к = н + 1
        пока к < части.длина {
            пусть т = части[к]
            если т.вид == "знак" и т.текст == "<" {
                глубина += 1
            } иначе если т.вид == "знак" и т.текст == ">" {
                глубина -= 1
                если глубина == 0 { прервать }
            } иначе если т.вид == "знак" и т.текст == ":" {
                было_двоеточие = истина
            } иначе если (т.вид == "слово" и ключевое(т)
                    и не (["и", "функ"].содержит(лексер.без_ё(т.текст))
                        и (было_двоеточие или лексер.без_ё(т.текст) == "функ"))) {
                прервать
            } иначе если ((т.вид != "слово" и т.вид != "знак")
                    или (т.вид == "знак" и не [",", ":", "[", "]", "{", "}", "?", "!", "(", ")", "->", "."].содержит(т.текст))) {
                прервать
            }
            к += 1
        }
        если к < части.длина и глубина == 0 {
            скобки[н] = истина
            скобки[к] = истина
        }
    }
    вернуть скобки
}

тип Собранное {
    текст: стр
    скобки: [стр]
}

/// Части одной строки (без комментария) -> текст с нормализованными пробелами.
/// «скобки» - стек видов открытых фигурных скобок («блок» или «словарь»),
/// общий для всех строк файла: словарь может занимать несколько строк.
функ собрать(части: [Часть], исходные_скобки: [стр]) -> Собранное {
    перем скобки = исходные_скобки
    перем вывод_: [стр] = []
    перем унарные: {цел: лог} = {}
    перем вид_открытой: {цел: стр} = {}
    пусть угловые = угловые_скобки(части)
    для н в 0..части.длина - 1 {
        пусть ч = части[н]
        если ч.вид == "знак" и (ч.текст == "-" или ч.текст == "−") и начало_выражения(части, н - 1) {
            унарные[н] = истина
        }
        перем закрыта = ""
        если ч.вид == "знак" и ч.текст == "{" {
            если словарная(части, н - 1) { вид_открытой[н] = "словарь" } иначе { вид_открытой[н] = "блок" }
            скобки.добавить(вид_открытой[н])
        } иначе если ч.вид == "знак" и ч.текст == "}" {
            если скобки.длина > 0 {
                закрыта = скобки[скобки.длина - 1]
                скобки.удалить(скобки.длина - 1)
            } иначе {
                закрыта = "блок"
            }
        }
        если н == 0 {
            вывод_.добавить(ч.текст)
            продолжить
        }
        пусть пред = части[н - 1]
        перем нужен = истина
        если знак_из(ч, [",", ")", "]", ".", "?", "..", "²", "³", "№"]) {
            нужен = ложь
        } иначе если пред.вид == "знак" и пред.текст == "№" {
            нужен = ложь                       // оценки№0: номер прилегает с обеих сторон
        } иначе если ч.вид == "знак" и ч.текст == "!" и не ч.пробел {
            нужен = ложь                       // ф()! - передать ошибку
        } иначе если ч.вид == "знак" и ч.текст == ":" {
            нужен = ч.пробел
        } иначе если знак_из(пред, ["(", "[", ".", ".."]) {
            нужен = ложь
        } иначе если унарные.содержит(н - 1) {
            нужен = ложь
        } иначе если закрыта == "словарь" {
            нужен = ложь
        } иначе если вид_открытой.содержит(н - 1) и вид_открытой[н - 1] == "словарь" {
            нужен = ложь
        } иначе если пред.вид == "знак" и пред.текст == "{" и ч.текст == "}" {
            нужен = ложь                       // {} - пустой блок или словарь
        } иначе если знак_из(ч, ["(", "["]) {
            // вызов и индекс прилегают к имени: ф(х), с[0], (а)(б); «если (а)» - через пробел
            пусть прилегает = ((пред.вид == "слово" и (не ключевое(пред) или лексер.без_ё(пред.текст) == "функ"))
                или пред.вид == "строка"
                или знак_из(пред, [")", "]", "?", "!"])
                или (пред.вид == "знак" и пред.текст == ">" и не ч.пробел))
            нужен = не прилегает
        } иначе если угловые.содержит(н) или (угловые.содержит(н - 1) и пред.текст == "<") {
            нужен = ложь                       // Пара<цел, стр>: скобки типа без пробелов
        } иначе если угловые.содержит(н - 1) и пред.текст == ">" {
            нужен = ч.вид != "знак" или не ["(", "?", "!", ")", "]", ",", ">"].содержит(ч.текст)
        }
        если нужен { вывод_.добавить(" " + ч.текст) } иначе { вывод_.добавить(ч.текст) }
    }
    вернуть Собранное(вывод_.соединить(""), скобки)
}

/// Ширина отступа строки в исходном тексте: пробел - 1, табуляция - 4.
функ исходный_отступ(строка: стр) -> цел {
    перем ширина = 0
    для з в строка.символы() {
        если з == " " { ширина += 1 } иначе если з == "\t" { ширина += 4 } иначе { прервать }
    }
    вернуть ширина
}

функ без_концов_строк(токены: [лексер.Токен]) -> [стр] {
    перем итог: [стр] = []
    для т в токены {
        если т.вид != "КОНЕЦ_СТРОКИ" { итог.добавить(т.вид + "\t" + т.значение) }
    }
    вернуть итог
}

/// Текст программы в едином виде или ошибка записи программы.
общий функ отформатировать(текст: стр) -> стр! {
    перем исходные: [лексер.Токен] = []
    если пусть т = лексер.разобрать(текст) { исходные = т } иначе ошибка о { вернуть ошибка(о) }
    перем итог: [стр] = []
    перем пустых = 0
    перем скобки: [стр] = []
    перем открытые: [цел] = []         // номера строк, в которых открыты ещё не закрытые скобки
    перем виды: [стр] = []             // виды этих скобок: ( [ {
    перем блоки: [цел] = []            // исходные отступы строк, открывших блок двоеточием в конце
    пусть строки = текст.заменить("\r\n", "\n").заменить("\r", "\n").разбить("\n")
    для номер в 0..строки.длина - 1 {
        пусть исходная = строки[номер]
        пусть части = части_строки(исходная)
        если части.длина == 0 {
            пустых += 1
            продолжить
        }
        если итог.длина > 0 и пустых > 0 { итог.добавить("") }
        пустых = 0
        перем код: [Часть] = []
        перем комментарий: [Часть] = []
        для ч в части {
            если ч.вид == "комментарий" { комментарий.добавить(ч) } иначе { код.добавить(ч) }
        }
        // отступ - число строк с незакрытыми скобками: «json.Объект({» на одной строке даёт один уровень
        перем закрывающих_в_начале = 0
        для ч в код {
            если знак_из(ч, [")", "]", "}"]) { закрывающих_в_начале += 1 } иначе { прервать }
        }
        // блоки двоеточием закрываются строкой с отступом не больше, чем у открывшей строки
        пусть продолжение = виды.длина > 0 и (виды[виды.длина - 1] == "(" или виды[виды.длина - 1] == "[")
        если не продолжение и код.длина > 0 {
            пусть исходный = исходный_отступ(исходная)
            пока блоки.длина > 0 и исходный <= блоки[блоки.длина - 1] { блоки.удалить(блоки.длина - 1) }
        }
        перем остаются: {цел: лог} = {}
        перем сколько = открытые.длина - закрывающих_в_начале
        если сколько < 0 { сколько = 0 }
        для н в 0..сколько - 1 { остаются[открытые[н]] = истина }
        пусть отступ = остаются.длина + блоки.длина
        пусть собранное = собрать(код, скобки)
        скобки = собранное.скобки
        перем строка = собранное.текст
        если комментарий.длина > 0 {
            если код.длина > 0 {
                // пробелы перед комментарием в конце строки сохраняются: ими выравнивают комментарии
                перем пробелов = комментарий[0].начало - код[код.длина - 1].конец
                если пробелов < 1 { пробелов = 1 }
                строка += " ".повторить(пробелов) + комментарий[0].текст
            } иначе {
                строка = комментарий[0].текст
            }
        }
        итог.добавить("    ".повторить(отступ) + строка)
        для ч в код {
            если знак_из(ч, ["(", "[", "{"]) {
                открытые.добавить(номер)
                виды.добавить(ч.текст)
            } иначе если знак_из(ч, [")", "]", "}"]) и открытые.длина > 0 {
                открытые.удалить(открытые.длина - 1)
                виды.удалить(виды.длина - 1)
            }
        }
        если (код.длина > 0 и код[код.длина - 1].вид == "знак" и код[код.длина - 1].текст == ":"
                и не (виды.длина > 0 и (виды[виды.длина - 1] == "(" или виды[виды.длина - 1] == "["))) {
            если не продолжение { блоки.добавить(исходный_отступ(исходная)) }
        }
    }
    пока итог.длина > 0 и итог[итог.длина - 1] == "" { итог.удалить(итог.длина - 1) }
    перем новый = ""
    если итог.длина > 0 { новый = итог.соединить("\n") + "\n" }
    // проверка: изменились только пробелы и переводы строк
    если пусть новые = лексер.разобрать(новый) {
        если без_концов_строк(новые) != без_концов_строк(исходные) {
            вернуть ошибка("внутренняя ошибка форматирования: изменился смысл программы; файл оставлен без изменений")
        }
    } иначе ошибка о {
        вернуть ошибка("внутренняя ошибка форматирования: " + о)
    }
    вернуть новый
}
