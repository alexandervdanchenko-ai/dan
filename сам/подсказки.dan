    с["площадь_сектора"] = "площадь_сектора(дроб, дроб) -> дроб\n\nплощадь кругового сектора по радиусу и углу в градусах"
    с["сумма_углов_многоугольника"] = "сумма_углов_многоугольника(цел) -> цел\n\nсумма внутренних углов выпуклого н-угольника в градусах"
    с["в_систему"] = "в_систему(цел, цел) -> стр\n\nзапись числа в системе счисления с основанием от 2 до 36: в_систему(10, 2) = \"1010\""
