    с["объём_цилиндра"] = "объём_цилиндра(дроб, дроб) -> дроб\n\nобъём цилиндра по радиусу и высоте"
    с["объем_цилиндра"] = "объём_цилиндра(дроб, дроб) -> дроб\n\nобъём цилиндра по радиусу и высоте"
