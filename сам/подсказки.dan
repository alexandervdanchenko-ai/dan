    с["переименовать"] = "переименовать(стр, стр) -> пусто\n\nпереименовать или перенести файл или папку (файл с новым именем заменяется)"
    с["создать_временную_папку"] = "создать_временную_папку() -> стр\n\nновая пустая папка с уникальным именем в папке временных файлов; результат - путь к ней"
