/// Таблицы подсказок сервера языка для редакторов (команда «дан сервер»).
///
/// Файл создан сценарием сам/создать_подсказки.py из server.py и таблиц компилятора;
/// изменять его вручную не нужно.

/// Ключевые слова по алфавиту.
общий функ ключевые_слова() -> [стр] {
    перем с: [стр] = []
    с.добавить("в")
    с.добавить("вернуть")
    с.добавить("внешняя")
    с.добавить("выбор")
    с.добавить("для")
    с.добавить("если")
    с.добавить("запустить")
    с.добавить("и")
    с.добавить("или")
    с.добавить("иначе")
    с.добавить("интерфейс")
    с.добавить("истина")
    с.добавить("как")
    с.добавить("ложь")
    с.добавить("не")
    с.добавить("ничего")
    с.добавить("общий")
    с.добавить("параллельно")
    с.добавить("перем")
    с.добавить("подключить")
    с.добавить("пока")
    с.добавить("прервать")
    с.добавить("продолжить")
    с.добавить("пусть")
    с.добавить("тип")
    с.добавить("функ")
    вернуть с
}

/// Описания ключевых слов.
общий функ описания_ключевых() -> {стр: стр} {
    перем с: {стр: стр} = {}
    с["функ"] = "функ имя(параметр: тип) -> тип { ... } - объявление функции"
    с["пусть"] = "пусть имя = значение - неизменяемая переменная"
    с["перем"] = "перем имя = значение - изменяемая переменная"
    с["если"] = "если условие { ... } иначе { ... }; если пусть з = значение { ... }"
    с["пока"] = "пока условие { ... }; пока пусть з = значение { ... }"
    с["для"] = "для х в источник { ... } - перебор списка, строки, словаря, диапазона а..б или канала"
    с["выбор"] = "выбор значение { Вариант(поля) { ... } иначе { ... } } - разбор перечисления"
    с["тип"] = "тип Имя { поле: тип } или тип Имя { Вариант(поле: тип) ... }"
    с["подключить"] = "подключить \"файл.dan\" как имя - подключение модуля"
    с["общий"] = "общий функ ... / общий тип ... - имя, видимое из других файлов"
    с["запустить"] = "пусть з = запустить ф(...) - параллельная задача"
    с["параллельно"] = "параллельно { запустить ... } - блок, ждущий все свои задачи"
    вернуть с
}

/// Встроенные функции по алфавиту.
общий функ встроенные() -> [стр] {
    перем с: [стр] = []
    с.добавить("байты")
    с.добавить("ввод")
    с.добавить("вывод")
    с.добавить("дата")
    с.добавить("длинное")
    с.добавить("дроб")
    с.добавить("канал")
    с.добавить("компл")
    с.добавить("лог")
    с.добавить("мн")
    с.добавить("ошибка")
    с.добавить("рац")
    с.добавить("стр")
    с.добавить("цел")
    вернуть с
}

/// Описания встроенных функций.
общий функ описания_встроенных() -> {стр: стр} {
    перем с: {стр: стр} = {}
    с["вывод"] = "вывод(значение): вывести значение и перевести строку"
    с["ввод"] = "ввод() или ввод(подсказка): строка, введённая с клавиатуры"
    с["ошибка"] = "ошибка(текст): ошибка-значение для результата «Т!»"
    с["канал"] = "канал() или канал(запас): канал для обмена значениями между задачами"
    с["цел"] = "цел(х): целое число из строки или дробного числа"
    с["дроб"] = "дроб(х): дробное число"
    с["рац"] = "рац(ч, з) или рац(х): обыкновенная дробь"
    с["стр"] = "стр(х): значение в виде строки"
    с["лог"] = "лог: логическое значение (истина или ложь)"
    с["мн"] = "мн: многочлен от х"
    с["байты"] = "байты(текст) или байты([числа]): последовательность байтов"
    с["длинное"] = "длинное(х): целое число любой длины"
    с["компл"] = "компл(в, м): комплексное число"
    с["дата"] = "дата(\"26.10.2026\") или дата(год, месяц, день): календарная дата"
    вернуть с
}

