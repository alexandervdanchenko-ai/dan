    с["эквивалентность"] = "эквивалентность(лог, лог) -> лог\n\nистина, если значения одинаковы"
    с["исключающее_или"] = "исключающее_или(лог, лог) -> лог\n\nистина, если ровно одно значение истинно"
    с["максимизировать"] = "максимизировать([рац], [[рац]], [рац]) -> [рац]?\n\nнаибольшее значение ц·х при ограничениях А·х ≤ б, х ≥ 0 (симплекс-метод, точно); результат - значения х или ничего, если целевая функция не ограничена"
    с["минимизировать"] = "минимизировать([рац], [[рац]], [рац]) -> [рац]?\n\nнаименьшее значение ц·х при ограничениях А·х ≤ б, х ≥ 0"
    с["прочитать"] = "прочитать(стр) -> стр\n\nтекст файла"
    с["прочитать_байты"] = "прочитать_байты(стр) -> байты\n\nсодержимое файла в виде байтов"
