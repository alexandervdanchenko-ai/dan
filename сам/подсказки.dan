    с["прописью"] = "прописью(цел) -> стр\n\nчисло словами: прописью(1251) = \"одна тысяча двести пятьдесят один\""
    с["сумма_прописью"] = "сумма_прописью(рац) -> стр\nсумма_прописью(дроб) -> стр\n\nденежная сумма словами: \"сто двадцать тысяч рублей 50 копеек\""
    с["сумма_цифрами"] = "сумма_цифрами(рац) -> стр\nсумма_цифрами(дроб) -> стр\n\nденежная сумма цифрами по правилам русского письма: сумма_цифрами(рац(15750025, 100)) = \"157 500,25\""
    с["склонение"] = "склонение(цел, стр, стр, стр) -> стр\n\nформа слова при числе: склонение(21, \"день\", \"дня\", \"дней\") = \"день\""
    с["член_арифметической"] = "член_арифметической(рац, рац, цел) -> рац\nчлен_арифметической(дроб, дроб, цел) -> дроб\n\nн-й член арифметической прогрессии по первому члену и разности"
    с["сумма_арифметической"] = "сумма_арифметической(рац, рац, цел) -> рац\nсумма_арифметической(дроб, дроб, цел) -> дроб\n\nсумма первых н членов арифметической прогрессии"
    с["член_геометрической"] = "член_геометрической(рац, рац, цел) -> рац\nчлен_геометрической(дроб, дроб, цел) -> дроб\n\nн-й член геометрической прогрессии по первому члену и знаменателю"
    с["сумма_геометрической"] = "сумма_геометрической(рац, рац, цел) -> рац\nсумма_геометрической(дроб, дроб, цел) -> дроб\n\nсумма первых н членов геометрической прогрессии"
    с["простые_проценты"] = "простые_проценты(рац, рац, рац) -> рац\nпростые_проценты(дроб, дроб, дроб) -> дроб\n\nсумма с простыми процентами: сумма, ставка в процентах годовых, срок в годах"
    с["сложные_проценты"] = "сложные_проценты(рац, рац, цел) -> рац\nсложные_проценты(дроб, дроб, дроб) -> дроб\nсложные_проценты(дроб, дроб, дроб, цел) -> дроб\n\nсумма со сложными процентами: сумма, ставка в процентах годовых, срок в годах (четвёртым значением - число начислений в год)"
    с["аннуитетный_платёж"] = "аннуитетный_платёж(дроб, дроб, цел) -> дроб\n\nежемесячный платёж по кредиту равными частями: сумма, ставка в процентах годовых, число месяцев"
    с["аннуитетный_платеж"] = "аннуитетный_платёж(дроб, дроб, цел) -> дроб\n\nежемесячный платёж по кредиту равными частями: сумма, ставка в процентах годовых, число месяцев"
    с["приведённая_стоимость"] = "приведённая_стоимость(дроб, дроб, дроб) -> дроб\n\nсегодняшняя стоимость будущей суммы при ставке дисконтирования (процентов годовых) через срок в годах"
    с["приведенная_стоимость"] = "приведённая_стоимость(дроб, дроб, дроб) -> дроб\n\nсегодняшняя стоимость будущей суммы при ставке дисконтирования (процентов годовых) через срок в годах"
    с["чистая_приведённая_стоимость"] = "чистая_приведённая_стоимость(дроб, [дроб]) -> дроб\n\nNPV: ставка в процентах и денежные потоки по годам, начиная с нулевого"
    с["чистая_приведенная_стоимость"] = "чистая_приведённая_стоимость(дроб, [дроб]) -> дроб\n\nNPV: ставка в процентах и денежные потоки по годам, начиная с нулевого"
    с["внутренняя_норма_доходности"] = "внутренняя_норма_доходности([дроб]) -> дроб?\n\nIRR в процентах: ставка, при которой NPV потоков равна нулю; ничего, если её нет"
    с["реальная_ставка"] = "реальная_ставка(дроб, дроб) -> дроб\n\nреальная ставка в процентах по номинальной ставке и инфляции (формула Фишера)"
    с["проценты_за_дни"] = "проценты_за_дни(рац, рац, цел, цел) -> рац\n\nпроценты за дни: сумма × ставка / 100 × дней / дней_в_году"
    с["разобрать_цел"] = "разобрать_цел(стр) -> цел!\n\nцелое число из строки или ошибка, если строка - не число: разобрать_цел(\"42\") = 42"
    с["разобрать_дроб"] = "разобрать_дроб(стр) -> дроб!\n\nдробное число из строки (точка или запятая) или ошибка"
