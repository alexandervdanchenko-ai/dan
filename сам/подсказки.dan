    с["из_римского"] = "из_римского(стр) -> цел\n\nчисло по римской записи"
    с["степень_по_модулю"] = "степень_по_модулю(цел, цел, цел) -> цел\n\nостаток от деления а в степени н на м (без переполнения)"
    с["обратный_по_модулю"] = "обратный_по_модулю(цел, цел) -> цел?\n\nчисло х, для которого а·х даёт остаток 1 при делении на м; ничего, если такого нет"
