/// Описания функций библиотеки: варианты и описание.
общий функ описания_библиотеки() -> {стр: стр} {
    перем с: {стр: стр} = {}
    с["модуль"] = "модуль(цел) -> цел\nмодуль(рац) -> рац\nмодуль(дроб) -> дроб\nмодуль(компл) -> дроб\n\nмодуль числа (расстояние от нуля): модуль(-5) = 5"
    с["делится"] = "делится(цел, цел) -> лог\n\nделится ли первое число на второе без остатка: делится(12, 4) = истина"
    с["чётное"] = "чётное(цел) -> лог\n\nделится ли число на 2 без остатка"
    с["четное"] = "чётное(цел) -> лог\n\nделится ли число на 2 без остатка"
    с["нечётное"] = "нечётное(цел) -> лог\n\nдаёт ли число остаток 1 при делении на 2"
    с["нечетное"] = "нечётное(цел) -> лог\n\nдаёт ли число остаток 1 при делении на 2"
    с["простое"] = "простое(цел) -> лог\n\nимеет ли число ровно два делителя: 1 и само себя"
    с["делители"] = "делители(цел) -> [цел]\n\nвсе делители натурального числа по возрастанию: делители(12) = [1, 2, 3, 4, 6, 12]"
    с["кратные"] = "кратные(цел, цел) -> [цел]\n\nпервые кратные числа: кратные(5, 4) = [5, 10, 15, 20]"
    с["простые_множители"] = "простые_множители(цел) -> [цел]\n\nразложение на простые множители: простые_множители(180) = [2, 2, 3, 3, 5]"
    с["частное"] = "частное(цел, цел) -> цел\nчастное(длинное, длинное) -> длинное\nчастное(мн, мн) -> мн\n\nчастное при делении с остатком: частное(7, 2) = 3, частное(-7, 2) = -4 (остаток а % б не бывает отрицательным); для многочленов - частное при делении многочленов"
    с["нод"] = "нод(цел, цел) -> цел\nнод([цел]) -> цел\n\nнаибольший общий делитель двух чисел или списка чисел: нод(12, 9) = 3"
    с["нок"] = "нок(цел, цел) -> цел\nнок([цел]) -> цел\n\nнаименьшее общее кратное двух чисел или списка чисел: нок(9, 12) = 36"
    с["цифры"] = "цифры(цел) -> [цел]\n\nцифры числа от старшего разряда к младшему: цифры(635) = [6, 3, 5]"
