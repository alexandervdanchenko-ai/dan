    с["контрольная_сумма"] = "контрольная_сумма(байты) -> цел\nконтрольная_сумма(стр) -> цел\n\nконтрольная сумма CRC-32 (как в zip)"
    с["хеш"] = "хеш(байты) -> стр\nхеш(стр) -> стр\n\nхеш SHA-256 шестнадцатеричными цифрами"
    с["сжать"] = "сжать(байты) -> байты\nсжать(стр) -> байты\nсжать(байты, стр) -> байты\nсжать(стр, стр) -> байты\n\nсжать данные как можно сильнее (LZMA2, формат .xz); со вторым аргументом - сжать и зашифровать паролем"
    с["сжать_gzip"] = "сжать_gzip(байты) -> байты\nсжать_gzip(стр) -> байты\n\nсжать данные алгоритмом DEFLATE в формате gzip (как в zip): быстрее и совместимее, но слабее"
    с["распаковать"] = "распаковать(байты) -> байты\nраспаковать(байты, стр) -> байты\n\nраспаковать данные в формате .xz или gzip; со вторым аргументом - расшифровать паролем и распаковать"
    с["зашифровать"] = "зашифровать(байты, стр) -> байты\nзашифровать(стр, стр) -> байты\n\nзашифровать данные паролем (ChaCha20-Poly1305)"
    с["расшифровать"] = "расшифровать(байты, стр) -> байты\n\nрасшифровать данные паролем"
    с["создать_архив"] = "создать_архив(стр, [стр]) -> пусто\nсоздать_архив(стр, [стр], стр) -> пусто\n\nсоздать zip-архив из файлов; третий аргумент - пароль (AES-256)"
    с["извлечь_архив"] = "извлечь_архив(стр, стр) -> [стр]\nизвлечь_архив(стр, стр, стр) -> [стр]\n\nизвлечь файлы zip-архива в папку; возвращает имена извлечённых файлов"
    с["содержимое_архива"] = "содержимое_архива(стр) -> [стр]\n\nимена файлов в zip-архиве"
    с["разобрать_архив"] = "разобрать_архив(байты) -> [байты]\n\nфайлы zip-архива из байтов: [имя, содержимое, имя, содержимое, ...] (имена - текст в байтах); основа модулей word и excel"
    с["файлы_архива"] = "файлы_архива(байты) -> [байты]!\n\nто же, что разобрать_архив, но повреждённый архив даёт ошибку вместо остановки программы"
    с["события_json"] = "события_json(стр) -> [стр]!\n\nсобытия разбора JSON: \"{\" \"}\" \"[\" \"]\", \"k\" + имя поля, \"s\" + строка, \"i\" + целое, \"d\" + число, \"t\", \"f\", \"n\"; ошибка с местом в тексте. Обычно используется через модуль json"
    с["части_json"] = "части_json(стр) -> [стр]!\n\nто же, что события_json, но короче: первый элемент - виды всех событий по одному знаку, дальше - имена полей, строки и записи чисел по порядку. Обычно используется через модуль json"
    с["разобрать_csv"] = "разобрать_csv(стр, стр) -> [[стр]]!\n\nстроки таблицы CSV с указанным разделителем; ошибка с номером строки. Обычно используется через модуль csv"
    с["разделитель_csv"] = "разделитель_csv(стр) -> стр\n\nразделитель таблицы CSV по первой строке: «;» или табуляция, если их больше, чем запятых, иначе запятая"
    с["строка_json"] = "строка_json(стр) -> стр\n\nстрока в записи JSON: в кавычках, с \\\" \\\\ \\n \\t и \\u00XX для прочих управляющих символов"
    с["разобрать_xml"] = "разобрать_xml(стр) -> [стр]!\n\nсобытия разбора XML: \"<\" имя (\"@\" атрибут значение)* \">\", \"</\" имя, \"т\" текст; ошибка с местом в тексте, если XML записан неверно. Обычно используется через модуль xml"
    с["текст_pdf"] = "текст_pdf(байты) -> [стр]!\n\nтекст страниц документа PDF: по строке на страницу; ошибка, если это не PDF или он зашифрован. Обычно используется через модуль pdf"
    с["шрифт_pdf"] = "шрифт_pdf(стр) -> цел!\n\nзагрузить шрифт TrueType (.ttf) для создания PDF; результат - номер шрифта. Обычно используется через модуль pdf"
    с["ширина_pdf"] = "ширина_pdf(цел, стр, дроб) -> дроб\n\nширина текста в пунктах: ширина_pdf(шрифт, текст, размер)"
    с["собрать_pdf"] = "собрать_pdf([стр], дроб, дроб) -> байты\n\nдокумент PDF из команд страниц (текст, линии, рамки); обычно используется через модуль pdf"
    с["в_base64"] = "в_base64(байты) -> стр\nв_base64(стр) -> стр\nв_base64(байты, цел) -> стр\n\nзапись данных в Base64; со вторым аргументом - строками такой длины (кратной 4), через \\r\\n"
    с["из_base64"] = "из_base64(стр) -> байты!\n\nданные из записи Base64 (допускаются пробелы и переводы строк); ошибка, если это не Base64"
    с["разобрать_письмо"] = "разобрать_письмо(байты) -> [байты]\n\nразбор письма (MIME): \"з\" имя значение - заголовки, \"ч\" тип файл вид содержимое - части. Обычно используется через модуль почта"
    с["собрать_архив"] = "собрать_архив([байты]) -> байты\n\nzip-архив в виде байтов из списка [имя, содержимое, имя, содержимое, ...]"
    с["сегодня"] = "сегодня() -> дата\n\nсегодняшняя дата по часам компьютера"
    с["разобрать_дату"] = "разобрать_дату(стр) -> дата!\n\nдата из строки вида 26.10.2026 или 2026-10-26; ошибка, если это не дата"
    с["добавить_месяцы"] = "добавить_месяцы(дата, цел) -> дата\n\nдата через столько-то месяцев; если такого числа в месяце нет - последний день месяца"
    с["добавить_годы"] = "добавить_годы(дата, цел) -> дата\n\nдата через столько-то лет (29 февраля переходит в 28 февраля)"
    с["дней_в_месяце"] = "дней_в_месяце(цел, цел) -> цел\n\nчисло дней в месяце: дней_в_месяце(год, месяц)"
    с["выходной"] = "выходной(дата) -> лог\n\nсуббота или воскресенье"
    с["праздник"] = "праздник(дата) -> лог\n\nустарела: нерабочие праздничные дни 1-8 января, 23 февраля, 8 марта, 1 и 9 мая, 12 июня, 4 ноября"
    с["рабочий_день"] = "рабочий_день(дата) -> лог\n\nне выходной и не праздник"
    с["добавить_рабочие_дни"] = "добавить_рабочие_дни(дата, цел) -> дата\n\nдата через столько-то рабочих дней (выходные и праздники пропускаются)"
    с["сейчас"] = "сейчас() -> стр\n\nтекущие дата и время: «26.10.2026 14:05:09»"
    с["метка_времени"] = "метка_времени() -> дроб\n\nсекунды с 01.01.1970 с долями: разность двух меток - продолжительность"
    с["пауза"] = "пауза(дроб) -> пусто\n\nостановить программу на столько-то секунд"
    с["аргументы"] = "аргументы() -> [стр]\n\nзначения, переданные программе при запуске (после её имени)"
    с["переменная_среды"] = "переменная_среды(стр) -> стр?\n\nзначение переменной среды или ничего, если её нет"
    с["выполнить_команду"] = "выполнить_команду(стр) -> цел\nвыполнить_команду(стр, дроб) -> цел\n\nвыполнить команду системы; результат - код завершения (0 - успешно); со вторым значением - не дольше стольких секунд: не уложившаяся команда останавливается, результат -1"
    с["вывод_команды"] = "вывод_команды(стр) -> стр!\n\nвыполнить команду и получить то, что она вывела; ошибка, если код завершения не 0"
    с["завершить"] = "завершить(цел) -> пусто\n\nзавершить программу с кодом завершения"
    с["вывод_ошибки"] = "вывод_ошибки(стр) -> пусто\n\nвывести строку в поток ошибок (а не в обычный вывод): сообщения о сбоях и предупреждения"
    с["совпадает"] = "совпадает(стр, стр) -> лог\n\nсоответствует ли весь текст шаблону"
    с["найти_шаблон"] = "найти_шаблон(стр, стр) -> стр?\n\nпервая часть текста, подходящая под шаблон, или ничего"
    с["найти_все"] = "найти_все(стр, стр) -> [стр]\n\nвсе непересекающиеся части текста, подходящие под шаблон"
    с["группы"] = "группы(стр, стр) -> [стр]\n\nпервое совпадение и его группы: [всё совпадение, группа 1, группа 2, ...]; пустой список, если нет"
    с["заменить_шаблон"] = "заменить_шаблон(стр, стр, стр) -> стр\n\nзаменить все совпадения; в замене $1..$9 - группы, $0 - всё совпадение, $$ - знак $"
    с["разбить_по_шаблону"] = "разбить_по_шаблону(стр, стр) -> [стр]\n\nразбить текст по разделителям, подходящим под шаблон"
    с["путь_программы"] = "путь_программы() -> стр\n\nпуть к исполняемому файлу программы"
    с["ввод_байтов"] = "ввод_байтов(цел) -> байты\n\nдо н байтов ввода как есть; пустые - конец ввода. Обычно используется через сервер языка"
    с["вывести_байты"] = "вывести_байты(байты) -> пусто\n\nзаписать байты в вывод как есть. Обычно используется через сервер языка"
    с["слушать_порт"] = "слушать_порт(цел) -> цел\n\nслушать порт TCP на 127.0.0.1 (0 - любой); номер слушателя или -1. Обычно используется через песочницу Дана"
    с["порт_слушателя"] = "порт_слушателя(цел) -> цел\n\nпорт слушателя. Обычно используется через песочницу Дана"
    с["принять_соединение"] = "принять_соединение(цел) -> цел\n\nдождаться соединения; номер или -1. Обычно используется через песочницу Дана"
    с["прочитать_соединение"] = "прочитать_соединение(цел, цел) -> байты\n\nдо н байтов из соединения; пустые - закрыто. Обычно используется через песочницу Дана"
    с["записать_соединение"] = "записать_соединение(цел, байты) -> лог\n\nотправить байты; ложь - закрыто. Обычно используется через песочницу Дана"
    с["закрыть_соединение"] = "закрыть_соединение(цел) -> пусто\n\nзакрыть соединение или слушателя. Обычно используется через песочницу Дана"
    с["утвердить"] = "утвердить(лог) -> пусто\nутвердить(лог, стр) -> пусто\n\nпроверить условие: если оно ложно - ошибка выполнения (в тесте - провал теста); второй аргумент - пояснение"
    с["утвердить_равно"] = "утвердить_равно(цел, цел) -> пусто\nутвердить_равно(дроб, дроб) -> пусто\nутвердить_равно(стр, стр) -> пусто\nутвердить_равно(лог, лог) -> пусто\n\nпроверить, что значение равно ожидаемому: утвердить_равно(факт, ожидание); при расхождении сообщение показывает оба значения"
    с["символ_по_коду"] = "символ_по_коду(цел) -> стр\n\nсимвол с данным кодом Юникода: символ_по_коду(1071) = \"Я\""
    с["код_символа"] = "код_символа(стр) -> цел\n\nкод Юникода первого символа строки: код_символа(\"Я\") = 1071"
    с["сетевой_запрос"] = "сетевой_запрос(стр, стр, [стр], байты, цел) -> [байты]!\n\nзапрос HTTP: сетевой_запрос(метод, адрес, заголовки, тело, секунд); результат - [заголовки ответа, тело]. Обычно используется через модуль http: подключить \"http\""
    с["почтовый_запрос"] = "почтовый_запрос(стр, стр, стр, стр, [стр], байты, стр, лог, цел) -> байты!\n\nзапрос к почтовому серверу: с получателями - отправка письма (SMTP), без них - запрос IMAP. Обычно используется через модуль почта: подключить \"почта\""
    с["дата_для_письма"] = "дата_для_письма() -> стр\n\nтекущие дата и время в записи заголовка письма: Mon, 26 Oct 2026 10:30:00 +0300"
    с["база_открыть"] = "база_открыть(стр) -> цел!\n\nоткрыть или создать базу данных SQLite; результат - номер базы. Обычно используется через модуль sqlite"
    с["база_закрыть"] = "база_закрыть(цел) -> пусто\n\nзакрыть базу данных по номеру"
    с["база_выполнить"] = "база_выполнить(цел, стр, [байты]) -> [байты]!\n\nвыполнить запрос SQL с параметрами; значения передаются байтами с буквой типа впереди"
    с["окно_создать"] = "окно_создать(стр, цел, цел) -> цел!\n\nсоздать окно; результат - номер окна. Обычно используется через модуль окна"
    с["окно_добавить"] = "окно_добавить(цел, стр, стр, цел, цел, цел, цел) -> цел\n\nдобавить в окно элемент: окно_добавить(окно, вид, текст, х, у, ширина, высота)"
    с["окно_задать"] = "окно_задать(цел, стр, стр) -> пусто\n\nизменить свойство элемента окна"
    с["окно_получить"] = "окно_получить(цел, стр) -> стр\n\nсвойство элемента окна"
    с["окно_рисовать"] = "окно_рисовать(цел, стр, [цел], стр) -> пусто\n\nнарисовать фигуру на холсте"
    с["окно_ждать"] = "окно_ждать(цел) -> [стр]\n\nждать события окон: [вид, элемент, х, у, текст]"
    с["окно_сообщение"] = "окно_сообщение(стр, стр, стр) -> цел\n\nокно с сообщением или вопросом"
    с["окно_файл"] = "окно_файл(стр, стр, стр) -> стр?\n\nокно выбора файла"
    вернуть с
}

