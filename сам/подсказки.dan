    с["энтропия"] = "энтропия([дроб]) -> дроб\n\nинформационная энтропия распределения в битах: энтропия([0.5, 0.5]) = 1.0"
    с["случайное"] = "случайное(цел, цел) -> цел\nслучайное() -> дроб\n\nслучайное целое от а до б включительно; без аргументов - случайное дробное от 0 до 1"
    с["перемешать"] = "перемешать([цел]) -> [цел]\nперемешать([стр]) -> [стр]\nперемешать([рац]) -> [рац]\nперемешать([дроб]) -> [дроб]\n\nновый список с теми же элементами в случайном порядке"
    с["определитель"] = "определитель([[рац]]) -> рац\nопределитель([[дроб]]) -> дроб\n\nопределитель квадратной матрицы: определитель([[1, 2], [3, 4]]) = -2"
    с["обратная_матрица"] = "обратная_матрица([[рац]]) -> [[рац]]\nобратная_матрица([[дроб]]) -> [[дроб]]\n\nобратная матрица (точно для рац)"
    с["транспонировать"] = "транспонировать([[рац]]) -> [[рац]]\nтранспонировать([[дроб]]) -> [[дроб]]\n\nтранспонированная матрица: строки становятся столбцами"
    с["умножить_матрицы"] = "умножить_матрицы([[рац]], [[рац]]) -> [[рац]]\nумножить_матрицы([[дроб]], [[дроб]]) -> [[дроб]]\n\nпроизведение матриц"
    с["сложить_матрицы"] = "сложить_матрицы([[рац]], [[рац]]) -> [[рац]]\nсложить_матрицы([[дроб]], [[дроб]]) -> [[дроб]]\n\nсумма матриц одинакового размера"
    с["ранг"] = "ранг([[рац]]) -> цел\n\nранг матрицы"
    с["единичная_матрица"] = "единичная_матрица(цел) -> [[рац]]\n\nединичная матрица порядка н"
    с["скалярное_произведение"] = "скалярное_произведение([рац], [рац]) -> рац\nскалярное_произведение([дроб], [дроб]) -> дроб\n\nскалярное произведение векторов"
    с["векторное_произведение"] = "векторное_произведение([рац], [рац]) -> [рац]\nвекторное_произведение([дроб], [дроб]) -> [дроб]\n\nвекторное произведение трёхмерных векторов"
    с["длина_вектора"] = "длина_вектора([рац]) -> дроб\nдлина_вектора([дроб]) -> дроб\n\nдлина вектора: длина_вектора([3, 4]) = 5.0"
    с["угол_между_векторами"] = "угол_между_векторами([дроб], [дроб]) -> дроб\n\nугол между векторами в радианах"
    с["расстояние"] = "расстояние(рац, рац, рац, рац) -> дроб\nрасстояние(дроб, дроб, дроб, дроб) -> дроб\n\nрасстояние между точками (х1, у1) и (х2, у2)"
    с["середина_отрезка"] = "середина_отрезка(рац, рац, рац, рац) -> [рац]\nсередина_отрезка(дроб, дроб, дроб, дроб) -> [дроб]\n\nкоординаты середины отрезка: [х, у]"
    с["прямая_через_точки"] = "прямая_через_точки(рац, рац, рац, рац) -> [рац]\nпрямая_через_точки(дроб, дроб, дроб, дроб) -> [дроб]\n\nкоэффициенты [а, б, в] уравнения прямой а·х + б·у + в = 0 через две точки"
    с["уравнение_прямой"] = "уравнение_прямой(рац, рац, рац, рац) -> стр\n\nуравнение прямой через две точки: «у = 2х + 1» или «х = 3»"
    с["пересечение_прямых"] = "пересечение_прямых(рац, рац, рац, рац, рац, рац) -> [рац]?\n\nточка пересечения прямых а1·х + б1·у + в1 = 0 и а2·х + б2·у + в2 = 0; ничего, если прямые параллельны или совпадают"
    с["площадь_по_вершинам"] = "площадь_по_вершинам(рац, рац, рац, рац, рац, рац) -> рац\nплощадь_по_вершинам(дроб, дроб, дроб, дроб, дроб, дроб) -> дроб\n\nплощадь треугольника по координатам вершин"
    с["площадь_многоугольника"] = "площадь_многоугольника([рац], [рац]) -> рац\n\nплощадь многоугольника по спискам координат вершин (по порядку обхода)"
    с["гипотенуза"] = "гипотенуза(дроб, дроб) -> дроб\n\nгипотенуза по двум катетам (теорема Пифагора)"
    с["катет"] = "катет(дроб, дроб) -> дроб\n\nкатет по гипотенузе и другому катету"
    с["площадь_треугольника_по_сторонам"] = "площадь_треугольника_по_сторонам(дроб, дроб, дроб) -> дроб\n\nплощадь треугольника по трём сторонам (формула Герона)"
    с["площадь_трапеции"] = "площадь_трапеции(рац, рац, рац) -> рац\nплощадь_трапеции(дроб, дроб, дроб) -> дроб\n\nплощадь трапеции по основаниям и высоте"
    с["площадь_параллелограмма"] = "площадь_параллелограмма(рац, рац) -> рац\nплощадь_параллелограмма(дроб, дроб) -> дроб\n\nплощадь параллелограмма по стороне и высоте"
    с["площадь_ромба"] = "площадь_ромба(рац, рац) -> рац\nплощадь_ромба(дроб, дроб) -> дроб\n\nплощадь ромба по диагоналям"
    с["объём_пирамиды"] = "объём_пирамиды(рац, рац) -> рац\nобъём_пирамиды(дроб, дроб) -> дроб\n\nобъём пирамиды по площади основания и высоте"
    с["объем_пирамиды"] = "объём_пирамиды(рац, рац) -> рац\nобъём_пирамиды(дроб, дроб) -> дроб\n\nобъём пирамиды по площади основания и высоте"
    с["объём_призмы"] = "объём_призмы(рац, рац) -> рац\nобъём_призмы(дроб, дроб) -> дроб\n\nобъём призмы по площади основания и высоте"
    с["объем_призмы"] = "объём_призмы(рац, рац) -> рац\nобъём_призмы(дроб, дроб) -> дроб\n\nобъём призмы по площади основания и высоте"
    с["площадь_поверхности_куба"] = "площадь_поверхности_куба(рац) -> рац\nплощадь_поверхности_куба(дроб) -> дроб\n\nплощадь поверхности куба по ребру"
