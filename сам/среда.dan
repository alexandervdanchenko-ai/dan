        "система" { вернуть [["DAN_MSG_ASSERT", "утверждение не выполнено"], ["DAN_TXT_ASSERT_EQ", "ожидалось %s, получено %s"], ["DAN_TXT_NOT_DATE", "\" - не дата: нужна запись вида 26.10.2026 или 2026-10-26"], ["DAN_MSG_BAD_PAUSE", "продолжительность паузы должна быть неотрицательным числом секунд"], ["DAN_MSG_RUN_FAILED", "не удалось выполнить команду"], ["DAN_MSG_RUN_CODE", "команда завершилась с кодом %d"], ["DAN_MSG_RX_BAD", "ошибка в шаблоне \"%s\": %s"], ["DAN_TXT_RX_ESCAPE", "неизвестное сочетание \\%c"], ["DAN_TXT_RX_END", "шаблон оканчивается знаком \\"], ["DAN_TXT_RX_RANGE", "в диапазоне [а-б] первый знак должен идти раньше второго"], ["DAN_TXT_RX_CLASS", "не закрыта квадратная скобка ["], ["DAN_TXT_RX_COUNT", "неверное число повторений в {...}"], ["DAN_TXT_RX_GROUPS", "больше 19 групп в скобках"], ["DAN_TXT_RX_PAREN", "не закрыта круглая скобка ("], ["DAN_TXT_RX_PAREN2", "лишняя закрывающая скобка )"], ["DAN_TXT_RX_NOTHING", "знаку повторения *, +, ? или {...} нечего повторять"], ["DAN_TXT_RX_BRACE", "не закрыта фигурная скобка {"], ["DAN_TXT_RX_DEEP", "слишком глубокая вложенность скобок"], ["DAN_TXT_RX_BIG", "шаблон слишком велик"], ["DAN_TXT_MAIL_HOST", "почтовый сервер не найден: проверьте его адрес и подключение к интернету"], ["DAN_TXT_MAIL_CONNECT", "не удалось подключиться к почтовому серверу: проверьте адрес, порт и подключение к интернету"], ["DAN_TXT_MAIL_TIMEOUT", "почтовый сервер не ответил вовремя"], ["DAN_TXT_MAIL_LOGIN", "почтовый сервер не принял имя пользователя или пароль (для Яндекса, Mail.ru и Gmail нужен пароль приложения, созданный в настройках безопасности ящика)"], ["DAN_TXT_MAIL_NOTLS", "почтовый сервер не поддерживает защищённое соединение"], ["DAN_TXT_MAIL_BROKEN", "соединение с почтовым сервером прервалось"], ["DAN_TXT_MAIL_NOTFOUND", "на почтовом сервере нет такой папки или письма"], ["DAN_TXT_MAIL_SCHEME", "адрес почтового сервера должен начинаться с smtps://, smtp://, imaps:// или imap://"], ["DAN_TXT_MAIL_WASM", "в программе для WebAssembly почта недоступна"], ["DAN_TXT_MAIL_NOCURLEXE", "для работы с почтой в Windows нужна программа curl.exe (есть в Windows 10 и новее)"], ["DAN_TXT_MAIL_TEMP", "не удалось записать временный файл для отправки письма"], ["DAN_TXT_NET_NOCURL", "для работы с сетью нужна библиотека libcurl, но она не найдена (в Ubuntu и Debian её устанавливает пакет libcurl4, в Fedora - libcurl)"], ["DAN_TXT_NET_WASM", "в программе для WebAssembly запросы HTTP недоступны"], ["DAN_TXT_NET_NOWINHTTP", "не удалось загрузить системную библиотеку WinHTTP"], ["DAN_TXT_NET_PROTOCOL", "адрес должен начинаться с http:// или https://"], ["DAN_TXT_NET_URL", "неверная запись адреса"], ["DAN_TXT_NET_HOST", "сервер не найден: адрес не существует или нет подключения к интернету"], ["DAN_TXT_NET_CONNECT", "не удалось подключиться к серверу"], ["DAN_TXT_NET_TIMEOUT", "сервер не ответил за отведённое время"], ["DAN_TXT_NET_TLS", "ошибка защищённого соединения: сертификат сервера не прошёл проверку или соединение не удалось установить"], ["DAN_TXT_NET_REDIRECTS", "слишком много перенаправлений"], ["DAN_TXT_NET_EMPTY", "сервер закрыл соединение, не прислав ответа"], ["DAN_TXT_NET_BROKEN", "соединение с сервером прервалось"], ["DAN_TXT_NET_MEMORY", "недостаточно памяти"], ["DAN_TXT_NET_OTHER", "ошибка сети (код libcurl %d: %s)"], ["DAN_TXT_NET_OTHER_WIN", "ошибка сети (код WinHTTP %lu)"], ["DAN_TXT_DB_NOLIB", "для работы с базой данных нужна библиотека SQLite, но она не найдена (в Ubuntu и Debian её устанавливает пакет libsqlite3-0, в Windows 10 и новее она встроена)"], ["DAN_MSG_DB_CLOSED", "база данных закрыта"], ["DAN_TXT_DB_BUSY", "база данных занята другой программой или задачей"], ["DAN_TXT_DB_READONLY", "база данных открыта только для чтения"], ["DAN_TXT_DB_IO", "ошибка чтения или записи файла базы данных"], ["DAN_TXT_DB_CORRUPT", "файл повреждён или не является базой данных SQLite"], ["DAN_TXT_DB_FULL", "нет места на диске"], ["DAN_TXT_DB_CANTOPEN", "не удалось открыть файл базы дан