tic int dan_plural_form(uint64_t n) {   /* 0: 1, 21...; 1: 2-4, 22-24...; 2: 0, 5-20... */\n    uint64_t t = n % 100, u = n % 10;\n    if (t >= 11 && t <= 14) return 2;\n    if (u == 1) return 0;\n    if (u >= 2 && u <= 4) return 1;\n    return 2;\n}\nstatic dan_str dan_plural(int64_t n, dan_str f1, dan_str f2, dan_str f5) {\n    uint64_t u = n < 0 ? (uint64_t)0 - (uint64_t)n : (uint64_t)n;\n    int f = dan_plural_form(u);\n    return f == 0 ? f1 : f == 1 ? f2 : f5;\n}\nstatic void dan_words_add(dan_buf *b, const char *w) {\n    if (!*w) return;\n    if (b->len) dan_buf_add(b, \" \");\n    dan_buf_add(b, w);\n}\nstatic void dan_words_triad(dan_buf *b, unsigned t, int female) {\n    dan_words_add(b, dan_w_hundreds[t / 100]);\n    unsigned r = t % 100;\n    if (r >= 10 && r < 20) { dan_words_add(b, dan_w_teens[r - 10]); return; }\n    dan_words_add(b, dan_w_tens[r / 10]);\n    dan_words_add(b, female ? dan_w_ones_f[r % 10] : dan_w_ones_m[r % 10]);\n}\nstatic dan_str dan_in_words(int64_t v) {\n    if (v == 0) return dan_strdup(DAN_W_ZERO);\n    uint64_t u = v < 0 ? (uint64_t)0 - (uint64_t)v : (uint64_t)v;\n    unsigned tri[7]; int k = 0;\n    while (u) { tri[k++] = (unsigned)(u % 1000); u /= 1000; }\n    dan_buf b = { NULL, 0, 0 };\n    for (int i = k - 1; i >= 0; i--) {\n        if (tri[i] == 0) continue;\n        dan_words_triad(&b, tri[i], dan_w_gender[i]);\n        if (i > 0) {\n            int f = dan_plural_form(tri[i]);\n            dan_words_add(&b, f == 0 ? dan_w_scale1[i] : f == 1 ? dan_w_scale2[i] : dan_w_scale5[i]);\n        }\n    }\n    if (v < 0) { dan_buf m = { NULL, 0, 0 }; dan_buf_add(&m, DAN_W_MINUS); dan_buf_add(&m, b.s); dan_buf_free(&b); return dan_buf_str(&m); }\n    return dan_buf_str(&b);\n}\nstatic dan_str dan_money_words_kop(int64_t kop, int line) {\n    if (kop < 0) dan_error(DAN_MSG_NEG_MONEY, line);\n    int64_t rub = kop / 100, k = kop % 100;\n    dan_buf b = { NULL, 0, 0 };\n    dan_buf_add(&b, dan_in_words(rub));\n    dan_buf_add(&b, \" \");\n    int f = dan_plural_form((uint64_t)rub);\n    dan_buf_add(&b, f == 0 ? DAN_W_RUB1 : f == 1 ? DAN_W_RUB2 : DAN_W_RUB5);\n    char num[8];\n    snprintf(num, sizeof num, \" %02d \", (int)k);\n    dan_buf_add(&b, num);\n    f = dan_plural_form((uint64_t)k);\n    dan_buf_add(&b, f == 0 ? DAN_W_KOP1 : f == 1 ? DAN_W_KOP2 : DAN_W_KOP5);\n    return dan_buf_str(&b);\n}\nstatic int64_t dan_to_kop_rat(dan_rat v, int line) {\n"
    + "    if (v.n < 0) dan_error(DAN_MSG_NEG_MONEY, line);\n    dan_i128 k = ((dan_i128)v.n * 200 + v.d) / (2 * (dan_i128)v.d);   /* до копеек с округлением половины вверх */\n    if (k > INT64_MAX) dan_error(DAN_MSG_TOO_BIG, line);\n    return (int64_t)k;\n}\nstatic dan_str dan_money_digits_kop(int64_t kop) {\n    char digits[24], out[48];\n    int n = snprintf(digits, sizeof digits, \"%lld\", (long long)(kop / 100)), k = 0;\n    for (int i = 0; i < n; i++) {\n        if (i > 0 && (n - i) % 3 == 0) out[k++] = ' ';\n        out[k++] = digits[i];\n    }\n    snprintf(out + k, sizeof out - (size_t)k, \",%02d\", (int)(kop % 100));\n    return dan_strdup(out);\n}\nstatic dan_str dan_money_digits_rat(dan_rat v, int line) { return dan_money_digits_kop(dan_to_kop_rat(v, line)); }\nstatic dan_str dan_money_digits_float(double v, int line) {\n    if (v < 0) dan_error(DAN_MSG_NEG_MONEY, line);\n    return dan_money_digits_kop(dan_float_to_i64(floor(v * 100 + 0.5), line));\n}\nstatic dan_str dan_money_words_rat(dan_rat v, int line) {\n    if (v.n < 0) dan_error(DAN_MSG_NEG_MONEY, line);\n    dan_i128 k = ((dan_i128)v.n * 200 + v.d) / (2 * (dan_i128)v.d);   /* до копеек с округлением половины вверх */\n    if (k > INT64_MAX) dan_error(DAN_MSG_TOO_BIG, line);\n    return dan_money_words_kop((int64_t)k, line);\n}\nstatic dan_str dan_money_words_float(double v, int line) {\n    if (v < 0) dan_error(DAN_MSG_NEG_MONEY, line);\n    return dan_money_words_kop(dan_float_to_i64(floor(v * 100 + 0.5), line), line);\n}\n\n/* -- progressions -- */\nstatic void dan_term_check(int64_t n, int line) { if (n < 1) dan_error(DAN_MSG_TERM_N, line); }\nstatic dan_rat dan_arith_term_rat(dan_rat a, dan_rat d, int64_t n, int line) {\n    dan_term_check(n, line);\n    return dan_rat_add(a, dan_rat_mul(d, dan_rat_from_int(n - 1, line), line), line);\n}\nstatic double dan_arith_term_float(double a, double d, int64_t n, int line) { dan_term_check(n, line); return a + d * (double)(n - 1); }\nstatic dan_rat dan_arith_sum_rat(dan_rat a, dan_rat d, int64_t n, int line) {\n    dan_rat last = dan_arith_term_rat(a, d, n, line);\n    return dan_rat_div(dan_rat_mul(dan_rat_add(a, last, line), dan_rat_from_int(n, line), line), dan_rat_from_int(2, line), line);\n}\nstatic double dan_arith_sum_float(double a, double d, int64_t n, int line) { return (a + dan_arith_term_float(a, d, n, line)) * (double)n / 2; }\nstatic dan_rat dan_geom_term_rat(dan_rat b, dan_rat q, int64_t n, int line) { dan_term_check(n, line); return dan_rat_mul(b, dan_rat_pow(q, n - 1, line), line); }\nstatic double dan_geom_term_float(double b, double q, int64_t n, int line) { dan_term_check(n, line); return b * pow(q, (double)(n - 1)); }\nstatic dan_rat dan_geom_sum_rat(dan_rat b, dan_rat q, int64_t n, int line) {\n    dan_term_check(n, line);\n    if (q.n == q.d) return dan_rat_mul(b, dan_rat_from_int(n, line), line);\n    dan_rat one = dan_rat_from_int(1, line);\n    return dan_rat_div(dan_rat_mul(b, dan_rat_sub(dan_rat_pow(q, n, line), one, line), line), dan_rat_sub(q, one, line), line);\n}\nstatic double dan_geom_sum_float(double b, double q, int64_t n, int line) {\n    dan_term_check(n, line);\n    if (q == 1) return b * (double)n;\n    return b * (pow(q, (double)n) - 1) / (q - 1);\n}\n\n/* -- financial mathematics (ставки в процентах) -- */\nstatic dan_rat dan_pct_r(dan_rat r, int line) { return dan_rat_div(r, dan_rat_from_int(100, line), line); }\nstatic dan_rat dan_simple_interest_rat(dan_rat s, dan_rat r, dan_rat t, int line) {\n    return dan_rat_mul(s, dan_rat_add(dan_rat_from_int(1, line), dan_rat_mul(dan_pct_r(r, line), t, line), line), line);\n}\nstatic double dan_simple_interest_float(double s, double r, double t) { return s * (1 + r / 100 * t); }\nstatic dan_rat dan_compound_rat(dan_rat s, dan_rat r, int64_t t, int line) {\n    if (t < 0) dan_error(DAN_MSG_NEG_LENGTH, line);\n    return dan_rat_mul(s, dan_rat_pow(dan_rat_add(dan_rat_from_int(1, line), dan_pct_r(r, line), line), t, line), line);\n}\n"
    + "static double dan_compound_float(double s, double r, double t) { return s * pow(1 + r / 100, t); }\nstatic double dan_compound_n(double s, double r, double t, int64_t m, int line) {\n    if (m < 1) dan_error(DAN_MSG_TERM_N, line);\n    return s * pow(1 + r / 100 / (double)m, t * (double)m);\n}\nstatic double dan_annuity(double s, double r, int64_t n, int line) {\n    if (n < 1) dan_error(DAN_MSG_MONTHS, line);\n    double i = r / 1200;\n    if (i == 0) return s / (double)n;\n    return s * i / (1 - pow(1 + i, -(double)n));\n}\nstatic double dan_present_value(double s, double r, double t) { return s / pow(1 + r / 100, t); }\nstatic double dan_npv(double r, const dl_Lf *cf) {\n    double s = 0, k = 1, q = 1 + r / 100;\n    for (int64_t i = 0; i < cf->len; i++) { s += cf->items[i] / k; k *= q; }\n    return s;\n}\nstatic do_f dan_irr(const dl_Lf *cf, int line) {\n    (void)line;\n    double lo = -99.999999, hi = 1e6, flo = dan_npv(lo, cf), fhi = dan_npv(hi, cf);\n    /* ищем отрезок со сменой знака на сетке, затем делим пополам */\n    double prev = lo, fprev = flo;\n    bool found = false;\n    for (double x = -99.0; x <= hi; x = x < 100 ? x + 1 : x * 1.1) {\n        double fx = dan_npv(x, cf);\n        if (fprev == 0) { return do_f_some(prev); }\n        if ((fprev < 0) != (fx < 0)) { lo = prev; hi = x; flo = fprev; fhi = fx; found = true; break; }\n        prev = x; fprev = fx;\n    }\n    if (!found) return do_f_none();\n    for (int it = 0; it < 200; it++) {\n        double mid = (lo + hi) / 2, fm = dan_npv(mid, cf);\n        if ((flo < 0) == (fm < 0)) { lo = mid; flo = fm; } else { hi = mid; fhi = fm; }\n    }\n    (void)fhi;\n    return do_f_some((lo + hi) / 2);\n}\nstatic double dan_real_rate(double nominal, double inflation) { return ((1 + nominal / 100) / (1 + inflation / 100) - 1) * 100; }\nstatic dan_rat dan_daily_interest(dan_rat s, dan_rat r, int64_t days, int64_t year, int line) {\n    if (year <= 0 || days < 0) dan_error(DAN_MSG_YEAR_DAYS, line);\n    return dan_rat_div(dan_rat_mul(dan_rat_mul(s, dan_pct_r(r, line), line), dan_rat_from_int(days, line), line),\n                       dan_rat_from_int(year, line), line);\n}\n\n/* -- parsing numbers: errors as values -- */\nstatic dan_str dan_not_number_msg(dan_str s, const char *what) {\n    dan_buf b = { NULL, 0, 0 };\n    dan_buf_add(&b, \"\\\"\");\n    dan_buf_add(&b, s);\n    dan_buf_add(&b, what);\n    return dan_buf_str(&b);\n}\nstatic dr_i dan_parse_int_res(dan_str s, int line) {\n    const char *p = s;\n    while (*p == ' ' || *p == '\\t') p++;\n    errno = 0;\n    char *end;\n    long long v = strtoll(p, &end, 10);\n    if (end == p) return dr_i_err(dan_not_number_msg(s, DAN_TXT_NOT_INT), line);\n    while (*end == ' ' || *end == '\\t' || *end == '\\n' || *end == '\\r') end++;\n    if (*end) return dr_i_err(dan_not_number_msg(s, DAN_TXT_NOT_INT), line);\n    if (errno == ERANGE) return dr_i_err(dan_not_number_msg(s, DAN_TXT_INT_BIG), line);\n    return dr_i_some((int64_t)v);\n}\nstatic dr_f dan_parse_float_res(dan_str s, int line) {\n    size_t n = strlen(s);\n    char *t = dan_alloc(n + 1);\n    for (size_t i = 0; i <= n; i++) t[i] = s[i] == ',' ? '.' : s[i];\n    const char *p = t;\n    while (*p == ' ' || *p == '\\t') p++;\n    char *end;\n    double v = strtod(p, &end);\n    bool bad = end == p;\n    while (*end == ' ' || *end == '\\t' || *end == '\\n' || *end == '\\r') end++;\n    if (*end) bad = true;\n    dan_free(t);\n    if (bad) return dr_f_err(dan_not_number_msg(s, DAN_TXT_NOT_FLOAT), line);\n    return dr_f_some(v);\n}\n\n/* -- logic -- */\nstatic bool dan_implies(bool a, bool b) { return !a || b; }\nstatic bool dan_equiv(bool a, bool b) { return a == b; }\nstatic bool dan_xor(bool a, bool b) { return a != b; }\n\n/* -- linear programming: max c·x, A·x <= b, x >= 0, b >= 0; exact simplex with Bland's rule -- */\nstatic do_Lr dan_lp(const dl_Lr *c, const dl_LLr *a, const dl_Lr *b, bool minimize, int line) {\n    int64_t n = c->len, m = a->len;\n    if (n == 0 || m != b->len) dan_error(DAN_MSG_LP_DIMS, line);\n"
    + "    for (int64_t i = 0; i < m; i++) {\n        if (a->items[i]->len != n) dan_error(DAN_MSG_LP_DIMS, line);\n        if (b->items[i].n < 0) dan_error(DAN_MSG_LP_RHS, line);\n    }\n    int64_t w = n + m + 1;                      /* столбцы: x, дополнительные, правая часть */\n    dan_rat *t = dan_alloc(sizeof(dan_rat) * (size_t)((m + 1) * w));\n    int64_t *basis = dan_alloc(sizeof(int64_t) * (size_t)(m ? m : 1));\n    dan_rat zero = { 0, 1 }, one = { 1, 1 };\n    for (int64_t i = 0; i < (m + 1) * w; i++) t[i] = zero;\n    for (int64_t i = 0; i < m; i++) {\n        for (int64_t j = 0; j < n; j++) t[i * w + j] = a->items[i]->items[j];\n        t[i * w + n + i] = one;\n        t[i * w + w - 1] = b->items[i];\n        basis[i] = n + i;\n    }\n    for (int64_t j = 0; j < n; j++) t[m * w + j] = minimize ? c->items[j] : dan_rat_neg(c->items[j], line);\n    for (;;) {\n        int64_t col = -1;\n        for (int64_t j = 0; j < w - 1; j++) if (t[m * w + j].n < 0) { col = j; break; }   /* правило Бленда */\n        if (col < 0) break;\n        int64_t row = -1;\n        dan_rat best = zero;\n        for (int64_t i = 0; i < m; i++) {\n            if (t[i * w + col].n <= 0) continue;\n            dan_rat ratio = dan_rat_div(t[i * w + w - 1], t[i * w + col], line);\n            if (row < 0 || dan_rat_cmp(ratio, best) < 0 || (dan_rat_cmp(ratio, best) == 0 && basis[i] < basis[row])) {\n                row = i; best = ratio;\n            }\n        }\n        if (row < 0) { dan_free(t); dan_free(basis); return do_Lr_none(); }   /* целевая функция не ограничена */\n        dan_rat pv = t[row * w + col];\n        for (int64_t j = 0; j < w; j++) t[row * w + j] = dan_rat_div(t[row * w + j], pv, line);\n        for (int64_t i = 0; i <= m; i++) {\n            if (i == row || t[i * w + col].n == 0) continue;\n            dan_rat f = t[i * w + col];\n            for (int64_t j = 0; j < w; j++) t[i * w + j] = dan_rat_sub(t[i * w + j], dan_rat_mul(f, t[row * w + j], line), line);\n        }\n        basis[row] = col;\n    }\n    dl_Lr *x = dl_Lr_from(0, NULL);\n    for (int64_t j = 0; j < n; j++) dl_Lr_push(x, zero);\n    for (int64_t i = 0; i < m; i++) if (basis[i] < n) x->items[basis[i]] = t[i * w + w - 1];\n    dan_free(t);\n    dan_free(basis);\n    return do_Lr_some(x);\n}\nstatic do_Lr dan_lp_max(const dl_Lr *c, const dl_LLr *a, const dl_Lr *b, int line) { return dan_lp(c, a, b, false, line); }\nstatic do_Lr dan_lp_min(const dl_Lr *c, const dl_LLr *a, const dl_Lr *b, int line) { return dan_lp(c, a, b, true, line); }\n")
}

/// Версия компилятора.
общий функ версия() -> стр { вернуть "1.4" }

/// Редакции языка: год и описание.
общий функ редакции() -> [[стр]] {
    вернуть [["2026", "первая редакция (Дан 1.0)"]]
}

/// Сообщения (имя макроса C и текст) по наборам.
общий функ сообщения(набор: стр) -> [[стр]] {
    выбор набор {
        "основные" { вернуть [["DAN_MSG_RUNTIME", "Ошибка выполнения в строке %d: %s\n"], ["DAN_MSG_RUNTIME_FILE", "Ошибка выполнения в файле %s, строка %d: %s\n"], ["DAN_MSG_DIV_ZERO", "деление на ноль"], ["DAN_MSG_NOT_EXACT", "%s не делится нацело на %s, поэтому точное частное нельзя записать значением этого типа; для деления с остатком используйте частное(а, б) и а %% б"], ["DAN_MSG_MOD_ZERO", "остаток от деления на ноль"], ["DAN_MSG_NO_MEMORY", "недостаточно памяти"], ["DAN_MSG_RUNTIME_NOLINE", "Ошибка выполнения: %s\n"], ["DAN_MSG_CX_LOG_ZERO", "логарифм нуля не определён"], ["DAN_MSG_BAD_MONTH", "номер месяца должен быть от 1 до 12"], ["DAN_MSG_DATE_RANGE", "дата выходит за пределы 01.01.0001 - 31.12.9999"], ["DAN_MSG_NO_DATE", "даты %02lld.%02lld.%04lld не существует"], ["DAN_MSG_NOT_DATE", "строку \"%s\" нельзя преобразовать в дату: нужна запись вида 26.10.2026 или 2026-10-26"], ["DAN_MSG_EXT_RANGE", "число не помещается в 32-разрядное целое, которое принимает внешняя функция"], ["DAN_MSG_BIG_HUGE", "длинное число слишком велико: больше трёх миллиардов двоичных разрядов"], ["DAN_MSG_BIG_TO_INT", "значение длинного числа не помещается в тип цел"], ["DAN_MSG_NOT_BIG", "«%s» - не целое число"], ["DAN_MSG_DEADLOCK", "Ошибка выполнения: взаимная блокировка - все задачи ждут друг друга, и ни одна не может продолжить:\n"], ["DAN_TXT_MAIN_WAITS", "  главная программа ждёт "], ["DAN_TXT_TASK_WAITS", "  задача, запущенная в строке %d, ждёт "], ["DAN_TXT_WAIT_RECV", "значения из канала"], ["DAN_TXT_WAIT_SEND", "места в канале или получателя значения"], ["DAN_TXT_WAIT_TASK", "завершения задачи"], ["DAN_TXT_AT_LINE", "%s в строке %d\n"], ["DAN_TXT_AT_FILE_LINE", "%s в файле %s, строка %d\n"], ["DAN_MSG_SEND_CLOSED", "отправка значения в закрытый канал"], ["DAN_MSG_CLOSE_TWICE", "канал уже закрыт"], ["DAN_MSG_CHAN_CAP", "запас канала не может быть отрицательным"], ["DAN_MSG_THREAD", "не удалось запустить задачу: система не выделила поток"], ["DAN_MSG_DEEP_DATA", "значение собственного типа вложено слишком глубоко (например, очень длинная цепочка звеньев), и его нельзя целиком сравнить, вывести или скопировать"], ["DAN_MSG_DEEP", "слишком глубокая рекурсия: функция из этой строки вызвала себя слишком много раз, не завершившись; проверьте условие остановки рекурсии или замените её циклом"], ["DAN_MSG_TOO_BIG", "результат слишком велик для типа цел"], ["DAN_MSG_INDEX", "индекс %lld за пределами (длина %lld)"], ["DAN_MSG_NO_KEY", "в словаре нет ключа "], ["DAN_MSG_EMPTY_SEARCH", "искомая строка не может быть пустой"], ["DAN_MSG_NEG_REPEAT", "число повторений не может быть отрицательным"], ["DAN_MSG_NOT_INT", "строку \"%s\" нельзя преобразовать в целое число"], ["DAN_MSG_INT_RANGE", "число \"%s\" слишком велико для типа цел"], ["DAN_MSG_NOT_FLOAT", "строку \"%s\" нельзя преобразовать в число"], ["DAN_MSG_FLOAT_RANGE", "дробное число слишком велико для типа цел или не является числом"], ["DAN_MSG_RAT_BIG", "числитель или знаменатель дроби слишком велик"], ["DAN_MSG_NOT_RAT", "строку \"%s\" нельзя преобразовать в дробь"], ["DAN_MSG_NOT_FINITE", "бесконечность или не-число нельзя преобразовать в дробь"], ["DAN_MSG_NEG_POW", "целое число в отрицательной степени не является целым; используйте рац(а) ^ н или дробное число"], ["DAN_TXT_BYTES", "байты"], ["DAN_TRUE", "истина"], ["DAN_TEST_PASSED", "пройден: %s\n"], ["DAN_TEST_FAILED", "ПРОВАЛЕН: %s (строка %d): %s\n"], ["DAN_TEST_FAILED_FILE", "ПРОВАЛЕН: %s (%s, строка %d): %s\n"], ["DAN_TEST_TOTAL", "Тестов: %d, пройдено: %d, провалено: %d\n"], ["DAN_FALSE", "ложь"]] }
        "отладчик" { вернуть [["DAN_TXT_DBG_HELLO", "Отладчик Дана. Команды: шаг (ш), далее (д), выйти_из (вы), продолжить (п), точка 12 (тч), убрать 12 (у), показать (пк), показать имя, стек (ст), текст (т), стоп (с). Пустая строка повторяет прошлую команду."], ["DAN_TXT_DBG_PROMPT", "(отладка) "], ["DAN_TXT_DBG_HELP", "Команды: шаг (ш) - к следующей строке, заходя в функции; далее (д) - к следующей строке, не заходя в функции; выйти_из (вы) - до выхода из текущей функции; продолжить (п) - до точки остановки или конца; точка 12 (тч 12) или точка файл.dan:12 - точка остановки, точка - список; убрать 12 (у 12); показать (пк) - переменные функции, показать имя - одну; стек (ст) - цепочка вызовов; текст (т) - строки вокруг текущей; стоп (с) - завершить программу."], ["DAN_TXT_DBG_NO_VARS", "  переменных пока нет"], ["DAN_TXT_DBG_NO_VAR", "  такой переменной здесь нет"], ["DAN_TXT_DBG_NO_BPS", "  точек остановки нет"], ["DAN_TXT_DBG_NO_FILE", "  такого файла в программе нет"], ["DAN_TXT_DBG_BAD_LINE", "  укажите номер строки: точка 12"], ["DAN_TXT_DBG_BP_SET", "  точка остановки: "], ["DAN_TXT_DBG_ERROR", "Ошибка выполнения: %s\nПрограмма остановлена в "], ["DAN_TXT_DBG_AFTER_ERROR", "  после ошибки программа продолжиться не может: посмотрите переменные (показать, стек) и завершите её (продолжить или стоп)"]] }
        "данные" { вернуть [["DAN_MSG_OPEN", "не удалось открыть файл \"%s\": %s"], ["DAN_MSG_OPEN_WRITE", "не удалось открыть файл \"%s\" для записи: %s"], ["DAN_MSG_READ", "ошибка чтения файла \"%s\": %s"], ["DAN_MSG_WRITE", "ошибка записи файла \"%s\": %s"], ["DAN_MSG_DELETE", "не удалось удалить файл \"%s\": %s"], ["DAN_MSG_MKDIR", "не удалось создать папку \"%s\": %s"], ["DAN_MSG_OPEN_DIR", "не удалось открыть папку \"%s\": %s"], ["DAN_MSG_RMDIR", "не удалось удалить \"%s\": %s"], ["DAN_MSG_RENAME", "не удалось переименовать \"%s\": %s"], ["DAN_TXT_ENOENT", "файл или папка не найдены"], ["DAN_TXT_EACCES", "нет доступа"], ["DAN_TXT_EIO", "ошибка ввода-вывода"], ["DAN_MSG_BYTE_RANGE", "байт - это число от 0 до 255"], ["DAN_MSG_HEX", "строка \"%s\" не является шестнадцатеричной записью байтов"], ["DAN_MSG_RANDOM", "не удалось получить случайные числа от операционной системы"], ["DAN_MSG_NOT_ENCRYPTED", "данные не являются зашифрованными данными Дан"], ["DAN_MSG_ENC_VERSION", "данные зашифрованы более новой версией Дан"], ["DAN_MSG_BAD_PASSWORD", "неверный пароль или данные повреждены"], ["DAN_MSG_CORRUPT", "данные повреждены"], ["DAN_MSG_NEED_PASSWORD", "данные зашифрованы: для распаковки укажите пароль"], ["DAN_MSG_NOT_COMPRESSED", "данные не являются сжатыми данными (форматы .xz и gzip)"], ["DAN_MSG_XZ_FILTER", "в данных .xz используется фильтр, который не поддерживается (поддерживается LZMA2)"], ["DAN_MSG_ZIP_BIG", "архив слишком велик: файлы до 4 ГБ и не больше 65535 файлов"], ["DAN_MSG_NOT_ZIP", "файл не является zip-архивом"], ["DAN_MSG_ZIP_UNSAFE", "небезопасное имя в архиве, файл не извлечён: \"%s\""], ["DAN_MSG_ZIPCRYPTO", "файл \"%s\" зашифрован устаревшим способом ZipCrypto, который не поддерживается"], ["DAN_MSG_ZIP_NEED_PW", "файл \"%s\" в архиве зашифрован: укажите пароль"], ["DAN_MSG_ZIP_BAD_PW", "неверный пароль для файла \"%s\" или архив повреждён"], ["DAN_MSG_ZIP_METHOD", "метод сжатия %s в архиве не поддерживается"], ["DAN_TXT_XML_ROW", "XML, строка "], ["DAN_TXT_XML_COL", ", позиция "], ["DAN_TXT_XML_LT", "знак «<» внутри значения атрибута нужно записывать как &lt;"], ["DAN_TXT_XML_ENTITY", "неизвестная или незакрытая ссылка «&...;» (знак & записывается как &amp;)"], ["DAN_TXT_XML_NAME", "ожидалось имя элемента или атрибута"], ["DAN_TXT_XML_OUTSIDE", "текст вне корневого элемента"], ["DAN_TXT_XML_COMMENT", "комментарий <!-- не закрыт"], ["DAN_TXT_XML_PI", "инструкция <? не закрыта"], ["DAN_TXT_XML_CDATA", "раздел <![CDATA[ не закрыт"], ["DAN_TXT_XML_UNCLOSED", "конструкция не закрыта"], ["DAN_TXT_XML_GT", "ожидался знак «>»"], ["DAN_TXT_XML_MISMATCH", "закрывающий тег </%s> не соответствует открытому <%s>"], ["DAN_TXT_XML_TWO_ROOTS", "второй корневой элемент: в документе XML корневой элемент один"], ["DAN_TXT_XML_ATTR", "неверная запись атрибута: нужно имя=\"значение\""], ["DAN_TXT_XML_DEEP", "слишком глубокая вложенность элементов (больше 10000)"], ["DAN_TXT_XML_NOT_CLOSED", "текст закончился, а элемент <%s> не закрыт"], ["DAN_TXT_XML_EMPTY", "в тексте нет ни одного элемента"], ["DAN_TXT_PDF_NOT", "это не документ PDF"], ["DAN_TXT_PDF_BROKEN", "документ PDF повреждён: не найден его каталог (Root)"], ["DAN_TXT_PDF_ENCRYPTED", "документ PDF зашифрован (защищён паролем или ограничениями); снимите защиту в программе просмотра PDF и сохраните копию"], ["DAN_TXT_PDF_FONTS", "загружено слишком много шрифтов (больше 32)"], ["DAN_TXT_PDF_NOFONT1", "шрифт «"], ["DAN_TXT_PDF_NOFONT2", "» не найден"], ["DAN_TXT_PDF_BADFONT", "» - не шрифт TrueType (.ttf)"], ["DAN_TXT_PDF_OTF", "» - шрифт OpenType с контурами CFF (.otf), такие шрифты не поддерживаются; выберите шрифт .ttf"], ["DAN_TXT_PDF_NOCMAP", "» не содержит таблицы символов Юникода"], ["DAN_MSG_PDF_FONTNUM", "неверный номер шрифта PDF"], ["DAN_MSG_B64_WIDTH", "длина строки Base64 должна быть положительной и кратной 4"], ["DAN_TXT_B64_BAD", "текст не является записью Base64"], ["DAN_MSG_ZIP_PAIRS", "для архива нужен список пар [имя, содержимое, ...]: чётное число