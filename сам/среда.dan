        "математика" { вернуть [["DAN_MSG_NATURAL", "функция \"%s\" определена только для натуральных чисел (1, 2, 3, ...), а получено %lld"], ["DAN_MSG_NEG_COUNT", "количество кратных не может быть отрицательным"], ["DAN_MSG_EMPTY_LIST", "функции \"%s\" нужен хотя бы один элемент в списке"], ["DAN_MSG_PERIOD_LONG", "период дроби слишком длинный (больше 100000 цифр)"], ["DAN_MSG_UNIT_UNKNOWN", "неизвестная единица измерения \"%s\""], ["DAN_MSG_UNIT_KIND", "единицы \"%s\" и \"%s\" измеряют разные величины"], ["DAN_MSG_SQRT_NEG", "квадратный корень из отрицательного числа не существует"], ["DAN_MSG_EMPTY_STAT", "у пустого списка нет такой характеристики"], ["DAN_MSG_MIXED", "в смешанном числе числитель и знаменатель дробной части должны быть неотрицательными, а знаменатель больше нуля"], ["DAN_MSG_POLY_NEG_POW", "многочлен нельзя возводить в отрицательную степень"], ["DAN_MSG_POLY_BIG", "многочлен слишком сложен: степень или коэффициенты слишком велики"], ["DAN_MSG_ANY_X", "уравнение верно при любом значении х"], ["DAN_MSG_BAD_REL", "неизвестный знак сравнения \"%s\"; используйте <, <=, >, >=, =, !="], ["DAN_MSG_SYS_SHAPE", "в системе из N уравнений каждая строка должна содержать N коэффициентов и свободный член"], ["DAN_MSG_SYS_NONE", "система не имеет решений"], ["DAN_MSG_SYS_MANY", "система имеет бесконечно много решений"], ["DAN_MSG_NOT_QUADRATIC", "это не квадратное уравнение: коэффициент при х² равен нулю"], ["DAN_MSG_DEG_TWO", "дискриминант определён для многочлена второй степени"], ["DAN_MSG_INEQ_LISTS", "списки левых частей, знаков и правых частей должны быть одной длины"], ["DAN_TXT_NONE", "нет решений"], ["DAN_TXT_X", "х"], ["DAN_TXT_MINF", "-∞"], ["DAN_TXT_PINF", "+∞"], ["DAN_TXT_UNION", " ∪ "], ["DAN_TXT_LE", "≤"], ["DAN_TXT_GE", "≥"], ["DAN_TXT_NE", "≠"], ["DAN_TXT_NOT_INT", "\" - не целое число"], ["DAN_TXT_INT_BIG", "\" - слишком большое число для типа цел"], ["DAN_TXT_NOT_FLOAT", "\" - не число"], ["DAN_MSG_TAN", "тангенс не определён для угла пи/2 + пи·к (90° + 180°·к)"], ["DAN_MSG_CTG", "котангенс не определён для угла пи·к (180°·к)"], ["DAN_MSG_ASIN", "арксинус и арккосинус определены для чисел от -1 до 1"], ["DAN_MSG_LOG", "логарифм определён только для положительных чисел"], ["DAN_MSG_LOG_BASE", "основание логарифма должно быть положительным и не равным 1"], ["DAN_MSG_ROOT", "корень чётной степени из отрицательного числа не существует среди действительных чисел"], ["DAN_MSG_ROOT_DEG", "степень корня должна быть натуральным числом"], ["DAN_MSG_NEG_ORDER", "порядок производной не может быть отрицательным"], ["DAN_MSG_NEG_FACT", "факториал определён для целых чисел от 0"], ["DAN_MSG_COMB_RANGE", "должно выполняться 0 ≤ к ≤ н"], ["DAN_MSG_COMB_N", "число элементов н должно быть натуральным"], ["DAN_MSG_PROB_RANGE", "число благоприятных исходов должно быть от 0 до числа всех исходов, а всех исходов - больше 0"], ["DAN_MSG_P_RANGE", "вероятность должна быть от 0 до 1"], ["DAN_MSG_DIST_LEN", "у значений и вероятностей должно быть одинаковое число элементов"], ["DAN_MSG_DIST_SUM", "сумма вероятностей должна быть равна 1"], ["DAN_MSG_STAT_EMPTY", "для расчёта нужен хотя бы один элемент"], ["DAN_MSG_STAT_TWO", "для расчёта нужно хотя бы два элемента"], ["DAN_MSG_SERIES_LEN", "ряды должны иметь одинаковое число элементов"], ["DAN_MSG_CONST_SERIES", "у ряда без разброса значений корреляция и регрессия не определены"], ["DAN_MSG_RANDOM_RANGE", "нижняя граница случайного числа больше верхней"], ["DAN_MSG_MATRIX_EMPTY", "матрица должна содержать хотя бы один элемент"], ["DAN_MSG_MATRIX_RECT", "все строки матрицы должны иметь одинаковую длину"], ["DAN_MSG_MATRIX_SQUARE", "матрица должна быть квадратной"], ["DAN_MSG_MATRIX_SINGULAR", "матрица вырожденная (определитель равен 0), обратной матрицы нет"], ["DAN_MSG_MATRIX_DIMS", "размеры матриц не подходят для этого действия"], ["DAN_MSG_VECTOR_LEN", "векторы должны иметь одинаковую длину"], ["DAN_MSG_VECTOR_3", "векторное произведение определено для трёхмерных векторов"], ["DA