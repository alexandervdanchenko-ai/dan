/// Типы, которые использует код библиотеки.
общий функ нужные_типы(набор: стр) -> [стр] {
    выбор набор {
        "данные" { вернуть ["[байты]", "[байты]!", "[стр]!", "[[стр]]!", "цел!", "байты!"] }
        "система" { вернуть ["[стр]", "стр?", "стр!", "дата!"] }
        "сеть" { вернуть ["[байты]", "[байты]!", "байты!", "[стр]"] }
        "база" { вернуть ["[байты]", "[байты]!", "цел!"] }
        "окна" { вернуть ["[цел]", "[стр]", "стр?", "цел!"] }
        "высшая" { вернуть ["[[дроб]]", "[рац]?", "цел?", "дроб?", "цел!", "дроб!"] }
        иначе { вернуть [] }
    }
}

/// Постоянные библиотеки: имя -> выражение C.
общий функ постоянные_c() -> {стр: стр} {
    перем п: {стр: стр} = {}
    п["пи"] = "3.141592653589793"
    п["х"] = "dan_poly_x()"
    п["x"] = "dan_poly_x()"
    п["е"] = "2.718281828459045"
    п["e"] = "2.718281828459045"
    вернуть п
}

/// Функции библиотеки: каноническое имя -> описание.
общий функ описания() -> {стр: Описание} {
    перем о: {стр: Описание} = {}
    о["модуль"] = Описание("", "", ["dan_abs_int", "dan_rat_abs", "dan_abs_float", "dan_cx_abs"], [истина, истина, ложь, ложь])
    о["делится"] = Описание("", "", ["dan_divides"], [истина])
    о["чётное"] = Описание("", "", ["dan_even"], [ложь])
    о["нечётное"] = Описание("", "", ["dan_odd"], [ложь])
    о["простое"] = Описание("", "", ["dan_prime"], [ложь])
    о["делители"] = Описание("", "", ["dan_divisors"], [истина])
    о["кратные"] = Описание("", "", ["dan_multiples"], [истина])
    о["простые_множители"] = Описание("", "", ["dan_prime_factors"], [истина])
    о["частное"] = Описание("", "", ["dan_div", "dan_big_div", "dan_poly_div"], [истина, истина, истина])
    о["нод"] = Описание("", "", ["dan_gcd", "dan_gcd_list"], [истина, истина])
    о["нок"] = Описание("", "", ["dan_lcm", "dan_lcm_list"], [истина, истина])
    о["цифры"] = Описание("", "", ["dan_digits"], [ложь])
    о["сумма_цифр"] = Описание("", "", ["dan_digit_sum"], [ложь])
    о["разряды"] = Описание("", "", ["dan_place_values"], [ложь])
    о["пропорция"] = Описание("", "", ["dan_f_0_r", "dan_f_1_f"], [истина, истина])
    о["процент"] = Описание("", "", ["dan_f_2_r", "dan_f_3_f"], [истина, истина])
    о["сколько_процентов"] = Описание("", "", ["dan_f_4_r", "dan_f_5_f"], [истина, истина])
    о["число_по_проценту"] = Описание("", "", ["dan_f_6_r", "dan_f_7_f"], [истина, истина])
    о["периметр_прямоугольника"] = Описание("", "", ["dan_f_8_i", "dan_f_9_r", "dan_f_10_f"], [истина, истина, истина])
    о["площадь_прямоугольника"] = Описание("", "", ["dan_f_11_i", "dan_f_12_r", "dan_f_13_f"], [истина, истина, истина])
    о["периметр_квадрата"] = Описание("", "", ["dan_f_14_i", "dan_f_15_r", "dan_f_16_f"], [истина, истина, истина])
    о["площадь_квадрата"] = Описание("", "", ["dan_f_17_i", "dan_f_18_r", "dan_f_19_f"], [истина, истина, истина])
    о["площадь_треугольника"] = Описание("", "", ["dan_f_20_r", "dan_f_21_f"], [истина, истина])
    о["объем_куба"] = Описание("", "", ["dan_f_22_i", "dan_f_23_r", "dan_f_24_f"], [истина, истина, истина])
    о["объем_параллелепипеда"] = Описание("", "", ["dan_f_25_i", "dan_f_26_r", "dan_f_27_f"], [истина, истина, истина])
    о["площадь_круга"] = Описание("", "", ["dan_f_28_f"], [истина])
    о["длина_окружности"] = Описание("", "", ["dan_f_29_f"], [истина])
    о["смешанное"] = Описание("", "", ["dan_mixed_str", "dan_mixed_make"], [ложь, истина])
    о["периодическая"] = Описание("", "", ["dan_periodic"], [истина])
    о["округлить"] = Описание("", "", ["dan_round_rat", "dan_round_float", "dan_round_int_places", "dan_round_rat_places", "dan_round_float_places"], [истина, истина, истина, истина, истина])
    о["корень"] = Описание("", "", ["dan_sqrt", "dan_nroot", "dan_cx_sqrt"], [истина, истина, ложь])
    о["целый_корень"] = Описание("", "", ["dan_isqrt"], [истина])
    о["перевести"] = Описание("", "", ["dan_convert_units"], [истина])
    о["упорядочить"] = Описание("", "", ["dan_sorted_i", "dan_sorted_r", "dan_sorted_f", "dan_sorted_s"], [ложь, ложь, ложь, ложь])
    о["множество"] = Описание("", "", ["dan_set_i", "dan_set_s"], [ложь, ложь])
    о["объединение"] = Описание("", "", ["dan_union_i", "dan_union_s"], [ложь, ложь])
    о["пересечение"] = Описание("", "", ["dan_intersection_i", "dan_intersection_s"], [ложь, ложь])
    о["разность"] = Описание("", "", ["dan_difference_i", "dan_difference_s"], [ложь, ложь])
