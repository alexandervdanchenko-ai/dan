        "имена_c" { вернуть [["DAN_NAME_DIVISORS", "делители"], ["DAN_NAME_PRIME_FACTORS", "простые_множители"], ["DAN_NAME_GCD", "нод"], ["DAN_NAME_LCM", "нок"]] }
        иначе { вернуть [] }
