ems[i]) j++;\n        if (j - i > best_count) { best_count = j - i; best = s->items[i]; }\n        i = j;\n    }\n    return best;\n}\nstatic dan_rat dan_f_0_r(dan_rat a0, dan_rat a1, dan_rat a2, int line) { (void)line; return dan_rat_div(dan_rat_mul(a1, a2, line), a0, line); }\nstatic double dan_f_1_f(double a0, double a1, double a2, int line) { (void)line; return ((a1 * a2) / a0); }\nstatic dan_rat dan_f_2_r(dan_rat a0, dan_rat a1, int line) { (void)line; return dan_rat_div(dan_rat_mul(a0, a1, line), dan_rat_from_int(100, line), line); }\nstatic double dan_f_3_f(double a0, double a1, int line) { (void)line; return ((a0 * a1) / 100.0); }\nstatic dan_rat dan_f_4_r(dan_rat a0, dan_rat a1, int line) { (void)line; return dan_rat_div(dan_rat_mul(a0, dan_rat_from_int(100, line), line), a1, line); }\nstatic double dan_f_5_f(double a0, double a1, int line) { (void)line; return ((a0 * 100.0) / a1); }\nstatic dan_rat dan_f_6_r(dan_rat a0, dan_rat a1, int line) { (void)line; return dan_rat_div(dan_rat_mul(a0, dan_rat_from_int(100, line), line), a1, line); }\nstatic double dan_f_7_f(double a0, double a1, int line) { (void)line; return ((a0 * 100.0) / a1); }\nstatic int64_t dan_f_8_i(int64_t a0, int64_t a1, int line) { (void)line; return (INT64_C(2) * (a0 + a1)); }\nstatic dan_rat dan_f_9_r(dan_rat a0, dan_rat a1, int line) { (void)line; return dan_rat_mul(dan_rat_from_int(2, line), dan_rat_add(a0, a1, line), line); }\nstatic double dan_f_10_f(double a0, double a1, int line) { (void)line; return (2.0 * (a0 + a1)); }\nstatic int64_t dan_f_11_i(int64_t a0, int64_t a1, int line) { (void)line; return (a0 * a1); }\nstatic dan_rat dan_f_12_r(dan_rat a0, dan_rat a1, int line) { (void)line; return dan_rat_mul(a0, a1, line); }\nstatic double dan_f_13_f(double a0, double a1, int line) { (void)line; return (a0 * a1); }\nstatic int64_t dan_f_14_i(int64_t a0, int line) { (void)line; return (INT64_C(4) * a0); }\nstatic dan_rat dan_f_15_r(dan_rat a0, int line) { (void)line; return dan_rat_mul(dan_rat_from_int(4, line), a0, line); }\n"
    + "static double dan_f_16_f(double a0, int line) { (void)line; return (4.0 * a0); }\nstatic int64_t dan_f_17_i(int64_t a0, int line) { (void)line; return (a0 * a0); }\nstatic dan_rat dan_f_18_r(dan_rat a0, int line) { (void)line; return dan_rat_mul(a0, a0, line); }\nstatic double dan_f_19_f(double a0, int line) { (void)line; return (a0 * a0); }\nstatic dan_rat dan_f_20_r(dan_rat a0, dan_rat a1, int line) { (void)line; return dan_rat_div(dan_rat_mul(a0, a1, line), dan_rat_from_int(2, line), line); }\nstatic double dan_f_21_f(double a0, double a1, int line) { (void)line; return ((a0 * a1) / 2.0); }\nstatic int64_t dan_f_22_i(int64_t a0, int line) { (void)line; return ((a0 * a0) * a0); }\nstatic dan_rat dan_f_23_r(dan_rat a0, int line) { (void)line; return dan_rat_mul(dan_rat_mul(a0, a0, line), a0, line); }\nstatic double dan_f_24_f(double a0, int line) { (void)line; return ((a0 * a0) * a0); }\nstatic int64_t dan_f_25_i(int64_t a0, int64_t a1, int64_t a2, int line) { (void)line; return ((a0 * a1) * a2); }\nstatic dan_rat dan_f_26_r(dan_rat a0, dan_rat a1, dan_rat a2, int line) { (void)line; return dan_rat_mul(dan_rat_mul(a0, a1, line), a2, line); }\nstatic double dan_f_27_f(double a0, double a1, double a2, int line) { (void)line; return ((a0 * a1) * a2); }\nstatic double dan_f_28_f(double a0, int line) { (void)line; return (3.141592653589793 * (a0 * a0)); }\nstatic double dan_f_29_f(double a0, int line) { (void)line; return ((2.0 * 3.141592653589793) * a0); }\nstatic dan_rat dan_f_30_r(dan_rat a0, dan_rat a1, dan_rat a2, int line) { (void)line; return dan_rat_sub(dan_rat_mul(a1, a1, line), dan_rat_mul(dan_rat_mul(dan_rat_from_int(4, line), a0, line), a2, line), line); }\nstatic double dan_f_31_f(double a0, double a1, double a2, int line) { (void)line; return ((a1 * a1) - ((4.0 * a0) * a2)); }")
}

