    + "    size_t n = strlen(s);\n    char *r = dan_str_new(n);\n    memcpy(r, s, n + 1);\n    return r;\n}\n\nstatic dan_str dan_concat(dan_str a, dan_str b) {\n    size_t la = strlen(a), lb = strlen(b);\n    char *r = dan_str_new(la + lb);\n    memcpy(r, a, la);\n    memcpy(r + la, b, lb + 1);\n    return r;\n}\n\nstatic bool dan_str_eq(dan_str a, dan_str b) { return strcmp(a, b) == 0; }\n\n/* ---- characters of UTF-8 strings ---- */\n\n/* length of the character at s in bytes. Text read from files and bytes may be\n   damaged: a byte that does not start a whole UTF-8 character counts as one\n   character, so the end of the string is never passed. */\nstatic size_t dan_utf8_len_at(const char *s) {\n    const unsigned char *p = (const unsigned char *)s;\n    size_t k = p[0] < 0xC2 ? 1 : p[0] < 0xE0 ? 2 : p[0] < 0xF0 ? 3 : p[0] < 0xF5 ? 4 : 1;\n    for (size_t i = 1; i < k; i++)\n        if ((p[i] & 0xC0) != 0x80) return 1;\n    return k;\n}\n\n/* byte offset of character number i (i may equal the length: end of string) */\nstatic const char *dan_utf8_at(dan_str s, int64_t i) {\n    const char *p = s;\n    while (i > 0 && *p) { p += dan_utf8_len_at(p); i--; }\n    return i == 0 ? p : NULL;\n}\n\nstatic int64_t dan_str_len(dan_str s);\n\nstatic dan_str dan_str_sub(const char *a, const char *b) {\n    size_t n = (size_t)(b - a);\n    char *r = dan_str_new(n);\n    memcpy(r, a, n);\n    r[n] = 0;\n    return r;\n}\n\n/* one-character strings of the first 128 characters (ASCII) and of the Cyrillic\n   block (U+0400 - U+04FF) are shared and never freed: splitting a text into\n   characters and taking a character by its number allocate memory only for\n   other letters */\nstatic const struct { dan_hdr h; char s[2]; } dan_ascii_s[128] = {\n    { DAN_HDR_INIT, { 0, 0 } },\n    { DAN_HDR_INIT, { 1, 0 } },\n    { DAN_HDR_INIT, { 2, 0 } },\n    { DAN_HDR_INIT, { 3, 0 } },\n    { DAN_HDR_INIT, { 4, 0 } },\n    { DAN_HDR_INIT, { 5, 0 } },\n    { DAN_HDR_INIT, { 6, 0 } },\n    {