/// Программа сверки: приводит файлы к единому виду форматированием на Дане.
///
///     python dan.py запустить сам/форматы.dan программа.dan итог.txt [другая.dan итог2.txt ...]
///
/// Для каждой пары файлов во второй записывается текст в едином виде
/// или «ОШИБКА » с сообщением.

подключить "формат"

пусть файлы = аргументы()
перем н = 0
пока н + 1 < файлы.длина {
    пусть текст = прочитать(файлы[н])
    если пусть новый = формат.отформатировать(текст) {
        записать(файлы[н + 1], новый)
    } иначе ошибка о {
        записать(файлы[н + 1], "ОШИБКА " + о)
    }
    н += 2
}
