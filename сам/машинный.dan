/// Машинный вывод сообщений компилятора на Дане: `дан проверить --json`.
///
/// Делает то же, что kody.py: постоянный код сообщения по его обобщённому тексту,
/// готовое исправление, место подчёркивания и запись в JSON - побайтно как у dan.py
/// (это проверяет test_sam.py).

подключить "коды"

/// Сообщение для машинного вывода.
общий тип Замечание {
    вид: стр
    файл: стр
    строка: цел
    столбец: цел
    текст: стр
    фрагмент: стр
}

/// Номер первого вхождения «что» в «т» не раньше «от» или -1.
функ найти_с(т: стр, что: стр, от: цел) -> цел {
    если от >= т.длина { вернуть -1 }
    пусть н = т[от..т.длина - 1].найти(что)
    если н < 0 { вернуть -1 }
    вернуть н + от
}

функ хвост(т: стр, от: цел) -> стр {
    если от >= т.длина { вернуть "" }
    вернуть т[от..т.длина - 1]
}

функ начало(т: стр, до: цел) -> стр {
    если до <= 0 { вернуть "" }
    вернуть т[0..до - 1]
}

функ прописная(з: стр) -> лог {
    пусть к = код_символа(з)
    вернуть (к >= 65 и к <= 90) или (к >= 1040 и к <= 1071) или к == 1025
}

функ без_знаков_справа(с: стр) -> стр {
    перем конец = с.длина
    пока конец > 0 и [",", ".", ")"].содержит(с[конец - 1]) { конец -= 1 }
    вернуть начало(с, конец)
}

функ без_признаков(с: стр) -> стр {
    перем конец = с.длина
    пока конец > 0 и (с[конец - 1] == "?" или с[конец - 1] == "!") { конец -= 1 }
    вернуть начало(с, конец)
}

/// Похоже ли слово сообщения на название типа (как kody._тип_ли).
функ тип_ли(слово: стр) -> лог {
    пусть ядро = без_знаков_справа(слово)
    если ядро == "" или ["Дан", "Дана", "Дане", "Даном", "Дану"].содержит(ядро) { вернуть ложь }
    если ядро[0] == "[" или ядро[0] == "{" или ядро.начинается("функ(") или ядро.содержит("<") { вернуть истина }
    если ["цел", "дроб", "рац", "стр", "лог", "байты", "длинное", "компл", "дата", "мн", "пусто", "диапазон",
            "<неизвестный>"].содержит(без_признаков(ядро)) {
        вернуть истина
    }
    если ядро.содержит(".") {
        перем точка = -1
        для н в 0..ядро.длина - 1 {
            если ядро[н] == "." { точка = н }
        }
        перем после = "а"
        если точка + 1 < ядро.длина { после = ядро[точка + 1] }
        если прописная(после) { вернуть истина }
    }
    вернуть прописная(ядро[0])
}

функ замена_слова(слово: стр) -> стр {
    если не тип_ли(слово) { вернуть слово }
    вернуть "Т" + хвост(слово, без_знаков_справа(слово).длина)
}

/// Шаблон сообщения: текст без подробностей конкретной программы (как kody.обобщить).
общий функ обобщить(текст_: стр) -> стр {
    перем текст = текст_
    пока текст.содержит(" (в «") {
        пусть н = текст.найти(" (в «")
        пусть к = найти_с(текст, ")", н)
        если к < 0 { прервать }
        текст = начало(текст, н) + хвост(текст, к + 1)
    }
    перем итог = ""
    перем н = 0
    пока н < текст.длина {
        пусть з = текст[н]
        если з == "«" или з == "\"" {
            перем закрытие = "\""
            если з == "«" { закрытие = "»" }
            пусть к = найти_с(текст, закрытие, н + 1)
            если к < 0 {
                итог += хвост(текст, н)
                прервать
            }
            если з == "«" { итог += "«*»" } иначе { итог += "*" }
            н = к + 1
            продолжить
        }
        если з == "U" и н + 1 < текст.длина и текст[н + 1] == "+" {
            итог += "U+*"
            н += 2
            пока н < текст.длина и "0123456789ABCDEF*".содержит(текст[н]) { н += 1 }
            продолжить
        }
        если з == "\\" и н + 1 < текст.длина {
            итог += "\\*"
            н += 2
            продолжить
        }
        итог += з
        н += 1
    }
    для разделитель в ["; ", ": ", ", а найдено", ", а передано"] {
        пусть место_ = итог.найти(разделитель)
        если место_ >= 0 { итог = начало(итог, место_) }
    }
    перем без_чисел = ""
    для з в итог.символы() {
        если з >= "0" и з <= "9" {
            если не без_чисел.оканчивается("*") { без_чисел += "*" }
        } иначе {
            без_чисел += з
        }
    }
    перем слова: [стр] = []
    для с в без_чисел.разбить(" ") { слова.добавить(замена_слова(с)) }
    вернуть слова.соединить(" ")
}

/// Код сообщения; Д0000 - шаблона нет в таблице.
общий функ код(текст: стр, таблица: {стр: стр}) -> стр {
    вернуть таблица.получить(обобщить(текст), "Д0000")
}

/// Замена для подчёркнутого места, если сообщение предлагает одну; "" - нет.
общий функ исправление(текст: стр) -> стр {
    для подсказка в ["имелось в виду «", "напишите «"] {
        перем н = текст.найти(подсказка)
        если н < 0 { продолжить }
        н += подсказка.длина
        пусть к = найти_с(текст, "»", н)
        если к < 0 или хвост(текст, к + 1).начинается(" или «") { вернуть "" }
        вернуть текст[н..к - 1]
    }
    вернуть ""
}

/// [позиция, длина] подчёркнутого места по фрагменту; без фрагмента - [столбец, 0].
общий функ место(фрагмент: стр, столбец: цел) -> [цел] {
    если фрагмент == "" { вернуть [столбец, 0] }
    пусть строки = фрагмент.разбить("\n")
    если строки.длина < 2 или не строки[1].содержит(" | ") { вернуть [столбец, 0] }
    пусть указатель = хвост(строки[1], строки[1].найти(" | ") + 3)
    перем отступ = 0
    пока отступ < указатель.длина и указатель[отступ] != "^" { отступ += 1 }
    вернуть [отступ + 1, указатель.длина - отступ]
}

/// Текст для «проверить --json» (как kody.запись_json).
общий функ запись_json(путь: стр, замечания: [Замечание]) -> стр {
    перем ошибок = 0
    для з в замечания {
        если з.вид == "ошибка" { ошибок += 1 }
    }
    пусть начало_ = ("{\"файл\": " + строка_json(путь) + ", \"ошибок\": " + стр(ошибок) + ", \"предупреждений\": "
        + стр(замечания.длина - ошибок) + ", \"сообщения\": [")
    если замечания.длина == 0 { вернуть начало_ + "]}" }
    пусть таблица = коды.коды()
    перем строки: [стр] = []
    для з в замечания {
        пусть м = место(з.фрагмент, з.столбец)
        перем запись = ("{\"вид\": " + строка_json(з.вид) + ", \"код\": " + строка_json(код(з.текст, таблица))
            + ", \"файл\": " + строка_json(з.файл) + ", \"строка\": " + стр(з.строка) + ", \"позиция\": " + стр(м[0])
            + ", \"длина\": " + стр(м[1]) + ", \"текст\": " + строка_json(з.текст))
        если м[1] > 0 {
            пусть замена = исправление(з.текст)
            если замена != "" { запись += ", \"исправление\": " + строка_json(замена) }
        }
        строки.добавить(запись + "}")
    }
    вернуть начало_ + "\n" + строки.соединить(",\n") + "\n]}"
}
