/// Порождение кода C, написанное на Дане: пятая часть компилятора на самом Дане.
///
/// Делает то же, что kodogen.py: переводит проверенное дерево программы (с пометками
/// проверки смысла) в текст на C с встроенной средой выполнения. Текст должен
/// совпадать с текстом kodogen.py побайтно.
///
/// Состояние порождения (зарегистрированные типы, имена C, строки кода) передаётся
/// из функции в функцию и возвращается вместе с кодом: РК {г, к}.

подключить "разбор"
подключить "типы"
подключить "проверка"
подключить "среда"
подключить "похожее"

// ---------- состояние ----------

/// Переменная C, которую нужно отпустить при выходе из области: имя и тип.
тип Место {
    имя: стр
    т: стр
}

тип МеткаЦикла {
    метка: стр
    от: цел
}

общий тип Г {
    /// имя в Дане -> имя в C
    имена: {стр: стр} = {}
    занятые: {стр: лог} = {}
    /// строки кода: последняя неполная часть, готовые части и число строк в них
    /// (части по 256 строк: изменение строк не копирует весь код)
    строки: [стр] = []
    части: [[стр]] = []
    сдано: цел = 0
    отступ: цел = 0
    счётчик: цел = 0
    /// тип списка -> имя структуры C (вложенные раньше внешних)
    списки: {стр: стр} = {}
    нужна_математика: лог = ложь
    нужны_данные: лог = ложь
    собственные: {стр: [проверка.ПолеТ]} = {}
    имена_типов: {стр: стр} = {}
    имена_типов_занятые: {стр: лог} = {}
    /// «владелец\tполе» -> имя поля C (владелец - тип или «тип|вариант»)
    поля_c: {стр: стр} = {}
    поля_занятые: {стр: [стр]} = {}
    /// собственные, необязательные, результаты и функции -> имя типа C
    значимые: {стр: стр} = {}
    /// «из\tв» -> функция C расширения списка
    расширения: {стр: стр} = {}
    словари: {стр: стр} = {}
    функциональные: {стр: цел} = {}
    лямбды_код: [стр] = []
    обёртки: {стр: стр} = {}
    /// «вид\tтип списка\tтип функции» -> код помощника и его имя
    помощники: {стр: стр} = {}
    помощники_имена: {стр: стр} = {}
    перечисления: {стр: [проверка.ВариантТ]} = {}
    перечисления_c: {стр: стр} = {}
    написания: {стр: стр} = {}
    литералы: {стр: стр} = {}
    области: [[Место]] = []
    метка_функции: стр = ""
    метки_циклов: [МеткаЦикла] = []
    нужны_задачи: лог = ложь
    нужны_длинные: лог = ложь
    нужны_компл: лог = ложь
    нужны_даты: лог = ложь
    /// плотные массивы (sreda/massivy.c)
    нужны_массивы: лог = ложь
    отладка: лог = ложь
    профиль: лог = ложь
    тесты: лог = ложь
    /// имя и строка каждой замеряемой функции
    профиль_функции: [[стр]] = []
    /// сборка тестов с учётом выполненных строк (тестировать --покрытие)
    покрытие: лог = ложь
    /// номер строки (с номером файла) каждой отмечаемой инструкции
    покрытие_строки: [цел] = []
    /// порождается тело теста: его строки не учитываются
    в_тесте: лог = ложь
    /// номера файлов стандартной библиотеки
    файлы_библиотеки: {цел: лог} = {}
    /// «#line» перед инструкциями (строки_дан) и имена файлов программы для них
    строки_дан: лог = ложь
    файлы_программы: [стр] = ["программа.dan"]
    /// сборка, которая замеряет время блоков «замер» (dan замерить)
    замеры: лог = ложь
    /// тип -> [имя функции записи, её код]
    отладочные_записи: {стр: [стр]} = {}
    нужна_система: лог = ложь
    нужна_сеть: лог = ложь
    нужен_pdf: лог = ложь
    нужна_база: лог = ложь
    нужны_окна: лог = ложь
    /// векторные ядра и пул потоков (sreda/yadra.c)
    нужны_ядра: лог = ложь
    /// локальные языковые модели через llama.cpp (sreda/modeli.c)
    нужны_модели: лог = ложь
    /// побитовые действия над цел (bity.py)
    нужны_биты: лог = ложь
    /// глубина блоков «приближённо»: ядра с FMA и свободным порядком сложения
    приближённо: цел = 0
    /// общие массивы шага «параллельно для», тело которого порождается сейчас: их часть «м[а..б]»
    /// заимствует элементы без изменения счётчика мест массива (dan_arr_borrow)
    общие_массивы_шага: [стр] = []
    /// все общие переменные шага: часть массива с таким корнем («сам.веса[а..б]», «кл[и][а..б]») - без счётчика
    общие_шага: [стр] = []
    клоны: {стр: стр} = {}
    каналы: {стр: стр} = {}
    задачи_c: {стр: стр} = {}
    группы: [стр] = []
    рекурсивные: {стр: лог} = {}
    текущий_результат: стр = ""
    описания: {стр: среда.Описание} = {}
    постоянные: {стр: стр} = {}
    /// функция программы -> параметры, которые она потребляет (см. «передача владения»)
    потребляемые: {стр: [Потребляемый]} = {}
    /// переменные, значение которых отдано функции до следующего присваивания
    без_освобождения: {стр: лог} = {}
    /// «список\tпеременная цикла\tсмещение» -> флаг C: обращение в границах (анализ диапазонов)
    быстрые_индексы: {стр: стр} = {}
    /// переменная цикла -> пределы её значений, известные при сборке
    пределы_имён: {стр: [цел]} = {}
    /// накопитель («с += х» с известными пределами х) -> «переменная цикла\tфлаг C»: переполнения нет
    накопители: {стр: стр} = {}
    /// флаги C, которые анализ диапазонов записал перед текущим циклом (по ним цикл раздваивается)
    флаги_цикла: [стр] = []
    /// сколько раздвоенных циклов вокруг (вложенные раздваиваются не глубже двух уровней)
    раздвоено: цел = 0
    /// переменная цикла «пока и < н { ... и += шаг }» -> флаг C: шаг «и += шаг» не переполняется
    шаги_пока: {стр: стр} = {}
}

тип Потребляемый {
    номер: цел
    т: стр
}

/// Результат шага: состояние и код C.
тип РК {
    г: Г
    к: стр = ""
}

функ рк(г: Г, к: стр) -> РК { вернуть РК(г, к) }

функ ПУСТО() -> стр { вернуть "пусто" }

// ---------- тексты C ----------

функ транслит(з: стр) -> стр {
    выбор з {
        "а" { вернуть "a" }
        "б" { вернуть "b" }
        "в" { вернуть "v" }
        "г" { вернуть "g" }
        "д" { вернуть "d" }
        "е" { вернуть "e" }
        "ё" { вернуть "yo" }
        "ж" { вернуть "zh" }
        "з" { вернуть "z" }
        "и" { вернуть "i" }
        "й" { вернуть "j" }
        "к" { вернуть "k" }
        "л" { вернуть "l" }
        "м" { вернуть "m" }
        "н" { вернуть "n" }
        "о" { вернуть "o" }
        "п" { вернуть "p" }
        "р" { вернуть "r" }
        "с" { вернуть "s" }
        "т" { вернуть "t" }
        "у" { вернуть "u" }
        "ф" { вернуть "f" }
        "х" { вернуть "h" }
        "ц" { вернуть "c" }
        "ч" { вернуть "ch" }
        "ш" { вернуть "sh" }
        "щ" { вернуть "shh" }
        "ъ" { вернуть "jj" }
        "ы" { вернуть "y" }
        "ь" { вернуть "q" }
        "э" { вернуть "eh" }
        "ю" { вернуть "yu" }
        "я" { вернуть "ya" }
        иначе { вернуть "" }
    }
}

функ шестнадцатеричное(число_: цел) -> стр {
    пусть цифры = "0123456789abcdef".символы()
    если число_ == 0 { вернуть "0" }
    перем итог = ""
    перем н = число_
    пока н > 0 {
        итог = цифры[н % 16] + итог
        н = частное(н, 16)
    }
    вернуть итог
}

функ ascii_буква_цифра(к: цел) -> лог {
    вернуть (к >= 48 и к <= 57) или (к >= 65 и к <= 90) или (к >= 97 и к <= 122)
}

/// Имя латиницей: сумма -> summa, Счёт -> Schyot, прочие символы - u<код>.
общий функ латиницей(имя: стр) -> стр {
    перем части: [стр] = []
    для з в имя.символы() {
        пусть н = з.строчные()
        пусть т = транслит(н)
        если т != "" {
            если з != н {
                части.добавить(т[0].прописные() + типы.срез(т, 1, т.длина))
            } иначе {
                части.добавить(т)
            }
        } иначе если ascii_буква_цифра(код_символа(з)) или з == "_" {
            части.добавить(з)
        } иначе {
            части.добавить("u" + шестнадцатеричное(код_символа(з)))
        }
    }
    вернуть части.соединить("")
}

функ восьмеричное(б: цел) -> стр {
    вернуть стр(частное(б, 64)) + стр(частное(б, 8) % 8) + стр(б % 8)
}

/// Строковый литерал C; байты не из ASCII записываются восьмеричными кодами.
общий функ строка_c(текст: стр) -> стр {
    пусть б = байты(текст)
    перем части = ["\""]
    для н в 0..б.длина - 1 {
        пусть к = б[н]
        если к == 34 {
            части.добавить("\\\"")
        } иначе если к == 92 {
            части.добавить("\\\\")
        } иначе если к == 10 {
            части.добавить("\\n")
        } иначе если к == 9 {
            части.добавить("\\t")
        } иначе если к == 63 {
            части.добавить("\\?")      // «??)» и подобные в C - триграфы
        } иначе если к >= 32 и к < 127 {
            части.добавить(символ_по_коду(к))
        } иначе {
            части.добавить("\\" + восьмеричное(к))
        }
    }
    части.добавить("\"")
    вернуть части.соединить("")
}

/// Дробное число в записи C (запись числа - repr Python).
функ дробь_c(запись: стр) -> стр {
    если запись.содержит("inf") {
        если запись.начинается("-") { вернуть "(-1.0/0.0)" }
        вернуть "(1.0/0.0)"
    }
    если не запись.содержит(".") и не запись.содержит("e") { вернуть запись + ".0" }
    вернуть запись
}

/// Подстановка в шаблон, как str.format в Python: {имя} - значение, {{ и }} - скобки.
функ формат(шаблон: стр, значения: {стр: стр}) -> стр {
    пусть с = шаблон.символы()
    перем части: [стр] = []
    перем н = 0
    пока н < с.длина {
        пусть з = с[н]
        если з == "{" и н + 1 < с.длина и с[н + 1] == "{" {
            части.добавить("{")
            н += 2
        } иначе если з == "}" и н + 1 < с.длина и с[н + 1] == "}" {
            части.добавить("}")
            н += 2
        } иначе если з == "{" {
            перем к = н + 1
            перем имя = ""
            пока с[к] != "}" {
                имя += с[к]
                к += 1
            }
            части.добавить(значения[имя])
            н = к + 1
        } иначе {
            части.добавить(з)
            н += 1
        }
    }
    вернуть части.соединить("")
}

// ---------- таблицы ----------

функ базовый_c(т: стр) -> стр {
    если типы.это_массив(т) { вернуть "dan_arr *" }
    выбор т {
        "цел" { вернуть "int64_t" }
        "дроб" { вернуть "double" }
        "стр" { вернуть "dan_str" }
        "лог" { вернуть "bool" }
        "рац" { вернуть "dan_rat" }
        "мн" { вернуть "dan_mn" }
        "байты" { вернуть "dan_bytes" }
        "пусто" { вернуть "void" }
        "длинное" { вернуть "dan_big" }
        "компл" { вернуть "dan_cx" }
        "дата" { вернуть "dan_date" }
        иначе { вернуть "" }
    }
}

функ код_базового(т: стр) -> стр {
    если типы.это_массив(т) { вернуть "A" + стр(типы.виды_массива().найти(типы.вид_массива(т))) }
    выбор т {
        "цел" { вернуть "i" }
        "дроб" { вернуть "f" }
        "стр" { вернуть "s" }
        "лог" { вернуть "b" }
        "рац" { вернуть "r" }
        "мн" { вернуть "p" }
        "байты" { вернуть "y" }
        "пусто" { вернуть "v" }
        "длинное" { вернуть "g" }
        "компл" { вернуть "c" }
        "дата" { вернуть "t" }
        иначе { вернуть "" }
    }
}

функ запись_базового(т: стр) -> стр {
    если типы.это_массив(т) { вернуть "dan_arr_write" }
    выбор т {
        "цел" { вернуть "dan_write_int" }
        "дроб" { вернуть "dan_write_float" }
        "стр" { вернуть "dan_write_str" }
        "лог" { вернуть "dan_write_bool" }
        "рац" { вернуть "dan_write_rat" }
        "мн" { вернуть "dan_write_poly" }
        "байты" { вернуть "dan_write_bytes" }
        "длинное" { вернуть "dan_write_big" }
        "компл" { вернуть "dan_write_cx" }
        "дата" { вернуть "dan_write_date" }
        иначе { вернуть "" }
    }
}

/// Равенство значений встроенного типа: шаблон с a и b ("" - не встроенный).
функ равенство_базового(т: стр) -> стр {
    если типы.это_массив(т) { вернуть "dan_arr_eq(a, b)" }
    выбор т {
        "дата" { вернуть "dan_date_eq(a, b)" }
        "компл" { вернуть "dan_cx_eq(a, b)" }
        "длинное" { вернуть "dan_big_eq(a, b)" }
        "цел" { вернуть "(a == b)" }
        "дроб" { вернуть "(a == b)" }
        "лог" { вернуть "(a == b)" }
        "стр" { вернуть "dan_str_eq(a, b)" }
        "рац" { вернуть "(dan_rat_cmp(a, b) == 0)" }
        "мн" { вернуть "dan_poly_eq(a, b)" }
        "байты" { вернуть "dan_bytes_eq(a, b)" }
        иначе { вернуть "" }
    }
}

функ хеш(т: стр) -> стр {
    выбор т {
        "цел" { вернуть "dan_hash_i(k)" }
        "стр" { вернуть "dan_hash_s(k)" }
        "лог" { вернуть "(uint64_t)(k)" }
        "рац" { вернуть "dan_hash_r(k)" }
        иначе { вернуть "dan_hash_i((k).d)" }
    }
}

функ строка_базового(т: стр) -> стр {
    если типы.это_массив(т) { вернуть "dan_arr_str" }
    выбор т {
        "цел" { вернуть "dan_int_to_str" }
        "дроб" { вернуть "dan_float_to_str" }
        "рац" { вернуть "dan_rat_to_str" }
        "лог" { вернуть "dan_bool_to_str" }
        "стр" { вернуть "dan_quote_str" }
        "мн" { вернуть "dan_poly_to_str" }
        "байты" { вернуть "dan_bytes_show" }
        "длинное" { вернуть "dan_big_to_str" }
        "компл" { вернуть "dan_cx_to_str" }
        иначе { вернуть "dan_date_to_str" }
    }
}

функ операция(вид: стр, оп: стр) -> стр {
    выбор вид + оп {
        "компл+" { вернуть "dan_cx_add" }
        "компл-" { вернуть "dan_cx_sub" }
        "компл*" { вернуть "dan_cx_mul" }
        "компл/" { вернуть "dan_cx_div" }
        "длинное+" { вернуть "dan_big_add" }
        "длинное-" { вернуть "dan_big_sub" }
        "длинное*" { вернуть "dan_big_mul" }
        "длинное/" { вернуть "dan_big_div_exact" }
        "длинное%" { вернуть "dan_big_mod" }
        "мн+" { вернуть "dan_poly_add" }
        "мн-" { вернуть "dan_poly_sub" }
        "мн*" { вернуть "dan_poly_mul" }
        "мн/" { вернуть "dan_poly_div_exact" }
        "мн%" { вернуть "dan_poly_mod" }
        "цел+" { вернуть "dan_add" }
        "цел-" { вернуть "dan_sub" }
        "цел*" { вернуть "dan_mul" }
        "рац+" { вернуть "dan_rat_add" }
        "рац-" { вернуть "dan_rat_sub" }
        "рац*" { вернуть "dan_rat_mul" }
        "рац/" { вернуть "dan_rat_div" }
        иначе { вернуть "" }
    }
}

// ---------- типы ----------

функ это_собственный(г: Г, т: стр) -> лог { вернуть г.собственные.содержит(т) }
функ это_перечисление(г: Г, т: стр) -> лог { вернуть г.перечисления.содержит(т) }

/// Короткий код типа для имён в C: [цел] -> Li, стр? -> Os, [Сотрудник] -> LTSotrudnik.
функ код_типа(исх: Г, т: стр) -> РК {
    перем г = исх
    если типы.это_канал(т) {
        пусть р = код_типа(г, типы.элемент_канала(т))
        вернуть рк(р.г, "K" + р.к)
    }
    если типы.это_список(т) {
        пусть р = код_типа(г, типы.элемент(т))
        вернуть рк(р.г, "L" + р.к)
    }
    если типы.это_словарь(т) {
        пусть рк_ = код_типа(г, типы.ключ_словаря(т))
        пусть рз = код_типа(рк_.г, типы.значение_словаря(т))
        вернуть рк(рз.г, "D" + рк_.к + рз.к)
    }
    если типы.это_функция(т) {
        г = значимый(г, т).г
        вернуть рк(г, "F" + стр(г.функциональные[т]))
    }
    если это_перечисление(г, т) {
        пусть р = имя_типа(г, т)
        вернуть рк(р.г, "V" + р.к)
    }
    если типы.это_результат(т) {
        пусть р = код_типа(г, типы.основа(т))
        вернуть рк(р.г, "R" + р.к)
    }
    если типы.это_необяз(т) {
        пусть р = код_типа(г, типы.основа(т))
        вернуть рк(р.г, "O" + р.к)
    }
    если это_собственный(г, т) {
        пусть р = имя_типа(г, т)
        вернуть рк(р.г, "T" + р.к)
    }
    вернуть рк(г, код_базового(т))
}

функ имя_типа(исх: Г, т: стр) -> РК {
    перем г = исх
    если не г.имена_типов.содержит(т) {
        пусть основа_имени = латиницей(т)
        перем кандидат = основа_имени
        перем номер = 2
        пока г.имена_типов_занятые.содержит(кандидат) {
            кандидат = основа_имени + "_" + стр(номер)
            номер += 1
        }
        г.имена_типов[т] = кандидат
        г.имена_типов_занятые[кандидат] = истина
    }
    вернуть рк(г, г.имена_типов[т])
}

/// Имя поля C; владелец - тип или «тип|вариант» у поля варианта перечисления.
функ поле_c(исх: Г, владелец: стр, поле: стр) -> РК {
    перем г = исх
    пусть ключ = владелец + "\t" + поле
    если не г.поля_c.содержит(ключ) {
        перем занятые: [стр] = []
        если г.поля_занятые.содержит(владелец) { занятые = г.поля_занятые[владелец] }
        пусть основа_имени = "f_" + латиницей(поле)
        перем кандидат = основа_имени
        перем номер = 2
        пока занятые.содержит(кандидат) {
            кандидат = основа_имени + "_" + стр(номер)
            номер += 1
        }
        г.поля_c[ключ] = кандидат
        занятые.добавить(кандидат)
        г.поля_занятые[владелец] = занятые
    }
    вернуть рк(г, г.поля_c[ключ])
}

функ вариант_владелец(т: стр, вариант: стр) -> стр { вернуть т + "|" + вариант }

/// Имя типа C для собственного, необязательного типа, результата или функции (значения, а не ссылки).
функ значимый(исх: Г, т: стр) -> РК {
    перем г = исх
    если не г.значимые.содержит(т) {
        если типы.это_функция(т) {
            г.функциональные[т] = г.функциональные.длина + 1
            г.значимые[т] = "df_" + стр(г.функциональные[т])
            пусть ф = типы.разобрать_тип_функции(т)
            перем все = ф.параметры
            все.добавить(ф.результат)
            для х в все {
                если х != ПУСТО() { г = тип_c(г, х).г }
            }
        } иначе если типы.это_результат(т) {
            пусть р = код_типа(г, типы.основа(т))
            г = р.г
            г.значимые[т] = "dr_" + р.к
            если типы.основа(т) != ПУСТО() { г = тип_c(г, типы.основа(т)).г }
        } иначе если типы.это_необяз(т) {
            пусть р = код_типа(г, типы.основа(т))
            г = р.г
            г.значимые[т] = "do_" + р.к
            г = тип_c(г, типы.основа(т)).г
        } иначе {
            пусть р = имя_типа(г, т)
            г = р.г
            г.значимые[т] = "dt_" + р.к
            для п в г.собственные[т] {
                г = поле_c(г, т, п.имя).г
                г = тип_c(г, п.т).г
            }
        }
    }
    вернуть рк(г, г.значимые[т])
}

тип Обход {
    да: лог
    посещённые: [стр]
}

/// Может ли значение собственного типа содержать (через поля) значение того же типа.
функ рекурсивный(г: Г, т: стр) -> лог { вернуть рекурсивный_в(г, т, т, []).да }

функ рекурсивный_в(г: Г, т: стр, искомый: стр, исходные: [стр]) -> Обход {
    перем посещённые = исходные
    если не г.собственные.содержит(т) { вернуть Обход(ложь, посещённые) }
    для п в г.собственные[т] {
        перем х = п.т
        пока типы.это_необяз(х) { х = типы.основа(х) }
        если х == искомый { вернуть Обход(истина, посещённые) }
        если г.собственные.содержит(х) и не посещённые.содержит(х) {
            посещённые.добавить(х)
            пусть р = рекурсивный_в(г, х, искомый, посещённые)
            посещённые = р.посещённые
            если р.да { вернуть Обход(истина, посещённые) }
        }
    }
    вернуть Обход(ложь, посещённые)
}

/// Необязательное значение рекурсивного типа хранится по ссылке (NULL - ничего).
функ по_ссылке(г: Г, т: стр) -> лог {
    вернуть типы.это_необяз(т) и г.собственные.содержит(типы.основа(т)) и рекурсивный(г, типы.основа(т))
}

/// Функция C, создающая из списка чисел список более широкого типа.
функ расширение(исх: Г, из_типа: стр, в_тип: стр) -> РК {
    перем г = исх
    пусть ключ = из_типа + "\t" + в_тип
    если не г.расширения.содержит(ключ) {
        пусть р1 = код_типа(г, из_типа)
        пусть р2 = код_типа(р1.г, в_тип)
        г = р2.г
        г.расширения[ключ] = "dan_widen_" + р1.к + "_" + р2.к
        г = структура(г, из_типа).г
        г = структура(г, в_тип).г
        если типы.это_список(типы.элемент(в_тип)) { г = расширение(г, типы.элемент(из_типа), типы.элемент(в_тип)).г }
    }
    вернуть рк(г, г.расширения[ключ])
}

/// Имя структуры C словаря; регистрирует нужные ему типы.
функ словарь_c(исх: Г, т: стр) -> РК {
    перем г = исх
    если не г.словари.содержит(т) {
        пусть р = код_типа(г, т)
        г = р.г
        г.словари[т] = "dm_" + р.к
        пусть к = типы.ключ_словаря(т)
        пусть з = типы.значение_словаря(т)
        г = структура(г, "[" + к + "]").г
        г = структура(г, "[" + з + "]").г
        если не типы.это_функция(з) {
            если типы.это_необяз(з) { г = тип_c(г, з).г } иначе { г = тип_c(г, з + "?").г }
        }
        г = тип_c(г, з).г
    }
    вернуть рк(г, г.словари[т])
}

/// Хранит ли значение типа ссылки на значения в памяти с учётом мест хранения.
функ куча(г: Г, т: стр) -> лог { вернуть куча_в(г, т, []).да }

функ куча_в(г: Г, т: стр, исходные: [стр]) -> Обход {
    перем в_работе = исходные
    если (т == "стр" или т == "байты" или т == "длинное" или т == "мн" или типы.это_список(т) или типы.это_словарь(т)
            или типы.это_функция(т) или г.перечисления.содержит(т) или типы.это_результат(т) или по_ссылке(г, т)
            или типы.это_канал(т) или типы.это_массив(т)) {
        вернуть Обход(истина, в_работе)
    }
    если типы.это_необяз(т) { вернуть куча_в(г, типы.основа(т), в_работе) }
    если г.собственные.содержит(т) {
        если в_работе.содержит(т) { вернуть Обход(ложь, в_работе) }
        в_работе.добавить(т)
        для п в г.собственные[т] {
            пусть р = куча_в(г, п.т, в_работе)
            в_работе = р.посещённые
            если р.да { вернуть Обход(истина, в_работе) }
        }
        вернуть Обход(ложь, в_работе)
    }
    вернуть Обход(ложь, в_работе)
}

/// Функция C учёта мест хранения («share», «release», «give») или "", если учёт не нужен.
функ учёт(исх: Г, т: стр, действие: стр) -> РК {
    перем г = исх
    если не куча(г, т) { вернуть рк(г, "") }
    если т == "стр" { вернуть рк(г, "dan_str_" + действие) }
    если т == "байты" { вернуть рк(г, "dan_bytes_" + действие) }
    если т == "длинное" {
        г.нужны_длинные = истина
        вернуть рк(г, "dan_big_" + действие)
    }
    если т == "мн" { вернуть рк(включить_математику(г), "dan_poly_" + действие) }
    если типы.это_канал(т) { вернуть рк(канал_c(г, т).г, "dan_chan_" + действие) }
    если типы.это_массив(т) { вернуть рк(г, "dan_arr_" + действие) }
    если типы.это_список(т) {
        пусть р = структура(г, т)
        вернуть рк(р.г, р.к + "_" + действие)
    }
    если типы.это_словарь(т) {
        пусть р = словарь_c(г, т)
        вернуть рк(р.г, р.к + "_" + действие)
    }
    если г.перечисления.содержит(т) {
        пусть р = перечисление_c(г, т)
        вернуть рк(р.г, р.к + "_" + действие)
    }
    пусть р = значимый(г, т)
    вернуть рк(р.г, р.к + "_" + действие)
}

функ удержать(г: Г, т: стр) -> РК { вернуть учёт(г, т, "share") }
функ отпустить(г: Г, т: стр) -> РК { вернуть учёт(г, т, "release") }
функ отдать(г: Г, т: стр) -> РК { вернуть учёт(г, т, "give") }

/// Код значения, которое получает место хранения.
функ учесть(г: Г, т: стр, код: стр) -> РК {
    пусть р = удержать(г, т)
    если р.к == "" { вернуть рк(р.г, код) }
    вернуть рк(р.г, р.к + "(" + код + ")")
}

/// Выражение C «a равно b» для значений типа или "", если сравнивать нельзя.
функ равенство(г: Г, т: стр) -> РК {
    если равенство_базового(т) != "" { вернуть рк(г, равенство_базового(т)) }
    если типы.это_список(т) {
        если не сравнимый(г, т) { вернуть рк(г, "") }
        пусть р = структура(г, т)
        вернуть рк(р.г, р.к + "_eq(a, b)")
    }
    если типы.это_словарь(т) {
        если не сравнимый(г, т) { вернуть рк(г, "") }
        пусть р = словарь_c(г, т)
        вернуть рк(р.г, р.к + "_eq(a, b)")
    }
    если г.перечисления.содержит(т) {
        если не сравнимый(г, т) { вернуть рк(г, "") }
        пусть р = перечисление_c(г, т)
        вернуть рк(р.г, р.к + "_eq(a, b)")
    }
    если типы.это_необяз(т) или г.собственные.содержит(т) {
        если сравнимый(г, т) {
            пусть р = значимый(г, т)
            вернуть рк(р.г, р.к + "_eq(a, b)")
        }
    }
    вернуть рк(г, "")
}

функ сравнимый(г: Г, т: стр) -> лог { вернуть сравнимый_в(г, т, []).да }

функ сравнимый_в(г: Г, т: стр, исходные: [стр]) -> Обход {
    перем в_работе = исходные
    если равенство_базового(т) != "" { вернуть Обход(истина, в_работе) }
    если типы.это_список(т) { вернуть сравнимый_в(г, типы.элемент(т), в_работе) }
    если типы.это_словарь(т) { вернуть сравнимый_в(г, типы.значение_словаря(т), в_работе) }
    если г.перечисления.содержит(т) {
        если в_работе.содержит(т) { вернуть Обход(истина, в_работе) }
        в_работе.добавить(т)
        для в_ в г.перечисления[т] {
            для п в в_.поля {
                пусть р = сравнимый_в(г, п.т, в_работе)
                в_работе = р.посещённые
                если не р.да { вернуть Обход(ложь, в_работе) }
            }
        }
        вернуть Обход(истина, в_работе)
    }
    если типы.это_необяз(т) { вернуть сравнимый_в(г, типы.основа(т), в_работе) }
    если г.собственные.содержит(т) {
        если в_работе.содержит(т) { вернуть Обход(истина, в_работе) }
        в_работе.добавить(т)
        для п в г.собственные[т] {
            пусть р = сравнимый_в(г, п.т, в_работе)
            в_работе = р.посещённые
            если не р.да { вернуть Обход(ложь, в_работе) }
        }
        вернуть Обход(истина, в_работе)
    }
    вернуть Обход(ложь, в_работе)
}

/// Код C, превращающий значение в строку так, как его печатает «вывод».
функ в_строку(г: Г, т: стр, код: стр) -> РК {
    если т == "стр" { вернуть рк(г, код) }
    если типы.это_список(т) {
        пусть р = структура(г, т)
        вернуть рк(р.г, р.к + "_str(" + код + ")")
    }
    если типы.это_словарь(т) {
        пусть р = словарь_c(г, т)
        вернуть рк(р.г, р.к + "_str(" + код + ")")
    }
    если типы.это_необяз(т) или типы.это_функция(т) или г.собственные.содержит(т) {
        пусть р = значимый(г, т)
        вернуть рк(р.г, р.к + "_str(" + код + ")")
    }
    если г.перечисления.содержит(т) {
        пусть р = перечисление_c(г, т)
        вернуть рк(р.г, р.к + "_str(" + код + ")")
    }
    вернуть преобразование(г, "стр", т, код, "0")
}

функ перечисление_c(исх: Г, т: стр) -> РК {
    перем г = исх
    если не г.перечисления_c.содержит(т) {
        пусть р = имя_типа(г, т)
        г = р.г
        г.перечисления_c[т] = "dv_" + р.к
        для в_ в г.перечисления[т] {
            для п в в_.поля { г = тип_c(г, п.т).г }
        }
    }
    вернуть рк(г, г.перечисления_c[т])
}

функ тип_c(исх: Г, т: стр) -> РК {
    перем г = исх
    если типы.это_массив(т) { г.нужны_массивы = истина }
    если т == "длинное" { г.нужны_длинные = истина }
    если т == "компл" { г.нужны_компл = истина }
    если т == "дата" { г.нужны_даты = истина }
    если типы.это_канал(т) { вернуть рк(канал_c(г, т).г, "dan_chan *") }
    если типы.это_задача(т) { вернуть задача_c(г, т) }
    если г.перечисления.содержит(т) { вернуть перечисление_c(г, т) }
    если типы.это_список(т) {
        пусть р = структура(г, т)
        вернуть рк(р.г, р.к + "*")
    }
    если типы.это_словарь(т) {
        пусть р = словарь_c(г, т)
        вернуть рк(р.г, р.к + "*")
    }
    если типы.это_необяз(т) или типы.это_результат(т) или типы.это_функция(т) или г.собственные.содержит(т) {
        вернуть значимый(г, т)
    }
    если т == "мн" { г = включить_математику(г) }
    вернуть рк(г, базовый_c(т))
}

функ типы_c(исх: Г, список_: [стр]) -> Г {
    перем г = исх
    для т в список_ { г = тип_c(г, т).г }
    вернуть г
}

функ включить_данные(исх: Г) -> Г {
    перем г = исх
    если г.нужны_данные { вернуть г }
    г.нужны_данные = истина
    для т в ["[цел]", "[стр]", "[байты]"] { г = структура(г, т).г }
    вернуть типы_c(г, среда.нужные_типы("данные"))
}

функ включить_систему(исх: Г) -> Г {
    перем г = исх
    если г.нужна_система { вернуть г }
    г.нужна_система = истина
    г.нужны_даты = истина
    вернуть типы_c(г, среда.нужные_типы("система"))
}

функ включить_ядра(исх: Г) -> Г {
    перем г = исх
    если г.нужны_ядра { вернуть г }
    г.нужны_ядра = истина
    вернуть типы_c(г, среда.нужные_типы("ядра"))
}

функ включить_модели(исх: Г) -> Г {
    перем г = исх
    если г.нужны_модели { вернуть г }
    г.нужны_модели = истина
    вернуть типы_c(г, среда.нужные_типы("модели"))
}

/// Библиотека и многочлены нужны: регистрируются все используемые ими типы списков.
функ включить_математику(исх: Г) -> Г {
    перем г = исх
    если г.нужна_математика { вернуть г }
    г.нужна_математика = истина
    для т в ["[цел]", "[рац]", "[дроб]", "[стр]", "[мн]", "[[рац]]"] { г = структура(г, т).г }
    вернуть типы_c(г, среда.нужные_типы("высшая"))
}

функ структура(исх: Г, т: стр) -> РК {
    перем г = исх
    если не г.списки.содержит(т) {
        пусть т_эл = типы.элемент(т)
        если типы.это_список(т_эл) { г = структура(г, т_эл).г }
        пусть р = код_типа(г, т)
        г = р.г
        г.списки[т] = "dl_" + р.к
    }
    вернуть рк(г, г.списки[т])
}

/// Функция C, которая печатает значение этого типа без перевода строки.
функ запись_типа(г: Г, т: стр, в_списке: лог) -> РК {
    если типы.это_список(т) {
        пусть р = структура(г, т)
        вернуть рк(р.г, р.к + "_write")
    }
    если типы.это_словарь(т) {
        пусть р = словарь_c(г, т)
        вернуть рк(р.г, р.к + "_write")
    }
    если типы.это_функция(т) {
        пусть р = значимый(г, т)
        вернуть рк(р.г, р.к + "_write")
    }
    если г.перечисления.содержит(т) {
        пусть р = перечисление_c(г, т)
        вернуть рк(р.г, р.к + "_write")
    }
    если типы.это_необяз(т) {
        пусть р = значимый(г, т)
        если в_списке { вернуть рк(р.г, р.к + "_qwrite") }
        вернуть рк(р.г, р.к + "_write")
    }
    если г.собственные.содержит(т) {
        пусть р = значимый(г, т)
        вернуть рк(р.г, р.к + "_write")
    }
    если т == "стр" и в_списке { вернуть рк(г, "dan_write_quoted") }
    вернуть рк(г, запись_базового(т))
}

/// Функция C, которая превращает элемент списка в строку (как при выводе).
функ строка_элемента(г: Г, т: стр) -> РК {
    если типы.это_список(т) {
        пусть р = структура(г, т)
        вернуть рк(р.г, р.к + "_str")
    }
    если типы.это_словарь(т) {
        пусть р = словарь_c(г, т)
        вернуть рк(р.г, р.к + "_str")
    }
    если типы.это_функция(т) {
        пусть р = значимый(г, т)
        вернуть рк(р.г, р.к + "_str")
    }
    если г.перечисления.содержит(т) {
        пусть р = перечисление_c(г, т)
        вернуть рк(р.г, р.к + "_str")
    }
    если типы.это_необяз(т) {
        пусть р = значимый(г, т)
        вернуть рк(р.г, р.к + "_qstr")
    }
    если г.собственные.содержит(т) {
        пусть р = значимый(г, т)
        вернуть рк(р.г, р.к + "_str")
    }
    вернуть рк(г, строка_базового(т))
}

// ---------- имена и вывод ----------

функ имя_си(исх: Г, имя_дан: стр) -> РК {
    перем г = исх
    если не г.имена.содержит(имя_дан) {
        пусть основа_ = "d_" + латиницей(имя_дан)
        перем кандидат = основа_
        перем номер = 2
        пока г.занятые.содержит(кандидат) {
            кандидат = основа_ + "_" + стр(номер)
            номер += 1
        }
        г.занятые[кандидат] = истина
        г.имена[имя_дан] = кандидат
    }
    вернуть рк(г, г.имена[имя_дан])
}

функ служебное_имя(исх: Г, основа_: стр) -> РК {
    перем г = исх
    г.счётчик += 1
    вернуть рк(г, "_" + основа_ + стр(г.счётчик))
}

функ отступ_(н: цел) -> стр {
    перем итог = ""
    для к в 1..н { итог += "    " }
    вернуть итог
}

функ пиши(исх: Г, текст: стр) -> Г {
    если текст == "" { вернуть добавить_строку(исх, "") }
    вернуть добавить_строку(исх, отступ_(исх.отступ) + текст)
}

функ добавить_строку(исх: Г, с: стр) -> Г {
    перем г = исх
    г.строки.добавить(с)
    если г.строки.длина >= 256 {
        г.сдано += г.строки.длина
        г.части.добавить(г.строки)
        г.строки = []
    }
    вернуть г
}

функ число_строк(г: Г) -> цел { вернуть г.сдано + г.строки.длина }

функ все_строки(г: Г) -> [стр] {
    перем итог: [стр] = []
    для ч_ в г.части {
        для с в ч_ { итог.добавить(с) }
    }
    для с в г.строки { итог.добавить(с) }
    вернуть итог
}

/// Дописывает текст в конец строки с номером «номер».
функ дописать_к_строке(исх: Г, номер: цел, текст: стр) -> Г {
    перем г = исх
    если номер >= г.сдано {
        г.строки[номер - г.сдано] = г.строки[номер - г.сдано] + текст
        вернуть г
    }
    перем н = номер
    для к в 0..г.части.длина - 1 {
        если н < г.части[к].длина {
            г.части[к][н] = г.части[к][н] + текст
            вернуть г
        }
        н -= г.части[к].длина
    }
    вернуть г
}

/// Строки кода, сохранённые на время порождения другой функции.
тип СохранённыеСтроки {
    строки: [стр]
    части: [[стр]]
    сдано: цел
}

функ сохранить_строки(г: Г) -> СохранённыеСтроки { вернуть СохранённыеСтроки(г.строки, г.части, г.сдано) }

функ с_новыми_строками(исх: Г) -> Г {
    перем г = исх
    г.строки = []
    г.части = []
    г.сдано = 0
    вернуть г
}

функ восстановить_строки(исх: Г, с: СохранённыеСтроки) -> Г {
    перем г = исх
    г.строки = с.строки
    г.части = с.части
    г.сдано = с.сдано
    вернуть г
}

/// Строковая постоянная программы: строка с заголовком, которая не освобождается.
функ литерал(исх: Г, текст: стр) -> РК {
    перем г = исх
    если не г.литералы.содержит(текст) { г.литералы[текст] = "dan_lit_" + стр(г.литералы.длина + 1) }
    вернуть рк(г, г.литералы[текст] + ".s")
}

/// Подставляет операнды в шаблон равенства вида «f(a, b)» или «(a == b)».
функ подставить(шаблон: стр, а: стр, б: стр) -> стр {
    если шаблон.оканчивается("(a, b)") { вернуть типы.срез(шаблон, 0, шаблон.длина - 6) + "(" + а + ", " + б + ")" }
    если шаблон == "(a == b)" { вернуть "(" + а + " == " + б + ")" }
    вернуть "(dan_rat_cmp(" + а + ", " + б + ") == 0)"
}

// ---------- программа ----------

общий тип Настройки {
    отладка: лог = ложь
    тесты: лог = ложь
    профиль: лог = ложь
    покрытие: лог = ложь
    замеры: лог = ложь
    /// «#line строка "файл.dan"» перед инструкциями: санитайзеры и gdb показывают строки программы
    строки_дан: лог = ложь
    /// папка с кодом библиотек на C (sreda) и разделитель частей пути
    среда: стр = "sreda"
    разделитель: стр = "/"
}

/// Имена функций программы, которые вызываются внутри узла.
функ вызываемые(у: разбор.Узел, имена: {стр: лог}, исходные: {стр: лог}) -> {стр: лог} {
    перем найдено = исходные
    если у.вид == "Вызов" {
        пусть ф = разбор.часть(у, "функция")
        если ф.вид == "Имя" и имена.содержит(ф.текст) { найдено[ф.текст] = истина }
    }
    для г_ в у.поля {
        для вложенный в г_.поля {
            если вложенный.вид != "=" { найдено = вызываемые(вложенный, имена, найдено) }
        }
    }
    вернуть найдено
}

/// Функции, которые могут вызвать сами себя (прямо или через другие функции).
функ рекурсивные_функции(функции: [разбор.Узел]) -> {стр: лог} {
    перем имена: {стр: лог} = {}
    для ф в функции { имена[разбор.свойство(ф, "имя")] = истина }
    перем вызовы: {стр: [стр]} = {}
    для ф в функции {
        вызовы[разбор.свойство(ф, "имя")] = вызываемые(разбор.часть(ф, "тело"), имена, {}).ключи()
    }
    перем рекурсивные: {стр: лог} = {}
    для начало в имена.ключи() {
        перем увиденные: {стр: лог} = {}
        перем очередь = вызовы[начало]
        пока очередь.длина > 0 {
            пусть имя_ = очередь[очередь.длина - 1]
            очередь.удалить(очередь.длина - 1)
            если имя_ == начало {
                рекурсивные[начало] = истина
                прервать
            }
            если не увиденные.содержит(имя_) {
                увиденные[имя_] = истина
                для х в вызовы[имя_] { очередь.добавить(х) }
            }
        }
    }
    вернуть рекурсивные
}

функ св(у: разбор.Узел, имя_: стр) -> стр { вернуть разбор.свойство(у, имя_) }
функ ч(у: разбор.Узел, имя_: стр) -> разбор.Узел { вернуть разбор.часть(у, имя_) }
функ гр(у: разбор.Узел, имя_: стр) -> [разбор.Узел] { вернуть разбор.часть_группы(у, имя_) }
функ есть(у: разбор.Узел, имя_: стр) -> лог { вернуть гр(у, имя_).длина > 0 }
функ пом(у: разбор.Узел, имя_: стр) -> стр { вернуть у.пометки.получить(имя_, "") }
функ тип_выр(у: разбор.Узел) -> стр { вернуть пом(у, "тип_выр") }

/// Текст программы на C для проверенного дерева.
общий функ сгенерировать(итог: проверка.Итог, файлы: [стр], тексты: [стр], настройки: Настройки) -> стр {
    перем г = Г()
    г.отладка = настройки.отладка
    г.тесты = настройки.тесты
    г.профиль = настройки.профиль
    г.покрытие = настройки.покрытие и настройки.тесты
    г.замеры = настройки.замеры и не настройки.тесты
    г.строки_дан = настройки.строки_дан
    если файлы.длина > 0 { г.файлы_программы = файлы }
    для н в 0..файлы.длина - 1 {
        если файлы[н].начинается("библиотека/") { г.файлы_библиотеки[н] = истина }
    }
    г.собственные = итог.с.типы
    г.перечисления = итог.с.перечисления
    г.написания = итог.с.написания
    г.описания = среда.описания()
    г.постоянные = среда.постоянные_c()
    пусть инструкции = гр(итог.дерево, "инструкции")
    перем функции: [разбор.Узел] = []
    перем прочие: [разбор.Узел] = []
    для и_ в инструкции {
        если и_.вид == "Функция" { функции.добавить(и_) } иначе { прочие.добавить(и_) }
    }
    г.рекурсивные = рекурсивные_функции(функции)
    если не г.отладка {
        для ф в функции {
            пусть п = потребляемые(г, ф)
            если п.длина > 0 { г.потребляемые[св(ф, "имя")] = п }
        }
    }
    пусть рв = внешние_функции(г, инструкции)
    г = рв.г
    // сначала порождается тело программы: при этом выясняется, какие типы нужны
    если функции.длина > 0 {
        г = пиши(г, "/* ---- program functions ---- */")
        для ф в функции {
            пусть р = заголовок(г, ф)
            г = пиши(р.г, р.к + ";")
        }
        г = пиши(г, "")
    }
    пусть место_лямбд = число_строк(г)
    для ф в функции {
        г = пиши(функция(г, ф), "")
    }
    если г.тесты {
        перем тесты: [разбор.Узел] = []
        для ф в функции {
            если ф.текст != "" и пом(ф, "замер") == "" { тесты.добавить(ф) }
        }
        г = главная_тестов(г, тесты)
        вернуть собрать_текст(г, место_лямбд, файлы, тексты, настройки)
    }
    если г.замеры {
        перем замеры: [разбор.Узел] = []
        для ф в функции {
            если пом(ф, "замер") != "" { замеры.добавить(ф) }
        }
        г = главная_замеров(г, замеры)
        вернуть собрать_текст(г, место_лямбд, файлы, тексты, настройки)
    }
    г = пиши(г, "int main(int argc, char **argv) {")
    г.отступ += 1
    г = пиши(г, "dan_argc = argc; dan_argv = argv; dan_start();")
    если г.отладка {
        г = пиши(г, "dan_dbg_start();")
        г = пиши(г, "__attribute__((cleanup(dan_dbg_leave))) int dan_df = dan_dbg_enter(" + строка_c("главная программа")
            + ", 0);")
    }
    пусть место_запуска = число_строк(г) - 1
    если г.профиль {
        г = пиши(г, "dan_prof_start();")
        г = начать_замер(г, "(основная часть программы)", 0)
    }
    г.метка_функции = "dan_main_mark"
    г.области = [[]]
    г.метки_циклов = []
    г.текущий_результат = ""
    г = пиши(г, "const size_t " + г.метка_функции + " = dan_mark();")
    г = инструкции_блока(г, прочие)
    // в конце программы память освобождает система, сразу всю: поштучное освобождение
    // значений только занимает время (на программах с большими данными - до 20%)
    г = пиши(г, "#if DAN_FREE_AT_EXIT")
    г = выход_из_функции(г)
    г = пиши(г, "#endif")
    г = пиши(г, "return 0;")
    если г.нужны_задачи { г = дописать_к_строке(г, место_запуска, " dan_tasks_init();") }
    г.отступ -= 1
    г = пиши(г, "}")
    вернуть собрать_текст(г, место_лямбд, файлы, тексты, настройки)
}

/// main сборки для «dan тестировать»: тесты по очереди; ошибка теста не останавливает остальные.
функ главная_тестов(исх: Г, тесты: [разбор.Узел]) -> Г {
    перем г = пиши(исх, "int main(int argc, char **argv) {")
    г.отступ += 1
    перем начало = "dan_argc = argc; dan_argv = argv; dan_start();"
    если г.нужны_задачи { начало += " dan_tasks_init();" }
    г = пиши(г, начало)
    если г.покрытие { г = пиши(г, "atexit(dan_cov_dump);") }
    г = пиши(г, "int dan_failed = 0;")
    г = пиши(г, "#ifndef __wasi__")
    г = пиши(г, "jmp_buf dan_here;")
    для ф в тесты {
        пусть название = строка_c(ф.текст)
        г = пиши(г, "{")
        г = пиши(г, "    const size_t dan_m = dan_mark();")
        г = пиши(г, "    if (!setjmp(dan_here)) {")
        пусть р = имя_си(г, св(ф, "имя"))
        г = пиши(р.г, "        dan_catch = &dan_here; " + р.к + "(); dan_catch = NULL;")
        г = пиши(г, "        printf(DAN_TEST_PASSED, " + название + ");")
        г = пиши(г, "    } else {")
        г = пиши(г, "        dan_catch = NULL; dan_failed++;")
        г = пиши(г, "        int l = dan_caught_line;")
        г = пиши(г, "        if (l >= DAN_FILE_STEP && l / DAN_FILE_STEP < DAN_FILE_COUNT)")
        г = пиши(г, "            printf(DAN_TEST_FAILED_FILE, " + название
            + ", dan_files[l / DAN_FILE_STEP], l % DAN_FILE_STEP, dan_caught);")
        г = пиши(г, "        else printf(DAN_TEST_FAILED, " + название + ", l, dan_caught);")
        г = пиши(г, "    }")
        г = пиши(г, "    dan_sweep(dan_m);")
        г = пиши(г, "    fflush(stdout);")
        г = пиши(г, "}")
    }
    пусть н = стр(тесты.длина)
    г = пиши(г, "printf(DAN_TEST_TOTAL, " + н + ", " + н + " - dan_failed, dan_failed);")
    г = пиши(г, "#else")
    г = пиши(г, "fputs(\"тесты в программе для WebAssembly не выполняются\\n\", stderr); dan_failed = 1;")
    г = пиши(г, "#endif")
    г = пиши(г, "return dan_failed ? 1 : 0;")
    г.отступ -= 1
    вернуть пиши(г, "}")
}

/// main сборки для «dan замерить»: замеры по очереди; ошибка замера не останавливает остальные.
функ главная_замеров(исх: Г, замеры: [разбор.Узел]) -> Г {
    перем г = пиши(исх, "int main(int argc, char **argv) {")
    г.отступ += 1
    перем начало = "dan_argc = argc; dan_argv = argv; dan_start();"
    если г.нужны_задачи { начало += " dan_tasks_init();" }
    г = пиши(г, начало)
    г = пиши(г, "dan_bench_open();")
    для ф в замеры {
        пусть р = имя_си(г, св(ф, "имя"))
        г = пиши(р.г, "{ const size_t dan_m = dan_mark(); dan_bench(" + строка_c(ф.текст) + ", " + р.к
            + "); dan_sweep(dan_m); }")
    }
    г = пиши(г, "if (dan_bench_out != stdout) fclose(dan_bench_out);")
    г = пиши(г, "return 0;")
    г.отступ -= 1
    вернуть пиши(г, "}")
}

функ определения(сообщения: [[стр]]) -> [стр] {
    перем итог: [стр] = []
    для п в сообщения { итог.добавить("#define " + п[0] + " " + строка_c(п[1])) }
    вернуть итог
}

функ код_файла(настройки: Настройки, имя_: стр) -> стр {
    вернуть прочитать(настройки.среда + настройки.разделитель + имя_)
}

функ собрать_текст(исх: Г, место_лямбд: цел, файлы_: [стр], тексты: [стр], настройки: Настройки) -> стр {
    перем г = исх
    перем код_программы = все_строки(г)
    если г.лямбды_код.длина > 0 {
        перем строки: [стр] = []
        для н в 0..место_лямбд - 1 { строки.добавить(код_программы[н]) }
        строки.добавить("/* ---- anonymous functions ---- */")
        для с в г.лямбды_код { строки.добавить(с) }
        для н в место_лямбд..код_программы.длина - 1 { строки.добавить(код_программы[н]) }
        код_программы = строки
    }
    перем шапка = [
        "/* Создано компилятором языка Дан. Редактировать не нужно. */",
        "#if defined(__wasi__) && !defined(_DEFAULT_SOURCE)", "#define _DEFAULT_SOURCE", "#endif"]
    если г.нужна_система или г.профиль или г.замеры или г.нужны_модели {
        для с в ["#if !defined(_WIN32) && !defined(__APPLE__)", "#define _DEFAULT_SOURCE", "#endif"] { шапка.добавить(с) }
    }
    для с в ["#if defined(__clang__)", "#pragma STDC FP_CONTRACT OFF", "#endif",
             "#include <stdint.h>", "#include <inttypes.h>", "#include <stdbool.h>",
             "#include <stdio.h>", "#include <stdlib.h>", "#include <string.h>", "#include <stddef.h>", "#include <ctype.h>",
             "#include <stdarg.h>", "#ifndef __wasi__", "#include <setjmp.h>", "#endif",
             "#include <errno.h>", "#include <math.h>", "#include <time.h>", "#include <sys/stat.h>",
             "#ifndef _WIN32", "#include <dirent.h>", "#include <unistd.h>", "#endif",
             "#if !defined(_WIN32) && !defined(__wasi__)", "#include <sys/resource.h>", "#endif",
             "#ifdef _WIN32", "#include <windows.h>", "#endif", ""] {
        шапка.добавить(с)
    }
    для с в определения(среда.сообщения("основные")) { шапка.добавить(с) }
    если г.нужны_данные {
        для с в определения(среда.сообщения("данные")) { шапка.добавить(с) }
    }
    если г.нужна_система {
        для с в определения(среда.сообщения("система")) { шапка.добавить(с) }
        для с в ["#if !defined(_WIN32) && !defined(__wasi__)", "#include <sys/wait.h>", "#endif"] { шапка.добавить(с) }
    }
    если г.нужна_сеть или г.нужна_база { шапка.добавить("#define DAN_NET 1") }
    если г.нужны_окна { шапка.добавить("#define DAN_GUI 1") }
    если г.нужны_модели { шапка.добавить("#define DAN_MODELI 1") }
    если г.профиль {
        перем замеры = г.профиль_функции
        если замеры.длина == 0 { замеры = [["", "0"]] }
        перем имена_: [стр] = []
        перем строки_: [стр] = []
        для з в замеры {
            имена_.добавить(строка_c(з[0]))
            строки_.добавить(з[1])
        }
        перем число = г.профиль_функции.длина
        если число < 1 { число = 1 }
        шапка.добавить("#define DAN_PROF_COUNT " + стр(число))
        шапка.добавить("static const char *const dan_prof_names[] = {" + имена_.соединить(", ") + "};")
        шапка.добавить("static const int dan_prof_lines[] = {" + строки_.соединить(", ") + "};")
    }
    если г.покрытие {
        перем отмеченные: [стр] = []
        для с в г.покрытие_строки { отмеченные.добавить(стр(с)) }
        если отмеченные.длина == 0 { отмеченные = ["0"] }
        перем число = г.покрытие_строки.длина
        если число < 1 { число = 1 }
        шапка.добавить("#define DAN_COV_COUNT " + стр(число))
        шапка.добавить("static unsigned char dan_cov[DAN_COV_COUNT];")
        шапка.добавить("static const int dan_cov_lines[] = {" + отмеченные.соединить(", ") + "};")
    }
    если г.отладка {
        шапка.добавить("#define DAN_DEBUG 1")
        шапка.добавить("static void dan_dbg_error(const char *text, int line);")
        для с в определения(среда.сообщения("отладчик")) { шапка.добавить(с) }
    }
    если г.нужна_математика {
        для с в определения(среда.сообщения("математика")) { шапка.добавить(с) }
        для с в определения(среда.сообщения("имена_c")) { шапка.добавить(с) }
    }
    если г.нужны_задачи {
        для с в ["#define DAN_TASKS 1", "#define DAN_TLS _Thread_local", "#ifndef _WIN32", "#include <pthread.h>", "#endif",
                 "#define DAN_OUT_LOCK() dan_out_lock()", "#define DAN_OUT_UNLOCK() dan_out_unlock()"] {
            шапка.добавить(с)
        }
    } иначе {
        для с в ["#define DAN_TLS", "#define DAN_OUT_LOCK() ((void)0)", "#define DAN_OUT_UNLOCK() ((void)0)"] { шапка.добавить(с) }
    }
    перем файлы = файлы_
    если файлы.длина == 0 { файлы = ["программа.dan"] }
    шапка.добавить("")
    шапка.добавить("#define DAN_FILE_STEP 1000000")
    шапка.добавить("#define DAN_FILE_COUNT " + стр(файлы.длина))
    перем имена_файлов: [стр] = []
    для ф в файлы { имена_файлов.добавить(строка_c(ф)) }
    шапка.добавить("static const char *const dan_files[] = {" + имена_файлов.соединить(", ") + "};")
    перем части = [шапка.соединить("\n"), среда.среда()]
    если г.профиль { части.добавить(среда.профиль()) }
    если г.покрытие { части.добавить(среда.покрытие()) }
    если г.замеры { части.добавить(среда.замеры()) }
    если г.нужны_задачи { части.добавить(среда.задачи()) }
    если г.нужны_длинные { части.добавить(среда.длинные()) }
    если г.нужны_компл { части.добавить(среда.комплексные()) }
    если г.нужны_даты { части.добавить(среда.даты()) }
    если г.нужны_массивы { части.добавить(код_файла(настройки, "massivy.c")) }
    если г.отладка {
        перем строки_файлов: [стр] = []
        перем числа: [стр] = []
        перем ссылки: [стр] = []
        для номер в 0..файлы.длина - 1 {
            перем текст = ""
            если номер < тексты.длина { текст = тексты[номер] }
            перем записи: [стр] = []
            для с в текст.разбить("\n") { записи.добавить(строка_c(обрезать_справа(с))) }
            строки_файлов.добавить("static const char *const dan_dbg_src_" + стр(номер) + "[] = {" + записи.соединить(", ") + "};")
            ссылки.добавить("dan_dbg_src_" + стр(номер))
            числа.добавить(стр(текст.разбить("\n").длина))
        }
        строки_файлов.добавить("static const char *const *const dan_dbg_src[] = {" + ссылки.соединить(", ") + "};")
        строки_файлов.добавить("static const int dan_dbg_src_count[] = {" + числа.соединить(", ") + "};")
        части.добавить(строки_файлов.соединить("\n"))
        части.добавить(среда.отладка())
    }
    г = собрать_все_типы(г)
    пусть рт = определения_типов(г)
    г = рт.г
    части.добавить(рт.к)
    пусть рз = определения_задач(г)
    г = рз.г
    части.добавить(рз.к)
    для имя_ в г.словари.значения() {
        части.добавить(формат(среда.объявления_словаря(), {"D": имя_}))
        для т в г.словари.ключи() {
            если г.словари[т] == имя_ и сравнимый(г, т) {
                части.добавить("static bool " + имя_ + "_eq(const " + имя_ + " *x, const " + имя_ + " *y);")
            }
        }
    }
    для т в г.списки.ключи() {
        пусть имя_ = г.списки[т]
        пусть т_эл = типы.элемент(т)
        пусть р1 = тип_c(г, т_эл)
        пусть р2 = запись_типа(р1.г, т_эл, истина)
        пусть р3 = строка_элемента(р2.г, т_эл)
        пусть р4 = удержать(р3.г, т_эл)
        пусть р5 = отпустить(р4.г, т_эл)
        г = р5.г
        перем ш_ = р4.к
        если ш_ == "" { ш_ = "DAN_ID" }
        перем р_л = р5.к
        если р_л == "" { р_л = "DAN_NOREL" }
        части.добавить(формат(среда.шаблон_списка(), {"описание": т, "S": имя_, "T": р1.к, "запись_элемента": р2.к,
                                                      "строка_элемента": р3.к, "SH": ш_, "RL": р_л}))
        пусть рр = равенство(г, т_эл)
        г = рр.г
        если рр.к != "" {
            пусть рт_ = тип_c(г, т_эл)
            г = рт_.г
            части.добавить(формат(среда.шаблон_поиска(), {"S": имя_, "T": рт_.к, "EQ": рр.к}))
        }
        если т_эл == "стр" { части.добавить(среда.код_строк_со_списками()) }
    }
    если г.словари.длина > 0 { части.добавить(среда.код_хешей()) }
    для т в г.словари.ключи() {
        пусть имя_ = г.словари[т]
        пусть к = типы.ключ_словаря(т)
        пусть з = типы.значение_словаря(т)
        перем необяз = з + "?"
        если типы.это_необяз(з) { необяз = з }
        перем найти_ = ""
        если не типы.это_функция(з) {
            пусть рк1 = тип_c(г, к)
            пусть рк2 = тип_c(рк1.г, необяз)
            г = рк2.г
            перем некоторое = ""
            если не типы.это_необяз(з) {
                пусть рк3 = тип_c(г, необяз)
                г = рк3.г
                некоторое = рк3.к + "_some"
            }
            найти_ = формат(среда.шаблон_поиска_в_словаре(), {"D": имя_, "K": рк1.к, "HASH": хеш(к), "O": рк2.к, "O_SOME": некоторое})
        }
        пусть с1 = тип_c(г, к)
        пусть с2 = тип_c(с1.г, з)
        пусть с3 = равенство(с2.г, к)
        пусть с4 = строка_элемента(с3.г, к)
        пусть с5 = строка_элемента(с4.г, з)
        пусть с6 = структура(с5.г, "[" + к + "]")
        пусть с7 = структура(с6.г, "[" + з + "]")
        пусть с8 = удержать(с7.г, к)
        пусть с9 = отпустить(с8.г, к)
        пусть с10 = удержать(с9.г, з)
        пусть с11 = отпустить(с10.г, з)
        г = с11.г
        части.добавить(формат(среда.шаблон_словаря(), {"описание": т, "D": имя_, "K": с1.к, "V": с2.к, "EQ_K": с3.к,
            "HASH": хеш(к), "СТРОКА_К": с4.к, "СТРОКА_З": с5.к, "НАЙТИ": найти_, "LK": с6.к, "LV": с7.к,
            "SK": или_иначе(с8.к, "DAN_ID"), "RK": или_иначе(с9.к, "DAN_NOREL"), "SV": или_иначе(с10.к, "DAN_ID"),
            "RV": или_иначе(с11.к, "DAN_NOREL")}))
        если сравнимый(г, т) {
            пусть в1 = тип_c(г, з)
            пусть в2 = равенство(в1.г, з)
            г = в2.г
            части.добавить(формат(среда.шаблон_равенства_словаря(), {"D": имя_, "V": в1.к, "EQ_V": в2.к}))
        }
    }
    пусть ф1 = функции_типов(г)
    г = ф1.г
    части.добавить(ф1.к)
    пусть ф2 = функции_перечислений(г)
    г = ф2.г
    части.добавить(ф2.к)
    пусть ф3 = функции_расширения(г)
    г = ф3.г
    части.добавить(ф3.к)
    части.добавить(г.помощники.значения().соединить("\n"))
    если г.списки.содержит("[компл]") { части.добавить(среда.комплексные_корни()) }
    пусть ф4 = функции_клонов(г)
    г = ф4.г
    части.добавить(ф4.к)
    пусть ф5 = функции_каналов(г)
    г = ф5.г
    части.добавить(ф5.к)
    пусть ф6 = функции_задач(г)
    г = ф6.г
    части.добавить(ф6.к)
    если г.нужны_данные {
        части.добавить(код_файла(настройки, "dannye.c"))
        если г.нужен_pdf { части.добавить(код_файла(настройки, "pdf.c")) }
    }
    если г.нужна_система { части.добавить(код_файла(настройки, "sistema.c")) }
    если г.нужна_сеть { части.добавить(код_файла(настройки, "set.c")) }
    если г.нужна_база { части.добавить(код_файла(настройки, "baza.c")) }
    если г.нужны_ядра { части.добавить(код_файла(настройки, "yadra.c")) }
    если г.нужны_модели { части.добавить(код_файла(настройки, "modeli.c")) }
    если г.нужны_биты { части.добавить(среда.биты()) }
    если г.нужны_окна {
        части.добавить(код_файла(настройки, "okna.c").заменить("#include \"okna_veb.c\"", код_файла(настройки, "okna_veb.c")))
    }
    если г.нужна_математика {
        части.добавить(среда.математика())
        части.добавить(среда.математика_дополнения())
        части.добавить(среда.многочлены_строки())
        части.добавить(среда.многочлены())
        части.добавить(среда.высшая())
    }
    если г.отладочные_записи.длина > 0 {
        перем записи: [стр] = []
        для з в г.отладочные_записи.значения() { записи.добавить(з[1]) }
        части.добавить(записи.соединить("\n"))
    }
    части.добавить(код_программы.соединить("\n"))
    перем постоянные = ["/* ---- string constants ---- */"]
    для текст в г.литералы.ключи() {
        постоянные.добавить("DAN_STATIC_STR(" + г.литералы[текст] + ", " + строка_c(текст) + ");")
    }
    части.вставить(2, постоянные.соединить("\n") + "\n")
    вернуть части.соединить("\n") + "\n"
}

функ или_иначе(а: стр, б: стр) -> стр {
    если а == "" { вернуть б }
    вернуть а
}

/// Строка без пробельных символов в конце (как str.rstrip).
функ обрезать_справа(с: стр) -> стр {
    пусть символы = с.символы()
    перем конец = символы.длина
    пока конец > 0 и пробельный(символы[конец - 1]) { конец -= 1 }
    вернуть типы.срез(с, 0, конец)
}

функ пробельный(з: стр) -> лог {
    пусть к = код_символа(з)
    вернуть (з == " " или (к >= 9 и к <= 13) или (к >= 28 и к <= 31) или к == 133 или к == 160 или к == 5760
        или (к >= 8192 и к <= 8202) или к == 8232 или к == 8233 или к == 8239 или к == 8287 или к == 12288)
}

// ---------- собственные и необязательные типы ----------

/// Регистрирует тип и всё, что нужно для его вывода, сравнения и учёта.
функ зарегистрировать(исх: Г, т: стр, в_строку_: лог) -> Г {
    перем г = тип_c(исх, т).г
    г = строка_элемента(г, т).г
    если в_строку_ { г = в_строку(г, т, "x").г }
    г = равенство(г, т).г
    вернуть удержать(г, т).г
}

/// Регистрирует все типы, которые понадобятся определениям (до неподвижной точки).
функ собрать_все_типы(исх: Г) -> Г {
    перем г = исх
    пока истина {
        пусть размер = [г.списки.длина, г.значимые.длина, г.словари.длина, г.перечисления_c.длина]
        для т в г.перечисления_c.ключи() {
            для в_ в г.перечисления[т] {
                для п в в_.поля { г = зарегистрировать(г, п.т, ложь) }
            }
        }
        для т в г.словари.ключи() {
            г = зарегистрировать(г, типы.ключ_словаря(т), ложь)
            г = зарегистрировать(г, типы.значение_словаря(т), ложь)
        }
        для т в г.списки.ключи() { г = зарегистрировать(г, типы.элемент(т), ложь) }
        для т в г.значимые.ключи() {
            если типы.это_функция(т) { продолжить }
            если типы.это_результат(т) {
                если типы.основа(т) != ПУСТО() {
                    г = тип_c(г, типы.основа(т)).г
                    г = удержать(г, типы.основа(т)).г
                }
                продолжить
            }
            если типы.это_необяз(т) {
                г = зарегистрировать(г, типы.основа(т), истина)
            } иначе {
                для п в г.собственные[т] { г = зарегистрировать(г, п.т, истина) }
            }
        }
        если [г.списки.длина, г.значимые.длина, г.словари.длина, г.перечисления_c.длина] == размер { вернуть г }
    }
    вернуть г
}

функ определения_типов(исх: Г) -> РК {
    перем г = исх
    перем строки = ["/* ---- types of the program ---- */"]
    для имя_ в г.списки.значения() { строки.добавить("typedef struct " + имя_ + " " + имя_ + ";") }
    для имя_ в г.словари.значения() { строки.добавить("typedef struct " + имя_ + " " + имя_ + ";") }
    для имя_ в г.перечисления_c.значения() {
        строки.добавить("typedef struct " + имя_ + "_s " + имя_ + "_s;")
        строки.добавить("typedef const " + имя_ + "_s *" + имя_ + ";")
    }
    перем готовые: {стр: лог} = {}
    для т в г.значимые.ключи() {
        если по_ссылке(г, т) {
            пусть р = значимый(г, типы.основа(т))
            г = р.г
            строки.добавить("typedef const struct " + р.к + " *" + г.значимые[т] + ";")
            готовые[т] = истина
        }
    }
    для т в г.значимые.ключи() {
        пусть р = определить(г, т, готовые, строки)
        г = р.г
        готовые = р.готовые
        строки = р.строки
    }
    // перечисления: значения - указатели на неизменяемые ячейки (деревья любой глубины)
    для т в г.перечисления_c.ключи() {
        пусть имя_ = г.перечисления_c[т]
        перем варианты: [стр] = []
        перем номер = 0
        для в_ в г.перечисления[т] {
            если в_.поля.длина > 0 {
                перем содержимое: [стр] = []
                для п в в_.поля {
                    пусть р1 = тип_c(г, п.т)
                    пусть р2 = поле_c(р1.г, вариант_владелец(т, в_.имя), п.имя)
                    г = р2.г
                    содержимое.добавить(р1.к + " " + р2.к + ";")
                }
                варианты.добавить("struct { " + содержимое.соединить(" ") + " } v" + стр(номер) + ";")
            }
            номер += 1
        }
        перем объединение = ""
        если варианты.длина > 0 { объединение = " union { " + варианты.соединить(" ") + " } u;" }
        строки.добавить("struct " + имя_ + "_s { dan_hdr h; int tag;" + объединение + " };")
        номер = 0
        для в_ в г.перечисления[т] {
            перем параметры: [стр] = []
            перем и_ = 0
            для п в в_.поля {
                пусть р = тип_c(г, п.т)
                г = р.г
                параметры.добавить(р.к + " a" + стр(и_))
                и_ += 1
            }
            строки.добавить("static " + имя_ + " " + имя_ + "_mk" + стр(номер) + "(" + или_иначе(параметры.соединить(", "), "void") + ");")
            номер += 1
        }
        строки.добавить("static void " + имя_ + "_destroy(dan_hdr *h);")
        строки.добавить("static inline " + имя_ + " " + имя_ + "_share(" + имя_ + " v) { if (v) dan_hdr_share((dan_hdr *)&v->h); return v; }")
        строки.добавить("static inline void " + имя_ + "_release(" + имя_ + " v) { if (v) dan_hdr_release((dan_hdr *)&v->h, " + имя_ + "_destroy); }")
        строки.добавить("static inline void " + имя_ + "_give(" + имя_ + " v) { if (v) dan_hdr_give((dan_hdr *)&v->h, " + имя_ + "_destroy); }")
        строки.добавить("static dan_str " + имя_ + "_str(" + имя_ + " v);")
        строки.добавить("static void " + имя_ + "_write(" + имя_ + " v);")
        если сравнимый(г, т) { строки.добавить("static bool " + имя_ + "_eq(" + имя_ + " a, " + имя_ + " b);") }
    }
    для т в г.значимые.ключи() {
        пусть имя_ = г.значимые[т]
        если типы.это_функция(т) { продолжить }
        если типы.это_результат(т) {
            если типы.основа(т) == ПУСТО() {
                строки.добавить("static inline bool " + имя_ + "_has(" + имя_ + " o) { return o.ok; }")
                строки.добавить("static inline " + имя_ + " " + имя_ + "_some(void) { return (" + имя_ + "){ .ok = true, .err = NULL, .line = 0 }; }")
            } иначе {
                пусть р = тип_c(г, типы.основа(т))
                г = р.г
                строки.добавить("static inline bool " + имя_ + "_has(" + имя_ + " o) { return o.ok; }")
                строки.добавить("static inline " + р.к + " " + имя_ + "_val(" + имя_ + " o) { return o.value; }")
                строки.добавить("static inline " + имя_ + " " + имя_ + "_some(" + р.к + " v) { return (" + имя_ + "){ .ok = true, .value = v, .err = NULL, .line = 0 }; }")
            }
            строки.добавить("static inline " + имя_ + " " + имя_ + "_err(dan_str e, int line) { " + имя_ + " r; memset(&r, 0, sizeof r); "
                + "r.ok = false; r.err = e; r.line = line; return r; }")
            строки.добавить("static " + имя_ + " " + имя_ + "_share(" + имя_ + " v);")
            строки.добавить("static void " + имя_ + "_release(" + имя_ + " v);")
            строки.добавить("static void " + имя_ + "_give(" + имя_ + " v);")
            продолжить
        }
        если типы.это_необяз(т) {
            пусть р = тип_c(г, типы.основа(т))
            г = р.г
            пусть т_c = р.к
            если по_ссылке(г, т) {
                строки.добавить("typedef struct { dan_hdr h; " + т_c + " v; } " + имя_ + "_cell;")
                строки.добавить("static inline bool " + имя_ + "_has(" + имя_ + " o) { return o != NULL; }")
                строки.добавить("static inline " + т_c + " " + имя_ + "_val(" + имя_ + " o) { return *o; }")
                строки.добавить("static inline " + имя_ + " " + имя_ + "_none(void) { return NULL; }")
                строки.добавить("static inline dan_hdr *" + имя_ + "_hdr(" + имя_ + " o) { return (dan_hdr *)(void *)((char *)(void *)o - offsetof("
                    + имя_ + "_cell, v)); }")
                строки.добавить("static void " + имя_ + "_destroy(dan_hdr *h);")
                строки.добавить("static " + имя_ + " " + имя_ + "_some(" + т_c + " v);")
            } иначе {
                строки.добавить("static inline bool " + имя_ + "_has(" + имя_ + " o) { return o.has; }")
                строки.добавить("static inline " + т_c + " " + имя_ + "_val(" + имя_ + " o) { return o.value; }")
                строки.добавить("static inline " + имя_ + " " + имя_ + "_none(void) { return (" + имя_ + "){ .has = false }; }")
                строки.добавить("static inline " + имя_ + " " + имя_ + "_some(" + т_c + " v) { return (" + имя_ + "){ .has = true, .value = v }; }")
            }
        }
        строки.добавить("static dan_str " + имя_ + "_str(" + имя_ + " v);")
        если не типы.это_необяз(т) { строки.добавить("static void " + имя_ + "_strb(" + имя_ + " v, dan_buf *b);") }
        строки.добавить("static void " + имя_ + "_write(" + имя_ + " v);")
        если типы.это_необяз(т) {
            строки.добавить("static dan_str " + имя_ + "_qstr(" + имя_ + " v);")
            строки.добавить("static void " + имя_ + "_qwrite(" + имя_ + " v);")
        }
        если сравнимый(г, т) { строки.добавить("static bool " + имя_ + "_eq(" + имя_ + " a, " + имя_ + " b);") }
        если куча(г, т) {
            строки.добавить("static " + имя_ + " " + имя_ + "_share(" + имя_ + " v);")
            строки.добавить("static void " + имя_ + "_release(" + имя_ + " v);")
            строки.добавить("static void " + имя_ + "_give(" + имя_ + " v);")
        }
    }
    вернуть рк(г, строки.соединить("\n") + "\n")
}

тип РО {
    г: Г
    готовые: {стр: лог}
    строки: [стр]
}

/// Определение типа C значения вместе с типами, от которых оно зависит.
функ определить(исх: Г, т: стр, исх_готовые: {стр: лог}, исх_строки: [стр]) -> РО {
    перем г = исх
    перем готовые = исх_готовые
    перем строки = исх_строки
    если готовые.содержит(т) { вернуть РО(г, готовые, строки) }
    готовые[т] = истина
    пусть имя_ = г.значимые[т]
    если типы.это_функция(т) {
        пусть ф = типы.разобрать_тип_функции(т)
        перем все = ф.параметры
        все.добавить(ф.результат)
        для х в все {
            если г.значимые.содержит(х) {
                пусть р = определить(г, х, готовые, строки)
                г = р.г
                готовые = р.готовые
                строки = р.строки
            }
        }
        пусть рр = тип_c(г, ф.результат)
        г = рр.г
        перем п = ""
        для х в ф.параметры {
            пусть р = тип_c(г, х)
            г = р.г
            п += ", " + р.к
        }
        строки.добавить("typedef struct { " + рр.к + " (*f)(void *" + п + "); void *env; } " + имя_ + ";")
        перем аргументы = ""
        перем передать = ""
        перем и_ = 0
        для х в ф.параметры {
            пусть р = тип_c(г, х)
            г = р.г
            аргументы += ", " + р.к + " a" + стр(и_)
            передать += ", a" + стр(и_)
            и_ += 1
        }
        перем возврат = "return "
        если рр.к == "void" { возврат = "" }
        строки.добавить("static inline " + рр.к + " " + имя_ + "_call(" + имя_ + " v" + аргументы + ") { " + возврат + "v.f(v.env" + передать + "); }")
        пусть рл = литерал(г, "<функция>")
        г = рл.г
        строки.добавить("static inline dan_str " + имя_ + "_str(" + имя_ + " v) { (void)v; return " + рл.к + "; }")
        строки.добавить("static inline void " + имя_ + "_write(" + имя_ + " v) { fputs(" + имя_ + "_str(v), stdout); }")
        строки.добавить("static inline " + имя_ + " " + имя_ + "_share(" + имя_ + " v) { dan_env_share(v.env); return v; }")
        строки.добавить("static inline void " + имя_ + "_release(" + имя_ + " v) { dan_env_release(v.env); }")
        строки.добавить("static inline void " + имя_ + "_give(" + имя_ + " v) { dan_env_give(v.env); }")
        вернуть РО(г, готовые, строки)
    }
    перем зависимости: [стр] = []
    если типы.это_необяз(т) или типы.это_результат(т) {
        зависимости = [типы.основа(т)]
    } иначе {
        для п в г.собственные[т] { зависимости.добавить(п.т) }
    }
    для х в зависимости {
        если г.значимые.содержит(х) {
            пусть р = определить(г, х, готовые, строки)
            г = р.г
            готовые = р.готовые
            строки = р.строки
        }
    }
    если типы.это_результат(т) {
        перем значение = ""
        если типы.основа(т) != ПУСТО() {
            пусть р = тип_c(г, типы.основа(т))
            г = р.г
            значение = " " + р.к + " value;"
        }
        строки.добавить("typedef struct { bool ok;" + значение + " dan_str err; int line; } " + имя_ + ";")
    } иначе если типы.это_необяз(т) {
        пусть р = тип_c(г, типы.основа(т))
        г = р.г
        строки.добавить("typedef struct { bool has; " + р.к + " value; } " + имя_ + ";")
    } иначе {
        перем поля: [стр] = []
        для п в г.собственные[т] {
            пусть р1 = тип_c(г, п.т)
            пусть р2 = поле_c(р1.г, т, п.имя)
            г = р2.г
            поля.добавить(р1.к + " " + р2.к + ";")
        }
        строки.добавить("typedef struct " + имя_ + " { " + поля.соединить(" ") + " } " + имя_ + ";")
    }
    вернуть РО(г, готовые, строки)
}

/// Собственные типы, значения которых могут содержать значения того же типа.
функ рекурсивные_типы(г: Г) -> {стр: лог} {
    перем рекурсивные: {стр: лог} = {}
    для начало в г.собственные.ключи() {
        перем увиденные: {стр: лог} = {}
        перем очередь = прямые(г, начало)
        пока очередь.длина > 0 {
            пусть т = очередь[очередь.длина - 1]
            очередь.удалить(очередь.длина - 1)
            если т == начало {
                рекурсивные[начало] = истина
                прервать
            }
            если не увиденные.содержит(т) {
                увиденные[т] = истина
                для х в прямые(г, т) { очередь.добавить(х) }
            }
        }
    }
    вернуть рекурсивные
}

функ прямые(г: Г, т: стр) -> [стр] {
    перем итог: [стр] = []
    для п в г.собственные[т] {
        перем х = п.т
        пока типы.это_список(х) или типы.это_необяз(х) {
            если типы.это_список(х) { х = типы.элемент(х) } иначе { х = типы.основа(х) }
        }
        если г.собственные.содержит(х) и не итог.содержит(х) { итог.добавить(х) }
    }
    вернуть итог
}

функ номер_варианта(г: Г, т: стр, вариант: стр) -> цел {
    перем н = 0
    для в_ в г.перечисления[т] {
        если в_.имя == вариант { вернуть н }
        н += 1
    }
    вернуть -1
}

функ функции_перечислений(исх: Г) -> РК {
    перем г = исх
    перем строки: [стр] = []
    для т в г.перечисления_c.ключи() {
        пусть имя_ = г.перечисления_c[т]
        // ячейка варианта учитывает свои поля: при создании они получают место хранения,
        // при освобождении ячейки - теряют его
        перем номер = 0
        для в_ в г.перечисления[т] {
            перем параметры: [стр] = []
            перем и_ = 0
            для п в в_.поля {
                пусть р = тип_c(г, п.т)
                г = р.г
                параметры.добавить(р.к + " a" + стр(и_))
                и_ += 1
            }
            перем присвоить: [стр] = []
            и_ = 0
            для п в в_.поля {
                пусть р1 = поле_c(г, вариант_владелец(т, в_.имя), п.имя)
                пусть р2 = учесть(р1.г, п.т, "a" + стр(и_))
                г = р2.г
                присвоить.добавить("c->u.v" + стр(номер) + "." + р1.к + " = " + р2.к + ";")
                и_ += 1
            }
            если в_.поля.длина == 0 {
                // вариант без полей у всех значений один и тот же: общая ячейка, которая не освобождается
                строки.добавить("static " + имя_ + " " + имя_ + "_mk" + стр(номер) + "(void) { static " + имя_ + "_s c = { DAN_HDR_INIT, "
                    + стр(номер) + " }; return &c; }")
            } иначе {
                строки.добавить("static " + имя_ + " " + имя_ + "_mk" + стр(номер) + "(" + или_иначе(параметры.соединить(", "), "void")
                    + ") { " + имя_ + "_s *c = dan_alloc(sizeof *c); dan_hdr_new(&c->h, " + имя_ + "_destroy); c->tag = "
                    + стр(номер) + "; " + присвоить.соединить(" ") + " return c; }")
            }
            номер += 1
        }
        строки.добавить("static void " + имя_ + "_destroy(dan_hdr *h) {")
        строки.добавить("    " + имя_ + "_s *c = (" + имя_ + "_s *)(void *)h;")
        строки.добавить("    switch (c->tag) {")
        номер = 0
        для в_ в г.перечисления[т] {
            перем освободить: [стр] = []
            для п в в_.поля {
                пусть р1 = отпустить(г, п.т)
                г = р1.г
                если р1.к != "" {
                    пусть р2 = поле_c(г, вариант_владелец(т, в_.имя), п.имя)
                    пусть р3 = отпустить(р2.г, п.т)
                    г = р3.г
                    освободить.добавить(р3.к + "(c->u.v" + стр(номер) + "." + р2.к + ");")
                }
            }
            если освободить.длина > 0 { строки.добавить("    case " + стр(номер) + ": " + освободить.соединить(" ") + " break;") }
            номер += 1
        }
        строки.добавить("    default: break;")
        строки.добавить("    }")
        строки.добавить("    dan_free(c);")
        строки.добавить("}")
        строки.добавить("static dan_str " + имя_ + "_str(" + имя_ + " v) {")
        строки.добавить("    DAN_STACK_CHECK(0);")
        строки.добавить("    dan_buf b = { NULL, 0, 0 };")
        строки.добавить("    switch (v->tag) {")
        номер = 0
        для в_ в г.перечисления[т] {
            пусть надпись = г.написания.получить(т + "|" + в_.имя, в_.имя)
            строки.добавить("    case " + стр(номер) + ":")
            если в_.поля.длина == 0 {
                строки.добавить("        dan_buf_add(&b, " + строка_c(надпись) + ");")
            } иначе {
                строки.добавить("        dan_buf_add(&b, " + строка_c(надпись + "(") + ");")
                перем и_ = 0
                для п в в_.поля {
                    перем подпись = ""
                    если и_ > 0 { подпись = ", " }
                    подпись += г.написания.получить(т + "|" + в_.имя + "|" + п.имя, п.имя) + " = "
                    строки.добавить("        dan_buf_add(&b, " + строка_c(подпись) + ");")
                    пусть р1 = строка_элемента(г, п.т)
                    пусть р2 = поле_c(р1.г, вариант_владелец(т, в_.имя), п.имя)
                    г = р2.г
                    строки.добавить("        dan_buf_add(&b, " + р1.к + "(v->u.v" + стр(номер) + "." + р2.к + "));")
                    и_ += 1
                }
                строки.добавить("        dan_buf_add(&b, \")\");")
            }
            строки.добавить("        break;")
            номер += 1
        }
        строки.добавить("    }")
        строки.добавить("    return dan_buf_str(&b);")
        строки.добавить("}")
        строки.добавить("static void " + имя_ + "_write(" + имя_ + " v) { fputs(" + имя_ + "_str(v), stdout); }")
        если сравнимый(г, т) {
            строки.добавить("static bool " + имя_ + "_eq(" + имя_ + " a, " + имя_ + " b) {")
            строки.добавить("    DAN_STACK_CHECK(0);")
            строки.добавить("    if (a == b) return true;")
            строки.добавить("    if (a->tag != b->tag) return false;")
            строки.добавить("    switch (a->tag) {")
            номер = 0
            для в_ в г.перечисления[т] {
                перем части: [стр] = []
                для п в в_.поля {
                    пусть р1 = равенство(г, п.т)
                    пусть р2 = поле_c(р1.г, вариант_владелец(т, в_.имя), п.имя)
                    пусть р3 = поле_c(р2.г, вариант_владелец(т, в_.имя), п.имя)
                    г = р3.г
                    части.добавить(подставить(р1.к, "a->u.v" + стр(номер) + "." + р2.к, "b->u.v" + стр(номер) + "." + р3.к))
                }
                строки.добавить("    case " + стр(номер) + ": return " + или_иначе(части.соединить(" && "), "true") + ";")
                номер += 1
            }
            строки.добавить("    }")
            строки.добавить("    return true;")
            строки.добавить("}")
        }
    }
    вернуть рк(г, строки.соединить("\n") + "\n")
}

функ функции_типов(исх: Г) -> РК {
    перем г = исх
    перем строки: [стр] = []
    пусть рекурсивные = рекурсивные_типы(г)
    пусть ничего_c = строка_c("ничего")
    пусть рн = литерал(г, "ничего")
    г = рн.г
    пусть ничего_значение = рн.к
    для т в г.значимые.ключи() {
        пусть имя_ = г.значимые[т]
        если типы.это_функция(т) { продолжить }
        если типы.это_результат(т) {
            пусть о = типы.основа(т)
            для действие в ["share", "release", "give"] {
                перем ф = ""
                если о != ПУСТО() {
                    пусть р = учёт(г, о, действие)
                    г = р.г
                    ф = р.к
                }
                перем знач = ""
                если ф != "" {
                    если действие == "share" { знач = "v.value = " + ф + "(v.value);" } иначе { знач = ф + "(v.value);" }
                }
                перем ошибка_ = "dan_str_" + действие + "(v.err);"
                если действие == "share" { ошибка_ = "v.err = dan_str_share(v.err);" }
                перем возврат = "void"
                перем конец = ""
                если действие == "share" {
                    возврат = имя_
                    конец = " return v;"
                }
                строки.добавить("static " + возврат + " " + имя_ + "_" + действие + "(" + имя_ + " v) { if (v.ok) { " + знач + " } "
                    + "else { " + ошибка_ + " }" + конец + " }")
            }
            продолжить
        }
        строки.добавить("/* ---- " + т + " ---- */")
        если типы.это_необяз(т) {
            пусть о = типы.основа(т)
            пусть знач = имя_ + "_val(v)"
            пусть р1 = в_строку(г, о, знач)
            г = р1.г
            строки.добавить("static dan_str " + имя_ + "_str(" + имя_ + " v) { return " + имя_ + "_has(v) ? " + р1.к + " : "
                + ничего_значение + "; }")
            пусть р2 = строка_элемента(г, о)
            г = р2.г
            строки.добавить("static dan_str " + имя_ + "_qstr(" + имя_ + " v) { return " + имя_ + "_has(v) ? " + р2.к + "(" + знач
                + ") : " + ничего_значение + "; }")
            строки.добавить("static void " + имя_ + "_qwrite(" + имя_ + " v) { fputs(" + имя_ + "_qstr(v), stdout); }")
            если сравнимый(г, т) {
                пусть р3 = равенство(г, о)
                г = р3.г
                пусть равно = подставить(р3.к, имя_ + "_val(a)", имя_ + "_val(b)")
                строки.добавить("static bool " + имя_ + "_eq(" + имя_ + " a, " + имя_ + " b) { return " + имя_ + "_has(a) == " + имя_
                    + "_has(b) && (!" + имя_ + "_has(a) || " + равно + "); }")
            }
        } иначе {
            пусть поля = г.собственные[т]
            перем проверка_ = ""
            если рекурсивные.содержит(т) { проверка_ = "DAN_STACK_CHECK(0); " }
            // вложенные значения собственных типов дописываются в общий буфер: вывод длинной цепочки линеен
            строки.добавить("static void " + имя_ + "_strb(" + имя_ + " v, dan_buf *b) {")
            если проверка_ != "" { строки.добавить("    DAN_STACK_CHECK(0);") }
            строки.добавить("    dan_buf_add(b, " + строка_c(г.написания.получить(т, т) + "(") + ");")
            перем номер = 0
            для п в поля {
                перем подпись = ""
                если номер > 0 { подпись = ", " }
                подпись += г.написания.получить(т + "|" + п.имя, п.имя) + " = "
                строки.добавить("    dan_buf_add(b, " + строка_c(подпись) + ");")
                пусть рп = поле_c(г, т, п.имя)
                г = рп.г
                пусть знач = "v." + рп.к
                если г.собственные.содержит(п.т) {
                    пусть р = значимый(г, п.т)
                    г = р.г
                    строки.добавить("    " + р.к + "_strb(" + знач + ", b);")
                } иначе если типы.это_необяз(п.т) и г.собственные.содержит(типы.основа(п.т)) {
                    пусть ро = значимый(г, п.т)
                    пусть рз = значимый(ро.г, типы.основа(п.т))
                    г = рз.г
                    пусть о = ро.к
                    строки.добавить("    if (" + о + "_has(" + знач + ")) " + рз.к + "_strb(" + о + "_val(" + знач + "), b); "
                        + "else dan_buf_add(b, " + ничего_c + ");")
                } иначе {
                    пусть р = строка_элемента(г, п.т)
                    г = р.г
                    строки.добавить("    dan_buf_add(b, " + р.к + "(" + знач + "));")
                }
                номер += 1
            }
            строки.добавить("    dan_buf_add(b, \")\");")
            строки.добавить("}")
            строки.добавить("static dan_str " + имя_ + "_str(" + имя_ + " v) { dan_buf b = { NULL, 0, 0 }; " + имя_
                + "_strb(v, &b); return dan_buf_str(&b); }")
            если сравнимый(г, т) {
                перем части: [стр] = []
                для п в поля {
                    пусть рп = поле_c(г, т, п.имя)
                    пусть рр = равенство(рп.г, п.т)
                    г = рр.г
                    части.добавить(подставить(рр.к, "a." + рп.к, "b." + рп.к))
                }
                строки.добавить("static bool " + имя_ + "_eq(" + имя_ + " a, " + имя_ + " b) { " + проверка_ + "return "
                    + части.соединить(" && ") + "; }")
            }
        }
        строки.добавить("static void " + имя_ + "_write(" + имя_ + " v) { fputs(" + имя_ + "_str(v), stdout); }")
        если не куча(г, т) { продолжить }
        если по_ссылке(г, т) {
            // необязательное значение рекурсивного типа: неизменяемая ячейка
            пусть о = типы.основа(т)
            пусть рт = тип_c(г, о)
            пусть ро = отпустить(рт.г, о)
            г = ро.г
            перем освободить = ""
            если ро.к != "" {
                пусть р = отпустить(г, о)
                г = р.г
                освободить = р.к + "(c->v);"
            }
            строки.добавить("static void " + имя_ + "_destroy(dan_hdr *h) { " + имя_ + "_cell *c = (" + имя_ + "_cell *)(void *)h; "
                + освободить + " dan_free(c); }")
            пусть ру = учесть(г, о, "v")
            г = ру.г
            строки.добавить("static " + имя_ + " " + имя_ + "_some(" + рт.к + " v) { " + имя_ + "_cell *c = dan_alloc(sizeof *c); "
                + "dan_hdr_new(&c->h, " + имя_ + "_destroy); c->v = " + ру.к + "; return &c->v; }")
            строки.добавить("static " + имя_ + " " + имя_ + "_share(" + имя_ + " v) { if (v) dan_hdr_share(" + имя_ + "_hdr(v)); return v; }")
            строки.добавить("static void " + имя_ + "_release(" + имя_ + " v) { if (v) dan_hdr_release(" + имя_ + "_hdr(v), " + имя_
                + "_destroy); }")
            строки.добавить("static void " + имя_ + "_give(" + имя_ + " v) { if (v) dan_hdr_give(" + имя_ + "_hdr(v), " + имя_
                + "_destroy); }")
            продолжить
        }
        если типы.это_необяз(т) {
            пусть о = типы.основа(т)
            для действие в ["share", "release", "give"] {
                пусть р = учёт(г, о, действие)
                г = р.г
                если действие == "share" {
                    строки.добавить("static " + имя_ + " " + имя_ + "_share(" + имя_ + " v) { if (v.has) v.value = " + р.к
                        + "(v.value); return v; }")
                } иначе {
                    строки.добавить("static void " + имя_ + "_" + действие + "(" + имя_ + " v) { if (v.has) " + р.к + "(v.value); }")
                }
            }
            продолжить
        }
        перем проверка_ = ""
        если рекурсивные.содержит(т) { проверка_ = "DAN_STACK_CHECK(0); " }
        для действие в ["share", "release", "give"] {
            перем части: [стр] = []
            для п в г.собственные[т] {
                пусть рп = поле_c(г, т, п.имя)
                пусть рд = учёт(рп.г, п.т, действие)
                г = рд.г
                если рд.к != "" {
                    если действие == "share" {
                        части.добавить("v." + рп.к + " = " + рд.к + "(v." + рп.к + ");")
                    } иначе {
                        части.добавить(рд.к + "(v." + рп.к + ");")
                    }
                }
            }
            пусть тело = части.соединить(" ")
            если действие == "share" {
                строки.добавить("static " + имя_ + " " + имя_ + "_share(" + имя_ + " v) { " + проверка_ + тело + " return v; }")
            } иначе {
                строки.добавить("static void " + имя_ + "_" + действие + "(" + имя_ + " v) { " + проверка_ + тело + " }")
            }
        }
    }
    вернуть рк(г, строки.соединить("\n") + "\n")
}

/// Функция C, копирующая значение для другой задачи ("" - копия не нужна).
функ клон(исх: Г, т: стр) -> РК {
    перем г = исх
    если не куча(г, т) { вернуть рк(г, "") }
    если т == "стр" { вернуть рк(г, "dan_str_clone") }
    если т == "байты" { вернуть рк(г, "dan_bytes_clone") }
    если т == "длинное" { вернуть рк(г, "dan_big_clone") }
    если т == "мн" { вернуть рк(г, "dan_poly_clone") }
    если типы.это_канал(т) { вернуть рк(канал_c(г, т).г, "dan_chan_clone") }
    если типы.это_массив(т) { вернуть рк(г, "dan_arr_clone") }
    если не г.клоны.содержит(т) {
        перем имя_ = ""
        если типы.это_список(т) {
            пусть р = структура(г, т)
            г = р.г
            имя_ = р.к + "_clone"
        } иначе если типы.это_словарь(т) {
            пусть р = словарь_c(г, т)
            г = р.г
            имя_ = р.к + "_clone"
        } иначе если г.перечисления.содержит(т) {
            пусть р = перечисление_c(г, т)
            г = р.г
            имя_ = р.к + "_clone"
        } иначе {
            пусть р = значимый(г, т)
            г = р.г
            имя_ = р.к + "_clone"
        }
        г.клоны[т] = имя_
        // вложенные типы тоже понадобятся
        если типы.это_список(т) {
            г = клон(г, типы.элемент(т)).г
        } иначе если типы.это_словарь(т) {
            г = клон(г, типы.ключ_словаря(т)).г
            г = клон(г, типы.значение_словаря(т)).г
        } иначе если г.перечисления.содержит(т) {
            для в_ в г.перечисления[т] {
                для п в в_.поля { г = клон(г, п.т).г }
            }
        } иначе если типы.это_необяз(т) или типы.это_результат(т) {
            если типы.основа(т) != ПУСТО() { г = клон(г, типы.основа(т)).г }
        } иначе если г.собственные.содержит(т) {
            для п в г.собственные[т] { г = клон(г, п.т).г }
        }
    }
    вернуть рк(г, г.клоны[т])
}

функ скопировать(г: Г, т: стр, код: стр) -> РК {
    пусть р = клон(г, т)
    если р.к == "" { вернуть рк(р.г, код) }
    вернуть рк(р.г, р.к + "(" + код + ")")
}

/// Копирование значений для задач: новые значения с одним местом хранения, без таблицы временных.
функ функции_клонов(исх: Г) -> РК {
    перем г = исх
    перем объявления: [стр] = []
    перем определения_: [стр] = []
    перем обработанные: {стр: лог} = {}
    пока обработанные.длина < г.клоны.длина {
        для т в г.клоны.ключи() {
            если обработанные.содержит(т) { продолжить }
            обработанные[т] = истина
            пусть имя_ = г.клоны[т]
            пусть рт = тип_c(г, т)
            г = рт.г
            пусть т_c = рт.к
            если типы.это_список(т) {
                пусть рс = структура(г, т)
                г = рс.г
                пусть с_с = рс.к
                объявления.добавить("static " + с_с + " *" + имя_ + "(const " + с_с + " *l);")
                пусть рк_ = скопировать(г, типы.элемент(т), "l->items[i]")
                г = рк_.г
                определения_.добавить("static " + с_с + " *" + имя_ + "(const " + с_с + " *l) { " + с_с + " *r = dan_alloc(sizeof *r); "
                    + "dan_hdr_detached(&r->h); r->len = l->len; r->cap = l->len < 4 ? 4 : l->len; "
                    + "r->items = dan_alloc((size_t)r->cap * sizeof *r->items); "
                    + "for (int64_t i = 0; i < l->len; i++) r->items[i] = " + рк_.к + "; return r; }")
            } иначе если типы.это_словарь(т) {
                пусть рд = словарь_c(г, т)
                г = рд.г
                пусть д_с = рд.к
                объявления.добавить("static " + д_с + " *" + имя_ + "(const " + д_с + " *d);")
                пусть р1 = скопировать(г, типы.ключ_словаря(т), "d->keys[e]")
                пусть р2 = скопировать(р1.г, типы.значение_словаря(т), "d->vals[e]")
                г = р2.г
                определения_.добавить("static " + д_с + " *" + имя_ + "(const " + д_с + " *d) { " + д_с + " *r = " + д_с + "_new_detached(); "
                    + "for (int64_t e = 0; e < d->n; e++) if (d->alive[e]) " + д_с + "_put_raw(r, " + р1.к + ", " + р2.к + "); return r; }")
            } иначе если г.перечисления.содержит(т) {
                пусть рп = перечисление_c(г, т)
                г = рп.г
                пусть в_т = рп.к
                объявления.добавить("static " + в_т + " " + имя_ + "(" + в_т + " v);")
                перем ветви: [стр] = []
                перем номер = 0
                для в_ в г.перечисления[т] {
                    перем копии: [стр] = []
                    для п в в_.поля {
                        пусть р1 = поле_c(г, вариант_владелец(т, в_.имя), п.имя)
                        пусть р2 = поле_c(р1.г, вариант_владелец(т, в_.имя), п.имя)
                        пусть р3 = скопировать(р2.г, п.т, "v->u.v" + стр(номер) + "." + р2.к)
                        г = р3.г
                        копии.добавить("c->u.v" + стр(номер) + "." + р1.к + " = " + р3.к + ";")
                    }
                    если копии.длина > 0 { ветви.добавить("case " + стр(номер) + ": " + копии.соединить(" ") + " break;") }
                    номер += 1
                }
                определения_.добавить("static " + в_т + " " + имя_ + "(" + в_т + " v) { if (!v) return v; DAN_STACK_CHECK(0); " + в_т
                    + "_s *c = dan_alloc(sizeof *c); *c = *v; dan_hdr_detached(&c->h); switch (v->tag) { " + ветви.соединить(" ")
                    + " default: break; } return c; }")
            } иначе если типы.это_функция(т) {
                объявления.добавить("static " + т_c + " " + имя_ + "(" + т_c + " v);")
                определения_.добавить("static " + т_c + " " + имя_ + "(" + т_c + " v) { v.env = dan_env_clone(v.env); return v; }")
            } иначе если по_ссылке(г, т) {
                объявления.добавить("static " + т_c + " " + имя_ + "(" + т_c + " v);")
                пусть р = скопировать(г, типы.основа(т), "*v")
                г = р.г
                определения_.добавить("static " + т_c + " " + имя_ + "(" + т_c + " v) { if (!v) return v; DAN_STACK_CHECK(0); " + т_c
                    + "_cell *c = dan_alloc(sizeof *c); dan_hdr_detached(&c->h); c->v = " + р.к + "; return &c->v; }")
            } иначе если типы.это_результат(т) {
                пусть о = типы.основа(т)
                перем значение = ""
                если о != ПУСТО() {
                    пусть рк1 = клон(г, о)
                    г = рк1.г
                    если рк1.к != "" {
                        пусть р = скопировать(г, о, "v.value")
                        г = р.г
                        значение = "v.value = " + р.к + ";"
                    }
                }
                объявления.добавить("static " + т_c + " " + имя_ + "(" + т_c + " v);")
                определения_.добавить("static " + т_c + " " + имя_ + "(" + т_c + " v) { if (v.ok) { " + значение + " } else "
                    + "v.err = dan_str_clone(v.err); return v; }")
            } иначе если типы.это_необяз(т) {
                объявления.добавить("static " + т_c + " " + имя_ + "(" + т_c + " v);")
                пусть р = скопировать(г, типы.основа(т), "v.value")
                г = р.г
                определения_.добавить("static " + т_c + " " + имя_ + "(" + т_c + " v) { if (v.has) v.value = " + р.к + "; return v; }")
            } иначе {
                объявления.добавить("static " + т_c + " " + имя_ + "(" + т_c + " v);")
                перем поля: [стр] = []
                для п в г.собственные[т] {
                    пусть рк1 = клон(г, п.т)
                    г = рк1.г
                    если рк1.к != "" {
                        пусть р1 = поле_c(г, т, п.имя)
                        пусть р2 = поле_c(р1.г, т, п.имя)
                        пусть р3 = скопировать(р2.г, п.т, "v." + р2.к)
                        г = р3.г
                        поля.добавить("v." + р1.к + " = " + р3.к + ";")
                    }
                }
                определения_.добавить("static " + т_c + " " + имя_ + "(" + т_c + " v) { DAN_STACK_CHECK(0); " + поля.соединить(" ")
                    + " return v; }")
            }
        }
    }
    перем все = объявления
    для о в определения_ { все.добавить(о) }
    вернуть рк(г, все.соединить("\n") + "\n")
}

/// Регистрирует функции канала для типа элементов; возвращает часть имени.
функ канал_c(исх: Г, т_канала: стр) -> РК {
    перем г = исх
    пусть т = типы.элемент_канала(т_канала)
    если не г.каналы.содержит(т) {
        г.нужны_задачи = истина
        пусть р = код_типа(г, т)
        г = р.г
        г.каналы[т] = "dk_" + р.к
        г = тип_c(г, т).г
        г = тип_c(г, т + "?").г
        г = клон(г, т).г
    }
    вернуть рк(г, г.каналы[т])
}

функ функции_каналов(исх: Г) -> РК {
    перем г = исх
    перем строки: [стр] = []
    для т в г.каналы.ключи() {
        пусть имя_ = г.каналы[т]
        пусть р1 = тип_c(г, т)
        пусть р2 = тип_c(р1.г, т + "?")
        г = р2.г
        пусть т_c = р1.к
        пусть о = р2.к
        пусть ро = отпустить(г, т)
        г = ро.г
        перем освободить = "(void)p;"
        если ро.к != "" {
            пусть р = отпустить(г, т)
            г = р.г
            освободить = р.к + "(*(" + т_c + " *)p);"
        }
        пусть рд = отдать(г, т)
        г = рд.г
        перем отдать_ = ""
        если рд.к != "" {
            пусть р = отдать(г, т)
            г = р.г
            отдать_ = р.к + "(x);"
        }
        строки.добавить("static void " + имя_ + "_drop(void *p) { " + освободить + " }")
        строки.добавить("static dan_chan *" + имя_ + "_new(int64_t cap, int line) { return dan_chan_new(sizeof(" + т_c + "), cap, "
            + имя_ + "_drop, line); }")
        пусть рс = скопировать(г, т, "v")
        г = рс.г
        строки.добавить("static void " + имя_ + "_send(dan_chan *c, " + т_c + " v, int line) { " + т_c + " x = " + рс.к + "; "
            + "dan_chan_send(c, &x, line); }")
        строки.добавить("static " + о + " " + имя_ + "_recv(dan_chan *c, int line) { " + т_c + " x; if (!dan_chan_recv(c, &x, line)) "
            + "return " + о + "_none(); " + отдать_ + " return " + о + "_some(x); }")
    }
    вернуть рк(г, строки.соединить("\n") + "\n")
}

/// Структура C задачи с местом для её результата.
функ задача_c(исх: Г, т: стр) -> РК {
    перем г = исх
    пусть результат = типы.срез(т, 7, т.длина - 1)
    если не г.задачи_c.содержит(результат) {
        г.нужны_задачи = истина
        перем код = "v"
        если результат != ПУСТО() {
            пусть р = код_типа(г, результат)
            г = р.г
            код = р.к
        }
        г.задачи_c[результат] = "dz_" + код
        если результат != ПУСТО() {
            г = тип_c(г, результат).г
            г = клон(г, результат).г
        }
    }
    вернуть рк(г, г.задачи_c[результат])
}

функ определения_задач(исх: Г) -> РК {
    перем г = исх
    перем строки: [стр] = []
    для результат в г.задачи_c.ключи() {
        пусть имя_ = г.задачи_c[результат]
        если результат == ПУСТО() {
            строки.добавить("typedef struct { dan_task t; } " + имя_ + ";")
        } иначе {
            пусть р = тип_c(г, результат)
            г = р.г
            строки.добавить("typedef struct { dan_task t; " + р.к + " result; } " + имя_ + ";")
        }
    }
    вернуть рк(г, строки.соединить("\n") + "\n")
}

функ функции_задач(исх: Г) -> РК {
    перем г = исх
    перем строки: [стр] = []
    для результат в г.задачи_c.ключи() {
        пусть имя_ = г.задачи_c[результат]
        перем освободить = ""
        если результат != ПУСТО() {
            пусть р1 = отпустить(г, результат)
            г = р1.г
            если р1.к != "" {
                пусть р2 = отпустить(г, результат)
                г = р2.г
                освободить = р2.к + "(z->result);"
            }
        }
        строки.добавить("static void " + имя_ + "_end(" + имя_ + " *z, int line) { dan_task_join(&z->t, line); " + освободить + " }")
    }
    вернуть рк(г, строки.соединить("\n") + "\n")
}

функ функции_расширения(исх: Г) -> РК {
    перем г = исх
    перем строки: [стр] = []
    для ключ в г.расширения.ключи() {
        пусть пара = ключ.разбить("\t")
        пусть р1 = структура(г, пара[1])
        пусть р2 = структура(р1.г, пара[0])
        г = р2.г
        строки.добавить("static " + р1.к + " *" + г.расширения[ключ] + "(const " + р2.к + " *l, int line);")
    }
    для ключ в г.расширения.ключи() {
        пусть пара = ключ.разбить("\t")
        пусть р1 = структура(г, пара[0])
        пусть р2 = структура(р1.г, пара[1])
        г = р2.г
        пусть с_из = р1.к
        пусть с_в = р2.к
        пусть рэ = привести(г, "l->items[i]", типы.элемент(пара[0]), типы.элемент(пара[1]), "line")
        г = рэ.г
        строки.добавить("static " + с_в + " *" + г.расширения[ключ] + "(const " + с_из + " *l, int line) {\n"
            + "    (void)line;\n    " + с_в + " *r = " + с_в + "_from(0, NULL);\n"
            + "    for (int64_t i = 0; i < l->len; i++) " + с_в + "_push(r, " + рэ.к + ");\n"
            + "    return r;\n}")
    }
    вернуть рк(г, строки.соединить("\n") + "\n")
}

/// Числовое преобразование цел -> рац -> дроб, цел, рац -> мн и такое же расширение элементов списков.
функ привести(исх: Г, код: стр, из_типа: стр, в_тип: стр, строка: стр) -> РК {
    перем г = исх
    если типы.это_список(в_тип) {
        пусть р = расширение(г, из_типа, в_тип)
        вернуть рк(р.г, р.к + "(" + код + ", " + строка + ")")
    }
    если в_тип == "мн" {
        г = включить_математику(г)
        если из_типа == "цел" { вернуть рк(г, "dan_poly_from_int(" + код + ", " + строка + ")") }
        вернуть рк(г, "dan_poly_const(" + код + ")")
    }
    если в_тип == "дроб" {
        если из_типа == "рац" { вернуть рк(г, "dan_rat_to_float(" + код + ")") }
        вернуть рк(г, "((double)(" + код + "))")
    }
    если в_тип == "рац" и из_типа == "цел" { вернуть рк(г, "dan_rat_from_int(" + код + ", " + строка + ")") }
    если в_тип == "длинное" и из_типа == "цел" {
        г.нужны_длинные = истина
        вернуть рк(г, "dan_big_from_int(" + код + ")")
    }
    если в_тип == "компл" {
        г.нужны_компл = истина
        если из_типа == "рац" { вернуть рк(г, "dan_cx_make(dan_rat_to_float(" + код + "), 0)") }
        вернуть рк(г, "dan_cx_make((double)(" + код + "), 0)")
    }
    вернуть рк(г, код)
}

функ преобразование(исх: Г, куда: стр, откуда: стр, значение: стр, строка: стр) -> РК {
    перем г = исх
    если куда == откуда { вернуть рк(г, значение) }
    если куда == "дата" или откуда == "дата" {
        г.нужны_даты = истина
        если куда == "стр" { вернуть рк(г, "dan_date_to_str(" + значение + ")") }
        вернуть рк(г, "dan_date_from_str(" + значение + ", " + строка + ")")
    }
    если куда == "компл" или откуда == "компл" {
        г.нужны_компл = истина
        если куда == "стр" { вернуть рк(г, "dan_cx_to_str(" + значение + ")") }
        вернуть привести(г, значение, откуда, "компл", строка)
    }
    если куда == "длинное" или откуда == "длинное" {
        г.нужны_длинные = истина
        если куда == "длинное" {
            если откуда == "цел" { вернуть рк(г, "dan_big_from_int(" + значение + ")") }
            вернуть рк(г, "dan_big_from_str(" + значение + ", " + строка + ")")
        }
        если куда == "цел" { вернуть рк(г, "dan_big_to_int(" + значение + ", " + строка + ")") }
        если куда == "дроб" { вернуть рк(г, "dan_big_to_float(" + значение + ")") }
        вернуть рк(г, "dan_big_to_str(" + значение + ")")
    }
    если куда == "стр" и (типы.это_необяз(откуда) или г.собственные.содержит(откуда)) { вернуть в_строку(г, откуда, значение) }
    если куда == "стр" и г.перечисления.содержит(откуда) {
        пусть р = перечисление_c(г, откуда)
        вернуть рк(р.г, р.к + "_str(" + значение + ")")
    }
    если куда == "стр" и типы.это_словарь(откуда) {
        пусть р = словарь_c(г, откуда)
        вернуть рк(р.г, р.к + "_str(" + значение + ")")
    }
    если куда == "стр" и типы.это_массив(откуда) { вернуть рк(г, "dan_arr_str(" + значение + ")") }
    если куда == "стр" и типы.это_список(откуда) {
        пусть р = структура(г, откуда)
        вернуть рк(р.г, р.к + "_str(" + значение + ")")
    }
    если куда == "байты" { вернуть рк(г, "dan_bytes_from_str(" + значение + ")") }
    если откуда == "байты" { вернуть рк(г, "dan_bytes_to_str(" + значение + ")") }
    если куда == "стр" {
        выбор откуда {
            "цел" { вернуть рк(г, "dan_int_to_str(" + значение + ")") }
            "дроб" { вернуть рк(г, "dan_float_to_str(" + значение + ")") }
            "рац" { вернуть рк(г, "dan_rat_to_str(" + значение + ")") }
            "лог" { вернуть рк(г, "dan_bool_to_str(" + значение + ")") }
            иначе { вернуть рк(г, "dan_poly_to_str(" + значение + ")") }
        }
    }
    если куда == "цел" {
        если откуда == "рац" { вернуть рк(г, "dan_rat_to_int(" + значение + ")") }
        если откуда == "дроб" { вернуть рк(г, "dan_float_to_int(" + значение + ", " + строка + ")") }
        вернуть рк(г, "dan_str_to_int(" + значение + ", " + строка + ")")
    }
    если куда == "рац" {
        выбор откуда {
            "цел" { вернуть рк(г, "dan_rat_from_int(" + значение + ", " + строка + ")") }
            "дроб" { вернуть рк(г, "dan_rat_from_float(" + значение + ", " + строка + ")") }
            иначе { вернуть рк(г, "dan_rat_from_str(" + значение + ", " + строка + ")") }
        }
    }
    если откуда == "цел" { вернуть рк(г, "((double)(" + значение + "))") }
    если откуда == "рац" { вернуть рк(г, "dan_rat_to_float(" + значение + ")") }
    вернуть рк(г, "dan_str_to_float(" + значение + ", " + строка + ")")
}

// ---------- функции ----------

функ внешний_c(т: стр) -> стр {
    если т.начинается("буфер<") {
        // буфер: тот же указатель на элементы, но функция C может в них писать
        вернуть типы.срез(внешний_c("массив<" + типы.срез(т, 6, т.длина - 1) + ">"), 6, 1000)
    }
    если типы.это_массив(т) {
        выбор типы.вид_массива(т) {
            "дроб" { вернуть "const double *" }
            "дроб32" { вернуть "const float *" }
            "дроб16" { вернуть "const uint16_t *" }
            "цел" { вернуть "const int64_t *" }
            "цел32" { вернуть "const int32_t *" }
            "цел16" { вернуть "const int16_t *" }
            "цел8" { вернуть "const int8_t *" }
            иначе { вернуть "const uint8_t *" }        // байт, а также цел4 и цел2 - упакованные байты
        }
    }
    выбор т {
        "байты" { вернуть "const uint8_t *" }
        "цел" { вернуть "int64_t" }
        "цел32" { вернуть "int32_t" }
        "дроб" { вернуть "double" }
        "дроб32" { вернуть "float" }
        "лог" { вернуть "int" }
        "стр" { вернуть "const char *" }
        "стр?" { вернуть "const char *" }
        иначе { вернуть "void" }
    }
}

функ тип_дана(т: стр) -> стр {
    если т.начинается("буфер<") { вернуть "массив<" + типы.срез(т, 6, т.длина - 1) + ">" }
    если т == "цел32" { вернуть "цел" }
    если т == "дроб32" { вернуть "дроб" }
    вернуть т
}

/// Функции библиотек C: объявление под служебным именем и обёртка с типами Дана.
функ внешние_функции(исх: Г, инструкции: [разбор.Узел]) -> РК {
    перем г = исх
    для блок_ в инструкции {
        если блок_.вид != "ВнешнийБлок" { продолжить }
        если св(блок_, "библиотека") != "" { г = добавить_строку(г, "/* DAN_LINK: " + св(блок_, "библиотека") + " */") }
        для ф в гр(блок_, "функции") {
            г.счётчик += 1
            пусть служебное = "dan_ext_" + стр(г.счётчик)
            пусть рез = св(ф, "тип_результата")
            перем рез_c = "void"
            если рез != "" { рез_c = внешний_c(рез) }
            перем параметры_c: [стр] = []
            для п в гр(ф, "параметры") { параметры_c.добавить(внешний_c(св(п, "тип"))) }
            г = добавить_строку(г, "extern " + рез_c + " " + служебное + "(" + или_иначе(параметры_c.соединить(", "), "void") + ") __asm__(DAN_SYM("
                + строка_c(св(ф, "имя_c")) + "));")
            перем параметры: [стр] = []
            перем и_ = 0
            для п в гр(ф, "параметры") {
                пусть р = тип_c(г, тип_дана(св(п, "тип")))
                г = р.г
                параметры.добавить(р.к + " a" + стр(и_))
                и_ += 1
            }
            перем проверки: [стр] = []
            перем аргументы: [стр] = []
            и_ = 0
            для п в гр(ф, "параметры") {
                пусть а = "a" + стр(и_)
                выбор св(п, "тип") {
                    "цел32" {
                        проверки.добавить("if (" + а + " < INT32_MIN || " + а + " > INT32_MAX) dan_error(DAN_MSG_EXT_RANGE, " + стр(ф.строка) + ");")
                        аргументы.добавить("(int32_t)" + а)
                    }
                    "дроб32" { аргументы.добавить("(float)" + а) }
                    "лог" { аргументы.добавить("(int)" + а) }
                    "байты" { аргументы.добавить("(const uint8_t *)" + а + "->data") }
                    иначе {
                        // массив передаётся указателем на первый элемент, без копии
                        если типы.это_массив(св(п, "тип")) или св(п, "тип").начинается("буфер<") {
                            аргументы.добавить("(" + внешний_c(св(п, "тип")) + ")(const void *)" + а + "->data")
                        } иначе {
                            аргументы.добавить(а)
                        }
                    }
                }
                и_ += 1
            }
            пусть вызов = служебное + "(" + аргументы.соединить(", ") + ")"
            перем возврат = ""
            перем тип_р = ""
            если рез == "" {
                возврат = вызов + ";"
                тип_р = "void"
            } иначе если рез == "стр" {
                возврат = "const char *r = " + вызов + "; return r ? dan_strdup(r) : dan_empty_s.s;"
                тип_р = "dan_str"
            } иначе если рез == "стр?" {
                пусть р = тип_c(г, "стр?")
                г = р.г
                возврат = "const char *r = " + вызов + "; return r ? " + р.к + "_some(dan_strdup(r)) : " + р.к + "_none();"
                тип_р = р.к
            } иначе если рез == "лог" {
                возврат = "return " + вызов + " != 0;"
                тип_р = "bool"
            } иначе {
                пусть р = тип_c(г, тип_дана(рез))
                г = р.г
                тип_р = р.к
                возврат = "return (" + тип_р + ")" + вызов + ";"
            }
            пусть ри = имя_си(г, св(ф, "имя"))
            г = ри.г
            г = добавить_строку(г, "static " + тип_р + " " + ри.к + "(" + или_иначе(параметры.соединить(", "), "void") + ") { "
                + проверки.соединить(" ") + " " + возврат + " }")
        }
    }
    вернуть рк(г, "")
}

функ заголовок(исх: Г, ф: разбор.Узел) -> РК {
    перем г = исх
    перем результат = "void"
    если св(ф, "тип_результата") != "" {
        пусть р = тип_c(г, св(ф, "тип_результата"))
        г = р.г
        результат = р.к
    }
    перем параметры: [стр] = []
    для п в гр(ф, "параметры") {
        пусть р1 = тип_c(г, св(п, "тип"))
        пусть р2 = имя_си(р1.г, св(п, "имя"))
        г = р2.г
        параметры.добавить(р1.к + " const " + р2.к)
    }
    пусть ри = имя_си(г, св(ф, "имя"))
    вернуть рк(ри.г, "static " + результат + " " + ри.к + "(" + или_иначе(параметры.соединить(", "), "void") + ")")
}

/// Имя функции для отладчика и профиля: у метода - «Тип.метод».
функ показ_функции(ф: разбор.Узел) -> стр {
    пусть имя_ = св(ф, "имя")
    если св(ф, "метод_типа") != "" {
        пусть части = имя_.разбить(".")
        вернуть св(ф, "метод_типа") + "." + части[части.длина - 1]
    }
    вернуть имя_
}

функ функция(исх: Г, ф: разбор.Узел) -> Г {
    перем г = пиши(исх, "/* line " + стр(ф.строка) + " */")
    пусть рз = заголовок(г, ф)
    г = пиши(рз.г, рз.к + " {")
    г.отступ += 1
    если г.отладка {
        г = пиши(г, "__attribute__((cleanup(dan_dbg_leave))) int dan_df = dan_dbg_enter(" + строка_c(показ_функции(ф)) + ", "
            + стр(ф.строка) + ");")
        для п в гр(ф, "параметры") {
            пусть р = имя_си(г, св(п, "имя"))
            г = отладить_переменную(р.г, св(п, "имя"), р.к, св(п, "тип"))
        }
    }
    если г.профиль { г = начать_замер(г, показ_функции(ф), ф.строка) }
    если г.рекурсивные.содержит(св(ф, "имя")) { г = пиши(г, "DAN_STACK_CHECK(" + стр(ф.строка) + ");") }
    г.в_тесте = ф.текст != ""
    пусть тр = св(ф, "тип_результата")
    г.текущий_результат = тр
    г.метка_функции = "dan_fmark"
    г.области = [[]]
    г.метки_циклов = []
    перем результат = тр
    если результат == "" { результат = ПУСТО() }
    если куча_в_узле(г, ч(ф, "тело"), истина) или куча_тип(г, результат) {
        г = пиши(г, "const size_t " + г.метка_функции + " = dan_mark();")
    } иначе {
        г.метка_функции = ""      // функция не создаёт значений в памяти
    }
    перем тело = гр(ч(ф, "тело"), "инструкции")
    если г.потребляемые.содержит(св(ф, "имя")) {
        для н в 0..г.потребляемые[св(ф, "имя")].длина - 1 { тело[н] = с_пометкой(тело[н], "из_параметра") }
    }
    г = инструкции_блока(г, тело)
    если (тр == "" или тр == ПУСТО() или тр == ПУСТО() + "!") и не завершает(ч(ф, "тело")) { г = выход_из_функции(г) }
    если тр == ПУСТО() + "!" {
        пусть р = тип_c(г, тр)
        г = пиши(р.г, "return " + р.к + "_some();")
    }
    г.текущий_результат = ""
    г.отступ -= 1
    вернуть пиши(г, "}")
}

функ начать_замер(исх: Г, имя_: стр, строка: цел) -> Г {
    перем г = исх
    пусть номер = г.профиль_функции.длина
    г.профиль_функции.добавить([имя_, стр(строка)])
    вернуть пиши(г, "__attribute__((cleanup(dan_prof_leave))) dan_prof_frame dan_pf; dan_prof_enter(&dan_pf, " + стр(номер) + ");")
}

// ---------- инструкции ----------

функ блок(исх: Г, б: разбор.Узел) -> Г {
    перем г = исх
    г.отступ += 1
    г.области.добавить([])
    г = инструкции_блока(г, гр(б, "инструкции"))
    пусть область = г.области[г.области.длина - 1]
    г.области.удалить(г.области.длина - 1)
    если не завершает(б) { г = освободить_область(г, область) }
    г.отступ -= 1
    вернуть г
}

/// Кончается ли блок переходом (вернуть, прервать, продолжить).
функ завершает(б: разбор.Узел) -> лог {
    пусть инструкции = гр(б, "инструкции")
    если инструкции.длина == 0 { вернуть ложь }
    пусть вид = инструкции[инструкции.длина - 1].вид
    вернуть вид == "Вернуть" или вид == "Прервать" или вид == "Продолжить"
}

// ---------- память: места хранения и временные значения ----------

функ код_отпустить(исх: Г, имя_c: стр, т: стр) -> РК {
    если т.начинается("<группа:") {
        вернуть рк(исх, "dan_tgroup_join(&" + имя_c + ", " + типы.срез(т, 8, т.длина - 1) + ");")     // блок ждёт свои задачи
    }
    если типы.это_задача(т) {
        пусть р = задача_c(исх, т)
        вернуть рк(р.г, р.к + "_end(&" + имя_c + ", " + имя_c + ".t.line);")     // задача не переживает блок
    }
    пусть р = отпустить(исх, т)
    вернуть рк(р.г, р.к + "(" + имя_c + ");")
}

функ освободить_область(исх: Г, область: [Место]) -> Г {
    перем г = исх
    перем н = область.длина - 1
    пока н >= 0 {
        пусть р = код_отпустить(г, область[н].имя, область[н].т)
        г = пиши(р.г, р.к)
        н -= 1
    }
    вернуть г
}

/// Код C, освобождающий переменные областей начиная с номера «от».
функ код_освобождения(исх: Г, от: цел) -> РК {
    перем г = исх
    перем отданные: {стр: лог} = {}
    для имя_ в г.без_освобождения.ключи() {
        если г.имена.содержит(имя_) { отданные[г.имена[имя_]] = истина }
    }
    перем части: [стр] = []
    перем о = г.области.длина - 1
    пока о >= от {
        пусть область = г.области[о]
        перем н = область.длина - 1
        пока н >= 0 {
            если не отданные.содержит(область[н].имя) {
                пусть р = код_отпустить(г, область[н].имя, область[н].т)
                г = р.г
                части.добавить(р.к)
            }
            н -= 1
        }
        о -= 1
    }
    вернуть рк(г, части.соединить(" "))
}

функ выход_из_функции(исх: Г) -> Г {
    пусть р = код_освобождения(исх, 0)
    перем г = р.г
    если р.к != "" { г = пиши(г, р.к) }
    если г.метка_функции != "" { г = пиши(г, "dan_sweep(" + г.метка_функции + ");") }
    вернуть г
}

/// Код C возврата значения: значение переживает освобождение переменных функции.
функ код_возврата(исх: Г, код: стр, т: стр) -> РК {
    перем г = исх
    перем уборка = ""
    если г.метка_функции != "" { уборка = "dan_sweep(" + г.метка_функции + ");" }
    пусть ро = код_освобождения(г, 0)
    г = ро.г
    пусть освободить_ = ро.к
    если т == "" или т == ПУСТО() { вернуть рк(г, (освободить_ + " " + уборка + " return;").обрезать()) }
    если освободить_ == "" и уборка == "" { вернуть рк(г, "return " + код + ";") }
    пусть рр = служебное_имя(г, "ret")
    пусть ру = удержать(рр.г, т)
    пусть рд = отдать(ру.г, т)
    пусть рт = тип_c(рд.г, т)
    г = рт.г
    пусть результат = рр.к
    если ру.к == "" {
        вернуть рк(г, "{ " + рт.к + " const " + результат + " = " + код + "; " + освободить_ + " " + уборка + " return " + результат + "; }")
    }
    вернуть рк(г, "{ " + рт.к + " const " + результат + " = " + ру.к + "(" + код + "); " + освободить_ + " " + уборка + " " + рд.к
        + "(" + результат + "); return " + результат + "; }")
}

/// Группы узла, которые в Python - поля узла (а не пометки проверки).
функ поле_узла(имя_: стр) -> лог { вернуть имя_ != "значения_полей" и имя_ != "захваты" }

/// Есть ли в выражении значения, которые могут оказаться временными в памяти;
/// «глубоко» - и во вложенных блоках инструкций.
функ куча_в_узле(г: Г, у: разбор.Узел, глубоко: лог) -> лог {
    для признак в ["тип_выр", "привести_к", "в_необяз", "в_результат"] {
        пусть т = пом(у, признак)
        если т != "" и т != "ошибка" и т != "ничего" и т != "функция" и т != "диапазон" и т != ПУСТО() и куча_тип(г, т) {
            вернуть истина
        }
    }
    если у.вид == "Лямбда" { вернуть истина }
    пусть по_месту = у.вид == "Индекс" или у.вид == "Поле"
    для г_ в у.поля {
        если не поле_узла(г_.вид) или (не глубоко и г_.вид == "тело") { продолжить }
        для вложенный в г_.поля {
            если по_месту и г_.вид == "объект" и простое_имя(вложенный) { продолжить }   // чтение переменной не создаёт значений
            если вложенный.вид != "=" и куча_в_узле(г, вложенный, глубоко) { вернуть истина }
        }
    }
    вернуть ложь
}

/// Имя переменной без преобразований: его чтение не создаёт временных значений.
функ простое_имя(у: разбор.Узел) -> лог {
    вернуть у.вид == "Имя" и пом(у, "привести_к") == "" и пом(у, "в_необяз") == "" и пом(у, "в_результат") == ""
}

функ куча_список(г: Г, узлы: [разбор.Узел]) -> лог {
    для у в узлы {
        если куча_в_узле(г, у, ложь) { вернуть истина }
    }
    вернуть ложь
}

/// Создаёт ли инструкция временные значения (тогда после неё таблица временных очищается).
/// Простое имя в присваивании, объявлении, выражении или условии - только чтение переменной.
функ куча_инструкции(г: Г, и_: разбор.Узел) -> лог {
    пусть по_именам = ["ОбъявлениеПеременной", "Присваивание", "ПрисваиваниеЭлемента", "Выражение", "Если"].содержит(и_.вид)
    для у в выражения(и_) {
        если по_именам и простое_имя(у) { продолжить }
        если куча_в_узле(г, у, ложь) { вернуть истина }
    }
    вернуть ложь
}

функ куча_тип(г: Г, т: стр) -> лог { вернуть куча(г, т) }

/// Выражения, которые вычисляет сама инструкция (без вложенных блоков).
функ выражения(и_: разбор.Узел) -> [разбор.Узел] {
    выбор и_.вид {
        "ОбъявлениеПеременной" { вернуть [ч(и_, "значение")] }
        "Присваивание" { вернуть [ч(и_, "значение")] }
        "ПрисваиваниеЭлемента" { вернуть [ч(и_, "объект"), ч(и_, "индекс"), ч(и_, "значение")] }
        "ПрисваиваниеПоля" { вернуть [ч(и_, "объект"), ч(и_, "значение")] }
        "Выражение" { вернуть [ч(и_, "выражение")] }
        "Если" {
            перем итог = [ч(и_, "условие")]
            перем у = и_
            пока есть(у, "иначе") и ч(у, "иначе").вид == "Если" {
                у = ч(у, "иначе")
                итог.добавить(ч(у, "условие"))
            }
            вернуть итог
        }
        "ЕслиЕсть" { вернуть [ч(и_, "значение")] }
        "ЕслиОшибка" { вернуть [ч(и_, "значение")] }
        "Выбор" { вернуть [ч(и_, "значение")] }
        "Для" { вернуть [ч(и_, "источник")] }
        иначе { вернуть [] }
    }
}

/// В отладочной сборке переменная становится видна отладчику до конца своей области.
функ отладить_переменную(исх: Г, имя_: стр, имя_c: стр, т: стр) -> Г {
    перем г = исх
    если не г.отладка или т == "" или типы.это_задача(т) или типы.это_канал(т) или т.начинается("<") или т == ПУСТО() {
        вернуть г
    }
    если не г.отладочные_записи.содержит(т) {
        перем запись_ = "dan_write_quoted"
        если т != "стр" {
            пусть р = запись_типа(г, т, ложь)
            г = р.г
            запись_ = р.к
        }
        пусть имя_записи = "dan_dbgw_" + стр(г.отладочные_записи.длина + 1)
        пусть рт = тип_c(г, т)
        г = рт.г
        г.отладочные_записи[т] = [имя_записи, "static void " + имя_записи + "(const void *p) { " + запись_ + "(*(" + рт.к
            + " const *)p); }"]
    }
    пусть рн = служебное_имя(г, "dv")
    г = рн.г
    вернуть пиши(г, "__attribute__((cleanup(dan_dbg_unvar))) int " + рн.к + " = dan_dbg_var(" + строка_c(имя_) + ", &" + имя_c
        + ", " + г.отладочные_записи[т][0] + ");")
}

функ без_кода(вид: стр) -> лог {
    вернуть (вид == "ОбъявлениеТипа" или вид == "ОбъявлениеВариантов" или вид == "ОбъявлениеИнтерфейса" или вид == "Функция"
        или вид == "ВнешнийБлок" или вид == "Подключение")
}

// ---------- передача владения ----------
//
// Функции Дана получают копии значений, а изменённое значение возвращают («с = добавить(с, х)»).
// Чтобы такая копия не стоила копирования всего списка, параметр, который функция первым делом
// кладёт в свою переменную («перем с = исходное») и больше нигде не использует, «потребляется»:
// функция получает своё место хранения значения. Вызывающая сторона отдаёт его, если её
// переменная больше не нужна до следующего присваивания, иначе удерживает значение для функции.

функ с_пометкой(у: разбор.Узел, имя_: стр) -> разбор.Узел {
    перем новый = у
    новый.пометки[имя_] = "True"
    вернуть новый
}

/// Сколько раз имя встречается в узле как переменная (узел «Имя»).
функ сколько_имён(у: разбор.Узел, имя_: стр) -> цел {
    перем итог = 0
    если у.вид == "Имя" и у.текст == имя_ { итог = 1 }
    для г_ в у.поля {
        если не поле_узла(г_.вид) { продолжить }
        для вложенный в г_.поля {
            если вложенный.вид != "=" { итог += сколько_имён(вложенный, имя_) }
        }
    }
    вернуть итог
}

функ опасный_для_переноса(вид: стр) -> лог {
    вернуть (вид == "Передать" или вид == "Лямбда" или вид == "Запуск" или вид == "Вернуть" или вид == "Прервать"
        или вид == "Продолжить")
}

функ есть_опасный(у: разбор.Узел) -> лог {
    если опасный_для_переноса(у.вид) { вернуть истина }
    для г_ в у.поля {
        если не поле_узла(г_.вид) { продолжить }
        для вложенный в г_.поля {
            если вложенный.вид != "=" и есть_опасный(вложенный) { вернуть истина }
        }
    }
    вернуть ложь
}

функ с_приведением(у: разбор.Узел) -> лог {
    вернуть пом(у, "привести_к") != "" или пом(у, "в_необяз") != "" или пом(у, "в_результат") != ""
}

/// Параметры, которые функция сразу кладёт в свою переменную и больше не использует.
функ потребляемые(г: Г, ф: разбор.Узел) -> [Потребляемый] {
    перем имена: [стр] = []
    для п в гр(ф, "параметры") { имена.добавить(св(п, "имя")) }
    перем итог: [Потребляемый] = []
    пусть тело = ч(ф, "тело")
    для и_ в гр(тело, "инструкции") {
        если и_.вид != "ОбъявлениеПеременной" или св(и_, "изменяемая") != "True" или св(и_, "тип") != "" { прервать }
        пусть з = ч(и_, "значение")
        если з.вид != "Имя" или не имена.содержит(з.текст) или с_приведением(з) { прервать }
        пусть номер = имена.найти(з.текст)
        перем было = ложь
        для п в итог {
            если п.номер == номер { было = истина }
        }
        если было или не куча(г, пом(и_, "тип_итог")) или сколько_имён(тело, з.текст) != 1 { прервать }
        итог.добавить(Потребляемый(номер, пом(и_, "тип_итог")))
    }
    вернуть итог
}

функ инструкции_блока(исх: Г, список_: [разбор.Узел]) -> Г {
    перем г = исх
    для н в 0..список_.длина - 1 {
        перем и_ = список_[н]
        если г.потребляемые.длина > 0 {
            перем дальше: [разбор.Узел] = []
            для к в н + 1..список_.длина - 1 { дальше.добавить(список_[к]) }
            пусть р = перенести(г, и_, дальше)
            г = р.г
            и_ = р.у
        }
        г = инструкция(г, и_)
    }
    вернуть г
}

тип РУ {
    г: Г
    у: разбор.Узел
}

/// Отмечает аргументы вызова, переменные которых отдают значение функции. Переменная отдаёт
/// значение, если она получает новое значение раньше, чем её прочтут («с = добавить(с, х)»),
/// или если инструкция - «вернуть». Вызов может стоять под «!» («д = шаг(д)!»): ошибка
/// передаётся уже после вызова, когда функция взяла значение и сама его освободила, поэтому
/// выход из функции по ошибке не освобождает отданную переменную второй раз.
функ перенести(исх: Г, и_: разбор.Узел, дальше: [разбор.Узел]) -> РУ {
    перем г = исх
    перем цель = ""
    если и_.вид == "Присваивание" и св(и_, "оператор") == "=" {
        цель = св(и_, "имя")
    } иначе если (и_.вид != "ОбъявлениеПеременной" и и_.вид != "Вернуть") или не есть(и_, "значение") {
        вернуть РУ(г, и_)
    }
    пусть значение_ = ч(и_, "значение")
    перем значение = значение_
    // «ф(д)!»: внутри «!» - только сам вызов (ошибка до вызова оставила бы отданное значение без хозяина)
    если значение_.вид == "Передать" { значение = ч(значение_, "значение") }
    если есть_опасный(значение) { вернуть РУ(г, и_) }
    перем свои: {стр: лог} = {}
    если и_.вид == "Вернуть" {
        для область в г.области {
            для м в область { свои[м.имя] = истина }
        }
    }
    перем отданные: [стр] = []
    для путь в вызовы_для_переноса(г, значение, "") {
        пусть вызов = узел_по_пути(значение, путь)
        для п в г.потребляемые[ч(вызов, "функция").текст] {
            пусть арг = гр(вызов, "аргументы")[п.номер]
            если арг.вид != "Имя" или с_приведением(арг) { продолжить }
            пусть имя_ = арг.текст
            если г.без_освобождения.содержит(имя_) или сколько_имён(и_, имя_) != 1 { продолжить }
            если и_.вид == "Вернуть" {
                если не г.имена.содержит(имя_) или не свои.содержит(г.имена[имя_]) { продолжить }
            } иначе если цель != имя_ и не присваивается_дальше(имя_, дальше) {
                продолжить
            }
            отданные.добавить(путь + "/" + стр(п.номер))
            г.без_освобождения[имя_] = истина
        }
    }
    если отданные.длина == 0 { вернуть РУ(г, и_) }
    перем новое = значение
    для путь в отданные { новое = отметить_по_пути(новое, путь) }
    если значение_.вид == "Передать" { новое = разбор_с_частью(значение_, "значение", новое) }
    вернуть РУ(г, разбор_с_частью(и_, "значение", новое))
}

/// Вызовы функций программы, которые выполняются при вычислении выражения всегда: само
/// выражение и вызовы среди аргументов таких вызовов. Результат - пути к ним («/2/0» - аргумент 0
/// аргумента 2).
функ вызовы_для_переноса(г: Г, узел_: разбор.Узел, путь: стр) -> [стр] {
    перем итог: [стр] = []
    если узел_.вид != "Вызов" { вернуть итог }
    пусть ф = ч(узел_, "функция")
    если ф.вид == "Имя" и не есть(узел_, "имена") и г.потребляемые.содержит(ф.текст) {
        перем годится = истина
        для а в ["вызов_значения", "вариант", "конструктор", "библиотека", "метод_функции"] {
            если пом(узел_, а) != "" { годится = ложь }
        }
        если годится { итог.добавить(путь) }
    }
    пусть аргументы = гр(узел_, "аргументы")
    для н в 0..аргументы.длина - 1 {
        для п в вызовы_для_переноса(г, аргументы[н], путь + "/" + стр(н)) { итог.добавить(п) }
    }
    вернуть итог
}

функ шаги_пути(путь: стр) -> [цел] {
    перем итог: [цел] = []
    для ч_ в путь.разбить("/") {
        если ч_ != "" { итог.добавить(разобрать_цел(ч_) иначе 0) }
    }
    вернуть итог
}

функ узел_по_пути(узел_: разбор.Узел, путь: стр) -> разбор.Узел {
    перем у = узел_
    для н в шаги_пути(путь) { у = гр(у, "аргументы")[н] }
    вернуть у
}

/// Узел с пометкой «перенос» у аргумента по пути.
функ отметить_по_пути(узел_: разбор.Узел, путь: стр) -> разбор.Узел {
    пусть шаги = шаги_пути(путь)
    вернуть отметить_шаги(узел_, шаги, 0)
}

функ отметить_шаги(узел_: разбор.Узел, шаги: [цел], н: цел) -> разбор.Узел {
    если н == шаги.длина { вернуть с_пометкой(узел_, "перенос") }
    перем аргументы = гр(узел_, "аргументы")
    пусть прежний = аргументы[шаги[н]]
    пусть новый = отметить_шаги(прежний, шаги, н + 1)
    аргументы[шаги[н]] = новый
    перем итог = разбор_с_группой(узел_, "аргументы", аргументы)
    если есть(узел_, "значения_полей") {
        // значения полей конструктора - те же узлы, что аргументы
        перем значения = гр(узел_, "значения_полей")
        для к в 0..значения.длина - 1 {
            если (значения[к].строка == прежний.строка и значения[к].столбец == прежний.столбец
                    и значения[к].вид == прежний.вид) {
                значения[к] = новый
            }
        }
        итог = разбор_с_группой(итог, "значения_полей", значения)
    }
    вернуть итог
}

/// Получает ли переменная новое значение раньше, чем её прочтут или покинут блок.
функ присваивается_дальше(имя_: стр, дальше: [разбор.Узел]) -> лог {
    для с в дальше {
        если (с.вид != "ОбъявлениеПеременной" и с.вид != "Присваивание" и с.вид != "Выражение") или есть_опасный(с) {
            вернуть ложь
        }
        если с.вид == "Присваивание" и св(с, "имя") == имя_ {
            вернуть св(с, "оператор") == "=" и сколько_имён(с, имя_) == 0
        }
        если сколько_имён(с, имя_) > 0 { вернуть ложь }
    }
    вернуть ложь
}

функ инструкция(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    если г.строки_дан и и_.строка > 0 и не без_кода(и_.вид) и частное(и_.строка, 1000000) < г.файлы_программы.длина {
        г = пиши(г, "#line " + стр(и_.строка % 1000000) + " " + строка_c(г.файлы_программы[частное(и_.строка, 1000000)]))
    }
    если г.отладка и и_.строка > 0 и не без_кода(и_.вид) { г = пиши(г, "dan_dbg_line(" + стр(и_.строка) + ");") }
    если (г.покрытие и не г.в_тесте и и_.строка > 0 и не без_кода(и_.вид)
            и не г.файлы_библиотеки.содержит(частное(и_.строка, 1000000))) {
        г = пиши(г, "dan_cov[" + стр(г.покрытие_строки.длина) + "] = 1;")
        г.покрытие_строки.добавить(и_.строка)
    }
    перем метка = ""
    если куча_инструкции(г, и_) {
        пусть р = служебное_имя(г, "m")
        г = пиши(р.г, "const size_t " + р.к + " = dan_mark();")
        метка = р.к
    }
    выбор и_.вид {
        "ОбъявлениеПеременной" { г = и_объявление(г, и_) }
        "Присваивание" { г = и_присваивание(г, и_) }
        "ПрисваиваниеЭлемента" { г = и_присваивание_элемента(г, и_) }
        "ПрисваиваниеПоля" { г = и_присваивание_поля(г, и_) }
        "Выбор" { г = и_выбор(г, и_) }
        "ЕслиЕсть" { г = и_если_есть(г, и_) }
        "ЕслиОшибка" { г = и_если_ошибка(г, и_) }
        "Выражение" { г = и_выражение(г, и_) }
        "Параллельно" { г = и_параллельно(г, и_) }
        "Приближённо" {
            г.приближённо += 1
            г = пиши(г, "{")
            г = блок(г, ч(и_, "тело"))
            г = пиши(г, "}")
            г.приближённо -= 1
        }
        "Если" { г = и_если(г, и_, ложь) }
        "Пока" { г = и_пока(г, и_) }
        "Для" { г = и_для(г, и_) }
        "Вернуть" { г = и_вернуть(г, и_) }
        "Прервать" { г = пиши(выход_из_шага(г), "break;") }
        "Продолжить" { г = пиши(выход_из_шага(г), "continue;") }
        иначе { }
    }
    если метка != "" { г = пиши(г, "dan_sweep(" + метка + ");") }
    вернуть г
}

функ итоговый_тип(у: разбор.Узел) -> стр {
    если пом(у, "в_результат") != "" { вернуть пом(у, "в_результат") }
    если пом(у, "в_необяз") != "" { вернуть пом(у, "в_необяз") }
    если пом(у, "привести_к") != "" { вернуть пом(у, "привести_к") }
    вернуть тип_выр(у)
}

функ с_готовым(у: разбор.Узел, код: стр) -> разбор.Узел {
    перем новый = у
    новый.пометки["готовый_код"] = код
    вернуть новый
}

/// Код запуска задачи: значения для вызова вычисляются здесь, копии получает задача.
функ запуск_задачи(исх: Г, запуск: разбор.Узел, задача: стр, результат: стр) -> Г {
    перем г = исх
    г.нужны_задачи = истина
    перем вызов = ч(запуск, "вызов")
    перем значения = гр(вызов, "аргументы")
    перем вид_первого = ""         // откуда взято первое значение: «объект» поля или «функция»
    если ч(вызов, "функция").вид == "Поле" {
        значения.вставить(0, ч(ч(вызов, "функция"), "объект"))
        вид_первого = "объект"
    } иначе если пом(вызов, "вызов_значения") != "" {
        значения.вставить(0, ч(вызов, "функция"))
        вид_первого = "функция"
    }
    г.счётчик += 1
    пусть номер = г.счётчик
    пусть А = "dan_targs_" + стр(номер)
    перем типы_: [стр] = []
    для з в значения { типы_.добавить(итоговый_тип(з)) }
    пусть тип_результата = пом(запуск, "тип_результата")
    перем поля: [стр] = []
    для и_ в 0..типы_.длина - 1 {
        пусть р = тип_c(г, типы_[и_])
        г = р.г
        поля.добавить(р.к + " a" + стр(и_) + ";")
    }
    // функция задачи: вызов с полученными копиями
    пусть сохр_строки = сохранить_строки(г)
    пусть сохр_отступ = г.отступ
    пусть сохр_результат = г.текущий_результат
    пусть сохр_области = г.области
    пусть сохр_метка = г.метка_функции
    пусть сохр_циклы = г.метки_циклов
    пусть сохр_группы = г.группы
    г = с_новыми_строками(г)
    г.отступ = 1
    г.текущий_результат = ""
    г.области = [[]]
    г.метка_функции = "dan_fmark"
    г.метки_циклов = []
    г.группы = []
    перем готовый = вызов
    перем аргументы = гр(вызов, "аргументы")
    перем сдвиг = 0
    если вид_первого != "" { сдвиг = 1 }
    перем значения_полей = гр(вызов, "значения_полей")
    для и_ в 0..аргументы.длина - 1 {
        пусть прежний = аргументы[и_]
        аргументы[и_] = с_готовым(прежний, "a->a" + стр(и_ + сдвиг))
        для к в 0..значения_полей.длина - 1 {
            если (значения_полей[к].строка == прежний.строка и значения_полей[к].столбец == прежний.столбец
                    и значения_полей[к].вид == прежний.вид) {
                значения_полей[к] = аргументы[и_]
            }
        }
    }
    готовый = разбор_с_группой(готовый, "аргументы", аргументы)
    если значения_полей.длина > 0 { готовый = разбор_с_группой(готовый, "значения_полей", значения_полей) }
    если вид_первого == "объект" {
        пусть поле = ч(готовый, "функция")
        готовый = разбор_с_частью(готовый, "функция", разбор_с_частью(поле, "объект", с_готовым(ч(поле, "объект"), "a->a0")))
    } иначе если вид_первого == "функция" {
        готовый = разбор_с_частью(готовый, "функция", с_готовым(ч(готовый, "функция"), "a->a0"))
    }
    г = пиши(г, А + " *a = p;")
    г = пиши(г, "dan_task_begin(a->task);")
    г = пиши(г, "{")
    г = пиши(г, "    const size_t " + г.метка_функции + " = dan_mark();")
    пусть рв = выр(г, готовый)
    г = рв.г
    если тип_результата == ПУСТО() или тип_результата == "" {
        г = пиши(г, "    " + рв.к + ";")
    } иначе {
        пусть рт = тип_c(г, тип_результата)
        г = пиши(рт.г, "    " + рт.к + " const r = " + рв.к + ";")
        пусть рс = скопировать(г, тип_результата, "r")
        г = пиши(рс.г, "    if (a->out) *a->out = " + рс.к + ";")
    }
    г = пиши(г, "    dan_sweep(" + г.метка_функции + ");")
    г = пиши(г, "}")
    для и_ в 0..типы_.длина - 1 {
        пусть р = отпустить(г, типы_[и_])
        г = р.г
        если р.к != "" {
            пусть р2 = отпустить(г, типы_[и_])
            г = пиши(р2.г, р2.к + "(a->a" + стр(и_) + ");")
        }
    }
    г = пиши(г, "dan_task *t = a->task;")
    г = пиши(г, "dan_free(a);")
    г = пиши(г, "dan_task_end(t);")
    г = пиши(г, "return DAN_THREAD_RETURN;")
    пусть тело = все_строки(г)
    г = восстановить_строки(г, сохр_строки)
    г.отступ = сохр_отступ
    г.текущий_результат = сохр_результат
    г.области = сохр_области
    г.метка_функции = сохр_метка
    г.метки_циклов = сохр_циклы
    г.группы = сохр_группы
    перем выход = ""
    если тип_результата != ПУСТО() и тип_результата != "" {
        пусть рт = тип_c(г, тип_результата)
        г = рт.г
        выход = " " + рт.к + " *out;"
    }
    г.лямбды_код.добавить("typedef struct { dan_task *task;" + выход + " " + поля.соединить(" ") + " } " + А + ";")
    г.лямбды_код.добавить("static DAN_THREAD_FN dan_task_entry_" + стр(номер) + "(void *p) {")
    для с в тело { г.лямбды_код.добавить(с) }
    г.лямбды_код.добавить("}")
    // запуск в текущей функции
    перем присвоения: [стр] = []
    для и_ в 0..значения.длина - 1 {
        пусть рв2 = выр(г, значения[и_])
        пусть рс = скопировать(рв2.г, типы_[и_], рв2.к)
        г = рс.г
        присвоения.добавить("a->a" + стр(и_) + " = " + рс.к + ";")
    }
    перем выход2 = ""
    если тип_результата != ПУСТО() и тип_результата != "" { выход2 = " a->out = " + или_иначе(результат, "NULL") + ";" }
    вернуть пиши(г, "{ " + А + " *a = dan_alloc(sizeof *a); a->task = " + задача + ";" + выход2 + " " + присвоения.соединить(" ")
        + " dan_task_start(a->task, dan_task_entry_" + стр(номер) + ", a, " + стр(запуск.строка) + "); }")
}

функ разбор_с_группой(у: разбор.Узел, имя_: стр, содержимое: [разбор.Узел]) -> разбор.Узел {
    перем новый = у
    перем группы: [разбор.Узел] = []
    перем найдена = ложь
    для г_ в у.поля {
        если г_.вид == имя_ {
            группы.добавить(разбор.группа(имя_, содержимое))
            найдена = истина
        } иначе {
            группы.добавить(г_)
        }
    }
    если не найдена { группы.добавить(разбор.группа(имя_, содержимое)) }
    новый.поля = группы
    вернуть новый
}

функ разбор_с_частью(у: разбор.Узел, имя_: стр, часть: разбор.Узел) -> разбор.Узел {
    вернуть разбор_с_группой(у, имя_, [часть])
}

функ и_объявление(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть значение = ч(и_, "значение")
    пусть т = пом(и_, "тип_итог")
    если значение.вид == "Запуск" {
        пусть ри = имя_си(г, св(и_, "имя"))
        пусть рз = задача_c(ри.г, т)
        г = пиши(рз.г, рз.к + " " + ри.к + ";")
        перем результат = "&" + ри.к + ".result"
        если пом(значение, "тип_результата") == ПУСТО() { результат = "" }
        г = запуск_задачи(г, значение, "&" + ри.к + ".t", результат)
        г.области[г.области.длина - 1].добавить(Место(ри.к, т))
        вернуть г
    }
    перем модификатор = " const"
    если св(и_, "изменяемая") == "True" { модификатор = "" }
    пусть рв = выр(г, значение)
    перем рс = рк(рв.г, рв.к)                 // функция получила своё место хранения значения
    если пом(и_, "из_параметра") == "" { рс = учесть(рв.г, т, рв.к) }
    пусть рт = тип_c(рс.г, т)
    пусть ри = имя_си(рт.г, св(и_, "имя"))
    г = пиши(ри.г, рт.к + модификатор + " " + ри.к + " = " + рс.к + ";")
    если куча(г, т) {
        пусть р = имя_си(г, св(и_, "имя"))
        г = р.г
        г.области[г.области.длина - 1].добавить(Место(р.к, т))
    }
    пусть р = имя_си(г, св(и_, "имя"))
    вернуть отладить_переменную(р.г, св(и_, "имя"), р.к, т)
}

/// Новое значение в месте хранения: сначала оно получает место, затем прежнее его теряет.
функ заменить(исх: Г, место_: стр, значение: стр, т: стр) -> Г {
    перем г = исх
    если не куча(г, т) { вернуть пиши(г, место_ + " = " + значение + ";") }
    пусть рп = служебное_имя(г, "old")
    пусть рт = тип_c(рп.г, т)
    пусть ру = удержать(рт.г, т)
    пусть ро = отпустить(ру.г, т)
    вернуть пиши(ро.г, "{ " + рт.к + " " + рп.к + " = " + место_ + "; " + место_ + " = " + ру.к + "(" + значение + "); " + ро.к + "("
        + рп.к + "); }")
}

функ и_присваивание(исх: Г, и_: разбор.Узел) -> Г {
    пусть рц = имя_си(исх, св(и_, "имя"))
    пусть рв = выр(рц.г, ч(и_, "значение"))
    перем г = рв.г
    если св(и_, "оператор") == "=" и г.без_освобождения.содержит(св(и_, "имя")) {
        г.без_освобождения.удалить(св(и_, "имя"))          // прежнее значение уже отдано функции
        пусть р = учесть(г, пом(и_, "тип_цели"), рв.к)
        вернуть пиши(р.г, рц.к + " = " + р.к + ";")
    }
    если св(и_, "оператор") == "=" { вернуть заменить(г, рц.к, рв.к, пом(и_, "тип_цели")) }
    если г.шаги_пока.содержит(св(и_, "имя")) {
        // шаг цикла «пока» (единственное присваивание переменной в теле, на верхнем уровне тела)
        пусть флаг = г.шаги_пока[св(и_, "имя")]
        пусть ра = арифметика(г, типы.срез(св(и_, "оператор"), 0, 1), рц.к, рв.к, пом(и_, "тип_результата"), стр(и_.строка), и_)
        г = ра.г
        // после шага переменная за пределами, доказанными для обращений до него
        г = забыть_пока_имя(г, св(и_, "имя"))
        вернуть пиши(г, рц.к + " = " + флаг + " ? " + рц.к + " " + типы.срез(св(и_, "оператор"), 0, 1) + " " + рв.к + " : " + ра.к + ";")
    }
    если г.накопители.содержит(св(и_, "имя")) и (св(и_, "оператор") == "+=" или св(и_, "оператор") == "-=") {
        // накопитель цикла: пределы проверены до цикла
        пусть флаг = г.накопители[св(и_, "имя")].разбить("\t")[1]
        пусть ра = арифметика(г, типы.срез(св(и_, "оператор"), 0, 1), рц.к, рв.к, пом(и_, "тип_результата"), стр(и_.строка), и_)
        вернуть пиши(ра.г, рц.к + " = " + флаг + " ? " + рц.к + " " + типы.срез(св(и_, "оператор"), 0, 1) + " " + рв.к + " : " + ра.к + ";")
    }
    пусть ра = арифметика(г, типы.срез(св(и_, "оператор"), 0, 1), рц.к, рв.к, пом(и_, "тип_результата"), стр(и_.строка), и_)
    вернуть заменить(ра.г, рц.к, ра.к, пом(и_, "тип_цели"))
}

/// Имя корня записи «з.п[и].к» или "" (корень - не имя).
функ имя_корня_шага(у: разбор.Узел) -> стр {
    если у.вид == "Имя" { вернуть у.текст }
    если (у.вид == "Индекс" или у.вид == "Поле") и не это_группа_полей(у) { вернуть имя_корня_шага(ч(у, "объект")) }
    вернуть ""
}

/// м[а..б] = х: место получает свою копию (если значение хранится и в других местах), границы
/// проверяются как у части, длины должны совпасть. Массив копируется одним memmove (перекрытие
/// источника и приёмника допустимо), список - поэлементно с учётом мест элементов.
функ записать_часть(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть т = тип_выр(ч(и_, "объект"))
    пусть индекс = ч(и_, "индекс")
    пусть стр_ = стр(и_.строка)
    пусть ро = служебное_имя(г, "part")
    пусть ра = служебное_имя(ро.г, "a")
    пусть рб = служебное_имя(ра.г, "b")
    пусть рз = служебное_имя(рб.г, "v")
    г = рз.г
    г = пиши(г, "{")
    г.отступ += 1
    пусть рм = место(г, ч(и_, "объект"))
    г = рм.г
    перем структура_ = "dan_arr"
    если типы.это_массив(т) {
        г.нужны_массивы = истина
        г = пиши(г, "dan_arr *const " + ро.к + " = dan_arr_mut(&" + рм.к + ");")
    } иначе {
        пусть рс = структура(г, т)
        г = рс.г
        структура_ = рс.к
        г = пиши(г, структура_ + "* const " + ро.к + " = " + структура_ + "_mut(&" + рм.к + ");")
    }
    пусть рн = выр(г, ч(индекс, "начало"))
    г = пиши(рн.г, "const int64_t " + ра.к + " = " + рн.к + ";")
    пусть рк_ = выр(г, ч(индекс, "конец"))
    г = пиши(рк_.г, "const int64_t " + рб.к + " = " + рк_.к + ";")
    пусть рв = выр(г, ч(и_, "значение"))
    г = рв.г
    если типы.это_массив(т) {
        г = пиши(г, "dan_arr_put(" + ро.к + ", " + ра.к + ", " + рб.к + ", " + рв.к + ", " + стр_ + ");")
    } иначе {
        г = пиши(г, структура_ + " *const " + рз.к + " = " + рв.к + ";")
        г = пиши(г, "if (" + ра.к + " < 0 || " + ра.к + " > " + ро.к + "->len) dan_index_error(" + ра.к + ", " + ро.к + "->len, "
            + стр_ + ");")
        г = пиши(г, "if (" + рб.к + " < " + ра.к + " - 1 || " + рб.к + " >= " + ро.к + "->len) dan_index_error(" + рб.к + ", "
            + ро.к + "->len, " + стр_ + ");")
        г = пиши(г, "if (" + рб.к + " - " + ра.к + " + 1 != " + рз.к + "->len) { char _m[200]; snprintf(_m, sizeof _m, "
            + "\"в часть из %lld элементов записывается %lld: длины должны совпадать\", (long long)(" + рб.к + " - " + ра.к
            + " + 1), (long long)" + рз.к + "->len); dan_error(_m, " + стр_ + "); }")
        г = пиши(г, "if (" + рз.к + " != " + ро.к + ") for (int64_t _k = 0; _k < " + рз.к + "->len; _k++) " + структура_
            + "_set(" + ро.к + ", " + ра.к + " + _k, " + рз.к + "->items[_k], " + стр_ + ");")
    }
    г.отступ -= 1
    вернуть пиши(г, "}")
}

функ и_присваивание_элемента(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    если пом(и_, "часть") != "" { вернуть записать_часть(г, и_) }
    если пом(и_, "словарь") != "" { вернуть присвоить_в_словарь(г, и_) }
    если пом(и_, "массив") != "" { вернуть присвоить_в_массив(г, и_) }
    пусть тип_списка = тип_выр(ч(и_, "объект"))
    пусть эл = типы.элемент(тип_списка)
    пусть флаг = флаг_границ(г, ч(и_, "объект"), ч(и_, "индекс"))
    если флаг == "" или (эл != "цел" и эл != "дроб" и эл != "лог") { вернуть присвоить_элемент(г, и_) }
    // границы доказаны до цикла, список там же сделан собственным: запись прямо в элемент
    // (элемент без счёта мест); иначе - как обычно, с проверкой
    пусть рм = место(г, ч(и_, "объект"))
    пусть ри = служебное_имя(рм.г, "i")
    г = пиши(ри.г, "if (" + флаг + ") {")
    г.отступ += 1
    пусть рин = выр(г, ч(и_, "индекс"))
    г = пиши(рин.г, "const int64_t " + ри.к + " = " + рин.к + ";")
    пусть рв = выр(г, ч(и_, "значение"))
    г = рв.г
    перем значение = рв.к
    пусть элемент_ = "(" + рм.к + ")->items[" + ри.к + "]"
    если св(и_, "оператор") != "=" {
        пусть ра = арифметика(г, типы.срез(св(и_, "оператор"), 0, 1), элемент_, значение, пом(и_, "тип_результата"), стр(и_.строка), и_)
        г = ра.г
        значение = ра.к
    }
    г = пиши(г, элемент_ + " = " + значение + ";")
    г.отступ -= 1
    г = пиши(г, "} else {")
    г.отступ += 1
    г = присвоить_элемент(г, и_)
    г.отступ -= 1
    вернуть пиши(г, "}")
}

функ присвоить_элемент(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть тип_списка = тип_выр(ч(и_, "объект"))
    пусть рс = структура(г, тип_списка)
    пусть ро = служебное_имя(рс.г, "list")
    пусть ри = служебное_имя(ро.г, "i")
    г = ри.г
    пусть структура_ = рс.к
    пусть объект = ро.к
    пусть индекс = ри.к
    // список и индекс вычисляются один раз, даже при «с[ф()] += 1»
    г = пиши(г, "{")
    г.отступ += 1
    пусть рм = место(г, ч(и_, "объект"))
    г = пиши(рм.г, структура_ + "* const " + объект + " = " + структура_ + "_mut(&" + рм.к + ");")
    пусть рин = выр(г, ч(и_, "индекс"))
    г = пиши(рин.г, "const int64_t " + индекс + " = " + рин.к + ";")
    пусть рв = выр(г, ч(и_, "значение"))
    г = рв.г
    перем значение = рв.к
    если св(и_, "оператор") != "=" {
        пусть текущее = структура_ + "_get(" + объект + ", " + индекс + ", " + стр(и_.строка) + ")"
        пусть ра = арифметика(г, типы.срез(св(и_, "оператор"), 0, 1), текущее, значение, пом(и_, "тип_результата"), стр(и_.строка), и_)
        г = ра.г
        значение = ра.к
    }
    г = пиши(г, структура_ + "_set(" + объект + ", " + индекс + ", " + значение + ", " + стр(и_.строка) + ");")
    г.отступ -= 1
    вернуть пиши(г, "}")
}

/// м[и] = значение: место получает свою копию массива, если массив хранится и в других местах.
функ присвоить_в_массив(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть т = тип_выр(ч(и_, "объект"))
    пусть б = буква_массива(т)
    пусть вид = вид_массива_c(типы.вид_массива(т))
    пусть ро = служебное_имя(г, "arr")
    пусть ри = служебное_имя(ро.г, "i")
    г = ри.г
    г.нужны_массивы = истина
    г = пиши(г, "{")
    г.отступ += 1
    пусть рм = место(г, ч(и_, "объект"))
    г = пиши(рм.г, "dan_arr *const " + ро.к + " = dan_arr_mut(&" + рм.к + ");")
    пусть рин = выр(г, ч(и_, "индекс"))
    г = пиши(рин.г, "const int64_t " + ри.к + " = " + рин.к + ";")
    пусть рв = выр(г, ч(и_, "значение"))
    г = рв.г
    перем значение = рв.к
    если св(и_, "оператор") != "=" {
        пусть текущее = "dan_arr_get" + б + "(" + вид + ", " + ро.к + ", " + ри.к + ", " + стр(и_.строка) + ")"
        пусть ра = арифметика(г, типы.срез(св(и_, "оператор"), 0, 1), текущее, значение, пом(и_, "тип_результата"), стр(и_.строка), и_)
        г = ра.г
        значение = ра.к
    }
    г = пиши(г, "dan_arr_set" + б + "(" + вид + ", " + ро.к + ", " + ри.к + ", " + значение + ", " + стр(и_.строка) + ");")
    г.отступ -= 1
    вернуть пиши(г, "}")
}

/// Буква функций C для элементов массива: d - дробные виды, i - целые.
функ буква_массива(т: стр) -> стр {
    если типы.элемент_массива(т) == "дроб" { вернуть "d" }
    вернуть "i"
}

/// Номер вида элементов в среде на C (DAN_AF64 ...).
функ вид_массива_c(т: стр) -> стр {
    вернуть стр(типы.виды_массива().найти(т))
}

/// «с[к] = с.получить(к, д) + х» (также «-» и «*»), где с и к - имена, д - постоянное значение,
/// а х не упоминает с: тогда запись с ключом к создаётся со значением д, если её нет, и сразу изменяется.
функ получить_с_запасом(и_: разбор.Узел) -> лог {
    пусть з = ч(и_, "значение")
    пусть объект = ч(и_, "объект")
    пусть индекс = ч(и_, "индекс")
    если св(и_, "оператор") != "=" или объект.вид != "Имя" или индекс.вид != "Имя" { вернуть ложь }
    если з.вид != "Бинарная" или не ["+", "-", "*"].содержит(св(з, "оператор")) { вернуть ложь }
    пусть л = ч(з, "левый")
    если л.вид != "Вызов" или ч(л, "функция").вид != "Поле" { вернуть ложь }
    пусть ф = ч(л, "функция")
    пусть аргументы = гр(л, "аргументы")
    если ф.текст != "получить" или пом(л, "метод_словаря") != "get_or" или ч(ф, "объект").вид != "Имя" { вернуть ложь }
    если ч(ф, "объект").текст != объект.текст или аргументы.длина != 2 { вернуть ложь }
    если аргументы[0].вид != "Имя" или аргументы[0].текст != индекс.текст или не постоянное(аргументы[1]) { вернуть ложь }
    для узел в [з, л, аргументы[0], аргументы[1], ч(з, "правый"), индекс] {
        для а в ["привести_к", "в_необяз", "в_результат"] {
            если пом(узел, а) != "" { вернуть ложь }
        }
    }
    пусть т = пом(и_, "тип_элемента")
    если тип_выр(з) != т или тип_выр(л) != т или пом(з, "операция_даты") != "" { вернуть ложь }
    вернуть сколько_имён(ч(з, "правый"), объект.текст) == 0
}

функ присвоить_в_словарь(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть т = тип_выр(ч(и_, "объект"))
    пусть рд = словарь_c(г, т)
    пусть рс = служебное_имя(рд.г, "dict")
    пусть рк_ = служебное_имя(рс.г, "key")
    г = рк_.г
    пусть д_с = рд.к
    пусть словарь = рс.к
    пусть ключ = рк_.к
    г = пиши(г, "{")
    г.отступ += 1
    пусть рм = место(г, ч(и_, "объект"))
    г = пиши(рм.г, д_с + "* const " + словарь + " = " + д_с + "_mut(&" + рм.к + ");")
    пусть ртк = тип_c(г, типы.ключ_словаря(т))
    пусть рин = выр(ртк.г, ч(и_, "индекс"))
    г = пиши(рин.г, "const " + ртк.к + " " + ключ + " = " + рин.к + ";")
    если получить_с_запасом(и_) {
        // «с[к] = с.получить(к, д) + х»: словарь ищется один раз
        пусть з = ч(и_, "значение")
        пусть л = ч(з, "левый")
        пусть рп = служебное_имя(г, "p")
        пусть рз = выр(рп.г, гр(л, "аргументы")[1])
        пусть рт = тип_c(рз.г, пом(и_, "тип_элемента"))
        г = пиши(рт.г, рт.к + " *const " + рп.к + " = " + д_с + "_slot(" + словарь + ", " + ключ + ", " + рз.к + ");")
        пусть рх = выр(г, ч(з, "правый"))
        пусть ра = арифметика(рх.г, св(з, "оператор"), "*" + рп.к, рх.к, тип_выр(з), стр(з.строка), з)
        г = заменить(ра.г, "*" + рп.к, ра.к, пом(и_, "тип_элемента"))
        г.отступ -= 1
        вернуть пиши(г, "}")
    }
    пусть рв = выр(г, ч(и_, "значение"))
    г = рв.г
    если св(и_, "оператор") == "=" {
        г = пиши(г, д_с + "_put(" + словарь + ", " + ключ + ", " + рв.к + ");")
    } иначе {
        пусть рп = служебное_имя(г, "p")
        пусть рт = тип_c(рп.г, пом(и_, "тип_элемента"))
        г = пиши(рт.г, рт.к + " *const " + рп.к + " = " + д_с + "_at(" + словарь + ", " + ключ + ", " + стр(и_.строка) + ");")
        пусть ра = арифметика(г, типы.срез(св(и_, "оператор"), 0, 1), "*" + рп.к, рв.к, пом(и_, "тип_результата"), стр(и_.строка), и_)
        г = заменить(ра.г, "*" + рп.к, ра.к, пом(и_, "тип_элемента"))
    }
    г.отступ -= 1
    вернуть пиши(г, "}")
}

функ и_выбор(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть т = тип_выр(ч(и_, "значение"))
    пусть рз = служебное_имя(г, "sel")
    г = рз.г
    пусть значение = рз.к
    г = пиши(г, "{")
    г.отступ += 1
    пусть рт = тип_c(г, т)
    пусть рв = выр(рт.г, ч(и_, "значение"))
    г = пиши(рв.г, рт.к + " const " + значение + " = " + рв.к + ";")
    перем первая = истина
    для ветвь в гр(и_, "ветви") {
        перем условия: [стр] = []
        перем привязки: [стр] = []
        перем отладочные: [Место] = []     // привязки для отладчика: имя Дана и тип
        пусть образцы = гр(ветвь, "образцы")
        для образец в образцы {
            если г.перечисления.содержит(т) {
                пусть номер = номер_варианта(г, т, св(образец, "имя"))
                условия.добавить(значение + "->tag == " + стр(номер))
                пусть поля = г.перечисления[т][номер].поля
                пусть имена_ = гр(образец, "привязки")
                для к в 0..имена_.длина - 1 {
                    если к >= поля.длина { прервать }
                    пусть имя_п = имена_[к].простые[0].значение
                    если имя_п != "_" {
                        пусть р1 = тип_c(г, поля[к].т)
                        пусть р2 = имя_си(р1.г, имя_п)
                        пусть р3 = поле_c(р2.г, вариант_владелец(т, св(образец, "имя")), поля[к].имя)
                        г = р3.г
                        привязки.добавить(р1.к + " const " + р2.к + " = " + значение + "->u.v" + стр(номер) + "." + р3.к + ";")
                        отладочные.добавить(Место(имя_п, поля[к].т))
                    }
                }
            } иначе если образец.вид == "Диапазон" {
                пусть р1 = выр(г, ч(образец, "начало"))
                пусть р2 = выр(р1.г, ч(образец, "конец"))
                г = р2.г
                условия.добавить("(" + значение + " >= " + р1.к + " && " + значение + " <= " + р2.к + ")")
            } иначе {
                пусть р = выр(г, образец)
                г = р.г
                если т == "стр" {
                    условия.добавить("dan_str_eq(" + значение + ", " + р.к + ")")
                } иначе если т == "рац" {
                    условия.добавить("dan_rat_cmp(" + значение + ", " + р.к + ") == 0")
                } иначе {
                    условия.добавить(значение + " == " + р.к)
                }
            }
        }
        перем начало = "} else if"
        если первая { начало = "if" }
        первая = ложь
        г = пиши(г, начало + " (" + условия.соединить(" || ") + ") {")
        г.отступ += 1
        перем н = 0
        для строка_ в привязки {
            г = пиши(г, строка_)
            если образцы.длина == 1 {
                пусть р = имя_си(г, отладочные[н].имя)
                г = отладить_переменную(р.г, отладочные[н].имя, р.к, отладочные[н].т)
            }
            н += 1
        }
        г.отступ -= 1
        г = блок(г, ч(ветвь, "тело"))
    }
    если есть(и_, "иначе") {
        если первая { г = пиши(г, "{") } иначе { г = пиши(г, "} else {") }
        г = блок(г, ч(и_, "иначе"))
    }
    г = пиши(г, "}")
    г.отступ -= 1
    вернуть пиши(г, "}")
}

/// Выражение C, обозначающее место в памяти (для изменения поля или элемента).
функ место(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    если у.вид == "Имя" { вернуть имя_си(г, у.текст) }
    если у.вид == "Поле" {
        пусть р1 = место(г, ч(у, "объект"))
        пусть р2 = поле_c(р1.г, тип_выр(ч(у, "объект")), св(у, "имя"))
        вернуть рк(р2.г, р1.к + "." + р2.к)
    }
    пусть т = тип_выр(ч(у, "объект"))
    если типы.это_словарь(т) {
        пусть р1 = словарь_c(г, т)
        пусть р2 = место(р1.г, ч(у, "объект"))
        пусть р3 = выр(р2.г, ч(у, "индекс"))
        вернуть рк(р3.г, "(*" + р1.к + "_at(" + р1.к + "_mut(&" + р2.к + "), " + р3.к + ", " + стр(у.строка) + "))")
    }
    пусть р1 = структура(г, т)
    пусть р2 = место(р1.г, ч(у, "объект"))
    пусть р3 = выр(р2.г, ч(у, "индекс"))
    вернуть рк(р3.г, "(*" + р1.к + "_at(" + р1.к + "_mut(&" + р2.к + "), " + р3.к + ", " + стр(у.строка) + "))")
}

/// Индексы с действием в записи места (м[ф()].п) вычисляются заранее, от начала записи к концу:
/// пишет их объявления и возвращает запись места с готовыми индексами.
функ индексы_места_заранее(исх: Г, у: разбор.Узел) -> РУ {
    перем г = исх
    если у.вид == "Поле" {
        пусть р = индексы_места_заранее(г, ч(у, "объект"))
        вернуть РУ(р.г, разбор_с_частью(у, "объект", р.у))
    }
    если у.вид == "Индекс" {
        пусть р = индексы_места_заранее(г, ч(у, "объект"))
        г = р.г
        перем новый = разбор_с_частью(у, "объект", р.у)
        пусть инд = ч(у, "индекс")
        если с_действием(инд) {
            пусть рн = служебное_имя(г, "pi")
            пусть рт = тип_c(рн.г, итоговый_тип(инд))
            пусть рв = выр(рт.г, инд)
            г = пиши(рв.г, рт.к + " const " + рн.к + " = " + рв.к + ";")
            новый = разбор_с_частью(новый, "индекс", с_готовым(инд, рн.к))
        }
        вернуть РУ(г, новый)
    }
    вернуть РУ(г, у)
}

функ и_присваивание_поля(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть рз = служебное_имя(г, "v")
    пусть рм = служебное_имя(рз.г, "p")
    г = рм.г
    пусть значение = рз.к
    пусть место_ = рм.к
    г = пиши(г, "{")
    г.отступ += 1
    // части присваивания выполняются слева направо: индексы с действием в записи места
    // вычисляются раньше значения; само поле находится после значения
    пусть ри = индексы_места_заранее(г, ч(и_, "объект"))
    г = ри.г
    пусть рв = выр(г, ч(и_, "значение"))
    г = пиши(рв.г, "__auto_type const " + значение + " = " + рв.к + ";")
    перем поле = разбор.Узел("Поле", [разбор.Свойство("имя", св(и_, "имя"))], [разбор.группа("объект", [ри.у])],
                             и_.строка, и_.столбец)
    поле.текст = св(и_, "имя")
    пусть рт = тип_c(г, пом(и_, "тип_поля"))
    пусть рп = место(рт.г, поле)
    г = пиши(рп.г, рт.к + " *const " + место_ + " = &" + рп.к + ";")
    если св(и_, "оператор") == "=" {
        г = заменить(г, "*" + место_, значение, пом(и_, "тип_поля"))
    } иначе {
        пусть ра = арифметика(г, типы.срез(св(и_, "оператор"), 0, 1), "*" + место_, значение, пом(и_, "тип_результата"),
                              стр(и_.строка), и_)
        г = заменить(ра.г, "*" + место_, ра.к, пом(и_, "тип_поля"))
    }
    г.отступ -= 1
    вернуть пиши(г, "}")
}

функ и_если_есть(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть т = тип_выр(ч(и_, "значение"))
    пусть рв_ = служебное_имя(г, "opt")
    г = рв_.г
    пусть временное = рв_.к
    г = пиши(г, "{")
    г.отступ += 1
    пусть рт = тип_c(г, т)
    г = рт.г
    пусть тип_c_ = рт.к
    пусть рз = выр(г, ч(и_, "значение"))
    г = пиши(рз.г, "const " + тип_c_ + " " + временное + " = " + рз.к + ";")
    г = пиши(г, "if (" + тип_c_ + "_has(" + временное + ")) {")
    г.отступ += 1
    пусть ро = тип_c(г, типы.основа(т))
    пусть ри = имя_си(ро.г, св(и_, "имя"))
    г = пиши(ри.г, ро.к + " const " + ри.к + " = " + тип_c_ + "_val(" + временное + ");")
    пусть ри2 = имя_си(г, св(и_, "имя"))
    г = отладить_переменную(ри2.г, св(и_, "имя"), ри2.к, типы.основа(т))
    г.отступ -= 1
    г = блок(г, ч(и_, "тогда"))
    если св(и_, "имя_ошибки") != "" {
        г = пиши(г, "} else {")
        г.отступ += 1
        пусть рн = имя_си(г, св(и_, "имя_ошибки"))
        г = пиши(рн.г, "dan_str const " + рн.к + " = " + временное + ".err;")
        пусть рн2 = имя_си(г, св(и_, "имя_ошибки"))
        г = отладить_переменную(рн2.г, св(и_, "имя_ошибки"), рн2.к, "стр")
        г.отступ -= 1
        г = блок(г, ч(и_, "иначе"))
        г = пиши(г, "}")
    } иначе {
        г = иначе_ветвь(г, и_)
    }
    г.отступ -= 1
    вернуть пиши(г, "}")
}

функ и_если_ошибка(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть т = тип_выр(ч(и_, "значение"))
    пусть рв_ = служебное_имя(г, "res")
    г = рв_.г
    пусть временное = рв_.к
    г = пиши(г, "{")
    г.отступ += 1
    пусть рт = тип_c(г, т)
    пусть рз = выр(рт.г, ч(и_, "значение"))
    г = пиши(рз.г, "const " + рт.к + " " + временное + " = " + рз.к + ";")
    г = пиши(г, "if (!" + временное + ".ok) {")
    г.отступ += 1
    пусть рн = имя_си(г, св(и_, "имя"))
    г = пиши(рн.г, "dan_str const " + рн.к + " = " + временное + ".err;")
    пусть рн2 = имя_си(г, св(и_, "имя"))
    г = отладить_переменную(рн2.г, св(и_, "имя"), рн2.к, "стр")
    г.отступ -= 1
    г = блок(г, ч(и_, "тогда"))
    г = иначе_ветвь(г, и_)
    г.отступ -= 1
    вернуть пиши(г, "}")
}

/// Ветвь «иначе» после «если пусть»: блок или вложенное условие.
функ иначе_ветвь(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    если не есть(и_, "иначе") { вернуть пиши(г, "}") }
    г = пиши(г, "} else {")
    пусть ин = ч(и_, "иначе")
    если ин.вид == "Если" или ин.вид == "ЕслиЕсть" или ин.вид == "ЕслиОшибка" {
        г.отступ += 1
        г = инструкция(г, ин)
        г.отступ -= 1
    } иначе {
        г = блок(г, ин)
    }
    вернуть пиши(г, "}")
}

функ и_выражение(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть выр_ = ч(и_, "выражение")
    если выр_.вид == "Запуск" {
        пусть т = "задача<" + пом(выр_, "тип_результата") + ">"
        пусть рз = задача_c(г, т)
        пусть рх = служебное_имя(рз.г, "task")
        г = пиши(рх.г, "{ " + рз.к + " *" + рх.к + " = dan_alloc(sizeof *" + рх.к + ");")
        г = запуск_задачи(г, выр_, "&" + рх.к + "->t", "")
        вернуть пиши(г, "dan_tgroup_add(&" + г.группы[г.группы.длина - 1] + ", &" + рх.к + "->t); }")
    }
    пусть р = выр(г, выр_)
    вернуть пиши(р.г, р.к + ";")
}

функ и_параллельно(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    г.нужны_задачи = истина
    пусть рг = служебное_имя(г, "group")
    г = рг.г
    пусть группа = рг.к
    г = пиши(г, "{")
    г.отступ += 1
    г = пиши(г, "dan_tgroup " + группа + " = { NULL };")
    г.области.добавить([Место(группа, "<группа:" + стр(и_.строка) + ">")])
    г.группы.добавить(группа)
    г = пиши(г, "{")
    г = блок(г, ч(и_, "тело"))
    г = пиши(г, "}")
    г.группы.удалить(г.группы.длина - 1)
    пусть область = г.области[г.области.длина - 1]
    г.области.удалить(г.области.длина - 1)
    г = освободить_область(г, область)
    г.отступ -= 1
    вернуть пиши(г, "}")
}

функ и_если(исх: Г, и_: разбор.Узел, продолжение: лог) -> Г {
    перем г = исх
    перем начало = "if"
    если продолжение { начало = "} else if" }
    пусть р = выр(г, ч(и_, "условие"))
    г = пиши(р.г, начало + " (" + р.к + ") {")
    г = блок(г, ч(и_, "тогда"))
    если есть(и_, "иначе") {
        пусть ин = ч(и_, "иначе")
        если ин.вид == "Если" { вернуть и_если(г, ин, истина) }
        если ин.вид == "ЕслиЕсть" или ин.вид == "ЕслиОшибка" { вернуть иначе_ветвь(г, и_) }
        г = пиши(г, "} else {")
        г = блок(г, ин)
    }
    вернуть пиши(г, "}")
}

функ и_пока(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    // анализ диапазонов «пока и < н { ... и += шаг }»: флаги до цикла, по ним цикл раздваивается
    г.флаги_цикла = []
    г = подготовить_пока(г, и_)
    пусть флаги = г.флаги_цикла
    г.флаги_цикла = []
    пусть раздвоить = можно_раздвоить(г, флаги)
    пусть сохранённые = сохранить_строки(г)
    если раздвоить { г = начать_раздвоение(г) }
    г = цикл_пока(г, и_)
    г = забыть_пока(г, и_)
    если раздвоить { г = закончить_раздвоение(г, сохранённые, флаги) }
    вернуть г
}

функ цикл_пока(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    если куча_в_узле(г, ч(и_, "условие"), ложь) {
        // значения, созданные при проверке условия, освобождаются на каждом шаге
        г = пиши(г, "for (;;) {")
        пусть рм = служебное_имя(г, "mc")
        пусть ру = служебное_имя(рм.г, "c")
        г = пиши(ру.г, "    const size_t " + рм.к + " = dan_mark();")
        пусть рв = выр(г, ч(и_, "условие"))
        г = пиши(рв.г, "    const bool " + ру.к + " = " + рв.к + ";")
        г = пиши(г, "    dan_sweep(" + рм.к + ");")
        г = пиши(г, "    if (!" + ру.к + ") break;")
    } иначе {
        пусть рв = выр(г, ч(и_, "условие"))
        г = пиши(рв.г, "while (" + рв.к + ") {")
    }
    г = тело_цикла(г, ч(и_, "тело"))
    вернуть пиши(г, "}")
}

функ тело_цикла(исх: Г, тело: разбор.Узел) -> Г {
    перем г = исх
    перем метка = ""
    если есть_выход_из_шага(тело) {
        пусть р = служебное_имя(г, "ml")
        г = пиши(р.г, "    const size_t " + р.к + " = dan_mark();")
        метка = р.к
    }
    г.метки_циклов.добавить(МеткаЦикла(метка, г.области.длина))
    г = блок(г, тело)
    г.метки_циклов.удалить(г.метки_циклов.длина - 1)
    вернуть г
}

/// Раздваивать ли цикл по флагам анализа диапазонов: при всех флагах - копия без проверок
/// (флаги в ней заменены на 1), иначе - обычная копия (вложенные - не глубже двух уровней).
функ можно_раздвоить(г: Г, флаги: [стр]) -> лог {
    вернуть флаги.длина > 0 и г.раздвоено < 2 и не г.отладка и не г.покрытие и не г.профиль и не г.замеры
}

/// Код цикла дальше пишется отдельно (строки до него сохранены вызывающим).
функ начать_раздвоение(исх: Г) -> Г {
    перем г = с_новыми_строками(исх)
    г.раздвоено += 1
    вернуть г
}

/// Записанный отдельно цикл - дважды: «if (флаги) { без проверок } else { как был }».
функ закончить_раздвоение(исх: Г, сохранённые: СохранённыеСтроки, флаги: [стр]) -> Г {
    перем г = исх
    г.раздвоено -= 1
    пусть цикл = все_строки(г)
    г = восстановить_строки(г, сохранённые)
    г = пиши(г, "if (" + флаги.соединить(" && ") + ") {")
    для с в цикл {
        перем быстрая = с
        для ф в флаги { быстрая = быстрая.заменить(ф, "1") }
        г = добавить_строку(г, "    " + быстрая)
    }
    г = пиши(г, "} else {")
    для с в цикл { г = добавить_строку(г, "    " + с) }
    вернуть пиши(г, "}")
}

/// Есть ли в теле цикла «прервать» или «продолжить» (не во вложенных циклах).
функ есть_выход_из_шага(у: разбор.Узел) -> лог {
    если у.вид == "Прервать" или у.вид == "Продолжить" { вернуть истина }
    если у.вид == "Пока" или у.вид == "Для" или у.вид == "Лямбда" { вернуть ложь }
    для г_ в у.поля {
        если не поле_узла(г_.вид) { продолжить }
        для вложенный в г_.поля {
            если вложенный.вид != "=" и есть_выход_из_шага(вложенный) { вернуть истина }
        }
    }
    вернуть ложь
}

/// Тело цикла по диапазону из одного вызова «с.добавить(постоянное)» для списка чисел или логических
/// значений вз переменной: такой вызов, иначе пустой узел.
функ вызов_заполнения(г: Г, тело: разбор.Узел) -> разбор.Узел {
    пусть пусто = разбор.Узел("")
    если г.отладка или г.покрытие или г.профиль или г.замеры { вернуть пусто }
    пусть инструкции = гр(тело, "инструкции")
    если инструкции.длина != 1 или инструкции[0].вид != "Выражение" { вернуть пусто }
    пусть вз = ч(инструкции[0], "выражение")
    если вз.вид != "Вызов" или пом(вз, "метод") != "добавить" { вернуть пусто }
    пусть ф = ч(вз, "функция")
    пусть аргументы_ = гр(вз, "аргументы")
    если ф.вид != "Поле" или аргументы_.длина != 1 или ч(ф, "объект").вид != "Имя" { вернуть пусто }
    пусть т = тип_выр(ч(ф, "объект"))
    пусть вид_ = аргументы_[0].вид
    если (т == "[цел]" и вид_ == "ЦелоеЧисло") или (т == "[дроб]" и вид_ == "ДробноеЧисло") или (т == "[лог]" и вид_ == "Логическое") {
        вернуть вз
    }
    вернуть пусто
}

/// Заполнение списка постоянным значением: копия для изменения (если список хранится и вз других местах)
/// и запас памяти - один раз до цикла, а не на каждом шаге; значения и порядок те же.
функ заполнить_список(исх: Г, вз: разбор.Узел, число_: стр, шаг: стр) -> Г {
    перем г = исх
    пусть объект = ч(ч(вз, "функция"), "объект")
    пусть рс = структура(г, тип_выр(объект))
    пусть рм = место(рс.г, объект)
    пусть рз = выр(рм.г, гр(вз, "аргументы")[0])
    пусть рл = служебное_имя(рз.г, "fill")
    г = рл.г
    пусть л = рл.к
    г = пиши(г, "if (" + число_ + " > 0) {")
    г.отступ += 1
    г = пиши(г, рс.к + " *const " + л + " = " + рс.к + "_mut(&" + рм.к + ");")
    г = пиши(г, "if (" + число_ + " <= (uint64_t)(INT64_MAX / 16) && " + л + "->len <= INT64_MAX / 16 && " + л + "->cap - "
        + л + "->len < (int64_t)" + число_ + ") {")
    г = пиши(г, "    " + л + "->cap = " + л + "->len + (int64_t)" + число_ + ";")
    г = пиши(г, "    " + л + "->items = dan_realloc(" + л + "->items, (size_t)" + л + "->cap * sizeof *" + л + "->items);")
    г = пиши(г, "}")
    // при запасе - запись подряд (компилятор C превращает её в заполнение памяти), иначе - добавление по одному
    г = пиши(г, "if (" + л + "->cap - " + л + "->len >= (int64_t)" + число_ + ") {")
    г = пиши(г, "    for (uint64_t " + шаг + " = 0; " + шаг + " < " + число_ + "; " + шаг + "++) " + л + "->items[" + л + "->len + (int64_t)"
        + шаг + "] = " + рз.к + ";")
    г = пиши(г, "    " + л + "->len += (int64_t)" + число_ + ";")
    г = пиши(г, "} else {")
    г = пиши(г, "    for (uint64_t " + шаг + " = 0; " + шаг + " < " + число_ + "; " + шаг + "++) " + рс.к + "_push(" + л + ", " + рз.к + ");")
    г = пиши(г, "}")
    г.отступ -= 1
    вернуть пиши(г, "}")
}

функ и_для(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть рп = имя_си(г, св(и_, "переменная"))
    г = рп.г
    пусть перем_ = рп.к
    пусть источник_ = ч(и_, "источник")
    пусть т_эл = пом(и_, "тип_элемента")
    если пом(и_, "по_массиву") != "" { вернуть цикл_по_массиву(г, и_, перем_) }
    если т_эл == "" и св(и_, "параллельно") == "True" { вернуть параллельный_для(г, и_, перем_) }
    если т_эл == "" {
        пусть р1 = служебное_имя(г, "from")
        пусть р2 = служебное_имя(р1.г, "count")
        пусть р3 = служебное_имя(р2.г, "k")
        пусть р4 = выр(р3.г, ч(источник_, "начало"))
        пусть р5 = выр(р4.г, ч(источник_, "конец"))
        г = р5.г
        пусть первое = р1.к
        пусть число_ = р2.к
        пусть шаг = р3.к
        // границы вычисляются один раз до начала цикла; счёт идёт по беззнаковому номеру шага
        г = пиши(г, "{")
        г.отступ += 1
        г = пиши(г, "const int64_t " + первое + " = " + р4.к + ", " + число_ + "_last = " + р5.к + ";")
        // число шагов насыщается: у полного диапазона цел (2^64 шагов) оно не помещается в 64 бита и без
        // насыщения стало бы 0 - цикл молча не выполнялся бы, а проверка накопителей сочла бы его пустым;
        // при насыщении теряется только 2^64-й шаг, до которого счёт не доходит за разумное время
        г = пиши(г, "const uint64_t " + число_ + " = " + число_ + "_last < " + первое + " ? 0 : (uint64_t)" + число_ + "_last - (uint64_t)"
            + первое + " == UINT64_MAX ? UINT64_MAX : (uint64_t)" + число_ + "_last - (uint64_t)" + первое + " + 1;")
        пусть заполнение = вызов_заполнения(г, ч(и_, "тело"))
        если заполнение.вид == "Вызов" {
            г = заполнить_список(г, заполнение, число_, шаг)
            г.отступ -= 1
            вернуть пиши(г, "}")
        }
        г.флаги_цикла = []
        г = подготовить_диапазоны(г, и_, первое, число_ + "_last", число_, ложь)
        пусть флаги = г.флаги_цикла
        г.флаги_цикла = []
        пусть раздвоить = можно_раздвоить(г, флаги)
        пусть сохранённые = сохранить_строки(г)
        если раздвоить { г = начать_раздвоение(г) }
        г = пиши(г, "for (uint64_t " + шаг + " = 0; " + шаг + " < " + число_ + "; " + шаг + "++) {")
        г.отступ += 1
        г = пиши(г, "const int64_t " + перем_ + " = (int64_t)((uint64_t)" + первое + " + " + шаг + ");")
        г = отладить_переменную(г, св(и_, "переменная"), перем_, "цел")
        г.отступ -= 1
        г = тело_цикла(г, ч(и_, "тело"))
        г = забыть_диапазоны(г, и_)
        г = пиши(г, "}")
        если раздвоить { г = закончить_раздвоение(г, сохранённые, флаги) }
        г.отступ -= 1
        вернуть пиши(г, "}")
    }
    если пом(и_, "по_каналу") != "" { вернуть цикл_по_каналу(г, и_, перем_) }
    перем структура_ = ""
    перем источник = ""
    если пом(и_, "по_строке") != "" {
        пусть р1 = структура(г, "[стр]")
        пусть р2 = выр(р1.г, источник_)
        г = р2.г
        структура_ = р1.к
        источник = "dan_str_chars(" + р2.к + ")"
    } иначе если пом(и_, "по_словарю") != "" {
        // ключи перебираются прямо в словаре, без списка ключей: словарь на время цикла
        // получает ещё одно место, поэтому его изменение в теле цикла получит свою копию
        пусть т = тип_выр(источник_)
        пусть р1 = словарь_c(г, т)
        пусть р2 = выр(р1.г, источник_)
        пусть р3 = служебное_имя(р2.г, "dict")
        пусть р4 = служебное_имя(р3.г, "e")
        г = р4.г
        пусть D = р1.к
        пусть словарь = р3.к
        пусть номер = р4.к
        г = пиши(г, "{")
        г.отступ += 1
        г = пиши(г, D + "* const " + словарь + " = " + D + "_share(" + р2.к + ");")
        г.области.добавить([Место(словарь, т)])
        г = пиши(г, "for (int64_t " + номер + " = 0; " + номер + " < " + словарь + "->n; " + номер + "++) {")
        г.отступ += 1
        г = пиши(г, "if (!" + словарь + "->alive[" + номер + "]) continue;")
        пусть рт = тип_c(г, т_эл)
        г = пиши(рт.г, рт.к + " const " + перем_ + " = " + словарь + "->keys[" + номер + "];")
        г = отладить_переменную(г, св(и_, "переменная"), перем_, т_эл)
        г.отступ -= 1
        г = тело_цикла(г, ч(и_, "тело"))
        г = пиши(г, "}")
        пусть область = г.области[г.области.длина - 1]
        г.области.удалить(г.области.длина - 1)
        г = освободить_область(г, область)
        г.отступ -= 1
        вернуть пиши(г, "}")
    } иначе {
        пусть р1 = структура(г, тип_выр(источник_))
        пусть р2 = выр(р1.г, источник_)
        г = р2.г
        структура_ = р1.к
        источник = р2.к
    }
    пусть рс = служебное_имя(г, "list")
    пусть рн = служебное_имя(рс.г, "i")
    г = рн.г
    пусть список_ = рс.к
    пусть номер = рн.к
    г = пиши(г, "{")
    г.отступ += 1
    // цикл перебирает значение списка на момент начала
    г = пиши(г, структура_ + "* const " + список_ + " = " + структура_ + "_share(" + источник + ");")
    г.области.добавить([Место(список_, "[" + т_эл + "]")])
    г = пиши(г, "for (int64_t " + номер + " = 0; " + номер + " < " + список_ + "->len; " + номер + "++) {")
    г.отступ += 1
    пусть рт = тип_c(г, т_эл)
    г = пиши(рт.г, рт.к + " const " + перем_ + " = " + список_ + "->items[" + номер + "];")
    г = отладить_переменную(г, св(и_, "переменная"), перем_, т_эл)
    г.отступ -= 1
    г = тело_цикла(г, ч(и_, "тело"))
    г = пиши(г, "}")
    пусть область = г.области[г.области.длина - 1]
    г.области.удалить(г.области.длина - 1)
    г = освободить_область(г, область)
    г.отступ -= 1
    вернуть пиши(г, "}")
}

/// для х в м: перебираются элементы массива на момент начала цикла (массив получает ещё одно место).
функ цикл_по_массиву(исх: Г, и_: разбор.Узел, перем_: стр) -> Г {
    перем г = исх
    пусть т = тип_выр(ч(и_, "источник"))
    пусть т_эл = типы.элемент_массива(т)
    пусть р1 = выр(г, ч(и_, "источник"))
    пусть р2 = служебное_имя(р1.г, "arr")
    пусть р3 = служебное_имя(р2.г, "i")
    г = р3.г
    г.нужны_массивы = истина
    пусть м = р2.к
    пусть н = р3.к
    г = пиши(г, "{")
    г.отступ += 1
    г = пиши(г, "dan_arr *const " + м + " = dan_arr_share(" + р1.к + ");")
    г.области.добавить([Место(м, т)])
    г = пиши(г, "for (int64_t " + н + " = 0; " + н + " < " + м + "->len; " + н + "++) {")
    г.отступ += 1
    пусть рт = тип_c(г, т_эл)
    перем чтение = "dan_arr_rik(" + вид_массива_c(типы.вид_массива(т)) + ", "
    если т_эл == "дроб" { чтение = "dan_arr_rdk(" + вид_массива_c(типы.вид_массива(т)) + ", " }
    г = пиши(рт.г, рт.к + " const " + перем_ + " = " + чтение + м + ", " + н + ");")
    г = отладить_переменную(г, св(и_, "переменная"), перем_, т_эл)
    г.отступ -= 1
    г = тело_цикла(г, ч(и_, "тело"))
    г = пиши(г, "}")
    пусть область = г.области[г.области.длина - 1]
    г.области.удалить(г.области.длина - 1)
    г = освободить_область(г, область)
    г.отступ -= 1
    вернуть пиши(г, "}")
}

// ---------- анализ диапазонов: проверки, которые доказуемо не сработают ----------
//
// Цикл «для к в а..б» с телом, где список с не меняет длину, проверяет границы всех
// обращений с[к + смещение] один раз до начала цикла: если все они в границах, обращения
// идут без проверки, иначе - с проверкой, как раньше (ошибка выхода за границы случится
// на том же шаге с тем же сообщением). Целые «+», «-», «*», пределы которых известны
// при сборке (числа и переменные циклов с такими пределами), выполняются без проверки
// переполнения. Всё снимается только при строгом доказательстве: в теле нет узлов, смысл
// которых не разобран здесь (безымянные функции, задачи, «выбор» и т. п.).

// ---------- «параллельно для»: шаги на всех ядрах (пул потоков среды, sreda/yadra.c) ----------
//
// Тело становится функцией C «шаги от _b до _e»: общие переменные (проверка разрешает только числа,
// логические значения, списки чисел и массивы) передаются ей в структуре и в функции называются так же, как
// снаружи, поэтому тело порождается обычным образом. Списки и массивы, в элементы которых пишут шаги, до
// запуска становятся собственными: в шагах их счёт мест не меняется, и запись не делает копий.

/// Имена, объявленные внутри тела.
функ имена_в_теле(у: разбор.Узел, итог_: [стр]) -> [стр] {
    перем итог = итог_
    если у.вид == "ОбъявлениеПеременной" { итог.добавить(св(у, "имя")) }
    если у.вид == "Для" { итог.добавить(св(у, "переменная")) }
    для д в у.поля { итог = имена_в_теле(д, итог) }
    вернуть итог
}

/// Общие переменные тела: имя -> тип (имена вызываемых функций и постоянные не входят).
функ общие_переменные(у: разбор.Узел, свои: [стр], итог_: {стр: стр}) -> {стр: стр} {
    перем итог = итог_
    если у.вид == "Имя" {
        если не свои.содержит(у.текст) и пом(у, "константа") == "" и тип_выр(у) != "" { итог[у.текст] = тип_выр(у) }
        вернуть итог
    }
    если у.вид == "Вызов" и не это_группа_полей(у) {
        пусть ф = ч(у, "функция")
        если ф.вид == "Поле" {
            итог = общие_переменные(ч(ф, "объект"), свои, итог)
        } иначе если ф.вид != "Имя" {
            итог = общие_переменные(ф, свои, итог)
        }
        для а в гр(у, "аргументы") { итог = общие_переменные(а, свои, итог) }
        вернуть итог
    }
    для д в у.поля { итог = общие_переменные(д, свои, итог) }
    вернуть итог
}

функ параллельный_для(исх: Г, и_: разбор.Узел, перем_: стр) -> Г {
    перем г = включить_ядра(исх)
    // шаги идут в нескольких потоках: таблицы временных значений и память - свои у каждого потока
    // (DAN_TLS), ошибка в шаге останавливает программу один раз (как в задачах)
    г.нужны_задачи = истина
    пусть тело = ч(и_, "тело")
    пусть источник_ = ч(и_, "источник")
    перем свои = имена_в_теле(тело, [])
    свои.добавить(св(и_, "переменная"))
    перем общие = общие_переменные(тело, свои, {})
    // сводка: у каждой части шагов своя сумма с нуля (переменная функции шагов), итог - после цикла
    перем сводка: [стр] = []
    если св(и_, "сводка") != "" { сводка = св(и_, "сводка").разбить(",") }
    для имя в сводка { если общие.содержит(имя) { общие.удалить(имя) } }
    пусть рф = служебное_имя(г, "par")
    г = рф.г
    пусть имя_ = рф.к
    перем поля: [стр] = ["int64_t from;"]
    перем значения: [стр] = []
    перем объявления: [стр] = []
    перем н = 0
    перем типы_сводки: [стр] = []
    если сводка.длина > 0 {
        поля.добавить("uint64_t count, parts;")
        значения.добавить("_count")
        значения.добавить("_np")
    }
    для имя в сводка {
        пусть т = пом(и_, "типы_сводки").разбить(",")[типы_сводки.длина]
        типы_сводки.добавить(т)
        пусть рт = тип_c(г, т)
        пусть рц = имя_си(рт.г, имя)
        г = рц.г
        поля.добавить(рт.к + " *s" + стр(типы_сводки.длина - 1) + ";")
        значения.добавить("_sv" + стр(типы_сводки.длина - 1))
        объявления.добавить(рт.к + " " + рц.к + " = 0; (void)" + рц.к + ";")
    }
    для имя в общие.ключи() {
        пусть рт = тип_c(г, общие[имя])
        пусть рц = имя_си(рт.г, имя)
        г = рц.г
        поля.добавить(рт.к + " v" + стр(н) + ";")
        значения.добавить(рц.к)
        объявления.добавить(рт.к + " " + рц.к + " = _c->v" + стр(н) + "; (void)" + рц.к + ";")
        н += 1
    }
    // функция шагов
    пусть сохранённые = сохранить_строки(г)
    пусть отступ_был = г.отступ
    г = с_новыми_строками(г)
    г.отступ = 0
    г = пиши(г, "struct " + имя_ + "_ctx { " + поля.соединить(" ") + " };")
    г = пиши(г, "static void " + имя_ + "(void *_vc, int64_t _b, int64_t _e) {")
    г.отступ = 1
    г = пиши(г, "struct " + имя_ + "_ctx *const _c = (struct " + имя_ + "_ctx *)_vc;")
    // поток пула: граница стека для проверки глубины рекурсии (стек потока не меньше 512 КБ)
    г = пиши(г, "if (!dan_stack_base) { char _here; dan_stack_base = (uintptr_t)&_here; dan_stack_limit = 384 * 1024; }")
    для о в объявления { г = пиши(г, о) }
    если сводка.длина > 0 {
        // части шагов: _c->parts частей подряд, размеры отличаются не больше чем на 1 (длиннее - первые);
        // _b.._e - номера частей, шаги частей - от _sb до _se
        г = пиши(г, "const uint64_t _q = _c->count / _c->parts, _r = _c->count % _c->parts;")
        г = пиши(г, "#define DAN_PART_START(j) ((int64_t)((uint64_t)(j) * _q + ((uint64_t)(j) < _r ? (uint64_t)(j) : _r)))")
        г = пиши(г, "const int64_t _sb = DAN_PART_START(_b), _se = DAN_PART_START(_e);")
    } иначе {
        г = пиши(г, "const int64_t _sb = _b, _se = _e;")
    }
    // анализ диапазонов для шагов от _sb до _se (как у «для»): переменная от _pf до _pl
    г = пиши(г, "const int64_t _pf = (int64_t)((uint64_t)_c->from + (uint64_t)_sb), _pl = (int64_t)((uint64_t)_c->from + (uint64_t)_se - 1);")
    г = пиши(г, "const uint64_t _pn = _se > _sb ? (uint64_t)(_se - _sb) : 0;")
    г.флаги_цикла = []
    // флаги границ и накопителей внешних циклов объявлены в другой функции C: в шагах они не видны,
    // поэтому обращения по переменным внешних циклов идут с проверкой
    пусть быстрые_были = г.быстрые_индексы
    пусть накопители_были = г.накопители
    г.быстрые_индексы = {}
    г.накопители = {}
    г = подготовить_диапазоны(г, и_, "_pf", "_pl", "_pn", истина)
    пусть флаги = г.флаги_цикла
    г.флаги_цикла = []
    пусть раздвоить = можно_раздвоить(г, флаги)
    пусть до_цикла = сохранить_строки(г)
    если раздвоить { г = начать_раздвоение(г) }
    если сводка.длина > 0 {
        г = пиши(г, "for (int64_t _j = _b; _j < _e; _j++) {")
        г.отступ += 1
        для имя в сводка {
            пусть рц = имя_си(г, имя)
            г = пиши(рц.г, рц.к + " = 0;")
        }
        г = пиши(г, "for (int64_t _i = DAN_PART_START(_j); _i < DAN_PART_START(_j + 1); _i++) {")
    } иначе {
        г = пиши(г, "for (int64_t _i = _b; _i < _e; _i++) {")
    }
    г = пиши(г, "    const int64_t " + перем_ + " = (int64_t)((uint64_t)_c->from + (uint64_t)_i);")
    пусть массивы_были = г.общие_массивы_шага
    перем массивы: [стр] = []
    для имя в общие.ключи() {
        если типы.это_массив(общие[имя]) { массивы.добавить(имя) }
    }
    г.общие_массивы_шага = массивы
    пусть общие_шага_были = г.общие_шага
    г.общие_шага = общие.ключи()
    г = тело_цикла(г, тело)
    г.общие_массивы_шага = массивы_были
    г.общие_шага = общие_шага_были
    г = забыть_диапазоны(г, и_)
    г.быстрые_индексы = быстрые_были
    г.накопители = накопители_были
    г = пиши(г, "}")
    если сводка.длина > 0 {
        для н_с в 0..сводка.длина - 1 {
            пусть рц = имя_си(г, сводка[н_с])
            г = пиши(рц.г, "_c->s" + стр(н_с) + "[_j] = " + рц.к + ";")
        }
        г.отступ -= 1
        г = пиши(г, "}")
    }
    если раздвоить { г = закончить_раздвоение(г, до_цикла, флаги) }
    если сводка.длина > 0 { г = пиши(г, "#undef DAN_PART_START") }
    г.отступ = 0
    г = пиши(г, "}")
    для с в все_строки(г) { г.лямбды_код.добавить(с) }
    г = восстановить_строки(г, сохранённые)
    г.отступ = отступ_был
    // запуск шагов на пуле потоков
    пусть р4 = выр(г, ч(источник_, "начало"))
    пусть р5 = выр(р4.г, ч(источник_, "конец"))
    г = р5.г
    г = пиши(г, "{")
    г.отступ += 1
    г = пиши(г, "const int64_t _from = " + р4.к + ", _last = " + р5.к + ";")
    // насыщение, как в обычном «для»: полный диапазон даёт ошибку «слишком большое число», а не пустой цикл
    г = пиши(г, "const uint64_t _count = _last < _from ? 0 : (uint64_t)_last - (uint64_t)_from == UINT64_MAX ? UINT64_MAX"
        + " : (uint64_t)_last - (uint64_t)_from + 1;")
    г = пиши(г, "if (_count > (uint64_t)INT64_MAX) dan_error(DAN_MSG_TOO_BIG, " + стр(и_.строка) + ");")
    для имя в общие.ключи() {
        если записывается(тело, имя) и типы.это_массив(общие[имя]) {
            // массив из файла и часть массива (ro) тоже получают свою копию: в шагах запись её не делает
            пусть рц = имя_си(г, имя)
            г = пиши(рц.г, "if (_count > 0) dan_arr_mut(&" + рц.к + ");")
        } иначе если записывается(тело, имя) {
            пусть рс = структура(г, общие[имя])
            пусть рц = имя_си(рс.г, имя)
            г = пиши(рц.г, "if (_count > 0) " + рс.к + "_mut(&" + рц.к + ");")
        }
    }
    для имя в общие.ключи() {
        если пишет_в_массив_списка(тело, имя) и типы.это_список(общие[имя]) и типы.это_массив(типы.элемент(общие[имя])) {
            // шаги пишут в массивы списка «хи[т][j] = х», каждый в свой (проверка): список и каждый его массив
            // становятся собственными до запуска, поэтому запись в шагах не делает копий и не меняет ни список,
            // ни счётчики мест (массив, лежавший в списке дважды или и в другой переменной, получает копию здесь)
            пусть рс = структура(г, общие[имя])
            пусть рц = имя_си(рс.г, имя)
            г = пиши(рц.г, "if (_count > 0) { " + рс.к + " *_lm = " + рс.к + "_mut(&" + рц.к + "); for (int64_t _q = 0; _q < _lm->len; "
                + "_q++) dan_arr_mut(&_lm->items[_q]); }")
        }
    }
    для п_ в поля_записи_шага(тело, свои, []) {
        // шаги пишут в элементы поля общей записи «н.р[к] = х» или в массивы его списка «н.кэш[к][j] = х», каждый в
        // свои (проверка): поле (и каждый массив списка) становится собственным до запуска, как общая переменная
        пусть т = тип_выр(п_)
        пусть рм = место(г, п_)
        г = рм.г
        если типы.это_массив(т) {
            г = пиши(г, "if (_count > 0) dan_arr_mut(&" + рм.к + ");")
        } иначе если типы.это_список(т) и типы.это_массив(типы.элемент(т)) {
            пусть рс = структура(г, т)
            г = пиши(рс.г, "if (_count > 0) { " + рс.к + " *_lm = " + рс.к + "_mut(&" + рм.к + "); for (int64_t _q = 0; _q < _lm->len; "
                + "_q++) dan_arr_mut(&_lm->items[_q]); }")
        } иначе {
            пусть рс = структура(г, т)
            г = пиши(рс.г, "if (_count > 0) " + рс.к + "_mut(&" + рм.к + ");")
        }
    }
    перем инициализация = "_from"
    для з в значения { инициализация = инициализация + ", " + з }
    если сводка.длина == 0 {
        г = пиши(г, "struct " + имя_ + "_ctx _cx = { " + инициализация + " };")
        г = пиши(г, "dan_pool_run((int64_t)_count, 1, " + имя_ + ", &_cx);")
        г.отступ -= 1
        вернуть пиши(г, "}")
    }
    // сводка: шаги делятся на мин(64, число шагов) частей - число частей не зависит от числа потоков;
    // суммы частей прибавляются к переменной после цикла по порядку частей
    г = пиши(г, "const uint64_t _np = _count < 64 ? _count : 64;")
    для н_с в 0..сводка.длина - 1 {
        пусть рт = тип_c(г, типы_сводки[н_с])
        г = пиши(рт.г, рт.к + " _sv" + стр(н_с) + "[64];")
    }
    г = пиши(г, "struct " + имя_ + "_ctx _cx = { " + инициализация + " };")
    г = пиши(г, "if (_np > 0) dan_pool_run((int64_t)_np, 1, " + имя_ + ", &_cx);")
    г = пиши(г, "for (uint64_t _j = 0; _j < _np; _j++) {")
    г.отступ += 1
    для н_с в 0..сводка.длина - 1 {
        пусть рц = имя_си(г, сводка[н_с])
        пусть ра = арифметика(рц.г, "+", рц.к, "_sv" + стр(н_с) + "[_j]", типы_сводки[н_с], стр(и_.строка), и_)
        г = пиши(ра.г, рц.к + " = " + ра.к + ";")
    }
    г.отступ -= 1
    г = пиши(г, "}")
    г.отступ -= 1
    вернуть пиши(г, "}")
}

/// Виды узлов, которые анализ разбирает; встреча любого другого узла отменяет снятие проверок.
функ разобранный_вид(вид: стр) -> лог {
    вернуть ["ЦелоеЧисло", "ДробноеЧисло", "Строка", "Логическое", "Имя", "Унарная", "Бинарная", "Диапазон",
        "Вызов", "Ничего", "Иначе", "Поле", "Список", "Словарь", "Индекс", "ОбъявлениеПеременной", "Присваивание",
        "ПрисваиваниеЭлемента", "ПрисваиваниеПоля", "Выражение", "Блок", "Если", "Пока", "Для", "Вернуть",
        "Прервать", "Продолжить"].содержит(вид)
}

/// Группа полей узла (вид - имя поля с маленькой буквы), а не узел дерева.
функ это_группа_полей(у: разбор.Узел) -> лог {
    пусть первая = типы.срез(у.вид, 0, 1)
    вернуть первая != "" и "абвгдеёжзийклмнопрстуфхцчшщъыьэюя".содержит(первая)
}

/// Все узлы тела разобраны анализом, и ни одно из имён не объявляется в теле заново.
функ тело_разобрано(у: разбор.Узел, имена: [стр]) -> лог {
    если у.вид == "=" или у.вид == "?" { вернуть истина }
    если не это_группа_полей(у) {
        если не разобранный_вид(у.вид) { вернуть ложь }
        если у.вид == "ОбъявлениеПеременной" и имена.содержит(св(у, "имя")) { вернуть ложь }
        если у.вид == "Для" и имена.содержит(св(у, "переменная")) { вернуть ложь }
    }
    для д в у.поля {
        если не тело_разобрано(д, имена) { вернуть ложь }
    }
    вернуть истина
}

/// Список с упоминается в теле только так, что его длина не меняется: с[...], с.длина,
/// с[...] = ...; присваивания с и вызовы методов с (и передача с куда-либо) отменяют снятие.
функ длина_не_меняется(у: разбор.Узел, с: стр) -> лог {
    если у.вид == "Имя" { вернуть у.текст != с }
    если у.вид == "Присваивание" и св(у, "имя") == с { вернуть ложь }
    если (у.вид == "Индекс" или у.вид == "Поле" или у.вид == "ПрисваиваниеЭлемента") и не это_группа_полей(у) {
        пусть о = ч(у, "объект")
        если о.вид == "Имя" и о.текст == с {
            если у.вид == "Поле" { вернуть св(у, "имя") == "длина" }
            если не длина_не_меняется(ч(у, "индекс"), с) { вернуть ложь }
            если у.вид == "ПрисваиваниеЭлемента" { вернуть длина_не_меняется(ч(у, "значение"), с) }
            вернуть истина
        }
    }
    для д в у.поля {
        если не длина_не_меняется(д, с) { вернуть ложь }
    }
    вернуть истина
}

/// Неотрицательное целое из записи числа (только цифры, не больше 9 знаков) или -1.
функ малое_число(запись: стр) -> цел {
    если запись == "" или запись.длина > 9 { вернуть -1 }
    перем итог = 0
    для з в запись.символы() {
        пусть н = "0123456789".найти(з)
        если н < 0 { вернуть -1 }
        итог = итог * 10 + н
    }
    вернуть итог
}

/// Смещение индекса от переменной цикла: «к» - 0, «к + 3», «3 + к» - 3, «к - 2» - -2;
/// для другого вида индекса - пустой список.
функ смещение_индекса(у: разбор.Узел, к: стр) -> [цел] {
    если у.вид == "Имя" и у.текст == к { вернуть [0] }
    если у.вид != "Бинарная" { вернуть [] }
    пусть оп = св(у, "оператор")
    пусть л = ч(у, "левый")
    пусть п = ч(у, "правый")
    если л.вид == "Имя" и л.текст == к и п.вид == "ЦелоеЧисло" {
        пусть ч_ = малое_число(св(п, "значение"))
        если ч_ < 0 { вернуть [] }
        если оп == "+" { вернуть [ч_] }
        если оп == "-" { вернуть [-ч_] }
    }
    если оп == "+" и п.вид == "Имя" и п.текст == к и л.вид == "ЦелоеЧисло" {
        пусть ч_ = малое_число(св(л, "значение"))
        если ч_ >= 0 { вернуть [ч_] }
    }
    вернуть []
}

/// Обращения с[к + смещение] к спискам в теле: «с» -> найденные смещения.
функ обращения_по_индексу(у: разбор.Узел, к: стр, итог_: {стр: [цел]}) -> {стр: [цел]} {
    перем итог = итог_
    если ((у.вид == "Индекс" или у.вид == "ПрисваиваниеЭлемента") и не это_группа_полей(у) и пом(у, "срез") == ""
            и пом(у, "словарь") == "") {
        пусть о = ч(у, "объект")
        если о.вид == "Имя" и типы.срез(тип_выр(о), 0, 1) == "[" и типы.срез(тип_выр(о), тип_выр(о).длина - 1, тип_выр(о).длина) == "]" {
            пусть см = смещение_индекса(ч(у, "индекс"), к)
            если см.длина == 1 {
                перем смещения = итог.получить(о.текст, [])
                если не смещения.содержит(см[0]) { смещения.добавить(см[0]) }
                итог[о.текст] = смещения
            }
        }
    }
    для д в у.поля { итог = обращения_по_индексу(д, к, итог) }
    вернуть итог
}

/// Элементы списка с записываются в теле (с[...] = ...).
функ записывается(у: разбор.Узел, с: стр) -> лог {
    если у.вид == "ПрисваиваниеЭлемента" и не это_группа_полей(у) и ч(у, "объект").вид == "Имя" и ч(у, "объект").текст == с {
        вернуть истина
    }
    для д в у.поля {
        если записывается(д, с) { вернуть истина }
    }
    вернуть ложь
}

/// Пишет ли тело в массив - элемент списка с: «с[и][j] = х», «с[и][а..б] = х», «с[и][j] += х».
функ пишет_в_массив_списка(у: разбор.Узел, с: стр) -> лог {
    если у.вид == "ПрисваиваниеЭлемента" и не это_группа_полей(у) {
        пусть о = ч(у, "объект")
        если о.вид == "Индекс" и ч(о, "объект").вид == "Имя" и ч(о, "объект").текст == с { вернуть истина }
    }
    для д в у.поля {
        если пишет_в_массив_списка(д, с) { вернуть истина }
    }
    вернуть ложь
}

/// Поле общей записи «н.п1.п2»: поля без индексов от общей переменной.
функ поле_общей_записи(у: разбор.Узел, свои: [стр]) -> лог {
    если у.вид == "Поле" и не это_группа_полей(у) {
        пусть о = ч(у, "объект")
        если о.вид == "Имя" { вернуть не свои.содержит(о.текст) }
        вернуть поле_общей_записи(о, свои)
    }
    вернуть ложь
}

функ текст_пути(у: разбор.Узел) -> стр {
    если у.вид == "Поле" { вернуть текст_пути(ч(у, "объект")) + "." + св(у, "имя") }
    вернуть у.текст
}

/// Поля общих записей, в элементы которых пишут шаги «параллельно для»: «н.р[...] = х» (узел «н.р») и
/// «н.кэш.ключи[...][...] = х» (узел списка массивов «н.кэш.ключи»), каждое один раз.
функ поля_записи_шага(у: разбор.Узел, свои: [стр], итог_: [разбор.Узел]) -> [разбор.Узел] {
    перем итог = итог_
    если у.вид == "ПрисваиваниеЭлемента" и не это_группа_полей(у) {
        перем поле = ч(у, "объект")
        если поле.вид == "Индекс" и пом(поле, "срез") == "" { поле = ч(поле, "объект") }
        если поле_общей_записи(поле, свои) {
            перем было = ложь
            для п_ в итог { если текст_пути(п_) == текст_пути(поле) { было = истина } }
            если не было { итог.добавить(поле) }
        }
    }
    для д в у.поля { итог = поля_записи_шага(д, свои, итог) }
    вернуть итог
}

/// Тип списка с по первому обращению с[...] в теле.
функ тип_списка_имени(у: разбор.Узел, с: стр) -> стр {
    если (у.вид == "Индекс" или у.вид == "ПрисваиваниеЭлемента") и не это_группа_полей(у) {
        пусть о = ч(у, "объект")
        если о.вид == "Имя" и о.текст == с { вернуть тип_выр(о) }
    }
    для д в у.поля {
        пусть т = тип_списка_имени(д, с)
        если т != "" { вернуть т }
    }
    вернуть ""
}

функ ключ_быстрого(с: стр, к: стр, смещение: цел) -> стр { вернуть с + "\t" + к + "\t" + стр(смещение) }

/// Флаг C, при котором обращение с[индекс] заведомо в границах, или "".
функ флаг_границ(г: Г, объект: разбор.Узел, индекс: разбор.Узел) -> стр {
    если г.быстрые_индексы.длина == 0 или объект.вид != "Имя" { вернуть "" }
    для ключ в г.быстрые_индексы.ключи() {
        пусть части = ключ.разбить("\t")
        если части[0] == объект.текст {
            пусть см = смещение_индекса(индекс, части[1])
            если см.длина == 1 и ключ == ключ_быстрого(части[0], части[1], см[0]) { вернуть г.быстрые_индексы[ключ] }
        }
    }
    вернуть ""
}

/// Наибольшая величина пределов, с которыми умножение заведомо не переполняется (2 000 000 000²
/// < 2⁶³), и сложение (4·10¹⁸ + 4·10¹⁸ < 2⁶³).
функ предел_умножения() -> цел { вернуть 2000000000 }
функ предел_сложения() -> цел { вернуть 4000000000000000000 }

функ в_пределах(п: [цел], м: цел) -> лог { вернуть п[0] >= -м и п[1] <= м }

/// Пределы значения целого выражения, известные при сборке: [наименьшее, наибольшее] или [].
функ пределы_выражения(г: Г, у: разбор.Узел) -> [цел] {
    если итоговый_тип(у) != "цел" или тип_выр(у) != "цел" { вернуть [] }
    если у.вид == "ЦелоеЧисло" {
        пусть ч_ = малое_число(св(у, "значение"))
        если ч_ < 0 { вернуть [] }
        вернуть [ч_, ч_]
    }
    если у.вид == "Имя" { вернуть г.пределы_имён.получить(у.текст, []) }
    если у.вид == "Унарная" и св(у, "оператор") == "-" {
        пусть п = пределы_выражения(г, ч(у, "операнд"))
        если п.длина == 2 и в_пределах(п, предел_сложения()) { вернуть [-п[1], -п[0]] }
        вернуть []
    }
    если у.вид != "Бинарная" { вернуть [] }
    пусть оп = св(у, "оператор")
    если оп == "%" {
        пусть пп = пределы_выражения(г, ч(у, "правый"))
        если пп.длина == 2 и пп[0] == пп[1] и пп[0] > 0 { вернуть [0, пп[0] - 1] }
        вернуть []
    }
    если оп != "+" и оп != "-" и оп != "*" { вернуть [] }
    пусть л = пределы_выражения(г, ч(у, "левый"))
    если л.длина != 2 { вернуть [] }
    пусть п = пределы_выражения(г, ч(у, "правый"))
    если п.длина != 2 { вернуть [] }
    если оп == "*" {
        если не в_пределах(л, предел_умножения()) или не в_пределах(п, предел_умножения()) { вернуть [] }
        пусть п1 = л[0] * п[0]
        пусть п2 = л[0] * п[1]
        пусть п3 = л[1] * п[0]
        пусть п4 = л[1] * п[1]
        вернуть [мин(мин(п1, п2), мин(п3, п4)), макс(макс(п1, п2), макс(п3, п4))]
    }
    если не в_пределах(л, предел_сложения()) или не в_пределах(п, предел_сложения()) { вернуть [] }
    если оп == "+" { вернуть [л[0] + п[0], л[1] + п[1]] }
    вернуть [л[0] - п[1], л[1] - п[0]]
}

/// Присваивания «а += х» и «а -= х» в теле: имя -> [число присваиваний, наименьшее и наибольшее
/// изменение за шаг]; [-1] - имя меняется иначе (другим присваиванием или во вложенном цикле).
функ накопления(г: Г, у: разбор.Узел, во_вложенном: лог, итог_: {стр: [цел]}) -> {стр: [цел]} {
    перем итог = итог_
    если у.вид == "Присваивание" и не это_группа_полей(у) {
        пусть имя_ = св(у, "имя")
        пусть оп = св(у, "оператор")
        пусть п = пределы_выражения(г, ч(у, "значение"))
        пусть было = итог.получить(имя_, [0, 0, 0])
        если (во_вложенном или (оп != "+=" и оп != "-=") или п.длина != 2 или пом(у, "тип_результата") != "цел"
                или пом(у, "тип_цели") != "цел" или было[0] < 0 или было[0] >= 1000 или не в_пределах(п, 1099511627776)) {
            итог[имя_] = [-1]
        } иначе {
            перем нижн = п[0]
            перем верхн = п[1]
            если оп == "-=" {
                нижн = -п[1]
                верхн = -п[0]
            }
            итог[имя_] = [было[0] + 1, было[1] + мин(нижн, 0), было[2] + макс(верхн, 0)]
        }
    }
    пусть вложенный = во_вложенном или ((у.вид == "Для" или у.вид == "Пока") и не это_группа_полей(у))
    для д в у.поля { итог = накопления(г, д, вложенный, итог) }
    вернуть итог
}

/// Перед циклом «для к в а..б»: что можно доказать для тела. Пишет флаги границ и возвращает
/// состояние со списками быстрых обращений и пределами переменной цикла. «в шагах» - тело шагов
/// «параллельно для» (часть шагов от первого до последнего): записываемые списки уже сделаны
/// собственными до запуска шагов, накопителей нет.
функ подготовить_диапазоны(исх: Г, и_: разбор.Узел, первое: стр, последнее: стр, число_: стр, в_шагах: лог) -> Г {
    перем г = исх
    пусть к = св(и_, "переменная")
    пусть тело = ч(и_, "тело")
    пусть источник_ = ч(и_, "источник")
    если не тело_разобрано(тело, [к]) { вернуть г }
    // пределы переменной цикла, если пределы начала и конца известны при сборке
    пусть пн = пределы_выражения(г, ч(источник_, "начало"))
    пусть пк = пределы_выражения(г, ч(источник_, "конец"))
    если пн.длина == 2 и пк.длина == 2 и пн[0] <= пк[1] { г.пределы_имён[к] = [пн[0], пк[1]] }
    пусть обращения = обращения_по_индексу(тело, к, {})
    перем условия: [стр] = []
    перем списки: [стр] = []
    для с в обращения.ключи() {
        если с != к и тело_разобрано(тело, [к, с]) и длина_не_меняется(тело, с) {
            перем мин_ = 0
            перем макс_ = 0
            для см в обращения[с] {
                мин_ = мин(мин_, см)
                макс_ = макс(макс_, см)
            }
            пусть рс = имя_си(г, с)
            г = рс.г
            условия.добавить(первое + " >= " + стр(-мин_) + " && " + последнее + " < (" + рс.к + ")->len - " + стр(макс_))
            списки.добавить(с)
        }
    }
    если условия.длина > 0 {
        // все обращения шагов от первого до последнего - в границах списков (длина в теле не меняется)
        пусть рф = служебное_имя(г, "inb")
        г = рф.г
        пусть флаг = рф.к + "v"         // имя не начало никакого другого имени (по нему цикл раздваивается)
        г = пиши(г, "const bool " + флаг + " = " + число_ + " == 0 || (" + условия.соединить(" && ") + ");")
        г.флаги_цикла.добавить(флаг)
        для с в списки {
            для см в обращения[с] { г.быстрые_индексы[ключ_быстрого(с, к, см)] = флаг }
            // список, элементы которого записываются, становится собственным один раз до цикла:
            // в теле его больше нигде не хранят, поэтому запись не делает копий
            если записывается(тело, с) и не в_шагах {
                пусть рс = структура(г, тип_списка_имени(тело, с))
                пусть рм = имя_си(рс.г, с)
                г = пиши(рм.г, "if (" + флаг + " && " + число_ + " > 0) " + рс.к + "_mut(&" + рм.к + ");")
            }
        }
    }
    если в_шагах { вернуть г }
    // накопители: за число_ шагов значение остаётся в пределах цел
    пусть нак = накопления(г, тело, ложь, {})
    для а в нак.ключи() {
        пусть н = нак[а]
        если н[0] > 0 и а != к и тело_разобрано(тело, [к, а]) {
            пусть ра = имя_си(г, а)
            пусть рф = служебное_имя(ра.г, "acc")
            г = рф.г
            пусть флаг = рф.к + "v"
            г.флаги_цикла.добавить(флаг)
            г = пиши(г, "const bool " + флаг + " = " + число_ + " <= (uint64_t)INT64_MAX && ({ int64_t _t; !__builtin_mul_overflow((int64_t)"
                + число_ + ", INT64_C(" + стр(н[2]) + "), &_t) && !__builtin_add_overflow(" + ра.к + ", _t, &_t) && !__builtin_mul_overflow((int64_t)"
                + число_ + ", INT64_C(" + стр(н[1]) + "), &_t) && !__builtin_add_overflow(" + ра.к + ", _t, &_t); });")
            г.накопители[а] = к + "\t" + флаг
        }
    }
    вернуть г
}

/// После цикла: доказанное для его тела больше не действует.
функ забыть_диапазоны(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть к = св(и_, "переменная")
    г.пределы_имён.удалить(к)
    для а в г.накопители.ключи() {
        если г.накопители[а].разбить("\t")[0] == к { г.накопители.удалить(а) }
    }
    для ключ в г.быстрые_индексы.ключи() {
        пусть части = ключ.разбить("\t")
        если части[1] == к { г.быстрые_индексы.удалить(ключ) }
    }
    вернуть г
}

// ---------- анализ диапазонов цикла «пока и < н { ... и += шаг }» ----------
//
// Условие - сравнение целой переменной и с границей н (<, <=, >, >=), граница и шаг в теле
// не меняются (число, имя без присваиваний в теле, длина списка, длина которого в теле не
// меняется); переменная присваивается в теле ровно один раз - «и += шаг» (при < и <=) или
// «и -= шаг» (при > и >=) прямо в теле, не во вложенном блоке. Тогда при шаге больше нуля
// до шага в каждом проходе и лежит между своим значением перед циклом и0 и границей:
// и0 <= и <= н (возрастающий цикл) или н <= и <= и0 (убывающий). «прервать» и «продолжить»
// этого не нарушают: шаг стоит на верхнем уровне тела, обращения до него идут до шага, после
// него - после. Перед циклом один раз проверяется: обращения с[и + смещение] до шага в
// границах и шаг не переполняет цел; если так, они идут без проверок. Обращения после шага
// и все прочие сохраняют проверку.

/// Сколько раз имя присваивается в теле («=», «+=» и т. п., на любой глубине).
функ присваивания_имени(у: разбор.Узел, имя_: стр) -> цел {
    перем н = 0
    если у.вид == "Присваивание" и не это_группа_полей(у) и св(у, "имя") == имя_ { н = 1 }
    для д в у.поля { н += присваивания_имени(д, имя_) }
    вернуть н
}

функ целое_выражение(у: разбор.Узел) -> лог { вернуть тип_выр(у) == "цел" и итоговый_тип(у) == "цел" }

/// Граница или шаг цикла «пока»: значение не меняется в теле.
функ неизменно_в_теле(у: разбор.Узел, тело: разбор.Узел) -> лог {
    если не целое_выражение(у) { вернуть ложь }
    если у.вид == "ЦелоеЧисло" { вернуть истина }
    если у.вид == "Унарная" и св(у, "оператор") == "-" { вернуть неизменно_в_теле(ч(у, "операнд"), тело) }
    если у.вид == "Имя" { вернуть присваивания_имени(тело, у.текст) == 0 и тело_разобрано(тело, [у.текст]) }
    если у.вид == "Поле" и не это_группа_полей(у) и св(у, "имя") == "длина" {
        пусть о = ч(у, "объект")
        пусть т = тип_выр(о)
        вернуть (о.вид == "Имя" и типы.срез(т, 0, 1) == "[" и типы.срез(т, т.длина - 1, т.длина) == "]"
            и тело_разобрано(тело, [о.текст]) и длина_не_меняется(тело, о.текст))
    }
    вернуть ложь
}

/// Перед циклом «пока»: что можно доказать для тела. Пишет флаги и возвращает состояние с быстрыми
/// обращениями до шага и флагом шага.
функ подготовить_пока(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть усл = ч(и_, "условие")
    пусть тело = ч(и_, "тело")
    если усл.вид != "Бинарная" { вернуть г }
    пусть оп = св(усл, "оператор")
    пусть возрастает = оп == "<" или оп == "<="
    если не возрастает и оп != ">" и оп != ">=" { вернуть г }
    пусть пер = ч(усл, "левый")
    пусть граница = ч(усл, "правый")
    если пер.вид != "Имя" или не целое_выражение(пер) { вернуть г }
    пусть к = пер.текст
    если не тело_разобрано(тело, [к]) или присваивания_имени(тело, к) != 1 { вернуть г }
    если не неизменно_в_теле(граница, тело) { вернуть г }
    // шаг: присваивание на верхнем уровне тела
    пусть инструкции = гр(тело, "инструкции")
    перем место_шага = -1
    для н в 0..инструкции.длина - 1 {
        пусть у = инструкции[н]
        если у.вид == "Присваивание" и св(у, "имя") == к { место_шага = н }
    }
    если место_шага < 0 { вернуть г }
    пусть шаг_ = инструкции[место_шага]
    пусть оп_шага = св(шаг_, "оператор")
    если (возрастает и оп_шага != "+=") или (не возрастает и оп_шага != "-=") { вернуть г }
    если пом(шаг_, "тип_цели") != "цел" или пом(шаг_, "тип_результата") != "цел" { вернуть г }
    пусть шаг = ч(шаг_, "значение")
    если не неизменно_в_теле(шаг, тело) { вернуть г }
    // значения перед циклом
    пусть рп = имя_си(г, к)
    пусть рн = выр(рп.г, граница)
    пусть рш = выр(рн.г, шаг)
    г = рш.г
    пусть рф = служебное_имя(г, "w")
    г = рф.г
    пусть и0 = рф.к + "lo"
    пусть н_ = рф.к + "hi"
    пусть ш = рф.к + "st"
    г = пиши(г, "const int64_t " + и0 + " = " + рп.к + ", " + н_ + " = " + рн.к + ", " + ш + " = " + рш.к + ";")
    // цикл не пуст и шаг больше нуля (при пустом цикле флаги не нужны)
    пусть не_пуст = и0 + " " + оп + " " + н_
    пусть пуст = "!(" + не_пуст + ")"
    пусть идёт = рф.к + "go"
    г = пиши(г, "const bool " + идёт + " = " + не_пуст + " && " + ш + " > 0;")
    // обращения до шага: и0 <= и <= н (при < - н - 1) или н (при > - н + 1) <= и <= и0
    перем обращения: {стр: [цел]} = {}
    для н в 0..место_шага - 1 { обращения = обращения_по_индексу(инструкции[н], к, обращения) }
    перем списки: [стр] = []
    перем флаги_списков: {стр: стр} = {}
    для с в обращения.ключи() {
        если с != к и тело_разобрано(тело, [к, с]) и длина_не_меняется(тело, с) {
            перем мин_ = 0
            перем макс_ = 0
            для см в обращения[с] {
                мин_ = мин(мин_, см)
                макс_ = макс(макс_, см)
            }
            пусть рс = имя_си(г, с)
            г = рс.г
            пусть длина_ = "(" + рс.к + ")->len - " + стр(макс_)
            перем условие = ""
            если оп == "<=" { условие = и0 + " >= " + стр(-мин_) + " && " + н_ + " < " + длина_ }
            если оп == "<" { условие = и0 + " >= " + стр(-мин_) + " && " + н_ + " <= " + длина_ }
            если оп == ">=" { условие = н_ + " >= " + стр(-мин_) + " && " + и0 + " < " + длина_ }
            если оп == ">" { условие = н_ + " >= " + стр(-мин_ - 1) + " && " + и0 + " < " + длина_ }
            пусть рфс = служебное_имя(г, "inb")
            г = рфс.г
            пусть флаг = рфс.к + "v"
            г = пиши(г, "const bool " + флаг + " = " + пуст + " || (" + идёт + " && " + условие + ");")
            г.флаги_цикла.добавить(флаг)
            флаги_списков[с] = флаг
            списки.добавить(с)
        }
    }
    для с в списки {
        пусть флаг = флаги_списков[с]
        для см в обращения[с] { г.быстрые_индексы[ключ_быстрого(с, к, см)] = флаг }
        если записывается(тело, с) {
            пусть рс = структура(г, тип_списка_имени(тело, с))
            пусть рм = имя_си(рс.г, с)
            г = пиши(рм.г, "if (" + флаг + " && " + идёт + ") " + рс.к + "_mut(&" + рм.к + ");")
        }
    }
    // шаг: до него и <= н (н >= и), после - не дальше н + шаг (н - шаг)
    пусть рфш = служебное_имя(г, "stp")
    г = рфш.г
    пусть флаг_шага = рфш.к + "v"
    перем действие = "add"
    если не возрастает { действие = "sub" }
    г = пиши(г, "const bool " + флаг_шага + " = " + пуст + " || (" + идёт + " && ({ int64_t _t; !__builtin_" + действие + "_overflow("
        + н_ + ", " + ш + ", &_t); }));")
    г.флаги_цикла.добавить(флаг_шага)
    г.шаги_пока[к] = флаг_шага
    вернуть г
}

/// Доказанное для обращений до шага переменной больше не действует.
функ забыть_пока_имя(исх: Г, к: стр) -> Г {
    перем г = исх
    г.шаги_пока.удалить(к)
    для ключ в г.быстрые_индексы.ключи() {
        если ключ.разбить("\t")[1] == к { г.быстрые_индексы.удалить(ключ) }
    }
    вернуть г
}

/// После цикла «пока»: доказанное для его тела больше не действует.
функ забыть_пока(исх: Г, и_: разбор.Узел) -> Г {
    пусть усл = ч(и_, "условие")
    если усл.вид != "Бинарная" или ч(усл, "левый").вид != "Имя" { вернуть исх }
    вернуть забыть_пока_имя(исх, ч(усл, "левый").текст)
}

функ цикл_по_каналу(исх: Г, и_: разбор.Узел, перем_: стр) -> Г {
    перем г = исх
    пусть т_канала = тип_выр(ч(и_, "источник"))
    пусть рк_ = канал_c(г, т_канала)
    г = рк_.г
    пусть dk = рк_.к
    пусть т = типы.элемент_канала(т_канала)
    пусть ро = тип_c(г, т + "?")
    г = ро.г
    пусть о = ро.к
    пусть р1 = служебное_имя(г, "chan")
    пусть р2 = служебное_имя(р1.г, "got")
    пусть р3 = служебное_имя(р2.г, "ml")
    г = р3.г
    пусть канал_ = р1.к
    пусть полученное = р2.к
    пусть метка = р3.к
    г = пиши(г, "{")
    г.отступ += 1
    пусть рв = выр(г, ч(и_, "источник"))
    г = пиши(рв.г, "dan_chan *const " + канал_ + " = dan_chan_share(" + рв.к + ");")
    г.области.добавить([Место(канал_, т_канала)])
    г = пиши(г, "for (;;) {")
    г = пиши(г, "    const size_t " + метка + " = dan_mark();")
    г = пиши(г, "    const " + о + " " + полученное + " = " + dk + "_recv(" + канал_ + ", " + стр(и_.строка) + ");")
    г = пиши(г, "    if (!" + о + "_has(" + полученное + ")) { dan_sweep(" + метка + "); break; }")
    пусть рт = тип_c(г, т)
    г = пиши(рт.г, "    " + рт.к + " const " + перем_ + " = " + о + "_val(" + полученное + ");")
    г = отладить_переменную(г, св(и_, "переменная"), перем_, т)
    // полученное значение живёт до конца шага цикла
    г.метки_циклов.добавить(МеткаЦикла(метка, г.области.длина))
    г = блок(г, ч(и_, "тело"))
    г.метки_циклов.удалить(г.метки_циклов.длина - 1)
    если не завершает(ч(и_, "тело")) { г = пиши(г, "    dan_sweep(" + метка + ");") }
    г = пиши(г, "}")
    пусть область = г.области[г.области.длина - 1]
    г.области.удалить(г.области.длина - 1)
    г = освободить_область(г, область)
    г.отступ -= 1
    вернуть пиши(г, "}")
}

функ и_вернуть(исх: Г, и_: разбор.Узел) -> Г {
    перем г = исх
    пусть результат = г.текущий_результат
    если не есть(и_, "значение") {
        если результат == ПУСТО() + "!" {
            пусть рт = тип_c(г, ПУСТО() + "!")
            пусть р = код_возврата(рт.г, рт.к + "_some()", результат)
            вернуть пиши(р.г, р.к)
        }
        пусть р = код_возврата(г, "", "")
        вернуть пиши(р.г, р.к)
    }
    // значение возврата удерживается, пока освобождаются переменные функции
    пусть рв = выр(г, ч(и_, "значение"))
    пусть р = код_возврата(рв.г, рв.к, результат)
    г = пиши(р.г, р.к)
    г.без_освобождения = {}        // отдавшие значение переменные этого «вернуть»
    вернуть г
}

функ выход_из_шага(исх: Г) -> Г {
    перем г = исх
    пусть м = г.метки_циклов[г.метки_циклов.длина - 1]
    пусть р = код_освобождения(г, м.от)
    г = р.г
    если р.к != "" { г = пиши(г, р.к) }
    если м.метка != "" { г = пиши(г, "dan_sweep(" + м.метка + ");") }
    вернуть г
}

// ---------- выражения ----------

// ---------- порядок вычисления ----------

/// Число, строка, логическое значение или «ничего» (возможно, со знаком минус).
функ постоянное(у: разбор.Узел) -> лог {
    если у.вид == "Унарная" { вернуть постоянное(ч(у, "операнд")) }
    вернуть ["ЦелоеЧисло", "ДробноеЧисло", "Строка", "Логическое", "Ничего"].содержит(у.вид)
}

/// Части выражения в порядке вычисления: имя части или «группа/номер»; «функция/объект» - объект метода.
функ пути_частей(у: разбор.Узел) -> [стр] {
    перем итог: [стр] = []
    выбор у.вид {
        "Унарная" { итог.добавить("операнд") }
        "Бинарная" { итог = ["левый", "правый"] }
        "Иначе" { итог = ["значение", "запасное"] }
        "Вызов" {
            если ч(у, "функция").вид == "Поле" {
                итог.добавить("функция/объект")
            } иначе если пом(у, "вызов_значения") != "" {
                итог.добавить("функция")
            }
            для н в 0..гр(у, "аргументы").длина - 1 { итог.добавить("аргументы/" + стр(н)) }
        }
        "Поле" { итог.добавить("объект") }
        "Список" {
            для н в 0..гр(у, "элементы").длина - 1 { итог.добавить("элементы/" + стр(н)) }
        }
        "Словарь" {
            для н в 0..гр(у, "ключи").длина - 1 {
                итог.добавить("ключи/" + стр(н))
                итог.добавить("значения/" + стр(н))
            }
        }
        "Индекс" { итог = ["объект", "индекс"] }
        "Диапазон" { итог = ["начало", "конец"] }
        "Передать" { итог.добавить("значение") }
        иначе { }
    }
    вернуть итог
}

/// Сами части выражения в том же порядке, что пути_частей.
функ части_выражения(у: разбор.Узел) -> [разбор.Узел] {
    выбор у.вид {
        "Унарная" { вернуть [ч(у, "операнд")] }
        "Бинарная" { вернуть [ч(у, "левый"), ч(у, "правый")] }
        "Иначе" { вернуть [ч(у, "значение"), ч(у, "запасное")] }
        "Вызов" {
            перем итог: [разбор.Узел] = []
            пусть ф = ч(у, "функция")
            если ф.вид == "Поле" {
                итог.добавить(ч(ф, "объект"))
            } иначе если пом(у, "вызов_значения") != "" {
                итог.добавить(ф)
            }
            для а в гр(у, "аргументы") { итог.добавить(а) }
            вернуть итог
        }
        "Поле" { вернуть [ч(у, "объект")] }
        "Список" { вернуть гр(у, "элементы") }
        "Словарь" {
            перем итог: [разбор.Узел] = []
            пусть ключи = гр(у, "ключи")
            пусть значения = гр(у, "значения")
            для н в 0..ключи.длина - 1 {
                итог.добавить(ключи[н])
                итог.добавить(значения[н])
            }
            вернуть итог
        }
        "Индекс" { вернуть [ч(у, "объект"), ч(у, "индекс")] }
        "Диапазон" { вернуть [ч(у, "начало"), ч(у, "конец")] }
        "Передать" { вернуть [ч(у, "значение")] }
        иначе { вернуть [] }
    }
}

функ часть_по_пути(у: разбор.Узел, путь: стр) -> разбор.Узел {
    если путь == "функция/объект" { вернуть ч(ч(у, "функция"), "объект") }
    пусть шаги = путь.разбить("/")
    если шаги.длина == 2 { вернуть гр(у, шаги[0])[разобрать_цел(шаги[1]) иначе 0] }
    вернуть ч(у, путь)
}

/// Узел с заменённой частью; у конструктора записи заменяется и то же значение поля.
функ с_частью_по_пути(у: разбор.Узел, путь: стр, новая: разбор.Узел) -> разбор.Узел {
    если путь == "функция/объект" { вернуть разбор_с_частью(у, "функция", разбор_с_частью(ч(у, "функция"), "объект", новая)) }
    пусть шаги = путь.разбить("/")
    если шаги.длина == 1 { вернуть разбор_с_частью(у, путь, новая) }
    перем группа = гр(у, шаги[0])
    пусть номер = разобрать_цел(шаги[1]) иначе 0
    пусть прежний = группа[номер]
    группа[номер] = новая
    перем итог = разбор_с_группой(у, шаги[0], группа)
    если шаги[0] == "аргументы" и есть(у, "значения_полей") {
        перем значения = гр(у, "значения_полей")
        для к в 0..значения.длина - 1 {
            если (значения[к].строка == прежний.строка и значения[к].столбец == прежний.столбец
                    и значения[к].вид == прежний.вид) {
                значения[к] = новая
            }
        }
        итог = разбор_с_группой(итог, "значения_полей", значения)
    }
    вернуть итог
}

/// Может ли вычисление выражения что-то сделать (вызов функции) или остановить программу
/// (деление, индекс, «!»): такие части выражения выполняются строго слева направо.
функ с_действием(у: разбор.Узел) -> лог {
    если у.пометки.содержит("готовый_код") или у.вид == "Лямбда" { вернуть ложь }
    если ["Вызов", "Запуск", "Передать", "Индекс"].содержит(у.вид) { вернуть истина }
    если у.вид == "Бинарная" и ["/", "%", "^"].содержит(св(у, "оператор")) { вернуть истина }
    для ч_ в части_выражения(у) {
        если с_действием(ч_) { вернуть истина }
    }
    вернуть ложь
}

/// Может ли вычисление выражения остановить программу или что-то сделать: к частям с действием
/// добавляются целые и рациональные «+», «-», «*» с проверкой переполнения и действия с датами.
/// Две такие части выполняются слева направо, иначе при двух ошибках сообщение зависело бы
/// от компилятора C.
функ ловушка(у: разбор.Узел) -> лог {
    если у.пометки.содержит("готовый_код") или у.вид == "Лямбда" или постоянное(у) { вернуть ложь }
    если с_действием(у) { вернуть истина }
    пусть т = тип_выр(у)
    пусть оп = св(у, "оператор")
    если у.вид == "Бинарная" и (оп == "+" или оп == "-" или оп == "*") и (т == "цел" или т == "рац" или пом(у, "операция_даты") != "") {
        вернуть истина
    }
    если у.вид == "Унарная" и оп == "-" и (т == "цел" или т == "рац") { вернуть истина }
    для ч_ в части_выражения(у) {
        если ловушка(ч_) { вернуть истина }
    }
    вернуть ложь
}

/// Части, которые надо вычислить заранее, чтобы выражение выполнялось слева направо: часть
/// с действием, после которой есть ещё не постоянная часть (в C порядок вычисления аргументов
/// функции не задан, и gcc часто вычисляет их справа налево).
функ по_порядку(у: разбор.Узел) -> [стр] {
    перем итог: [стр] = []
    если у.вид == "Бинарная" {
        пусть оп = св(у, "оператор")
        если оп == "и" или оп == "или" или пом(у, "сравнение_с_ничего") != "" { вернуть итог }
    } иначе если не ["Вызов", "Список", "Словарь", "Индекс"].содержит(у.вид) {
        вернуть итог
    }
    если у.вид == "Вызов" и (пом(у, "метод_задачи") != "" или пом(у, "метод_функции") != "") { вернуть итог }
    пусть ч_ = части_выражения(у)
    если ч_.длина < 2 { вернуть итог }
    // последняя не постоянная часть: раньше неё части с действием вычисляются заранее
    перем последняя = -1
    для н в 0..ч_.длина - 1 {
        если не постоянное(ч_[н]) { последняя = н }
    }
    если последняя < 1 { вернуть итог }
    перем пути: [стр] = []
    для н в 0..последняя - 1 {
        перем взять = с_действием(ч_[н])
        если не взять и ловушка(ч_[н]) {
            для м в н + 1..ч_.длина - 1 {
                если ловушка(ч_[м]) { взять = истина }
            }
        }
        если взять {
            если пути.длина == 0 { пути = пути_частей(у) }
            итог.добавить(пути[н])
        }
    }
    вернуть итог
}

функ выр(исх: Г, у_: разбор.Узел) -> РК {
    перем г = исх
    если у_.пометки.содержит("готовый_код") { вернуть рк(г, у_.пометки["готовый_код"]) }   // значение уже вычислено (передано задаче)
    перем у = у_
    перем объявления: [стр] = []
    для путь в по_порядку(у_) {
        пусть часть = часть_по_пути(у, путь)
        пусть р1 = выр(г, часть)
        пусть р2 = служебное_имя(р1.г, "seq")
        пусть р3 = тип_c(р2.г, итоговый_тип(часть))
        г = р3.г
        объявления.добавить(р3.к + " const " + р2.к + " = " + р1.к + ";")
        у = с_частью_по_пути(у, путь, с_готовым(часть, р2.к))
    }
    пусть р = выр_узла(г, у)
    если объявления.длина == 0 { вернуть р }
    вернуть рк(р.г, "({ " + объявления.соединить(" ") + " " + р.к + "; })")
}

функ выр_узла(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    выбор у.вид {
        "Передать" { вернуть оформить(в_передать(г, у), у) }
        "Лямбда" { вернуть оформить(в_лямбда(г, у), у) }
        "Ничего" { вернуть оформить(рк(г, "0"), у) }        // «ничего» всегда заворачивается в необязательный тип
        "Иначе" { вернуть оформить(в_иначе(г, у), у) }
        "ЦелоеЧисло" { вернуть оформить(рк(г, "INT64_C(" + св(у, "значение") + ")"), у) }
        "ДробноеЧисло" { вернуть оформить(рк(г, дробь_c(св(у, "значение"))), у) }
        "Строка" { вернуть оформить(литерал(г, св(у, "значение")), у) }
        "Логическое" {
            если св(у, "значение") == "True" { вернуть оформить(рк(г, "true"), у) } иначе { вернуть оформить(рк(г, "false"), у) }
        }
        "Имя" { вернуть оформить(в_имя(г, у), у) }
        "Унарная" { вернуть оформить(в_унарная(г, у), у) }
        "Бинарная" { вернуть оформить(в_бинарная(г, у), у) }
        "Список" { вернуть оформить(в_список(г, у), у) }
        "Словарь" { вернуть оформить(в_словарь(г, у), у) }
        "Индекс" { вернуть оформить(в_индекс(г, у), у) }
        "Поле" { вернуть оформить(в_поле(г, у), у) }
        "Вызов" { вернуть оформить(в_вызов(г, у), у) }
        иначе { вернуть оформить(рк(г, ""), у) }
    }
}

/// Приведение, заворачивание в необязательное значение или результат после кода выражения.
функ оформить(р: РК, у: разбор.Узел) -> РК {
    перем г = р.г
    перем код = р.к
    пусть к_типу = пом(у, "привести_к")
    если к_типу != "" и к_типу != тип_выр(у) {
        пусть рп = привести(г, код, тип_выр(у), к_типу, стр(у.строка))
        г = рп.г
        код = рп.к
    }
    пусть необяз = пом(у, "в_необяз")
    если необяз != "" {
        пусть рт = тип_c(г, необяз)
        г = рт.г
        если тип_выр(у) == "ничего" { код = рт.к + "_none()" } иначе { код = рт.к + "_some(" + код + ")" }
    }
    пусть результат = пом(у, "в_результат")
    если результат != "" {
        пусть рт = тип_c(г, результат)
        г = рт.г
        если тип_выр(у) == "ошибка" {
            код = рт.к + "_err(" + код + ", " + стр(у.строка) + ")"
        } иначе {
            код = рт.к + "_some(" + код + ")"
        }
    }
    вернуть рк(г, код)
}

функ в_передать(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    пусть т = тип_выр(ч(у, "значение"))
    пусть рт = тип_c(г, т)
    пусть рв_ = служебное_имя(рт.г, "res")
    г = рв_.г
    пусть тип_c_ = рт.к
    пусть временное = рв_.к
    пусть функция_ = пом(у, "функция_результат")
    перем при_ошибке = ""
    если функция_ != "" {
        пусть рф = тип_c(г, функция_)
        пусть рк_ = код_возврата(рф.г, рф.к + "_err(" + временное + ".err, " + временное + ".line)", функция_)
        г = рк_.г
        при_ошибке = рк_.к
    } иначе {
        при_ошибке = "dan_error(" + временное + ".err, " + временное + ".line);"
    }
    перем значение = временное + ".value"
    если типы.основа(т) == ПУСТО() { значение = "(void)0" }
    пусть рв = выр(г, ч(у, "значение"))
    вернуть рк(рв.г, "({ const " + тип_c_ + " " + временное + " = " + рв.к + "; if (!" + временное + ".ok) { " + при_ошибке + " } "
        + значение + "; })")
}

функ в_лямбда(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    пусть т = тип_выр(у)
    пусть р_df = тип_c(г, т)
    г = р_df.г
    пусть df = р_df.к
    пусть ф = типы.разобрать_тип_функции(т)
    пусть результат = ф.результат
    г.счётчик += 1
    пусть номер = г.счётчик
    пусть имя_c = "dan_lambda_" + стр(номер)
    перем захваты: [Место] = []
    для э в гр(у, "захваты") { захваты.добавить(Место(э.простые[0].имя, э.простые[0].значение)) }
    пусть сохр_строки = сохранить_строки(г)
    пусть сохр_отступ = г.отступ
    пусть сохр_результат = г.текущий_результат
    пусть сохр_области = г.области
    пусть сохр_метка = г.метка_функции
    пусть сохр_циклы = г.метки_циклов
    г = с_новыми_строками(г)
    г.отступ = 1
    г.текущий_результат = результат
    г.области = [[]]
    г.метка_функции = "dan_fmark"
    г.метки_циклов = []
    если захваты.длина > 0 {
        г = пиши(г, "const dan_env_" + стр(номер) + " *env = envp;")
        для з в захваты {
            пусть р1 = тип_c(г, з.т)
            пусть р2 = имя_си(р1.г, з.имя)
            пусть р3 = имя_си(р2.г, з.имя)
            г = пиши(р3.г, р1.к + " const " + р2.к + " = env->" + р3.к + ";")
        }
    } иначе {
        г = пиши(г, "(void)envp;")
    }
    перем тело_ = ч(у, "выражение")
    если не есть(у, "выражение") { тело_ = ч(у, "тело") }
    если куча_в_узле(г, тело_, истина) или куча_тип(г, результат) {
        г = пиши(г, "const size_t " + г.метка_функции + " = dan_mark();")
    } иначе {
        г.метка_функции = ""
    }
    если есть(у, "выражение") {
        пусть рв = выр(г, ч(у, "выражение"))
        г = рв.г
        если результат == ПУСТО() {
            г = выход_из_функции(пиши(г, рв.к + ";"))
        } иначе {
            пусть р = код_возврата(г, рв.к, результат)
            г = пиши(р.г, р.к)
        }
    } иначе {
        г = инструкции_блока(г, гр(ч(у, "тело"), "инструкции"))
        если (результат == ПУСТО() или результат == ПУСТО() + "!") и не завершает(ч(у, "тело")) { г = выход_из_функции(г) }
        если результат == ПУСТО() + "!" {
            пусть рт = тип_c(г, результат)
            г = пиши(рт.г, "return " + рт.к + "_some();")
        }
    }
    пусть тело = все_строки(г)
    г = восстановить_строки(г, сохр_строки)
    г.отступ = сохр_отступ
    г.текущий_результат = сохр_результат
    г.области = сохр_области
    г.метка_функции = сохр_метка
    г.метки_циклов = сохр_циклы
    перем параметры_c = ""
    пусть параметры = гр(у, "параметры")
    для н в 0..параметры.длина - 1 {
        если н >= ф.параметры.длина { прервать }
        пусть р1 = тип_c(г, ф.параметры[н])
        пусть р2 = имя_си(р1.г, св(параметры[н], "имя"))
        г = р2.г
        параметры_c += ", " + р1.к + " const " + р2.к
    }
    перем код: [стр] = []
    если захваты.длина > 0 {
        перем поля: [стр] = []
        для з в захваты {
            пусть р1 = тип_c(г, з.т)
            пусть р2 = имя_си(р1.г, з.имя)
            г = р2.г
            поля.добавить(р1.к + " " + р2.к + ";")
        }
        код.добавить("typedef struct { dan_hdr h; dan_destroy_fn d; void *(*c)(const void *); " + поля.соединить(" ") + " } dan_env_"
            + стр(номер) + ";")
        перем освободить_: [стр] = []
        для з в захваты {
            пусть р0 = отпустить(г, з.т)
            г = р0.г
            если р0.к != "" {
                пусть р1 = отпустить(г, з.т)
                пусть р2 = имя_си(р1.г, з.имя)
                г = р2.г
                освободить_.добавить(р1.к + "(e->" + р2.к + ");")
            }
        }
        код.добавить("static void dan_env_" + стр(номер) + "_destroy(dan_hdr *h) { dan_env_" + стр(номер) + " *e = (dan_env_"
            + стр(номер) + " *)(void *)h; " + освободить_.соединить(" ") + " dan_free(e); }")
        перем копии: [стр] = []
        для з в захваты {
            пусть р1 = имя_си(г, з.имя)
            пусть р2 = имя_си(р1.г, з.имя)
            пусть р3 = скопировать(р2.г, з.т, "e->" + р2.к)
            г = р3.г
            копии.добавить("r->" + р1.к + " = " + р3.к + ";")
        }
        код.добавить("static void *dan_env_" + стр(номер) + "_clone(const void *p) { const dan_env_" + стр(номер) + " *e = p; "
            + "dan_env_" + стр(номер) + " *r = dan_alloc(sizeof *r); *r = *e; dan_hdr_detached(&r->h); " + копии.соединить(" ")
            + " return r; }")
    }
    пусть рр = тип_c(г, результат)
    г = рр.г
    код.добавить("static " + рр.к + " " + имя_c + "(void *envp" + параметры_c + ") {")
    для с в тело { код.добавить(с) }
    код.добавить("}")
    для с в код { г.лямбды_код.добавить(с) }
    если захваты.длина == 0 { вернуть рк(г, "((" + df + "){ " + имя_c + ", NULL })") }
    пусть ро = служебное_имя(г, "env")
    г = ро.г
    пусть окр = ро.к
    перем присвоения: [стр] = []
    для з в захваты {
        пусть р1 = имя_си(г, з.имя)
        пусть р2 = имя_си(р1.г, з.имя)
        пусть р3 = учесть(р2.г, з.т, р2.к)
        г = р3.г
        присвоения.добавить(окр + "->" + р1.к + " = " + р3.к + ";")
    }
    пусть н = стр(номер)
    вернуть рк(г, "({ dan_env_" + н + " *" + окр + " = dan_alloc(sizeof *" + окр + "); dan_hdr_new(&" + окр + "->h, dan_env_" + н
        + "_destroy); " + окр + "->d = dan_env_" + н + "_destroy; " + окр + "->c = dan_env_" + н + "_clone; " + присвоения.соединить(" ")
        + " (" + df + "){ " + имя_c + ", " + окр + " }; })")
}

/// Функция программы как значение: обёртка с общим видом вызова.
функ обёртка(исх: Г, имя_дан: стр, т: стр) -> РК {
    перем г = исх
    если не г.обёртки.содержит(имя_дан) {
        пусть ф = типы.разобрать_тип_функции(т)
        пусть ри = имя_си(г, имя_дан)
        г = ри.г
        пусть имя_c = "dan_wrap_" + ри.к
        перем аргументы = ""
        перем передать: [стр] = []
        перем и_ = 0
        для х в ф.параметры {
            пусть р = тип_c(г, х)
            г = р.г
            аргументы += ", " + р.к + " a" + стр(и_)
            передать.добавить("a" + стр(и_))
            и_ += 1
        }
        если г.потребляемые.содержит(имя_дан) {
            для н в 0..передать.длина - 1 {
                для п в г.потребляемые[имя_дан] {
                    если п.номер == н {
                        пусть р = учесть(г, п.т, передать[н])
                        г = р.г
                        передать[н] = р.к
                    }
                }
            }
        }
        пусть рр = тип_c(г, ф.результат)
        г = рр.г
        перем возврат = "return "
        если рр.к == "void" { возврат = "" }
        пусть ри2 = имя_си(г, имя_дан)
        г = ри2.г
        г.лямбды_код.добавить("static " + рр.к + " " + имя_c + "(void *env" + аргументы + ") { (void)env; " + возврат + ри2.к + "("
            + передать.соединить(", ") + "); }")
        г.обёртки[имя_дан] = имя_c
    }
    вернуть рк(г, г.обёртки[имя_дан])
}

функ в_иначе(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    пусть т = тип_выр(ч(у, "значение"))
    пусть рв_ = служебное_имя(г, "opt")
    пусть рз = выр(рв_.г, ч(у, "запасное"))
    пусть рт = тип_c(рз.г, т)
    г = рт.г
    пусть временное = рв_.к
    пусть тип_c_ = рт.к
    перем результат = тип_c_ + "_val(" + временное + ")"
    если тип_выр(у) == т { результат = временное }
    пусть рв = выр(г, ч(у, "значение"))
    вернуть рк(рв.г, "({ const " + тип_c_ + " " + временное + " = " + рв.к + "; " + тип_c_ + "_has(" + временное + ") ? " + результат
        + " : (" + рз.к + "); })")
}

функ в_имя(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    если пом(у, "вариант") != "" {
        пусть т = пом(у, "вариант_тип")
        пусть номер = номер_варианта(г, т, пом(у, "вариант"))
        пусть р = перечисление_c(г, т)
        вернуть рк(р.г, р.к + "_mk" + стр(номер) + "()")
    }
    если пом(у, "функция_значение") != "" {
        пусть р1 = тип_c(г, тип_выр(у))
        пусть р2 = обёртка(р1.г, пом(у, "функция_значение"), тип_выр(у))
        вернуть рк(р2.г, "((" + р1.к + "){ " + р2.к + ", NULL })")
    }
    если пом(у, "константа") != "" {
        г = тип_c(г, тип_выр(у)).г
        вернуть рк(г, г.постоянные[пом(у, "константа")])
    }
    вернуть имя_си(г, у.текст)
}

функ в_унарная(исх: Г, у: разбор.Узел) -> РК {
    пусть оп = св(у, "оператор")
    пусть т = тип_выр(у)
    пусть стр_ = стр(у.строка)
    если оп == "-" и (т == "рац" или т == "мн" или т == "цел" или т == "длинное" или т == "компл") {
        пусть р = выр(исх, ч(у, "операнд"))
        выбор т {
            "рац" { вернуть рк(р.г, "dan_rat_neg(" + р.к + ", " + стр_ + ")") }
            "мн" { вернуть рк(р.г, "dan_poly_neg(" + р.к + ", " + стр_ + ")") }
            "цел" { вернуть рк(р.г, "dan_neg(" + р.к + ", " + стр_ + ")") }
            "длинное" { вернуть рк(р.г, "dan_big_neg(" + р.к + ", " + стр_ + ")") }
            иначе { вернуть рк(р.г, "dan_cx_neg(" + р.к + ")") }
        }
    }
    перем знак = "!"
    если оп == "-" { знак = "-" }
    пусть р = выр(исх, ч(у, "операнд"))
    вернуть рк(р.г, "(" + знак + р.к + ")")
}

функ равенство_или_нет(оп: стр, равно: стр) -> стр {
    если оп == "==" { вернуть равно }
    вернуть "(!" + равно + ")"
}

/// Части цепочки «а + б + в» строк (слева направо). Вложенная склейка, части которой надо вычислять
/// заранее (по_порядку), и уже вычисленная часть остаются целыми: тогда в цепочке ни одна часть
/// с действием не стоит раньше части, которая не постоянна, и порядок вычисления частей не важен.
функ части_склейки(у: разбор.Узел, верх: лог) -> [разбор.Узел] {
    если у.пометки.содержит("готовый_код") или (не верх и по_порядку(у).длина > 0) { вернуть [у] }
    если у.вид == "Бинарная" и св(у, "оператор") == "+" и тип_выр(у) == "стр" и пом(у, "операция_даты") == "" и пом(у, "привести_к") == "" {
        перем итог = части_склейки(ч(у, "левый"), ложь)
        для ч_ в части_склейки(ч(у, "правый"), ложь) { итог.добавить(ч_) }
        вернуть итог
    }
    вернуть [у]
}

/// «стр(целое)»: цифры пишутся сразу в итог склейки.
функ число_в_строку(у: разбор.Узел) -> лог {
    если у.вид != "Вызов" или пом(у, "библиотека") != "" или пом(у, "привести_к") != "" или у.пометки.содержит("готовый_код") {
        вернуть ложь                  // уже вычисленное значение (по_порядку) не вычисляется заново
    }
    пусть ф = ч(у, "функция")
    пусть аргументы_ = гр(у, "аргументы")
    вернуть ф.вид == "Имя" и ф.текст == "стр" и аргументы_.длина == 1 и тип_выр(аргументы_[0]) == "цел"
}

/// Склейка цепочки строк одним выделением памяти по сумме длин (те же байты, что у попарной склейки).
функ склейка_цепочкой(исх: Г, части: [разбор.Узел]) -> РК {
    перем г = исх
    если не г.помощники.содержит("dan_cat") {
        г.помощники["dan_cat"] = ("typedef struct { dan_str s; int64_t i; } dan_catp;\n"
            + "/* склейка до 16 частей: строка (s) или цифры целого (s == NULL) - одно выделение памяти */\n"
            + "static dan_str dan_cat(size_t n, const dan_catp *p) {\n"
            + "    char b[16][24];\n    const char *q[16];\n    size_t l[16], t = 0;\n"
            + "    for (size_t k = 0; k < n; k++) {\n"
            + "        if (p[k].s) { q[k] = p[k].s; l[k] = strlen(p[k].s); }\n"
            + "        else { q[k] = dan_itoa(p[k].i, b[k] + sizeof b[k]); l[k] = (size_t)(b[k] + sizeof b[k] - 1 - q[k]); }\n"
            + "        t += l[k];\n    }\n"
            + "    char *r = dan_str_new(t), *w = r;\n"
            + "    for (size_t k = 0; k < n; k++) { memcpy(w, q[k], l[k]); w += l[k]; }\n"
            + "    return r;\n}\n")
    }
    перем коды: [стр] = []
    для ч_ в части {
        если число_в_строку(ч_) {
            пусть р = выр(г, гр(ч_, "аргументы")[0])
            г = р.г
            коды.добавить("{ NULL, " + р.к + " }")
        } иначе {
            пусть р = выр(г, ч_)
            г = р.г
            коды.добавить("{ " + р.к + ", 0 }")
        }
    }
    вернуть рк(г, "dan_cat(" + стр(части.длина) + ", (const dan_catp[]){ " + коды.соединить(", ") + " })")
}

функ в_бинарная(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    пусть оп = св(у, "оператор")
    пусть стр_ = стр(у.строка)
    пусть сторона = пом(у, "сравнение_с_ничего")
    если сторона != "" {
        пусть узел = ч(у, сторона)
        пусть р1 = тип_c(г, тип_выр(узел))
        пусть р2 = выр(р1.г, узел)
        пусть есть_ = р1.к + "_has(" + р2.к + ")"
        если оп == "==" { вернуть рк(р2.г, "(!" + есть_ + ")") }
        вернуть рк(р2.г, "(" + есть_ + ")")
    }
    если оп == "+" и тип_выр(у) == "стр" и пом(у, "операция_даты") == "" {
        пусть части = части_склейки(у, истина)
        перем числа = 0
        для ч_ в части { если число_в_строку(ч_) { числа += 1 } }
        если части.длина <= 16 и (части.длина >= 3 или числа > 0) { вернуть склейка_цепочкой(г, части) }
    }
    пусть рл = выр(г, ч(у, "левый"))
    пусть рп = выр(рл.г, ч(у, "правый"))
    г = рп.г
    пусть л = рл.к
    пусть п = рп.к
    пусть т = тип_выр(у)
    если т == "цел" и (оп == "+" или оп == "-" или оп == "*") и пом(у, "операция_даты") == "" и пределы_выражения(г, у).длина == 2 {
        вернуть рк(г, "(" + л + " " + оп + " " + п + ")")      // пределы известны: переполнения быть не может
    }
    если оп == "+" или оп == "-" или оп == "*" или оп == "/" или оп == "%" { вернуть арифметика(г, оп, л, п, т, стр_, у) }
    если оп == "^" {
        если т == "цел" { вернуть рк(г, "dan_pow_int(" + л + ", " + п + ", " + стр_ + ")") }
        если т == "рац" { вернуть рк(г, "dan_rat_pow(" + л + ", " + п + ", " + стр_ + ")") }
        если т == "длинное" { вернуть рк(г, "dan_big_pow(" + л + ", " + п + ", " + стр_ + ")") }
        если т == "компл" {
            пусть правый = ч(у, "правый")
            если или_иначе(пом(правый, "привести_к"), тип_выр(правый)) == "цел" {
                вернуть рк(г, "dan_cx_pow_int(" + л + ", " + п + ", " + стр_ + ")")
            }
            вернуть рк(г, "dan_cx_pow(" + л + ", " + п + ", " + стр_ + ")")
        }
        если т == "мн" { вернуть рк(г, "dan_poly_pow(" + л + ", " + п + ", " + стр_ + ")") }
        вернуть рк(г, "pow(" + л + ", " + п + ")")
    }
    если оп == "и" { вернуть рк(г, "(" + л + " && " + п + ")") }
    если оп == "или" { вернуть рк(г, "(" + л + " || " + п + ")") }
    пусть т_л = тип_выр(ч(у, "левый"))
    если т_л == "стр" и оп != "==" и оп != "!=" { вернуть рк(г, "(dan_str_cmp(" + л + ", " + п + ") " + оп + " 0)") }
    если т_л == "стр" { вернуть рк(г, равенство_или_нет(оп, "dan_str_eq(" + л + ", " + п + ")")) }
    если т_л == "байты" { вернуть рк(г, равенство_или_нет(оп, "dan_bytes_eq(" + л + ", " + п + ")")) }
    пусть т_о = пом(у, "тип_операндов")
    если типы.это_массив(т_о) или типы.это_массив(т_л) { вернуть рк(г, равенство_или_нет(оп, "dan_arr_eq(" + л + ", " + п + ")")) }
    если типы.это_словарь(т_о) {
        пусть р = словарь_c(г, т_о)
        вернуть рк(р.г, равенство_или_нет(оп, р.к + "_eq(" + л + ", " + п + ")"))
    }
    если типы.это_список(т_о) {
        пусть р = структура(г, т_о)
        вернуть рк(р.г, равенство_или_нет(оп, р.к + "_eq(" + л + ", " + п + ")"))
    }
    если г.перечисления.содержит(т_о) {
        пусть р = перечисление_c(г, т_о)
        вернуть рк(р.г, равенство_или_нет(оп, р.к + "_eq(" + л + ", " + п + ")"))
    }
    если г.собственные.содержит(т_о) {
        пусть р = значимый(г, т_о)
        вернуть рк(р.г, равенство_или_нет(оп, р.к + "_eq(" + л + ", " + п + ")"))
    }
    если т_о == "рац" { вернуть рк(г, "(dan_rat_cmp(" + л + ", " + п + ") " + оп + " 0)") }
    если т_о == "длинное" { вернуть рк(г, "(dan_big_cmp(" + л + ", " + п + ") " + оп + " 0)") }
    если т_о == "дата" { вернуть рк(г, "(dan_date_cmp(" + л + ", " + п + ") " + оп + " 0)") }
    если т_о == "компл" { вернуть рк(г, равенство_или_нет(оп, "dan_cx_eq(" + л + ", " + п + ")")) }
    если т_о == "мн" { вернуть рк(г, равенство_или_нет(оп, "dan_poly_eq(" + л + ", " + п + ")")) }
    вернуть рк(г, "(" + л + " " + оп + " " + п + ")")
}

/// Код «л оп п», где оба операнда уже приведены к типу результата.
функ арифметика(г: Г, оп: стр, л: стр, п: стр, т: стр, строка: стр, у: разбор.Узел) -> РК {
    пусть дата_ = пом(у, "операция_даты")
    если дата_ == "add" { вернуть рк(г, "dan_date_add(" + л + ", " + п + ", " + строка + ")") }
    если дата_ == "radd" { вернуть рк(г, "dan_date_add(" + п + ", " + л + ", " + строка + ")") }
    если дата_ == "sub" { вернуть рк(г, "dan_date_sub_days(" + л + ", " + п + ", " + строка + ")") }
    если дата_ == "diff" { вернуть рк(г, "dan_date_diff(" + л + ", " + п + ")") }
    если т == "стр" { вернуть рк(г, "dan_concat(" + л + ", " + п + ")") }
    если т == "байты" { вернуть рк(г, "dan_bytes_concat(" + л + ", " + п + ")") }
    если т == "рац" или т == "длинное" или т == "компл" или т == "мн" {
        вернуть рк(г, операция(т, оп) + "(" + л + ", " + п + ", " + строка + ")")
    }
    если т == "цел" {
        если оп == "/" { вернуть рк(г, "dan_div_exact(" + л + ", " + п + ", " + строка + ")") }   // только в обобщённых функциях
        если оп == "%" { вернуть рк(г, "dan_mod(" + л + ", " + п + ", " + строка + ")") }
        вернуть рк(г, операция("цел", оп) + "(" + л + ", " + п + ", " + строка + ")")
    }
    вернуть рк(г, "(" + л + " " + оп + " " + п + ")")
}

функ в_список(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    пусть т = тип_выр(у)
    пусть рс = структура(г, т)
    г = рс.г
    пусть элементы_ = гр(у, "элементы")
    если элементы_.длина == 0 { вернуть рк(г, рс.к + "_from(0, NULL)") }
    перем элементы: [стр] = []
    для э в элементы_ {
        пусть р = выр(г, э)
        г = р.г
        элементы.добавить(р.к)
    }
    пусть рт = тип_c(г, типы.элемент(т))
    вернуть рк(рт.г, рс.к + "_from(" + стр(элементы_.длина) + ", (" + рт.к + "[]){" + элементы.соединить(", ") + "})")
}

функ в_словарь(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    пусть т = тип_выр(у)
    пусть рд = словарь_c(г, т)
    г = рд.г
    пусть д_с = рд.к
    пусть ключи_ = гр(у, "ключи")
    если ключи_.длина == 0 { вернуть рк(г, д_с + "_new()") }
    перем ключи: [стр] = []
    для к в ключи_ {
        пусть р = выр(г, к)
        г = р.г
        ключи.добавить(р.к)
    }
    перем значения: [стр] = []
    для з в гр(у, "значения") {
        пусть р = выр(г, з)
        г = р.г
        значения.добавить(р.к)
    }
    пусть р1 = тип_c(г, типы.ключ_словаря(т))
    пусть р2 = тип_c(р1.г, типы.значение_словаря(т))
    пусть р3 = тип_c(р2.г, типы.значение_словаря(т))
    // приведение к типу параметра: для значений-указателей новые gcc без него не собирают программу
    вернуть рк(р3.г, д_с + "_from(" + стр(ключи_.длина) + ", (" + р1.к + "[]){" + ключи.соединить(", ") + "}, (const " + р2.к + " *)("
        + р3.к + "[]){" + значения.соединить(", ") + "})")
}

функ в_индекс(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    пусть объект = ч(у, "объект")
    пусть индекс = ч(у, "индекс")
    пусть т = тип_выр(объект)
    пусть стр_ = стр(у.строка)
    если типы.это_словарь(т) {
        пусть р1 = словарь_c(г, т)
        пусть р2 = выр(р1.г, объект)
        пусть р3 = выр(р2.г, индекс)
        вернуть рк(р3.г, р1.к + "_get(" + р2.к + ", " + р3.к + ", " + стр_ + ")")
    }
    если пом(у, "срез") != "" {
        пусть ро = выр(г, объект)
        пусть ра = выр(ро.г, ч(индекс, "начало"))
        пусть рб = выр(ра.г, ч(индекс, "конец"))
        г = рб.г
        если т == "стр" { вернуть рк(г, "dan_str_slice(" + ро.к + ", " + ра.к + ", " + рб.к + ", " + стр_ + ")") }
        если типы.это_массив(т) {
            // в шаге «параллельно для» часть общего массива (проверка пускает её только прямо в векторную
            // функцию) не держит массив: счётчик мест, общий для всех шагов, не меняется
            если г.общие_шага.содержит(имя_корня_шага(объект)) {
                вернуть рк(г, "dan_arr_borrow(" + ро.к + ", " + ра.к + ", " + рб.к + ", " + стр_ + ")")
            }
            вернуть рк(г, "dan_arr_slice(" + ро.к + ", " + ра.к + ", " + рб.к + ", " + стр_ + ")")
        }
        если т == "байты" {
            вернуть рк(включить_данные(г), "dan_bytes_slice(" + ро.к + ", " + ра.к + ", " + рб.к + ", " + стр_ + ")")
        }
        пусть рс = структура(г, т)
        вернуть рк(рс.г, рс.к + "_slice(" + ро.к + ", " + ра.к + ", " + рб.к + ", " + стр_ + ")")
    }
    если т == "стр" {
        пусть р1 = выр(г, объект)
        пусть р2 = выр(р1.г, индекс)
        вернуть рк(р2.г, "dan_str_char_at(" + р1.к + ", " + р2.к + ", " + стр_ + ")")
    }
    если т == "байты" {
        пусть р1 = выр(г, объект)
        пусть р2 = выр(р1.г, индекс)
        вернуть рк(р2.г, "dan_bytes_get(" + р1.к + ", " + р2.к + ", " + стр_ + ")")
    }
    если типы.это_массив(т) {
        пусть р1 = выр(г, объект)
        пусть р2 = выр(р1.г, индекс)
        вернуть рк(р2.г, "dan_arr_get" + буква_массива(т) + "(" + вид_массива_c(типы.вид_массива(т)) + ", " + р1.к + ", " + р2.к + ", "
            + стр_ + ")")
    }
    пусть рс = структура(г, т)
    пусть р1 = выр(рс.г, объект)
    пусть р2 = выр(р1.г, индекс)
    пусть флаг = флаг_границ(г, объект, индекс)
    если флаг != "" {
        вернуть рк(р2.г, "(" + флаг + " ? (" + р1.к + ")->items[" + р2.к + "] : " + рс.к + "_get(" + р1.к + ", " + р2.к + ", " + стр_ + "))")
    }
    вернуть рк(р2.г, рс.к + "_get(" + р1.к + ", " + р2.к + ", " + стр_ + ")")
}

/// массив(вид, размер), массив(вид, размер, значение), массив(вид, список)
функ создать_массив(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    г.нужны_массивы = истина
    пусть аргументы_ = гр(у, "аргументы")
    пусть т = тип_выр(у)
    пусть вид = вид_массива_c(типы.вид_массива(т))
    пусть б = буква_массива(т)
    пусть стр_ = стр(у.строка)
    пусть р1 = выр(г, аргументы_[1])
    г = р1.г
    пусть способ = пом(у, "создать_массив")
    если способ == "размер" { вернуть рк(г, "dan_arr_new(" + вид + ", " + р1.к + ", " + стр_ + ")") }
    если способ == "байты" { вернуть рк(г, "dan_arr_from_bytes(" + вид + ", " + р1.к + ", " + стр_ + ")") }
    если способ == "заполнить" {
        пусть р2 = выр(г, аргументы_[2])
        вернуть рк(р2.г, "dan_arr_fill" + б + "(" + вид + ", " + р1.к + ", " + р2.к + ", " + стр_ + ")")
    }
    пусть рс = структура(г, "[" + типы.элемент_массива(т) + "]")
    пусть рн = служебное_имя(рс.г, "src")
    г = рн.г
    вернуть рк(г, "({ " + рс.к + " *const " + рн.к + " = " + р1.к + "; dan_arr_from" + б + "(" + вид + ", " + рн.к + "->items, "
        + рн.к + "->len, " + стр_ + "); })")
}

/// склеить(а, б): новый массив (два memcpy) или новый список (элементы получают ещё одно место).
функ породить_склеить(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    пусть аргументы_ = гр(у, "аргументы")
    пусть ра = выр_список_г(г, аргументы_)
    г = ра.г
    пусть стр_ = стр(у.строка)
    если пом(у, "склеить") == "массив" {
        г.нужны_массивы = истина
        вернуть рк(г, "dan_arr_concat(" + ра.коды[0] + ", " + ра.коды[1] + ", " + стр_ + ")")
    }
    пусть рс = структура(г, тип_выр(у))
    пусть р1 = служебное_имя(рс.г, "x")
    пусть р2 = служебное_имя(р1.г, "y")
    пусть р3 = служебное_имя(р2.г, "r")
    г = р3.г
    пусть с_ = рс.к
    вернуть рк(г, "({ " + с_ + " *const " + р1.к + " = " + ра.коды[0] + "; " + с_ + " *const " + р2.к + " = " + ра.коды[1] + "; "
        + с_ + " *const " + р3.к + " = " + с_ + "_from(" + р1.к + "->len, " + р1.к + "->items); "
        + "for (int64_t _k = 0; _k < " + р2.к + "->len; _k++) " + с_ + "_push(" + р3.к + ", " + р2.к + "->items[_k]); " + р3.к + "; })")
}

/// массив_из_файла(вид, путь, смещение, количество): массив, отображённый из файла, или ошибка-значение.
функ массив_из_файла(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    г.нужны_массивы = истина
    пусть аргументы_ = гр(у, "аргументы")
    пусть т = тип_выр(у)
    пусть вид = вид_массива_c(типы.вид_массива(типы.основа(т)))
    пусть ра = выр_список_г(г, [аргументы_[1]])
    г = ра.г
    перем смещение = "INT64_C(0)"
    перем количество = "INT64_C(-1)"
    если аргументы_.длина > 2 {
        пусть р = выр(г, аргументы_[2])
        г = р.г
        смещение = р.к
    }
    если аргументы_.длина > 3 {
        пусть р = выр(г, аргументы_[3])
        г = р.г
        количество = р.к
    }
    пусть рр = значимый(г, т)
    пусть рм = служебное_имя(рр.г, "arr")
    пусть рн = служебное_имя(рм.г, "err")
    г = рн.г
    вернуть рк(г, "({ dan_str " + рн.к + " = NULL; dan_arr *const " + рм.к + " = dan_arr_map(" + вид + ", " + ра.коды[0] + ", "
        + смещение + ", " + количество + ", &" + рн.к + "); " + рм.к + " ? " + рр.к + "_some(" + рм.к + ") : " + рр.к + "_err("
        + рн.к + ", " + стр(у.строка) + "); })")
}

/// м.список(): новый список с элементами массива.
функ список_из_массива(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    пусть объект = ч(ч(у, "функция"), "объект")
    пусть т = тип_выр(объект)
    пусть б = буква_массива(т)
    пусть рс = структура(г, "[" + типы.элемент_массива(т) + "]")
    г = рс.г
    пусть S = рс.к
    пусть имя_ = "dan_arr_to_" + S
    если не г.помощники.содержит(имя_) {
        г.помощники[имя_] = ("static " + S + " *" + имя_ + "(const dan_arr *a) {\n    " + S + " *l = " + S + "_from(0, NULL);\n"
            + "    if (a->len > l->cap) { l->cap = a->len; l->items = dan_realloc(l->items, (size_t)l->cap * sizeof *l->items); }\n"
            + "    l->len = a->len;\n    dan_arr_out" + б + "(a, l->items);\n    return l;\n}")
    }
    пусть р = выр(г, объект)
    вернуть рк(р.г, имя_ + "(" + р.к + ")")
}

функ в_поле(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    пусть объект = ч(у, "объект")
    пусть т = тип_выр(объект)
    пусть имя_ = св(у, "имя")
    если пом(у, "свойство_задачи") != "" {
        пусть р = выр(г, объект)
        вернуть рк(р.г, "dan_task_ready(&" + р.к + ".t)")
    }
    если т == "дата" {
        пусть р = выр(г, объект)
        выбор имя_ {
            "год" { вернуть рк(р.г, "dan_date_year(" + р.к + ")") }
            "месяц" { вернуть рк(р.г, "dan_date_month(" + р.к + ")") }
            "день" { вернуть рк(р.г, "dan_date_day(" + р.к + ")") }
            "день_недели" { вернуть рк(р.г, "dan_date_weekday(" + р.к + ")") }
            иначе { вернуть рк(р.г, "dan_date_yday(" + р.к + ")") }
        }
    }
    если т == "компл" {
        пусть р = выр(г, объект)
        выбор имя_ {
            "вещ" { вернуть рк(р.г, "(" + р.к + ").re") }
            "мним" { вернуть рк(р.г, "(" + р.к + ").im") }
            "модуль" { вернуть рк(р.г, "dan_cx_abs(" + р.к + ")") }
            "аргумент" { вернуть рк(р.г, "dan_cx_arg(" + р.к + ")") }
            иначе { вернуть рк(р.г, "dan_cx_conj(" + р.к + ")") }
        }
    }
    если г.собственные.содержит(т) {
        пусть р1 = выр(г, объект)
        пусть р2 = поле_c(р1.г, т, имя_)
        вернуть рк(р2.г, "(" + р1.к + ")." + р2.к)
    }
    пусть р = выр(г, объект)
    если т == "рац" {
        если имя_ == "числитель" { вернуть рк(р.г, "(" + р.к + ").n") }
        вернуть рк(р.г, "(" + р.к + ").d")
    }
    если т == "мн" {
        если имя_ == "степень" { вернуть рк(р.г, "(" + р.к + ")->deg") }
        вернуть рк(р.г, "dan_poly_coeffs(" + р.к + ")")
    }
    если т == "стр" { вернуть рк(р.г, "dan_str_len(" + р.к + ")") }
    если т == "байты" или типы.это_словарь(т) или типы.это_список(т) или типы.это_массив(т) { вернуть рк(р.г, "(" + р.к + ")->len") }
    вернуть рк(г, "INT64_C(0)")              // литерал «[]»
}

функ выр_список(исх: Г, узлы: [разбор.Узел]) -> [стр] {
    вернуть выр_список_г(исх, узлы).коды
}

тип РКС {
    г: Г
    коды: [стр]
}

функ выр_список_г(исх: Г, узлы: [разбор.Узел]) -> РКС {
    перем г = исх
    перем коды: [стр] = []
    для у в узлы {
        пусть р = выр(г, у)
        г = р.г
        коды.добавить(р.к)
    }
    вернуть РКС(г, коды)
}

функ в_вызов(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    пусть стр_ = стр(у.строка)
    пусть функция_ = ч(у, "функция")
    пусть аргументы_ = гр(у, "аргументы")
    если пом(у, "метод_задачи") != "" {
        пусть р = выр(г, ч(функция_, "объект"))
        если тип_выр(у) == ПУСТО() { вернуть рк(р.г, "dan_task_join(&" + р.к + ".t, " + стр_ + ")") }
        вернуть рк(р.г, "(dan_task_join(&" + р.к + ".t, " + стр_ + "), " + р.к + ".result)")
    }
    если пом(у, "метод_канала") != "" {
        пусть объект = ч(функция_, "объект")
        пусть р1 = выр(г, объект)
        пусть р2 = канал_c(р1.г, тип_выр(объект))
        г = р2.г
        если пом(у, "метод_канала") == "отправить" {
            пусть р3 = выр(г, аргументы_[0])
            вернуть рк(р3.г, р2.к + "_send(" + р1.к + ", " + р3.к + ", " + стр_ + ")")
        }
        если пом(у, "метод_канала") == "получить" { вернуть рк(г, р2.к + "_recv(" + р1.к + ", " + стр_ + ")") }
        вернуть рк(г, "dan_chan_close(" + р1.к + ", " + стр_ + ")")
    }
    если пом(у, "создать_массив") != "" { вернуть создать_массив(г, у) }
    если пом(у, "массив_из_файла") != "" { вернуть массив_из_файла(г, у) }
    если пом(у, "склеить") != "" { вернуть породить_склеить(г, у) }
    если пом(у, "метод_массива") != "" { вернуть список_из_массива(г, у) }
    если функция_.вид == "Имя" и функция_.текст == "канал" и типы.это_канал(тип_выр(у)) {
        перем запас = "0"
        если аргументы_.длина > 0 {
            пусть р = выр(г, аргументы_[0])
            г = р.г
            запас = р.к
        }
        пусть р = канал_c(г, тип_выр(у))
        вернуть рк(р.г, р.к + "_new(" + запас + ", " + стр_ + ")")
    }
    если пом(у, "вызов_значения") != "" {
        пусть ра = выр_список_г(г, аргументы_)
        пусть рт = тип_c(ра.г, пом(у, "вызов_значения"))
        пусть рф = выр(рт.г, функция_)
        перем аргументы = ""
        для к в ра.коды { аргументы += ", " + к }
        вернуть рк(рф.г, рт.к + "_call(" + рф.к + аргументы + ")")
    }
    если пом(у, "метод_функции") != "" { вернуть функциональный_метод(г, у) }
    если функция_.вид == "Поле" {
        // метод: список.добавить(х), строка.найти(т)
        пусть объект = ч(функция_, "объект")
        пусть р0 = выр(г, объект)
        пусть ра = выр_список_г(р0.г, аргументы_)
        г = ра.г
        перем аргументы = [р0.к]
        для к в ра.коды { аргументы.добавить(к) }
        если пом(у, "метод_словаря") != "" {
            пусть рд = словарь_c(г, тип_выр(объект))
            г = рд.г
            пусть суффикс = пом(у, "метод_словаря")
            если суффикс == "remove" {
                пусть рм = место(г, объект)
                г = рм.г
                аргументы[0] = рд.к + "_mut(&" + рм.к + ")"
            }
            вернуть рк(г, рд.к + "_" + суффикс + "(" + аргументы.соединить(", ") + ")")
        }
        если пом(у, "метод_c") != "" {
            г = структура(г, "[стр]").г       // некоторые методы строк возвращают списки строк
            если пом(у, "метод_c_строка") == "True" { аргументы.добавить(стр_) }
            вернуть рк(г, пом(у, "метод_c") + "(" + аргументы.соединить(", ") + ")")
        }
        пусть рс = структура(г, тип_выр(объект))
        г = рс.г
        пусть метод_ = пом(у, "метод")
        если метод_ == "добавить" или метод_ == "вставить" или метод_ == "удалить" {
            пусть рм = место(г, объект)
            г = рм.г
            аргументы[0] = рс.к + "_mut(&" + рм.к + ")"
        }
        если пом(у, "метод_списка_строка") == "True" { аргументы.добавить(стр_) }
        вернуть рк(г, рс.к + "_" + пом(у, "метод_списка") + "(" + аргументы.соединить(", ") + ")")
    }
    пусть имя_ = функция_.текст
    если пом(у, "вариант") != "" {
        пусть т = пом(у, "вариант_тип")
        пусть номер = номер_варианта(г, т, пом(у, "вариант"))
        пусть рз = выр_список_г(г, гр(у, "значения_полей"))
        пусть рп = перечисление_c(рз.г, т)
        вернуть рк(рп.г, рп.к + "_mk" + стр(номер) + "(" + рз.коды.соединить(", ") + ")")
    }
    если пом(у, "конструктор") != "" {
        пусть т = пом(у, "конструктор")
        пусть узлы = гр(у, "значения_полей")
        перем значения: [стр] = []
        перем н = 0
        для п в г.собственные[т] {
            если н >= узлы.длина { прервать }
            пусть р1 = поле_c(г, т, п.имя)
            пусть р2 = выр(р1.г, узлы[н])
            г = р2.г
            значения.добавить("." + р1.к + " = " + р2.к)
            н += 1
        }
        пусть рт = тип_c(г, т)
        вернуть рк(рт.г, "((" + рт.к + "){ " + значения.соединить(", ") + " })")
    }
    пусть ра = выр_список_г(г, аргументы_)
    г = ра.г
    перем аргументы = ра.коды
    для к в 0..аргументы_.длина - 1 {
        // буфер<вид> функции C: место получает свой массив (копию, если массив хранится и в других местах)
        если пом(аргументы_[к], "буфер") != "" {
            пусть рм = место(г, аргументы_[к])
            г = рм.г
            аргументы[к] = "dan_arr_mut(&" + рм.к + ")"
        }
    }
    если пом(у, "библиотека") != "" {
        пусть описание = г.описания[пом(у, "библиотека")]
        пусть вариант = разобрать_цел(пом(у, "библиотека_номер")) иначе 0
        если описание.модуль == "данные" {
            г = включить_данные(г)
            если описание.часть == "pdf" { г.нужен_pdf = истина }
        } иначе если описание.модуль == "система" {
            г = включить_систему(г)
            если описание.часть == "сеть" и не г.нужна_сеть {
                г.нужна_сеть = истина
                г = типы_c(г, среда.нужные_типы("сеть"))
            }
            если описание.часть == "окна" и не г.нужны_окна {
                г.нужны_окна = истина
                г = типы_c(г, среда.нужные_типы("окна"))
            }
            если описание.часть == "база" и не г.нужна_база {
                г.нужна_база = истина
                г = типы_c(г, среда.нужные_типы("база"))
            }
        } иначе если описание.модуль == "ядра" {
            г = включить_ядра(г)
        } иначе если описание.модуль == "модели" {
            г = включить_модели(г)
        } иначе если описание.модуль == "вывод" {
            // напечатать(т): как «вывод», но без перевода строки и с выталкиванием буфера
            вернуть рк(г, "(DAN_OUT_LOCK(), " + описание.си[вариант] + "(" + аргументы[0] + "), fflush(stdout), DAN_OUT_UNLOCK())")
        } иначе если описание.модуль == "биты" {
            г.нужны_биты = истина
        } иначе {
            г = включить_математику(г)
        }
        если описание.строка[вариант] { аргументы.добавить(стр_) }
        перем имя_c = описание.си[вариант]
        // в блоке «приближённо» ядра с приближённым вариантом (имя C с «_fast») выбирают его
        если г.приближённо > 0 и описание.модуль == "ядра" и описание.часть.содержит("|" + имя_c + "|") { имя_c = имя_c + "_fast" }
        вернуть рк(г, имя_c + "(" + аргументы.соединить(", ") + ")")
    }
    если имя_ == "вывод" {
        пусть р = запись_типа(г, тип_выр(аргументы_[0]), ложь)
        вернуть рк(р.г, "(DAN_OUT_LOCK(), " + р.к + "(" + аргументы[0] + "), dan_newline(), DAN_OUT_UNLOCK())")
    }
    если имя_ == "ошибка" { вернуть рк(г, аргументы[0]) }
    если имя_ == "ввод" {
        если аргументы.длина > 0 { вернуть рк(г, "dan_input(" + аргументы[0] + ")") }
        вернуть рк(г, "dan_input(NULL)")
    }
    если имя_ == "байты" и пом(у, "из_массива") != "" { вернуть рк(г, "dan_arr_to_bytes(" + аргументы[0] + ")") }
    если имя_ == "байты" и пом(у, "из_списка") != "" {
        вернуть рк(включить_данные(г), "dan_bytes_from_list(" + аргументы[0] + ", " + стр_ + ")")
    }
    если имя_ == "рац" и аргументы.длина == 2 { вернуть рк(г, "dan_rat_of(" + аргументы[0] + ", " + аргументы[1] + ", " + стр_ + ")") }
    если имя_ == "дата" и аргументы.длина == 3 {
        г.нужны_даты = истина
        вернуть рк(г, "dan_date_make(" + аргументы[0] + ", " + аргументы[1] + ", " + аргументы[2] + ", " + стр_ + ")")
    }
    если имя_ == "компл" и аргументы.длина == 2 {
        г.нужны_компл = истина
        вернуть рк(г, "dan_cx_make(" + аргументы[0] + ", " + аргументы[1] + ")")
    }
    если ["стр", "цел", "дроб", "рац", "байты", "длинное", "компл", "дата"].содержит(имя_) {
        вернуть преобразование(г, имя_, тип_выр(аргументы_[0]), аргументы[0], стр_)
    }
    если г.потребляемые.содержит(имя_) {
        для п в г.потребляемые[имя_] {
            если пом(аргументы_[п.номер], "перенос") == "" {
                пусть р = учесть(г, п.т, аргументы[п.номер])         // функция получает своё место хранения
                г = р.г
                аргументы[п.номер] = р.к
            }
        }
    }
    пусть ри = имя_си(г, имя_)
    вернуть рк(ри.г, ри.к + "(" + аргументы.соединить(", ") + ")")
}

функ функциональный_метод(исх: Г, у: разбор.Узел) -> РК {
    перем г = исх
    пусть вид = пом(у, "метод_функции")
    пусть тип_ф = пом(у, "метод_функции_тип")
    пусть результат = пом(у, "метод_функции_результат")
    пусть объект = ч(ч(у, "функция"), "объект")
    пусть тип_списка = тип_выр(объект)
    пусть т = типы.элемент(тип_списка)
    пусть рс = структура(г, тип_списка)
    пусть рф = тип_c(рс.г, тип_ф)
    г = рф.г
    пусть с_с = рс.к
    пусть ф_т = рф.к
    пусть ключ = вид + "\t" + тип_списка + "\t" + тип_ф
    если не г.помощники.содержит(ключ) {
        пусть имя_ = "dan_" + вид + "_" + стр(г.помощники.длина + 1)
        г = тип_c(г, т).г
        перем код = ""
        если вид == "преобразовать" {
            пусть рр = структура(г, "[" + результат + "]")
            г = рр.г
            пусть р_т = рр.к
            код = ("static " + р_т + " *" + имя_ + "(const " + с_с + " *l, " + ф_т + " f) {\n    " + р_т + " *r = " + р_т + "_from(0, NULL);\n"
                + "    for (int64_t i = 0; i < l->len; i++) " + р_т + "_push(r, " + ф_т + "_call(f, l->items[i]));\n    return r;\n}")
        } иначе если вид == "отобрать" {
            код = ("static " + с_с + " *" + имя_ + "(const " + с_с + " *l, " + ф_т + " f) {\n    " + с_с + " *r = " + с_с + "_from(0, NULL);\n"
                + "    for (int64_t i = 0; i < l->len; i++) if (" + ф_т + "_call(f, l->items[i])) " + с_с + "_push(r, l->items[i]);\n"
                + "    return r;\n}")
        } иначе если вид == "любой" или вид == "все" {
            перем искомое = "false"
            перем проверка_ = "!" + ф_т + "_call(f, l->items[i])"
            если вид == "любой" {
                искомое = "true"
                проверка_ = ф_т + "_call(f, l->items[i])"
            }
            код = ("static bool " + имя_ + "(const " + с_с + " *l, " + ф_т + " f) {\n    for (int64_t i = 0; i < l->len; i++) "
                + "if (" + проверка_ + ") return " + искомое + ";\n    return !" + искомое + ";\n}")
        } иначе если вид == "найти_первый" {
            перем необяз = т + "?"
            если типы.это_необяз(т) { необяз = т }
            пусть ро = тип_c(г, необяз)
            г = ро.г
            пусть О = ро.к
            перем некоторое = О + "_some(l->items[i])"
            если типы.это_необяз(т) { некоторое = "l->items[i]" }
            код = ("static " + О + " " + имя_ + "(const " + с_с + " *l, " + ф_т + " f) {\n    for (int64_t i = 0; i < l->len; i++) "
                + "if (" + ф_т + "_call(f, l->items[i])) return " + некоторое + ";\n    return " + О + "_none();\n}")
        } иначе если вид == "свернуть" {
            пусть ра = тип_c(г, результат)
            г = ра.г
            пусть а_т = ра.к
            код = ("static " + а_т + " " + имя_ + "(const " + с_с + " *l, " + а_т + " acc, " + ф_т + " f) {\n    " + а_т + " r = acc;\n"
                + "    for (int64_t i = 0; i < l->len; i++) r = " + ф_т + "_call(f, r, l->items[i]);\n    return r;\n}")
        } иначе {
            // упорядочить_по: устойчивая сортировка слиянием по ключу
            пусть рк_ = тип_c(г, результат)
            г = рк_.г
            пусть к_т = рк_.к
            перем сравнить = "(ka < kb ? -1 : ka > kb)"
            выбор результат {
                "рац" { сравнить = "dan_rat_cmp(ka, kb)" }
                "стр" { сравнить = "dan_str_cmp(ka, kb)" }
                "дата" { сравнить = "dan_date_cmp(ka, kb)" }
                иначе { }
            }
            код = ("static " + с_с + " *" + имя_ + "(const " + с_с + " *l, " + ф_т + " f) {\n"
                + "    int64_t n = l->len;\n    " + с_с + " *r = " + с_с + "_copy(l);\n"
                + "    " + к_т + " *k = dan_alloc(sizeof(" + к_т + ") * (size_t)(n ? n : 1));\n"
                + "    int64_t *ix = dan_alloc(sizeof(int64_t) * (size_t)(n ? n : 1)), *tmp = dan_alloc(sizeof(int64_t) * (size_t)(n ? n : 1));\n"
                + "    for (int64_t i = 0; i < n; i++) { k[i] = " + ф_т + "_call(f, l->items[i]); ix[i] = i; }\n"
                + "    for (int64_t w = 1; w < n; w *= 2)\n"
                + "        for (int64_t lo = 0; lo < n; lo += 2 * w) {\n"
                + "            int64_t mid = lo + w < n ? lo + w : n, hi = lo + 2 * w < n ? lo + 2 * w : n, a = lo, b = mid, o = lo;\n"
                + "            while (a < mid || b < hi) {\n"
                + "                if (b >= hi) { tmp[o++] = ix[a++]; continue; }\n"
                + "                if (a >= mid) { tmp[o++] = ix[b++]; continue; }\n"
                + "                " + к_т + " ka = k[ix[a]], kb = k[ix[b]];\n"
                + "                tmp[o++] = (" + сравнить + ") <= 0 ? ix[a++] : ix[b++];\n"
                + "            }\n"
                + "            for (int64_t i = lo; i < hi; i++) ix[i] = tmp[i];\n"
                + "        }\n"
                + "    for (int64_t i = 0; i < n; i++) r->items[i] = l->items[ix[i]];\n"
                + "    dan_free(k); dan_free(ix); dan_free(tmp);\n"
                + "    return r;\n}")
        }
        г.помощники[ключ] = код
        г.помощники_имена[ключ] = имя_
    }
    пусть имя_ = г.помощники_имена[ключ]
    пусть р0 = выр(г, объект)
    пусть ра = выр_список_г(р0.г, гр(у, "аргументы"))
    перем аргументы = [р0.к]
    для к в ра.коды { аргументы.добавить(к) }
    вернуть рк(ра.г, имя_ + "(" + аргументы.соединить(", ") + ")")
}
