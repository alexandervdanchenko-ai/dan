        "THAANA", "THAI", "TIBETAN", "TIFINAGH", "TIRHUTA", "TOTO", "TURNED", "UGARITIC",
        "VAI", "VEDIC", "VERTICAL", "VITHKUQI", "WANCHO", "WARANG", "YEZIDI", "YI",
        "ZANABAZAR",
    ]
    вернуть имена[номер - 1]
}
