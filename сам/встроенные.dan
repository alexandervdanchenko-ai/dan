    для имя_ в ["рабочий_день", "добавить_рабочие_дни", "сейчас", "метка_времени", "пауза", "аргументы", "переменная_среды", "выполнить_команду"] { т.имена.добавить(имя_) }
    для имя_ в ["вывод_команды", "завершить", "вывод_ошибки", "совпадает", "найти_шаблон", "найти_все", "группы", "заменить_шаблон"] { т.имена.добавить(имя_) }
    для имя_ в ["разбить_по_шаблону", "утвердить", "утвердить_равно", "символ_по_коду", "код_символа", "сетевой_запрос", "почтовый_запрос", "дата_для_письма"] { т.имена.добавить(имя_) }
    для имя_ в ["база_открыть", "база_закрыть", "база_выполнить", "окно_создать", "окно_добавить", "окно_задать", "окно_получить", "окно_рисовать"] { т.имена.добавить(имя_) }
    для имя_ в ["окно_ждать", "окно_сообщение", "окно_файл"] { т.имена.добавить(имя_) }
    т.постоянные["пи"] = "дроб"
    т.постоянные["х"] = "мн"
    т.постоянные["x"] = "мн"
    т.постоянные["е"] = "дроб"
    т.постоянные["e"] = "дроб"
    т.устаревшие["праздник"] = ["2027", "нерабочие дни задавайте в своей программе, например словарём {дата: лог}"]
    т.устаревшие["рабочий_день"] = ["2027", "используйте «выходной» и свой список нерабочих дней"]
    т.устаревшие["добавить_рабочие_дни"] = ["2027", "прибавляйте по одному дню, пропуская выходные и свои нерабочие дни"]
    вернуть т
}

