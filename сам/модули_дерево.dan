/// Программа сверки: дерево программы со всеми подключёнными файлами, построенное на Дане.
///
///     сам/модули_дерево --версия=1.3 --редакции=2026 --библиотека=папка --разделитель=/ программа.dan [...]
///
/// Для каждого файла (путь - полный) - строка «== путь», строка «ФАЙЛЫ» со
/// списком файлов программы и дерево или «ОШИБКА» с сообщением.

подключить "модули"
подключить "разбор"

перем настройки = модули.Настройки("")
перем файлы: [стр] = []
для а в аргументы() {
    если а.начинается("--версия=") {
        настройки.версия = а[9..а.длина - 1]
    } иначе если а.начинается("--редакции=") {
        настройки.редакции = а[11..а.длина - 1].разбить(",")
    } иначе если а.начинается("--библиотека=") {
        настройки.библиотека = а[13..а.длина - 1]
    } иначе если а.начинается("--разделитель=") {
        настройки.разделитель = а[14..а.длина - 1]
    } иначе {
        файлы.добавить(а)
    }
}
для путь в файлы {
    вывод("== " + путь)
    если пусть программа = модули.загрузить(прочитать(путь), путь, настройки) {
        вывод("ФАЙЛЫ " + программа.файлы.соединить(" | "))
        вывод(разбор.показать(программа.дерево))
    } иначе ошибка о {
        вывод("ОШИБКА " + о.заменить("\n", "\\n"))
    }
}
