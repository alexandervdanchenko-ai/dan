/// Программа сверки: создаёт страницы документации генератором на Дане.
///
///     python dan.py запустить сам/документы.dan [файл|папка ...] [--в=папка]
///
/// Делает то же, что «python dan.py документация» без --проверить.

подключить "документация"
подключить "среда"

перем редакции: [стр] = []
для р в среда.редакции() { редакции.добавить(р[0]) }
перем разделитель = "/"
если (переменная_среды("OS") иначе "") == "Windows_NT" { разделитель = "\\" }
завершить(документация.команда(аргументы(), редакции, среда.версия(), разделитель))
