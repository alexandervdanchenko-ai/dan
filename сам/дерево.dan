/// Программа сверки: печатает деревья файлов, построенные разбором на Дане.
///
///     python dan.py запустить сам/дерево.dan --версия=1.3 --редакции=2026 программа.dan [...]
///
/// Для каждого файла - строка «== путь», затем дерево (как uzly.показать)
/// или «ОШИБКА» с сообщением.

подключить "лексер"
подключить "разбор"

перем версия = ""
перем редакции: [стр] = []
перем файлы: [стр] = []
для а в аргументы() {
    если а.начинается("--версия=") {
        версия = а[9..а.длина - 1]
    } иначе если а.начинается("--редакции=") {
        редакции = а[11..а.длина - 1].разбить(",")
    } иначе {
        файлы.добавить(а)
    }
}
для путь в файлы {
    вывод("== " + путь)
    пусть текст = прочитать(путь)
    если пусть токены = лексер.разобрать(текст) {
        если пусть дерево = разбор.разобрать(токены, редакции, версия) {
            вывод(разбор.показать(дерево))
        } иначе ошибка о {
            вывод("ОШИБКА " + о.заменить("\n", "\\n"))
        }
    } иначе ошибка о {
        вывод("ОШИБКА " + о.заменить("\n", "\\n"))
    }
}
