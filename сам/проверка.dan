/// Проверка смысла программы, написанная на Дане: четвёртая часть компилятора на самом Дане.
///
/// Делает то же, что proverka.py: проверяет объявления, типы, вызовы, изменяемость и
/// собирает все ошибки программы с теми же текстами. Каждому выражению записывается
/// найденный тип (пометка «тип_выр»), числу, которое нужно привести к другому типу, -
/// пометка «привести_к»; ими пользуется порождение кода.
///
/// Функции Дана получают копии значений, поэтому состояние проверки (найденные ошибки,
/// области видимости, объявления) передаётся из функции в функцию и возвращается вместе
/// с результатом, а проверенный узел возвращается новым - уже с пометками.

подключить "разбор"
подключить "типы"
подключить "похожее"
подключить "встроенные"

// ---------- состояние проверки ----------

общий тип Сообщение {
    строка: цел
    столбец: цел
    текст: стр
}

общий тип Переменная {
    т: стр
    изменяемая: лог
    /// «переменная», «параметр», «цикл», «значение» или «захват»
    вид: стр = "переменная"
}

общий тип Сигн {
    параметры: [стр]
    результат: стр
    имена: [стр] = []
}

/// Поле собственного типа: имя, тип и значение по умолчанию (ноль или один узел).
общий тип ПолеТ {
    имя: стр
    т: стр
    по_умолчанию: [разбор.Узел] = []
}

общий тип ВариантТ {
    имя: стр
    поля: [ПолеТ] = []
}

/// Обобщённая функция: нетронутый узел, параметры типа (с интерфейсами) и сигнатура.
общий тип Шаблон {
    узел: разбор.Узел
    /// параметр типа -> интерфейсы (вместе с включёнными)
    параметры: {стр: [стр]}
    сигн: Сигн
}

общий тип ЛямбдаВ {
    граница: цел
    захваты: {стр: стр} = {}
}

общий тип Сост {
    т: встроенные.Таблицы
    ошибки: [Сообщение] = []
    предупреждения: [Сообщение] = []
    /// ошибки, которые может снять ожидаемый тип: место узла -> сообщение
    отложенные: {стр: Сообщение} = {}
    функции: {стр: Сигн} = {}
    области: [{стр: Переменная}] = []
    в_функции: лог = ложь
    функция_имя: стр = ""
    функция_результат: стр = ""
    глубина_циклов: цел = 0
    типы: {стр: [ПолеТ]} = {}
    лямбды: [ЛямбдаВ] = []
    перечисления: {стр: [ВариантТ]} = {}
    вариант_тип: {стр: стр} = {}
    /// тип, «тип|поле», «тип|вариант» или «тип|вариант|поле» -> как написано в программе
    написания: {стр: стр} = {}
    шаблоны: {стр: Шаблон} = {}
    обобщённые_типы: {стр: разбор.Узел} = {}
    обобщённые_варианты: {стр: стр} = {}
    /// интерфейс -> метод -> сигнатура; пустой - ещё не проверен
    интерфейсы: {стр: {стр: Сигн}} = {}
    /// «тип|метод» -> полное имя функции
    методы: {стр: стр} = {}
    параметры_типов: {стр: [стр]} = {}
    новые_функции: [разбор.Узел] = []
    временные_типы: [стр] = []
    глубина_экземпляров: цел = 0
    в_параллельном: цел = 0
    задача_разрешена: лог = ложь
    внешние: {стр: разбор.Узел} = {}
    неполных_выборов: цел = 0
    /// проверяется объект метода или поля (задачу можно только дождаться)
    приёмник: лог = ложь
    /// номер копии обобщённого кода (у каждой подстановки свои узлы, как у deepcopy в Python)
    копия: цел = 0
    копий: цел = 0
}

/// Результат шага проверки: состояние, проверенный узел, найденный тип, успех.
тип Р {
    с: Сост
    у: разбор.Узел
    т: стр = ""
    да: лог = ложь
}

// ---------- постоянные ----------

функ НЕИЗВ() -> стр { вернуть "<неизвестный>" }
функ ОТЛОЖЕННАЯ() -> стр { вернуть "<функция>" }
функ ПУСТО() -> стр { вернуть "пусто" }

функ встроенные_имена() -> [стр] {
    вернуть ["вывод", "ввод", "ошибка", "канал", "цел", "дроб", "рац", "стр", "лог", "мн", "байты", "длинное",
             "компл", "дата"]
}

функ встроенное(имя: стр) -> лог { вернуть встроенные_имена().содержит(имя) }

функ встроенный_тип(имя: стр) -> лог { вернуть типы.встроенные_типы().содержит(имя) }

функ число(т: стр) -> лог { вернуть типы.номер_числа(т) >= 0 }

функ сравнимые() -> [стр] {
    вернуть ["цел", "дроб", "рац", "стр", "лог", "мн", "байты", "длинное", "компл", "дата"]
}

/// Встроенные интерфейсы и включённые в них.
функ встроенные_интерфейсы() -> [стр] { вернуть ["Сравнимое", "Упорядоченное", "Числовое", "Ключ"] }

функ описание_интерфейса(и_: стр) -> стр {
    выбор и_ {
        "Сравнимое" { вернуть "сравнение на равенство (== и !=)" }
        "Упорядоченное" { вернуть "сравнение по порядку (<, <=, >, >=)" }
        "Числовое" { вернуть "арифметика (+, -, *, /) и сравнение" }
        "Ключ" { вернуть "использование ключом словаря" }
        иначе { вернуть "" }
    }
}

функ включённые_интерфейсы(и_: стр) -> [стр] {
    выбор и_ {
        "Упорядоченное" { вернуть ["Сравнимое"] }
        "Числовое" { вернуть ["Упорядоченное", "Сравнимое"] }
        "Ключ" { вернуть ["Сравнимое"] }
        иначе { вернуть [] }
    }
}

/// Типы, которые выполняют встроенный интерфейс (кроме «Сравнимое», которое проверяется по типу).
функ типы_интерфейса(и_: стр) -> [стр] {
    выбор и_ {
        "Упорядоченное" { вернуть ["цел", "дроб", "рац", "стр", "длинное", "дата"] }
        "Числовое" { вернуть ["цел", "дроб", "рац", "длинное"] }
        "Ключ" { вернуть типы.ключи_словаря() }
        иначе { вернуть [] }
    }
}

/// Во что можно преобразовать значение функцией с названием типа (пусто - преобразования нет).
функ преобразования(т: стр) -> [стр] {
    выбор т {
        "стр" { вернуть ["цел", "дроб", "рац", "стр", "лог", "мн", "байты", "длинное", "компл", "дата"] }
        "байты" { вернуть ["стр", "байты"] }
        "цел" { вернуть ["цел", "дроб", "рац", "стр", "длинное"] }
        "дроб" { вернуть ["цел", "дроб", "рац", "стр", "длинное"] }
        "рац" { вернуть ["цел", "дроб", "рац", "стр"] }
        "длинное" { вернуть ["цел", "стр", "длинное"] }
        "компл" { вернуть ["цел", "дроб", "рац", "компл"] }
        "дата" { вернуть ["стр", "дата"] }
        иначе { вернуть [] }
    }
}

/// Свойства значений встроенных типов: «тип|свойство» -> тип свойства.
функ свойство_типа(т: стр, имя: стр) -> стр {
    выбор т + "|" + имя {
        "рац|числитель" { вернуть "цел" }
        "рац|знаменатель" { вернуть "цел" }
        "мн|степень" { вернуть "цел" }
        "мн|коэффициенты" { вернуть "[рац]" }
        "байты|длина" { вернуть "цел" }
        "компл|вещ" { вернуть "дроб" }
        "компл|мним" { вернуть "дроб" }
        "компл|модуль" { вернуть "дроб" }
        "компл|аргумент" { вернуть "дроб" }
        "компл|сопряженное" { вернуть "компл" }
        "дата|год" { вернуть "цел" }
        "дата|месяц" { вернуть "цел" }
        "дата|день" { вернуть "цел" }
        "дата|день_недели" { вернуть "цел" }
        "дата|день_года" { вернуть "цел" }
        иначе { вернуть "" }
    }
}

функ методы_строки() -> [стр] {
    вернуть ["найти", "содержит", "начинается", "оканчивается", "заменить", "разбить", "прописные", "строчные",
             "обрезать", "символы", "повторить"]
}

/// Варианты метода строки: типы параметров и результат.
функ варианты_метода_строки(имя: стр) -> [встроенные.Вариант] {
    выбор имя {
        "найти" { вернуть [встроенные.Вариант(["стр"], "цел")] }
        "содержит" { вернуть [встроенные.Вариант(["стр"], "лог")] }
        "начинается" { вернуть [встроенные.Вариант(["стр"], "лог")] }
        "оканчивается" { вернуть [встроенные.Вариант(["стр"], "лог")] }
        "заменить" { вернуть [встроенные.Вариант(["стр", "стр"], "стр")] }
        "разбить" { вернуть [встроенные.Вариант([], "[стр]"), встроенные.Вариант(["стр"], "[стр]")] }
        "прописные" { вернуть [встроенные.Вариант([], "стр")] }
        "строчные" { вернуть [встроенные.Вариант([], "стр")] }
        "обрезать" { вернуть [встроенные.Вариант([], "стр")] }
        "символы" { вернуть [встроенные.Вариант([], "[стр]")] }
        иначе { вернуть [встроенные.Вариант(["цел"], "стр")] }
    }
}

функ методы_списка() -> [стр] {
    вернуть ["добавить", "вставить", "удалить", "содержит", "найти", "копия", "обратный", "соединить"]
}

/// Метод списка: параметры и результат с «Т» (тип элементов) и «[Т]» (тип списка).
функ метод_списка(имя: стр) -> встроенные.Вариант {
    выбор имя {
        "добавить" { вернуть встроенные.Вариант(["Т"], "пусто") }
        "вставить" { вернуть встроенные.Вариант(["цел", "Т"], "пусто") }
        "удалить" { вернуть встроенные.Вариант(["цел"], "пусто") }
        "содержит" { вернуть встроенные.Вариант(["Т"], "лог") }
        "найти" { вернуть встроенные.Вариант(["Т"], "цел") }
        "копия" { вернуть встроенные.Вариант([], "[Т]") }
        "обратный" { вернуть встроенные.Вариант([], "[Т]") }
        иначе { вернуть встроенные.Вариант(["стр"], "стр") }
    }
}

функ методы_словаря() -> [стр] {
    вернуть ["содержит", "найти", "получить", "удалить", "ключи", "значения", "копия"]
}

/// Метод словаря: «К» - тип ключей, «З» - тип значений, «С» - тип словаря.
функ метод_словаря(имя: стр) -> встроенные.Вариант {
    выбор имя {
        "содержит" { вернуть встроенные.Вариант(["К"], "лог") }
        "найти" { вернуть встроенные.Вариант(["К"], "З?") }
        "получить" { вернуть встроенные.Вариант(["К", "З"], "З") }
        "удалить" { вернуть встроенные.Вариант(["К"], "пусто") }
        "ключи" { вернуть встроенные.Вариант([], "[К]") }
        "значения" { вернуть встроенные.Вариант([], "[З]") }
        иначе { вернуть встроенные.Вариант([], "С") }
    }
}

функ суффикс_словаря(имя: стр) -> стр {
    выбор имя {
        "получить" { вернуть "get_or" }
        "удалить" { вернуть "remove" }
        "ключи" { вернуть "keys" }
        "значения" { вернуть "values" }
        "найти" { вернуть "find" }
        "копия" { вернуть "copy" }
        иначе { вернуть "contains" }
    }
}

функ функциональные_методы() -> [стр] {
    вернуть ["преобразовать", "отобрать", "любой", "все", "найти_первый", "свернуть", "упорядочить_по"]
}

функ образец_метода(имя: стр) -> стр {
    выбор имя {
        "преобразовать" { вернуть "с.преобразовать(функ(х) = ...): новый список из результатов функции" }
        "отобрать" { вернуть "с.отобрать(функ(х) = условие): элементы, для которых условие истинно" }
        "любой" { вернуть "с.любой(функ(х) = условие): истинно ли условие хотя бы для одного элемента" }
        "все" { вернуть "с.все(функ(х) = условие): истинно ли условие для всех элементов" }
        "найти_первый" { вернуть "с.найти_первый(функ(х) = условие): первый подходящий элемент или ничего" }
        "свернуть" { вернуть "с.свернуть(начальное, функ(итог, х) = ...): итог последовательного применения функции" }
        иначе { вернуть "с.упорядочить_по(функ(х) = ключ): новый список по возрастанию ключа" }
    }
}

функ изменяющий_метод(имя: стр) -> лог { вернуть ["добавить", "вставить", "удалить"].содержит(имя) }

// ---------- узлы ----------

функ св(у: разбор.Узел, имя: стр) -> стр { вернуть разбор.свойство(у, имя) }
функ ч(у: разбор.Узел, имя: стр) -> разбор.Узел { вернуть разбор.часть(у, имя) }
функ гр(у: разбор.Узел, имя: стр) -> [разбор.Узел] { вернуть разбор.часть_группы(у, имя) }

/// Есть ли у узла вложенное поле (не пустое).
функ есть(у: разбор.Узел, имя: стр) -> лог { вернуть гр(у, имя).длина > 0 }

функ пом(у: разбор.Узел, имя: стр) -> стр { вернуть у.пометки.получить(имя, "") }

функ с_пом(у: разбор.Узел, имя: стр, значение: стр) -> разбор.Узел {
    перем новый = у
    новый.пометки[имя] = значение
    вернуть новый
}

функ без_пом(у: разбор.Узел, имя: стр) -> разбор.Узел {
    если не у.пометки.содержит(имя) { вернуть у }
    перем новый = у
    новый.пометки.удалить(имя)
    вернуть новый
}

/// Тип выражения, записанный в узел проверкой.
функ тип_узла(у: разбор.Узел) -> стр { вернуть пом(у, "тип_выр") }

функ с_группой(у: разбор.Узел, имя: стр, содержимое: [разбор.Узел]) -> разбор.Узел {
    перем новый = у
    перем группы: [разбор.Узел] = []
    перем найдена = ложь
    для г в у.поля {
        если г.вид == имя {
            группы.добавить(разбор.группа(имя, содержимое))
            найдена = истина
        } иначе {
            группы.добавить(г)
        }
    }
    если не найдена { группы.добавить(разбор.группа(имя, содержимое)) }
    новый.поля = группы
    вернуть новый
}

функ с_частью(у: разбор.Узел, имя: стр, часть: разбор.Узел) -> разбор.Узел {
    вернуть с_группой(у, имя, [часть])
}

функ со_свойством(у: разбор.Узел, имя: стр, значение: стр) -> разбор.Узел {
    перем новый = у
    перем простые: [разбор.Свойство] = []
    перем найдено = ложь
    для с_ в у.простые {
        если с_.имя == имя {
            простые.добавить(разбор.Свойство(имя, значение, с_.строкой))
            найдено = истина
        } иначе {
            простые.добавить(с_)
        }
    }
    если не найдено { простые.добавить(разбор.Свойство(имя, значение)) }
    новый.простые = простые
    вернуть новый
}

/// Место узла: ключ отложенных ошибок (замена id(узел) в Python).
функ место_узла(у: разбор.Узел) -> стр {
    вернуть стр(у.строка) + ":" + стр(у.столбец) + ":" + у.вид
}

функ ключ_отложенной(с: Сост, у: разбор.Узел) -> стр {
    вернуть стр(с.копия) + ":" + место_узла(у)
}

// ---------- сообщения ----------

функ ошибка(с: Сост, у: разбор.Узел, текст: стр) -> Сост {
    перем новое = с
    перем т = текст
    если пом(у, "деление_целых") != "" и т.содержит("рац") {
        т += ("; деление целых чисел «/» точное и даёт обыкновенную дробь, а частное при делении "
              + "с остатком - функция частное(а, б)")
    }
    новое.ошибки.добавить(Сообщение(у.строка, у.столбец, т))
    вернуть новое
}

функ предупреждение(с: Сост, у: разбор.Узел, текст: стр) -> Сост {
    пусть сообщение = Сообщение(у.строка, у.столбец, текст)
    если с.предупреждения.содержит(сообщение) { вернуть с }
    перем новое = с
    новое.предупреждения.добавить(сообщение)
    вернуть новое
}

функ проверить_устаревание(с: Сост, у: разбор.Узел, имя: стр) -> Сост {
    если не с.т.устаревшие.содержит(имя) { вернуть с }
    пусть запись = с.т.устаревшие[имя]
    перем текст = "функция «" + имя + "» устарела и будет удалена в редакции " + запись[0]
    если запись[1] != "" { текст += "; " + запись[1] }
    вернуть предупреждение(с, у, текст)
}

функ склонение_полей(н: цел) -> стр {
    если н % 10 == 1 и н % 100 != 11 { вернуть стр(н) + " поле" }
    если [2, 3, 4].содержит(н % 10) и не [12, 13, 14].содержит(н % 100) { вернуть стр(н) + " поля" }
    вернуть стр(н) + " полей"
}

функ склонение_параметров(н: цел) -> стр {
    если н % 10 == 1 и н % 100 != 11 { вернуть стр(н) + " параметр" }
    если [2, 3, 4].содержит(н % 10) и не [12, 13, 14].содержит(н % 100) { вернуть стр(н) + " параметра" }
    вернуть стр(н) + " параметров"
}

функ склонение_значений(н: цел) -> стр {
    если н % 10 == 1 и н % 100 != 11 { вернуть стр(н) + " значение" }
    если [2, 3, 4].содержит(н % 10) и не [12, 13, 14].содержит(н % 100) { вернуть стр(н) + " значения" }
    вернуть стр(н) + " значений"
}

функ подсказка(имя: стр, кандидаты: [стр]) -> стр {
    пусть похожее_ = похожее.похожее_имя(имя, кандидаты)
    если похожее_ == "" { вернуть "" }
    вернуть "; возможно, имелось в виду «" + похожее_ + "»"
}

/// Функция библиотеки: каноническое имя или "".
функ в_библиотеке(с: Сост, имя: стр) -> стр {
    вернуть с.т.поиск.получить(имя, "")
}

// ---------- переменные ----------

тип Найдено {
    с: Сост
    есть: лог
    п: Переменная
}

/// Переменная по имени; «захват» - запомнить, что безымянная функция берёт её копию.
функ найти(с: Сост, имя: стр, захват: лог) -> Найдено {
    перем номер = с.области.длина - 1
    пока номер >= 0 {
        если с.области[номер].содержит(имя) {
            пусть п = с.области[номер][имя]
            если с.лямбды.длина > 0 и номер < с.лямбды[с.лямбды.длина - 1].граница {
                // переменная снаружи безымянной функции: функция получает её копию
                перем новое = с
                если захват {
                    для н в 0..новое.лямбды.длина - 1 {
                        если номер < новое.лямбды[н].граница и не новое.лямбды[н].захваты.содержит(имя) {
                            новое.лямбды[н].захваты[имя] = п.т
                        }
                    }
                }
                вернуть Найдено(новое, истина, Переменная(п.т, ложь, "захват"))
            }
            вернуть Найдено(с, истина, п)
        }
        номер -= 1
    }
    вернуть Найдено(с, ложь, Переменная("", ложь))
}

/// Совпадает ли имя переменной с функцией или типом, видимыми в файле узла.
функ занято_объявлением(с: Сост, у: разбор.Узел, имя: стр) -> лог {
    если встроенное(имя) или с.параметры_типов.содержит(имя) { вернуть истина }
    если у.строка >= 1000000 и не имя.содержит(".") { вернуть ложь }
    вернуть (с.функции.содержит(имя) или с.типы.содержит(имя) или с.вариант_тип.содержит(имя)
        или с.перечисления.содержит(имя) или с.шаблоны.содержит(имя) или с.обобщённые_типы.содержит(имя)
        или с.обобщённые_варианты.содержит(имя))
}

функ объявить(исходное: Сост, у: разбор.Узел, имя: стр, т: стр, изменяемая: лог, вид: стр) -> Сост {
    перем с = исходное
    если занято_объявлением(с, у, имя) {
        с = ошибка(с, у, "имя «" + имя + "» уже занято функцией или названием типа")
    } иначе если найти(с, имя, ложь).есть {
        с = ошибка(с, у, "переменная «" + имя + "» уже объявлена; повторно объявлять переменную с тем же именем нельзя")
    }
    с.области[с.области.длина - 1][имя] = Переменная(т, изменяемая, вид)
    вернуть с
}

функ видимые_переменные(с: Сост) -> [стр] {
    перем итог: [стр] = []
    для область в с.области {
        для имя в область.ключи() { итог.добавить(имя) }
    }
    вернуть итог
}

функ видимые_функции(с: Сост) -> [стр] {
    перем итог = с.функции.ключи()
    для имя в встроенные_имена() { итог.добавить(имя) }
    для имя в с.т.имена { итог.добавить(имя) }
    вернуть итог
}

функ пустая_область() -> {стр: Переменная} { вернуть {} }

функ новая_область(с: Сост) -> Сост {
    перем новое = с
    новое.области.добавить({})
    вернуть новое
}

функ убрать_область(с: Сост) -> Сост {
    перем новое = с
    новое.области.удалить(новое.области.длина - 1)
    вернуть новое
}

// ---------- типы ----------

функ рт(с: Сост, т: стр) -> Р { вернуть Р(с, разбор.Узел(""), т) }

/// Тип по записи из программы; неизвестный тип - ошибка и НЕИЗВ.
функ тип_по_имени(исходное: Сост, у: разбор.Узел, имя: стр) -> Р {
    перем с = исходное
    если встроенный_тип(имя) или с.типы.содержит(имя) или с.перечисления.содержит(имя) или с.параметры_типов.содержит(имя) {
        вернуть рт(с, имя)
    }
    если типы.это_функция(имя) {
        пусть ф = типы.разобрать_тип_функции(имя)
        перем найденные: [стр] = []
        перем неизв = ложь
        для п в ф.параметры {
            пусть р = тип_по_имени(с, у, п)
            с = р.с
            найденные.добавить(р.т)
            если р.т == НЕИЗВ() { неизв = истина }
        }
        перем результат = ф.результат
        если результат != ПУСТО() и результат != ПУСТО() + "!" {
            пусть р = тип_по_имени(с, у, результат)
            с = р.с
            результат = р.т
            если р.т == НЕИЗВ() { неизв = истина }
        }
        если неизв { вернуть рт(с, НЕИЗВ()) }
        вернуть рт(с, типы.тип_функции(найденные, результат))
    }
    если типы.это_результат(имя) {
        если типы.основа(имя) == ПУСТО() { вернуть рт(с, имя) }
        пусть р = тип_по_имени(с, у, типы.основа(имя))
        если р.т == НЕИЗВ() { вернуть р }
        вернуть рт(р.с, р.т + "!")
    }
    если типы.это_необяз(имя) {
        пусть р = тип_по_имени(с, у, типы.основа(имя))
        если р.т == НЕИЗВ() { вернуть р }
        вернуть рт(р.с, р.т + "?")
    }
    если имя.начинается("[") и имя.оканчивается("]") {
        пусть р = тип_по_имени(с, у, типы.элемент(имя))
        если р.т == НЕИЗВ() { вернуть р }
        вернуть рт(р.с, "[" + р.т + "]")
    }
    если типы.это_словарь(имя) {
        пусть рк = тип_по_имени(с, у, типы.ключ_словаря(имя))
        пусть рз = тип_по_имени(рк.с, у, типы.значение_словаря(имя))
        с = рз.с
        пусть ключ = рк.т
        если с.параметры_типов.содержит(ключ) и не с.параметры_типов[ключ].содержит("Ключ") {
            вернуть рт(ошибка(с, у, "параметр типа " + ключ + " может быть ключом словаря, только если он выполняет "
                + "интерфейс Ключ: <" + ключ + ": Ключ>"), НЕИЗВ())
        }
        если не типы.ключи_словаря().содержит(ключ) и ключ != НЕИЗВ() и не с.параметры_типов.содержит(ключ) {
            вернуть рт(ошибка(с, у, "ключами словаря могут быть значения типов " + типы.ключи_словаря().соединить(", ")
                + ", а не " + ключ), НЕИЗВ())
        }
        если ключ == НЕИЗВ() или рз.т == НЕИЗВ() { вернуть рт(с, НЕИЗВ()) }
        вернуть рт(с, типы.словарь(ключ, рз.т))
    }
    если (имя.начинается("канал<") или имя.начинается("задача<")) и имя.оканчивается(">") {
        пусть вид = типы.срез(имя, 0, типы.позиция(имя, "<"))
        пусть внутри = типы.срез(имя, вид.длина + 1, имя.длина - 1)
        если вид == "задача" {
            если не с.задача_разрешена {
                вернуть рт(ошибка(с, у, "задачу нельзя хранить в списках, полях и параметрах или возвращать из функции: "
                    + "она принадлежит блоку, где запущена; результат получают «з.дождаться()»"), НЕИЗВ())
            }
            если внутри == ПУСТО() { вернуть рт(с, "задача<" + внутри + ">") }
            пусть р = тип_по_имени(с, у, внутри)
            если р.т == НЕИЗВ() { вернуть р }
            вернуть рт(р.с, "задача<" + р.т + ">")
        }
        пусть р = тип_по_имени(с, у, внутри)
        если р.т == НЕИЗВ() { вернуть р }
        если типы.это_необяз(р.т) или типы.это_результат(р.т) или типы.это_задача(р.т) {
            вернуть рт(ошибка(р.с, у, "в канал нельзя передавать значения типа " + р.т + ": получение «ничего» из канала "
                + "означает, что канал закрыт"), НЕИЗВ())
        }
        вернуть рт(р.с, "канал<" + р.т + ">")
    }
    если имя.оканчивается(">") и имя.содержит("<") {
        пусть д = типы.разобрать(имя)
        перем аргументы: [стр] = []
        перем неизв = ложь
        для а в д.дети {
            пусть р = тип_по_имени(с, у, типы.собрать(а))
            с = р.с
            аргументы.добавить(р.т)
            если р.т == НЕИЗВ() { неизв = истина }
        }
        если не с.обобщённые_типы.содержит(д.имя) {
            если с.типы.содержит(д.имя) или с.перечисления.содержит(д.имя) {
                с = ошибка(с, у, "у типа «" + д.имя + "» нет параметров типа, угловые скобки не нужны")
            } иначе {
                с = ошибка(с, у, "неизвестный тип «" + д.имя + "»")
            }
            вернуть рт(с, НЕИЗВ())
        }
        если неизв { вернуть рт(с, НЕИЗВ()) }
        вернуть экземпляр_типа(с, у, д.имя, аргументы)
    }
    если с.обобщённые_типы.содержит(имя) {
        перем параметры: [стр] = []
        перем целые: [стр] = []
        для п в гр(с.обобщённые_типы[имя], "параметры_типа") {
            параметры.добавить(св(п, "имя"))
            целые.добавить("цел")
        }
        вернуть рт(ошибка(с, у, "у типа «" + имя + "» есть параметры типа (" + параметры.соединить(", ") + "); укажите их, "
            + "например " + имя + "<" + целые.соединить(", ") + ">"), НЕИЗВ())
    }
    перем кандидаты = типы.встроенные_типы()
    для т в с.типы.ключи() { кандидаты.добавить(т) }
    пусть похожее_ = похожее.похожее_имя(имя, кандидаты)
    если похожее_ != "" {
        вернуть рт(ошибка(с, у, "неизвестный тип «" + имя + "»; возможно, имелось в виду «" + похожее_ + "»"), НЕИЗВ())
    }
    перем собственные = ""
    если с.типы.длина > 0 { собственные = ", собственные типы (" + с.типы.ключи().соединить(", ") + ")" }
    вернуть рт(ошибка(с, у, "неизвестный тип «" + имя + "»; доступны типы: " + типы.встроенные_типы().соединить(", ")
        + собственные + ", списки, например [цел], и необязательные значения, например стр?"), НЕИЗВ())
}

функ можно_вывести(с: Сост, т: стр) -> лог {
    если (встроенный_тип(т) или т == НЕИЗВ() или с.типы.содержит(т) или с.перечисления.содержит(т)
            или с.параметры_типов.содержит(т)) {
        вернуть истина
    }
    если типы.это_словарь(т) { вернуть можно_вывести(с, типы.значение_словаря(т)) }
    если типы.это_необяз(т) { вернуть можно_вывести(с, типы.основа(т)) }
    вернуть типы.это_список(т) и можно_вывести(с, типы.элемент(т))
}

тип ИтогСравнимости {
    да: лог
    в_работе: [стр]
}

/// Можно ли сравнивать значения типа на равенство (==, «содержит», «найти»).
функ сравнимый(с: Сост, т: стр) -> лог {
    вернуть сравнимый_в(с, т, []).да
}

функ сравнимый_в(с: Сост, т: стр, исходные: [стр]) -> ИтогСравнимости {
    перем в_работе = исходные
    если сравнимые().содержит(т) { вернуть ИтогСравнимости(истина, в_работе) }
    если с.параметры_типов.содержит(т) { вернуть ИтогСравнимости(с.параметры_типов[т].содержит("Сравнимое"), в_работе) }
    если типы.это_необяз(т) { вернуть сравнимый_в(с, типы.основа(т), в_работе) }
    если типы.это_список(т) { вернуть сравнимый_в(с, типы.элемент(т), в_работе) }
    если типы.это_словарь(т) { вернуть сравнимый_в(с, типы.значение_словаря(т), в_работе) }
    если с.типы.содержит(т) {
        если в_работе.содержит(т) { вернуть ИтогСравнимости(истина, в_работе) }    // рекурсивный тип
        в_работе.добавить(т)
        для п в с.типы[т] {
            пусть р = сравнимый_в(с, п.т, в_работе)
            в_работе = р.в_работе
            если не р.да { вернуть ИтогСравнимости(ложь, в_работе) }
        }
        вернуть ИтогСравнимости(истина, в_работе)
    }
    если с.перечисления.содержит(т) {
        если в_работе.содержит(т) { вернуть ИтогСравнимости(истина, в_работе) }
        в_работе.добавить(т)
        для вариант в с.перечисления[т] {
            для п в вариант.поля {
                пусть р = сравнимый_в(с, п.т, в_работе)
                в_работе = р.в_работе
                если не р.да { вернуть ИтогСравнимости(ложь, в_работе) }
            }
        }
        вернуть ИтогСравнимости(истина, в_работе)
    }
    вернуть ИтогСравнимости(ложь, в_работе)
}

/// Запрет изменения: что нельзя изменять (в винительном падеже; "" - временное значение) и почему.
тип Запрет {
    есть: лог
    что: стр = ""
    почему: стр = ""
}

/// Можно ли изменять значение по этому месту (переменная, её поле или элемент).
функ место(исходное: Сост, у: разбор.Узел) -> Запрет {
    перем с = исходное
    если у.вид == "Имя" {
        пусть н = найти(с, у.текст, истина)
        если не н.есть или н.п.изменяемая { вернуть Запрет(ложь) }
        перем имя = у.написание
        если имя == "" { имя = у.текст }
        выбор н.п.вид {
            "параметр" {
                вернуть Запрет(истина, "параметр «" + имя + "»", "функция получает копию значения и не может изменить "
                    + "переменную вызывающей стороны; изменённое значение функция может вернуть")
            }
            "цикл" {
                вернуть Запрет(истина, "переменную цикла «" + имя + "»", "она сама получает новое значение на каждом шаге цикла")
            }
            "захват" {
                вернуть Запрет(истина, "переменную «" + имя + "»", "безымянная функция получила её копию в момент создания; "
                    + "изменить переменную снаружи из функции нельзя - верните новое значение как результат")
            }
            "значение" {
                вернуть Запрет(истина, "значение «" + имя + "»", "оно получено в «если пусть»; чтобы изменять его, "
                    + "скопируйте его в переменную: «перем копия = " + имя + "»")
            }
            иначе {
                вернуть Запрет(истина, "переменную «" + имя + "»", "она объявлена через «пусть»; если её нужно менять, "
                    + "объявите её через «перем " + имя + " = ...»")
            }
        }
    }
    если у.вид == "Поле" и с.типы.содержит(тип_узла(ч(у, "объект"))) { вернуть место(с, ч(у, "объект")) }
    если (у.вид == "Индекс" и (типы.это_список(тип_узла(ч(у, "объект"))) или типы.это_словарь(тип_узла(ч(у, "объект"))))
            и пом(у, "срез") == "") {
        вернуть место(с, ч(у, "объект"))
    }
    вернуть Запрет(истина, "", "изменить можно только значение в переменной «перем», его поле или элемент списка, "
        + "а здесь временное значение")
}

/// Текст ошибки: «действие» невозможно по причине запрета.
функ текст_запрета(действие: стр, з: Запрет) -> стр {
    если з.что == "" { вернуть действие + ": " + з.почему }
    вернуть действие + ", так как " + з.что + " изменять нельзя: " + з.почему
}

функ ошибка_необяз(с: Сост, у: разбор.Узел, т: стр, что: стр) -> Сост {
    если типы.это_результат(т) {
        вернуть ошибка(с, у, что + ": значение типа " + т + " может оказаться ошибкой; передайте ошибку дальше "
            + "знаком «!» («ф()!»), задайте запасное значение («... иначе запасное») "
            + "или проверьте: «если пусть знач = ... { } иначе ошибка о { }»")
    }
    вернуть ошибка(с, у, что + ": значение типа " + т + " может отсутствовать (быть «ничего»); "
        + "сначала проверьте его: «если пусть знач = ... { }» "
        + "или задайте запасное значение: «... иначе запасное»")
}

/// Отмечает, что числовое значение узла надо привести к типу «к_типу».
функ привести(у: разбор.Узел, т: стр, к_типу: стр) -> разбор.Узел {
    пусть числа_мн = ["цел", "рац", "дроб", "мн"]
    если ((числа_мн.содержит(т) и числа_мн.содержит(к_типу) и т != к_типу) или (т == "цел" и к_типу == "длинное")
            или (число(т) и к_типу == "компл") или типы.расширяемый_список(т, к_типу)) {
        вернуть с_пом(у, "привести_к", к_типу)
    }
    вернуть без_пом(у, "привести_к")
}

функ рсу(с: Сост, у: разбор.Узел, да: лог) -> Р { вернуть Р(с, у, "", да) }

/// Подходит ли значение туда, где ждут тип «ожидаемый». Запись списка или словаря подстраивается
/// под ожидаемый тип, безымянная функция без типов параметров получает их; найденное
/// записывается в узел.
функ согласовать(исходное: Сост, исходный: разбор.Узел, т_исх: стр, ожидаемый: стр) -> Р {
    перем с = исходное
    перем у = исходный
    перем т = т_исх
    если у.вид == "Лямбда" и т == ОТЛОЖЕННАЯ() {
        если не типы.это_функция(ожидаемый) { вернуть рсу(с, у, ложь) }
        пусть ф = типы.разобрать_тип_функции(ожидаемый)
        если ф.параметры.длина != гр(у, "параметры").длина { вернуть рсу(с, у, ложь) }
        пусть р = лямбда(с, у, ф.параметры, истина, ф.результат, истина)
        вернуть рсу(р.с, с_пом(р.у, "тип_выр", р.т), р.т == ожидаемый)
    }
    если (т.оканчивается("<>") и пом(у, "отложенный") != "" и ожидаемый.оканчивается(">")
            и ожидаемый.начинается(типы.основа(т))) {
        вернуть достроить(с, у, ожидаемый)
    }
    у = без_пом(без_пом(у, "в_необяз"), "в_результат")
    если типы.это_результат(ожидаемый) и т != НЕИЗВ() и т != ожидаемый {
        если т == "ошибка" { вернуть рсу(с, с_пом(у, "в_результат", ожидаемый), истина) }
        если типы.основа(ожидаемый) != ПУСТО() {
            пусть р = согласовать(с, у, т, типы.основа(ожидаемый))
            если р.да { вернуть рсу(р.с, с_пом(р.у, "в_результат", ожидаемый), истина) }
            вернуть рсу(р.с, р.у, ложь)
        }
        вернуть рсу(с, у, ложь)
    }
    если типы.это_необяз(ожидаемый) и т != НЕИЗВ() и т != ожидаемый {
        если т == "ничего" { вернуть рсу(с, с_пом(у, "в_необяз", ожидаемый), истина) }
        пусть р = согласовать(с, у, т, типы.основа(ожидаемый))
        если р.да { вернуть рсу(р.с, с_пом(р.у, "в_необяз", ожидаемый), истина) }
        вернуть рсу(р.с, р.у, ложь)
    }
    если у.вид == "Словарь" и типы.это_словарь(ожидаемый) и (т != НЕИЗВ() или пом(у, "ждёт_типа") != "") {
        пусть т_к = типы.ключ_словаря(ожидаемый)
        пусть т_з = типы.значение_словаря(ожидаемый)
        перем ключи = гр(у, "ключи")
        для н в 0..ключи.длина - 1 {
            пусть р = согласовать(с, ключи[н], тип_узла(ключи[н]), т_к)
            с = р.с
            ключи[н] = р.у
            если не р.да { вернуть рсу(с, с_группой(у, "ключи", ключи), ложь) }
        }
        у = с_группой(у, "ключи", ключи)
        перем значения = гр(у, "значения")
        для н в 0..значения.длина - 1 {
            пусть р = согласовать(с, значения[н], тип_узла(значения[н]), т_з)
            с = р.с
            значения[н] = р.у
            если не р.да { вернуть рсу(с, с_группой(у, "значения", значения), ложь) }
        }
        у = без_пом(с_пом(с_группой(у, "значения", значения), "тип_выр", ожидаемый), "ждёт_типа")
        если с.отложенные.содержит(ключ_отложенной(с, у)) { с.отложенные.удалить(ключ_отложенной(с, у)) }
        вернуть рсу(с, у, истина)
    }
    если у.вид == "Список" и типы.это_список(ожидаемый) и (т != НЕИЗВ() или пом(у, "ждёт_типа") != "") {
        пусть т_эл = типы.элемент(ожидаемый)
        перем элементы = гр(у, "элементы")
        для н в 0..элементы.длина - 1 {
            пусть р = согласовать(с, элементы[н], тип_узла(элементы[н]), т_эл)
            с = р.с
            элементы[н] = р.у
            если не р.да { вернуть рсу(с, с_группой(у, "элементы", элементы), ложь) }
        }
        у = без_пом(с_пом(с_группой(у, "элементы", элементы), "тип_выр", ожидаемый), "ждёт_типа")
        если с.отложенные.содержит(ключ_отложенной(с, у)) { с.отложенные.удалить(ключ_отложенной(с, у)) }
        вернуть рсу(с, у, истина)
    }
    пусть подходит = типы.совместим(т, ожидаемый)
    перем к = т
    если подходит { к = ожидаемый }
    вернуть рсу(с, привести(у, т, к), подходит)
}

// ---------- программа ----------

/// Проверенная программа: дерево с пометками, ошибки и предупреждения.
общий тип Итог {
    дерево: разбор.Узел
    ошибки: [Сообщение]
    предупреждения: [Сообщение]
    /// объявления программы (типы, перечисления, написания, внешние функции) для порождения кода
    с: Сост
}

/// Ошибки по порядку строк и позиций (при равных - в порядке нахождения).
функ упорядочить_ошибки(ошибки: [Сообщение]) -> [Сообщение] {
    перем итог: [Сообщение] = []
    для о в ошибки {
        перем место_ = итог.длина
        пока (место_ > 0 и (итог[место_ - 1].строка > о.строка
                или (итог[место_ - 1].строка == о.строка и итог[место_ - 1].столбец > о.столбец))) {
            место_ -= 1
        }
        итог.вставить(место_, о)
    }
    вернуть итог
}

/// Проверяет дерево программы (со всеми подключёнными модулями).
общий функ проверить(программа: разбор.Узел, таблицы: встроенные.Таблицы) -> Итог {
    перем с = Сост(таблицы)
    перем инструкции = гр(программа, "инструкции")
    // первый проход: собственные типы и все функции, чтобы их можно было использовать до объявления
    с = собрать_обобщённые(с, инструкции)
    перем ожидаемые: [стр] = []          // названия перечислений нужны раньше полей типов
    для и_ в инструкции {
        если и_.вид == "ОбъявлениеВариантов" и не с.перечисления.содержит(св(и_, "имя")) и не есть(и_, "параметры_типа") {
            с.перечисления[св(и_, "имя")] = []
            ожидаемые.добавить(св(и_, "имя"))
        }
    }
    с = собрать_типы(с, инструкции)
    для имя в ожидаемые {
        если с.перечисления.содержит(имя) { с.перечисления.удалить(имя) }
    }
    с = собрать_перечисления(с, инструкции)
    с = проверить_интерфейсы(с, инструкции)
    с = проверить_обобщённые_типы(с)
    для и_ в инструкции {
        если и_.вид == "ВнешнийБлок" { с = собрать_внешние(с, и_) }
    }
    для н в 0..инструкции.длина - 1 {
        пусть и_ = инструкции[н]
        если и_.вид != "Функция" { продолжить }
        если есть(и_, "параметры_типа") и св(и_, "метод_типа") != "" {
            пусть р = собрать_обобщённый_метод(с, и_)
            с = р.с
            инструкции[н] = р.у
        } иначе если есть(и_, "параметры_типа") {
            с = собрать_шаблон(с, и_)
        } иначе если св(и_, "метод_типа") != "" {
            пусть р = собрать_метод(с, и_)
            с = р.с
            инструкции[н] = р.у
        } иначе {
            пусть имя = св(и_, "имя")
            если с.типы.содержит(имя) {
                с = ошибка(с, и_, "имя «" + имя + "» уже занято типом")
                продолжить
            }
            если встроенное(имя) {
                с = ошибка(с, и_, "«" + имя + "» - встроенная функция, объявить её заново нельзя")
                продолжить
            }
            если с.функции.содержит(имя) {
                с = ошибка(с, и_, "функция «" + имя + "» уже объявлена")
                продолжить
            }
            пусть р = сигнатура_функции(с, и_)
            с = р.с
            с.функции[имя] = р.сигн
        }
    }
    // второй проход: тела функций и инструкции верхнего уровня
    с = новая_область(с)
    для н в 0..инструкции.длина - 1 {
        пусть и_ = инструкции[н]
        если и_.вид == "Функция" и есть(и_, "параметры_типа") {
            пусть р = проверить_шаблон(с, и_)
            с = р.с
            инструкции[н] = р.у
        } иначе если и_.вид == "Функция" {
            пусть р = функция(с, и_, Сигн([], ""), ложь)
            с = р.с
            инструкции[н] = р.у
        } иначе если и_.вид == "ОбъявлениеТипа" {
            если не есть(и_, "параметры_типа") {
                пусть р = значения_по_умолчанию(с, и_)
                с = р.с
                инструкции[н] = р.у
            }
        } иначе если и_.вид == "ОбъявлениеВариантов" или и_.вид == "ОбъявлениеИнтерфейса" или и_.вид == "ВнешнийБлок" {
        } иначе {
            пусть р = инструкция(с, и_)
            с = р.с
            инструкции[н] = р.у
        }
    }
    с = убрать_область(с)
    // обобщённые функции и типы сами в программу не входят: вместо них - их варианты для конкретных типов
    перем итог: [разбор.Узел] = []
    для и_ в инструкции {
        если и_.вид != "ОбъявлениеИнтерфейса" и не есть(и_, "параметры_типа") { итог.добавить(и_) }
    }
    для ф в с.новые_функции { итог.добавить(ф) }
    для о в с.отложенные.значения() { с.ошибки.добавить(о) }
    пусть ошибки = упорядочить_ошибки(с.ошибки)
    вернуть Итог(с_группой(программа, "инструкции", итог), ошибки, с.предупреждения, с)
}

тип РС {
    с: Сост
    сигн: Сигн
}

/// Сигнатура функции программы по типам параметров и результата.
функ сигнатура_функции(исходное: Сост, ф: разбор.Узел) -> РС {
    перем с = исходное
    перем параметры: [стр] = []
    перем имена: [стр] = []
    для п в гр(ф, "параметры") {
        пусть р = тип_по_имени(с, п, св(п, "тип"))
        с = р.с
        параметры.добавить(р.т)
        имена.добавить(св(п, "имя"))
    }
    перем результат = ПУСТО()
    если св(ф, "тип_результата") != "" {
        пусть р = тип_по_имени(с, ф, св(ф, "тип_результата"))
        с = р.с
        результат = р.т
    }
    вернуть РС(с, Сигн(параметры, результат, имена))
}

функ собрать_перечисления(исходное: Сост, инструкции: [разбор.Узел]) -> Сост {
    перем с = исходное
    перем объявления: [разбор.Узел] = []
    для и_ в инструкции {
        если и_.вид == "ОбъявлениеВариантов" и не есть(и_, "параметры_типа") { объявления.добавить(и_) }
    }
    для о в объявления {
        пусть имя = св(о, "имя")
        если встроенный_тип(имя) или встроенное(имя) или с.перечисления.содержит(имя) {
            с = ошибка(с, о, "название «" + имя + "» уже занято")
            продолжить
        }
        с.перечисления[имя] = []
        с.написания[имя] = написание_или(св(о, "написание"), имя)
        для в_ в гр(о, "варианты") {
            пусть вариант = св(в_, "имя")
            если (с.вариант_тип.содержит(вариант) или встроенный_тип(вариант) или встроенное(вариант)
                    или с.обобщённые_варианты.содержит(вариант)) {
                с = ошибка(с, в_, "вариант «" + вариант + "» уже есть в другом типе или это занятое название")
                продолжить
            }
            с.вариант_тип[вариант] = имя
            с.написания[имя + "|" + вариант] = написание_или(св(в_, "написание"), вариант)
            для п в гр(в_, "поля") {
                с.написания[имя + "|" + вариант + "|" + св(п, "имя")] = написание_или(св(п, "написание"), св(п, "имя"))
            }
        }
    }
    для о в объявления {
        пусть имя = св(о, "имя")
        если не с.перечисления.содержит(имя) или с.перечисления[имя].длина > 0 { продолжить }
        для в_ в гр(о, "варианты") {
            пусть вариант = св(в_, "имя")
            если с.вариант_тип.получить(вариант, "") != имя { продолжить }
            перем поля: [ПолеТ] = []
            для п в гр(в_, "поля") {
                пусть р = тип_по_имени(с, п, св(п, "тип"))
                с = р.с
                поля.добавить(ПолеТ(св(п, "имя"), р.т))
            }
            с.перечисления[имя].добавить(ВариантТ(вариант, поля))
        }
    }
    вернуть с
}

функ написание_или(написание: стр, имя: стр) -> стр {
    если написание == "" { вернуть имя }
    вернуть написание
}

функ собрать_типы(исходное: Сост, инструкции: [разбор.Узел]) -> Сост {
    перем с = исходное
    перем объявления: [разбор.Узел] = []
    для и_ в инструкции {
        если и_.вид == "ОбъявлениеТипа" и не есть(и_, "параметры_типа") { объявления.добавить(и_) }
    }
    для о в объявления {
        пусть имя = св(о, "имя")
        если с.перечисления.содержит(имя) или с.вариант_тип.содержит(имя) {
            с = ошибка(с, о, "название «" + имя + "» уже занято перечислением или его вариантом")
        }
    }
    для о в объявления {
        пусть имя = св(о, "имя")
        если встроенный_тип(имя) или встроенное(имя) {
            с = ошибка(с, о, "«" + имя + "» - встроенный тип или функция, такое название занято")
        } иначе если с.обобщённые_типы.содержит(имя) или с.интерфейсы.содержит(имя) {
            с = ошибка(с, о, "название «" + имя + "» уже занято")
        } иначе если с.типы.содержит(имя) {
            с = ошибка(с, о, "тип «" + имя + "» уже объявлен")
        } иначе {
            с.типы[имя] = []
        }
    }
    перем принятые: [разбор.Узел] = []
    перем встречены: [стр] = []
    для о в объявления {
        пусть имя = св(о, "имя")
        если с.типы.содержит(имя) и с.типы[имя].длина == 0 и не встречены.содержит(имя) { принятые.добавить(о) }
        встречены.добавить(имя)
    }
    для о в принятые {
        пусть имя = св(о, "имя")
        перем поля: [ПолеТ] = []
        для п в гр(о, "поля") {
            пусть р = тип_по_имени(с, п, св(п, "тип"))
            с = р.с
            поля.добавить(ПолеТ(св(п, "имя"), р.т, гр(п, "по_умолчанию")))
        }
        с.типы[имя] = поля
        с.написания[имя] = написание_или(св(о, "написание"), имя)
        для п в гр(о, "поля") {
            с.написания[имя + "|" + св(п, "имя")] = написание_или(св(п, "написание"), св(п, "имя"))
        }
    }
    // значение не может содержать само себя целиком (иначе оно бесконечно)
    для о в принятые {
        пусть имя = св(о, "имя")
        пусть путь = цикл_типа(с, имя, имя, [], [])
        если путь.длина > 0 {
            с = ошибка(с, о, "тип «" + имя + "» содержит сам себя (через " + путь.соединить(" -> ") + "); "
                + "такое значение было бы бесконечным. Сделайте поле необязательным "
                + "(«след: " + имя + "?») или храните вложенные значения в списке "
                + "(«дети: [" + имя + "]»)")
        }
    }
    вернуть с
}

тип ПутьЦикла {
    путь: [стр]
    посещённые: [стр]
}

/// Путь по полям от типа к искомому (пустой - цикла нет).
функ цикл_типа(с: Сост, искомый: стр, т: стр, путь: [стр], посещённые: [стр]) -> [стр] {
    вернуть цикл_типа_в(с, искомый, т, путь, посещённые).путь
}

функ цикл_типа_в(с: Сост, искомый: стр, т: стр, путь: [стр], исходные: [стр]) -> ПутьЦикла {
    перем посещённые = исходные
    если посещённые.содержит(т) { вернуть ПутьЦикла([], посещённые) }
    посещённые.добавить(т)
    если не с.типы.содержит(т) { вернуть ПутьЦикла([], посещённые) }
    для п в с.типы[т] {
        // необязательное поле может быть пустым, поэтому значение конечно
        если типы.это_необяз(п.т) { продолжить }
        перем дальше = путь
        дальше.добавить("поле «" + п.имя + "»")
        если п.т == искомый { вернуть ПутьЦикла(дальше, посещённые) }
        если с.типы.содержит(п.т) {
            пусть р = цикл_типа_в(с, искомый, п.т, дальше, посещённые)
            посещённые = р.посещённые
            если р.путь.длина > 0 { вернуть р }
        }
    }
    вернуть ПутьЦикла([], посещённые)
}

/// Значения полей по умолчанию вычисляются без доступа к переменным программы.
функ значения_по_умолчанию(исходное: Сост, о: разбор.Узел) -> Р {
    перем с = исходное
    пусть внешние = с.области
    с.области = [пустая_область()]
    пусть имя_типа = св(о, "имя")
    перем поля = гр(о, "поля")
    для н в 0..поля.длина - 1 {
        пусть п = поля[н]
        если не есть(п, "по_умолчанию") { продолжить }
        перем тип_поля = НЕИЗВ()
        если с.типы.содержит(имя_типа) и с.типы[имя_типа].длина > 0 {
            пусть р = тип_по_имени(с, п, св(п, "тип"))
            с = р.с
            тип_поля = р.т
        }
        пусть рв = выражение(с, ч(п, "по_умолчанию"))
        с = рв.с
        пусть рс = согласовать(с, рв.у, рв.т, тип_поля)
        с = рс.с
        если не рс.да {
            с = ошибка(с, рс.у, "поле «" + св(п, "имя") + "» имеет тип " + тип_поля + ", а значение по умолчанию имеет тип " + рв.т)
        }
        поля[н] = с_частью(п, "по_умолчанию", рс.у)
        // проверенное значение нужно и порождению кода: оно хранится в описании типа
        если с.типы.содержит(имя_типа) {
            для к в 0..с.типы[имя_типа].длина - 1 {
                если с.типы[имя_типа][к].имя == св(п, "имя") { с.типы[имя_типа][к].по_умолчанию = [рс.у] }
            }
        }
    }
    с.области = внешние
    вернуть Р(с, с_группой(о, "поля", поля))
}

// ---------- обобщённые функции и типы, методы, интерфейсы ----------

/// Интерфейсы вместе с теми, что они включают (Числовое -> Упорядоченное -> Сравнимое).
функ замыкание(огр: [стр]) -> [стр] {
    перем итог: [стр] = []
    для о в огр {
        если не итог.содержит(о) { итог.добавить(о) }
        для в_ в включённые_интерфейсы(о) {
            если не итог.содержит(в_) { итог.добавить(в_) }
        }
    }
    вернуть похожее.упорядочить(итог)
}

функ ограничения_пт(пт: разбор.Узел) -> [стр] {
    перем итог: [стр] = []
    для о в гр(пт, "ограничения") { итог.добавить(о.простые[0].значение) }
    вернуть итог
}

функ занято_как_тип(с: Сост, имя: стр) -> лог {
    вернуть (встроенный_тип(имя) или с.типы.содержит(имя) или с.перечисления.содержит(имя) или с.обобщённые_типы.содержит(имя)
        или с.интерфейсы.содержит(имя) или встроенные_интерфейсы().содержит(имя) или с.вариант_тип.содержит(имя)
        или с.обобщённые_варианты.содержит(имя))
}

тип РП {
    с: Сост
    параметры: {стр: [стр]}
}

/// Проверяет параметры типа <Т: Интерфейс, ...> и возвращает {имя: интерфейсы}.
функ параметры_типа(исходное: Сост, пт_: [разбор.Узел]) -> РП {
    перем с = исходное
    перем итог: {стр: [стр]} = {}
    для п в пт_ {
        пусть имя = св(п, "имя")
        если занято_как_тип(с, имя) {
            с = ошибка(с, п, "имя параметра типа «" + имя + "» совпадает с названием типа или интерфейса; "
                + "выберите другое, например Т")
        }
        для о в ограничения_пт(п) {
            если не встроенные_интерфейсы().содержит(о) и не с.интерфейсы.содержит(о) {
                перем известные = встроенные_интерфейсы()
                для и_ в с.интерфейсы.ключи() { известные.добавить(и_) }
                с = ошибка(с, п, "неизвестный интерфейс «" + о + "»" + подсказка(о, известные) + "; "
                    + "встроенные интерфейсы: " + встроенные_интерфейсы().соединить(", "))
            }
        }
        итог[имя] = замыкание(ограничения_пт(п))
    }
    вернуть РП(с, итог)
}

/// Подстановки с параметрами типа (Пара<Т, цел>) нужны только при проверке обобщённого кода.
функ убрать_временные(исходное: Сост) -> Сост {
    перем с = исходное
    для т в с.временные_типы {
        если с.типы.содержит(т) { с.типы.удалить(т) }
        если с.перечисления.содержит(т) { с.перечисления.удалить(т) }
    }
    с.временные_типы = []
    вернуть с
}

функ собрать_обобщённые(исходное: Сост, инструкции: [разбор.Узел]) -> Сост {
    перем с = исходное
    для и_ в инструкции {
        пусть имя = св(и_, "имя")
        если и_.вид == "ОбъявлениеИнтерфейса" {
            если встроенный_тип(имя) или встроенные_интерфейсы().содержит(имя) или с.интерфейсы.содержит(имя) {
                с = ошибка(с, и_, "название «" + имя + "» уже занято")
                продолжить
            }
            с.интерфейсы[имя] = {}
            с.написания[имя] = написание_или(св(и_, "написание"), имя)
        } иначе если (и_.вид == "ОбъявлениеТипа" или и_.вид == "ОбъявлениеВариантов") и есть(и_, "параметры_типа") {
            если (встроенный_тип(имя) или встроенное(имя) или с.обобщённые_типы.содержит(имя)
                    или встроенные_интерфейсы().содержит(имя)) {
                с = ошибка(с, и_, "название «" + имя + "» уже занято")
                продолжить
            }
            с.обобщённые_типы[имя] = и_
            с.написания[имя] = написание_или(св(и_, "написание"), имя)
            если и_.вид == "ОбъявлениеВариантов" {
                для в_ в гр(и_, "варианты") {
                    если с.обобщённые_варианты.содержит(св(в_, "имя")) {
                        с = ошибка(с, в_, "вариант «" + св(в_, "имя") + "» уже есть в другом типе")
                    }
                    с.обобщённые_варианты[св(в_, "имя")] = имя
                }
            }
        }
    }
    вернуть с
}

функ проверить_интерфейсы(исходное: Сост, инструкции: [разбор.Узел]) -> Сост {
    перем с = исходное
    перем проверенные: [стр] = []
    для и_ в инструкции {
        пусть имя = св(и_, "имя")
        если и_.вид != "ОбъявлениеИнтерфейса" или не с.интерфейсы.содержит(имя) или проверенные.содержит(имя) { продолжить }
        проверенные.добавить(имя)
        с.параметры_типов = {"Сам": []}
        перем методы: {стр: Сигн} = {}
        для м в гр(и_, "методы") {
            перем параметры: [стр] = []
            для п в гр(м, "параметры") {
                пусть р = тип_по_имени(с, п, св(п, "тип"))
                с = р.с
                параметры.добавить(р.т)
            }
            перем результат = ПУСТО()
            если св(м, "тип_результата") != "" {
                пусть р = тип_по_имени(с, м, св(м, "тип_результата"))
                с = р.с
                результат = р.т
            }
            методы[св(м, "имя")] = Сигн(параметры, результат)
        }
        с.параметры_типов = {}
        с = убрать_временные(с)
        с.интерфейсы[имя] = методы
    }
    вернуть с
}

/// Поля обобщённого типа: у перечисления - поля всех вариантов.
функ поля_шаблона(ш: разбор.Узел) -> [разбор.Узел] {
    если ш.вид == "ОбъявлениеТипа" { вернуть гр(ш, "поля") }
    перем итог: [разбор.Узел] = []
    для в_ в гр(ш, "варианты") {
        для п в гр(в_, "поля") { итог.добавить(п) }
    }
    вернуть итог
}

функ проверить_обобщённые_типы(исходное: Сост) -> Сост {
    перем с = исходное
    для имя в с.обобщённые_типы.ключи() {
        пусть ш = с.обобщённые_типы[имя]
        пусть рп = параметры_типа(с, гр(ш, "параметры_типа"))
        с = рп.с
        с.параметры_типов = рп.параметры
        пусть поля = поля_шаблона(ш)
        для п в поля {
            с = тип_по_имени(с, п, св(п, "тип")).с
        }
        если ш.вид == "ОбъявлениеТипа" {
            для пт в гр(ш, "параметры_типа") {
                перем встречается = ложь
                для п в поля {
                    если типы.имена_в_типе(св(п, "тип")).содержит(св(пт, "имя")) { встречается = истина }
                }
                если не встречается {
                    с = ошибка(с, пт, "параметр типа «" + св(пт, "имя") + "» не встречается в полях типа «" + имя + "»; "
                        + "по полям он определяется при создании значения")
                }
            }
        }
        с.параметры_типов = {}
        с = убрать_временные(с)
    }
    вернуть с
}

/// Тип, полученный подстановкой: Пара<цел, стр> из «тип Пара<А, Б>».
функ экземпляр_типа(исходное: Сост, у: разбор.Узел, имя: стр, аргументы: [стр]) -> Р {
    перем с = исходное
    пусть ш = с.обобщённые_типы[имя]
    перем имена: [стр] = []
    для п в гр(ш, "параметры_типа") { имена.добавить(св(п, "имя")) }
    если аргументы.длина != имена.длина {
        вернуть рт(ошибка(с, у, "у типа «" + имя + "» " + склонение_параметров(имена.длина) + " типа: " + имя + "<"
            + имена.соединить(", ") + ">, а указано " + стр(аргументы.длина)), НЕИЗВ())
    }
    пусть пт_ = гр(ш, "параметры_типа")
    для н в 0..пт_.длина - 1 {
        для о в замыкание(ограничения_пт(пт_[н])) {
            пусть в_ = выполняет(с, аргументы[н], о)
            если не в_.есть {
                вернуть рт(ошибка(с, у, "тип «" + имя + "» требует, чтобы " + имена[н] + " выполнял интерфейс " + о
                    + ", а " + имена[н] + " = " + аргументы[н] + ": " + в_.почему), НЕИЗВ())
            }
        }
    }
    пусть полное = имя + "<" + аргументы.соединить(", ") + ">"
    если с.типы.содержит(полное) или с.перечисления.содержит(полное) { вернуть рт(с, полное) }
    перем связи: {стр: стр} = {}
    для н в 0..имена.длина - 1 { связи[имена[н]] = аргументы[н] }
    перем временный = ложь
    для а в аргументы {
        если типы.содержит_имена(а, с.параметры_типов.ключи()) { временный = истина }
    }
    если временный и не с.временные_типы.содержит(полное) { с.временные_типы.добавить(полное) }
    с.написания[полное] = с.написания.получить(имя, имя)
    если ш.вид == "ОбъявлениеТипа" {
        с.типы[полное] = []          // на случай полей того же типа
        перем поля: [ПолеТ] = []
        для п в гр(ш, "поля") {
            пусть р = тип_по_имени(с, п, типы.подставить(св(п, "тип"), связи))
            с = р.с
            поля.добавить(ПолеТ(св(п, "имя"), р.т, гр(п, "по_умолчанию")))
            с.написания[полное + "|" + св(п, "имя")] = написание_или(св(п, "написание"), св(п, "имя"))
        }
        с.типы[полное] = поля
        пусть путь = цикл_типа(с, полное, полное, [], [])
        если путь.длина > 0 {
            с = ошибка(с, у, "тип «" + полное + "» содержит сам себя (через " + путь.соединить(" -> ") + "); "
                + "такое значение было бы бесконечным")
        }
        перем умолчания: [разбор.Узел] = []
        для п в поля {
            перем поле = разбор.Узел("ПолеТипа", [разбор.Свойство("имя", п.имя), разбор.Свойство("тип", п.т)], [],
                                     у.строка, у.столбец)
            если п.по_умолчанию.длина > 0 { поле = с_частью(поле, "по_умолчанию", п.по_умолчанию[0]) }
            умолчания.добавить(поле)
        }
        пусть прежняя_копия = с.копия
        с.копий += 1
        с.копия = с.копий
        с = значения_по_умолчанию(с, разбор.Узел("ОбъявлениеТипа", [разбор.Свойство("имя", полное)],
                                                 [разбор.группа("поля", умолчания)])).с
        с.копия = прежняя_копия
    } иначе {
        с.перечисления[полное] = []
        перем варианты: [ВариантТ] = []
        для в_ в гр(ш, "варианты") {
            пусть вариант = св(в_, "имя")
            с.написания[полное + "|" + вариант] = написание_или(св(в_, "написание"), вариант)
            перем поля: [ПолеТ] = []
            для п в гр(в_, "поля") {
                пусть р = тип_по_имени(с, п, типы.подставить(св(п, "тип"), связи))
                с = р.с
                поля.добавить(ПолеТ(св(п, "имя"), р.т))
                с.написания[полное + "|" + вариант + "|" + св(п, "имя")] = написание_или(св(п, "написание"), св(п, "имя"))
            }
            варианты.добавить(ВариантТ(вариант, поля))
        }
        с.перечисления[полное] = варианты
    }
    вернуть рт(с, полное)
}

/// Подходит ли тип к интерфейсу и почему нет.
функ выполняет(с: Сост, т: стр, инт_: стр) -> Запрет {
    если т == НЕИЗВ() { вернуть Запрет(истина) }
    если с.параметры_типов.содержит(т) {
        вернуть Запрет(с.параметры_типов[т].содержит(инт_), "",
            "у параметра типа " + т + " нет ограничения " + инт_ + "; допишите его: <" + т + ": " + инт_ + ">")
    }
    если инт_ == "Сравнимое" {
        вернуть Запрет(сравнимый(с, т), "", "значения этого типа нельзя сравнивать на равенство")
    }
    если ["Упорядоченное", "Числовое", "Ключ"].содержит(инт_) {
        вернуть Запрет(типы_интерфейса(инт_).содержит(т), "", "подходят только типы " + типы_интерфейса(инт_).соединить(", "))
    }
    если с.интерфейсы.содержит(инт_) {
        для м в с.интерфейсы[инт_].ключи() {
            пусть сигн = с.интерфейсы[инт_][м]
            перем нужные: [стр] = []
            для п в сигн.параметры { нужные.добавить(типы.подставить(п, {"Сам": т})) }
            пусть нужный = типы.подставить(сигн.результат, {"Сам": т})
            перем образец = "функ " + т + "." + м + "(" + нужные.соединить(", ") + ")"
            если нужный != ПУСТО() { образец += " -> " + нужный }
            если не с.методы.содержит(т + "|" + м) {
                вернуть Запрет(ложь, "", "у типа " + т + " нет метода «" + м + "»; объявите его: " + образец)
            }
            пусть сигн_м = с.функции[с.методы[т + "|" + м]]
            перем свои: [стр] = []
            для н в 1..сигн_м.параметры.длина - 1 { свои.добавить(сигн_м.параметры[н]) }
            если свои != нужные или сигн_м.результат != нужный {
                вернуть Запрет(ложь, "", "метод «" + м + "» должен быть объявлен так: " + образец)
            }
        }
    }
    вернуть Запрет(истина)
}

/// функ Пара<А, Б>.поменять() - обобщённая функция «Пара.поменять» с параметром сам: Пара<А, Б>.
функ собрать_обобщённый_метод(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем ф = исходный
    пусть т = св(ф, "метод_типа")
    пусть имя = св(ф, "имя")
    если не с.обобщённые_типы.содержит(т) {
        вернуть Р(ошибка(с, ф, "«" + т + "» - не обобщённый тип; метод объявляется так: функ " + т + "." + имя + "(...)"), ф)
    }
    пусть объявленные = гр(с.обобщённые_типы[т], "параметры_типа")
    перем свои = гр(ф, "параметры_типа")
    если объявленные.длина != свои.длина {
        перем имена: [стр] = []
        для п в объявленные { имена.добавить(св(п, "имя")) }
        вернуть Р(ошибка(с, ф, "у типа " + т + " параметров типа " + стр(объявленные.длина) + ": функ " + т + "<"
            + имена.соединить(", ") + ">." + имя + "(...)"), ф)
    }
    // ограничения параметров типа, объявленные у самого типа, действуют и в его методах
    для н в 0..свои.длина - 1 {
        перем огр = гр(свои[н], "ограничения")
        для о в ограничения_пт(объявленные[н]) {
            если не ограничения_пт(свои[н]).содержит(о) и не содержит_элемент(огр, о) { огр.добавить(разбор.элемент(о)) }
        }
        свои[н] = с_группой(свои[н], "ограничения", огр)
    }
    ф = с_группой(ф, "параметры_типа", свои)
    пусть ш = с.обобщённые_типы[т]
    если ш.вид == "ОбъявлениеТипа" {
        для п в гр(ш, "поля") {
            если св(п, "имя") == имя {
                вернуть Р(ошибка(с, ф, "у типа " + т + " уже есть поле «" + имя + "»; метод должен называться иначе"), ф)
            }
        }
    }
    пусть полное = т + "." + имя
    если с.шаблоны.содержит(полное) {
        вернуть Р(ошибка(с, ф, "метод «" + полное + "» уже объявлен"), ф)
    }
    с.методы[т + "|" + имя] = полное
    ф = со_свойством(ф, "имя", полное)
    вернуть Р(собрать_шаблон(с, ф), ф)
}

функ содержит_элемент(элементы: [разбор.Узел], значение_: стр) -> лог {
    для э в элементы {
        если э.простые[0].значение == значение_ { вернуть истина }
    }
    вернуть ложь
}

функ собрать_метод(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем ф = исходный
    пусть т = св(ф, "метод_типа")
    пусть имя = св(ф, "имя")
    если с.обобщённые_типы.содержит(т) {
        перем параметры: [стр] = []
        для п в гр(с.обобщённые_типы[т], "параметры_типа") { параметры.добавить(св(п, "имя")) }
        вернуть Р(ошибка(с, ф, т + " - обобщённый тип; метод объявляется с его параметрами типа: функ " + т + "<"
            + параметры.соединить(", ") + ">." + имя + "(...)"), ф)
    }
    если не с.типы.содержит(т) и не с.перечисления.содержит(т) {
        перем вид = "неизвестный тип"
        если встроенный_тип(т) { вид = "встроенный тип" }
        вернуть Р(ошибка(с, ф, "метод можно объявить только для собственного типа, а «" + т + "» - " + вид), ф)
    }
    если с.типы.содержит(т) {
        для п в с.типы[т] {
            если п.имя == имя {
                вернуть Р(ошибка(с, ф, "у типа " + т + " уже есть поле «" + имя + "»; метод должен называться иначе"), ф)
            }
        }
    }
    пусть полное = т + "." + имя
    если с.функции.содержит(полное) { вернуть Р(ошибка(с, ф, "метод «" + полное + "» уже объявлен"), ф) }
    с.методы[т + "|" + имя] = полное
    ф = со_свойством(ф, "имя", полное)
    пусть р = сигнатура_функции(с, ф)
    с = р.с
    с.функции[полное] = р.сигн
    вернуть Р(с, ф)
}

функ собрать_шаблон(исходное: Сост, ф: разбор.Узел) -> Сост {
    перем с = исходное
    пусть имя = св(ф, "имя")
    если (с.типы.содержит(имя) или встроенное(имя) или с.функции.содержит(имя) или с.шаблоны.содержит(имя)
            или занято_как_тип(с, имя)) {
        вернуть ошибка(с, ф, "имя «" + имя + "» уже занято")
    }
    пусть рп = параметры_типа(с, гр(ф, "параметры_типа"))
    с = рп.с
    с.параметры_типов = рп.параметры
    перем типы_п: [стр] = []
    перем имена: [стр] = []
    для п в гр(ф, "параметры") {
        пусть р = тип_по_имени(с, п, св(п, "тип"))
        с = р.с
        типы_п.добавить(р.т)
        имена.добавить(св(п, "имя"))
    }
    перем результат = св(ф, "тип_результата")
    если результат == "" {
        результат = ПУСТО()
    } иначе если результат != ПУСТО() + "!" {
        пусть р = тип_по_имени(с, ф, результат)
        с = р.с
        результат = р.т
    }
    с.параметры_типов = {}
    с = убрать_временные(с)
    для пт в гр(ф, "параметры_типа") {
        перем встречается = ложь
        для т в типы_п {
            если типы.имена_в_типе(т).содержит(св(пт, "имя")) { встречается = истина }
        }
        если не встречается {
            с = ошибка(с, пт, "параметр типа «" + св(пт, "имя") + "» должен встречаться в типах параметров функции: "
                + "по ним он определяется при вызове")
        }
    }
    с.шаблоны[имя] = Шаблон(ф, рп.параметры, Сигн(типы_п, результат, имена))
    вернуть с
}

/// Тело обобщённой функции проверяется один раз: параметр типа допускает только действия,
/// которые обещают его интерфейсы.
функ проверить_шаблон(исходное: Сост, ф: разбор.Узел) -> Р {
    перем с = исходное
    пусть имя = св(ф, "имя")
    если не с.шаблоны.содержит(имя) или с.шаблоны[имя].узел.строка != ф.строка { вернуть Р(с, ф) }
    пусть шаблон = с.шаблоны[имя]
    с.параметры_типов = шаблон.параметры
    перем все = шаблон.сигн.параметры
    все.добавить(шаблон.сигн.результат)
    для т в все {
        если не т.содержит(НЕИЗВ()) и т != ПУСТО() и т != ПУСТО() + "!" {
            с = тип_по_имени(с, ф, т).с     // подстановки вроде Пара<А, Б> снова нужны для проверки тела
        }
    }
    пусть р = функция(с, ф, шаблон.сигн, истина)
    с = р.с
    с.параметры_типов = {}
    с = убрать_временные(с)
    вернуть Р(с, р.у)
}

/// Подстановка типов в узлы обобщённой функции: типы параметров и переменных, Т(0) -> цел(0).
функ подставить_в_дерево(у: разбор.Узел, связи: {стр: стр}) -> разбор.Узел {
    перем новый = у
    если у.вид == "Вызов" и ч(у, "функция").вид == "Имя" и связи.содержит(ч(у, "функция").текст) {
        перем имя = ч(у, "функция")
        пусть замена = связи[имя.текст]
        имя = со_свойством(имя, "имя", замена)
        имя.текст = замена
        новый = с_частью(новый, "функция", имя)
    }
    перем простые: [разбор.Свойство] = []
    для с_ в новый.простые {
        если с_.имя == "тип" или с_.имя == "тип_результата" {
            простые.добавить(разбор.Свойство(с_.имя, типы.подставить(с_.значение, связи), с_.строкой))
        } иначе {
            простые.добавить(с_)
        }
    }
    новый.простые = простые
    перем группы: [разбор.Узел] = []
    для г в новый.поля {
        перем содержимое: [разбор.Узел] = []
        для вложенный в г.поля {
            если вложенный.вид == "=" {
                содержимое.добавить(вложенный)
            } иначе {
                содержимое.добавить(подставить_в_дерево(вложенный, связи))
            }
        }
        группы.добавить(разбор.группа(г.вид, содержимое))
    }
    новый.поля = группы
    вернуть новый
}

/// Вариант обобщённой функции для конкретных типов: «наибольший<цел>»; "" - слишком глубоко.
функ экземпляр(исходное: Сост, имя: стр, связи: {стр: стр}, у: разбор.Узел) -> Р {
    перем с = исходное
    пусть шаблон = с.шаблоны[имя]
    перем аргументы: [стр] = []
    для п в шаблон.параметры.ключи() { аргументы.добавить(связи[п]) }
    пусть полное = имя + "<" + аргументы.соединить(", ") + ">"
    если с.функции.содержит(полное) { вернуть рт(с, полное) }
    если с.глубина_экземпляров >= 40 {
        вернуть рт(ошибка(с, у, "слишком глубокая цепочка подстановок типов в обобщённую функцию «" + имя + "»: "
            + "функция вызывает себя со всё более сложными типами"), "")
    }
    перем копия = подставить_в_дерево(шаблон.узел, связи)
    копия = с_группой(со_свойством(копия, "имя", полное), "параметры_типа", [])
    пусть рс = сигнатура_обобщённая(с, копия)
    с = рс.с
    с.функции[полное] = рс.сигн
    пусть номер = с.новые_функции.длина
    с.новые_функции.добавить(копия)
    пусть области = с.области
    пусть в_функции = с.в_функции
    пусть функция_имя = с.функция_имя
    пусть функция_результат = с.функция_результат
    пусть глубина_циклов = с.глубина_циклов
    пусть лямбды = с.лямбды
    с.лямбды = []
    с.глубина_циклов = 0
    пусть было = с.ошибки.длина
    с.глубина_экземпляров += 1
    пусть прежняя_копия = с.копия
    с.копий += 1
    с.копия = с.копий
    пусть р = функция(с, копия, Сигн([], ""), ложь)
    с = р.с
    с.копия = прежняя_копия
    с.новые_функции[номер] = р.у
    с.глубина_экземпляров -= 1
    с.области = области
    с.в_функции = в_функции
    с.функция_имя = функция_имя
    с.функция_результат = функция_результат
    с.глубина_циклов = глубина_циклов
    с.лямбды = лямбды
    перем пояснения: [стр] = []
    перем н = 0
    для п в шаблон.параметры.ключи() {
        пояснения.добавить(п + " = " + аргументы[н])
        н += 1
    }
    для к в было..с.ошибки.длина - 1 {
        если с.ошибки[к].текст.содержит(" (в «") { продолжить }    // пояснение уже есть у внутренней подстановки
        с.ошибки[к].текст = с.ошибки[к].текст + " (в «" + имя + "» при " + пояснения.соединить(", ") + ")"
    }
    вернуть рт(с, полное)
}

/// Сигнатура варианта обобщённой функции: результат «пусто!» не разбирается.
функ сигнатура_обобщённая(исходное: Сост, ф: разбор.Узел) -> РС {
    перем с = исходное
    перем параметры: [стр] = []
    перем имена: [стр] = []
    для п в гр(ф, "параметры") {
        пусть р = тип_по_имени(с, п, св(п, "тип"))
        с = р.с
        параметры.добавить(р.т)
        имена.добавить(св(п, "имя"))
    }
    перем результат = св(ф, "тип_результата")
    если результат == "" {
        результат = ПУСТО()
    } иначе если результат != ПУСТО() + "!" {
        пусть р = тип_по_имени(с, ф, результат)
        с = р.с
        результат = р.т
    }
    вернуть РС(с, Сигн(параметры, результат, имена))
}

// ---------- вызовы обобщённых функций и конструкторов ----------

/// Имя аргумента вызова («имя = значение») или "" у позиционного.
функ имена_аргументов(у: разбор.Узел) -> [стр] {
    перем итог: [стр] = []
    для э в гр(у, "имена") {
        если э.простые[0].строкой { итог.добавить(э.простые[0].значение) } иначе { итог.добавить("") }
    }
    вернуть итог
}

функ есть_имена(у: разбор.Узел) -> лог { вернуть гр(у, "имена").длина > 0 }

функ без_имени() -> разбор.Узел { вернуть разбор.Узел("=", [разбор.Свойство("", "None", ложь)]) }

/// Имя с новым названием (Т(0) -> цел(0), метод -> «Тип.метод»).
функ переименовать(у: разбор.Узел, имя: стр) -> разбор.Узел {
    перем новый = со_свойством(у, "имя", имя)
    новый.текст = имя
    вернуть новый
}

тип Порядок {
    с: Сост
    есть: лог
    /// для каждого параметра - номер аргумента или -1 (значение по умолчанию)
    номера: [цел] = []
}

/// Сопоставляет аргументы вызова (позиционные и «имя = значение») с параметрами или полями.
функ сопоставить_аргументы(исходное: Сост, у: разбор.Узел, имена: [стр], по_умолчанию: [лог], чего: стр, вид: стр) -> Порядок {
    перем с = исходное
    перем порядок: [цел] = []
    для к в имена { порядок.добавить(-1) }
    пусть аргументы = гр(у, "аргументы")
    перем имена_арг = имена_аргументов(у)
    если имена_арг.длина == 0 {
        для к в аргументы { имена_арг.добавить("") }
    }
    перем ошибочно = ложь
    для номер в 0..имена_арг.длина - 1 {
        пусть имя_арг = имена_арг[номер]
        если имя_арг == "" {
            если номер >= имена.длина {
                с = ошибка(с, аргументы[номер], "лишний аргумент: у " + чего + " " + склонение_значений(имена.длина))
                ошибочно = истина
                продолжить
            }
            порядок[номер] = номер
        } иначе если не имена.содержит(имя_арг) {
            с = ошибка(с, аргументы[номер], "у " + чего + " нет " + вид + " «" + имя_арг + "»" + подсказка(имя_арг, имена))
            ошибочно = истина
        } иначе если порядок[имена.найти(имя_арг)] != -1 {
            с = ошибка(с, аргументы[номер], "значение «" + имя_арг + "» уже задано")
            ошибочно = истина
        } иначе {
            порядок[имена.найти(имя_арг)] = номер
        }
    }
    перем пропущенные: [стр] = []
    для н в 0..порядок.длина - 1 {
        если порядок[н] == -1 и не по_умолчанию[н] { пропущенные.добавить("«" + имена[н] + "»") }
    }
    если пропущенные.длина > 0 {
        с = ошибка(с, у, "для " + чего + " не задано: " + пропущенные.соединить(", "))
        ошибочно = истина
    }
    вернуть Порядок(с, не ошибочно, порядок)
}

тип Привязка {
    с: Сост
    есть: лог
    связи: {стр: стр} = {}
}

/// Находит параметры типа по парам (тип в объявлении, номер аргумента).
функ связать(исходное: Сост, у: разбор.Узел, что: стр, нужные: [стр], номера: [цел], типы_арг: [стр],
             параметры: [стр]) -> Привязка {
    перем с = исходное
    перем связи: {стр: стр} = {}
    пусть аргументы = гр(у, "аргументы")
    для н в 0..нужные.длина - 1 {
        пусть т = типы_арг[номера[н]]
        если т == ОТЛОЖЕННАЯ() { продолжить }
        пусть прежние = связи
        пусть р = типы.сопоставить(нужные[н], т, параметры, связи)
        связи = р.связи
        если не р.успех {
            перем противоречие: [стр] = []
            пусть имена = типы.имена_в_типе(нужные[н])
            для п в прежние.ключи() {
                если имена.содержит(п) { противоречие.добавить(п + " = " + прежние[п]) }
            }
            перем текст = "значение типа " + т + " не согласуется с другими аргументами " + что
            если противоречие.длина > 0 { текст += " (по ним " + противоречие.соединить(", ") + ")" }
            вернуть Привязка(ошибка(с, аргументы[номера[н]], текст), ложь)
        }
    }
    вернуть Привязка(с, истина, связи)
}

функ ру(с: Сост, у: разбор.Узел, т: стр) -> Р { вернуть Р(с, у, т) }

/// Аргументы в порядке параметров (после именованных аргументов).
функ переставить(у: разбор.Узел, номера: [цел]) -> разбор.Узел {
    пусть аргументы = гр(у, "аргументы")
    перем новые: [разбор.Узел] = []
    для н в номера { новые.добавить(аргументы[н]) }
    вернуть с_группой(с_группой(у, "аргументы", новые), "имена", [])
}

функ переставить_типы(типы_арг: [стр], номера: [цел]) -> [стр] {
    перем новые: [стр] = []
    для н в номера { новые.добавить(типы_арг[н]) }
    вернуть новые
}

функ неизвестные_параметры(параметры: [стр], связи: {стр: стр}) -> [стр] {
    перем итог: [стр] = []
    для п в параметры {
        если не связи.содержит(п) { итог.добавить(п) }
    }
    вернуть итог
}

функ обобщённый_вызов(исходное: Сост, исходный: разбор.Узел, имя: стр, исходные_типы: [стр]) -> Р {
    перем с = исходное
    перем у = исходный
    перем типы_арг = исходные_типы
    пусть шаблон = с.шаблоны[имя]
    пусть сигн = шаблон.сигн
    пусть параметры = шаблон.параметры.ключи()
    с = проверить_устаревание(с, у, имя)
    если есть_имена(у) {
        перем умолч: [лог] = []
        для к в сигн.имена { умолч.добавить(ложь) }
        пусть п = сопоставить_аргументы(с, у, сигн.имена, умолч, "функции «" + имя + "»", "параметра")
        с = п.с
        если не п.есть { вернуть ру(с, у, НЕИЗВ()) }
        у = переставить(у, п.номера)
        типы_арг = переставить_типы(типы_арг, п.номера)
    }
    если типы_арг.длина != сигн.параметры.длина {
        вернуть ру(ошибка(с, у, "функция «" + имя + "» принимает " + склонение_значений(сигн.параметры.длина)
            + ", а передано " + стр(типы_арг.длина)), у, НЕИЗВ())
    }
    если типы_арг.содержит(НЕИЗВ()) { вернуть ру(с, у, НЕИЗВ()) }
    перем номера: [цел] = []
    для н в 0..типы_арг.длина - 1 { номера.добавить(н) }
    пусть пр = связать(с, у, "функции «" + имя + "»", сигн.параметры, номера, типы_арг, параметры)
    с = пр.с
    если не пр.есть { вернуть ру(с, у, НЕИЗВ()) }
    перем связи = пр.связи
    // безымянные функции без типов параметров: типы берутся из уже найденных параметров типа
    перем аргументы = гр(у, "аргументы")
    для номер в 0..аргументы.длина - 1 {
        пусть арг = аргументы[номер]
        если типы_арг[номер] != ОТЛОЖЕННАЯ() или арг.вид != "Лямбда" { продолжить }
        пусть нужен = сигн.параметры[номер]
        пусть ожидаемый = типы.подставить(нужен, связи)
        если не типы.это_функция(ожидаемый) {
            вернуть ру(ошибка(с, арг, "аргумент " + стр(номер + 1) + " функции «" + имя + "» должен иметь тип " + ожидаемый
                + ", а здесь функция"), с_группой(у, "аргументы", аргументы), НЕИЗВ())
        }
        пусть ф = типы.разобрать_тип_функции(ожидаемый)
        пусть неизвестные = неизвестные_параметры(параметры, связи)
        для х в ф.параметры {
            если типы.содержит_имена(х, неизвестные) {
                вернуть ру(ошибка(с, арг, "типы параметров безымянной функции не удаётся определить по другим аргументам; "
                    + "укажите их: функ(х: цел) = ..."), с_группой(у, "аргументы", аргументы), НЕИЗВ())
            }
        }
        если гр(арг, "параметры").длина != ф.параметры.длина {
            вернуть ру(ошибка(с, арг, "функция должна принимать " + склонение_значений(ф.параметры.длина)),
                       с_группой(у, "аргументы", аргументы), НЕИЗВ())
        }
        пусть рл = лямбда(с, арг, ф.параметры, истина, ф.результат, не типы.содержит_имена(ф.результат, неизвестные))
        с = рл.с
        аргументы[номер] = с_пом(рл.у, "тип_выр", рл.т)
        типы_арг[номер] = рл.т
        пусть сп = типы.сопоставить(нужен, рл.т, параметры, связи)
        связи = сп.связи
        если не сп.успех {
            вернуть ру(ошибка(с, аргументы[номер], "функция имеет тип " + рл.т + ", а нужен " + ожидаемый),
                       с_группой(у, "аргументы", аргументы), НЕИЗВ())
        }
    }
    у = с_группой(у, "аргументы", аргументы)
    пусть неизвестные = неизвестные_параметры(параметры, связи)
    если неизвестные.длина > 0 {
        вернуть ру(ошибка(с, у, "по аргументам вызова не удаётся определить " + неизвестные.соединить(", ") + " для «" + имя
            + "»: передайте значения известного типа (пустой список «[]» или «ничего» типа не "
            + "сообщают; сохраните их в переменную с указанным типом)"), у, НЕИЗВ())
    }
    для п в связи.ключи() {
        для о в похожее.упорядочить(шаблон.параметры[п]) {
            пусть т = связи[п]
            пусть в_ = выполняет(с, т, о)
            если не в_.есть {
                пусть описание = описание_интерфейса(о)
                пусть написание = с.написания.получить(т, т)
                пусть причина = в_.почему.заменить("типа " + т + " ", "типа " + написание + " ").заменить("функ " + т + ".",
                                                                                                    "функ " + написание + ".")
                перем текст = "функция «" + имя + "» требует, чтобы тип " + п + " выполнял интерфейс " + о
                если описание != "" { текст += " (" + описание + ")" }
                вернуть ру(ошибка(с, у, текст + ", а " + п + " = " + написание + ": " + причина), у, НЕИЗВ())
            }
        }
    }
    перем нужные: [стр] = []
    для х в сигн.параметры { нужные.добавить(типы.подставить(х, связи)) }
    пусть результат = типы.подставить(сигн.результат, связи)
    перем все = нужные
    все.добавить(результат)
    для т в все {
        если т.содержит("??") или т.содержит("?!") или т.содержит("!?") или т.содержит("!!") {
            вернуть ру(ошибка(с, у, "при подстановке типов получился тип " + т + ": необязательное значение или результат "
                + "внутри другого такого же не допускается"), у, НЕИЗВ())
        }
    }
    если с.параметры_типов.длина == 0 {
        пусть рэ = экземпляр(с, имя, связи, у)
        с = рэ.с
        если рэ.т == "" { вернуть ру(с, у, НЕИЗВ()) }
        у = с_частью(у, "функция", переименовать(ч(у, "функция"), рэ.т))
    }
    аргументы = гр(у, "аргументы")
    для номер в 0..аргументы.длина - 1 {
        пусть р = согласовать(с, аргументы[номер], типы_арг[номер], нужные[номер])
        с = р.с
        аргументы[номер] = р.у
        если не р.да {
            с = ошибка(с, р.у, "аргумент " + стр(номер + 1) + " функции «" + имя + "» должен иметь тип " + нужные[номер]
                + ", а имеет тип " + типы_арг[номер])
        }
    }
    вернуть ру(с, с_группой(у, "аргументы", аргументы), результат)
}

/// Отметка значения, параметры типа которого определит место: «пусть о: Ответ<цел> = Нет».
функ отложить(у: разбор.Узел, вид: стр, шаблон: стр, имя: стр, типы_арг: [стр]) -> разбор.Узел {
    перем новый = с_пом(с_пом(у, "отложенный", вид), "отложенный_шаблон", шаблон)
    новый = с_пом(с_пом(новый, "отложенный_имя", имя), "отложенный_типы", типы_арг.соединить("\n"))
    вернуть новый
}

функ отложенные_типы(у: разбор.Узел) -> [стр] {
    если пом(у, "отложенный_типы") == "" { вернуть [] }
    вернуть пом(у, "отложенный_типы").разбить("\n")
}

функ обобщённый_конструктор(исходное: Сост, у: разбор.Узел, имя: стр, типы_арг: [стр]) -> Р {
    перем с = исходное
    пусть ш = с.обобщённые_типы[имя]
    пусть поля = гр(ш, "поля")
    перем имена: [стр] = []
    перем умолч: [лог] = []
    для п в поля {
        имена.добавить(св(п, "имя"))
        умолч.добавить(есть(п, "по_умолчанию"))
    }
    пусть порядок = сопоставить_аргументы(с, у, имена, умолч, "типа " + имя, "поля")
    с = порядок.с
    если не порядок.есть или типы_арг.содержит(НЕИЗВ()) { вернуть ру(с, у, НЕИЗВ()) }
    перем параметры: [стр] = []
    для п в гр(ш, "параметры_типа") { параметры.добавить(св(п, "имя")) }
    перем нужные: [стр] = []
    перем номера: [цел] = []
    для н в 0..поля.длина - 1 {
        если порядок.номера[н] != -1 {
            нужные.добавить(св(поля[н], "тип"))
            номера.добавить(порядок.номера[н])
        }
    }
    пусть пр = связать(с, у, "типа " + имя, нужные, номера, типы_арг, параметры)
    с = пр.с
    если не пр.есть { вернуть ру(с, у, НЕИЗВ()) }
    если неизвестные_параметры(параметры, пр.связи).длина > 0 {
        вернуть ру(с, отложить(у, "тип", имя, "", типы_арг), имя + "<>")
    }
    перем аргументы_типа: [стр] = []
    для п в параметры { аргументы_типа.добавить(пр.связи[п]) }
    пусть рт_ = экземпляр_типа(с, у, имя, аргументы_типа)
    с = рт_.с
    если рт_.т == НЕИЗВ() { вернуть ру(с, у, НЕИЗВ()) }
    вернуть конструктор(с, у, рт_.т, типы_арг)
}

функ обобщённый_вариант(исходное: Сост, у: разбор.Узел, имя: стр, типы_арг: [стр]) -> Р {
    перем с = исходное
    пусть шаблон = с.обобщённые_варианты[имя]
    пусть ш = с.обобщённые_типы[шаблон]
    перем вариант = разбор.Узел("?")
    для в_ в гр(ш, "варианты") {
        если св(в_, "имя") == имя {
            вариант = в_
            прервать
        }
    }
    пусть поля = гр(вариант, "поля")
    перем имена: [стр] = []
    перем умолч: [лог] = []
    для п в поля {
        имена.добавить(св(п, "имя"))
        умолч.добавить(ложь)
    }
    пусть порядок = сопоставить_аргументы(с, у, имена, умолч, "варианта " + имя, "поля")
    с = порядок.с
    если не порядок.есть или типы_арг.содержит(НЕИЗВ()) { вернуть ру(с, у, НЕИЗВ()) }
    перем параметры: [стр] = []
    для п в гр(ш, "параметры_типа") { параметры.добавить(св(п, "имя")) }
    перем нужные: [стр] = []
    для п в поля { нужные.добавить(св(п, "тип")) }
    пусть пр = связать(с, у, "варианта " + имя, нужные, порядок.номера, типы_арг, параметры)
    с = пр.с
    если не пр.есть { вернуть ру(с, у, НЕИЗВ()) }
    если неизвестные_параметры(параметры, пр.связи).длина > 0 {
        вернуть ру(с, отложить(у, "вариант", шаблон, имя, типы_арг), шаблон + "<>")
    }
    перем аргументы_типа: [стр] = []
    для п в параметры { аргументы_типа.добавить(пр.связи[п]) }
    пусть рт_ = экземпляр_типа(с, у, шаблон, аргументы_типа)
    с = рт_.с
    если рт_.т == НЕИЗВ() { вернуть ру(с, у, НЕИЗВ()) }
    вернуть конструктор_варианта(с, у, имя, типы_арг, рт_.т)
}

/// Значение обобщённого типа, параметры которого определяет место: «пусть о: Ответ<цел> = Нет».
функ достроить(исходное: Сост, исходный: разбор.Узел, т: стр) -> Р {
    перем с = исходное
    пусть вид = пом(исходный, "отложенный")
    пусть шаблон = пом(исходный, "отложенный_шаблон")
    пусть имя = пом(исходный, "отложенный_имя")
    пусть типы_арг = отложенные_типы(исходный)
    перем у = без_пом(без_пом(без_пом(без_пом(исходный, "отложенный"), "отложенный_шаблон"), "отложенный_имя"),
                      "отложенный_типы")
    если не т.начинается(шаблон + "<") { вернуть рсу(с, у, ложь) }
    если вид == "канал" { вернуть рсу(с, с_пом(у, "тип_выр", т), истина) }
    если не с.типы.содержит(т) и не с.перечисления.содержит(т) { вернуть рсу(с, у, ложь) }
    если вид == "тип" {
        пусть р = конструктор(с, у, т, типы_арг)
        с = р.с
        у = р.у
    } иначе если вид == "вариант" {
        пусть р = конструктор_варианта(с, у, имя, типы_арг, т)
        с = р.с
        у = р.у
    } иначе {
        у = с_пом(с_пом(у, "вариант_тип", т), "вариант", имя)
    }
    вернуть рсу(с, с_пом(у, "тип_выр", т), истина)
}

/// Т(1) в обобщённой функции с <Т: Числовое>: число в значение параметра типа.
функ преобразование_в_параметр(с: Сост, у: разбор.Узел, имя: стр, типы_арг: [стр]) -> Р {
    если не с.параметры_типов[имя].содержит("Числовое") {
        вернуть ру(ошибка(с, у, "преобразовать значение в параметр типа " + имя + " можно, только если он выполняет "
            + "интерфейс Числовое: <" + имя + ": Числовое>"), у, НЕИЗВ())
    }
    если типы_арг.длина != 1 или не (число(типы_арг[0]) или типы_арг[0] == имя или типы_арг[0] == НЕИЗВ()) {
        вернуть ру(ошибка(с, у, имя + "(...) принимает одно число"), у, НЕИЗВ())
    }
    вернуть ру(с, у, имя)
}

/// Метод значения параметра типа: его обещает интерфейс из ограничения.
функ метод_параметра(исходное: Сост, у: разбор.Узел, т: стр, имя: стр, типы_арг: [стр]) -> Р {
    перем с = исходное
    перем найдено = ложь
    перем сигн = Сигн([], "")
    для инт_ в похожее.упорядочить(с.параметры_типов[т]) {
        если с.интерфейсы.содержит(инт_) и с.интерфейсы[инт_].содержит(имя) {
            сигн = с.интерфейсы[инт_][имя]
            найдено = истина
            прервать
        }
    }
    если не найдено {
        вернуть ру(ошибка(с, ч(у, "функция"), "у значения параметра типа " + т + " нет метода «" + имя + "»: методы параметра "
            + "типа обещают интерфейсы из его ограничения (<" + т + ": Интерфейс>)"), у, НЕИЗВ())
    }
    перем параметры: [стр] = []
    для п в сигн.параметры { параметры.добавить(типы.подставить(п, {"Сам": т})) }
    пусть результат = типы.подставить(сигн.результат, {"Сам": т})
    если типы_арг.длина != параметры.длина {
        вернуть ру(ошибка(с, у, "метод «" + имя + "» принимает " + склонение_значений(параметры.длина) + ", а передано "
            + стр(типы_арг.длина)), у, результат)
    }
    пусть р = согласовать_аргументы(с, у, типы_арг, параметры, " метода «" + имя + "»")
    вернуть ру(р.с, р.у, результат)
}

/// Согласует аргументы вызова с типами параметров; «чего» - « функции «имя»», « метода ...» или "".
функ согласовать_аргументы(исходное: Сост, у: разбор.Узел, типы_арг: [стр], нужные: [стр], чего: стр) -> Р {
    перем с = исходное
    перем аргументы = гр(у, "аргументы")
    для н в 0..аргументы.длина - 1 {
        если н >= нужные.длина или н >= типы_арг.длина { прервать }
        пусть р = согласовать(с, аргументы[н], типы_арг[н], нужные[н])
        с = р.с
        аргументы[н] = р.у
        если не р.да {
            с = ошибка(с, р.у, "аргумент " + стр(н + 1) + чего + " должен иметь тип " + нужные[н] + ", а имеет тип " + типы_арг[н])
        }
    }
    вернуть Р(с, с_группой(у, "аргументы", аргументы))
}

// ---------- функции библиотек C ----------

функ внешний_тип(т: стр) -> стр {
    выбор т {
        "цел" { вернуть "цел" }
        "цел32" { вернуть "цел" }
        "дроб" { вернуть "дроб" }
        "дроб32" { вернуть "дроб" }
        "лог" { вернуть "лог" }
        "стр" { вернуть "стр" }
        иначе { вернуть "" }
    }
}

функ латинское_имя(имя: стр) -> лог {
    если имя == "" { вернуть ложь }
    для з в имя.символы() {
        пусть к = код_символа(з)
        если не ((к >= 48 и к <= 57) или (к >= 65 и к <= 90) или (к >= 97 и к <= 122) или к == 95) { вернуть ложь }
    }
    вернуть истина
}

функ собрать_внешние(исходное: Сост, блок_: разбор.Узел) -> Сост {
    перем с = исходное
    пусть допустимые = "цел, цел32, дроб, дроб32, лог, стр"
    для ф в гр(блок_, "функции") {
        пусть имя = св(ф, "имя")
        если с.функции.содержит(имя) или встроенное(имя) или занято_как_тип(с, имя) {
            с = ошибка(с, ф, "имя «" + имя + "» уже занято")
            продолжить
        }
        перем типы_: [стр] = []
        перем имена: [стр] = []
        для п в гр(ф, "параметры") {
            имена.добавить(св(п, "имя"))
            если внешний_тип(св(п, "тип")) == "" {
                с = ошибка(с, п, "параметр внешней функции может иметь тип " + допустимые + ", а здесь " + св(п, "тип"))
                типы_.добавить(НЕИЗВ())
            } иначе {
                типы_.добавить(внешний_тип(св(п, "тип")))
            }
        }
        перем результат = ПУСТО()
        пусть тр = св(ф, "тип_результата")
        если тр != "" {
            если тр == "стр?" {
                результат = "стр?"
            } иначе если внешний_тип(тр) != "" {
                результат = внешний_тип(тр)
            } иначе {
                с = ошибка(с, ф, "внешняя функция может возвращать " + допустимые + " или стр?, а здесь " + тр)
                результат = НЕИЗВ()
            }
        }
        если не латинское_имя(св(ф, "имя_c")) {
            с = ошибка(с, ф, "имя функции в библиотеке C пишется латинскими буквами, цифрами и «_», а здесь «" + св(ф, "имя_c") + "»")
        }
        с.функции[имя] = Сигн(типы_, результат, имена)
        с.внешние[имя] = ф
    }
    вернуть с
}

// ---------- задачи и каналы ----------

/// Проверяет вызов после «запустить»; р.т - тип его результата.
функ запуск(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    пусть р = выражение(с, ч(исходный, "вызов"))
    с = р.с
    пусть т = р.т
    перем у = с_частью(исходный, "вызов", р.у)
    если изменяющий_метод(пом(р.у, "метод")) или пом(р.у, "метод_словаря") == "remove" {
        вернуть ру(ошибка(с, у, "задача не может изменить значение из запустившего её блока: она получает копии "
            + "значений; верните результат («з.дождаться()») или передайте его через канал"), у, НЕИЗВ())
    }
    если т == "диапазон" {
        вернуть ру(ошибка(с, у, "диапазон нельзя получить как результат задачи"), у, НЕИЗВ())
    }
    у = с_пом(у, "тип_результата", т)
    если т != НЕИЗВ() { у = с_пом(у, "тип_выр", "задача<" + т + ">") } иначе { у = с_пом(у, "тип_выр", НЕИЗВ()) }
    вернуть ру(с, у, т)
}

функ в_запуск(с: Сост, у: разбор.Узел) -> Р {
    пусть р = запуск(ошибка(с, у, "«запустить» пишется так: «пусть з = запустить ф(...)», затем «з.дождаться()»; "
        + "или отдельной строкой внутри блока «параллельно { ... }»"), у)
    вернуть ру(р.с, р.у, НЕИЗВ())
}

функ объявление_задачи(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем и_ = исходный
    пусть имя = св(и_, "имя")
    если св(и_, "изменяемая") == "True" {
        с = ошибка(с, и_, "задача объявляется через «пусть»: «пусть " + имя + " = запустить ...»")
    }
    пусть р = запуск(с, ч(и_, "значение"))
    с = р.с
    перем тип_задачи = НЕИЗВ()
    если р.т != НЕИЗВ() { тип_задачи = "задача<" + р.т + ">" }
    если св(и_, "тип") != "" {
        с.задача_разрешена = истина
        пусть ря = тип_по_имени(с, и_, св(и_, "тип"))
        с = ря.с
        с.задача_разрешена = ложь
        если ря.т != НЕИЗВ() и тип_задачи != НЕИЗВ() и ря.т != тип_задачи {
            с = ошибка(с, и_, "переменная «" + имя + "» имеет тип " + ря.т + ", а запущена задача типа " + тип_задачи)
        }
    }
    и_ = с_пом(с_частью(и_, "значение", с_пом(р.у, "тип_выр", тип_задачи)), "тип_итог", тип_задачи)
    вернуть Р(объявить(с, и_, имя, тип_задачи, ложь, "переменная"), и_)
}

функ метод_задачи(с: Сост, у: разбор.Узел, т: стр, имя: стр, типы_арг: [стр]) -> Р {
    если имя != "дождаться" или типы_арг.длина > 0 {
        вернуть ру(ошибка(с, у, "у задачи есть метод «дождаться()» (результат задачи) и свойство «готова»"), у, НЕИЗВ())
    }
    вернуть ру(с, с_пом(у, "метод_задачи", имя), типы.срез(т, 7, т.длина - 1))
}

функ метод_канала(исходное: Сост, исходный: разбор.Узел, т: стр, имя: стр, типы_арг: [стр]) -> Р {
    перем с = исходное
    перем у = исходный
    пусть эл = типы.элемент_канала(т)
    перем нужно = -1
    выбор имя {
        "отправить" { нужно = 1 }
        "получить" { нужно = 0 }
        "закрыть" { нужно = 0 }
        иначе { }
    }
    если нужно == -1 {
        вернуть ру(ошибка(с, у, "у канала есть методы «отправить(значение)», «получить()» и «закрыть()»"
            + подсказка(имя, ["отправить", "получить", "закрыть"])), у, НЕИЗВ())
    }
    если типы_арг.длина != нужно {
        вернуть ру(ошибка(с, у, "«" + имя + "» принимает " + склонение_значений(нужно) + ", а передано " + стр(типы_арг.длина)),
                   у, НЕИЗВ())
    }
    у = с_пом(у, "метод_канала", имя)
    если имя == "отправить" {
        перем аргументы = гр(у, "аргументы")
        пусть р = согласовать(с, аргументы[0], типы_арг[0], эл)
        с = р.с
        аргументы[0] = р.у
        если не р.да { с = ошибка(с, р.у, "по каналу передаются значения типа " + эл + ", а здесь " + типы_арг[0]) }
        вернуть ру(с, с_группой(у, "аргументы", аргументы), ПУСТО())
    }
    если имя == "получить" { вернуть ру(с, у, эл + "?") }
    вернуть ру(с, у, ПУСТО())
}

// ---------- функции и инструкции ----------

функ функция(исходное: Сост, исходный: разбор.Узел, сигн: Сигн, есть_сигн: лог) -> Р {
    перем с = исходное
    пусть имя = св(исходный, "имя")
    перем сигнатура = сигн
    если не есть_сигн {
        если не с.функции.содержит(имя) { вернуть Р(с, исходный) }      // ошибка уже сообщена в первом проходе
        сигнатура = с.функции[имя]
    }
    // функции видят только свои параметры и свои переменные
    пусть внешние = с.области
    с.области = [пустая_область()]
    пусть параметры = гр(исходный, "параметры")
    для н в 0..параметры.длина - 1 {
        если н >= сигнатура.параметры.длина { прервать }
        пусть п = параметры[н]
        если занято_объявлением(с, п, св(п, "имя")) {
            с = ошибка(с, п, "имя «" + св(п, "имя") + "» уже занято функцией")
        }
        с.области[с.области.длина - 1][св(п, "имя")] = Переменная(сигнатура.параметры[н], ложь, "параметр")
    }
    с.в_функции = истина
    с.функция_имя = имя
    с.функция_результат = сигнатура.результат
    пусть прежнее = с.в_параллельном
    с.в_параллельном = 0
    пусть неполных = с.неполных_выборов
    пусть рб = блок(с, ч(исходный, "тело"), ложь)
    с = рб.с
    с.в_параллельном = прежнее
    пусть р = сигнатура.результат
    если р != ПУСТО() и р != НЕИЗВ() и р != ПУСТО() + "!" и не всегда_возвращает(рб.у) и с.неполных_выборов == неполных {
        с = ошибка(с, исходный, "функция «" + имя + "» может завершиться, не вернув значение; "
            + "в конце каждой ветви нужна инструкция «вернуть»")
    }
    с.в_функции = ложь
    с.функция_имя = ""
    с.функция_результат = ""
    с.области = внешние
    вернуть Р(с, с_частью(исходный, "тело", рб.у))
}

функ блок(исходное: Сост, б: разбор.Узел, новая: лог) -> Р {
    перем с = исходное
    если новая { с = новая_область(с) }
    перем инструкции = гр(б, "инструкции")
    для н в 0..инструкции.длина - 1 {
        пусть р = инструкция(с, инструкции[н])
        с = р.с
        инструкции[н] = р.у
    }
    если новая { с = убрать_область(с) }
    вернуть Р(с, с_группой(б, "инструкции", инструкции))
}

функ инструкция(с: Сост, и_: разбор.Узел) -> Р {
    выбор и_.вид {
        "Функция" {
            вернуть Р(ошибка(с, и_, "функции объявляются только на верхнем уровне программы, "
                + "а не внутри других функций или блоков"), и_)
        }
        "ОбъявлениеИнтерфейса" {
            вернуть Р(ошибка(с, и_, "интерфейсы объявляются только на верхнем уровне программы, "
                + "а не внутри функций или блоков"), и_)
        }
        "ВнешнийБлок" { вернуть Р(ошибка_внешнего(с, и_), и_) }
        "ВнешняяФункция" { вернуть Р(ошибка_внешнего(с, и_), и_) }
        "ОбъявлениеВариантов" { вернуть Р(ошибка(с, и_, "типы объявляются только на верхнем уровне программы"), и_) }
        "ОбъявлениеТипа" {
            вернуть Р(ошибка(с, и_, "типы объявляются только на верхнем уровне программы, "
                + "а не внутри функций или блоков"), и_)
        }
        "ОбъявлениеПеременной" { вернуть и_объявление(с, и_) }
        "Присваивание" { вернуть и_присваивание(с, и_) }
        "ПрисваиваниеЭлемента" { вернуть и_присваивание_элемента(с, и_) }
        "ПрисваиваниеПоля" { вернуть и_присваивание_поля(с, и_) }
        "Выражение" { вернуть и_выражение(с, и_) }
        "Если" { вернуть и_если(с, и_) }
        "ЕслиЕсть" { вернуть и_если_есть(с, и_) }
        "ЕслиОшибка" { вернуть и_если_ошибка(с, и_) }
        "Пока" { вернуть и_пока(с, и_) }
        "Для" { вернуть и_для(с, и_) }
        "Вернуть" { вернуть и_вернуть(с, и_) }
        "Прервать" {
            если с.глубина_циклов == 0 { вернуть Р(ошибка(с, и_, "«прервать» можно использовать только внутри цикла"), и_) }
            вернуть Р(с, и_)
        }
        "Продолжить" {
            если с.глубина_циклов == 0 { вернуть Р(ошибка(с, и_, "«продолжить» можно использовать только внутри цикла"), и_) }
            вернуть Р(с, и_)
        }
        "Выбор" { вернуть и_выбор(с, и_) }
        "Параллельно" {
            перем н = с
            н.в_параллельном += 1
            пусть р = блок(н, ч(и_, "тело"), истина)
            н = р.с
            н.в_параллельном -= 1
            вернуть Р(н, с_частью(и_, "тело", р.у))
        }
        "Блок" { вернуть блок(с, и_, истина) }
        иначе { вернуть Р(с, и_) }
    }
}

функ ошибка_внешнего(с: Сост, и_: разбор.Узел) -> Сост {
    вернуть ошибка(с, и_, "функции библиотек C («внешняя») объявляются только на верхнем уровне программы, "
        + "а не внутри функций или блоков")
}

функ слово_объявления(и_: разбор.Узел) -> стр {
    если св(и_, "изменяемая") == "True" { вернуть "перем" }
    вернуть "пусть"
}

/// Начало названия типа до «<>» без открывающих скобок: «[{Ответ<>]» -> «Ответ».
функ основа_имени(т: стр) -> стр {
    перем с = т.символы()
    перем конец = типы.позиция(т, "<>")
    перем начало = 0
    пока начало < конец и (с[начало] == "[" или с[начало] == "{") { начало += 1 }
    вернуть типы.срез(т, начало, конец)
}

функ и_объявление(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем и_ = исходный
    если ч(и_, "значение").вид == "Запуск" { вернуть объявление_задачи(с, и_) }
    пусть имя = св(и_, "имя")
    пусть без_типа = св(и_, "тип") == ""
    пусть слово = слово_объявления(и_)
    пусть рв = выражение(с, ч(и_, "значение"))
    с = рв.с
    перем зн = рв.у
    перем т_зн = рв.т
    если т_зн == ПУСТО() {
        с = ошибка(с, зн, "выражение не имеет значения, его нельзя сохранить в переменную")
        т_зн = НЕИЗВ()
    }
    если т_зн == "диапазон" {
        с = ошибка(с, зн, "диапазон можно использовать только в цикле «для»")
        т_зн = НЕИЗВ()
    }
    если т_зн == ОТЛОЖЕННАЯ() и без_типа {
        с = ошибка(с, зн, "у параметров безымянной функции не указаны типы: укажите их "
            + "(функ(х: цел) = ...) или тип переменной (пусть ф: функ(цел) -> цел = ...)")
        т_зн = НЕИЗВ()
    }
    если т_зн == "ошибка" и без_типа {
        с = ошибка(с, зн, "ошибку можно вернуть из функции («вернуть ошибка(...)») или сохранить в переменной типа «Т!»")
        т_зн = НЕИЗВ()
    }
    если т_зн == "ничего" и без_типа {
        с = ошибка(с, зн, "у «ничего» неизвестен тип значения; укажите его: «" + слово + " " + имя + ": стр? = ничего»")
        т_зн = НЕИЗВ()
    }
    если т_зн == "канал<>" и без_типа {
        с = ошибка(с, зн, "укажите, значения какого типа передаются по каналу: «пусть " + имя + ": канал<цел> = канал()»")
        т_зн = НЕИЗВ()
    }
    если типы.это_задача(т_зн) {
        с = ошибка(с, зн, "задачу нельзя копировать в другую переменную; результат получают «з.дождаться()»")
        т_зн = НЕИЗВ()
    }
    если т_зн.содержит("<>") и без_типа {
        пусть основа_ = основа_имени(т_зн)
        с = ошибка(с, зн, "по значению не определить параметры типа " + основа_ + "; укажите тип переменной: «"
            + слово + " " + имя + ": " + основа_ + "<цел> = ...»")
        т_зн = НЕИЗВ()
    }
    перем т = т_зн
    если не без_типа {
        пусть ря = тип_по_имени(с, и_, св(и_, "тип"))
        с = ря.с
        т = ря.т
        пусть рс = согласовать(с, зн, т_зн, т)
        с = рс.с
        зн = рс.у
        если не рс.да {
            с = ошибка(с, зн, "переменная «" + имя + "» имеет тип " + т + ", а значение имеет тип " + т_зн)
        }
    } иначе если т_зн == "{}" {
        с = ошибка(с, зн, "у пустого словаря неизвестны типы ключей и значений; укажите их: «" + слово + " " + имя
            + ": {стр: цел} = {}»")
        т = НЕИЗВ()
    } иначе если т_зн == "[]" {
        с = ошибка(с, зн, "у пустого списка неизвестен тип элементов; укажите его, например «" + слово + " " + имя
            + ": [стр] = []» для списка строк или «" + слово + " " + имя + ": [цел] = []» для списка целых чисел")
        т = НЕИЗВ()
    }
    и_ = с_пом(с_частью(и_, "значение", зн), "тип_итог", т)
    вернуть Р(объявить(с, и_, имя, т, св(и_, "изменяемая") == "True", "переменная"), и_)
}

функ и_присваивание(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем и_ = исходный
    пусть имя = св(и_, "имя")
    пусть рв = выражение(с, ч(и_, "значение"))
    с = рв.с
    и_ = с_частью(и_, "значение", рв.у)
    пусть т_зн = рв.т
    пусть н = найти(с, имя, истина)
    с = н.с
    если не н.есть {
        если с.функции.содержит(имя) или встроенное(имя) {
            вернуть Р(ошибка(с, и_, "«" + имя + "» - функция, ей нельзя присвоить значение"), и_)
        }
        пусть подсказка_ = подсказка(имя, видимые_переменные(с))
        если подсказка_ != "" {
            вернуть Р(ошибка(с, и_, "переменная «" + имя + "» не объявлена" + подсказка_), и_)
        }
        вернуть Р(ошибка(с, и_, "переменная «" + имя + "» не объявлена; объявите её через «перем " + имя + " = ...»"), и_)
    }
    и_ = с_пом(и_, "тип_цели", н.п.т)
    если не н.п.изменяемая {
        перем цель = разбор.Узел("Имя", [разбор.Свойство("имя", имя)])
        цель.текст = имя
        цель.написание = и_.написание
        пусть з = место(с, цель)
        с = ошибка(с, и_, з.что + " нельзя изменить: " + з.почему)
    }
    если св(и_, "оператор") == "=" {
        пусть рс = согласовать(с, ч(и_, "значение"), т_зн, н.п.т)
        с = рс.с
        и_ = с_частью(и_, "значение", рс.у)
        если не рс.да {
            с = ошибка(с, рс.у, "переменная «" + имя + "» имеет тип " + н.п.т + ", а значение имеет тип " + т_зн)
        }
        вернуть Р(с, и_)
    }
    пусть оп = типы.срез(св(и_, "оператор"), 0, 1)
    пусть ра = арифметика(с, и_, оп, н.п.т, т_зн, "", "значение")
    с = ра.с
    и_ = с_пом(ра.у, "тип_результата", ра.т)
    если не типы.совместим(ра.т, н.п.т) {
        с = ошибка(с, и_, "результат «" + имя + " " + оп + " ...» имеет тип " + ра.т + ", а переменная «" + имя
            + "» имеет тип " + н.п.т)
    }
    вернуть Р(с, и_)
}

/// Изменение «а оп= б» у элемента, значения словаря или поля: тип результата должен подходить.
функ составное(исходное: Сост, исходный: разбор.Узел, т_цели: стр, т_зн: стр, что: стр) -> Р {
    перем с = исходное
    пусть оп = типы.срез(св(исходный, "оператор"), 0, 1)
    пусть ра = арифметика(с, исходный, оп, т_цели, т_зн, "", "значение")
    с = ра.с
    пусть и_ = с_пом(ра.у, "тип_результата", ра.т)
    если не типы.совместим(ра.т, т_цели) {
        с = ошибка(с, и_, "результат операции имеет тип " + ра.т + ", а " + что + " " + т_цели)
    }
    вернуть Р(с, и_)
}

функ и_присваивание_элемента(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем и_ = исходный
    пусть ро = выражение(с, ч(и_, "объект"))
    пусть ри = выражение(ро.с, ч(и_, "индекс"))
    пусть рв = выражение(ри.с, ч(и_, "значение"))
    с = рв.с
    и_ = с_частью(с_частью(с_частью(и_, "объект", ро.у), "индекс", ри.у), "значение", рв.у)
    и_ = с_пом(и_, "тип_элемента", НЕИЗВ())
    пусть т_сп = ро.т
    пусть т_инд = ри.т
    пусть т_зн = рв.т
    если т_сп == "стр" или т_сп == "байты" {
        вернуть Р(ошибка(с, и_, "значение типа " + т_сп + " нельзя изменять по частям; соберите новое"), и_)
    }
    если типы.это_словарь(т_сп) {
        пусть т_к = типы.ключ_словаря(т_сп)
        пусть т_з = типы.значение_словаря(т_сп)
        и_ = с_пом(с_пом(и_, "тип_элемента", т_з), "словарь", "True")
        пусть рк = согласовать(с, ч(и_, "индекс"), т_инд, т_к)
        с = рк.с
        и_ = с_частью(и_, "индекс", рк.у)
        если не рк.да { с = ошибка(с, рк.у, "ключи словаря имеют тип " + т_к + ", а здесь " + т_инд) }
        пусть з = место(с, ч(и_, "объект"))
        если з.есть { с = ошибка(с, и_, текст_запрета("словарь нельзя изменить", з)) }
        если св(и_, "оператор") == "=" {
            пусть рс = согласовать(с, ч(и_, "значение"), т_зн, т_з)
            с = рс.с
            и_ = с_частью(и_, "значение", рс.у)
            если не рс.да { с = ошибка(с, рс.у, "значения словаря имеют тип " + т_з + ", а значение имеет тип " + т_зн) }
            вернуть Р(с, и_)
        }
        вернуть составное(с, и_, т_з, т_зн, "значения словаря имеют тип")
    }
    если не типы.это_список(т_сп) {
        если т_сп != НЕИЗВ() {
            с = ошибка(с, ч(и_, "объект"), "квадратные скобки применимы только к спискам, а здесь " + т_сп)
        }
        вернуть Р(с, и_)
    }
    если т_инд != "цел" и т_инд != НЕИЗВ() {
        с = ошибка(с, ч(и_, "индекс"), "индекс должен быть целым числом, а здесь " + т_инд)
    }
    пусть т_эл = типы.элемент(т_сп)
    и_ = с_пом(и_, "тип_элемента", т_эл)
    пусть з = место(с, ч(и_, "объект"))
    если з.есть { с = ошибка(с, и_, текст_запрета("элемент списка нельзя изменить", з)) }
    если св(и_, "оператор") == "=" {
        пусть рс = согласовать(с, ч(и_, "значение"), т_зн, т_эл)
        с = рс.с
        и_ = с_частью(и_, "значение", рс.у)
        если не рс.да { с = ошибка(с, рс.у, "элементы списка имеют тип " + т_эл + ", а значение имеет тип " + т_зн) }
        вернуть Р(с, и_)
    }
    вернуть составное(с, и_, т_эл, т_зн, "элементы списка имеют тип")
}

функ и_присваивание_поля(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем и_ = исходный
    пусть имя = св(и_, "имя")
    пусть ро = выражение(с, ч(и_, "объект"))
    пусть рв = выражение(ро.с, ч(и_, "значение"))
    с = рв.с
    и_ = с_пом(с_частью(с_частью(и_, "объект", ро.у), "значение", рв.у), "тип_поля", НЕИЗВ())
    пусть т_об = ро.т
    пусть т_зн = рв.т
    если т_об == НЕИЗВ() { вернуть Р(с, и_) }
    если типы.это_особое(т_об) {
        вернуть Р(ошибка_необяз(с, ч(и_, "объект"), т_об, "поле «" + имя + "» нельзя изменить"), и_)
    }
    если не с.типы.содержит(т_об) {
        если имя == "длина" или свойство_типа(т_об, имя) != "" {
            вернуть Р(ошибка(с, и_, "свойство «" + имя + "» вычисляется само, изменить его нельзя"), и_)
        }
        вернуть Р(ошибка(с, и_, "у значения типа " + т_об + " нет полей"), и_)
    }
    перем тип_поля = ""
    перем имена: [стр] = []
    для п в с.типы[т_об] {
        имена.добавить(п.имя)
        если п.имя == имя { тип_поля = п.т }
    }
    если не имена.содержит(имя) {
        вернуть Р(ошибка(с, и_, "у типа " + т_об + " нет поля «" + имя + "»" + подсказка(имя, имена)), и_)
    }
    и_ = с_пом(и_, "тип_поля", тип_поля)
    пусть з = место(с, ч(и_, "объект"))
    если з.есть { с = ошибка(с, и_, текст_запрета("поле «" + имя + "» нельзя изменить", з)) }
    если св(и_, "оператор") == "=" {
        пусть рс = согласовать(с, ч(и_, "значение"), т_зн, тип_поля)
        с = рс.с
        и_ = с_частью(и_, "значение", рс.у)
        если не рс.да { с = ошибка(с, рс.у, "поле «" + имя + "» имеет тип " + тип_поля + ", а значение имеет тип " + т_зн) }
        вернуть Р(с, и_)
    }
    вернуть составное(с, и_, тип_поля, т_зн, "поле «" + имя + "» имеет тип")
}

/// Есть ли в выражении вызов функции (только вызов может что-то изменить или вывести).
функ есть_вызов(у: разбор.Узел) -> лог {
    если у.вид == "Вызов" { вернуть истина }
    если у.вид == "Лямбда" { вернуть ложь }
    для г в у.поля {
        для вложенный в г.поля {
            если вложенный.вид != "=" и есть_вызов(вложенный) { вернуть истина }
        }
    }
    вернуть ложь
}

функ имя_функции(с: Сост, у: разбор.Узел) -> лог {
    вернуть у.вид == "Имя" и (с.функции.содержит(у.текст) или в_библиотеке(с, у.текст) != "")
}

/// Сообщение о выражении отдельной инструкцией, которое ничего не делает.
функ бесполезное_выражение(с: Сост, выр: разбор.Узел) -> Сост {
    перем подсказка_ = "; чтобы показать его на экране, используйте «вывод(...)»"
    если выр.вид == "Бинарная" и св(выр, "оператор") == "==" {
        подсказка_ = "; для присваивания используйте «=», а не «==»"
    } иначе если имя_функции(с, выр) {
        перем написание = выр.написание
        если написание == "" { написание = выр.текст }
        подсказка_ = "; чтобы вызвать функцию, допишите скобки: «" + написание + "(...)»"
    }
    вернуть ошибка(с, выр, "значение этого выражения нигде не используется, и оно ничего не меняет" + подсказка_)
}

функ и_выражение(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    пусть выр = ч(исходный, "выражение")
    если выр.вид == "Запуск" {
        если с.в_параллельном == 0 {
            с = ошибка(с, выр, "задача без имени запускается внутри блока «параллельно { ... }», который "
                + "дождётся её завершения; или сохраните задачу: «пусть з = запустить ...»")
        }
        пусть р = запуск(с, выр)
        с = р.с
        если типы.это_результат(р.т) {
            с = ошибка(с, р.у, "результат задачи может оказаться ошибкой, и её нельзя молча проигнорировать: "
                + "сохраните задачу («пусть з = запустить ...») и проверьте «з.дождаться()»")
        }
        вернуть Р(с, с_частью(исходный, "выражение", р.у))
    }
    если не есть_вызов(выр) {
        пусть было = с.ошибки.длина
        перем у = выр
        если не имя_функции(с, выр) {
            пусть р = выражение(с, выр)
            с = р.с
            у = р.у
        }
        если с.ошибки.длина == было { с = бесполезное_выражение(с, у) }
        вернуть Р(с, с_частью(исходный, "выражение", у))
    }
    пусть р = выражение(с, выр)
    с = р.с
    если р.т == "диапазон" { с = ошибка(с, р.у, "диапазон можно использовать только в цикле «для»") }
    если типы.это_результат(р.т) {
        с = ошибка(с, р.у, "результат может оказаться ошибкой, и её нельзя молча проигнорировать: "
            + "допишите «!», чтобы передать ошибку дальше, или обработайте её: «если ошибка о = ... { }»")
    }
    вернуть Р(с, с_частью(исходный, "выражение", р.у))
}

функ условие(исходное: Сост, у: разбор.Узел, слово: стр) -> Р {
    перем с = исходное
    пусть р = выражение(с, у)
    с = р.с
    если типы.это_особое(р.т) {
        с = ошибка_необяз(с, р.у, р.т, "условие после «" + слово + "» должно иметь тип лог")
    } иначе если не типы.совместим(р.т, "лог") {
        с = ошибка(с, р.у, "условие после «" + слово + "» должно иметь тип лог (истина или ложь), а имеет тип " + р.т)
    }
    вернуть Р(с, р.у)
}

/// Ветвь «иначе» условной инструкции: вложенное «если» или блок.
функ иначе_ветвь(с: Сост, и_: разбор.Узел) -> Р {
    если не есть(и_, "иначе") { вернуть Р(с, и_) }
    пусть ин = ч(и_, "иначе")
    если ин.вид == "Если" или ин.вид == "ЕслиЕсть" или ин.вид == "ЕслиОшибка" {
        пусть р = инструкция(с, ин)
        вернуть Р(р.с, с_частью(и_, "иначе", р.у))
    }
    пусть р = блок(с, ин, истина)
    вернуть Р(р.с, с_частью(и_, "иначе", р.у))
}

функ и_если(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    пусть ру_ = условие(с, ч(исходный, "условие"), "если")
    пусть рт_ = блок(ру_.с, ч(исходный, "тогда"), истина)
    вернуть иначе_ветвь(рт_.с, с_частью(с_частью(исходный, "условие", ру_.у), "тогда", рт_.у))
}

функ и_если_есть(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем и_ = исходный
    пусть имя = св(и_, "имя")
    пусть рв = выражение(с, ч(и_, "значение"))
    с = рв.с
    и_ = с_частью(и_, "значение", рв.у)
    пусть т = рв.т
    перем т_перем = НЕИЗВ()
    если типы.это_результат(т) и типы.основа(т) == ПУСТО() {
        с = ошибка(с, рв.у, "у результата без значения нет значения для «если пусть»; используйте «если ошибка о = ... { }»")
    } иначе если типы.это_особое(т) {
        т_перем = типы.основа(т)
    } иначе если т == "ничего" {
        с = ошибка(с, рв.у, "здесь всегда «ничего», проверять нечего")
    } иначе если т != НЕИЗВ() {
        с = ошибка(с, рв.у, "после «если пусть " + имя + " =» ожидается необязательное значение (тип со знаком «?»), а здесь "
            + т + "; обычное условие записывается без «пусть»: «если условие { }»")
    }
    и_ = с_пом(и_, "тип_значения", т)
    с = объявить(новая_область(с), и_, имя, т_перем, ложь, "значение")
    пусть рт_ = блок(с, ч(и_, "тогда"), ложь)
    с = убрать_область(рт_.с)
    и_ = с_частью(и_, "тогда", рт_.у)
    пусть имя_ошибки = св(и_, "имя_ошибки")
    если имя_ошибки != "" {
        если не типы.это_результат(т) и т != НЕИЗВ() {
            с = ошибка(с, и_, "«иначе ошибка " + имя_ошибки + "» возможно только для результата, который может быть ошибкой "
                + "(тип со знаком «!»), а здесь " + т)
        }
        с = объявить(новая_область(с), и_, имя_ошибки, "стр", ложь, "значение")
        пусть ри = блок(с, ч(и_, "иначе"), ложь)
        вернуть Р(убрать_область(ри.с), с_частью(и_, "иначе", ри.у))
    }
    вернуть иначе_ветвь(с, и_)
}

функ и_если_ошибка(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем и_ = исходный
    пусть имя = св(и_, "имя")
    пусть рв = выражение(с, ч(и_, "значение"))
    с = рв.с
    и_ = с_частью(и_, "значение", рв.у)
    если не типы.это_результат(рв.т) и рв.т != НЕИЗВ() {
        с = ошибка(с, рв.у, "после «если ошибка " + имя + " =» ожидается результат, который может быть ошибкой "
            + "(тип со знаком «!»), а здесь " + рв.т)
    }
    с = объявить(новая_область(с), и_, имя, "стр", ложь, "значение")
    пусть рт_ = блок(с, ч(и_, "тогда"), ложь)
    вернуть иначе_ветвь(убрать_область(рт_.с), с_частью(и_, "тогда", рт_.у))
}

функ и_пока(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    пусть ру_ = условие(с, ч(исходный, "условие"), "пока")
    с = ру_.с
    с.глубина_циклов += 1
    пусть рб = блок(с, ч(исходный, "тело"), истина)
    с = рб.с
    с.глубина_циклов -= 1
    вернуть Р(с, с_частью(с_частью(исходный, "условие", ру_.у), "тело", рб.у))
}

функ и_для(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем и_ = исходный
    пусть ри = выражение(с, ч(и_, "источник"))
    с = ри.с
    и_ = с_частью(и_, "источник", ри.у)
    пусть т = ри.т
    если т == "стр" { и_ = с_пом(и_, "по_строке", "True") }
    перем т_перем = НЕИЗВ()
    если т == "диапазон" {
        т_перем = "цел"
    } иначе если т == "стр" {
        т_перем = "стр"
    } иначе если типы.это_список(т) {
        т_перем = типы.элемент(т)
    } иначе если типы.это_словарь(т) {
        т_перем = типы.ключ_словаря(т)          // перебираются ключи в порядке добавления
        и_ = с_пом(и_, "по_словарю", "True")
    } иначе если типы.это_канал(т) {
        т_перем = типы.элемент_канала(т)        // значения принимаются, пока канал не закрыт
        и_ = с_пом(и_, "по_каналу", "True")
    } иначе если т == "[]" {
        с = ошибка(с, ри.у, "перебирать пустой список «[]» бессмысленно")
    } иначе если т != НЕИЗВ() {
        с = ошибка(с, ри.у, "после «в» ожидается диапазон, например «1..10», список, словарь или строка")
    }
    если типы.это_список(т) или типы.это_словарь(т) или т == "стр" или типы.это_канал(т) {
        и_ = с_пом(и_, "тип_элемента", т_перем)
    }
    с = объявить(новая_область(с), и_, св(и_, "переменная"), т_перем, ложь, "цикл")
    с.глубина_циклов += 1
    пусть рб = блок(с, ч(и_, "тело"), истина)
    с = рб.с
    с.глубина_циклов -= 1
    вернуть Р(убрать_область(с), с_частью(и_, "тело", рб.у))
}

функ и_вернуть(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем и_ = исходный
    если не с.в_функции {
        с = ошибка(с, и_, "«вернуть» можно использовать только внутри функции")
        если есть(и_, "значение") {
            пусть р = выражение(с, ч(и_, "значение"))
            вернуть Р(р.с, с_частью(и_, "значение", р.у))
        }
        вернуть Р(с, и_)
    }
    пусть имя = с.функция_имя
    пусть ожидаемый = с.функция_результат
    если не есть(и_, "значение") {
        если ожидаемый != ПУСТО() и ожидаемый != НЕИЗВ() и ожидаемый != ПУСТО() + "!" {
            с = ошибка(с, и_, "функция «" + имя + "» должна вернуть значение типа " + ожидаемый)
        }
        вернуть Р(с, и_)
    }
    пусть р = выражение(с, ч(и_, "значение"))
    с = р.с
    и_ = с_частью(и_, "значение", р.у)
    если р.у.вид == "Имя" {
        // возвращается собственная переменная функции: значение переходит к вызывающей стороне без копирования
        пусть н = найти(с, р.у.текст, истина)
        с = н.с
        если н.есть и н.п.вид == "переменная" { и_ = с_пом(и_, "перемещение", "True") }
    }
    если ожидаемый == ПУСТО() {
        с = ошибка(с, и_, "функция «" + имя + "» не возвращает значений; если она должна возвращать результат, "
            + "укажите его тип после «->»")
    } иначе {
        пусть рс = согласовать(с, ч(и_, "значение"), р.т, ожидаемый)
        с = рс.с
        и_ = с_частью(и_, "значение", рс.у)
        если не рс.да {
            с = ошибка(с, рс.у, "функция «" + имя + "» должна вернуть " + ожидаемый + ", а возвращается " + р.т)
        }
    }
    вернуть Р(с, и_)
}

// ---------- выбор ----------

/// Записанное значение: число, строка, истина, ложь или диапазон из них.
функ постоянное(у: разбор.Узел) -> лог {
    если ["ЦелоеЧисло", "ДробноеЧисло", "Строка", "Логическое"].содержит(у.вид) { вернуть истина }
    если у.вид == "Унарная" и св(у, "оператор") == "-" {
        пусть о = ч(у, "операнд")
        вернуть о.вид == "ЦелоеЧисло" или о.вид == "ДробноеЧисло"
    }
    если у.вид == "Диапазон" { вернуть постоянное(ч(у, "начало")) и постоянное(ч(у, "конец")) }
    вернуть ложь
}

/// Значение образца в записи Python (repr) - для поиска повторов.
функ значение_образца(у: разбор.Узел) -> стр {
    если у.вид == "Унарная" {
        пусть з = св(ч(у, "операнд"), "значение")
        если ч(у, "операнд").вид == "ЦелоеЧисло" {
            если з == "0" { вернуть "0" }
            вернуть "-" + з
        }
        если з == "nan" { вернуть з }
        вернуть "-" + з
    }
    если у.вид == "Строка" { вернуть разбор.питон(св(у, "значение")) }
    вернуть св(у, "значение")
}

функ последняя_часть(имя: стр) -> стр {
    пусть части = имя.разбить(".")
    вернуть части[части.длина - 1]
}

функ до_последней_точки(имя: стр) -> стр {
    перем последняя = -1
    перем н = 0
    для з в имя.символы() {
        если з == "." { последняя = н }
        н += 1
    }
    вернуть типы.срез(имя, 0, последняя)
}

функ и_выбор(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем и_ = исходный
    пусть рв = выражение(с, ч(и_, "значение"))
    с = рв.с
    пусть т = рв.т
    и_ = с_пом(с_частью(и_, "значение", рв.у), "тип_значения", т)
    перем ветви = гр(и_, "ветви")
    если с.перечисления.содержит(т) {
        пусть варианты = с.перечисления[т]
        перем имена: [стр] = []
        для в_ в варианты { имена.добавить(в_.имя) }
        перем покрытые: [стр] = []
        для н в 0..ветви.длина - 1 {
            пусть ветвь = ветви[н]
            перем привязки: {стр: стр} = {}
            перем образцы = гр(ветвь, "образцы")
            для к в 0..образцы.длина - 1 {
                перем образец = образцы[к]
                если образец.вид != "ОбразецВарианта" {
                    с = ошибка(с, образец, "значение типа " + т + " разбирается по вариантам: " + имена.соединить(", "))
                    продолжить
                }
                перем имя_о = св(образец, "имя")
                пусть основа_типа = типы.разобрать(т).имя
                если не имена.содержит(имя_о) и основа_типа.содержит(".") {
                    // вариант типа из модуля можно называть коротко: Круг вместо фигуры.Круг
                    пусть полное = до_последней_точки(основа_типа) + "." + последняя_часть(имя_о)
                    если имена.содержит(полное) {
                        имя_о = полное
                        образец = со_свойством(образец, "имя", полное)
                        образцы[к] = образец
                    }
                }
                если не имена.содержит(имя_о) {
                    с = ошибка(с, образец, "у типа " + т + " нет варианта «" + имя_о + "»" + подсказка(имя_о, имена))
                    продолжить
                }
                если покрытые.содержит(имя_о) {
                    с = ошибка(с, образец, "вариант «" + имя_о + "» уже разобран выше")
                } иначе {
                    покрытые.добавить(имя_о)
                }
                пусть поля = варианты[имена.найти(имя_о)].поля
                пусть пр = гр(образец, "привязки")
                если пр.длина > 0 {
                    если образцы.длина > 1 {
                        с = ошибка(с, образец, "если в ветви несколько вариантов, получить их поля нельзя")
                    } иначе если пр.длина != поля.длина {
                        перем названия: [стр] = []
                        для п в поля { названия.добавить(п.имя) }
                        перем список_ = названия.соединить(", ")
                        если список_ == "" { список_ = "нет полей" }
                        с = ошибка(с, образец, "у варианта «" + имя_о + "» " + склонение_полей(поля.длина) + " (" + список_
                            + "), а указано " + стр(пр.длина))
                    } иначе {
                        для м в 0..пр.длина - 1 {
                            пусть имя_п = пр[м].простые[0].значение
                            если имя_п != "_" { привязки[имя_п] = поля[м].т }
                        }
                    }
                }
            }
            с = новая_область(с)
            для имя_п в привязки.ключи() { с = объявить(с, ветвь, имя_п, привязки[имя_п], ложь, "значение") }
            пусть рб = блок(с, ч(ветвь, "тело"), ложь)
            с = убрать_область(рб.с)
            ветви[н] = с_частью(с_группой(ветвь, "образцы", образцы), "тело", рб.у)
        }
        перем пропущенные: [стр] = []
        для имя в имена {
            если не покрытые.содержит(имя) { пропущенные.добавить("«" + имя + "»") }
        }
        если пропущенные.длина > 0 и не есть(и_, "иначе") {
            с.неполных_выборов += 1
            с = ошибка(с, и_, "в «выбор» не разобраны варианты типа " + т + ": " + пропущенные.соединить(", ")
                + "; добавьте для них ветви или ветвь «иначе»")
        }
        если пропущенные.длина == 0 { и_ = с_пом(и_, "полный", "True") }
    } иначе если ["цел", "стр", "лог", "рац", "дроб", НЕИЗВ()].содержит(т) {
        перем значения: [стр] = []
        для н в 0..ветви.длина - 1 {
            перем образцы = гр(ветви[н], "образцы")
            для к в 0..образцы.длина - 1 {
                перем образец = образцы[к]
                если образец.вид == "ОбразецВарианта" {
                    если т != НЕИЗВ() {
                        с = ошибка(с, образец, "для значения типа " + т + " в ветви пишутся значения "
                            + "(числа, строки, диапазоны), а не имена; для сравнения с переменной используйте «если»")
                    }
                    продолжить
                }
                если не постоянное(образец) {
                    с = ошибка(с, образец, "в ветви «выбор» допускаются только записанные значения: "
                        + "числа, строки, истина, ложь и диапазоны «1..5»")
                    продолжить
                }
                если образец.вид == "Диапазон" {
                    для сторона в ["начало", "конец"] {
                        пусть рг = выражение(с, ч(образец, сторона))
                        с = рг.с
                        образец = с_частью(образец, сторона, рг.у)
                        если рг.т != "цел" и рг.т != НЕИЗВ() {
                            с = ошибка(с, рг.у, "границы диапазона должны быть целыми числами")
                        }
                    }
                    образец = с_пом(образец, "тип_выр", "диапазон")
                    образцы[к] = образец
                    если т != "цел" и т != НЕИЗВ() {
                        с = ошибка(с, образец, "диапазон применим только к целым числам, а здесь " + т)
                    }
                    продолжить
                }
                пусть ро = выражение(с, образец)
                с = ро.с
                образец = ро.у
                если т != НЕИЗВ() {
                    пусть рс = согласовать(с, образец, ро.т, т)
                    с = рс.с
                    образец = рс.у
                    если не рс.да {
                        с = ошибка(с, образец, "значение имеет тип " + ро.т + ", а в «выбор» - значение типа " + т)
                    }
                }
                образцы[к] = образец
                пусть ключ = значение_образца(образец)
                если значения.содержит(ключ) {
                    с = ошибка(с, образец, "это значение уже разобрано выше")
                } иначе {
                    значения.добавить(ключ)
                }
            }
            пусть рб = блок(с, ч(ветви[н], "тело"), истина)
            с = рб.с
            ветви[н] = с_частью(с_группой(ветви[н], "образцы", образцы), "тело", рб.у)
        }
        если т == "лог" и значения.содержит("True") и значения.содержит("False") { и_ = с_пом(и_, "полный", "True") }
    } иначе {
        с = ошибка(с, рв.у, "«выбор» работает с перечислениями, числами, строками и логическими значениями, а здесь " + т)
        для н в 0..ветви.длина - 1 {
            пусть рб = блок(с, ч(ветви[н], "тело"), истина)
            с = рб.с
            ветви[н] = с_частью(ветви[н], "тело", рб.у)
        }
    }
    и_ = с_группой(и_, "ветви", ветви)
    если есть(и_, "иначе") {
        пусть рб = блок(с, ч(и_, "иначе"), истина)
        с = рб.с
        и_ = с_частью(и_, "иначе", рб.у)
    }
    вернуть Р(с, и_)
}

/// Возвращает ли блок значение при любом пути выполнения.
функ всегда_возвращает(у: разбор.Узел) -> лог {
    если у.вид == "Вернуть" { вернуть истина }
    если у.вид == "Блок" {
        для и_ в гр(у, "инструкции") {
            если всегда_возвращает(и_) { вернуть истина }
        }
        вернуть ложь
    }
    если у.вид == "Выбор" {
        если не ((есть(у, "иначе") и всегда_возвращает(ч(у, "иначе"))) или пом(у, "полный") != "") { вернуть ложь }
        для в_ в гр(у, "ветви") {
            если не всегда_возвращает(ч(в_, "тело")) { вернуть ложь }
        }
        вернуть истина
    }
    если у.вид == "Если" или у.вид == "ЕслиЕсть" или у.вид == "ЕслиОшибка" {
        вернуть есть(у, "иначе") и всегда_возвращает(ч(у, "тогда")) и всегда_возвращает(ч(у, "иначе"))
    }
    вернуть ложь
}

// ---------- выражения ----------

/// Проверяет выражение: р.у - узел с пометкой «тип_выр», р.т - его тип.
функ выражение(с: Сост, у: разбор.Узел) -> Р {
    перем р = Р(с, у, НЕИЗВ())
    выбор у.вид {
        "ЦелоеЧисло" { р = в_целое(с, у) }
        "ДробноеЧисло" { р = ру(с, у, "дроб") }
        "Строка" { р = ру(с, у, "стр") }
        "Логическое" { р = ру(с, у, "лог") }
        "Ничего" { р = ру(с, у, "ничего") }
        "Передать" { р = в_передать(с, у) }
        "Иначе" { р = в_иначе(с, у) }
        "Имя" { р = в_имя(с, у) }
        "Унарная" { р = в_унарная(с, у) }
        "Бинарная" { р = в_бинарная(с, у) }
        "Диапазон" { р = в_диапазон(с, у) }
        "Вызов" { р = в_вызов(с, у, "", ложь) }
        "Запуск" { р = в_запуск(с, у) }
        "Лямбда" { р = лямбда(с, у, [], ложь, "", ложь) }
        "Поле" { р = в_поле(с, у) }
        "Список" { р = в_список(с, у) }
        "Словарь" { р = в_словарь(с, у) }
        "Индекс" { р = в_индекс(с, у) }
        иначе { }
    }
    вернуть Р(р.с, с_пом(р.у, "тип_выр", р.т), р.т)
}

/// Больше ли запись целого числа, чем 2^63 - 1.
функ слишком_большое(запись: стр) -> лог {
    пусть предел = "9223372036854775807"
    если запись.длина != предел.длина { вернуть запись.длина > предел.длина }
    вернуть похожее.сравнить_строки(запись, предел) > 0
}

функ в_целое(с: Сост, у: разбор.Узел) -> Р {
    пусть з = св(у, "значение")
    если слишком_большое(з) {
        вернуть ру(ошибка(с, у, "число слишком велико для типа цел; для целых чисел любой длины есть тип "
            + "длинное: длинное(\"" + з + "\")"), у, "цел")
    }
    вернуть ру(с, у, "цел")
}

функ в_передать(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    пусть р = выражение(с, ч(исходный, "значение"))
    с = р.с
    перем у = с_частью(исходный, "значение", р.у)
    пусть т = р.т
    если т == НЕИЗВ() { вернуть ру(с, у, НЕИЗВ()) }
    если не типы.это_результат(т) {
        вернуть ру(ошибка(с, у, "знак «!» передаёт дальше ошибку, а значение типа " + т + " ошибкой быть не может"), у, т)
    }
    если с.в_функции и не типы.это_результат(с.функция_результат) {
        с = ошибка(с, у, "передать ошибку можно только из функции, которая сама может завершиться ошибкой: "
            + "отметьте тип результата функции «" + с.функция_имя + "» знаком «!» (например, «-> цел!» или «-> !»), "
            + "или обработайте ошибку здесь")
    }
    если с.в_функции { у = с_пом(у, "функция_результат", с.функция_результат) }
    вернуть ру(с, у, типы.основа(т))
}

функ в_иначе(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    пусть рз = выражение(с, ч(исходный, "значение"))
    пусть рп = выражение(рз.с, ч(исходный, "запасное"))
    с = рп.с
    перем у = с_частью(с_частью(исходный, "значение", рз.у), "запасное", рп.у)
    пусть т = рз.т
    пусть запасной = рп.т
    если т == НЕИЗВ() { вернуть ру(с, у, НЕИЗВ()) }
    если т == "ничего" {
        вернуть ру(ошибка(с, у, "слева от «иначе» стоит «ничего», поэтому всегда будет выбрано запасное значение"), у, запасной)
    }
    если типы.это_результат(т) и типы.основа(т) == ПУСТО() {
        вернуть ру(ошибка(с, у, "у результата без значения («-> !») нет значения, которое можно заменить запасным; "
            + "обработайте ошибку: «если ошибка о = ... { }»"), у, НЕИЗВ())
    }
    если не типы.это_особое(т) {
        вернуть ру(ошибка(с, у, "слева от «иначе» должно стоять необязательное значение (тип со знаком «?») "
            + "или результат, который может быть ошибкой («!»), а здесь " + т + "; такое значение есть всегда"), у, т)
    }
    если запасной == НЕИЗВ() { вернуть ру(с, у, типы.основа(т)) }
    пусть р1 = согласовать(с, ч(у, "запасное"), запасной, типы.основа(т))
    с = р1.с
    у = с_частью(у, "запасное", р1.у)
    если р1.да { вернуть ру(с, у, типы.основа(т)) }
    пусть р2 = согласовать(с, ч(у, "запасное"), запасной, т)
    с = р2.с
    у = с_частью(у, "запасное", р2.у)
    если р2.да { вернуть ру(с, у, т) }
    с = ошибка(с, ч(у, "запасное"), "запасное значение должно иметь тип " + типы.основа(т) + ", а имеет тип " + запасной)
    вернуть ру(с, у, типы.основа(т))
}

функ в_имя(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем у = исходный
    пусть имя = у.текст
    пусть н = найти(с, имя, истина)
    с = н.с
    если н.есть {
        если типы.это_задача(н.п.т) {
            если н.п.вид == "захват" {
                вернуть ру(ошибка(с, у, "безымянная функция не может пользоваться задачей из внешнего блока"), у, НЕИЗВ())
            }
            если не с.приёмник {
                перем написание = у.написание
                если написание == "" { написание = имя }
                вернуть ру(ошибка(с, у, "задачу можно только дождаться: «" + написание + ".дождаться()», или проверить, "
                    + "завершилась ли она: «" + написание + ".готова»"), у, НЕИЗВ())
            }
        }
        вернуть ру(с, у, н.п.т)
    }
    если с.т.постоянные.содержит(имя) { вернуть ру(с, с_пом(у, "константа", имя), с.т.постоянные[имя]) }
    если с.обобщённые_варианты.содержит(имя) {
        пусть шаблон = с.обобщённые_варианты[имя]
        для в_ в гр(с.обобщённые_типы[шаблон], "варианты") {
            если св(в_, "имя") != имя { продолжить }
            пусть поля = гр(в_, "поля")
            если поля.длина > 0 {
                перем имена: [стр] = []
                для п в поля { имена.добавить(св(п, "имя")) }
                вернуть ру(ошибка(с, у, "у варианта «" + имя + "» есть поля (" + имена.соединить(", ") + "); задайте их: "
                    + имя + "(...)"), у, НЕИЗВ())
            }
            прервать
        }
        вернуть ру(с, отложить(у, "имя", шаблон, имя, []), шаблон + "<>")
    }
    если с.шаблоны.содержит(имя) {
        вернуть ру(ошибка(с, у, "«" + имя + "» - обобщённая функция; как значение её можно передать через "
            + "безымянную функцию: функ(х) = " + имя + "(х)"), у, НЕИЗВ())
    }
    если с.обобщённые_типы.содержит(имя) или с.параметры_типов.содержит(имя) {
        вернуть ру(ошибка(с, у, "«" + имя + "» - название типа, а не значение"), у, НЕИЗВ())
    }
    если с.вариант_тип.содержит(имя) {
        пусть т = с.вариант_тип[имя]
        для в_ в с.перечисления[т] {
            если в_.имя == имя и в_.поля.длина > 0 {
                перем имена: [стр] = []
                для п в в_.поля { имена.добавить(п.имя) }
                вернуть ру(ошибка(с, у, "у варианта «" + имя + "» есть поля (" + имена.соединить(", ") + "); задайте их: "
                    + имя + "(...)"), у, НЕИЗВ())
            }
        }
        вернуть ру(с, с_пом(с_пом(у, "вариант_тип", т), "вариант", имя), т)
    }
    если с.типы.содержит(имя) {
        с = ошибка(с, у, "«" + имя + "» - название типа; чтобы создать значение, допишите скобки с полями: " + имя + "(...)")
    } иначе если с.функции.содержит(имя) {
        // функция программы как значение: её можно передать или сохранить
        пусть сигн = с.функции[имя]
        вернуть ру(с, с_пом(у, "функция_значение", имя), типы.тип_функции(сигн.параметры, сигн.результат))
    } иначе если встроенное(имя) или в_библиотеке(с, имя) != "" {
        перем что = "функция"
        если встроенный_тип(имя) { что = "название типа" }
        с = ошибка(с, у, "«" + имя + "» - " + что + "; чтобы вызвать функцию, допишите скобки: " + имя + "(...)")
    } иначе {
        перем кандидаты = видимые_переменные(с)
        для к в с.т.постоянные.ключи() { кандидаты.добавить(к) }
        с = ошибка(с, у, "переменная «" + имя + "» не объявлена" + подсказка(имя, кандидаты))
    }
    вернуть ру(с, у, НЕИЗВ())
}

функ в_унарная(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    пусть р = выражение(с, ч(исходный, "операнд"))
    с = р.с
    пусть у = с_частью(исходный, "операнд", р.у)
    пусть т = р.т
    пусть оп = св(у, "оператор")
    если типы.это_особое(т) { вернуть ру(ошибка_необяз(с, у, т, "«" + оп + "» нельзя применить"), у, НЕИЗВ()) }
    если оп == "-" {
        если число(т) или т == НЕИЗВ() или т == "мн" или т == "длинное" или т == "компл" { вернуть ру(с, у, т) }
        если с.параметры_типов.содержит(т) {
            если не с.параметры_типов[т].содержит("Числовое") {
                с = ошибка(с, у, "знак «-» применим к параметру типа " + т + ", только если он выполняет "
                    + "интерфейс Числовое: <" + т + ": Числовое>")
            }
            вернуть ру(с, у, т)
        }
        вернуть ру(ошибка(с, у, "знак «-» применим только к числам, а не к типу " + т), у, НЕИЗВ())
    }
    если не типы.совместим(т, "лог") { с = ошибка(с, у, "«не» применимо только к типу лог, а не к типу " + т) }
    вернуть ру(с, у, "лог")
}

функ привести_часть(у: разбор.Узел, часть: стр, т: стр, к_типу: стр) -> разбор.Узел {
    если часть == "" { вернуть у }
    вернуть с_частью(у, часть, привести(ч(у, часть), т, к_типу))
}

функ в_мн(т: стр) -> лог { вернуть т == "цел" или т == "рац" или т == "мн" }

функ согласовать_часть(с: Сост, у: разбор.Узел, часть: стр, т: стр, ожидаемый: стр) -> Р {
    пусть р = согласовать(с, ч(у, часть), т, ожидаемый)
    вернуть рсу(р.с, с_частью(у, часть, р.у), р.да)
}

функ в_бинарная(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    пусть рл = выражение(с, ч(исходный, "левый"))
    пусть рп = выражение(рл.с, ч(исходный, "правый"))
    с = рп.с
    перем у = с_частью(с_частью(исходный, "левый", рл.у), "правый", рп.у)
    перем л = рл.т
    перем п = рп.т
    пусть оп = св(у, "оператор")
    если оп == "+" или оп == "-" или оп == "*" или оп == "/" или оп == "%" {
        вернуть арифметика(с, у, оп, л, п, "левый", "правый")
    }
    если оп == "^" { вернуть степень(с, у, л, п) }
    если оп == "и" или оп == "или" {
        если не типы.совместим(л, "лог") { с = ошибка(с, ч(у, "левый"), "«" + оп + "» соединяет значения типа лог, а здесь тип " + л) }
        если не типы.совместим(п, "лог") { с = ошибка(с, ч(у, "правый"), "«" + оп + "» соединяет значения типа лог, а здесь тип " + п) }
        вернуть ру(с, у, "лог")
    }
    // сравнения; запись списка или словаря, тип которой определяется местом («а == [[]]»), получает тип другой стороны
    пусть исх_л = л
    пусть исх_п = п
    если пом(ч(у, "левый"), "ждёт_типа") != "" и исх_п != НЕИЗВ() {
        пусть р = согласовать_часть(с, у, "левый", НЕИЗВ(), исх_п)
        с = р.с
        у = р.у
        если р.да { л = исх_п }
    }
    если пом(ч(у, "правый"), "ждёт_типа") != "" и исх_л != НЕИЗВ() {
        пусть р = согласовать_часть(с, у, "правый", НЕИЗВ(), исх_л)
        с = р.с
        у = р.у
        если р.да { п = исх_л }
    }
    если л == НЕИЗВ() или п == НЕИЗВ() { вернуть ру(с, у, "лог") }
    если л.оканчивается("<>") != п.оканчивается("<>") {     // «х == Нет» у обобщённого перечисления
        если л.оканчивается("<>") {
            пусть р = согласовать_часть(с, у, "левый", л, п)
            с = р.с
            у = р.у
            если р.да { л = п }
        } иначе {
            пусть р = согласовать_часть(с, у, "правый", п, л)
            с = р.с
            у = р.у
            если р.да { п = л }
        }
    }
    если с.параметры_типов.содержит(л) или с.параметры_типов.содержит(п) {
        если л != п { вернуть ру(ошибка(с, у, "нельзя сравнивать " + л + " и " + п), у, "лог") }
        перем нужен = "Упорядоченное"
        если оп == "==" или оп == "!=" { нужен = "Сравнимое" }
        если не с.параметры_типов[л].содержит(нужен) {
            с = ошибка(с, у, "для «" + оп + "» параметр типа " + л + " должен выполнять интерфейс " + нужен + ": <" + л + ": "
                + нужен + ">")
        }
        вернуть ру(с, с_пом(у, "тип_операндов", л), "лог")
    }
    если типы.это_результат(л) или типы.это_результат(п) {
        перем т = п
        если типы.это_результат(л) { т = л }
        вернуть ру(ошибка_необяз(с, у, т, "сравнение невозможно"), у, "лог")
    }
    пусть равенство = оп == "==" или оп == "!="
    если л == "ничего" или п == "ничего" {
        перем другой = л
        перем сторона = "левый"
        если л == "ничего" {
            другой = п
            сторона = "правый"
        }
        если не равенство {
            с = ошибка(с, у, "с «ничего» можно сравнивать только на равенство (== и !=)")
        } иначе если другой == "ничего" {
            с = ошибка(с, у, "«ничего» всегда равно «ничего»")
        } иначе если не типы.это_необяз(другой) {
            с = ошибка(с, у, "значение типа " + другой + " есть всегда, оно не может быть равно «ничего»")
        }
        вернуть ру(с, с_пом(у, "сравнение_с_ничего", сторона), "лог")
    }
    если типы.это_необяз(л) или типы.это_необяз(п) {
        вернуть ру(ошибка(с, у, "необязательное значение можно сравнить только с «ничего»; чтобы сравнить "
            + "само значение, извлеките его: «если пусть знач = ... { }»"), у, "лог")
    }
    если с.типы.содержит(л) или с.типы.содержит(п) или с.перечисления.содержит(л) или с.перечисления.содержит(п) {
        если л != п {
            с = ошибка(с, у, "нельзя сравнивать " + л + " и " + п)
        } иначе если не равенство {
            с = ошибка(с, у, "значения типа " + л + " можно сравнивать только на равенство (== и !=)")
        } иначе если не сравнимый(с, л) {
            с = ошибка(с, у, "значения типа " + л + " нельзя сравнивать: в его полях есть значения, которые не сравниваются "
                + "(функции или каналы)")
        }
        вернуть ру(с, с_пом(у, "тип_операндов", л), "лог")
    }
    если число(л) и число(п) {
        пусть общий_ = типы.общий_числовой([л, п])
        у = привести_часть(привести_часть(у, "левый", л, общий_), "правый", п, общий_)
        вернуть ру(с, с_пом(у, "тип_операндов", общий_), "лог")
    }
    если (л == "длинное" или п == "длинное") и (л == "цел" или л == "длинное") и (п == "цел" или п == "длинное") {
        у = привести_часть(привести_часть(у, "левый", л, "длинное"), "правый", п, "длинное")
        вернуть ру(с, с_пом(у, "тип_операндов", "длинное"), "лог")
    }
    если (л == "компл" или п == "компл") и (число(л) или л == "компл") и (число(п) или п == "компл") {
        если не равенство {
            вернуть ру(ошибка(с, у, "комплексные числа можно сравнивать только на равенство (== и !=); "
                + "по величине сравнивают их модули: з.модуль"), у, "лог")
        }
        у = привести_часть(привести_часть(у, "левый", л, "компл"), "правый", п, "компл")
        вернуть ру(с, с_пом(у, "тип_операндов", "компл"), "лог")
    }
    если (л == "мн" или п == "мн") и в_мн(л) и в_мн(п) {
        если не равенство { с = ошибка(с, у, "многочлены можно сравнивать только на равенство (== и !=)") }
        у = привести_часть(привести_часть(у, "левый", л, "мн"), "правый", п, "мн")
        вернуть ру(с, с_пом(у, "тип_операндов", "мн"), "лог")
    }
    если равенство и л == п и (л == "стр" или л == "лог" или л == "байты") { вернуть ру(с, у, "лог") }
    если л == "дата" и п == "дата" { вернуть ру(с, с_пом(у, "тип_операндов", "дата"), "лог") }
    если не равенство и л == "стр" и п == "стр" { вернуть ру(с, у, "лог") }
    если типы.это_словарь(л) или типы.это_словарь(п) или л == "{}" или п == "{}" {
        если не равенство {
            вернуть ру(ошибка(с, у, "словари можно сравнивать только на равенство (== и !=)"), у, "лог")
        }
        перем т = л
        если л == "{}" { т = п }
        если т == "{}" { вернуть ру(ошибка(с, у, "пустые словари всегда равны"), у, "лог") }
        для сторона в ["левый", "правый"] {
            пусть р = согласовать_часть(с, у, сторона, тип_узла(ч(у, сторона)), т)
            с = р.с
            у = р.у
            если не р.да { вернуть ру(ошибка(с, у, "нельзя сравнивать " + л + " и " + п), у, "лог") }
        }
        если не сравнимый(с, т) { с = ошибка(с, у, "словари типа " + т + " нельзя сравнивать") }
        вернуть ру(с, с_пом(у, "тип_операндов", т), "лог")
    }
    если типы.это_список(л) или типы.это_список(п) или л == "[]" или п == "[]" {
        если не равенство {
            вернуть ру(ошибка(с, у, "списки можно сравнивать только на равенство (== и !=)"), у, "лог")
        }
        если л == "[]" и п == "[]" { вернуть ру(ошибка(с, у, "пустые списки всегда равны"), у, "лог") }
        перем т = л
        если л == "[]" { т = п }
        для сторона в ["левый", "правый"] {
            пусть р = согласовать_часть(с, у, сторона, тип_узла(ч(у, сторона)), т)
            с = р.с
            у = р.у
            если не р.да { вернуть ру(ошибка(с, у, "нельзя сравнивать " + л + " и " + п), у, "лог") }
        }
        если не сравнимый(с, т) { с = ошибка(с, у, "списки типа " + т + " нельзя сравнивать: их элементы не сравниваются") }
        вернуть ру(с, с_пом(у, "тип_операндов", т), "лог")
    }
    если не равенство и л == п и (л == "стр" или л == "лог") {
        с = ошибка(с, у, "значения типа " + л + " можно сравнивать только на равенство (== и !=)")
    } иначе {
        с = ошибка(с, у, "нельзя сравнивать " + л + " и " + п)
    }
    вернуть ру(с, у, "лог")
}

/// Тип результата «л оп п»; операнды (части «часть_л» и «часть_п» узла) отмечаются для приведения к нему.
функ арифметика(исходное: Сост, исходный: разбор.Узел, оп: стр, л: стр, п: стр, часть_л: стр, часть_п: стр) -> Р {
    перем с = исходное
    перем у = исходный
    если л == НЕИЗВ() или п == НЕИЗВ() { вернуть ру(с, у, НЕИЗВ()) }
    если типы.это_особое(л) или типы.это_особое(п) {
        перем т = п
        если типы.это_особое(л) { т = л }
        вернуть ру(ошибка_необяз(с, у, т, "операцию «" + оп + "» нельзя выполнить"), у, НЕИЗВ())
    }
    если с.параметры_типов.содержит(л) или с.параметры_типов.содержит(п) {
        перем т = п
        если с.параметры_типов.содержит(л) { т = л }
        если л != п {
            с = ошибка(с, у, "операция «" + оп + "» соединяет значения одного типа, а здесь " + л + " и " + п + "; "
                + "число приводится к параметру типа так: " + т + "(1)")
        } иначе если не с.параметры_типов[т].содержит("Числовое") или оп == "%" {
            если оп == "%" {
                с = ошибка(с, у, "остаток «%» вычисляется только для целых чисел, а здесь параметр типа " + т)
            } иначе {
                с = ошибка(с, у, "для «" + оп + "» параметр типа " + т + " должен выполнять интерфейс Числовое: <" + т
                    + ": Числовое>")
            }
        } иначе {
            вернуть ру(с, у, т)
        }
        вернуть ру(с, у, НЕИЗВ())
    }
    если л == "дата" или п == "дата" {
        если оп == "+" и ((л == "дата" и п == "цел") или (л == "цел" и п == "дата")) {
            перем вид = "radd"
            если л == "дата" { вид = "add" }
            вернуть ру(с, с_пом(у, "операция_даты", вид), "дата")
        }
        если оп == "-" и л == "дата" и п == "цел" { вернуть ру(с, с_пом(у, "операция_даты", "sub"), "дата") }
        если оп == "-" и л == "дата" и п == "дата" { вернуть ру(с, с_пом(у, "операция_даты", "diff"), "цел") }
        вернуть ру(ошибка(с, у, "с датами возможны действия: дата + цел и дата - цел (прибавить или вычесть дни), "
            + "дата - дата (число дней между датами), а здесь «" + л + " " + оп + " " + п + "»; месяцы и годы "
            + "прибавляют функции добавить_месяцы и добавить_годы"), у, НЕИЗВ())
    }
    если л == "мн" или п == "мн" {
        если в_мн(л) и в_мн(п) {
            вернуть ру(с, привести_часть(привести_часть(у, часть_л, л, "мн"), часть_п, п, "мн"), "мн")
        }
        вернуть ру(ошибка(с, у, "многочлен можно соединять с целыми числами, обыкновенными дробями "
            + "и другими многочленами, а здесь " + л + " и " + п + "; десятичную дробь запишите как рац(...)"), у, НЕИЗВ())
    }
    если (л == "компл" или п == "компл") и (число(л) или л == "компл") и (число(п) или п == "компл") {
        если оп == "%" { вернуть ру(ошибка(с, у, "остаток от деления «%» для комплексных чисел не определён"), у, НЕИЗВ()) }
        вернуть ру(с, привести_часть(привести_часть(у, часть_л, л, "компл"), часть_п, п, "компл"), "компл")
    }
    если (л == "длинное" или п == "длинное") и (л == "цел" или л == "длинное") и (п == "цел" или п == "длинное") {
        вернуть ру(с, привести_часть(привести_часть(у, часть_л, л, "длинное"), часть_п, п, "длинное"), "длинное")
    }
    если л == "длинное" или п == "длинное" {
        вернуть ру(ошибка(с, у, "длинное целое соединяется только с целыми числами, а здесь " + л + " и " + п + "; "
            + "для дробей преобразуйте его: дроб(...)"), у, НЕИЗВ())
    }
    если оп == "%" {
        если л == "цел" и п == "цел" { вернуть ру(с, у, "цел") }
        вернуть ру(ошибка(с, у, "остаток от деления «%» вычисляется только для целых чисел и многочленов, а здесь "
            + л + " и " + п), у, НЕИЗВ())
    }
    если число(л) и число(п) {
        перем результат = типы.общий_числовой([л, п])
        если оп == "/" и результат == "цел" {
            // деление точное: частное двух целых - обыкновенная дробь; с остатком - частное(а, б) и а % б
            результат = "рац"
            у = с_пом(у, "деление_целых", "True")
        }
        вернуть ру(с, привести_часть(привести_часть(у, часть_л, л, результат), часть_п, п, результат), результат)
    }
    если оп == "+" и л == п и (л == "стр" или л == "байты") { вернуть ру(с, у, л) }
    если оп == "+" и (л == "стр" или п == "стр") {
        с = ошибка(с, у, "нельзя сложить " + л + " и " + п + "; строку можно соединять только со строкой")
    } иначе {
        с = ошибка(с, у, "операция «" + оп + "» не применима к типам " + л + " и " + п)
    }
    вернуть ру(с, у, НЕИЗВ())
}

/// Возведение в степень «а ^ н».
функ степень(с: Сост, исходный: разбор.Узел, л: стр, п: стр) -> Р {
    перем у = исходный
    если л == НЕИЗВ() или п == НЕИЗВ() { вернуть ру(с, у, НЕИЗВ()) }
    если л == "мн" {
        если п != "цел" {
            вернуть ру(ошибка(с, ч(у, "правый"), "многочлен можно возводить только в целую степень, а здесь " + п), у, НЕИЗВ())
        }
        вернуть ру(с, у, "мн")
    }
    если (л == "компл" или п == "компл") и (число(л) или л == "компл") и (число(п) или п == "компл") {
        у = привести_часть(у, "левый", л, "компл")
        если п != "цел" { у = привести_часть(у, "правый", п, "компл") }    // целая степень вычисляется умножением
        вернуть ру(с, у, "компл")
    }
    если л == "длинное" {
        если п != "цел" {
            вернуть ру(ошибка(с, ч(у, "правый"), "длинное целое возводится только в целую степень, а здесь " + п), у, НЕИЗВ())
        }
        вернуть ру(с, у, "длинное")
    }
    если не число(л) или не число(п) {
        вернуть ру(ошибка(с, у, "возводить в степень можно только числа, а здесь " + л + " и " + п), у, НЕИЗВ())
    }
    если п == "цел" и (л == "цел" или л == "рац") { вернуть ру(с, у, л) }
    // дробное основание или нецелый показатель: вычисление в дробных числах
    вернуть ру(с, привести_часть(привести_часть(у, "левый", л, "дроб"), "правый", п, "дроб"), "дроб")
}

функ в_диапазон(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем у = исходный
    для сторона в ["начало", "конец"] {
        пусть р = выражение(с, ч(у, сторона))
        с = р.с
        у = с_частью(у, сторона, р.у)
        если р.т != "цел" и р.т != НЕИЗВ() {
            с = ошибка(с, р.у, "границы диапазона должны быть целыми числами, а здесь " + р.т)
        }
    }
    вернуть ру(с, у, "диапазон")
}

// ---------- вызовы ----------

/// Функция C метода строки и нужна ли ей строка-аргумент: «dan_str_split|True».
функ си_метод_строки(имя: стр, номер: цел) -> [стр] {
    выбор имя {
        "найти" { вернуть ["dan_str_find", "False"] }
        "содержит" { вернуть ["dan_str_contains", "False"] }
        "начинается" { вернуть ["dan_str_starts", "False"] }
        "оканчивается" { вернуть ["dan_str_ends", "False"] }
        "заменить" { вернуть ["dan_str_replace", "True"] }
        "разбить" {
            если номер == 0 { вернуть ["dan_str_split_ws", "False"] }
            вернуть ["dan_str_split", "True"]
        }
        "прописные" { вернуть ["dan_str_upper", "False"] }
        "строчные" { вернуть ["dan_str_lower", "False"] }
        "обрезать" { вернуть ["dan_str_trim", "False"] }
        "символы" { вернуть ["dan_str_chars", "False"] }
        иначе { вернуть ["dan_str_repeat", "True"] }
    }
}

/// Суффикс функции C метода списка и признак «строка».
функ си_метод_списка(имя: стр) -> [стр] {
    выбор имя {
        "добавить" { вернуть ["push", "False"] }
        "вставить" { вернуть ["insert", "True"] }
        "удалить" { вернуть ["remove", "True"] }
        "содержит" { вернуть ["contains", "False"] }
        "найти" { вернуть ["find", "False"] }
        "копия" { вернуть ["copy", "False"] }
        "обратный" { вернуть ["reversed", "False"] }
        иначе { вернуть ["join", "False"] }
    }
}

функ с_аргументом(у: разбор.Узел, номер: цел, арг: разбор.Узел) -> разбор.Узел {
    перем аргументы = гр(у, "аргументы")
    аргументы[номер] = арг
    вернуть с_группой(у, "аргументы", аргументы)
}

функ аргумент(у: разбор.Узел, номер: цел) -> разбор.Узел { вернуть гр(у, "аргументы")[номер] }

функ в_вызов(исходное: Сост, исходный: разбор.Узел, первый: стр, есть_первый: лог) -> Р {
    перем с = исходное
    перем у = исходный
    если ч(у, "функция").вид == "Поле" { вернуть метод(с, у) }
    перем аргументы = гр(у, "аргументы")
    перем типы_арг: [стр] = []
    для н в 0..аргументы.длина - 1 {
        если н == 0 и есть_первый {
            типы_арг.добавить(первый)
        } иначе {
            пусть р = выражение(с, аргументы[н])
            с = р.с
            аргументы[н] = р.у
            типы_арг.добавить(р.т)
        }
    }
    у = с_группой(у, "аргументы", аргументы)
    пусть ф = ч(у, "функция")
    если ф.вид != "Имя" { вернуть вызов_значения(с, у, типы_арг) }
    пусть имя = ф.текст
    пусть н = найти(с, имя, истина)
    с = н.с
    если н.есть и типы.это_функция(н.п.т) { вернуть вызов_значения(с, у, типы_арг) }
    у = с_частью(у, "функция", с_пом(ф, "тип_выр", "функция"))
    если не н.есть {
        если с.шаблоны.содержит(имя) { вернуть обобщённый_вызов(с, у, имя, типы_арг) }
        если с.обобщённые_варианты.содержит(имя) { вернуть обобщённый_вариант(с, у, имя, типы_арг) }
        если с.обобщённые_типы.содержит(имя) {
            если с.обобщённые_типы[имя].вид == "ОбъявлениеВариантов" {
                вернуть ру(ошибка(с, у, "«" + имя + "» - перечисление; значения создаются его вариантами"), у, НЕИЗВ())
            }
            вернуть обобщённый_конструктор(с, у, имя, типы_арг)
        }
        если с.параметры_типов.содержит(имя) { вернуть преобразование_в_параметр(с, у, имя, типы_арг) }
        если с.типы.содержит(имя) { вернуть конструктор(с, у, имя, типы_арг) }
        если с.вариант_тип.содержит(имя) { вернуть конструктор_варианта(с, у, имя, типы_арг, "") }
    }
    если есть_имена(у) и (не с.функции.содержит(имя) или н.есть) {
        с = ошибка(с, у, "именованные аргументы («имя = значение») можно передавать функциям "
            + "программы и при создании значений собственных типов")
        у = с_группой(у, "имена", [])
    }
    если имя == "вывод" {
        если типы_арг.длина != 1 {
            с = ошибка(с, у, "функция «вывод» принимает одно значение, а передано " + стр(типы_арг.длина))
        } иначе если типы_арг[0] == "[]" {
            у = с_аргументом(у, 0, с_пом(аргумент(у, 0), "тип_выр", "[цел]"))      // пустой список выводится как []
        } иначе если типы.это_особое(типы_арг[0]) и не можно_вывести(с, типы_арг[0]) {
            с = ошибка_необяз(с, аргумент(у, 0), типы_арг[0], "вывести нельзя")
        } иначе если не можно_вывести(с, типы_арг[0]) {
            с = ошибка(с, аргумент(у, 0), "это выражение не имеет значения, которое можно вывести")
        }
        вернуть ру(с, у, ПУСТО())
    }
    если имя == "канал" {
        если типы_арг.длина > 1 или (типы_арг.длина == 1 и не типы.совместим(типы_арг[0], "цел")) {
            с = ошибка(с, у, "«канал()» создаёт канал без запаса, «канал(10)» - с запасом на 10 значений")
        }
        вернуть ру(с, отложить(у, "канал", "канал", "", []), "канал<>")
    }
    если имя == "ошибка" {
        если типы_арг.длина != 1 или не типы.совместим(типы_арг[0], "стр") {
            с = ошибка(с, у, "«ошибка» принимает одно значение - текст ошибки: ошибка(\"файл не найден\")")
        }
        вернуть ру(с, у, "ошибка")
    }
    если имя == "ввод" {
        если типы_арг.длина > 1 {
            с = ошибка(с, у, "функция «ввод» принимает не более одного значения: текст подсказки")
        } иначе если типы_арг.длина == 1 и не типы.совместим(типы_арг[0], "стр") {
            с = ошибка(с, аргумент(у, 0), "подсказка для «ввод» должна быть строкой, а здесь " + типы_арг[0])
        }
        вернуть ру(с, у, "стр")
    }
    если встроенный_тип(имя) { вернуть преобразование(с, у, имя, типы_арг) }
    если не с.функции.содержит(имя) {
        если н.есть { вернуть ру(ошибка(с, у, "«" + имя + "» - переменная, а не функция"), у, НЕИЗВ()) }
        пусть каноническое = в_библиотеке(с, имя)
        если каноническое != "" {
            вернуть библиотека(проверить_устаревание(с, у, каноническое), у, каноническое, типы_арг)
        }
        вернуть ру(ошибка(с, у, "функция «" + имя + "» не объявлена" + подсказка(имя, видимые_функции(с))), у, НЕИЗВ())
    }
    пусть сигн = с.функции[имя]
    с = проверить_устаревание(с, у, имя)
    перем типы_ = типы_арг
    если есть_имена(у) {
        перем умолч: [лог] = []
        для к в сигн.имена { умолч.добавить(ложь) }
        пусть п = сопоставить_аргументы(с, у, сигн.имена, умолч, "функции «" + имя + "»", "параметра")
        с = п.с
        если не п.есть { вернуть ру(с, у, сигн.результат) }
        у = переставить(у, п.номера)
        типы_ = переставить_типы(типы_, п.номера)
    }
    если типы_.длина != сигн.параметры.длина {
        вернуть ру(ошибка(с, у, "функция «" + имя + "» принимает " + склонение_значений(сигн.параметры.длина) + ", а передано "
            + стр(типы_.длина)), у, сигн.результат)
    }
    пусть р = согласовать_аргументы(с, у, типы_, сигн.параметры, " функции «" + имя + "»")
    вернуть ру(р.с, р.у, сигн.результат)
}

/// Преобразование функцией с названием типа: цел(х), стр(х), компл(в, м), дата(г, м, д)...
функ преобразование(исходное: Сост, исходный: разбор.Узел, имя: стр, типы_арг: [стр]) -> Р {
    перем с = исходное
    перем у = исходный
    если преобразования(имя).длина == 0 {
        вернуть ру(ошибка(с, у, "преобразование в тип " + имя + " не поддерживается; используйте сравнение, например «х != 0»"),
                   у, НЕИЗВ())
    }
    если имя == "компл" и типы_арг.длина == 2 {
        // компл(вещественная часть, мнимая часть)
        для н в 0..1 {
            если число(типы_арг[н]) или типы_арг[н] == НЕИЗВ() {
                у = с_аргументом(у, н, привести(аргумент(у, н), типы_арг[н], "дроб"))
            } иначе {
                с = ошибка(с, аргумент(у, н), "части комплексного числа - обычные числа, а здесь " + типы_арг[н])
            }
        }
        вернуть ру(с, у, "компл")
    }
    если имя == "дата" и типы_арг.длина == 3 {
        для н в 0..2 {
            если типы_арг[н] != "цел" и типы_арг[н] != НЕИЗВ() {
                с = ошибка(с, аргумент(у, н), "год, месяц и день даты - целые числа, а здесь " + типы_арг[н])
            }
        }
        вернуть ру(с, у, "дата")
    }
    если имя == "рац" и типы_арг.длина == 2 {
        для н в 0..1 {
            если типы_арг[н] != "цел" и типы_арг[н] != НЕИЗВ() {
                с = ошибка(с, аргумент(у, н), "числитель и знаменатель должны быть целыми числами, а здесь " + типы_арг[н])
            }
        }
        вернуть ру(с, у, "рац")
    }
    если типы_арг.длина != 1 {
        вернуть ру(ошибка(с, у, "преобразование «" + имя + "(...)» принимает одно значение, а передано " + стр(типы_арг.длина)),
                   у, имя)
    }
    пусть т = типы_арг[0]
    если имя == "байты" {
        перем подходит = т == "[]"
        если не подходит {
            пусть р = согласовать(с, аргумент(у, 0), т, "[цел]")
            с = р.с
            у = с_аргументом(у, 0, р.у)
            подходит = р.да
        }
        если подходит {
            если т == "[]" { у = с_аргументом(у, 0, с_пом(аргумент(у, 0), "тип_выр", "[цел]")) }
            вернуть ру(с, с_пом(у, "из_списка", "True"), "байты")
        }
    }
    если (имя == "стр" и (типы.это_необяз(т) или с.типы.содержит(т) или с.перечисления.содержит(т) или типы.это_словарь(т)
            или с.параметры_типов.содержит(т))) {
        вернуть ру(с, у, "стр")
    }
    если имя == "стр" и (типы.это_список(т) или т == "[]") {
        если т == "[]" { у = с_аргументом(у, 0, с_пом(аргумент(у, 0), "тип_выр", "[цел]")) }
        вернуть ру(с, у, "стр")
    }
    если не преобразования(имя).содержит(т) и т != НЕИЗВ() {
        с = ошибка(с, аргумент(у, 0), "значение типа " + т + " нельзя преобразовать в " + имя)
    }
    вернуть ру(с, у, имя)
}

/// Вызов функции, которая хранится в переменной, элементе списка, поле и т.п.
функ вызов_значения(исходное: Сост, исходный: разбор.Узел, типы_арг: [стр]) -> Р {
    перем с = исходное
    пусть рф = выражение(с, ч(исходный, "функция"))
    с = рф.с
    перем у = с_частью(исходный, "функция", рф.у)
    пусть т = рф.т
    если т == НЕИЗВ() { вернуть ру(с, у, НЕИЗВ()) }
    если не типы.это_функция(т) {
        вернуть ру(ошибка(с, у, "вызвать можно только функцию, а здесь значение типа " + т), у, НЕИЗВ())
    }
    если есть_имена(у) { с = ошибка(с, у, "функции-значению аргументы передаются по порядку, без имён") }
    пусть ф = типы.разобрать_тип_функции(т)
    если типы_арг.длина != ф.параметры.длина {
        с = ошибка(с, у, "функция принимает " + склонение_значений(ф.параметры.длина) + ", а передано " + стр(типы_арг.длина))
    } иначе {
        пусть р = согласовать_аргументы(с, у, типы_арг, ф.параметры, "")
        с = р.с
        у = р.у
    }
    вернуть ру(с, с_пом(у, "вызов_значения", т), ф.результат)
}

/// Безымянная функция. Если типы параметров не указаны, они берутся из места использования
/// (ожидаемые); до этого проверка откладывается (тип ОТЛОЖЕННАЯ).
функ лямбда(исходное: Сост, исходный: разбор.Узел, ожидаемые: [стр], есть_ожидаемые: лог, ожидаемый_результат: стр,
            есть_результат: лог) -> Р {
    перем с = исходное
    перем у = исходный
    пусть параметры = гр(у, "параметры")
    перем типы_п: [стр] = []
    для н в 0..параметры.длина - 1 {
        пусть п = параметры[н]
        если св(п, "тип") != "" {
            пусть р = тип_по_имени(с, п, св(п, "тип"))
            с = р.с
            типы_п.добавить(р.т)
        } иначе если есть_ожидаемые {
            типы_п.добавить(ожидаемые[н])
        } иначе {
            вернуть ру(с, у, ОТЛОЖЕННАЯ())
        }
    }
    если есть_ожидаемые {
        для н в 0..параметры.длина - 1 {
            если н >= ожидаемые.длина { прервать }
            пусть п = параметры[н]
            если св(п, "тип") != "" и типы_п[н] != ожидаемые[н] {
                с = ошибка(с, п, "параметр «" + св(п, "имя") + "» должен иметь тип " + ожидаемые[н] + ", а указан " + типы_п[н])
            }
        }
    }
    перем результат = св(у, "тип_результата")
    если результат != "" и результат != ПУСТО() + "!" {
        пусть р = тип_по_имени(с, у, результат)
        с = р.с
        результат = р.т
    }
    если результат == "" и есть_результат и не есть(у, "выражение") { результат = ожидаемый_результат }
    с.лямбды.добавить(ЛямбдаВ(с.области.длина))
    с = новая_область(с)
    для н в 0..параметры.длина - 1 {
        с.области[с.области.длина - 1][св(параметры[н], "имя")] = Переменная(типы_п[н], ложь, "параметр")
    }
    пусть прежде_в_функции = с.в_функции
    пусть прежнее_имя = с.функция_имя
    пусть прежний_результат = с.функция_результат
    пусть прежние_циклы = с.глубина_циклов
    пусть прежнее_параллельно = с.в_параллельном
    с.глубина_циклов = 0
    с.в_параллельном = 0
    с.в_функции = истина
    с.функция_имя = "безымянная функция"
    если есть(у, "выражение") {
        с.функция_результат = результат
        если результат == "" { с.функция_результат = НЕИЗВ() }
        пусть рв = выражение(с, ч(у, "выражение"))
        с = рв.с
        у = с_частью(у, "выражение", рв.у)
        перем т = рв.т
        если т == ОТЛОЖЕННАЯ() {
            с = ошибка(с, рв.у, "укажите типы параметров вложенной безымянной функции")
            т = НЕИЗВ()
        }
        перем нужный = результат
        если нужный == "" и есть_результат и ожидаемый_результат != НЕИЗВ() { нужный = ожидаемый_результат }
        если нужный != "" и нужный != ПУСТО() {
            пусть рс = согласовать(с, ч(у, "выражение"), т, нужный)
            с = рс.с
            у = с_частью(у, "выражение", рс.у)
            если не рс.да { с = ошибка(с, рс.у, "функция должна вернуть " + нужный + ", а выражение имеет тип " + т) }
            результат = нужный
        } иначе если т == "диапазон" {
            результат = НЕИЗВ()
        } иначе {
            результат = т
        }
    } иначе {
        если результат == "" { результат = ПУСТО() }
        с.функция_результат = результат
        пусть неполных = с.неполных_выборов
        пусть рб = блок(с, ч(у, "тело"), ложь)
        с = рб.с
        у = с_частью(у, "тело", рб.у)
        если (результат != ПУСТО() и результат != НЕИЗВ() и результат != ПУСТО() + "!" и не всегда_возвращает(рб.у)
                и с.неполных_выборов == неполных) {
            с = ошибка(с, у, "безымянная функция может завершиться, не вернув значение")
        }
    }
    с.в_функции = прежде_в_функции
    с.функция_имя = прежнее_имя
    с.функция_результат = прежний_результат
    с.глубина_циклов = прежние_циклы
    с.в_параллельном = прежнее_параллельно
    с = убрать_область(с)
    пусть захваты = с.лямбды[с.лямбды.длина - 1].захваты
    с.лямбды.удалить(с.лямбды.длина - 1)
    перем список_захватов: [разбор.Узел] = []
    для имя в захваты.ключи() { список_захватов.добавить(разбор.Узел("=", [разбор.Свойство(имя, захваты[имя])])) }
    у = с_группой(у, "захваты", список_захватов)
    у = с_пом(с_пом(у, "типы_параметров", типы_п.соединить("\n")), "тип_итог", результат)
    вернуть ру(с, у, типы.тип_функции(типы_п, результат))
}

/// Функция - аргумент функционального метода: безымянная функция получает типы параметров.
функ функция_аргумент(исходное: Сост, исходный: разбор.Узел, номер: цел, тип_арг: стр, параметры: [стр],
                      результат: стр, есть_результат: лог, образец: стр) -> Р {
    перем с = исходное
    перем у = исходный
    пусть а = аргумент(у, номер)
    если а.вид == "Лямбда" и тип_арг == ОТЛОЖЕННАЯ() {
        если гр(а, "параметры").длина != параметры.длина {
            вернуть ру(ошибка(с, а, "функция должна принимать " + склонение_значений(параметры.длина) + ": " + образец), у, "")
        }
        пусть р = лямбда(с, а, параметры, истина, результат, есть_результат)
        вернуть ру(р.с, с_аргументом(у, номер, с_пом(р.у, "тип_выр", р.т)), р.т)
    }
    если тип_арг == НЕИЗВ() { вернуть ру(с, у, "") }
    если не типы.это_функция(тип_арг) или типы.разобрать_тип_функции(тип_арг).параметры != параметры {
        вернуть ру(ошибка(с, а, "ожидается функция с параметрами (" + параметры.соединить(", ") + "), а здесь " + тип_арг + ": "
            + образец), у, "")
    }
    вернуть ру(с, у, тип_арг)
}

функ с_методом_функции(у: разбор.Узел, имя: стр, ф: стр, т: стр) -> разбор.Узел {
    вернуть с_пом(с_пом(с_пом(у, "метод_функции", имя), "метод_функции_тип", ф), "метод_функции_результат", т)
}

функ функциональный_метод(исходное: Сост, исходный: разбор.Узел, имя: стр, т: стр, типы_арг: [стр]) -> Р {
    перем с = исходное
    перем у = исходный
    пусть образец = образец_метода(имя)
    перем нужно = 1
    если имя == "свернуть" { нужно = 2 }
    если типы_арг.длина != нужно { вернуть ру(ошибка(с, у, "метод вызывается так: " + образец), у, НЕИЗВ()) }
    если имя == "свернуть" {
        пусть начальное = типы_арг[0]
        если начальное == НЕИЗВ() или начальное == "[]" или начальное == "{}" или начальное == "ничего" {
            если начальное != НЕИЗВ() { с = ошибка(с, аргумент(у, 0), "у начального значения должен быть известен тип") }
            вернуть ру(с, у, НЕИЗВ())
        }
        пусть рф = функция_аргумент(с, у, 1, типы_арг[1], [начальное, т], начальное, истина, образец)
        с = рф.с
        у = рф.у
        если рф.т == "" { вернуть ру(с, у, НЕИЗВ()) }
        пусть рез = типы.разобрать_тип_функции(рф.т).результат
        если рез != начальное {
            с = ошибка(с, аргумент(у, 1), "функция должна возвращать " + начальное + " (тип начального значения), а возвращает " + рез)
        }
        вернуть ру(с, с_методом_функции(у, имя, рф.т, начальное), начальное)
    }
    пусть условие_ = имя == "отобрать" или имя == "любой" или имя == "все" или имя == "найти_первый"
    пусть рф = функция_аргумент(с, у, 0, типы_арг[0], [т], "лог", условие_, образец)
    с = рф.с
    у = рф.у
    если рф.т == "" { вернуть ру(с, у, НЕИЗВ()) }
    пусть рез = типы.разобрать_тип_функции(рф.т).результат
    если условие_ и рез != "лог" {
        вернуть ру(ошибка(с, аргумент(у, 0), "условие должно иметь тип лог, а функция возвращает " + рез), у, НЕИЗВ())
    }
    если имя == "преобразовать" {
        если рез == ПУСТО() или рез == НЕИЗВ() или типы.это_результат(рез) {
            если рез != НЕИЗВ() { с = ошибка(с, аргумент(у, 0), "функция должна возвращать значение, а возвращает " + рез) }
            вернуть ру(с, у, НЕИЗВ())
        }
        вернуть ру(с, с_методом_функции(у, имя, рф.т, рез), "[" + рез + "]")
    }
    если имя == "упорядочить_по" {
        если не ["цел", "рац", "дроб", "стр", "дата"].содержит(рез) {
            вернуть ру(ошибка(с, аргумент(у, 0), "ключ упорядочивания должен быть числом, строкой или датой, а здесь " + рез),
                       у, НЕИЗВ())
        }
        вернуть ру(с, с_методом_функции(у, имя, рф.т, рез), "[" + т + "]")
    }
    у = с_методом_функции(у, имя, рф.т, "лог")
    если имя == "найти_первый" {
        если типы.это_функция(т) {
            вернуть ру(ошибка(с, у, "для списка функций «найти_первый» недоступен; используйте «отобрать»"), у, НЕИЗВ())
        }
        если типы.это_необяз(т) { вернуть ру(с, у, т) }
        вернуть ру(с, у, т + "?")
    }
    если имя == "отобрать" { вернуть ру(с, у, "[" + т + "]") }
    вернуть ру(с, у, "лог")
}

/// Создание значения собственного типа: Сотрудник(имя = "Иванов", оклад = 65000).
функ конструктор(исходное: Сост, исходный: разбор.Узел, имя: стр, типы_арг: [стр]) -> Р {
    перем с = исходное
    перем у = с_пом(исходный, "конструктор", имя)
    пусть поля = с.типы[имя]
    перем имена: [стр] = []
    перем умолч: [лог] = []
    для п в поля {
        имена.добавить(п.имя)
        умолч.добавить(п.по_умолчанию.длина > 0)
    }
    пусть порядок = сопоставить_аргументы(с, у, имена, умолч, "типа " + имя, "поля")
    с = порядок.с
    если не порядок.есть { вернуть ру(с, у, имя) }
    перем аргументы = гр(у, "аргументы")
    перем значения: [разбор.Узел] = []
    для н в 0..поля.длина - 1 {
        пусть номер = порядок.номера[н]
        если номер == -1 {
            значения.добавить(поля[н].по_умолчанию[0])
            продолжить
        }
        пусть р = согласовать(с, аргументы[номер], типы_арг[номер], поля[н].т)
        с = р.с
        аргументы[номер] = р.у
        если не р.да {
            с = ошибка(с, р.у, "поле «" + поля[н].имя + "» имеет тип " + поля[н].т + ", а значение имеет тип " + типы_арг[номер])
        }
        значения.добавить(р.у)
    }
    вернуть ру(с, с_группой(с_группой(у, "аргументы", аргументы), "значения_полей", значения), имя)
}

функ конструктор_варианта(исходное: Сост, исходный: разбор.Узел, имя: стр, типы_арг: [стр], тип_: стр) -> Р {
    перем с = исходное
    перем т = тип_
    если т == "" { т = с.вариант_тип[имя] }
    перем поля: [ПолеТ] = []
    для в_ в с.перечисления[т] {
        если в_.имя == имя {
            поля = в_.поля
            прервать
        }
    }
    перем имена: [стр] = []
    перем умолч: [лог] = []
    для п в поля {
        имена.добавить(п.имя)
        умолч.добавить(ложь)
    }
    пусть порядок = сопоставить_аргументы(с, исходный, имена, умолч, "варианта " + имя, "поля")
    с = порядок.с
    перем у = с_пом(с_пом(исходный, "вариант_тип", т), "вариант", имя)
    если не порядок.есть { вернуть ру(с, у, т) }
    перем аргументы = гр(у, "аргументы")
    перем значения: [разбор.Узел] = []
    для н в 0..поля.длина - 1 {
        пусть номер = порядок.номера[н]
        пусть р = согласовать(с, аргументы[номер], типы_арг[номер], поля[н].т)
        с = р.с
        аргументы[номер] = р.у
        если не р.да {
            с = ошибка(с, р.у, "поле «" + поля[н].имя + "» имеет тип " + поля[н].т + ", а значение имеет тип " + типы_арг[номер])
        }
        значения.добавить(р.у)
    }
    вернуть ру(с, с_группой(с_группой(у, "аргументы", аргументы), "значения_полей", значения), т)
}

/// Вызов функции библиотеки: выбирается подходящий вариант.
функ библиотека(исходное: Сост, исходный: разбор.Узел, имя: стр, типы_арг: [стр]) -> Р {
    перем с = исходное
    перем у = исходный
    пусть варианты = с.т.варианты[имя]
    для номер в 0..варианты.длина - 1 {
        пусть вар = варианты[номер]
        если вар.параметры.длина != типы_арг.длина { продолжить }
        перем подходит = истина
        перем аргументы = гр(у, "аргументы")
        для к в 0..аргументы.длина - 1 {
            пусть р = согласовать(с, аргументы[к], типы_арг[к], вар.параметры[к])
            с = р.с
            аргументы[к] = р.у
            если не р.да или типы_арг[к] == НЕИЗВ() {
                подходит = ложь
                прервать
            }
        }
        у = с_группой(у, "аргументы", аргументы)
        если подходит {
            вернуть ру(с, с_пом(с_пом(у, "библиотека", имя), "библиотека_номер", стр(номер)), вар.результат)
        }
    }
    если типы_арг.содержит(НЕИЗВ()) { вернуть ру(с, у, НЕИЗВ()) }
    перем записи: [стр] = []
    для вар в варианты { записи.добавить(имя + "(" + вар.параметры.соединить(", ") + ")") }
    перем переданы = типы_арг.соединить(", ")
    если переданы == "" { переданы = "ничего" }
    вернуть ру(ошибка(с, у, "функция «" + имя + "» вызывается так: " + записи.соединить(" или ") + "; а передано: " + переданы),
               у, НЕИЗВ())
}

/// Объект метода или поля; имя-объект проверяется как «приёмник» (задачу можно дождаться).
функ объект(исходное: Сост, у: разбор.Узел) -> Р {
    перем с = исходное
    с.приёмник = у.вид == "Имя"
    пусть р = выражение(с, у)
    с = р.с
    с.приёмник = ложь
    вернуть Р(с, р.у, р.т)
}

функ типы_аргументов(исходное: Сост, исходный: разбор.Узел) -> РТипы {
    перем с = исходное
    перем аргументы = гр(исходный, "аргументы")
    перем типы_: [стр] = []
    для н в 0..аргументы.длина - 1 {
        пусть р = выражение(с, аргументы[н])
        с = р.с
        аргументы[н] = р.у
        типы_.добавить(р.т)
    }
    вернуть РТипы(с, с_группой(исходный, "аргументы", аргументы), типы_)
}

тип РТипы {
    с: Сост
    у: разбор.Узел
    типы: [стр]
}

/// Вызов через точку: список.добавить(х), строка.заменить(а, б).
функ метод(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем у = исходный
    перем поле = ч(у, "функция")
    пусть имя = св(поле, "имя")
    пусть ро = объект(с, ч(поле, "объект"))
    с = ро.с
    поле = с_частью(поле, "объект", ро.у)
    у = с_частью(у, "функция", поле)
    пусть т_об = ро.т
    если типы.это_задача(т_об) {
        пусть ра = типы_аргументов(с, у)
        вернуть метод_задачи(ра.с, ра.у, т_об, имя, ра.типы)
    }
    если типы.это_канал(т_об) {
        пусть ра = типы_аргументов(с, у)
        вернуть метод_канала(ра.с, ра.у, т_об, имя, ра.типы)
    }
    перем основа_типа = т_об
    если т_об.оканчивается(">") и т_об.содержит("<") { основа_типа = типы.срез(т_об, 0, типы.позиция(т_об, "<")) }
    если с.методы.содержит(основа_типа + "|" + имя) и (основа_типа == т_об или с.обобщённые_типы.содержит(основа_типа)) {
        // метод собственного типа: к.площадь() - это вызов функции «Круг.площадь»(к);
        // у обобщённого типа это вызов обобщённой функции, параметры типа берутся из «сам»
        пусть полное = с.методы[основа_типа + "|" + имя]
        перем функция_ = разбор.Узел("Имя", [разбор.Свойство("имя", полное)], [], поле.строка, поле.столбец)
        функция_.текст = полное
        перем аргументы = [ч(поле, "объект")]
        для а в гр(у, "аргументы") { аргументы.добавить(а) }
        у = с_группой(с_частью(у, "функция", функция_), "аргументы", аргументы)
        если есть_имена(у) {
            перем имена = [без_имени()]
            для и_ в гр(у, "имена") { имена.добавить(и_) }
            у = с_группой(у, "имена", имена)
        }
        вернуть в_вызов(с, у, т_об, истина)
    }
    пусть ра = типы_аргументов(с, у)
    с = ра.с
    у = ра.у
    пусть типы_арг = ра.типы
    если с.параметры_типов.содержит(т_об) { вернуть метод_параметра(с, у, т_об, имя, типы_арг) }
    у = с_пом(у, "метод", имя)
    если т_об == НЕИЗВ() { вернуть ру(с, у, НЕИЗВ()) }
    если типы.это_особое(т_об) {
        вернуть ру(ошибка_необяз(с, поле, т_об, "метод «" + имя + "» нельзя вызвать"), у, НЕИЗВ())
    }
    если имя == "длина" и (типы.это_список(т_об) или типы.это_словарь(т_об) или т_об == "стр" или т_об == "байты") {
        вернуть ру(ошибка(с, у, "«длина» - свойство, а не функция; пишите без скобок: «с.длина»"), у, НЕИЗВ())
    }
    если типы.это_словарь(т_об) и методы_словаря().содержит(имя) {
        пусть т_к = типы.ключ_словаря(т_об)
        пусть т_з = типы.значение_словаря(т_об)
        если имя == "найти" и типы.это_функция(т_з) {
            вернуть ру(ошибка(с, у, "для словаря функций «найти» недоступен: проверьте ключ через «содержит» "
                + "и получите функцию через «с[к]»"), у, НЕИЗВ())
        }
        перем необяз_з = т_з + "?"
        если типы.это_необяз(т_з) { необяз_з = т_з }
        пусть подстановка = {"К": т_к, "З": т_з, "З?": необяз_з, "[К]": "[" + т_к + "]", "[З]": "[" + т_з + "]", "С": т_об}
        пусть вар = метод_словаря(имя)
        перем параметры: [стр] = []
        для п в вар.параметры { параметры.добавить(подстановка.получить(п, п)) }
        пусть результат = подстановка.получить(вар.результат, вар.результат)
        если типы_арг.длина != параметры.длина {
            вернуть ру(ошибка(с, у, "«" + имя + "» принимает " + склонение_значений(параметры.длина) + ", а передано "
                + стр(типы_арг.длина)), у, результат)
        }
        пусть р = согласовать_аргументы(с, у, типы_арг, параметры, " метода «" + имя + "»")
        с = р.с
        у = р.у
        если имя == "удалить" {
            пусть з = место(с, ч(поле, "объект"))
            если з.есть { с = ошибка(с, у, текст_запрета("словарь нельзя изменить методом «" + имя + "»", з)) }
        }
        вернуть ру(с, с_пом(у, "метод_словаря", суффикс_словаря(имя)), результат)
    }
    если т_об == "стр" и методы_строки().содержит(имя) {
        пусть варианты = варианты_метода_строки(имя)
        для номер в 0..варианты.длина - 1 {
            пусть вар = варианты[номер]
            если вар.параметры.длина != типы_арг.длина { продолжить }
            перем подходит = истина
            перем аргументы = гр(у, "аргументы")
            для к в 0..аргументы.длина - 1 {
                пусть р = согласовать(с, аргументы[к], типы_арг[к], вар.параметры[к])
                с = р.с
                аргументы[к] = р.у
                если не р.да {
                    подходит = ложь
                    прервать
                }
            }
            у = с_группой(у, "аргументы", аргументы)
            если подходит {
                пусть си = си_метод_строки(имя, номер)
                вернуть ру(с, с_пом(с_пом(у, "метод_c", си[0]), "метод_c_строка", си[1]), вар.результат)
            }
        }
        перем записи: [стр] = []
        для вар в варианты { записи.добавить("с." + имя + "(" + вар.параметры.соединить(", ") + ")") }
        вернуть ру(ошибка(с, у, "метод строки вызывается так: " + записи.соединить(" или ")), у, НЕИЗВ())
    }
    если типы.это_список(т_об) и функциональные_методы().содержит(имя) {
        вернуть функциональный_метод(с, у, имя, типы.элемент(т_об), типы_арг)
    }
    если типы.это_список(т_об) и методы_списка().содержит(имя) {
        пусть т_эл = типы.элемент(т_об)
        пусть вар = метод_списка(имя)
        пусть подстановка = {"Т": т_эл, "[Т]": т_об}
        перем параметры: [стр] = []
        для п в вар.параметры { параметры.добавить(подстановка.получить(п, п)) }
        пусть результат = подстановка.получить(вар.результат, вар.результат)
        если (имя == "содержит" или имя == "найти") и не сравнимый(с, т_эл) {
            вернуть ру(ошибка(с, у, "элементы типа " + т_эл + " нельзя сравнивать, поэтому «" + имя + "» для них недоступен"),
                       у, НЕИЗВ())
        }
        если имя == "соединить" и т_эл != "стр" {
            вернуть ру(ошибка(с, у, "«соединить» работает только со списком строк; используйте стр(...) для элементов"), у,
                       НЕИЗВ())
        }
        если типы_арг.длина != параметры.длина {
            вернуть ру(ошибка(с, у, "«" + имя + "» принимает " + склонение_значений(параметры.длина) + ", а передано "
                + стр(типы_арг.длина)), у, результат)
        }
        пусть р = согласовать_аргументы(с, у, типы_арг, параметры, " метода «" + имя + "»")
        с = р.с
        у = р.у
        если изменяющий_метод(имя) {
            пусть з = место(с, ч(поле, "объект"))
            если з.есть {
                если з.что != "" {
                    с = ошибка(с, у, "метод «" + имя + "» изменяет список, а " + з.что + " изменять нельзя: " + з.почему)
                } иначе {
                    с = ошибка(с, у, "метод «" + имя + "» изменяет список: " + з.почему)
                }
            }
        }
        пусть си = си_метод_списка(имя)
        вернуть ру(с, с_пом(с_пом(у, "метод_списка", си[0]), "метод_списка_строка", си[1]), результат)
    }
    если с.типы.содержит(т_об) {
        для п в с.типы[т_об] {
            если п.имя == имя и типы.это_функция(п.т) { вернуть вызов_значения(с, у, типы_арг) }     // поле хранит функцию
        }
    }
    вернуть ру(ошибка(с, поле, "у значения типа " + т_об + " нет метода «" + имя + "»"), у, НЕИЗВ())
}

функ в_поле(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    пусть имя = св(исходный, "имя")
    пусть ро = объект(с, ч(исходный, "объект"))
    с = ро.с
    перем у = с_частью(исходный, "объект", ро.у)
    пусть т = ро.т
    если т == НЕИЗВ() { вернуть ру(с, у, НЕИЗВ()) }
    если типы.это_задача(т) {
        если имя != "готова" { вернуть ру(ошибка(с, у, "у задачи есть свойство «готова» и метод «дождаться()»"), у, НЕИЗВ()) }
        вернуть ру(с, с_пом(у, "свойство_задачи", "True"), "лог")
    }
    если типы.это_особое(т) { вернуть ру(ошибка_необяз(с, у, т, "поле «" + имя + "» нельзя получить"), у, НЕИЗВ()) }
    если с.перечисления.содержит(т) {
        вернуть ру(ошибка(с, у, "поля значения типа " + т + " зависят от варианта; получите их через «выбор»"), у, НЕИЗВ())
    }
    если с.параметры_типов.содержит(т) {
        вернуть ру(ошибка(с, у, "у значения параметра типа " + т + " нет полей: обобщённая функция работает со значениями "
            + "любого подходящего типа; нужные действия задаются интерфейсом (<" + т + ": Интерфейс>)"), у, НЕИЗВ())
    }
    если с.типы.содержит(т) {
        перем имена: [стр] = []
        для п в с.типы[т] {
            если п.имя == имя { вернуть ру(с, у, п.т) }
            имена.добавить(п.имя)
        }
        вернуть ру(ошибка(с, у, "у типа " + т + " нет поля «" + имя + "»" + подсказка(имя, имена)), у, НЕИЗВ())
    }
    если имя == "длина" и (типы.это_список(т) или типы.это_словарь(т) или т == "стр" или т == "байты" или т == "[]" или т == "{}") {
        вернуть ру(с, у, "цел")
    }
    если свойство_типа(т, имя) != "" { вернуть ру(с, у, свойство_типа(т, имя)) }
    если ((типы.это_список(т) и методы_списка().содержит(имя)) или (т == "стр" и методы_строки().содержит(имя))
            или (типы.это_словарь(т) и методы_словаря().содержит(имя))) {
        вернуть ру(ошибка(с, у, "«" + имя + "» - метод; допишите скобки: «с." + имя + "(...)»"), у, НЕИЗВ())
    }
    вернуть ру(ошибка(с, у, "у значения типа " + т + " нет свойства «" + имя + "»"), у, НЕИЗВ())
}

/// Тип элементов по известным типам: числа приводятся к общему, «ничего» делает тип необязательным.
функ общий_из(известные: [стр], все: [стр]) -> стр {
    перем т = известные[0]
    для к в известные {
        если не к.оканчивается("<>") {
            т = к
            прервать
        }
    }
    перем все_числа = истина
    перем числа_компл = истина
    перем целые_длинные = истина
    для к в известные {
        если не число(к) { все_числа = ложь }
        если не число(к) и к != "компл" { числа_компл = ложь }
        если к != "цел" и к != "длинное" { целые_длинные = ложь }
    }
    если все_числа {
        т = типы.общий_числовой(известные)
    } иначе если известные.содержит("компл") и числа_компл {
        т = "компл"
    } иначе если известные.содержит("длинное") и целые_длинные {
        т = "длинное"
    }
    если все.содержит("ничего") и не типы.это_необяз(т) { т += "?" }
    вернуть т
}

функ в_список(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем элементы = гр(исходный, "элементы")
    перем типы_: [стр] = []
    для н в 0..элементы.длина - 1 {
        пусть р = выражение(с, элементы[н])
        с = р.с
        элементы[н] = р.у
        типы_.добавить(р.т)
    }
    перем у = с_группой(исходный, "элементы", элементы)
    если типы_.длина == 0 { вернуть ру(с, у, "[]") }
    перем известные: [стр] = []
    для т в типы_ {
        если т != НЕИЗВ() и т != "[]" и т != "ничего" { известные.добавить(т) }
    }
    если известные.длина == 0 {
        если типы_.содержит(НЕИЗВ()) {
            для э в элементы {
                если тип_узла(э) == НЕИЗВ() и пом(э, "ждёт_типа") == "" { вернуть ру(с, у, НЕИЗВ()) }
            }
        }
        // тип таких элементов может сообщить место, куда попадёт список: «перем с: [[цел]] = [[]]»
        перем пример = "«пусть с: [[цел]] = [[]]»"
        перем что = "пустых списков"
        если типы_.содержит("ничего") {
            пример = "«пусть с: [стр?] = [ничего]»"
            что = "«ничего»"
        }
        у = с_пом(у, "ждёт_типа", "True")
        с.отложенные[ключ_отложенной(с, у)] = Сообщение(у.строка, у.столбец, "не удаётся определить тип элементов списка из одних "
            + что + "; укажите тип, например " + пример)
        для э в элементы {
            если с.отложенные.содержит(ключ_отложенной(с, э)) { с.отложенные.удалить(ключ_отложенной(с, э)) }
        }
        вернуть ру(с, у, НЕИЗВ())
    }
    пусть т_эл = общий_из(известные, типы_)
    для н в 0..элементы.длина - 1 {
        пусть т = типы_[н]
        если т == ПУСТО() или т == "диапазон" {
            вернуть ру(ошибка(с, элементы[н], "это выражение нельзя сделать элементом списка"), с_группой(у, "элементы", элементы),
                       НЕИЗВ())
        }
        пусть р = согласовать(с, элементы[н], т, т_эл)
        с = р.с
        элементы[н] = р.у
        если не р.да {
            вернуть ру(ошибка(с, р.у, "все элементы списка должны иметь один тип: первый имеет тип " + т_эл + ", а этот " + т),
                       с_группой(у, "элементы", элементы), НЕИЗВ())
        }
    }
    вернуть ру(с, с_группой(у, "элементы", элементы), "[" + т_эл + "]")
}

функ в_словарь(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    перем у = исходный
    перем ключи = гр(у, "ключи")
    перем типы_к: [стр] = []
    для н в 0..ключи.длина - 1 {
        пусть р = выражение(с, ключи[н])
        с = р.с
        ключи[н] = р.у
        типы_к.добавить(р.т)
    }
    перем значения = гр(у, "значения")
    перем типы_з: [стр] = []
    для н в 0..значения.длина - 1 {
        пусть р = выражение(с, значения[н])
        с = р.с
        значения[н] = р.у
        типы_з.добавить(р.т)
    }
    у = с_группой(с_группой(у, "ключи", ключи), "значения", значения)
    если ключи.длина == 0 { вернуть ру(с, у, "{}") }
    пусть рк = общий_тип(с, у, "ключи", типы_к, "ключи", ложь)
    пусть рз = общий_тип(рк.с, рк.у, "значения", типы_з, "значения", истина)
    с = рз.с
    у = рз.у
    если рк.т == НЕИЗВ() или рз.т == НЕИЗВ() { вернуть ру(с, у, НЕИЗВ()) }
    если не типы.ключи_словаря().содержит(рк.т) {
        вернуть ру(ошибка(с, гр(у, "ключи")[0], "ключами словаря могут быть значения типов " + типы.ключи_словаря().соединить(", ")
            + ", а не " + рк.т), у, НЕИЗВ())
    }
    вернуть ру(с, у, типы.словарь(рк.т, рз.т))
}

/// Общий тип ключей или значений записи словаря. С «отложить» ошибка неизвестного типа откладывается:
/// его может сообщить место, куда попадёт запись («перем с: {стр: [цел]} = {"к": []}»).
функ общий_тип(исходное: Сост, исходный: разбор.Узел, группа: стр, типы_: [стр], что: стр, отложить_: лог) -> Р {
    перем с = исходное
    перем у = исходный
    перем узлы = гр(у, группа)
    перем известные: [стр] = []
    для т в типы_ {
        если т != НЕИЗВ() и т != "[]" и т != "{}" и т != "ничего" { известные.добавить(т) }
    }
    если известные.длина == 0 {
        перем ждущие = истина
        для н в 0..узлы.длина - 1 {
            если типы_[н] == НЕИЗВ() и пом(узлы[н], "ждёт_типа") == "" { ждущие = ложь }
        }
        пусть текст = ("не удаётся определить тип, у которого все " + что + " пустые или «ничего»; "
            + "укажите тип переменной, например «пусть с: {стр: [цел]} = ...»")
        если отложить_ и ждущие {
            у = с_пом(у, "ждёт_типа", "True")
            с.отложенные[ключ_отложенной(с, у)] = Сообщение(у.строка, у.столбец, текст)
            для э в узлы {
                если с.отложенные.содержит(ключ_отложенной(с, э)) { с.отложенные.удалить(ключ_отложенной(с, э)) }
            }
        } иначе если не типы_.содержит(НЕИЗВ()) {
            с = ошибка(с, у, текст)
        }
        вернуть ру(с, у, НЕИЗВ())
    }
    пусть т_общ = общий_из(известные, типы_)
    для н в 0..узлы.длина - 1 {
        пусть т = типы_[н]
        если т == ПУСТО() или т == "диапазон" {
            вернуть ру(ошибка(с, узлы[н], "это выражение нельзя поместить в словарь"), с_группой(у, группа, узлы), НЕИЗВ())
        }
        пусть р = согласовать(с, узлы[н], т, т_общ)
        с = р.с
        узлы[н] = р.у
        если не р.да {
            вернуть ру(ошибка(с, р.у, "все " + что + " должны иметь один тип: первый имеет тип " + т_общ + ", а этот " + т),
                       с_группой(у, группа, узлы), НЕИЗВ())
        }
    }
    вернуть ру(с, с_группой(у, группа, узлы), т_общ)
}

функ в_индекс(исходное: Сост, исходный: разбор.Узел) -> Р {
    перем с = исходное
    пусть ро = выражение(с, ч(исходный, "объект"))
    с = ро.с
    перем у = с_частью(исходный, "объект", ро.у)
    пусть т = ро.т
    перем индекс = ч(у, "индекс")
    если индекс.вид == "Диапазон" {
        // срез: с[а..б] - элементы (символы, байты) с номерами от а до б включительно
        для сторона в ["начало", "конец"] {
            пусть р = выражение(с, ч(индекс, сторона))
            с = р.с
            индекс = с_частью(индекс, сторона, р.у)
            если р.т != "цел" и р.т != НЕИЗВ() {
                с = ошибка(с, р.у, "границы среза должны быть целыми числами, а здесь " + р.т)
            }
        }
        у = с_частью(у, "индекс", с_пом(индекс, "тип_выр", "диапазон"))
        если т == НЕИЗВ() { вернуть ру(с, у, НЕИЗВ()) }
        если т == "стр" или т == "байты" или типы.это_список(т) { вернуть ру(с, с_пом(у, "срез", "True"), т) }
        вернуть ру(ошибка(с, ч(у, "объект"), "срез применим к строкам, спискам и байтам, а здесь " + т), у, НЕИЗВ())
    }
    пусть ри = выражение(с, индекс)
    с = ри.с
    у = с_частью(у, "индекс", ри.у)
    пусть т_инд = ри.т
    если т == НЕИЗВ() { вернуть ру(с, у, НЕИЗВ()) }
    если типы.это_особое(т) { вернуть ру(ошибка_необяз(с, у, т, "элемент по номеру нельзя получить"), у, НЕИЗВ()) }
    если т == "стр" или т == "байты" {
        если т_инд != "цел" и т_инд != НЕИЗВ() { с = ошибка(с, ри.у, "индекс должен быть целым числом, а здесь " + т_инд) }
        если т == "стр" { вернуть ру(с, у, "стр") }
        вернуть ру(с, у, "цел")
    }
    если типы.это_словарь(т) {
        пусть т_к = типы.ключ_словаря(т)
        если т_инд != НЕИЗВ() {
            пусть р = согласовать(с, ри.у, т_инд, т_к)
            с = р.с
            у = с_частью(у, "индекс", р.у)
            если не р.да { с = ошибка(с, р.у, "ключи словаря имеют тип " + т_к + ", а здесь " + т_инд) }
        }
        вернуть ру(с, у, типы.значение_словаря(т))
    }
    если не типы.это_список(т) {
        вернуть ру(ошибка(с, ч(у, "объект"), "квадратные скобки применимы к спискам, словарям, строкам и байтам, а здесь " + т),
                   у, НЕИЗВ())
    }
    если т_инд != "цел" и т_инд != НЕИЗВ() { с = ошибка(с, ри.у, "индекс должен быть целым числом, а здесь " + т_инд) }
    вернуть ру(с, у, типы.элемент(т))
}
