/// Обновление Дана: команда «дан обновить» (то же, что obnovlenie.py компилятора на Python).
///
/// Выпуски берутся со страницы выпусков репозитория Дана на GitHub (адрес можно заменить
/// переменной DAN_RELEASES_URL), загружает их программа curl. Скачанный файл сверяется с
/// контрольной суммой из файла SHA256SUMS.txt выпуска; без совпадения ничего не запускается и не
/// распаковывается. Дан, поставленный установщиком, обновляется установщиком новой версии (он
/// запускается сам после выхода из команды); переносной архив распаковывается в новую папку
/// рядом с прежней. Как поставлен Дан, видно по папке его исполняемого файла: в поставке рядом с
/// ним лежит папка «sreda» (переменная DAN_UPDATE_MODE задаёт способ явно).

подключить "среда"
подключить "страницы"
подключить "модели_поставка"
подключить "json"

функ репозиторий() -> стр { вернуть "alexandervdanchenko-ai/dan" }

функ адрес_выпусков() -> стр { вернуть "https://api.github.com/repos/" + репозиторий() + "/releases" }

функ страница_выпусков() -> стр { вернуть "https://github.com/" + репозиторий() + "/releases" }

функ windows(с: модели_поставка.Система) -> лог { вернуть с.р == "\\" }

функ переменная(имя: стр) -> стр { вернуть переменная_среды(имя) иначе "" }

функ склеить(а: стр, б: стр, р: стр) -> стр {
    если а == "" { вернуть б }
    если а.оканчивается("/") или а.оканчивается("\\") { вернуть а + б }
    вернуть а + р + б
}

функ в_кавычках(т: стр, с: модели_поставка.Система) -> стр {
    если windows(с) { вернуть "\"" + т + "\"" }
    вернуть "'" + т.заменить("'", "'\\''") + "'"
}

функ для_оболочки(строка_: стр, с: модели_поставка.Система) -> стр {
    если windows(с) { вернуть "\"" + строка_ + "\"" }
    вернуть строка_
}

/// Номер версии для сравнения: «1.4» -> [1, 4, 0, 1, 0]; «1.4b2» -> [1, 4, 0, 0, 2]: пробный выпуск
/// раньше стабильного того же номера. Пустой список - не номер версии.
общий функ номер(версия: стр) -> [цел] {
    пусть текст = версия.обрезать().строчные()
    пусть шаблон = "v?(\\d+(?:\\.\\d+)*)(?:\\s*-?\\s*([a-zа-яё]+)\\.?(\\d*))?"
    если не совпадает(текст, шаблон) { вернуть [] }
    пусть г = группы(текст, "^" + шаблон + "$")
    если г.длина < 4 { вернуть [] }
    перем числа: [цел] = []
    для ч в г[1].разбить(".") {
        если пусть з = разобрать_цел(ч) { числа.добавить(з) } иначе ошибка о { вернуть [] }
    }
    пока числа.длина < 3 { числа.добавить(0) }
    если г[2] != "" {
        перем н = 0
        если пусть з = разобрать_цел(г[3]) { н = з }
        числа.добавить(0)
        числа.добавить(н)
    } иначе {
        числа.добавить(1)
        числа.добавить(0)
    }
    вернуть числа
}

/// а < б для номеров версий (сравнение по порядку чисел, как у кортежей Python).
общий функ раньше(а: [цел], б: [цел]) -> лог {
    перем н = 0
    пока н < а.длина и н < б.длина {
        если а[н] != б[н] { вернуть а[н] < б[н] }
        н += 1
    }
    вернуть а.длина < б.длина
}

общий функ пробный(версия: стр) -> лог {
    пусть н = номер(версия)
    вернуть н.длина > 0 и н[н.длина - 2] == 0
}

функ папка_настроек(с: модели_поставка.Система) -> стр {
    если переменная("DAN_CONFIG") != "" { вернуть переменная("DAN_CONFIG") }
    если windows(с) {
        перем основа = переменная("APPDATA")
        если основа == "" { основа = переменная("USERPROFILE") }
        вернуть склеить(основа, "Dan", с.р)
    }
    перем основа = переменная("XDG_CONFIG_HOME")
    если основа == "" { основа = склеить(переменная("HOME"), ".config", с.р) }
    вернуть склеить(основа, "dan", с.р)
}

функ канал(с: модели_поставка.Система) -> стр {
    пусть путь = склеить(папка_настроек(с), "канал.txt", с.р)
    если не существует(путь) или это_папка(путь) { вернуть "стабильный" }
    пусть значение = прочитать(путь).обрезать()
    если значение == "стабильный" или значение == "пробный" { вернуть значение }
    вернуть "стабильный"
}

функ запомнить_канал(с: модели_поставка.Система, значение: стр) {
    создать_папку(папка_настроек(с))
    записать(склеить(папка_настроек(с), "канал.txt", с.р), значение + "\n")
}

/// Сервер в адресе (для сообщений): «https://api.github.com/...» -> «api.github.com».
функ сервер_адреса(адрес: стр) -> стр {
    пусть части = адрес.разбить("/")
    если части.длина > 2 и части[2] != "" { вернуть части[2] }
    вернуть адрес
}

/// Скачивает адрес в файл программой curl.
функ получить(с: модели_поставка.Система, адрес: стр, куда: стр) -> ! {
    пусть ошибки = куда + ".ошибки"
    пусть строка_ = ("curl -fsSL --retry 3 --connect-timeout 60 -A " + в_кавычках("dan/" + среда.версия(), с)
        + " -H " + в_кавычках("Accept: application/vnd.github+json", с) + " -o " + в_кавычках(куда, с) + " "
        + в_кавычках(адрес, с) + " 2>" + в_кавычках(ошибки, с))
    пусть код = выполнить_команду(для_оболочки(строка_, с))
    перем текст = ""
    если существует(ошибки) {
        текст = прочитать(ошибки).обрезать()
        удалить_файл(ошибки)
    }
    если код != 0 {
        если текст.начинается("curl: ") { текст = текст[6..текст.длина - 1] }
        если текст == "" { текст = "curl завершился с кодом " + стр(код) }
        вернуть ошибка("не удалось связаться с " + сервер_адреса(адрес) + ": " + текст
            + ". Проверьте подключение к интернету")
    }
}

/// Выпуск: метка, версия и файлы для скачивания.
тип Файл {
    имя: стр
    размер: цел
    адрес: стр
}

тип Выпуск {
    версия: стр
    метка: стр
    страница: стр
    файлы: [Файл]
}

функ выпуски(с: модели_поставка.Система, временная: стр) -> [json.Значение]! {
    перем адрес = переменная("DAN_RELEASES_URL")
    если адрес == "" { адрес = адрес_выпусков() }
    пусть путь = склеить(временная, "releases.json", с.р)
    если ошибка о = получить(с, адрес, путь) { вернуть ошибка(о) }
    пусть текст = прочитать(путь)
    если пусть данные = json.разобрать(текст) {
        пусть запись = json.записать(данные)
        если запись.начинается("[") { вернуть данные.элементы() }
        вернуть ошибка("сервер выпусков отказал: " + (данные.поле("message").как_стр() иначе запись))
    } иначе ошибка о {
        вернуть ошибка("сервер выпусков вернул непонятный ответ")
    }
}

/// Самый новый выпуск канала или ничего.
общий функ выбрать(список: [json.Значение], канал_выпусков: стр) -> Выпуск? {
    перем лучший: Выпуск? = ничего
    перем лучший_номер: [цел] = []
    для вып в список {
        если вып.поле("draft").как_лог() иначе ложь { продолжить }
        перем версия = вып.поле("tag_name").как_стр() иначе ""
        пока версия.начинается("v") { версия = версия[1..версия.длина - 1] }
        пусть н = номер(версия)
        если н.длина == 0 { продолжить }
        если канал_выпусков == "стабильный" и ((вып.поле("prerelease").как_лог() иначе ложь) или пробный(версия)) {
            продолжить
        }
        если лучший_номер.длина == 0 или раньше(лучший_номер, н) {
            перем файлы: [Файл] = []
            для ф в вып.поле("assets").элементы() {
                файлы.добавить(Файл(ф.поле("name").как_стр() иначе "", ф.поле("size").как_цел() иначе 0,
                    ф.поле("browser_download_url").как_стр() иначе ""))
            }
            лучший = Выпуск(версия, вып.поле("tag_name").как_стр() иначе "", вып.поле("html_url").как_стр() иначе "", файлы)
            лучший_номер = н
        }
    }
    вернуть лучший
}

функ файл_выпуска(выпуск: Выпуск, образец: стр) -> Файл? {
    для ф в выпуск.файлы {
        если совпадает(ф.имя, образец) { вернуть ф }
    }
    вернуть ничего
}

/// Скачивает файл выпуска и сверяет его с SHA256SUMS.txt; результат - путь к нему.
функ скачать_проверенный(с: модели_поставка.Система, выпуск: Выпуск, образец: стр, папка: стр) -> стр! {
    перем файл = Файл("", 0, "")
    если пусть ф = файл_выпуска(выпуск, образец) {
        файл = ф
    } иначе {
        вернуть ошибка("в выпуске " + выпуск.метка + " нет нужного файла; скачайте его вручную: " + страница_выпусков())
    }
    перем суммы = Файл("", 0, "")
    если пусть ф = файл_выпуска(выпуск, "SHA256SUMS\\.txt") {
        суммы = ф
    } иначе {
        вернуть ошибка("в выпуске нет файла контрольных сумм SHA256SUMS.txt; обновление остановлено")
    }
    пусть путь_сумм = склеить(папка, "SHA256SUMS.txt", с.р)
    если ошибка о = получить(с, суммы.адрес, путь_сумм) { вернуть ошибка(о) }
    перем ожидается = ""
    для строка в прочитать(путь_сумм).разбить("\n") {
        пусть части = строка.разбить()
        если части.длина == 2 {
            перем имя = части[1]
            пока имя.начинается("*") { имя = имя[1..имя.длина - 1] }
            если имя == файл.имя { ожидается = части[0].строчные() }
        }
    }
    если ожидается == "" {
        вернуть ошибка("для файла " + файл.имя + " нет контрольной суммы; обновление остановлено")
    }
    перем мегабайт = частное(частное(файл.размер, 1024), 1024)
    если мегабайт == 0 { мегабайт = 1 }
    вывод("Скачивание " + файл.имя + " (" + стр(мегабайт) + " МБ)...")
    пусть путь = склеить(папка, файл.имя, с.р)
    если ошибка о = получить(с, файл.адрес, путь) { вернуть ошибка(о) }
    если хеш(прочитать_байты(путь)).строчные() != ожидается {
        удалить_файл(путь)
        вернуть ошибка("файл " + файл.имя + " не совпадает с контрольной суммой выпуска: он повреждён "
            + "или подменён. Ничего не изменено")
    }
    вернуть путь
}

/// Папка, в которой лежит исполняемый файл Дана.
функ папка_установки(с: модели_поставка.Система) -> стр {
    пусть путь = путь_программы()
    перем конец = -1
    перем н = 0
    для з в путь.символы() {
        если з == "/" или з == "\\" { конец = н }
        н += 1
    }
    если конец <= 0 { вернуть "." }
    вернуть путь[0..конец - 1]
}

функ родитель(путь: стр) -> стр {
    перем конец = -1
    перем н = 0
    для з в путь.символы() {
        если з == "/" или з == "\\" { конец = н }
        н += 1
    }
    если конец <= 0 { вернуть "." }
    вернуть путь[0..конец - 1]
}

/// «установщик», «архив» или «исходники».
функ способ_установки(с: модели_поставка.Система) -> стр {
    если переменная("DAN_UPDATE_MODE") != "" { вернуть переменная("DAN_UPDATE_MODE") }
    пусть папка = папка_установки(с)
    если не это_папка(склеить(папка, "sreda", с.р)) { вернуть "исходники" }
    если windows(с) {
        для имя в список_файлов(папка) {
            если совпадает(имя.строчные(), "unins\\d+\\.exe") { вернуть "установщик" }
        }
    }
    вернуть "архив"
}

/// Переносной архив -> новая папка рядом с нынешней установкой.
функ распаковать_рядом(с: модели_поставка.Система, архив: стр, версия: стр) -> стр! {
    пусть основа = родитель(папка_установки(с))
    перем цель = склеить(основа, "dan-" + версия, с.р)
    перем н = 2
    пока существует(цель) {
        цель = склеить(основа, "dan-" + версия + "-" + стр(н), с.р)
        н += 1
    }
    для имя в содержимое_архива(архив) {
        перем плохое = имя.начинается("/") или имя.начинается("\\") или имя.содержит(":")
        для часть в имя.заменить("\\", "/").разбить("/") {
            если часть == ".." { плохое = истина }
        }
        если плохое { вернуть ошибка("в архиве недопустимое имя файла: " + имя) }
    }
    создать_папку(цель)
    извлечь_архив(архив, цель)
    // архив содержит одну папку верхнего уровня: она и есть Дан
    пусть внутри = список_файлов(цель)
    если внутри.длина == 1 и внутри[0].оканчивается("/") {
        вернуть склеить(цель, внутри[0][0..внутри[0].длина - 2], с.р)
    }
    вернуть цель
}

функ обновить(с: модели_поставка.Система, только_проверить: лог, выбранный: стр, временная: стр) -> цел! {
    если выбранный != "" { запомнить_канал(с, выбранный) }
    перем к = выбранный
    если к == "" { к = канал(с) }
    пусть текущая = среда.версия()
    перем список: [json.Значение] = []
    если пусть вв = выпуски(с, временная) { список = вв } иначе ошибка о { вернуть ошибка(о) }
    перем выпуск = Выпуск("", "", "", [])
    если пусть вв = выбрать(список, к) {
        выпуск = вв
    } иначе {
        вывод("В канале «" + к + "» выпусков нет")
        вернуть 0
    }
    если не раньше(номер(текущая), номер(выпуск.версия)) {
        вывод("Установлена последняя версия Дана (" + текущая + ", канал «" + к + "»)")
        вернуть 0
    }
    вывод("Есть новая версия Дана: " + выпуск.версия + " (установлена " + текущая + ", канал «" + к + "»)")
    если выпуск.страница != "" { вывод("Что нового: " + выпуск.страница) }
    если только_проверить { вернуть 0 }
    пусть способ = способ_установки(с)
    если способ == "исходники" {
        вывод("Дан запущен из исходных текстов: обновите их (git pull) или поставьте выпуск со страницы "
            + страница_выпусков())
        вернуть 0
    }
    // файлы выпуска остаются во временной папке: установщик запускается после выхода из команды
    пусть папка = создать_временную_папку()
    если способ == "установщик" {
        перем установщик = ""
        если пусть п = скачать_проверенный(с, выпуск, "dan-.*-setup\\.exe", папка) {
            установщик = п
        } иначе ошибка о {
            вернуть ошибка(о)
        }
        если переменная("DAN_UPDATE_DRY_RUN") != "" {
            вывод("Установщик готов: " + установщик)
            вернуть 0
        }
        // установщик заменит файлы, когда эта команда завершится
        пусть параметры = " /SILENT /SUPPRESSMSGBOXES /NORESTART /CLOSEAPPLICATIONS"
        если windows(с) {
            выполнить_команду(для_оболочки("start \"\" " + в_кавычках(установщик, с) + параметры, с))
        } иначе {
            выполнить_команду(в_кавычках(установщик, с) + параметры + " >/dev/null 2>&1 &")
        }
        вывод("Запущен установщик Дана " + выпуск.версия + ". Когда он закончит, откройте новое окно командной строки")
        вернуть 0
    }
    перем архив = ""
    если пусть п = скачать_проверенный(с, выпуск, "dan-.*-windows\\.zip", папка) {
        архив = п
    } иначе ошибка о {
        удалить_папку(папка)
        вернуть ошибка(о)
    }
    перем новая = ""
    если пусть п = распаковать_рядом(с, архив, выпуск.версия) { новая = п } иначе ошибка о {
        удалить_папку(папка)
        вернуть ошибка(о)
    }
    удалить_папку(папка)
    вывод("Дан " + выпуск.версия + " распакован в папку " + новая + ". Прежняя версия осталась в "
        + папка_установки(с) + "; чтобы команда dan запускала новую, укажите новую папку в переменной PATH вместо прежней")
    вернуть 0
}

/// «дан обновить [--проверить] [--канал=пробный|стабильный]».
общий функ команда(аргументы: [стр], с: модели_поставка.Система) -> цел {
    перем только_проверить = ложь
    перем выбранный = ""
    для а в аргументы {
        если а == "--проверить" {
            только_проверить = истина
        } иначе если а.начинается("--канал=") {
            выбранный = а[8..а.длина - 1]
            если выбранный != "стабильный" и выбранный != "пробный" {
                вывод("Канал может быть: стабильный, пробный")
                вернуть 2
            }
        } иначе {
            вывод(страницы.обновление_справка())
            вернуть 2
        }
    }
    перем временная = с.сборка
    если временная == "" { временная = создать_временную_папку() }
    перем код = 0
    если пусть к = обновить(с, только_проверить, выбранный, временная) {
        код = к
    } иначе ошибка о {
        вывод("Ошибка: " + о)
        код = 1
    }
    удалить_папку(временная)
    вернуть код
}
