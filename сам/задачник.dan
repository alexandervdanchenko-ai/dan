/// Задачник для компилятора на Дане: список задач, условия и наборы проверок.
///
/// Делает то же, что zadachnik.py: задача - файл «NN_имя.dan» с условием в первой строке
/// и файл «NN_имя.проверки» с наборами входных данных и ожидаемого вывода:
///
///     === ввод
///     Анна
///     === вывод
///     Привет, Анна!
///
/// Сборку и запуск решения выполняет дан.dan; здесь - разбор файлов и текст сообщений.

/// Задача из папки: номер (первые две цифры имени) и имя файла без «.dan».
общий тип Задача {
    номер: цел
    имя: стр
}

функ цифра(з: стр) -> лог {
    вернуть з >= "0" и з <= "9"
}

/// Задачи папки по порядку имён; нет папки - нет задач.
общий функ задачи(папка: стр) -> [Задача] {
    перем итог: [Задача] = []
    если не существует(папка) { вернуть итог }
    для имя_ в список_файлов(папка) {
        если не имя_.оканчивается(".dan") или имя_.начинается(".") { продолжить }
        пусть имя = имя_[0..имя_.длина - 5]
        если имя.длина >= 2 и цифра(имя[0]) и цифра(имя[1]) {
            итог.добавить(Задача(цел(имя[0..1]), имя))
        }
    }
    вернуть итог
}

/// Строка без пробелов, табуляции и переводов строк справа.
общий функ без_пробелов_справа(с: стр) -> стр {
    перем конец = с.длина
    пока конец > 0 и [" ", "\t", "\r", "\n", символ_по_коду(11), символ_по_коду(12)].содержит(с[конец - 1]) { конец -= 1 }
    если конец == 0 { вернуть "" }
    вернуть с[0..конец - 1]
}

/// Условие задачи: первая строка файла без «//» и без «Задача N.».
общий функ условие(текст: стр) -> стр {
    перем первая = текст.разбить("\n")[0].обрезать()
    перем н = 0
    пока н < первая.длина и (первая[н] == "/" или первая[н] == " ") { н += 1 }
    если н >= первая.длина { первая = "" } иначе { первая = первая[н..первая.длина - 1] }
    пусть точка = первая.найти(". ")
    если точка >= 0 { вернуть первая[точка + 2..первая.длина - 1] }
    вернуть первая
}

/// Наборы проверок: пары [ввод, вывод] из текста файла «.проверки».
общий функ проверки(текст: стр) -> [[стр]] {
    перем итог: [[стр]] = []
    пусть части = текст.разбить("=== ввод\n")
    для н в 1..части.длина - 1 {
        пусть часть = части[н]
        пусть место = часть.найти("=== вывод\n")
        если место < 0 {
            итог.добавить([часть, ""])
        } иначе {
            перем ввод_ = ""
            если место > 0 { ввод_ = часть[0..место - 1] }
            итог.добавить([ввод_, часть[место + 10..часть.длина - 1]])
        }
    }
    вернуть итог
}

/// Строки вывода для сравнения: без пустых строк в конце и без пробелов в конце строк.
общий функ строки(текст_: стр) -> [стр] {
    перем текст = текст_.заменить("\r\n", "\n")
    пока текст.оканчивается("\n") { текст = текст[0..текст.длина - 2] }
    перем итог: [стр] = []
    для с в текст.разбить("\n") { итог.добавить(без_пробелов_справа(с)) }
    вернуть итог
}

/// Описание первого расхождения: программа остановилась с ошибкой (код не 0) или напечатала не то.
общий функ расхождение(номер: цел, ввод_: стр, ожидается: стр, вывод_: стр, ошибки: стр, код: цел) -> стр {
    перем показ = ввод_
    пока показ.оканчивается("\n") { показ = показ[0..показ.длина - 2] }
    показ = показ.заменить("\n", " | ")
    если показ == "" { показ = "(без ввода)" }
    пусть начало = "проверка " + стр(номер) + ", ввод: " + показ + "\n"
    если код != 0 {
        вернуть начало + "  программа остановилась с ошибкой:\n  " + ошибки.обрезать()
    }
    перем получено = "(ничего не напечатано)"
    если вывод_.обрезать() != "" { получено = строки(вывод_).соединить("\n    ") }
    вернуть (начало + "  ожидалось:\n    " + строки(ожидается).соединить("\n    ") + "\n  получено:\n    "
        + получено)
}

тест "условие и проверки" {
    утвердить_равно(условие("// Задача 1. Программа здоровается.\n// ещё\n"), "Программа здоровается.")
    утвердить(проверки("=== ввод\nАнна\n=== вывод\nПривет!\n=== ввод\n=== вывод\n1\n")
        == [["Анна\n", "Привет!\n"], ["", "1\n"]])
    утвердить(строки("а  \nб\r\n\n\n") == ["а", "б"])
    утвердить_равно(расхождение(2, "", "1\n", "", "", 0),
        "проверка 2, ввод: (без ввода)\n  ожидалось:\n    1\n  получено:\n    (ничего не напечатано)")
}
