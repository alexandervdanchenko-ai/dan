/// Сервер языка Дан для редакторов (протокол Language Server Protocol): команда «дан сервер».
///
/// Редактор (Visual Studio Code и любой другой, понимающий LSP) запускает сервер и обменивается
/// с ним сообщениями JSON-RPC через стандартный ввод и вывод. Ошибки находит сам компилятор на
/// Дане - тот же разбор и та же проверка, что у «дан проверить», поэтому редактор знает все
/// возможности языка (плотные массивы, «параллельно для», модуль «модели»). Сервер:
/// - показывает ошибки и предупреждения прямо в тексте при каждом изменении;
/// - подсказывает ключевые слова, функции, имена программы и общие имена подключённых модулей;
/// - показывает описание при наведении указателя (и объяснение строки у ключевого слова в её начале);
/// - переходит к объявлению функции или типа, в том числе в другом файле;
/// - предлагает быстрые исправления (опечатки, привычки Python) - те же, что применяет «дан исправить»;
/// - показывает список функций и типов файла и приводит текст к единому виду.
/// Поведение то же, что у сервера на Python (server.py).

подключить "среда"
подключить "лексер"
подключить "разбор"
подключить "модули"
подключить "машинный"
подключить "формат"
подключить "документация"
подключить "объяснение"
подключить "подсказки"
подключить "json"

/// Что серверу нужно от компилятора (это знает дан.dan).
общий тип Компилятор {
    настройки: модули.Настройки
    /// ошибки (или, если их нет, предупреждения) программы: текст и путь -> замечания
    замечания: функ(стр, стр) -> [машинный.Замечание]
    /// разделитель папок
    р: стр
}

// ---------- чтение и запись сообщений ----------

тип Поток {
    данные: байты = байты("")
    поз: цел = 0
    конец: лог = ложь
}

функ дочитать(п: Поток) -> Поток {
    перем н = п
    пусть часть = ввод_байтов(65536)
    если часть.длина == 0 {
        н.конец = истина
        вернуть н
    }
    если н.поз >= н.данные.длина {
        н.данные = часть
    } иначе {
        н.данные = н.данные[н.поз..н.данные.длина - 1] + часть
    }
    н.поз = 0
    вернуть н
}

тип Сообщение {
    поток: Поток
    /// "" - ввод кончился
    тело: стр
}

/// Следующее сообщение: заголовки «Content-Length: N», пустая строка и N байтов JSON.
функ прочитать_сообщение(п_: Поток) -> Сообщение {
    перем п = п_
    перем длина = -1
    пока истина {
        // строка заголовка до «\n»
        перем конец_строки = -1
        перем к = п.поз
        пока конец_строки < 0 {
            пока к < п.данные.длина {
                если п.данные[к] == 10 {
                    конец_строки = к
                    прервать
                }
                к += 1
            }
            если конец_строки < 0 {
                п = дочитать(п)
                если п.конец { вернуть Сообщение(п, "") }
                к = п.поз
            }
        }
        перем строка = ""
        если конец_строки > п.поз { строка = стр(п.данные[п.поз..конец_строки - 1]) }
        п.поз = конец_строки + 1
        строка = строка.обрезать()
        если строка == "" {
            если длина >= 0 { прервать }
            продолжить
        }
        пусть н = строка.найти(":")
        если н > 0 и строка[0..н - 1].обрезать().строчные() == "content-length" {
            длина = разобрать_цел(строка[н + 1..строка.длина - 1].обрезать()) иначе 0
        }
    }
    пока п.данные.длина - п.поз < длина {
        п = дочитать(п)
        если п.конец { вернуть Сообщение(п, "") }
    }
    перем тело = ""
    если длина > 0 { тело = стр(п.данные[п.поз..п.поз + длина - 1]) }
    п.поз += длина
    вернуть Сообщение(п, тело)
}

функ отправить(текст: стр) {
    пусть данные = байты(текст)
    вывести_байты(байты("Content-Length: " + стр(данные.длина) + "\r\n\r\n") + данные)
}

функ ответить(номер: стр, результат: стр) {
    отправить("{\"jsonrpc\":\"2.0\",\"id\":" + номер + ",\"result\":" + результат + "}")
}

функ уведомить(метод: стр, параметры: стр) {
    отправить("{\"jsonrpc\":\"2.0\",\"method\":" + строка_json(метод) + ",\"params\":" + параметры + "}")
}

// ---------- места в тексте ----------

функ знак_имени(з: стр) -> лог { вернуть лексер.буква(з) или лексер.цифра(з) или з == "_" }

функ начало_имени(з: стр) -> лог { вернуть лексер.буква(з) или з == "_" }

/// Позиция LSP (единицы UTF-16) для номера символа строки.
функ в_utf16(знаки: [стр], до: цел) -> цел {
    перем единиц = 0
    для н в 0..до - 1 {
        если н >= знаки.длина { прервать }
        если код_символа(знаки[н]) > 65535 { единиц += 2 } иначе { единиц += 1 }
    }
    вернуть единиц
}

/// Номер символа строки для позиции LSP (единицы UTF-16).
функ из_utf16(знаки: [стр], символ: цел) -> цел {
    перем единиц = 0
    для н в 0..знаки.длина - 1 {
        если единиц >= символ { вернуть н }
        если код_символа(знаки[н]) > 65535 { единиц += 2 } иначе { единиц += 1 }
    }
    вернуть знаки.длина
}

функ строки_текста(текст: стр) -> [стр] { вернуть текст.разбить("\n") }

функ позиция(строка: цел, символ: цел) -> стр {
    вернуть "{\"line\":" + стр(строка) + ",\"character\":" + стр(символ) + "}"
}

/// Диапазон LSP для места (строка и столбец Дана с 1): до конца слова.
функ диапазон(текст: стр, строка: цел, столбец: цел) -> стр {
    пусть строки = строки_текста(текст)
    перем н = строка - 1
    если н < 0 { н = 0 }
    перем с = столбец - 1
    если с < 0 { с = 0 }
    если н >= строки.длина {
        н = строки.длина - 1
        если н < 0 { н = 0 }
        с = 0
    }
    перем линия = ""
    если н < строки.длина { линия = строки[н] }
    пусть знаки = линия.символы()
    перем конец = с
    если с < знаки.длина {
        если начало_имени(знаки[с]) {
            пока конец < знаки.длина и знак_имени(знаки[конец]) { конец += 1 }
        } иначе если знаки[с] != " " и знаки[с] != "\t" {
            пока конец < знаки.длина и знаки[конец] != " " и знаки[конец] != "\t" { конец += 1 }
        }
    }
    если конец == с {
        конец = с + 1
        если конец > знаки.длина { конец = знаки.длина }
    }
    вернуть "{\"start\":" + позиция(н, в_utf16(знаки, с)) + ",\"end\":" + позиция(н, в_utf16(знаки, конец)) + "}"
}

// ---------- объявления ----------

тип Объявление {
    вид: стр
    строка: цел
    столбец: цел
    описание: стр
    общий_: лог
}

/// Функции, типы, варианты и переменные верхнего уровня файла по именам (порядок - как в файле).
функ объявления(текст: стр, к: Компилятор) -> {стр: Объявление} {
    перем итог: {стр: Объявление} = {}
    перем токены: [лексер.Токен] = []
    если пусть т = лексер.разобрать(текст) { токены = т } иначе ошибка о { вернуть итог }
    перем дерево = разбор.Узел("?")
    если пусть д = разбор.разобрать(токены, к.настройки.редакции, к.настройки.версия) { дерево = д } иначе ошибка о {
        вернуть итог
    }
    для инстр в разбор.часть_группы(дерево, "инструкции") {
        пусть имя = разбор.свойство(инстр, "имя")
        если инстр.вид == "Функция" {
            // тест инстр замер не вызывают по имени: в подсказках их нет
            если имя.начинается("тест__") или имя.начинается("замер__") { продолжить }
            перем параметры: [стр] = []
            для п в разбор.часть_группы(инстр, "параметры") {
                параметры.добавить(разбор.свойство(п, "имя") + ": " + разбор.свойство(п, "тип"))
            }
            перем результат = ""
            если разбор.свойство(инстр, "тип_результата") != "" { результат = " -> " + разбор.свойство(инстр, "тип_результата") }
            перем полное = имя
            если разбор.свойство(инстр, "метод_типа") != "" { полное = разбор.свойство(инстр, "метод_типа") + "." + имя }
            итог[полное] = Объявление("функция", инстр.строка, инстр.столбец,
                "функ " + полное + "(" + параметры.соединить(", ") + ")" + результат, инстр.открытый)
        } иначе если инстр.вид == "ОбъявлениеТипа" или инстр.вид == "ОбъявлениеВариантов" или инстр.вид == "ОбъявлениеИнтерфейса" {
            перем вид = "тип"
            если инстр.вид == "ОбъявлениеИнтерфейса" { вид = "интерфейс" }
            перем написание = разбор.свойство(инстр, "написание")
            если написание == "" { написание = имя }
            итог[имя] = Объявление(вид, инстр.строка, инстр.столбец, вид + " " + написание, инстр.открытый)
            если инстр.вид == "ОбъявлениеВариантов" {
                для в_ в разбор.часть_группы(инстр, "варианты") {
                    перем поля: [стр] = []
                    для п в разбор.часть_группы(в_, "поля") {
                        поля.добавить(разбор.свойство(п, "имя") + ": " + разбор.свойство(п, "тип"))
                    }
                    перем имя_в = разбор.свойство(в_, "написание")
                    если имя_в == "" { имя_в = разбор.свойство(в_, "имя") }
                    перем описание = имя_в + " - вариант типа " + имя
                    если поля.длина > 0 { описание = имя_в + "(" + поля.соединить(", ") + ") - вариант типа " + имя }
                    итог[разбор.свойство(в_, "имя")] = Объявление("вариант", в_.строка, в_.столбец, описание, инстр.открытый)
                }
            }
        } иначе если инстр.вид == "ОбъявлениеПеременной" {
            перем слово = "пусть"
            если разбор.свойство(инстр, "изменяемая") == "True" { слово = "перем" }
            итог[имя] = Объявление("переменная", инстр.строка, инстр.столбец, слово + " " + имя, ложь)
        }
    }
    вернуть итог
}

функ папка_пути(путь: стр) -> стр {
    перем конец = -1
    перем н = 0
    для з в путь.символы() {
        если з == "/" или з == "\\" { конец = н }
        н += 1
    }
    если конец < 0 { вернуть "." }
    если конец == 0 { вернуть путь[0..0] }
    вернуть путь[0..конец - 1]
}

функ имя_без_окончания(путь: стр) -> стр {
    перем имя = путь
    для з в ["/", "\\"] {
        пусть части = имя.разбить(з)
        имя = части[части.длина - 1]
    }
    пусть точка = имя.найти(".")
    если точка > 0 {
        перем последняя = точка
        перем н = 0
        для з в имя.символы() {
            если з == "." { последняя = н }
            н += 1
        }
        вернуть имя[0..последняя - 1]
    }
    вернуть имя
}

/// Подключённые модули файла: псевдоним -> путь к файлу.
функ подключения(текст: стр, путь: стр, к: Компилятор) -> {стр: стр} {
    перем итог: {стр: стр} = {}
    пусть папка = папка_пути(путь)
    для линия_ в строки_текста(текст) {
        пусть линия = линия_.обрезать()
        если не линия.начинается("подключить") { продолжить }
        пусть знаки = линия.символы()
        перем н = 10
        если н >= знаки.длина или (знаки[н] != " " и знаки[н] != "\t") { продолжить }
        пока н < знаки.длина и (знаки[н] == " " или знаки[н] == "\t") { н += 1 }
        если н >= знаки.длина или знаки[н] != "\"" { продолжить }
        перем файл = ""
        н += 1
        пока н < знаки.длина и знаки[н] != "\"" {
            файл += знаки[н]
            н += 1
        }
        если н >= знаки.длина или файл == "" { продолжить }
        н += 1
        перем псевдоним = ""
        пусть хвост = знаки[н..знаки.длина - 1].соединить("").обрезать()
        если хвост.начинается("как ") или хвост.начинается("как\t") {
            пусть имя = хвост[3..хвост.длина - 1].обрезать()
            если имя != "" и начало_имени(имя.символы()[0]) {
                для з в имя.символы() {
                    если не знак_имени(з) { прервать }
                    псевдоним += з
                }
            }
        }
        для кандидат в [папка + к.р + файл, папка + к.р + файл + ".dan", к.настройки.библиотека + к.р + файл,
            к.настройки.библиотека + к.р + файл + ".dan"] {
            если существует(кандидат) и не это_папка(кандидат) {
                перем имя = псевдоним
                если имя == "" { имя = имя_без_окончания(кандидат) }
                итог[лексер.без_ё(имя)] = кандидат
                прервать
            }
        }
    }
    вернуть итог
}

/// Слово под позицией символа и «модуль» перед ним (через точку): [модуль, слово]; слово "" - нет слова.
функ слово_в_позиции(линия: стр, символ: цел) -> [стр] {
    пусть знаки = линия.символы()
    перем н = 0
    пока н < знаки.длина {
        если не начало_имени(знаки[н]) {
            н += 1
            продолжить
        }
        пусть начало = н
        пока н < знаки.длина и знак_имени(знаки[н]) { н += 1 }
        перем модуль = ""
        перем слово = знаки[начало..н - 1].соединить("")
        если н + 1 < знаки.длина и знаки[н] == "." и начало_имени(знаки[н + 1]) {
            модуль = слово
            пусть второе = н + 1
            н = второе
            пока н < знаки.длина и знак_имени(знаки[н]) { н += 1 }
            слово = знаки[второе..н - 1].соединить("")
        }
        если начало <= символ и символ <= н { вернуть [модуль, слово] }
    }
    вернуть ["", ""]
}

// ---------- подсказки ----------

функ вариант(имя: стр, вид: стр, описание: стр) -> стр {
    перем код = 1
    выбор вид {
        "функция" { код = 3 }
        "метод" { код = 2 }
        "свойство" { код = 10 }
        "переменная" { код = 6 }
        "тип" { код = 7 }
        "интерфейс" { код = 8 }
        "вариант" { код = 20 }
        "ключевое" { код = 14 }
        "модуль" { код = 9 }
        иначе { код = 1 }
    }
    перем запись = "{\"label\":" + строка_json(имя) + ",\"kind\":" + стр(код)
    если описание != "" {
        запись += ",\"detail\":" + строка_json(описание.разбить("\n")[0]) + ",\"documentation\":" + строка_json(описание)
    }
    вернуть запись + "}"
}

функ список_подсказок(варианты: [стр]) -> стр {
    вернуть "{\"isIncomplete\":false,\"items\":[" + варианты.соединить(",") + "]}"
}

функ имена_текста(текст: стр) -> [стр] {
    перем итог: [стр] = []
    перем было: {стр: лог} = {}
    пусть знаки = текст.символы()
    перем н = 0
    пока н < знаки.длина {
        если не начало_имени(знаки[н]) {
            н += 1
            продолжить
        }
        пусть начало = н
        пока н < знаки.длина и знак_имени(знаки[н]) { н += 1 }
        пусть имя = знаки[начало..н - 1].соединить("")
        если не было.содержит(имя) {
            было[имя] = истина
            итог.добавить(имя)
        }
    }
    вернуть итог
}

функ подсказать(текст: стр, путь: стр, номер_строки: цел, символ: цел, к: Компилятор) -> стр {
    пусть строки = строки_текста(текст)
    перем линия = ""
    если номер_строки >= 0 и номер_строки < строки.длина { линия = строки[номер_строки] }
    пусть знаки = линия.символы()
    пусть до = из_utf16(знаки, символ)
    // «имя.начало» перед курсором
    перем н = до
    пока н > 0 и знак_имени(знаки[н - 1]) { н -= 1 }
    перем после_точки = ложь
    перем псевдоним = ""
    если н > 0 и знаки[н - 1] == "." {
        перем к_ = н - 1
        пока к_ > 0 и знак_имени(знаки[к_ - 1]) { к_ -= 1 }
        // имя не начинается с цифры: начало сдвигается к первой букве
        пока к_ < н - 1 и не начало_имени(знаки[к_]) { к_ += 1 }
        если к_ < н - 1 {
            после_точки = истина
            псевдоним = лексер.без_ё(знаки[к_..н - 2].соединить(""))
        }
    }
    перем варианты: [стр] = []
    если после_точки {
        пусть модули_ = подключения(текст, путь, к)
        если пусть файл = модули_.найти(псевдоним) {
            пусть чужие = объявления(прочитать(файл), к)
            для имя в чужие.ключи() {
                пусть о = чужие[имя]
                если о.общий_ и не имя.содержит(".") { варианты.добавить(вариант(имя, о.вид, о.описание)) }
            }
            вернуть список_подсказок(варианты)
        }
        перем были: {стр: лог} = {}
        пусть таблица = подсказки.после_точки()
        перем н_ = 0
        пока н_ + 2 < таблица.длина {
            если не были.содержит(таблица[н_]) {
                были[таблица[н_]] = истина
                варианты.добавить(вариант(таблица[н_], таблица[н_ + 1], таблица[н_ + 2]))
            }
            н_ += 3
        }
        пусть свои = объявления(текст, к)
        для имя в свои.ключи() {
            если имя.содержит(".") {
                пусть короткое = имя[имя.найти(".") + 1..имя.длина - 1]
                если не были.содержит(короткое) {
                    были[короткое] = истина
                    варианты.добавить(вариант(короткое, "метод", свои[имя].описание))
                }
            }
        }
        вернуть список_подсказок(варианты)
    }
    перем известные: {стр: лог} = {}
    пусть ключевые = подсказки.описания_ключевых()
    для слово в подсказки.ключевые_слова() {
        варианты.добавить(вариант(слово, "ключевое", ключевые.получить(слово, "ключевое слово")))
        известные[слово] = истина
    }
    пусть встроенные = подсказки.описания_встроенных()
    для имя в подсказки.встроенные() {
        варианты.добавить(вариант(имя, "функция", встроенные.получить(имя, "")))
        известные[имя] = истина
    }
    пусть библиотека = подсказки.описания_библиотеки()
    для имя в подсказки.библиотечные() {
        варианты.добавить(вариант(имя, "функция", библиотека.получить(имя, "")))
        известные[имя] = истина
    }
    пусть свои = объявления(текст, к)
    для имя в свои.ключи() {
        если не имя.содержит(".") {
            варианты.добавить(вариант(имя, свои[имя].вид, свои[имя].описание))
            известные[имя] = истина
        }
    }
    для псевдоним_ в подключения(текст, путь, к).ключи() {
        варианты.добавить(вариант(псевдоним_, "модуль", "подключённый модуль " + псевдоним_))
        известные[псевдоним_] = истина
    }
    // имена, уже встречавшиеся в тексте (переменные функций, параметры)
    для имя в имена_текста(текст) {
        если не известные.содержит(имя) и имя.длина > 1 { варианты.добавить(вариант(имя, "имя", "")) }
    }
    вернуть список_подсказок(варианты)
}

/// Объяснение строки («дан объяснить») без первого абзаца с самой строкой или "".
функ объяснение_строки(текст: стр, путь: стр, номер: цел, к: Компилятор) -> стр {
    если пусть о = объяснение.объяснить(текст, путь, номер, к.настройки) {
        пусть абзацы = о.разбить("\n\n")
        если абзацы.длина > 1 { вернуть абзацы[1..абзацы.длина - 1].соединить("\n\n") }
    } иначе ошибка о {
        // программа не разбирается: объяснения нет, подсказка показывает только описание
    }
    вернуть ""
}

функ навести(текст: стр, путь: стр, номер_строки: цел, символ: цел, к: Компилятор) -> стр {
    пусть строки = строки_текста(текст)
    перем линия = ""
    если номер_строки >= 0 и номер_строки < строки.длина { линия = строки[номер_строки] }
    пусть найдено_слово = слово_в_позиции(линия, из_utf16(линия.символы(), символ))
    пусть модуль = найдено_слово[0]
    пусть слово = найдено_слово[1]
    если слово == "" { вернуть "null" }
    пусть имя = лексер.без_ё(слово)
    перем описание = ""
    перем пояснение = ""
    если модуль != "" {
        если пусть файл = подключения(текст, путь, к).найти(лексер.без_ё(модуль)) {
            пусть чужой = прочитать(файл)
            если пусть о = объявления(чужой, к).найти(имя) {
                описание = о.описание
                пояснение = документация.комментарий_над(строки_текста(чужой), о.строка)
            }
        }
    }
    если описание == "" {
        если пусть о = объявления(текст, к).найти(имя) {
            описание = о.описание
            пояснение = документация.комментарий_над(строки, о.строка)
        }
    }
    если описание == "" {
        описание = подсказки.описания_библиотеки().получить(имя, "")
        если описание == "" { описание = подсказки.описания_встроенных().получить(имя, "") }
        если описание == "" { описание = подсказки.описания_ключевых().получить(имя, "") }
    }
    если описание == "" { вернуть "null" }
    если модуль == "" и подсказки.ключевые_слова().содержит(имя) и линия.обрезать().начинается(слово) {
        // ключевое слово в начале строки: к описанию слова добавляется объяснение всей строки
        пусть строка_ = объяснение_строки(текст, путь, номер_строки + 1, к)
        если строка_ != "" {
            если пояснение != "" { пояснение += "\n\n" }
            пояснение += "**Эта строка.** " + строка_
        }
    }
    перем значение = "```dan\n" + описание + "\n```"
    если пояснение != "" { значение += "\n\n" + пояснение }
    вернуть "{\"contents\":{\"kind\":\"markdown\",\"value\":" + строка_json(значение) + "}}"
}

функ перейти(uri: стр, текст: стр, путь: стр, номер_строки: цел, символ: цел, к: Компилятор) -> стр {
    пусть строки = строки_текста(текст)
    перем линия = ""
    если номер_строки >= 0 и номер_строки < строки.длина { линия = строки[номер_строки] }
    пусть найдено_слово = слово_в_позиции(линия, из_utf16(линия.символы(), символ))
    пусть модуль = найдено_слово[0]
    пусть слово = найдено_слово[1]
    если слово == "" { вернуть "null" }
    если модуль != "" {
        если пусть файл = подключения(текст, путь, к).найти(лексер.без_ё(модуль)) {
            пусть чужой = прочитать(файл)
            если пусть о = объявления(чужой, к).найти(лексер.без_ё(слово)) {
                вернуть ("{\"uri\":" + строка_json(uri_из_пути(файл, к)) + ",\"range\":"
                    + диапазон(чужой, о.строка, о.столбец) + "}")
            }
        }
    }
    если пусть о = объявления(текст, к).найти(лексер.без_ё(слово)) {
        вернуть "{\"uri\":" + строка_json(uri) + ",\"range\":" + диапазон(текст, о.строка, о.столбец) + "}"
    }
    вернуть "null"
}

функ символы_файла(текст: стр, к: Компилятор) -> стр {
    перем итог: [стр] = []
    пусть свои = объявления(текст, к)
    для имя в свои.ключи() {
        пусть о = свои[имя]
        перем вид = 13
        выбор о.вид {
            "функция" { вид = 12 }
            "тип" { вид = 5 }
            "интерфейс" { вид = 11 }
            "вариант" { вид = 22 }
            иначе { вид = 13 }
        }
        пусть д = диапазон(текст, о.строка, о.столбец)
        итог.добавить("{\"name\":" + строка_json(имя) + ",\"kind\":" + стр(вид) + ",\"detail\":" + строка_json(о.описание)
            + ",\"range\":" + д + ",\"selectionRange\":" + д + "}")
    }
    вернуть "[" + итог.соединить(",") + "]"
}

функ привести(текст: стр) -> стр {
    если пусть новый = формат.отформатировать(текст) {
        если новый == текст { вернуть "[]" }
        пусть строк = текст.разбить("\n").длина
        вернуть ("[{\"range\":{\"start\":" + позиция(0, 0) + ",\"end\":" + позиция(строк, 0) + "},\"newText\":"
            + строка_json(новый) + "}]")
    } иначе ошибка о {
        вернуть "[]"
    }
}

// ---------- адреса файлов ----------

функ цифра16(п: цел) -> цел {
    если п >= 48 и п <= 57 { вернуть п - 48 }
    если п >= 65 и п <= 70 { вернуть п - 55 }
    если п >= 97 и п <= 102 { вернуть п - 87 }
    вернуть -1
}

/// «file:///home/%D0%B4/а.dan» -> «/home/д/а.dan»; в Windows «file:///C:/x» -> «C:\x».
общий функ путь_из_uri(uri: стр, р: стр) -> стр {
    перем путь = uri
    если путь.начинается("file://") { путь = путь[7..путь.длина - 1] }
    // имя компьютера перед путём («file://сервер/путь») пропускается
    если не путь.начинается("/") и путь.содержит("/") { путь = путь[путь.найти("/")..путь.длина - 1] }
    пусть б = байты(путь)
    перем числа: [цел] = []
    перем н = 0
    пока н < б.длина {
        если б[н] == 37 и н + 2 < б.длина и цифра16(б[н + 1]) >= 0 и цифра16(б[н + 2]) >= 0 {
            числа.добавить(цифра16(б[н + 1]) * 16 + цифра16(б[н + 2]))
            н += 3
        } иначе {
            числа.добавить(б[н])
            н += 1
        }
    }
    путь = стр(байты(числа))
    если р == "\\" {
        пусть знаки = путь.символы()
        если знаки.длина >= 3 и знаки[0] == "/" и знаки[2] == ":" { путь = путь[1..путь.длина - 1] }
        путь = путь.заменить("/", "\\")
    }
    вернуть путь
}

функ uri_из_пути(путь_: стр, к: Компилятор) -> стр {
    перем путь = путь_.заменить("\\", "/")
    если не путь.начинается("/") { путь = "/" + путь }
    перем итог = ""
    для п в числа_байтов(байты(путь)) {
        // как urllib.parse.quote: буквы, цифры и «_.-~/» остаются, остальное - %XX
        если ((п >= 48 и п <= 57) или (п >= 65 и п <= 90) или (п >= 97 и п <= 122) или п == 95 или п == 46 или п == 45
            или п == 126 или п == 47) {
            итог += символ_по_коду(п)
        } иначе {
            итог += "%" + шестнадцатеричная(байты([п])).прописные()
        }
    }
    вернуть "file://" + итог
}

// ---------- проверка документа ----------

функ строка_подключения(текст: стр) -> цел {
    перем н = 1
    для линия в строки_текста(текст) {
        если линия.обрезать().начинается("подключить") { вернуть н }
        н += 1
    }
    вернуть 1
}

функ имя_файла(путь: стр) -> стр {
    перем имя = путь
    для з в ["/", "\\"] {
        пусть части = имя.разбить(з)
        имя = части[части.длина - 1]
    }
    вернуть имя
}

/// Диагностика LSP для замечания; "" - замечание в редакторе не показывается.
функ запись_диагностики(з: машинный.Замечание, текст: стр, путь: стр) -> стр {
    перем строка = з.строка
    перем столбец = з.столбец
    перем сообщение = з.текст
    если з.файл != путь и з.файл != "" и з.файл != имя_файла(путь) {
        если з.строка > 0 и з.вид != "предупреждение" {
            // ошибка проверки в подключённом файле: показывается в начале файла
            сообщение = "в подключённом файле " + з.файл + ", строка " + стр(з.строка) + ": " + з.текст
            строка = 1
            столбец = 1
        } иначе если з.вид == "предупреждение" {
            вернуть ""
        } иначе {
            // ошибка подключения: показывается у строки подключения
            сообщение = з.файл + ": " + з.текст
            строка = строка_подключения(текст)
            столбец = 1
        }
    } иначе если строка == 0 {
        строка = строка_подключения(текст)
        столбец = 1
    }
    перем важность = 1
    если з.вид == "предупреждение" { важность = 2 }
    вернуть ("{\"range\":" + диапазон(текст, строка, столбец) + ",\"severity\":" + стр(важность)
        + ",\"source\":\"Дан\",\"message\":" + строка_json(сообщение) + "}")
}

функ диагностика(текст: стр, путь: стр, к: Компилятор) -> стр {
    перем итог: [стр] = []
    для з в к.замечания(текст, путь) {
        пусть запись = запись_диагностики(з, текст, путь)
        если запись != "" { итог.добавить(запись) }
    }
    вернуть "[" + итог.соединить(",") + "]"
}

/// textDocument/codeAction: готовые исправления из сообщений (те же, что применяет «дан исправить»)
/// для замечаний этого файла в строках от..до (с нуля, как в LSP); каждое - действие quickfix с правкой.
функ быстрые_исправления(uri: стр, текст: стр, путь: стр, от: цел, до: цел, к: Компилятор) -> стр {
    перем итог: [стр] = []
    пусть строки = строки_текста(текст)
    для з в к.замечания(текст, путь) {
        если з.файл != путь и з.файл != "" и з.файл != имя_файла(путь) { продолжить }
        если з.строка < 1 или з.строка > строки.длина или з.строка - 1 < от или з.строка - 1 > до { продолжить }
        пусть м = машинный.место(з.фрагмент, з.столбец)
        если м[1] == 0 { продолжить }
        пусть замена = машинный.исправление(з.текст)
        если замена == "" { продолжить }
        пусть знаки = строки[з.строка - 1].символы()
        перем сдвиг = 0
        если з.строка == 1 и знаки.длина > 0 и код_символа(знаки[0]) == 65279 { сдвиг = 1 }
        пусть начало = м[0] - 1 + сдвиг
        если начало >= знаки.длина { продолжить }
        перем конец = начало + м[1]
        если конец > знаки.длина { конец = знаки.длина }
        перем было = ""
        для н в начало..конец - 1 { было += знаки[н] }
        если было == замена { продолжить }
        пусть место_ = ("{\"start\":" + позиция(з.строка - 1, в_utf16(знаки, начало)) + ",\"end\":"
            + позиция(з.строка - 1, в_utf16(знаки, конец)) + "}")
        пусть правка = ("{\"changes\":{" + строка_json(uri) + ":[{\"range\":" + место_ + ",\"newText\":"
            + строка_json(замена) + "}]}}")
        перем действие = ("{\"title\":" + строка_json("Заменить «" + было + "» на «" + замена + "»")
            + ",\"kind\":\"quickfix\",\"isPreferred\":true")
        пусть запись = запись_диагностики(з, текст, путь)
        если запись != "" { действие += ",\"diagnostics\":[" + запись + "]" }
        итог.добавить(действие + ",\"edit\":" + правка + "}")
    }
    вернуть "[" + итог.соединить(",") + "]"
}

функ опубликовать(uri: стр, текст: стр, к: Компилятор) {
    уведомить("textDocument/publishDiagnostics", "{\"uri\":" + строка_json(uri) + ",\"diagnostics\":"
        + диагностика(текст, путь_из_uri(uri, к.р), к) + "}")
}

// ---------- ссылки и переименование ----------

/// Номер токена-имени под позицией LSP или -1
функ токен_под(токены: [лексер.Токен], строки: [стр], номер_строки: цел, символ: цел) -> цел {
    если номер_строки < 0 или номер_строки >= строки.длина { вернуть -1 }
    пусть знак = из_utf16(строки[номер_строки].символы(), символ)
    для н в 0..токены.длина - 1 {
        пусть т = токены[н]
        если т.вид == "ИМЯ" и т.строка == номер_строки + 1 {
            пусть начало = т.столбец - 1
            перем длина = т.написание.символы().длина
            если длина == 0 { длина = т.значение.символы().длина }
            если начало <= знак и знак <= начало + длина { вернуть н }
        }
    }
    вернуть -1
}

функ за_точкой(токены: [лексер.Токен], н: цел) -> лог {
    вернуть н > 0 и токены[н - 1].вид == "ЗНАК" и токены[н - 1].значение == "."
}

/// Функции верхнего уровня: пары номеров токенов [начало, конец] (от «функ» до закрывающей «}»)
функ функции_файла(токены: [лексер.Токен]) -> [[цел]] {
    перем итог: [[цел]] = []
    перем глубина = 0
    перем начало = -1
    для н в 0..токены.длина - 1 {
        пусть т = токены[н]
        если т.вид == "КЛЮЧ" и т.значение == "функ" и глубина == 0 и начало < 0 { начало = н }
        если т.вид == "ЗНАК" и т.значение == "{" { глубина += 1 }
        если т.вид == "ЗНАК" и т.значение == "}" {
            глубина -= 1
            если глубина == 0 и начало >= 0 {
                итог.добавить([начало, н])
                начало = -1
            }
        }
    }
    вернуть итог
}

/// Объявлено ли имя в части токенов: параметр «имя:» в заголовке функции, после «пусть», «перем», «для», «ошибка»
функ объявлено_в(токены: [лексер.Токен], от: цел, до: цел, имя: стр) -> лог {
    перем в_заголовке = истина
    для н в от..до {
        пусть т = токены[н]
        если т.вид == "ЗНАК" и т.значение == "{" { в_заголовке = ложь }
        если т.вид != "ИМЯ" или т.значение != имя или за_точкой(токены, н) { продолжить }
        если н > 0 {
            пусть п = токены[н - 1]
            если п.вид == "КЛЮЧ" и (п.значение == "пусть" или п.значение == "перем" или п.значение == "для" или п.значение == "ошибка") {
                вернуть истина
            }
        }
        если в_заголовке и н + 1 <= до и токены[н + 1].вид == "ЗНАК" и токены[н + 1].значение == ":" { вернуть истина }
    }
    вернуть ложь
}

/// Номера токенов, которые означают то же имя, что токен под курсором; пустой список - имя переименовать нельзя
функ места_имени(токены: [лексер.Токен], н: цел) -> [цел] {
    перем итог: [цел] = []
    если н < 0 или за_точкой(токены, н) { вернуть итог }
    пусть имя = токены[н].значение
    пусть функции = функции_файла(токены)
    // своя функция, если имя объявлено в ней (параметр или переменная)
    для ф в функции {
        если ф[0] <= н и н <= ф[1] и объявлено_в(токены, ф[0], ф[1], имя) {
            // имя функции в её же заголовке - имя верхнего уровня
            если не (н == ф[0] + 1) {
                для к в ф[0]..ф[1] {
                    если токены[к].вид == "ИМЯ" и токены[к].значение == имя и не за_точкой(токены, к) { итог.добавить(к) }
                }
                вернуть итог
            }
        }
    }
    // имя верхнего уровня: весь файл, кроме функций, где объявлено такое же местное имя
    для к в 0..токены.длина - 1 {
        если токены[к].вид != "ИМЯ" или токены[к].значение != имя или за_точкой(токены, к) { продолжить }
        перем своё = ложь
        для ф в функции {
            если ф[0] <= к и к <= ф[1] и к != ф[0] + 1 и объявлено_в(токены, ф[0], ф[1], имя) { своё = истина }
        }
        если не своё { итог.добавить(к) }
    }
    вернуть итог
}

функ диапазон_токена(строки: [стр], т: лексер.Токен) -> стр {
    перем линия: [стр] = []
    если т.строка - 1 < строки.длина { линия = строки[т.строка - 1].символы() }
    перем длина = т.написание.символы().длина
    если длина == 0 { длина = т.значение.символы().длина }
    вернуть ("{\"start\":" + позиция(т.строка - 1, в_utf16(линия, т.столбец - 1)) + ",\"end\":"
        + позиция(т.строка - 1, в_utf16(линия, т.столбец - 1 + длина)) + "}")
}

функ токены_текста(текст: стр) -> [лексер.Токен] {
    если пусть т = лексер.разобрать(текст) { вернуть т } иначе ошибка о {
        // в тексте ошибка записи: ссылок не ищем
        пусть пусто: [лексер.Токен] = []
        вернуть пусто
    }
}

/// textDocument/references: места имени в этом файле
функ ссылки(uri: стр, текст: стр, номер_строки: цел, символ: цел) -> стр {
    пусть токены = токены_текста(текст)
    пусть строки = строки_текста(текст)
    перем итог: [стр] = []
    для к в места_имени(токены, токен_под(токены, строки, номер_строки, символ)) {
        итог.добавить("{\"uri\":" + строка_json(uri) + ",\"range\":" + диапазон_токена(строки, токены[к]) + "}")
    }
    вернуть "[" + итог.соединить(",") + "]"
}

/// textDocument/prepareRename: диапазон имени или null
функ можно_переименовать(текст: стр, номер_строки: цел, символ: цел) -> стр {
    пусть токены = токены_текста(текст)
    пусть строки = строки_текста(текст)
    пусть н = токен_под(токены, строки, номер_строки, символ)
    если места_имени(токены, н).длина == 0 { вернуть "null" }
    вернуть диапазон_токена(строки, токены[н])
}

/// Подходит ли новое имя: одно имя, не ключевое слово
функ верное_новое_имя(имя: стр) -> лог {
    если пусть т = лексер.разобрать(имя) {
        перем имён = 0
        для токен в т {
            если токен.вид == "ИМЯ" { имён += 1 } иначе если токен.вид != "КОНЕЦ_СТРОКИ" и токен.вид != "КОНЕЦ_ФАЙЛА" { вернуть ложь }
        }
        вернуть имён == 1
    } иначе ошибка о {
        вернуть ложь
    }
}

/// textDocument/rename: правки WorkspaceEdit; "" - новое имя не подходит
функ переименовать(uri: стр, текст: стр, номер_строки: цел, символ: цел, новое: стр) -> стр {
    если не верное_новое_имя(новое) { вернуть "" }
    пусть токены = токены_текста(текст)
    пусть строки = строки_текста(текст)
    перем правки: [стр] = []
    для к в места_имени(токены, токен_под(токены, строки, номер_строки, символ)) {
        правки.добавить("{\"range\":" + диапазон_токена(строки, токены[к]) + ",\"newText\":" + строка_json(новое) + "}")
    }
    если правки.длина == 0 { вернуть "null" }
    вернуть "{\"changes\":{" + строка_json(uri) + ":[" + правки.соединить(",") + "]}}"
}

// ---------- главный цикл ----------

функ возможности() -> стр {
    вернуть ("{\"capabilities\":{\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":{\"includeText\":false}},"
        + "\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"hoverProvider\":true,\"definitionProvider\":true,"
        + "\"documentSymbolProvider\":true,\"documentFormattingProvider\":true,\"referencesProvider\":true,"
        + "\"codeActionProvider\":{\"codeActionKinds\":[\"quickfix\"]},"
        + "\"renameProvider\":{\"prepareProvider\":true}},"
        + "\"serverInfo\":{\"name\":\"Дан\",\"version\":" + строка_json(среда.версия()) + "}}")
}

/// «дан сервер»: обмен сообщениями с редактором до «exit» или конца ввода.
общий функ работать(к: Компилятор) -> цел {
    перем поток = Поток()
    перем документы: {стр: стр} = {}
    пока истина {
        пусть с = прочитать_сообщение(поток)
        поток = с.поток
        если с.тело == "" { прервать }
        перем сообщение = json.Пусто
        если пусть з = json.разобрать(с.тело) { сообщение = з } иначе ошибка о { продолжить }
        пусть метод = сообщение.поле("method").как_стр() иначе ""
        перем номер = ""
        если сообщение.есть_поле("id") { номер = json.записать(сообщение.поле("id")) }
        пусть п = сообщение.поле("params")
        пусть uri = п.поле("textDocument").поле("uri").как_стр() иначе ""
        пусть строка = п.поле("position").поле("line").как_цел() иначе 0
        пусть символ = п.поле("position").поле("character").как_цел() иначе 0
        перем результат = "null"
        выбор метод {
            "initialize" { результат = возможности() }
            "initialized" { }
            "shutdown" { }
            "exit" { прервать }
            "textDocument/didOpen" {
                документы[uri] = п.поле("textDocument").поле("text").как_стр() иначе ""
                опубликовать(uri, документы[uri], к)
            }
            "textDocument/didChange" {
                для изменение в п.поле("contentChanges").элементы() {
                    документы[uri] = изменение.поле("text").как_стр() иначе ""
                }
                опубликовать(uri, документы.получить(uri, ""), к)
            }
            "textDocument/didSave" { опубликовать(uri, документы.получить(uri, ""), к) }
            "textDocument/didClose" {
                если документы.содержит(uri) { документы.удалить(uri) }
                уведомить("textDocument/publishDiagnostics", "{\"uri\":" + строка_json(uri) + ",\"diagnostics\":[]}")
            }
            "textDocument/completion" {
                результат = подсказать(документы.получить(uri, ""), путь_из_uri(uri, к.р), строка, символ, к)
            }
            "textDocument/hover" {
                результат = навести(документы.получить(uri, ""), путь_из_uri(uri, к.р), строка, символ, к)
            }
            "textDocument/definition" {
                результат = перейти(uri, документы.получить(uri, ""), путь_из_uri(uri, к.р), строка, символ, к)
            }
            "textDocument/documentSymbol" { результат = символы_файла(документы.получить(uri, ""), к) }
            "textDocument/formatting" { результат = привести(документы.получить(uri, "")) }
            "textDocument/references" { результат = ссылки(uri, документы.получить(uri, ""), строка, символ) }
            "textDocument/codeAction" {
                пусть от = п.поле("range").поле("start").поле("line").как_цел() иначе 0
                пусть до = п.поле("range").поле("end").поле("line").как_цел() иначе от
                результат = быстрые_исправления(uri, документы.получить(uri, ""), путь_из_uri(uri, к.р), от, до, к)
            }
            "textDocument/prepareRename" { результат = можно_переименовать(документы.получить(uri, ""), строка, символ) }
            "textDocument/rename" {
                пусть новое = п.поле("newName").как_стр() иначе ""
                результат = переименовать(uri, документы.получить(uri, ""), строка, символ, новое)
                если результат == "" {
                    отправить("{\"jsonrpc\":\"2.0\",\"id\":" + номер + ",\"error\":{\"code\":-32602,\"message\":"
                        + строка_json("«" + новое + "» не может быть именем: нужно одно имя, не ключевое слово") + "}}")
                    продолжить
                }
            }
            иначе {
                если номер != "" и метод != "" {
                    отправить("{\"jsonrpc\":\"2.0\",\"id\":" + номер + ",\"error\":{\"code\":-32601,\"message\":"
                        + строка_json("метод " + метод + " не поддерживается") + "}}")
                }
                продолжить
            }
        }
        если номер != "" { ответить(номер, результат) }
    }
    вернуть 0
}
