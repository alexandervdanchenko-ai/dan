/// Программа сверки: ошибки и предупреждения проверки смысла, найденные на Дане.
///
///     сам/проверка_ошибки --версия=1.3 --редакции=2026 --библиотека=папка --разделитель=/ программа.dan [...]
///
/// Для каждого файла - строка «== путь», затем «ОШИБКА РАЗБОРА» с сообщением или
/// сообщения проверки: «ОШИБКА место: текст» и «ПРЕДУПРЕЖДЕНИЕ место: текст».

подключить "модули"
подключить "проверка"
подключить "встроенные"

функ место(с: проверка.Сообщение, файлы: [стр]) -> стр {
    пусть номер = частное(с.строка, 1000000)
    если с.строка >= 1000000 и номер < файлы.длина {
        вернуть "Файл " + файлы[номер] + ", строка " + стр(с.строка % 1000000) + ", позиция " + стр(с.столбец)
    }
    вернуть "Строка " + стр(с.строка) + ", позиция " + стр(с.столбец)
}

перем настройки = модули.Настройки("")
перем файлы: [стр] = []
для а в аргументы() {
    если а.начинается("--версия=") {
        настройки.версия = а[9..а.длина - 1]
    } иначе если а.начинается("--редакции=") {
        настройки.редакции = а[11..а.длина - 1].разбить(",")
    } иначе если а.начинается("--библиотека=") {
        настройки.библиотека = а[13..а.длина - 1]
    } иначе если а.начинается("--разделитель=") {
        настройки.разделитель = а[14..а.длина - 1]
    } иначе {
        файлы.добавить(а)
    }
}
пусть таблицы = встроенные.таблицы()
для путь в файлы {
    вывод("== " + путь)
    если пусть программа = модули.загрузить(прочитать(путь), путь, настройки) {
        пусть итог = проверка.проверить(программа.дерево, таблицы)
        для о в итог.ошибки { вывод("ОШИБКА " + место(о, программа.файлы) + ": " + о.текст.заменить("\n", "\\n")) }
        для п в итог.предупреждения { вывод("ПРЕДУПРЕЖДЕНИЕ " + место(п, программа.файлы) + ": " + п.текст.заменить("\n", "\\n")) }
    } иначе ошибка о {
        вывод("ОШИБКА РАЗБОРА " + о.заменить("\n", "\\n"))
    }
}
