/// Отчёты команд «тестировать --покрытие», «замерить» и «профиль», написанные на Дане.
///
/// Делают то же, что функции отчёт_покрытия, отчёт_замеров и отчёт_профиля в dan.py.
/// Отчёт о покрытии совпадает с dan.py побайтно (проверяет test_sam.py); в отчётах
/// о времени числа каждый раз свои, совпадает их запись.

подключить "json"

функ обрезать_всё(текст: стр) -> стр { вернуть текст.обрезать() }

/// Выравнивание по правому краю: строка, дополненная пробелами слева до ширины.
общий функ справа(текст: стр, ширина: цел) -> стр {
    если текст.длина >= ширина { вернуть текст }
    вернуть " ".повторить(ширина - текст.длина) + текст
}

/// Число с «знаков» цифрами после запятой (запятая - знак дробной части): 12,5.
общий функ с_запятой(х: дроб, знаков: цел) -> стр {
    перем множитель = 1
    для н в 1..знаков { множитель *= 10 }
    пусть всё = округлить(х * дроб(множитель))
    перем текст = стр(частное(всё, множитель))
    если знаков > 0 {
        перем дробная = стр(всё % множитель)
        пока дробная.длина < знаков { дробная = "0" + дробная }
        текст += "," + дробная
    }
    вернуть текст
}

/// Время в наносекундах: «1,25 с», «12,5 мс», «152,3 мкс», «35,1 нс».
общий функ время_по_русски(нс: дроб) -> стр {
    если нс >= 1000000000.0 { вернуть с_запятой(нс / 1000000000.0, 2) + " с" }
    если нс >= 1000000.0 { вернуть с_запятой(нс / 1000000.0, 1) + " мс" }
    если нс >= 1000.0 { вернуть с_запятой(нс / 1000.0, 1) + " мкс" }
    вернуть с_запятой(нс, 1) + " нс"
}

/// Есть ли в тексте программы строка, начинающаяся словом и строкой в кавычках: тест "..." или замер "...".
общий функ есть_блок(исходник: стр, слово: стр) -> лог {
    для строка в исходник.разбить("\n") {
        пусть с = строка.обрезать()
        если с.начинается(слово) {
            пусть остаток = с[слово.длина..с.длина - 1]
            если остаток.длина > 1 и (остаток[0] == " " или остаток[0] == "\t") и остаток.обрезать().начинается("\"") {
                вернуть истина
            }
        }
    }
    вернуть ложь
}

// ---------- покрытие ----------

/// Отчёт о покрытии из файла, записанного программой тестов (переменная DAN_COVERAGE): сколько
/// строк программы выполнено и какие не выполнялись. Строка считается выполненной, если выполнены
/// все инструкции, записанные в ней. «тексты» - тексты файлов программы по их именам.
общий функ отчёт_покрытия(данные: стр, тексты: {стр: стр}) -> стр {
    перем выполнена: {стр: лог} = {}          // «файл\tстрока» -> выполнены ли все инструкции строки
    перем порядок: {стр: цел} = {}            // файл -> номер по первому появлению
    перем места: {стр: [стр]} = {}            // «файл\tстрока» -> [файл, строка]
    для запись в данные.разбить("\n") {
        если запись == "" { продолжить }
        пусть части = запись.разбить("\t")
        если части.длина < 3 { продолжить }
        пусть ключ = части[0] + "\t" + части[1]
        если не порядок.содержит(части[0]) { порядок[части[0]] = порядок.длина }
        перем было = истина
        если выполнена.содержит(ключ) { было = выполнена[ключ] }
        выполнена[ключ] = было и части[2] == "1"
        места[ключ] = [части[0], части[1]]
    }
    если выполнена.длина == 0 { вернуть "Покрытие: в программе нет строк, кроме тестов" }
    перем пропущены: [стр] = []
    для ключ в выполнена.ключи() {
        если не выполнена[ключ] { пропущены.добавить(ключ) }
    }
    пропущены = пропущены.упорядочить_по(функ(к: стр) -> цел {
        вернуть порядок[места[к][0]] * 100000000 + (разобрать_цел(места[к][1]) иначе 0)
    })
    пусть всего = выполнена.длина
    пусть сделано = всего - пропущены.длина
    если пропущены.длина == 0 { вернуть "Покрытие: тесты выполнили все строки программы (" + стр(всего) + ")" }
    // доля в процентах с одним знаком после запятой, округлённая точно (целыми числами)
    пусть десятые = частное(сделано * 2000 + всего, 2 * всего)
    перем доля = стр(частное(десятые, 10))
    если десятые % 10 != 0 { доля += "," + стр(десятые % 10) }
    перем слово = "строк"
    если сделано % 10 == 1 и сделано % 100 != 11 {
        слово = "строку"
    } иначе если сделано % 10 >= 2 и сделано % 10 <= 4 и не (сделано % 100 >= 12 и сделано % 100 <= 14) {
        слово = "строки"
    }
    перем итог = ["Покрытие: тесты выполнили " + стр(сделано) + " " + слово + " из " + стр(всего) + " (" + доля
        + "%). Не выполнены (целиком или частично):"]
    для н в 0..пропущены.длина - 1 {
        если н >= 40 { прервать }
        пусть файл = места[пропущены[н]][0]
        пусть номер = разобрать_цел(места[пропущены[н]][1]) иначе 0
        перем линия = ""
        если тексты.содержит(файл) {
            пусть строки = тексты[файл].разбить("\n")
            если номер > 0 и номер <= строки.длина { линия = обрезать_всё(строки[номер - 1]) }
        }
        итог.добавить("  " + файл + ", строка " + стр(номер) + ": " + линия)
    }
    если пропущены.длина > 40 { итог.добавить("  ... и ещё строк: " + стр(пропущены.длина - 40)) }
    вернуть итог.соединить("\n")
}

// ---------- замеры ----------

/// Отчёт о замерах и новые значения для сравнения в следующий раз (имя -> [среднее, разброс в %]).
/// Изменение считается заметным, если оно больше 2% и больше утроенного разброса.
общий тип Замеры {
    строки: [стр]
    новые: {стр: [дроб]}
}

общий функ отчёт_замеров(данные: стр, прошлые: {стр: [дроб]}) -> Замеры {
    перем итог: [стр] = []
    перем новые: {стр: [дроб]} = {}
    для запись в данные.разбить("\n") {
        если запись == "" { продолжить }
        пусть ч = запись.разбить("\t")
        пусть имя = ч[0]
        если ч.длина == 5 и ч[1] == "!" {
            итог.добавить("  " + имя + ": ОШИБКА (" + ч[3] + ", строка " + ч[4] + "): " + ч[2])
            продолжить
        }
        если ч.длина < 5 { продолжить }
        пусть среднее = разобрать_дроб(ч[1]) иначе 0.0
        пусть отклонение = разобрать_дроб(ч[2]) иначе 0.0
        пусть раз = разобрать_цел(ч[4]) иначе 0
        перем разброс = 0.0
        если среднее > 0.0 { разброс = отклонение * 100.0 / среднее }
        новые[имя] = [среднее, разброс]
        перем строка = ("  " + имя + ": " + время_по_русски(среднее) + " (разброс ±" + с_запятой(разброс, 1)
            + "%, выполнено раз: " + стр(раз) + ")")
        если прошлые.содержит(имя) и прошлые[имя].длина == 2 и прошлые[имя][0] > 0.0 и среднее > 0.0 {
            пусть было_ = прошлые[имя][0]
            пусть изменение = (среднее - было_) * 100.0 / было_
            перем порог = 3.0 * разброс
            если прошлые[имя][1] > разброс { порог = 3.0 * прошлые[имя][1] }
            если порог < 2.0 { порог = 2.0 }
            пусть было = "в прошлый раз " + время_по_русски(было_)
            перем модуль_ = изменение
            если модуль_ < 0.0 { модуль_ = -модуль_ }
            если модуль_ <= порог {
                строка += "; " + было + ", разница " + с_запятой(модуль_, 1) + "% в пределах разброса"
            } иначе если изменение < 0.0 {
                строка += "; " + было + ": быстрее в " + с_запятой(было_ / среднее, 2) + " раза"
            } иначе {
                строка += "; " + было + ": медленнее в " + с_запятой(среднее / было_, 2) + " раза"
            }
        }
        итог.добавить(строка)
    }
    вернуть Замеры(итог, новые)
}

функ число_json(з: json.Значение) -> дроб { вернуть з.как_дроб() иначе 0.0 }

/// Прошлые замеры из файла JSON {"имя": [среднее, разброс]}; пустой словарь, если файла нет.
общий функ прочитать_замеры(путь: стр) -> {стр: [дроб]} {
    перем итог: {стр: [дроб]} = {}
    если не существует(путь) { вернуть итог }
    пусть з = json.разобрать(прочитать(путь)) иначе json.Пусто
    для имя в з.ключи() {
        пусть пара = з.поле(имя).элементы()
        если пара.длина == 2 { итог[имя] = [число_json(пара[0]), число_json(пара[1])] }
    }
    вернуть итог
}

/// Записывает замеры в файл JSON (прошлые, дополненные новыми).
общий функ записать_замеры(путь: стр, прошлые: {стр: [дроб]}, новые: {стр: [дроб]}) {
    перем все = прошлые
    для имя в новые.ключи() { все[имя] = новые[имя] }
    перем поля: {стр: json.Значение} = {}
    для имя в все.ключи() { поля[имя] = json.Массив([json.Число(все[имя][0]), json.Число(все[имя][1])]) }
    записать(путь, json.записать(json.Объект(поля)))
}

// ---------- профиль ----------

/// Таблица профиля из файла, записанного программой при выходе (переменная DAN_PROFILE).
общий функ отчёт_профиля(данные: стр) -> стр! {
    пусть строки = данные.разбить("\n")
    пусть всего = разобрать_цел(строки[0])!
    перем записи: [[стр]] = []
    для н в 1..строки.длина - 1 {
        пусть ч = строки[н].разбить("\t")
        если ч.длина == 6 и (разобрать_цел(ч[3]) иначе 0) > 0 { записи.добавить(ч) }
    }
    // по убыванию своего времени, затем полного, затем числа вызовов, имени, файла и строки
    записи = записи.упорядочить_по(функ(з: [стр]) -> стр { вернуть ключ_профиля(з) })
    перем итог = ["Профиль: программа работала " + время_профиля(всего) + ". Своё время - без вызванных функций.",
                  справа("своё время", 18) + " " + справа("всего", 10) + " " + справа("вызовов", 12) + "  функция"]
    перем сумма = 0
    для з в записи { сумма += разобрать_цел(з[5]) иначе 0 }
    для н в 0..записи.длина - 1 {
        если н >= 30 { прервать }
        пусть з = записи[н]
        пусть своё = разобрать_цел(з[5]) иначе 0
        перем доля = ""
        если всего > 0 { доля = с_запятой(дроб(своё) * 100.0 / дроб(всего), 1) + "%" }
        перем место = ""
        если з[2] != "0" { место = " (" + имя_файла(з[1]) + ":" + з[2] + ")" }
        итог.добавить(справа(время_профиля(своё), 11) + " " + справа(доля, 6) + " "
            + справа(время_профиля(разобрать_цел(з[4]) иначе 0), 10) + " " + справа(з[3], 12) + "  " + з[0] + место)
    }
    если записи.длина > 30 { итог.добавить("... и ещё функций: " + стр(записи.длина - 30)) }
    если всего > 0 и дроб(сумма) > дроб(всего) * 1.05 {
        итог.добавить("Задачи выполнялись одновременно, поэтому сумма долей больше 100%.")
    }
    вернуть итог.соединить("\n")
}

/// Ключ упорядочения записей профиля: большее время - раньше (числа дополнены до одной длины).
функ ключ_профиля(з: [стр]) -> стр {
    перем ключ = ""
    для поле в [з[5], з[4], з[3]] {
        пусть число = разобрать_цел(поле) иначе 0
        перем запись = стр(999999999999999999 - число)
        пока запись.длина < 18 { запись = "0" + запись }
        ключ += запись
    }
    вернуть ключ
}

функ время_профиля(нс: цел) -> стр {
    если нс >= 1000000000 { вернуть с_запятой(дроб(нс) / 1000000000.0, 2) + " с" }
    если нс >= 1000000 { вернуть с_запятой(дроб(нс) / 1000000.0, 1) + " мс" }
    вернуть с_запятой(дроб(нс) / 1000.0, 1) + " мкс"
}

функ имя_файла(путь: стр) -> стр {
    перем имя = путь
    для р в ["/", "\\"] {
        пусть части = имя.разбить(р)
        имя = части[части.длина - 1]
    }
    вернуть имя
}
