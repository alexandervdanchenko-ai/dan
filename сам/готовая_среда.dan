/// Заранее собранная среда выполнения для компилятора на Дане: то же, что gotovaya_sreda.py.
///
/// Большие библиотеки среды (данные, PDF, система, сеть, база данных, математика) собираются
/// компилятором C один раз и хранятся в кэше как объектные файлы; программа собирается из
/// своей части кода C и компонуется с ними. Код C программы (вывод «дан си») не меняется:
/// разделение делается при сборке. Здесь - только работа с текстом C; сборку и кэш ведёт дан.dan.

/// Признаки сборок, для которых готовая среда не годится.
общий функ не_для(код_c: стр) -> лог {
    для п в ["#define DAN_DEBUG 1", "#define DAN_PROF_COUNT", "#define DAN_COV_COUNT", "#define DAN_TASKS 1",
        "#define DAN_GUI 1"] {
        если код_c.содержит(п) { вернуть истина }
    }
    вернуть ложь
}

/// Образцовая программа группы: пользуется только этой библиотекой.
общий функ образец(группа: стр) -> стр {
    выбор группа {
        "данные" { вернуть "вывод(хеш(\"а\"))\n" }
        "pdf" { вернуть "если пусть т = текст_pdf(байты(\"а\")) { вывод(т) }\n" }
        "система" { вернуть "вывод(сегодня())\n" }
        "сеть" { вернуть "вывод(дата_для_письма())\n" }
        "база" { вернуть "если пусть б = база_открыть(\"а\") { база_закрыть(б) }\n" }
        иначе { вернуть "вывод(синус(1.0))\n" }
    }
}

/// Часть текста C: обычный текст или функция с «static» в начале строки.
тип Часть {
    функция: лог = ложь
    /// весь текст части (у функции - вместе с телом)
    текст: стр = ""
    имя: стр = ""
    встроенная: лог = ложь
    /// заголовок функции до «{» (у объявления без тела - всё объявление)
    голова: стр = ""
    есть_тело: лог = ложь
    тело: стр = ""
}

функ буква_имени(з: стр) -> лог {
    вернуть (з >= "a" и з <= "z") или (з >= "A" и з <= "Z") или (з >= "0" и з <= "9") или з == "_"
}

/// Последнее имя (слово из латинских букв, цифр и «_») в тексте до первой «(».
функ имя_функции(голова: стр) -> стр {
    пусть скобка = голова.найти("(")
    перем до = голова
    если скобка >= 0 {
        если скобка == 0 { вернуть "" }
        до = голова[0..скобка - 1]
    }
    перем итог = ""
    перем текущее = ""
    для з в до.символы() {
        если буква_имени(з) { текущее += з } иначе {
            если текущее != "" { итог = текущее }
            текущее = ""
        }
    }
    если текущее != "" { итог = текущее }
    вернуть итог
}

/// Начинается ли со строки объявление или определение функции с «static».
общий функ это_функция(строка: стр) -> лог {
    если не строка.начинается("static ") { вернуть ложь }
    перем голова = строка
    пусть фигурная = строка.найти("{")
    если фигурная >= 0 {
        если фигурная == 0 { вернуть ложь }
        голова = строка[0..фигурная - 1]
    }
    пусть скобка = голова.найти("(")
    если скобка < 0 { вернуть ложь }
    пусть после = голова[скобка + 1..голова.длина - 1].обрезать()
    если после.начинается("*") { вернуть ложь }          // указатель на функцию - переменная
    если скобка > 0 и голова[0..скобка - 1].содержит("=") { вернуть ложь }
    вернуть истина
}

функ без_static(строка: стр) -> стр {
    перем с = строка[7..строка.длина - 1]
    если с.начинается("inline ") { с = с[7..с.длина - 1] }
    вернуть с
}

функ без_пробелов_справа(с: стр) -> стр {
    перем конец = с.длина
    пока конец > 0 и [" ", "\t", "\n", "\r"].содержит(с[конец - 1]) { конец -= 1 }
    если конец == 0 { вернуть "" }
    вернуть с[0..конец - 1]
}

функ подсчёт(с: стр, знак: стр) -> цел {
    перем н = 0
    для з в с.символы() {
        если з == знак { н += 1 }
    }
    вернуть н
}

/// Части текста C (строки соединяются через «\n», последняя строка - без него).
общий функ разобрать(текст: стр) -> [Часть] {
    пусть строки = текст.разбить("\n")
    перем итог: [Часть] = []
    перем обычные: [стр] = []
    перем номер = 0
    пока номер < строки.длина {
        пусть строка = строки[номер]
        если не это_функция(строка) {
            обычные.добавить(строка)
            номер += 1
            продолжить
        }
        перем к = номер
        пока не строки[к].содержит("{") и не без_пробелов_справа(строки[к]).оканчивается(";") и к + 1 < строки.длина {
            к += 1
        }
        перем голова_строки: [стр] = []
        для н в номер..к { голова_строки.добавить(строки[н]) }
        пусть голова = голова_строки.соединить("\n")
        если обычные.длина > 0 {
            итог.добавить(Часть(текст = обычные.соединить("\n")))
            обычные = []
        }
        если не голова.содержит("{") {
            итог.добавить(Часть(функция = истина, текст = голова, имя = имя_функции(голова),
                встроенная = голова.начинается("static inline "), голова = голова))
            номер = к + 1
            продолжить
        }
        перем конец = к
        если не (без_пробелов_справа(голова).оканчивается("}") и подсчёт(голова, "{") == подсчёт(голова, "}")) {
            конец = к + 1
            пока конец < строки.длина и не строки[конец].начинается("}") { конец += 1 }
        }
        перем все: [стр] = []
        для н в номер..конец {
            если н < строки.длина { все.добавить(строки[н]) }
        }
        пусть кусок = все.соединить("\n")
        пусть позиция = кусок.найти("{")
        перем до_тела = ""
        если позиция > 0 { до_тела = кусок[0..позиция - 1] }
        итог.добавить(Часть(функция = истина, текст = кусок, имя = имя_функции(до_тела),
            встроенная = кусок.начинается("static inline "), голова = до_тела, есть_тело = истина,
            тело = кусок[позиция..кусок.длина - 1]))
        номер = конец + 1
    }
    если обычные.длина > 0 { итог.добавить(Часть(текст = обычные.соединить("\n"))) }
    вернуть итог
}

функ объявление(голова: стр) -> стр {
    вернуть без_static(без_пробелов_справа(голова)) + ";"
}

функ соединить(части: [стр]) -> стр { вернуть части.соединить("\n") }

/// Текст библиотеки: тела функций заменены объявлениями без «static».
общий функ как_объявления(текст: стр) -> стр {
    перем итог: [стр] = []
    для ч в разобрать(текст) {
        если не ч.функция { итог.добавить(ч.текст) } иначе { итог.добавить(объявление(ч.голова)) }
    }
    вернуть соединить(итог)
}

/// Текст библиотеки с телами функций, все функции видимы снаружи.
общий функ с_телами(текст: стр) -> стр {
    перем итог: [стр] = []
    для ч в разобрать(текст) {
        если не ч.функция { итог.добавить(ч.текст) } иначе { итог.добавить(без_static(ч.текст)) }
    }
    вернуть соединить(итог)
}

/// Строка - переменная состояния среды уровня файла («static ...;» без «const»).
функ переменная(строка: стр) -> лог {
    если не строка.начинается("static ") или строка.начинается("static const ") { вернуть ложь }
    пусть точка = строка.найти(";")
    если точка < 0 { вернуть ложь }
    пусть до = строка[0..точка - 1]
    пусть равно = до.найти("=")
    перем объявление_ = до
    если равно >= 0 { объявление_ = до[0..равно - 1] }
    если объявление_.содержит("{") { вернуть ложь }
    вернуть не это_функция(строка)
}

функ как_внешняя(строка: стр) -> стр {
    пусть точка = строка.найти(";")
    пусть до = строка[7..точка - 1]
    перем объявление_ = до
    пусть равно = до.найти("=")
    если равно >= 0 { объявление_ = без_пробелов_справа(до[0..равно - 1]) }
    вернуть "extern " + объявление_ + строка[точка..строка.длина - 1]
}

функ переменные_внешние(текст: стр) -> стр {
    перем итог: [стр] = []
    для с в текст.разбить("\n") {
        если переменная(с) { итог.добавить(как_внешняя(с)) } иначе { итог.добавить(с) }
    }
    вернуть соединить(итог)
}

функ переменные_видимые(текст: стр) -> стр {
    перем итог: [стр] = []
    для с в текст.разбить("\n") {
        если переменная(с) { итог.добавить(с[7..с.длина - 1]) } иначе { итог.добавить(с) }
    }
    вернуть соединить(итог)
}

функ определённые(части: [Часть]) -> {стр: лог} {
    перем итог: {стр: лог} = {}
    для ч в части {
        если ч.функция и ч.есть_тело { итог[ч.имя] = истина }
    }
    вернуть итог
}

/// Итог: текст и имена функций среды (определяются в части программы).
общий тип Текст {
    текст: стр
    имена: [стр] = []
}

/// Среда в части библиотеки: переменные - «extern», функции, зависящие от программы
/// (имена её файлов), - объявления, объявления функций библиотек - без «static».
функ среда_для_библиотеки(среда: стр) -> Текст {
    перем итог: [стр] = []
    перем имена: [стр] = []
    пусть части = разобрать(среда)
    пусть свои = определённые(части)
    для ч в части {
        если не ч.функция {
            итог.добавить(переменные_внешние(ч.текст))
        } иначе если не ч.есть_тело и не свои.содержит(ч.имя) {
            итог.добавить(без_static(ч.текст))
        } иначе если ч.есть_тело и (ч.тело.содержит("dan_files") или ч.тело.содержит("DAN_FILE_COUNT")) {
            имена.добавить(ч.имя)
            итог.добавить(объявление(ч.голова))
        } иначе {
            итог.добавить(ч.текст)
        }
    }
    // объявления без тела тех же функций - тоже без «static»
    перем готовый: [стр] = []
    для к в итог {
        если к.начинается("static ") и это_функция(к) и имена.содержит(имя_функции(к)) {
            готовый.добавить(без_static(к))
        } иначе {
            готовый.добавить(к)
        }
    }
    вернуть Текст(соединить(готовый), имена)
}

/// Среда в части программы: переменные состояния и функции из «видимые» - без «static».
функ среда_для_программы(среда: стр, видимые: [стр]) -> стр {
    перем итог: [стр] = []
    пусть части = разобрать(среда)
    пусть свои = определённые(части)
    для ч в части {
        если не ч.функция {
            итог.добавить(переменные_видимые(ч.текст))
        } иначе если видимые.содержит(ч.имя) или (не ч.есть_тело и не свои.содержит(ч.имя)) {
            итог.добавить(без_static(ч.текст))
        } иначе {
            итог.добавить(ч.текст)
        }
    }
    вернуть соединить(итог)
}

/// Текст готовой части группы из кода образцовой программы и имена функций среды, которые
/// определяются в части программы. «группы» - пары [имя, текст] в порядке кода C.
общий функ часть_библиотеки(образец_c: стр, среда: стр, группа: стр, группы: [[стр]]) -> Текст! {
    пусть начало_среды = образец_c.найти(среда)
    если начало_среды < 0 { вернуть ошибка("в образцовой программе нет среды") }
    перем места: [цел] = []
    перем первое = -1
    перем есть_своя = ложь
    для г в группы {
        пусть п = образец_c.найти(г[1])
        места.добавить(п)
        если п >= 0 {
            если первое < 0 или п < первое { первое = п }
            если г[0] == группа { есть_своя = истина }
        }
    }
    если не есть_своя { вернуть ошибка("образцовая программа группы «" + группа + "» не содержит её библиотеку") }
    пусть с = среда_для_библиотеки(среда)
    перем части: [стр] = []
    если начало_среды > 0 { части.добавить(образец_c[0..начало_среды - 1]) }
    части.добавить(с.текст)
    пусть после_среды = начало_среды + среда.длина
    если первое > после_среды { части.добавить(образец_c[после_среды..первое - 1]) }
    // группы - в порядке их места в коде образца (он совпадает с порядком «группы»)
    для н в 0..группы.длина - 1 {
        если места[н] < 0 { продолжить }
        части.добавить("\n")
        если группы[н][0] == группа { части.добавить(с_телами(группы[н][1])) } иначе {
            части.добавить(как_объявления(группы[н][1]))
        }
    }
    пусть итог = части.соединить("")
    // функции среды, упомянутые в части не только своим объявлением
    перем видимые: [стр] = []
    для имя в с.имена {
        если итог.разбить(имя).длина > 2 { видимые.добавить(имя) }
    }
    вернуть Текст(итог, видимые)
}

/// Часть программы и группы, библиотеки которых взяты из готовой среды; группы пусты -
/// готовая среда не подходит.
общий функ часть_программы(код_c: стр, среда: стр, группы: [[стр]], видимые: [стр]) -> Текст {
    перем программа = код_c
    для г в группы {
        программа = программа.заменить(г[1], как_объявления(г[1]))
    }
    вернуть Текст(программа.заменить(среда, среда_для_программы(среда, видимые)), [])
}

/// Группы, библиотеки которых есть в коде программы ровно по одному разу.
общий функ группы_программы(код_c: стр, среда: стр, группы: [[стр]]) -> [стр] {
    перем итог: [стр] = []
    если не_для(код_c) или код_c.разбить(среда).длина != 2 { вернуть итог }
    для г в группы {
        если г[1] != "" и код_c.разбить(г[1]).длина == 2 { итог.добавить(г[0]) }
    }
    вернуть итог
}
