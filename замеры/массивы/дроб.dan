// сумма и скалярное произведение 10 000 000 чисел, 20 проходов
пусть н = 10_000_000
перем а = массив(дроб, н)
перем б = массив(дроб, н)
для к в 0..н - 1 {
    а[к] = дроб(к % 7) * 0.5
    б[к] = дроб(к % 5) * 0.25
}
перем сумма = 0.0
перем скаляр = 0.0
для п в 1..20 {
    для к в 0..н - 1 {
        сумма += а[к]
        скаляр += а[к] * б[к]
    }
}
вывод(сумма)
вывод(скаляр)
