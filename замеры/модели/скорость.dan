// Замер скорости порождения текста модулем «модели»: токенов в секунду без обработки запроса.
//     dan запустить замеры/модели/скорость.dan модель.gguf [токенов]
// Число потоков - DAN_POTOKI (как у пула Дана).

подключить "модели"

функ замер(путь: стр, токенов: цел) -> ! {
    пусть м = модели.загрузить_с_настройками(путь, модели.Настройки(контекст = 512))!
    пусть выборка = модели.Выборка(температура = 0.0, максимум_токенов = токенов)
    // прогрев: первый ответ размещает буферы llama.cpp
    м.ответ("привет", модели.Выборка(температура = 0.0, максимум_токенов = 4))!
    пусть поток = м.начать("привет мир", выборка)!
    пусть начало = метка_времени()
    перем частей = 0
    пока истина {
        пусть часть = поток.следующая()!
        если часть == "" { прервать }
        частей += 1
    }
    пусть время = метка_времени() - начало
    // первый токен берётся из расчёта запроса, остальные токенов - 1 требуют расчёта модели
    вывод("токенов_в_секунду=" + стр(дроб(токенов - 1) / время))
    вывод("частей=" + стр(частей))
    м.освободить()
}

пусть арг = аргументы()
перем токенов = 128
если арг.длина > 1 { токенов = разобрать_цел(арг[1]) иначе 128 }
если ошибка о = замер(арг[0], токенов) {
    вывод_ошибки(о)
    завершить(1)
}
