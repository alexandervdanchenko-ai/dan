// Недоумение (perplexity) модели на тексте движком «нейро» - для сверки с llama-perplexity
// (замеры/нейро/недоумение.py). Запуск: недоумение модель.gguf текст.txt окно окон [кэш32]
//   токенов: ...      - сколько токенов оценено
//   окон: ...         - сколько окон пройдено
//   по_окнам: ...     - недоумение после каждого окна (как «[1]...,[2]...» llama-perplexity)
//   недоумение: ...   - итог и погрешность (как «Final estimate: PPL = ... +/- ...»)
//   секунд: ...       - время подсчёта (без загрузки модели)
// Контекст модели - ровно окно; кэш по умолчанию в половинной точности (как f16 у llama-perplexity),
// «кэш32» - в дроб32. Потоки - DAN_POTOKI.

подключить "нейро"

функ главная() -> ! {
    пусть арг = аргументы()
    если арг.длина < 4 {
        вернуть ошибка("запуск: недоумение модель.gguf текст.txt окно окон [кэш32]")
    }
    пусть окно = разобрать_цел(арг[2]) иначе 512
    пусть окон = разобрать_цел(арг[3]) иначе 0
    перем текст_ = прочитать(арг[1])
    // llama-perplexity (ключ -f) отбрасывает один перевод строки в конце файла
    если текст_.оканчивается("\n") { текст_ = текст_[0..текст_.длина - 2] }
    пусть м = нейро.загрузить_с_настройками(арг[0], нейро.Настройки(контекст = окно, точный_кэш = арг.содержит("кэш32")))!
    пусть начало = метка_времени()
    пусть н = м.недоумение(текст_, окно, окон)!
    вывод("токенов: " + стр(н.токенов))
    вывод("окон: " + стр(н.окон))
    вывод("по_окнам: " + н.по_окнам.преобразовать(функ(х: дроб) = стр(округлить(х, 4))).соединить(" "))
    вывод("недоумение: " + стр(н.значение) + " " + стр(н.погрешность))
    вывод("секунд: " + стр(округлить(метка_времени() - начало, 1)))
}

если ошибка о = главная() {
    вывод_ошибки("ошибка: " + о)
    завершить(1)
}
