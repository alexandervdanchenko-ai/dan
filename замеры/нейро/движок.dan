// Движок «нейро» для сверки с llama.cpp (замеры/нейро/сверка.py): тот же вывод, что у сверка_llama.c.
// Запуск: движок модель.gguf запрос.txt N [точно] [кэш32] [по_одному]
//   токены: ...     - разбиение запроса (служебные части разбираются, начало - по модели)
//   логиты: ...     - логиты после всего запроса
//   запрос: ...     - токенов запроса в секунду (подать_все: пакетами; «по_одному» - по одному токену)
//   ответ: ...      - N токенов жадной выборки
//   текст: ...      - тот же ответ текстом
//   скорость: ...   - токенов в секунду порождения (без обработки запроса)
//   загрузка: ...   - секунд на загрузку модели
// «точно» - веса в видах без своих ядер разворачиваются в дроб32, а не в Q8_0; «кэш32» - кэш ключей и
// значений в дроб32 (по умолчанию - в половинной точности).
// N = 0 - только токены (для сверки разбиения многих строк: движок запрос.txt ... по одному файлу).

подключить "нейро"

функ числа(т: [цел]) -> стр {
    вернуть т.преобразовать(функ(х: цел) = стр(х)).соединить(" ")
}

функ главная() -> ! {
    пусть арг = аргументы()
    пусть н = цел(арг[2])
    пусть начало = метка_времени()
    если н == 0 {
        // только словарь: файлы запросов с третьего аргумента
        пусть ф = нейро.открыть_gguf(арг[0])!
        пусть сл = нейро.словарь_из(ф)!
        для к в 3..арг.длина - 1 {
            вывод("токены: " + числа(сл.разбить_текст(прочитать(арг[к]), истина, истина)))
        }
        вернуть
    }
    пусть м = нейро.загрузить_с_настройками(арг[0], нейро.Настройки(контекст = 1024, точные_веса = арг.содержит("точно"),
        точный_кэш = арг.содержит("кэш32")))!
    вывод("загрузка: " + стр(округлить(метка_времени() - начало, 2)))
    пусть т = м.разбить(прочитать(арг[1]))
    вывод("токены: " + числа(т))
    перем с = м.сеанс()
    пусть начало_запроса = метка_времени()
    если арг.содержит("по_одному") {
        для ид в т {
            с = м.подать(с, ид)
            с.проверить()!
        }
    } иначе {
        с = м.подать_все(с, т)
        с.проверить()!
    }
    вывод("запрос: " + стр(округлить(дроб(т.длина) / (метка_времени() - начало_запроса), 3)))
    перем части: [стр] = []
    для к в 0..с.логиты.длина - 1 { части.добавить(стр(с.логиты[к])) }
    вывод("логиты: " + части.соединить(" "))
    перем ответ: [цел] = []
    пусть старт = метка_времени()
    для к в 1..н {
        пусть лучший = нейро.наибольший(с.логиты)
        ответ.добавить(лучший)
        если м.словарь.конечные.содержит(лучший) или к == н { прервать }
        с = м.подать(с, лучший)
        с.проверить()!
    }
    пусть секунд = метка_времени() - старт
    вывод("ответ: " + числа(ответ))
    вывод("текст: " + м.текст(ответ).заменить("\n", " "))
    перем скорость = 0.0
    если ответ.длина > 1 { скорость = дроб(ответ.длина - 1) / секунд }
    вывод("скорость: " + стр(округлить(скорость, 3)))
}

если ошибка о = главная() {
    вывод_ошибки("ошибка: " + о)
    завершить(1)
}
