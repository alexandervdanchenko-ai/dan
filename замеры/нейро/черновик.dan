// Спекулятивная генерация движка «нейро» на настоящих моделях (замеры/нейро/черновик.py).
// Запуск: черновик большая.gguf черновик.gguf запрос.txt N к1,к2,...
//   загрузка: ...              - секунд на загрузку обеих моделей
//   обычный: скорость          - токенов в секунду порождения без черновика (м.ответ_по_частям, жадно)
//   к=К: скорость предложено принято проверок совпал - с черновиком, К предложений (жадно); совпал -
//                                текст побайтно тот же, что без черновика
//   подстройка: ...            - то же с подстройкой числа предложений (от 4, до 16)
//   температура: скорость доля - с черновиком (К = 4), температура 0,7, верх_к 40, верх_п 0,95, зерно 1
//   текст: ...                 - ответ без черновика
// Скорость - токенов после первого в секунду от первой отданной части до конца ответа (чтение
// запроса не считается, догон запроса черновиком считается).

подключить "нейро"

тип Замер {
    текст: стр
    скорость: дроб
    токенов: цел
    предложено: цел
    принято: цел
    проверок: цел
}

функ замер(м: нейро.Модель, ч: нейро.Модель, запрос: стр, выб: нейро.Выборка, к: цел, подстраивать: лог) -> Замер! {
    пусть кан: канал<дроб> = канал(1_000_000)
    пусть получатель = функ(т: стр) -> лог {
        кан.отправить(метка_времени())
        вернуть истина
    }
    перем текст = ""
    перем токенов = 0
    перем предложено = 0
    перем принято = 0
    перем проверок = 0
    если к == 0 {
        текст = м.ответ_по_частям(запрос, выб, получатель)!
    } иначе {
        пусть итог = м.ответ_с_черновиком_по_частям(ч, запрос, выб,
            нейро.Черновик(токенов = к, подстраивать = подстраивать, наибольшее = 16), получатель)!
        текст = итог.текст
        токенов = итог.токенов
        предложено = итог.предложено
        принято = итог.принято
        проверок = итог.проверок
    }
    пусть конец = метка_времени()
    кан.закрыть()
    перем первая = -1.0
    для м_ в кан {
        если первая < 0.0 { первая = м_ }
    }
    вернуть Замер(текст, конец - первая, токенов, предложено, принято, проверок)
}

функ строкой(т: стр) -> стр {
    вернуть т.заменить("\n", " ")
}

функ главная() -> ! {
    пусть арг = аргументы()
    пусть начало = метка_времени()
    пусть м = нейро.загрузить_с_настройками(арг[0], нейро.Настройки(контекст = 1024))!
    пусть ч = нейро.загрузить_с_настройками(арг[1], нейро.Настройки(контекст = 1024))!
    м.проверить_черновик(ч)!
    вывод("загрузка: " + стр(округлить(метка_времени() - начало, 2)))
    пусть запрос = прочитать(арг[2])
    пусть н = цел(арг[3])
    пусть жадно = нейро.Выборка(температура = 0.0, максимум_токенов = н)
    перем к_: [цел] = []
    для т в арг[4].разбить(",") { к_.добавить(цел(т)) }
    // без черновика (дважды: лучшая скорость); число токенов - из ответа с черновиком (тот же текст)
    пусть о1 = замер(м, ч, запрос, жадно, 0, ложь)!
    пусть о2 = замер(м, ч, запрос, жадно, 0, ложь)!
    перем токенов = 0
    перем строки: [стр] = []
    для к в к_ {
        пусть з = замер(м, ч, запрос, жадно, к, ложь)!
        токенов = з.токенов
        строки.добавить("к=" + стр(к) + ": " + стр(округлить(дроб(з.токенов - 1) / з.скорость, 3)) + " " + стр(з.предложено) + " " +
            стр(з.принято) + " " + стр(з.проверок) + " " + стр(з.текст == о1.текст))
    }
    вывод("обычный: " + стр(округлить(дроб(токенов - 1) / мин(о1.скорость, о2.скорость), 3)))
    для с в строки { вывод(с) }
    пусть п = замер(м, ч, запрос, жадно, 4, истина)!
    вывод("подстройка: " + стр(округлить(дроб(п.токенов - 1) / п.скорость, 3)) + " " + стр(п.предложено) + " " + стр(п.принято) + " " +
        стр(п.проверок) + " " + стр(п.текст == о1.текст))
    пусть т = замер(м, ч, запрос, нейро.Выборка(температура = 0.7, зерно = 1, максимум_токенов = н), 4, ложь)!
    перем доля = 0.0
    если т.предложено > 0 { доля = дроб(т.принято) / дроб(т.предложено) }
    вывод("температура: " + стр(округлить(дроб(т.токенов - 1) / т.скорость, 3)) + " " + стр(округлить(доля, 3)))
    вывод("текст: " + строкой(о1.текст))
}

если ошибка о = главная() {
    вывод_ошибки("ошибка: " + о)
    завершить(1)
}
