// Замер сервера HTTP (замеры/вебсервер/замер.sh): ответ на GET с параметром, 8 работников, 20000 соединений.
подключить "вебсервер"
функ ответить(з: вебсервер.Запрос) -> вебсервер.Ответ {
    вернуть вебсервер.текст("Привет, " + (з.параметр("имя") иначе "мир"))
}
перем с = вебсервер.слушать("127.0.0.1", 0)!
с.работников = 8
с.предел_запросов = 20000
вывод(с.порт)
с.обслуживать(ответить)
