// Эталон скорости чтения памяти для главной цели (ROADMAP.md): буфер размером
// с веса модели читается целиком так же, как движок читает веса, - матрицей на
// вектор (`матвек`) на всех потоках пула ядер, массив выровнен по 64 байтам.
// Матвек считается в блоке `приближённо` (FMA, свой порядок сложения), как
// движку и нужно: так счёт не отстаёт от памяти (точный порядок на ARM
// упирается в счёт, а не в чтение - замеры/результаты.md).
// Запуск: dan запустить замеры/память/память.dan [ГБ буфера] [ГБ весов] [проходов] [файл] [точно]
//   ГБ буфера - объём читаемой памяти (по умолчанию 4; меньше, если памяти мало);
//   ГБ весов - объём весов модели для предела слов в секунду (по умолчанию 4,1: 7B Q4_K_M);
//   проходов - сколько раз прочитать буфер (по умолчанию 9, берётся медиана);
//   файл - если задан, буфер не выделяется, а отображается из файла, как веса GGUF
//          (читаются целые строки, не больше «ГБ буфера»); "-" - без файла;
//   точно - считать матвек в порядке сложения языка, без блока `приближённо`.
// Число потоков - DAN_POTOKI (по умолчанию все ядра). ГБ - миллиард байтов.

/// Читает все веса один раз: матрица (строки по длине `х`) на вектор.
/// Возвращает последнее число результата, чтобы чтение нельзя было выбросить.
функ прочитать(веса: массив<дроб32>, х: массив<дроб32>, точно: лог) -> дроб {
    если точно {
        пусть у = матвек(веса, х)
        вернуть у[у.длина - 1]
    }
    перем последнее = 0.0
    приближённо {
        пусть у = матвек(веса, х)
        последнее = у[у.длина - 1]
    }
    вернуть последнее
}

функ число_аргумента(арг: [стр], н: цел, умолчание: дроб) -> дроб {
    если арг.длина <= н { вернуть умолчание }
    вернуть разобрать_дроб(арг[н]) иначе умолчание
}

пусть арг = аргументы()
пусть гб = число_аргумента(арг, 0, 4.0)
пусть гб_весов = число_аргумента(арг, 1, 4.1)
пусть проходов = цел(число_аргумента(арг, 2, 9.0))
// строка матрицы - 4096 чисел (16 КБ), как строка весов модели 7B
пусть столбцов = 4096
перем строк = частное(цел(гб * 1e9), столбцов * 4)
перем веса = массив(дроб32, 0)
пусть из_файла = арг.длина > 3 и арг[3] != "-"
пусть точно = арг.длина > 4 и арг[4] == "точно"
если из_файла {
    // весь файл отображается в память; читается не больше «ГБ буфера» целыми строками
    пусть файл = массив_из_файла(байт, арг[3])!
    строк = мин(строк, частное(файл.длина, столбцов * 4))
    если строк > 0 {
        веса = массив_из_файла(дроб32, арг[3], 0, строк * столбцов)!
    }
}
если строк < 1 или проходов < 1 {
    вывод_ошибки("нужны буфер не меньше 16 КБ и хотя бы один проход")
    завершить(2)
}
если не из_файла {
    // заполнение касается каждой страницы: память выделена до замера
    веса = массив(дроб32, строк * столбцов, 0.001)
}
пусть х = массив(дроб32, столбцов, 1.0)
пусть байтов = дроб(веса.длина) * 4.0
вывод("буфер: " + стр(округлить(байтов / 1e9, 2)) + " ГБ, " + стр(строк) + " строк по " + стр(столбцов) + " чисел дроб32")
перем счёт = "приближённо (FMA)"
если точно { счёт = "точно" }
вывод("ядра: " + ядра_процессора() + ", потоков: " + стр(число_потоков()) + ", счёт: " + счёт)
// первый проход прогревает: в отображённом файле подгружает страницы
перем контроль = прочитать(веса, х, точно)
перем скорости: [дроб] = []
для п в 1..проходов {
    // на малом буфере проход бывает короче шага часов: читаем, пока время не сдвинется
    пусть начало = метка_времени()
    перем раз = 0
    перем время = 0.0
    пока время <= 0.0 {
        контроль += прочитать(веса, х, точно)
        раз += 1
        время = метка_времени() - начало
    }
    скорости.добавить(байтов * дроб(раз) / время / 1e9)
}
пусть скорость = медиана(скорости)
вывод("проходов: " + стр(проходов) + ", ГБ/с: наименьшая " + стр(округлить(мин(скорости), 1)) + ", медиана " + стр(округлить(скорость, 1)) + ", наибольшая " + стр(округлить(макс(скорости), 1)))
вывод("скорость чтения: " + стр(округлить(скорость, 1)) + " ГБ/с")
вывод("предел для " + стр(гб_весов) + " ГБ весов: " + стр(округлить(скорость / гб_весов, 1)) + " слов/с")
если контроль != контроль {
    вывод("контроль: не число")
}
