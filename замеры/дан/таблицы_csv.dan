// Таблицы CSV: записать таблицу из 300 000 строк в текст CSV, разобрать обратно и сложить столбец.
подключить "csv"
перем строки: [[стр]] = [["Номер", "Клиент", "Сумма"]]
для к в 1..300000 {
    строки.добавить([стр(к), "Клиент \"" + стр(к % 100) + "\", Москва", стр(к * 37 % 1000)])
}
пусть текст = csv.записать(строки)
пусть таблица = csv.разобрать(текст) иначе []
перем итог = 0
для н в 1..таблица.длина - 1 {
    итог += цел(таблица[н][2])
}
вывод(таблица.длина)
вывод(итог)
