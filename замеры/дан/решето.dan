// Списки и циклы: количество простых чисел до 30 000 000 решетом Эратосфена.
пусть предел = 30000000
перем решето: [лог] = []
для к в 0..предел { решето.добавить(истина) }
перем н = 2
пока н * н <= предел {
    если решето[н] {
        перем м = н * н
        пока м <= предел {
            решето[м] = ложь
            м += н
        }
    }
    н += 1
}
перем счёт = 0
для к в 2..предел {
    если решето[к] { счёт += 1 }
}
вывод(счёт)
