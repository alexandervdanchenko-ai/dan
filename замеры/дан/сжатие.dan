// Сжатие: сжать около 20 МБ текста в формат gzip и распаковать обратно.
перем части: [стр] = []
для к в 1..400000 {
    части.добавить("Строка номер " + стр(к) + ": договор, акт, счёт\n")
}
пусть текст = байты(части.соединить(""))
пусть обратно = распаковать(сжать_gzip(текст))
вывод(обратно == текст)
вывод(обратно.длина)
