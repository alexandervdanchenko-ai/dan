// Записи JSON в свои типы: записать 200 000 записей своего типа в текст JSON, разобрать его в тот же тип и сложить суммы.
подключить "json"
тип Запись {
    номер: цел
    имя: стр
    сумма: цел
}
перем записи: [Запись] = []
для к в 1..200000 {
    записи.добавить(Запись(к, "Клиент " + стр(к), к * 37 % 1000))
}
пусть текст = json.записать(записи)
пусть данные = json.разобрать_в(текст, [Запись]) иначе []
перем итог = 0
для з в данные {
    итог += з.сумма
}
вывод(текст.длина)
вывод(итог)
