// Сортировка: упорядочить 5 000 000 псевдослучайных целых чисел встроенной функцией.
перем х = 1
перем числа: [цел] = []
для к в 1..5000000 {
    х = (х * 1103515245 + 12345) % 2147483648
    числа.добавить(х)
}
пусть упорядоченные = упорядочить(числа)
вывод(упорядоченные[0])
вывод(упорядоченные[2500000])
вывод(упорядоченные[4999999])
