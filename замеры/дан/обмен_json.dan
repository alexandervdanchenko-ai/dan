// Обмен данными JSON: записать 200 000 записей в текст JSON, разобрать его обратно и сложить суммы.
подключить "json"
перем записи: [json.Значение] = []
для к в 1..200000 {
    записи.добавить(json.Объект({"номер": json.Целое(к), "имя": json.Строка("Клиент " + стр(к)),
        "сумма": json.Целое(к * 37 % 1000)}))
}
пусть текст = json.записать(json.Массив(записи))
пусть данные = json.разобрать(текст) иначе json.Пусто
перем итог = 0
для з в данные.элементы() {
    итог += з.поле("сумма").как_цел() иначе 0
}
вывод(текст.длина)
вывод(итог)
