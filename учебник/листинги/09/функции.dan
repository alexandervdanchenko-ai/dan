функ площадь_комнаты(длина: дроб, ширина: дроб) -> дроб {
    вернуть длина * ширина
}

функ стоимость_обоев(площадь: дроб, цена_метра: цел) -> дроб {
    вернуть площадь * цена_метра
}

пусть п = площадь_комнаты(4.5, 3.2)
вывод("Площадь: " + стр(п) + " м²")
вывод("Обои: " + стр(стоимость_обоев(п, 450)) + " руб.")
