записать("покупки.txt", "хлеб\nмолоко\nсыр\n")
дописать("покупки.txt", "яблоки\n")
пусть строки = прочитать("покупки.txt").обрезать().разбить("\n")
для к в 0..строки.длина - 1 {
    вывод(стр(к + 1) + ". " + строки[к])
}
вывод(существует("покупки.txt"))
удалить_файл("покупки.txt")
вывод(существует("покупки.txt"))
