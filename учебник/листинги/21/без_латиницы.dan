// Программа набрана целиком в русской раскладке
функ средний_балл(оценки: (цел)) дроб:
    вернуть округлить(дроб(сумма(оценки)) / оценки.длина, 2)

перем журнал = ("Иванов" = (5, 4, 5), "Петрова" = (3, 4, 4))
журнал№"Сидоров" = (5, 5, 4)
для фамилия в журнал:
    пусть балл = средний_балл(журнал№фамилия)
    если балл не меньше 4.5:
        вывод(фамилия + ": " + стр(балл) + ", отлично")
    иначе если балл больше 3.5:
        вывод(фамилия + ": " + стр(балл) + ", хорошо")
    иначе:
        вывод(фамилия + ": " + стр(балл))
