подключить "word"

пусть блоки = [
    word.заголовок("Справка", 1),
    word.абзац("Дана Иванову Ивану Ивановичу в том, что он изучает язык программирования Дан."),
    word.таблица([["Глава", "Тема"], ["1", "Первая программа"], ["17", "Документы"]]),
    word.по_центру("26.10.2026")
]
если ошибка о = word.создать("справка.docx", блоки) {
    вывод("Не удалось создать документ: " + о)
}
пусть д = word.открыть("справка.docx")!
вывод(д.абзацы().длина)
вывод(д.таблицы()[0][1])
удалить_файл("справка.docx")
