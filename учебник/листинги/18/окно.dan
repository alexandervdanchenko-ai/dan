подключить "окна"

пусть окно = окна.создать("Счётчик", 300, 160)!
пусть надпись = окно.надпись("Нажато: 0", 20, 20, 260, 30)
пусть кнопка = окно.кнопка("Нажми меня", 20, 70, 150, 40)
перем нажатий = 0
пока пусть событие = окно.ждать() {
    выбор событие {
        окна.Нажатие(элемент) {
            если элемент == кнопка {
                нажатий += 1
                надпись.задать_текст("Нажато: " + стр(нажатий))
            }
        }
        иначе { }
    }
}
