функ возраст(текст: стр) -> цел! {
    пусть лет = разобрать_цел(текст)!
    если лет < 0 или лет > 150 {
        вернуть ошибка("возраст должен быть от 0 до 150, а не " + стр(лет))
    }
    вернуть лет
}

для т в ["35", "сорок", "-2"] {
    если пусть лет = возраст(т) {
        вывод("Возраст: " + стр(лет))
    } иначе ошибка о {
        вывод("Ошибка: " + о)
    }
}
вывод(возраст("abc") иначе 0)
