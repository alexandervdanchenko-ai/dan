// Учёт расходов: читаем таблицу CSV, считаем итоги по статьям и сохраняем отчёт
подключить "csv"

пусть данные = ("Дата;Статья;Сумма\n01.10.2026;Продукты;2350\n03.10.2026;Транспорт;600\n" +
    "05.10.2026;Продукты;1870\n09.10.2026;Связь;450\n12.10.2026;Транспорт;1200\n")
записать("расходы.csv", данные)

пусть строки = csv.разобрать(прочитать("расходы.csv"))!
перем по_статьям: {стр: цел} = {}
перем всего = 0
для строка в строки[1..строки.длина - 1] {
    пусть сумма = разобрать_цел(строка[2]) иначе 0
    по_статьям[строка[1]] = по_статьям.получить(строка[1], 0) + сумма
    всего += сумма
}

перем отчёт = [["Статья", "Сумма", "Доля, %"]]
для статья в по_статьям {
    пусть доля = округлить(сколько_процентов(по_статьям[статья], всего), 1)
    отчёт.добавить([статья, стр(по_статьям[статья]), стр(доля)])
    вывод(статья + ": " + сумма_цифрами(рац(по_статьям[статья], 1)) + " руб. (" + стр(доля) + "%)")
}
вывод("Всего: " + сумма_цифрами(рац(всего, 1)) + " руб.")
записать("отчёт.csv", csv.записать_для_excel(отчёт))
удалить_файл("расходы.csv")
удалить_файл("отчёт.csv")
