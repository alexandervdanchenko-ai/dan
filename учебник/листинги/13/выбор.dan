тип Платёж {
    Наличные(сумма: цел)
    Карта(сумма: цел, последние_цифры: стр)
    Бесплатно
}

функ описание(п: Платёж) -> стр {
    выбор п {
        Наличные(с) { вернуть "наличными " + стр(с) + " руб." }
        Карта(с, цифры) { вернуть "картой *" + цифры + " " + стр(с) + " руб." }
        Бесплатно { вернуть "без оплаты" }
    }
}

для п в [Наличные(500), Карта(1200, "4417"), Бесплатно] {
    вывод(описание(п))
}
пусть оценка = 4
выбор оценка {
    5 { вывод("отлично") }
    4 { вывод("хорошо") }
    иначе { вывод("можно лучше") }
}
