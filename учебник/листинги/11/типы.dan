тип Сотрудник {
    фамилия: стр
    должность: стр
    оклад: цел
    стаж_лет: цел = 0
}

функ Сотрудник.надбавка() -> цел {
    если сам.стаж_лет >= 5 { вернуть частное(сам.оклад, 10) }
    вернуть 0
}

перем иванов = Сотрудник("Иванов", "инженер", 80000, стаж_лет = 7)
пусть петрова = Сотрудник(фамилия = "Петрова", должность = "бухгалтер", оклад = 70000)
вывод(петрова)
вывод(иванов.фамилия + ": надбавка " + стр(иванов.надбавка()))
иванов.оклад += 5000
вывод(иванов.оклад)
