// Игра «Угадай число»: компьютер загадывает число от 1 до 100
пусть загадано = случайное(1, 100)
вывод("Я загадал число от 1 до 100. Угадайте!")
перем попыток = 0
пока истина {
    пусть ответ = ввод("Ваш вариант: ")
    если ответ == "" {
        вывод("Игра прервана.")
        прервать
    }
    пусть число = разобрать_цел(ответ) иначе 0
    попыток += 1
    если число < загадано {
        вывод("Больше!")
    } иначе если число > загадано {
        вывод("Меньше!")
    } иначе {
        вывод("Угадали за " + стр(попыток) + " " + склонение(попыток, "попытку", "попытки", "попыток") + "!")
        прервать
    }
}
