пусть фраза = "Мама мыла раму"
вывод(фраза.длина)
вывод(фраза.прописные())
вывод(фраза.заменить("раму", "окно"))
вывод(фраза.разбить())
вывод(фраза[0..3])
вывод(фраза.содержит("мыла"))
перем гласных = 0
для буква в фраза.строчные() {
    если "аеёиоуыэюя".содержит(буква) { гласных += 1 }
}
вывод("Гласных: " + стр(гласных))
