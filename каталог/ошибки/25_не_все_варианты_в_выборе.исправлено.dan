// Исправлено: разобран и вариант «Отклонено».
тип Статус {
    Подано
    Принято
    Отклонено(причина: стр)
}

функ описать(с: Статус) -> стр {
    выбор с {
        Подано { вернуть "подано" }
        Принято { вернуть "принято к производству" }
        Отклонено(п) { вернуть "отклонено: " + п }
    }
}
вывод(описать(Подано))
вывод(описать(Отклонено("не оплачена пошлина")))
