// Задача: читать суммы с клавиатуры, пропуская неверно введённые строки.
перем итого = 0.0
перем пропущено = 0
перем строка = ввод()
пока строка != "" {
    если пусть с = разобрать_дроб(строка) {
        итого += с
    } иначе {
        пропущено += 1
    }
    строка = ввод()
}
вывод(итого)
вывод(пропущено)
