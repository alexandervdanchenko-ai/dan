// Задача: создать документ Word с таблицей, заполнить в нём поля и прочитать результат.
подключить "word"

если ошибка о = word.создать("накладная.docx", [
    word.заголовок("Накладная № {{номер}}", 1),
    word.абзац("Получатель: {{получатель}}"),
    word.таблица([["Товар", "Количество"], ["Книга", "2"], ["Тетрадь", "10"]])
]) {
    вывод(о)
}

пусть не_заполнено = word.заполнить("накладная.docx", "накладная_17.docx", {"номер": "17", "получатель": "Библиотека № 5"}) иначе ["ошибка"]
вывод("Не заполнено полей: " + стр(не_заполнено.длина))

если пусть д = word.открыть("накладная_17.docx") {
    вывод(д.текст())
    вывод("Строк в таблице: " + стр(д.таблицы()[0].длина))
} иначе ошибка о {
    вывод(о)
}
