// Даты: арифметика дней, месяцы, свои нерабочие дни и сравнение.
пусть начало = дата("26.10.2026")
// срок - месяц со дня начала
пусть последний_день = добавить_месяцы(начало, 1)
вывод("начало " + стр(начало) + ", срок до " + стр(последний_день))
вывод("дней до срока: " + стр(последний_день - начало))
// пять рабочих дней: выходные и свои нерабочие дни пропускаются
пусть нерабочие: {дата: лог} = {дата("31.12.2026"): истина, дата("01.01.2027"): истина}
перем д = дата(2026, 12, 30)
перем осталось = 5
пока осталось > 0 {
    д += 1
    если не выходной(д) и не нерабочие.получить(д, ложь) { осталось -= 1 }
}
вывод("5 рабочих дней с 30.12.2026: " + стр(д))
пусть дни = ["пн", "вт", "ср", "чт", "пт", "сб", "вс"]
вывод("26.10.2026 - " + дни[начало.день_недели - 1] + ", день года " + стр(начало.день_года))
вывод(добавить_месяцы(дата(2026, 1, 31), 1))
вывод(дата(2024, 2, 28) + 1 < дата("2024-03-01"))
перем день = дата(2026, 5, 1)
перем выходных = 0
пока день.месяц == 5 {
    если выходной(день) { выходных += 1 }
    день += 1
}
вывод("суббот и воскресений в мае: " + стр(выходных))
вывод(разобрать_дату("31.06.2026") иначе дата(1, 1, 1))
