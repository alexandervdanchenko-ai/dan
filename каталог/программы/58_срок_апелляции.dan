// Задача: последний день срока апелляционной жалобы - месяц со дня решения в окончательной форме
// (ч. 2 ст. 321 ГПК РФ). Срок, исчисляемый месяцами, истекает в соответствующее число последнего
// месяца (ч. 3 ст. 107 ГПК РФ), а если оно приходится на нерабочий день, - в следующий рабочий день
// (ч. 2 ст. 108 ГПК РФ). Переносы выходных постановлениями Правительства здесь не учитываются.
функ окончание_срока(решение: дата) -> дата {
    перем д = добавить_месяцы(решение, 1)
    пока не рабочий_день(д) {
        д += 1
    }
    вернуть д
}

для решение в [дата("28.09.2026"), дата("03.09.2026"), дата("31.08.2026")] {
    пусть конец = окончание_срока(решение)
    вывод(стр(решение) + " -> " + стр(конец) + " (день недели " + стр(конец.день_недели) + ")")
}
