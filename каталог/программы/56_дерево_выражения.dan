// Задача: вычислить арифметическое выражение, записанное деревом из перечисления.
тип Выражение {
    Число(значение: цел)
    Сумма(левое: Выражение, правое: Выражение)
    Произведение(левое: Выражение, правое: Выражение)
}

функ вычислить(в_: Выражение) -> цел {
    выбор в_ {
        Число(з) { вернуть з }
        Сумма(л, п) { вернуть вычислить(л) + вычислить(п) }
        Произведение(л, п) { вернуть вычислить(л) * вычислить(п) }
    }
}

// (2 + 3) × 4
пусть выражение = Произведение(Сумма(Число(2), Число(3)), Число(4))
вывод(вычислить(выражение))
