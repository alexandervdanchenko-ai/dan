// JSON: разбор текста, доступ к полям, создание и запись значений.
подключить "json"

пусть текст = "{\"дело\": \"А40-12345/2026\", \"сумма\": 150000.50, \"истцы\": [\"Иванов\", \"Петров\"], \"суд\": {\"город\": \"Москва\"}}"
если пусть дело = json.разобрать(текст) {
    вывод(дело.поле("дело").как_стр() иначе "")
    вывод(дело.поле("сумма").как_дроб() иначе 0.0)
    вывод("истцов: " + стр(дело.поле("истцы").длина()))
    вывод(дело.поле("суд").поле("город").как_стр() иначе "не указан")
    вывод(дело.поле("суд").поле("судья").как_стр() иначе "судья не указан")
} иначе ошибка о {
    вывод(о)
}

пусть ответ = json.Объект({
    "номер": json.Целое(17),
    "стороны": json.Массив([json.Строка("Иванов И.И."), json.Строка("ООО \"Ромашка\"")]),
    "оплачено": json.Логическое(ложь),
    "примечание": json.Пусто
})
вывод(json.записать(ответ))
вывод(json.записать_красиво(ответ))

если ошибка о = json.разобрать("{\"а\": [1, 2,]}") { вывод(о) }
