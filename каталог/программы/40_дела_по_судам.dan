// Задача: сгруппировать номера дел по судам (словарь со списками).
тип Дело {
    номер: стр
    суд: стр
}

пусть дела = [Дело("2-101/2026", "Тверской"), Дело("2-202/2026", "Таганский"),
              Дело("2-303/2026", "Тверской")]
перем по_судам: {стр: [стр]} = {}
для д в дела {
    если не по_судам.содержит(д.суд) {
        по_судам[д.суд] = []
    }
    по_судам[д.суд].добавить(д.номер)
}
вывод(по_судам)
для суд в по_судам {
    вывод(суд + ": " + стр(по_судам[суд].длина))
}
