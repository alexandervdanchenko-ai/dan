// Целые числа любой длины: точные вычисления без переполнения.
функ факториал_длинный(н: цел) -> длинное {
    перем р = длинное(1)
    для к в 2..н { р = р * к }
    вернуть р
}

пусть ф = факториал_длинный(50)
вывод("50! = " + стр(ф))
вывод("цифр в 50!: " + стр(стр(ф).длина))
вывод("2^128 = " + стр(длинное(2) ^ 128))
вывод("остаток 50! от деления на 1000003: " + стр(ф % 1000003))
