// Задача: вызвать функцию с аргументами по именам в любом порядке.
функ стоимость(цена: цел, количество: цел, скидка_процентов: цел) -> рац {
    вернуть цена × количество − процент(цена × количество, скидка_процентов)
}

вывод(стоимость(1200, 3, 10))
вывод(стоимость(скидка_процентов = 10, цена = 1200, количество = 3))
