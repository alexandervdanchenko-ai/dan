// Задача: превратить «Фамилия Имя Отчество» в «Фамилия И.О.».
функ с_инициалами(фио: стр) -> стр {
    пусть части = фио.разбить()
    если части.длина < 3 { вернуть фио }
    вернуть части[0] + " " + части[1][0] + "." + части[2][0] + "."
}

вывод(с_инициалами("Иванов Иван Иванович"))
вывод(с_инициалами("Петрова Анна Сергеевна"))
вывод(с_инициалами("Сидоров"))
