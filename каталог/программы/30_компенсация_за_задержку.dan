// Задача: компенсация за задержку заработной платы по ст. 236 ТК РФ:
// сумма × 1/150 ключевой ставки × число дней задержки. Ставка в примере условная (21%).
функ компенсация(долг: цел, ставка_процентов: цел, дней: цел) -> рац {
    вернуть рац(долг) × рац(ставка_процентов, 100) / 150 × дней
}

пусть итог = компенсация(долг = 100000, ставка_процентов = 21, дней = 30)
вывод(итог)
вывод(округлить(дроб(компенсация(87500, 21, 45)), 2))
