// Задача: найти наибольший элемент списка и его номер.
функ номер_наибольшего(с: [дроб]) -> цел {
    перем лучший = 0
    для к в 1..с.длина − 1 {
        если с[к] > с[лучший] { лучший = к }
    }
    вернуть лучший
}

пусть температуры = [12.5, 17.0, 21.25, 19.0, 8.5]
пусть н = номер_наибольшего(температуры)
вывод(н)
вывод(температуры[н])
