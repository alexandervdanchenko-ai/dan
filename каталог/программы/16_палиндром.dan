// Задача: проверить, читается ли фраза одинаково в обе стороны (без пробелов и регистра).
функ палиндром(фраза: стр) -> лог {
    пусть буквы = фраза.строчные().заменить(" ", "").символы()
    вернуть буквы == буквы.обратный()
}

вывод(палиндром("А роза упала на лапу Азора"))
вывод(палиндром("Дан"))
