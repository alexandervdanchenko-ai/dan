// Задача: записать таблицу в книгу Excel и в CSV, прочитать её обратно и подсчитать итог.
подключить "excel"
подключить "csv"

пусть продажи = [["Товар", "Количество", "Дата"], ["Книга", "2", "26.10.2026"], ["Тетрадь", "10", "27.10.2026"]]
если ошибка о = excel.создать("продажи.xlsx", [excel.Лист("Октябрь", продажи)]) {
    вывод(о)
}
записать("продажи.csv", csv.записать_для_excel(продажи))

если пусть книга = excel.открыть("продажи.xlsx") {
    вывод(книга.листы())
    перем всего = 0
    для строка в книга.лист("Октябрь") иначе [] {
        вывод(строка.соединить(" | "))
        если пусть к = разобрать_цел(строка[1]) { всего += к }
    }
    вывод("Всего: " + стр(всего))
}

пусть из_csv = csv.разобрать(прочитать("продажи.csv")) иначе []
вывод("Строк в CSV: " + стр(из_csv.длина))
