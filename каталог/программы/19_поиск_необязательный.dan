// Задача: найти значение, которого может не быть, без нулевой ссылки.
тип Дело {
    номер: стр
    суд: стр
}

функ найти_дело(дела: [Дело], номер: стр) -> Дело? {
    для д в дела {
        если д.номер == номер { вернуть д }
    }
    вернуть ничего
}

пусть реестр = [Дело("2-101/2026", "Тверской"), Дело("2-202/2026", "Таганский")]
если пусть д = найти_дело(реестр, "2-202/2026") {
    вывод(д.суд)
} иначе {
    вывод("не найдено")
}
вывод(найти_дело(реестр, "2-999/2026") == ничего)
