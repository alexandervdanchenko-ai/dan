// Задача: обобщённые типы - пара значений и ответ, которого может не быть.
тип Пара<А, Б> { первое: А, второе: Б }

тип Ответ<Т> {
    Есть(значение: Т)
    Нет
}

функ делить(а: цел, б: цел) -> Ответ<рац> {
    если б == 0 { вернуть Нет }
    вернуть Есть(а / б)
}

пусть п = Пара("Иванов", 65000)
вывод(п.первое + ": " + стр(п.второе))
для делитель в [5, 3, 0] {
    выбор делить(100, делитель) {
        Есть(з) { вывод(з) }
        Нет { вывод("делить на ноль нельзя") }
    }
}
