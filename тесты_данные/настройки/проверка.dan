подключить "настройки"
подключить "json"
пусть плохие = ["а = 1\nа = 2", "[т]\nx=1\n[т]", "т = {а = 1}\n[т]", "т = {а = 1}\nт.б = 2", "[т.у]\n[т]\nу = 1", "а.б = 1\n[а]", "[[м]]\n[м]", "м = [1]\n[[м]]", "а = ", "а = 01", "а = 1__0", "а = _1", "а = \"незакрыта", "а = 'x\ny'", "а = 1 б = 2", "а = {x = 1,}", "а = [1 2]", "= 1", "а = \"\\q\"", "а = 99999999999999999999", "а = 1979-13-xx", "[а\nб = 1", "а = tru", "а = {x = 1\n}", "a.b = 1\na = 2", "[[a]]\nb=1\n[a.b]"]
для т в плохие {
    если ошибка о = настройки.toml(т) { вывод("ок: " + о) } иначе { вывод("ПРИНЯТО: " + т) }
}
пусть хорошие = ["[a]\nb.c = 1\n[a.d]\ne = 2", "[[a]]\n[a.b]\nc=1\n[[a]]\n[a.b]\nc=2", "a = \"\"\"x\"\"\"\"\"", "a = '''x'''''", "a = -0.0\nb = +inf\nc = nan", "\"\" = 1"]
для т в хорошие {
    если пусть з = настройки.toml(т) { вывод(json.записать(з)) } иначе ошибка о { вывод("ОТКАЗ: " + о) }
}
пусть плохие_yaml = ["а: 1\nа: 2", "а:\n\tб: 1", "а: &x 1", "а: *x", "а: !!str 1", "---\nа: 1\n---\nб: 2", "а: 1\n  б: 2", "- а\nб: 1", "а: [1, 2", "а: \"x", "а: {б 1}", "а: @x", "? сложный\n: 1"]
для т в плохие_yaml {
    если ошибка о = настройки.yaml(т) { вывод("ок: " + о) } иначе { вывод("ПРИНЯТО: " + т) }
}
вывод(json.записать(настройки.yaml("")!))
вывод(json.записать(настройки.yaml("просто строка")!))
вывод(json.записать(настройки.yaml("- 1\n- - 2\n  - 3\n- а: 1\n  б:\n    - x")!))
вывод(json.записать(настройки.yaml("а: |+\n  x\n\n\nб: 1")!))
вывод(json.записать(настройки.yaml("а: >\n  x\n  y\nб: |-\n  z\n")!))
пусть н = настройки.yaml("сервер:\n  порт: 8080\nсписок:\n  - имя: а\n  - имя: б")!
вывод(настройки.найти(н, "сервер.порт").как_цел() иначе -1)
вывод(настройки.найти(н, "список.1.имя").как_стр() иначе "-")
вывод(настройки.найти(н, "список.5.имя").пусто())
вывод(настройки.найти(н, "нет.такого").пусто())
если ошибка о = настройки.загрузить("нет.toml") { вывод(о) }
записать("н.ini", "x")
если ошибка о = настройки.загрузить("н.ini") { вывод(о) }
записать("н.json", "{\"а\": [1]}")
вывод(json.записать(настройки.загрузить("н.json")!))
записать("п.toml", "а = 1\nб = ")
если ошибка о = настройки.загрузить("п.toml") { вывод(о) }
