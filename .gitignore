__pycache__/
*.pyc
# Файлы, которые создаёт сборка программ на Дан
*.c
# ...кроме исходного кода среды выполнения языка
!sreda/*.c
*.exe
*.o
# Собранные программы без расширения (Linux, macOS) в папке примеров
примеры/*
!примеры/*.dan
!примеры/модули/
примеры/модули/*
!примеры/модули/*.dan
!примеры/harant/
примеры/harant/*
!примеры/harant/*.dan
!примеры/harant/*.md
!примеры/harant/*.html

# результаты работы примера данные.dan
пример_данные/

# Собранные программы каталога (появляются после «dan.py запустить»)
каталог/программы/*
!каталог/программы/*.dan
!каталог/программы/*.вывод
!каталог/программы/*.ввод
каталог/ошибки/*
!каталог/ошибки/*.dan
!каталог/ошибки/*.вывод
!каталог/ошибки/*.сообщение
!каталог/ошибки/*.ввод

# зависимости расширения редактора (ставятся командой npm install)
редактор/vscode/node_modules/

# рабочий корпус фаззинга (входы, найденные фаззером; образцы и находки хранятся)
фаззинг/корпус/
