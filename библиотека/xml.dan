// Стандартная библиотека Дана: формат XML.
//
//     подключить "xml"
//     пусть д = xml.разобрать("<книга год=\"2026\"><название>Дан</название></книга>")!
//     вывод(д.атрибут("год") иначе "")                       // 2026
//     вывод(д.значение("название"))                           // Дан
//     вывод(xml.записать(д))                                  // тот же текст
//
// Документ - дерево узлов. Узел - элемент (имя, атрибуты, дети) или текст
// (имя пустое, значение в поле «текст»). Порядок детей и атрибутов
// сохраняется, поэтому разобранный и записанный обратно документ совпадает
// с исходным с точностью до записи пустых элементов, кавычек и ссылок.

общий тип Узел {
    имя: стр
    атрибуты: {стр: стр}
    дети: [Узел]
    текст: стр = ""
}

// ---------- создание ----------

общий функ элемент(имя: стр, атрибуты: {стр: стр}, дети: [Узел]) -> Узел {
    вернуть Узел(имя, атрибуты, дети)
}

// Элемент без атрибутов, содержащий только текст: <имя>текст</имя>
общий функ элемент_с_текстом(имя: стр, с: стр) -> Узел {
    пусть пустые: {стр: стр} = {}
    вернуть Узел(имя, пустые, [текст(с)])
}

общий функ текст(с: стр) -> Узел {
    пусть пустые: {стр: стр} = {}
    пусть нет: [Узел] = []
    вернуть Узел("", пустые, нет, текст = с)
}

// ---------- доступ ----------

общий функ Узел.это_текст() -> лог {
    вернуть сам.имя == ""
}

общий функ Узел.атрибут(имя: стр) -> стр? {
    вернуть сам.атрибуты.найти(имя)
}

// Первый прямой потомок с этим именем
общий функ Узел.первый(имя: стр) -> Узел? {
    для р в сам.дети {
        если р.имя == имя { вернуть р }
    }
    вернуть ничего
}

// Все прямые потомки с этим именем
общий функ Узел.все(имя: стр) -> [Узел] {
    перем итог: [Узел] = []
    для р в сам.дети {
        если р.имя == имя { итог.добавить(р) }
    }
    вернуть итог
}

// Элементы-потомки (не только прямые) с этим именем ("*" - все) в порядке документа
общий функ Узел.найти_все(имя: стр) -> [Узел] {
    перем итог: [Узел] = []
    // обход без рекурсии: стек узлов и номер следующего ребёнка каждого
    перем стек: [Узел] = [сам]
    перем номера: [цел] = [0]
    пока стек.длина > 0 {
        пусть п = стек.длина - 1
        пусть к = номера[п]
        если к < стек[п].дети.длина {
            номера[п] = к + 1
            пусть р = стек[п].дети[к]
            если р.имя != "" {
                если р.имя == имя или имя == "*" { итог.добавить(р) }
                стек.добавить(р)
                номера.добавить(0)
            }
        } иначе {
            стек.удалить(п)
            номера.удалить(п)
        }
    }
    вернуть итог
}

// Первый элемент-потомок с этим именем
общий функ Узел.найти(имя: стр) -> Узел? {
    для р в сам.дети {
        если р.имя == имя { вернуть р }
        если р.имя != "" {
            если пусть н = р.найти(имя) { вернуть н }
        }
    }
    вернуть ничего
}

// Весь текст первого потомка с этим именем или "", если такого нет:
// книга.значение("название")
общий функ Узел.значение(имя: стр) -> стр {
    если пусть н = сам.найти(имя) { вернуть н.весь_текст() }
    вернуть ""
}

// Весь текст внутри узла, без тегов
общий функ Узел.весь_текст() -> стр {
    если сам.имя == "" { вернуть сам.текст }
    перем части: [стр] = []
    для р в сам.дети { части.добавить(р.весь_текст()) }
    вернуть части.соединить("")
}

// ---------- разбор ----------

// Дерево документа (корневой элемент); ошибка называет строку и позицию в тексте
общий функ разобрать(с: стр) -> Узел! {
    пусть события = разобрать_xml(с)!
    перем имена: [стр] = []
    перем атрибуты: [{стр: стр}] = []
    перем дети: [[Узел]] = []
    перем корень = текст("")
    перем к = 0
    пока к < события.длина {
        пусть вид = события[к]
        если вид == "<" {
            имена.добавить(события[к + 1])
            перем а: {стр: стр} = {}
            к += 2
            пока события[к] == "@" {
                а[события[к + 1]] = события[к + 2]
                к += 3
            }
            атрибуты.добавить(а)
            пусть нет: [Узел] = []
            дети.добавить(нет)
            к += 1                      // «>»
        } иначе если вид == "</" {
            пусть п = имена.длина - 1
            пусть у = Узел(имена[п], атрибуты[п], дети[п])
            имена.удалить(п)
            атрибуты.удалить(п)
            дети.удалить(п)
            если п == 0 {
                корень = у
            } иначе {
                дети[п - 1].добавить(у)
            }
            к += 2
        } иначе {
            дети[дети.длина - 1].добавить(текст(события[к + 1]))
            к += 2
        }
    }
    вернуть корень
}

// ---------- запись ----------

// Текст с заменой знаков & < > " на ссылки XML
общий функ экранировать(с: стр) -> стр {
    если не (с.содержит("&") или с.содержит("<") или с.содержит(">") или с.содержит("\"")) { вернуть с }
    вернуть с.заменить("&", "&amp;").заменить("<", "&lt;").заменить(">", "&gt;").заменить("\"", "&quot;")
}

// Значение атрибута: кроме знаков & < > " заменяются табуляция и переводы
// строки, иначе при чтении они превратятся в пробелы
общий функ экранировать_атрибут(с: стр) -> стр {
    пусть т = экранировать(с)
    если не (т.содержит("\t") или т.содержит("\n") или т.содержит(символ_по_коду(13))) { вернуть т }
    вернуть т.заменить("\t", "&#9;").заменить("\n", "&#10;").заменить(символ_по_коду(13), "&#13;")
}

// Узел в виде текста XML
общий функ записать(у: Узел) -> стр {
    перем ч: [стр] = []
    перем стек: [Узел] = [у]
    перем номера: [цел] = [-1]          // -1 - элемент ещё не открыт
    пока стек.длина > 0 {
        пусть п = стек.длина - 1
        пусть к = номера[п]
        пусть узел = стек[п]
        если к == -1 {
            если узел.имя == "" {
                ч.добавить(экранировать(узел.текст))
                стек.удалить(п)
                номера.удалить(п)
                продолжить
            }
            ч.добавить("<" + узел.имя)
            для имя в узел.атрибуты.ключи() {
                ч.добавить(" " + имя + "=\"" + экранировать_атрибут(узел.атрибуты[имя]) + "\"")
            }
            если узел.дети.длина == 0 {
                ч.добавить("/>")
                стек.удалить(п)
                номера.удалить(п)
                продолжить
            }
            ч.добавить(">")
            номера[п] = 0
        } иначе если к < узел.дети.длина {
            номера[п] = к + 1
            стек.добавить(узел.дети[к])
            номера.добавить(-1)
        } иначе {
            ч.добавить("</" + узел.имя + ">")
            стек.удалить(п)
            номера.удалить(п)
        }
    }
    вернуть ч.соединить("")
}

// Документ с объявлением <?xml ...?> в начале
общий функ записать_документ(у: Узел) -> стр {
    вернуть "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" + записать(у)
}
