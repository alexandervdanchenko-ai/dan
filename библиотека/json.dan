// Стандартная библиотека Дана: формат JSON (RFC 8259).
//
//     подключить "json"
//     пусть з = json.разобрать("{\"имя\": \"Иван\", \"возраст\": 35}")!
//     вывод(з.поле("имя"))                    // Строка(значение = "Иван")
//     вывод(json.записать(з))                 // {"имя":"Иван","возраст":35}
//
// Значение JSON - перечисление из семи вариантов. Порядок полей объекта
// сохраняется (словари Дана хранят порядок добавления).

общий тип Значение {
    Пусто
    Логическое(значение: лог)
    Целое(значение: цел)
    Число(значение: дроб)
    Строка(значение: стр)
    Массив(элементы: [Значение])
    Объект(поля: {стр: Значение})
}

// ---------- доступ к частям значения ----------

// Поле объекта; если поля нет или значение не объект - Пусто. Поэтому
// обращения можно соединять в цепочку и проверять один раз в конце:
//     з.поле("адрес").поле("город").как_стр() иначе "не указан"
общий функ Значение.поле(имя: стр) -> Значение {
    выбор сам {
        Объект(п) { вернуть п.получить(имя, Пусто) }
        иначе { вернуть Пусто }
    }
}

общий функ Значение.есть_поле(имя: стр) -> лог {
    выбор сам {
        Объект(п) { вернуть п.содержит(имя) }
        иначе { вернуть ложь }
    }
}

// Элемент массива с номером (от 0); если его нет - Пусто
общий функ Значение.элемент(номер: цел) -> Значение {
    выбор сам {
        Массив(э) {
            если номер >= 0 и номер < э.длина { вернуть э[номер] }
            вернуть Пусто
        }
        иначе { вернуть Пусто }
    }
}

общий функ Значение.длина() -> цел {
    выбор сам {
        Массив(э) { вернуть э.длина }
        Объект(п) { вернуть п.длина }
        иначе { вернуть 0 }
    }
}

общий функ Значение.элементы() -> [Значение] {
    выбор сам {
        Массив(э) { вернуть э }
        иначе { вернуть [] }
    }
}

общий функ Значение.ключи() -> [стр] {
    выбор сам {
        Объект(п) { вернуть п.ключи() }
        иначе { вернуть [] }
    }
}

общий функ Значение.как_стр() -> стр? {
    выбор сам {
        Строка(с) { вернуть с }
        иначе { вернуть ничего }
    }
}

общий функ Значение.как_цел() -> цел? {
    выбор сам {
        Целое(ч) { вернуть ч }
        Число(ч) {
            если ч >= -9000000000000000000.0 и ч <= 9000000000000000000.0 и дроб(цел(ч)) == ч { вернуть цел(ч) }
            вернуть ничего
        }
        иначе { вернуть ничего }
    }
}

общий функ Значение.как_дроб() -> дроб? {
    выбор сам {
        Целое(ч) { вернуть дроб(ч) }
        Число(ч) { вернуть ч }
        иначе { вернуть ничего }
    }
}

общий функ Значение.как_лог() -> лог? {
    выбор сам {
        Логическое(л) { вернуть л }
        иначе { вернуть ничего }
    }
}

общий функ Значение.пусто() -> лог {
    выбор сам {
        Пусто { вернуть истина }
        иначе { вернуть ложь }
    }
}

// ---------- запись ----------

// Текст JSON без лишних пробелов: {"а":1,"б":[true,null]}
общий функ записать(з: Значение) -> стр {
    вернуть записать_с_отступом(з, -1, 0)
}

// Текст JSON с отступами в два пробела, по одному полю в строке
общий функ записать_красиво(з: Значение) -> стр {
    вернуть записать_с_отступом(з, 2, 0)
}

функ отступ(шаг: цел, уровень: цел) -> стр {
    если шаг < 0 { вернуть "" }
    вернуть "\n" + " ".повторить(шаг * уровень)
}

// Части текста собираются в список и соединяются один раз, поэтому запись
// длинного массива или объекта занимает время, пропорциональное длине текста.
функ записать_с_отступом(з: Значение, шаг: цел, уровень: цел) -> стр {
    выбор з {
        Пусто { вернуть "null" }
        Логическое(л) { вернуть если_лог(л) }
        Целое(ч) { вернуть стр(ч) }
        Число(ч) { вернуть число_в_текст(ч) }
        Строка(с) { вернуть строка_в_текст(с) }
        Массив(э) {
            если э.длина == 0 { вернуть "[]" }
            перем части: [стр] = ["["]
            для н в 0..э.длина - 1 {
                если н > 0 { части.добавить(",") }
                части.добавить(отступ(шаг, уровень + 1))
                части.добавить(записать_с_отступом(э[н], шаг, уровень + 1))
            }
            части.добавить(отступ(шаг, уровень))
            части.добавить("]")
            вернуть части.соединить("")
        }
        Объект(п) {
            если п.длина == 0 { вернуть "{}" }
            перем части: [стр] = ["{"]
            перем первое = истина
            для к в п {
                если не первое { части.добавить(",") }
                первое = ложь
                части.добавить(отступ(шаг, уровень + 1))
                части.добавить(строка_в_текст(к))
                части.добавить(если_пробел(шаг))
                части.добавить(записать_с_отступом(п[к], шаг, уровень + 1))
            }
            части.добавить(отступ(шаг, уровень))
            части.добавить("}")
            вернуть части.соединить("")
        }
    }
}

функ если_лог(л: лог) -> стр {
    если л { вернуть "true" }
    вернуть "false"
}

функ если_пробел(шаг: цел) -> стр {
    если шаг < 0 { вернуть ":" }
    вернуть ": "
}

функ число_в_текст(ч: дроб) -> стр {
    // в JSON нет бесконечности и «не числа»: такие значения записываются как null
    если ч - ч != 0.0 { вернуть "null" }
    вернуть стр(ч)
}

функ строка_в_текст(с: стр) -> стр {
    перем части: [стр] = ["\""]
    для знак в с.символы() {
        если знак == "\"" {
            части.добавить("\\\"")
        } иначе если знак == "\\" {
            части.добавить("\\\\")
        } иначе если знак == "\n" {
            части.добавить("\\n")
        } иначе если знак == "\t" {
            части.добавить("\\t")
        } иначе если код_символа(знак) < 32 {
            пусть к = в_систему(код_символа(знак), 16)
            части.добавить("\\u" + "0".повторить(4 - к.длина) + к)
        } иначе {
            части.добавить(знак)
        }
    }
    части.добавить("\"")
    вернуть части.соединить("")
}

// ---------- разбор ----------

тип Разбор { значение: Значение, конец: цел }

// Значение из текста JSON; ошибка называет строку и позицию в тексте
общий функ разобрать(текст: стр) -> Значение! {
    пусть знаки = текст.символы()
    перем н = пропустить_пробелы(знаки, 0)
    если н < знаки.длина и знаки[н] == символ_по_коду(65279) { н = пропустить_пробелы(знаки, н + 1) }   // метка UTF-8
    пусть р = разобрать_значение(знаки, н, 0)!
    пусть конец = пропустить_пробелы(знаки, р.конец)
    если конец < знаки.длина {
        вернуть ошибка(место(знаки, конец) + "после значения лишний текст")
    }
    вернуть р.значение
}

функ место(знаки: [стр], н: цел) -> стр {
    перем строка = 1
    перем позиция = 1
    для к в 0..н - 1 {
        если к < знаки.длина и знаки[к] == "\n" {
            строка += 1
            позиция = 1
        } иначе {
            позиция += 1
        }
    }
    вернуть "JSON, строка " + стр(строка) + ", позиция " + стр(позиция) + ": "
}

функ пропустить_пробелы(знаки: [стр], н: цел) -> цел {
    перем к = н
    пока к < знаки.длина и (знаки[к] == " " или знаки[к] == "\n" или знаки[к] == "\t" или знаки[к] == символ_по_коду(13)) {
        к += 1
    }
    вернуть к
}

функ разобрать_значение(знаки: [стр], н: цел, глубина: цел) -> Разбор! {
    если глубина > 500 { вернуть ошибка(место(знаки, н) + "слишком глубокая вложенность (больше 500)") }
    если н >= знаки.длина { вернуть ошибка(место(знаки, н) + "текст закончился, а значение не найдено") }
    пусть з = знаки[н]
    если з == "{" { вернуть разобрать_объект(знаки, н + 1, глубина) }
    если з == "[" { вернуть разобрать_массив(знаки, н + 1, глубина) }
    если з == "\"" {
        пусть р = разобрать_строку(знаки, н + 1)!
        вернуть Разбор(Строка(р.текст), р.конец)
    }
    если з == "t" { вернуть разобрать_слово(знаки, н, "true", Логическое(истина)) }
    если з == "f" { вернуть разобрать_слово(знаки, н, "false", Логическое(ложь)) }
    если з == "n" { вернуть разобрать_слово(знаки, н, "null", Пусто) }
    если з == "-" или цифра(з) { вернуть разобрать_число(знаки, н) }
    вернуть ошибка(место(знаки, н) + "неожиданный знак «" + з + "»")
}

функ разобрать_слово(знаки: [стр], н: цел, слово: стр, з: Значение) -> Разбор! {
    пусть буквы = слово.символы()
    для к в 0..буквы.длина - 1 {
        если н + к >= знаки.длина или знаки[н + к] != буквы[к] {
            вернуть ошибка(место(знаки, н) + "ожидалось «" + слово + "»")
        }
    }
    вернуть Разбор(з, н + буквы.длина)
}

функ цифра(з: стр) -> лог {
    вернуть з >= "0" и з <= "9" и з.длина == 1
}

функ разобрать_число(знаки: [стр], н: цел) -> Разбор! {
    перем к = н
    перем целое = истина
    если знаки[к] == "-" { к += 1 }
    если к >= знаки.длина или не цифра(знаки[к]) {
        вернуть ошибка(место(знаки, н) + "после «-» должна идти цифра")
    }
    если знаки[к] == "0" {
        к += 1
    } иначе {
        пока к < знаки.длина и цифра(знаки[к]) { к += 1 }
    }
    если к < знаки.длина и знаки[к] == "." {
        целое = ложь
        к += 1
        если к >= знаки.длина или не цифра(знаки[к]) {
            вернуть ошибка(место(знаки, к) + "после десятичной точки должна идти цифра")
        }
        пока к < знаки.длина и цифра(знаки[к]) { к += 1 }
    }
    если к < знаки.длина и (знаки[к] == "e" или знаки[к] == "E") {
        целое = ложь
        к += 1
        если к < знаки.длина и (знаки[к] == "+" или знаки[к] == "-") { к += 1 }
        если к >= знаки.длина или не цифра(знаки[к]) {
            вернуть ошибка(место(знаки, к) + "в показателе степени должна быть цифра")
        }
        пока к < знаки.длина и цифра(знаки[к]) { к += 1 }
    }
    пусть запись = знаки[н..к - 1].соединить("")
    если целое {
        если пусть ч = разобрать_цел(запись) {
            вернуть Разбор(Целое(ч), к)
        }
        // не помещается в цел: остаётся дробным числом
    }
    вернуть Разбор(Число(разобрать_дроб(запись) иначе 0.0), к)
}

тип Текст { текст: стр, конец: цел }

функ разобрать_строку(знаки: [стр], н: цел) -> Текст! {
    перем части: [стр] = []
    перем к = н
    пока истина {
        если к >= знаки.длина { вернуть ошибка(место(знаки, н - 1) + "строка не закрыта кавычкой") }
        пусть з = знаки[к]
        если з == "\"" { вернуть Текст(части.соединить(""), к + 1) }
        если з == "\\" {
            если к + 1 >= знаки.длина { вернуть ошибка(место(знаки, к) + "строка не закрыта кавычкой") }
            пусть е = знаки[к + 1]
            если е == "\"" или е == "\\" или е == "/" {
                части.добавить(е)
            } иначе если е == "n" {
                части.добавить("\n")
            } иначе если е == "t" {
                части.добавить("\t")
            } иначе если е == "r" {
                части.добавить(символ_по_коду(13))
            } иначе если е == "b" {
                части.добавить(символ_по_коду(8))
            } иначе если е == "f" {
                части.добавить(символ_по_коду(12))
            } иначе если е == "u" {
                перем код = шестнадцатеричное(знаки, к + 2)!
                к += 4
                если код >= 55296 и код <= 56319 {
                    // суррогатная пара UTF-16: 😀
                    если к + 7 < знаки.длина и знаки[к + 2] == "\\" и знаки[к + 3] == "u" {
                        пусть второй = шестнадцатеричное(знаки, к + 4)!
                        если второй >= 56320 и второй <= 57343 {
                            код = 65536 + (код - 55296) * 1024 + (второй - 56320)
                            к += 6
                        } иначе {
                            код = 65533
                        }
                    } иначе {
                        код = 65533
                    }
                } иначе если код >= 56320 и код <= 57343 {
                    код = 65533
                }
                если код == 0 {
                    вернуть ошибка(место(знаки, к - 4) + "символ с кодом 0 не может входить в строку Дана")
                }
                части.добавить(символ_по_коду(код))
            } иначе {
                вернуть ошибка(место(знаки, к) + "неизвестное сочетание «\\" + е + "»")
            }
            к += 2
        } иначе если код_символа(з) < 32 {
            вернуть ошибка(место(знаки, к) + "управляющий символ внутри строки нужно записывать как \\n, \\t или \\u....")
        } иначе {
            части.добавить(з)
            к += 1
        }
    }
    вернуть ошибка("недостижимо")
}

функ шестнадцатеричное(знаки: [стр], н: цел) -> цел! {
    перем итог = 0
    для к в н..н + 3 {
        если к >= знаки.длина { вернуть ошибка(место(знаки, н - 2) + "после \\u нужны четыре шестнадцатеричные цифры") }
        пусть ц = "0123456789abcdef".найти(знаки[к].строчные())
        если ц < 0 или знаки[к].длина != 1 {
            вернуть ошибка(место(знаки, н - 2) + "после \\u нужны четыре шестнадцатеричные цифры")
        }
        итог = итог * 16 + ц
    }
    вернуть итог
}

функ разобрать_массив(знаки: [стр], н: цел, глубина: цел) -> Разбор! {
    перем элементы: [Значение] = []
    перем к = пропустить_пробелы(знаки, н)
    если к < знаки.длина и знаки[к] == "]" { вернуть Разбор(Массив(элементы), к + 1) }
    пока истина {
        пусть р = разобрать_значение(знаки, к, глубина + 1)!
        элементы.добавить(р.значение)
        к = пропустить_пробелы(знаки, р.конец)
        если к >= знаки.длина { вернуть ошибка(место(знаки, н - 1) + "массив не закрыт скобкой «]»") }
        если знаки[к] == "]" { вернуть Разбор(Массив(элементы), к + 1) }
        если знаки[к] != "," { вернуть ошибка(место(знаки, к) + "между элементами массива нужна запятая") }
        к = пропустить_пробелы(знаки, к + 1)
    }
    вернуть ошибка("недостижимо")
}

функ разобрать_объект(знаки: [стр], н: цел, глубина: цел) -> Разбор! {
    перем поля: {стр: Значение} = {}
    перем к = пропустить_пробелы(знаки, н)
    если к < знаки.длина и знаки[к] == "}" { вернуть Разбор(Объект(поля), к + 1) }
    пока истина {
        если к >= знаки.длина { вернуть ошибка(место(знаки, н - 1) + "объект не закрыт скобкой «}»") }
        если знаки[к] != "\"" { вернуть ошибка(место(знаки, к) + "имя поля должно быть строкой в кавычках") }
        пусть имя = разобрать_строку(знаки, к + 1)!
        к = пропустить_пробелы(знаки, имя.конец)
        если к >= знаки.длина или знаки[к] != ":" {
            вернуть ошибка(место(знаки, к) + "после имени поля нужно двоеточие")
        }
        пусть р = разобрать_значение(знаки, пропустить_пробелы(знаки, к + 1), глубина + 1)!
        поля[имя.текст] = р.значение
        к = пропустить_пробелы(знаки, р.конец)
        если к >= знаки.длина { вернуть ошибка(место(знаки, н - 1) + "объект не закрыт скобкой «}»") }
        если знаки[к] == "}" { вернуть Разбор(Объект(поля), к + 1) }
        если знаки[к] != "," { вернуть ошибка(место(знаки, к) + "между полями объекта нужна запятая") }
        к = пропустить_пробелы(знаки, к + 1)
    }
    вернуть ошибка("недостижимо")
}
