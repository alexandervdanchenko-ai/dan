/// Стандартная библиотека Дана: таблицы Excel (.xlsx, Office Open XML).
///
///     подключить "excel"
///     // новая книга
///     excel.создать("отчёт.xlsx", [excel.Лист("Октябрь", [["Товар", "Количество"], ["Книга", "2"]])])!
///     // чтение
///     пусть к = excel.открыть("данные.xlsx")!
///     для строка в к.лист(к.листы()[0])! { вывод(строка) }
///
/// Значения ячеек читаются как текст: число - как записано в файле (350,
/// 0.25), дата - как 26.10.2026 (с временем - 26.10.2026 14:30), логическое
/// значение - истина или ложь, формула - её последний вычисленный результат.
/// При записи текст, похожий на число (350, -12, 0.25) или на дату
/// (26.10.2026), сохраняется числом или датой, остальное - текстом.

подключить "xml"

// ---------- запись ----------

/// Лист книги. Первая строка - шапка: выделяется жирным и закрепляется при прокрутке.
общий тип Лист {
    имя: стр
    строки: [[стр]]
    шапка: лог = истина
}

общий функ создать(путь: стр, листы: [Лист]) -> ! {
    записать(путь, книга(листы)!)
}

/// Байты файла .xlsx, не записывая его на диск
общий функ книга(листы: [Лист]) -> байты! {
    если листы.длина == 0 { вернуть ошибка("в книге Excel должен быть хотя бы один лист") }
    перем имена: [стр] = []
    для л в листы {
        если л.имя == "" или л.имя.длина > 31 {
            вернуть ошибка("имя листа «" + л.имя + "»: нужно от 1 до 31 знака")
        }
        для з в ["[", "]", ":", "*", "?", "/", "\\"] {
            если л.имя.содержит(з) { вернуть ошибка("имя листа «" + л.имя + "» не может содержать знак " + з) }
        }
        если имена.содержит(л.имя.строчные()) { вернуть ошибка("два листа с именем «" + л.имя + "»") }
        имена.добавить(л.имя.строчные())
    }
    перем части: [байты] = [
        байты("[Content_Types].xml"), байты(типы_содержимого(листы.длина)),
        байты("_rels/.rels"), байты(связи_пакета()),
        байты("xl/workbook.xml"), байты(книга_xml(листы)),
        байты("xl/_rels/workbook.xml.rels"), байты(связи_книги(листы.длина)),
        байты("xl/styles.xml"), байты(стили())
    ]
    для н в 0..листы.длина - 1 {
        части.добавить(байты("xl/worksheets/sheet" + стр(н + 1) + ".xml"))
        части.добавить(байты(лист_xml(листы[н])))
    }
    вернуть собрать_архив(части)
}

/// Буквенное имя столбца: 0 - A, 25 - Z, 26 - AA
общий функ столбец(номер: цел) -> стр {
    пусть буквы = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    перем н = номер
    перем итог = ""
    пока истина {
        итог = буквы[н % 26] + итог
        н = частное(н, 26) - 1
        если н < 0 { прервать }
    }
    вернуть итог
}

функ лист_xml(л: Лист) -> стр {
    перем ч: [стр] = ["<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"]
    ч.добавить("<worksheet xmlns=\"" + пространство() + "\" xmlns:r=\"" + пространство_r() + "\">")
    если л.шапка и л.строки.длина > 1 {
        ч.добавить("<sheetViews><sheetView workbookViewId=\"0\"><pane ySplit=\"1\" topLeftCell=\"A2\" ")
        ч.добавить("activePane=\"bottomLeft\" state=\"frozen\"/></sheetView></sheetViews>")
    }
    // ширина столбцов - по самому длинному значению
    перем ширины: [цел] = []
    для строка в л.строки {
        для к в 0..строка.длина - 1 {
            пока ширины.длина <= к { ширины.добавить(8) }
            если строка[к].длина + 2 > ширины[к] { ширины[к] = строка[к].длина + 2 }
        }
    }
    если ширины.длина > 0 {
        ч.добавить("<cols>")
        для к в 0..ширины.длина - 1 {
            перем ш = ширины[к]
            если ш > 80 { ш = 80 }
            ч.добавить("<col min=\"" + стр(к + 1) + "\" max=\"" + стр(к + 1) + "\" width=\"" + стр(ш) + "\" customWidth=\"1\"/>")
        }
        ч.добавить("</cols>")
    }
    ч.добавить("<sheetData>")
    для н в 0..л.строки.длина - 1 {
        ч.добавить("<row r=\"" + стр(н + 1) + "\">")
        пусть жирная = л.шапка и н == 0
        для к в 0..л.строки[н].длина - 1 {
            ч.добавить(ячейка_xml(столбец(к) + стр(н + 1), л.строки[н][к], жирная))
        }
        ч.добавить("</row>")
    }
    ч.добавить("</sheetData></worksheet>")
    вернуть ч.соединить("")
}

функ ячейка_xml(адрес: стр, значение: стр, жирная: лог) -> стр {
    если значение == "" {
        если жирная { вернуть "<c r=\"" + адрес + "\" s=\"1\"/>" }
        вернуть ""
    }
    перем стиль = ""
    если жирная { стиль = " s=\"1\"" }
    если не жирная и похоже_на_число(значение) {
        вернуть "<c r=\"" + адрес + "\"><v>" + значение + "</v></c>"
    }
    если не жирная {
        если пусть д = дата_из_текста(значение) {
            вернуть "<c r=\"" + адрес + "\" s=\"2\"><v>" + стр(д - дата(1899, 12, 30)) + "</v></c>"
        }
    }
    пусть т = xml.экранировать(значение)
    вернуть "<c r=\"" + адрес + "\"" + стиль + " t=\"inlineStr\"><is><t xml:space=\"preserve\">" + т + "</t></is></c>"
}

// Число в обычной записи: без ведущих нулей (номера вроде 007 остаются текстом) и не длиннее 15 цифр
функ похоже_на_число(с: стр) -> лог {
    перем знаки = с.символы()
    перем к = 0
    если знаки[0] == "-" { к = 1 }
    если к >= знаки.длина { вернуть ложь }
    перем цифр = 0
    перем точка = ложь
    если знаки[к] == "0" и к + 1 < знаки.длина и знаки[к + 1] != "." { вернуть ложь }
    пока к < знаки.длина {
        пусть з = знаки[к]
        если з == "." {
            если точка или цифр == 0 или к == знаки.длина - 1 { вернуть ложь }
            точка = истина
        } иначе если з >= "0" и з <= "9" и з.длина == 1 {
            цифр += 1
        } иначе {
            вернуть ложь
        }
        к += 1
    }
    вернуть цифр > 0 и цифр <= 15
}

// Дата в записи ДД.ММ.ГГГГ (ровно так: 26.10.2026)
функ дата_из_текста(с: стр) -> дата? {
    если с.длина != 10 или с[2] != "." или с[5] != "." { вернуть ничего }
    для к в [0, 1, 3, 4, 6, 7, 8, 9] {
        если не (с[к] >= "0" и с[к] <= "9") { вернуть ничего }
    }
    если пусть д = разобрать_дату(с) { вернуть д }
    вернуть ничего
}

функ книга_xml(листы: [Лист]) -> стр {
    перем ч: [стр] = ["<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"]
    ч.добавить("<workbook xmlns=\"" + пространство() + "\" xmlns:r=\"" + пространство_r() + "\"><sheets>")
    для н в 0..листы.длина - 1 {
        ч.добавить("<sheet name=\"" + xml.экранировать_атрибут(листы[н].имя) + "\" sheetId=\"" + стр(н + 1))
        ч.добавить("\" r:id=\"rId" + стр(н + 1) + "\"/>")
    }
    ч.добавить("</sheets></workbook>")
    вернуть ч.соединить("")
}

функ связи_книги(листов: цел) -> стр {
    перем ч: [стр] = ["<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"]
    ч.добавить("<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">")
    для н в 1..листов {
        ч.добавить("<Relationship Id=\"rId" + стр(н) + "\" Type=\"" + пространство_r() + "/worksheet\" ")
        ч.добавить("Target=\"worksheets/sheet" + стр(н) + ".xml\"/>")
    }
    ч.добавить("<Relationship Id=\"rId" + стр(листов + 1) + "\" Type=\"" + пространство_r() + "/styles\" Target=\"styles.xml\"/>")
    ч.добавить("</Relationships>")
    вернуть ч.соединить("")
}

функ типы_содержимого(листов: цел) -> стр {
    перем ч: [стр] = ["<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"]
    ч.добавить("<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">")
    ч.добавить("<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>")
    ч.добавить("<Default Extension=\"xml\" ContentType=\"application/xml\"/>")
    ч.добавить("<Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/>")
    ч.добавить("<Override PartName=\"/xl/styles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml\"/>")
    для н в 1..листов {
        ч.добавить("<Override PartName=\"/xl/worksheets/sheet" + стр(н) + ".xml\" ")
        ч.добавить("ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>")
    }
    ч.добавить("</Types>")
    вернуть ч.соединить("")
}

функ связи_пакета() -> стр {
    вернуть ("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
        "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">" +
        "<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" " +
        "Target=\"xl/workbook.xml\"/></Relationships>")
}

// Стили: 0 - обычная ячейка, 1 - жирная (шапка), 2 - дата ДД.ММ.ГГГГ
функ стили() -> стр {
    вернуть ("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
        "<styleSheet xmlns=\"" + пространство() + "\">" +
        "<numFmts count=\"1\"><numFmt numFmtId=\"164\" formatCode=\"dd\\.mm\\.yyyy\"/></numFmts>" +
        "<fonts count=\"2\"><font><sz val=\"11\"/><name val=\"Calibri\"/><family val=\"2\"/></font>" +
        "<font><b/><sz val=\"11\"/><name val=\"Calibri\"/><family val=\"2\"/></font></fonts>" +
        "<fills count=\"2\"><fill><patternFill patternType=\"none\"/></fill><fill><patternFill patternType=\"gray125\"/></fill></fills>" +
        "<borders count=\"1\"><border><left/><right/><top/><bottom/><diagonal/></border></borders>" +
        "<cellStyleXfs count=\"1\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\"/></cellStyleXfs>" +
        "<cellXfs count=\"3\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\"/>" +
        "<xf numFmtId=\"0\" fontId=\"1\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyFont=\"1\"/>" +
        "<xf numFmtId=\"164\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyNumberFormat=\"1\"/></cellXfs>" +
        "<cellStyles count=\"1\"><cellStyle name=\"Normal\" xfId=\"0\" builtinId=\"0\"/></cellStyles></styleSheet>")
}

функ пространство() -> стр {
    вернуть "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
}

функ пространство_r() -> стр {
    вернуть "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
}

// ---------- чтение ----------

/// Открытая книга: файлы архива, имена и пути листов, общие строки, стили дат
общий тип Книга {
    файлы: [байты]
    имена: [стр]
    пути: [стр]
    строки: [стр]
    даты: [лог]
}

общий функ открыть(путь: стр) -> Книга! {
    если не существует(путь) { вернуть ошибка("файл «" + путь + "» не найден") }
    вернуть из_байтов(прочитать_байты(путь))
}

общий функ из_байтов(данные: байты) -> Книга! {
    если данные.длина < 4 или данные[0] != 80 или данные[1] != 75 {
        вернуть ошибка("это не книга Excel в формате .xlsx (старый формат .xls не поддерживается: " +
            "сохраните её в Excel как .xlsx)")
    }
    пусть файлы = файлы_архива(данные)!
    пусть книга_текст = файл_архива(файлы, "xl/workbook.xml")
    если книга_текст == ничего { вернуть ошибка("в архиве нет файла xl/workbook.xml: это не книга Excel") }
    пусть корень_книги = xml.разобрать(книга_текст иначе "")!
    // какой файл соответствует какому листу - в связях книги
    перем цели: {стр: стр} = {}
    если пусть связи_текст = файл_архива(файлы, "xl/_rels/workbook.xml.rels") {
        пусть связи = xml.разобрать(связи_текст)!
        для с в связи.все("Relationship") {
            пусть номер = с.атрибут("Id") иначе ""
            перем цель = с.атрибут("Target") иначе ""
            если цель.начинается("/") {
                цель = цель[1..цель.длина - 1]
            } иначе {
                цель = "xl/" + цель
            }
            цели[номер] = цель
        }
    }
    перем имена: [стр] = []
    перем пути: [стр] = []
    для л в корень_книги.найти_все("sheet") {
        имена.добавить(л.атрибут("name") иначе "")
        пусть номер = л.атрибут("r:id") иначе ""
        пути.добавить(цели.получить(номер, ""))
    }
    перем строки: [стр] = []
    если пусть общие = файл_архива(файлы, "xl/sharedStrings.xml") {
        для си в xml.разобрать(общие)!.все("si") { строки.добавить(текст_строки(си)) }
    }
    перем даты: [лог] = []
    если пусть стили_текст = файл_архива(файлы, "xl/styles.xml") {
        даты = стили_дат(xml.разобрать(стили_текст)!)
    }
    вернуть Книга(файлы, имена, пути, строки, даты)
}

// Текст элемента общей строки: <t> или части <r><t>, без фонетических подсказок <rPh>
функ текст_строки(си: xml.Узел) -> стр {
    перем ч: [стр] = []
    для р в си.дети {
        если р.имя == "t" {
            ч.добавить(р.весь_текст())
        } иначе если р.имя == "r" {
            ч.добавить(р.значение("t"))
        }
    }
    вернуть ч.соединить("")
}

// Для каждого стиля ячейки - является ли его формат форматом даты
функ стили_дат(корень: xml.Узел) -> [лог] {
    перем свои: {цел: лог} = {}
    если пусть форматы = корень.первый("numFmts") {
        для ф в форматы.все("numFmt") {
            пусть номер = разобрать_цел(ф.атрибут("numFmtId") иначе "") иначе -1
            свои[номер] = формат_даты(ф.атрибут("formatCode") иначе "")
        }
    }
    перем итог: [лог] = []
    если пусть ячейки = корень.первый("cellXfs") {
        для х в ячейки.все("xf") {
            пусть номер = разобрать_цел(х.атрибут("numFmtId") иначе "0") иначе 0
            итог.добавить(свои.получить(номер, (номер >= 14 и номер <= 22) или (номер >= 45 и номер <= 47)))
        }
    }
    вернуть итог
}

// Формат даты содержит буквы d, m, y (или h, s) вне кавычек и квадратных скобок
функ формат_даты(код: стр) -> лог {
    перем в_кавычках = ложь
    перем в_скобках = ложь
    перем пред = ""
    для з в код.строчные().символы() {
        если пред == "\\" {
            пред = ""
            продолжить
        }
        если з == "\"" {
            в_кавычках = не в_кавычках
        } иначе если з == "[" {
            в_скобках = истина
        } иначе если з == "]" {
            в_скобках = ложь
        } иначе если не в_кавычках и не в_скобках и (з == "d" или з == "y" или з == "m") {
            вернуть истина
        }
        пред = з
    }
    вернуть ложь
}

функ файл_архива(файлы: [байты], имя: стр) -> стр? {
    перем к = 0
    пока к + 1 < файлы.длина {
        если стр(файлы[к]) == имя { вернуть стр(файлы[к + 1]) }
        к += 2
    }
    вернуть ничего
}

общий функ Книга.листы() -> [стр] {
    вернуть сам.имена
}

/// Значения листа: прямоугольная таблица строк, пустые ячейки - ""
общий функ Книга.лист(имя: стр) -> [[стр]]! {
    для н в 0..сам.имена.длина - 1 {
        если сам.имена[н] == имя { вернуть сам.лист_по_номеру(н)! }
    }
    вернуть ошибка("в книге нет листа «" + имя + "»; листы: " + сам.имена.соединить(", "))
}

/// Значения листа по номеру (от 0)
общий функ Книга.лист_по_номеру(номер: цел) -> [[стр]]! {
    если номер < 0 или номер >= сам.пути.длина { вернуть ошибка("в книге нет листа с номером " + стр(номер)) }
    пусть текст = файл_архива(сам.файлы, сам.пути[номер])
    если текст == ничего { вернуть ошибка("в архиве нет файла листа " + сам.пути[номер]) }
    пусть лист = xml.разобрать(текст иначе "")!
    перем таблица: [[стр]] = []
    перем ширина = 0
    перем следующая = 0
    если пусть данные = лист.первый("sheetData") {
        для ряд в данные.все("row") {
            перем номер_ряда = следующая
            если пусть r = ряд.атрибут("r") { номер_ряда = (разобрать_цел(r) иначе (следующая + 1)) - 1 }
            пока таблица.длина <= номер_ряда { таблица.добавить([]) }
            перем строка: [стр] = []
            перем след_столбец = 0
            для я в ряд.все("c") {
                перем к = след_столбец
                если пусть адрес = я.атрибут("r") { к = номер_столбца(адрес) }
                пока строка.длина <= к { строка.добавить("") }
                строка[к] = сам.значение(я)
                след_столбец = к + 1
            }
            если строка.длина > ширина { ширина = строка.длина }
            таблица[номер_ряда] = строка
            следующая = номер_ряда + 1
        }
    }
    // пустые строки в конце не нужны; строки дополняются до одной ширины
    пока таблица.длина > 0 и пустая(таблица[таблица.длина - 1]) { таблица.удалить(таблица.длина - 1) }
    для н в 0..таблица.длина - 1 {
        пока таблица[н].длина < ширина { таблица[н].добавить("") }
    }
    вернуть таблица
}

функ пустая(строка: [стр]) -> лог {
    для я в строка {
        если я != "" { вернуть ложь }
    }
    вернуть истина
}

// Номер столбца (от 0) по адресу ячейки: B3 - 1, AA10 - 26
функ номер_столбца(адрес: стр) -> цел {
    пусть буквы = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    перем н = 0
    для з в адрес.символы() {
        пусть к = буквы.найти(з)
        если к < 0 { прервать }
        н = н * 26 + к + 1
    }
    вернуть н - 1
}

// Текст значения ячейки
функ Книга.значение(я: xml.Узел) -> стр {
    пусть вид = я.атрибут("t") иначе "n"
    если вид == "inlineStr" {
        если пусть ис = я.первый("is") { вернуть текст_строки(ис) }
        вернуть ""
    }
    пусть v = я.значение("v")
    если v == "" {
        // формула, которую ещё никто не вычислил (файл создан не Excel): видна сама формула
        если пусть ф = я.первый("f") {
            если ф.весь_текст() != "" { вернуть "=" + ф.весь_текст() }
        }
    }
    если вид == "s" {
        пусть н = разобрать_цел(v) иначе -1
        если н >= 0 и н < сам.строки.длина { вернуть сам.строки[н] }
        вернуть ""
    }
    если вид == "b" {
        если v == "1" { вернуть "истина" }
        вернуть "ложь"
    }
    если вид == "n" и v != "" {
        пусть стиль = разобрать_цел(я.атрибут("s") иначе "0") иначе 0
        если стиль >= 0 и стиль < сам.даты.длина и сам.даты[стиль] {
            если пусть ч = разобрать_дроб(v) { вернуть дата_excel(ч) }
        }
    }
    вернуть v
}

// Дата и время по номеру дня Excel (1 - 01.01.1900)
функ дата_excel(ч: дроб) -> стр {
    если ч < 1.0 или ч > 2958465.0 { вернуть стр(ч) }
    пусть дней = округлить_вниз(ч)
    пусть секунд = округлить((ч - дроб(дней)) * 86400.0)
    перем д = дата(1899, 12, 30) + дней
    если дней < 61 { д = д + 1 }          // Excel считает несуществующий день 29.02.1900
    если секунд == 0 { вернуть стр(д) }
    если секунд >= 86400 { вернуть стр(д + 1) }
    пусть часы = частное(секунд, 3600)
    пусть минуты = частное(секунд % 3600, 60)
    перем итог = стр(д) + " " + две_цифры(часы) + ":" + две_цифры(минуты)
    если секунд % 60 != 0 { итог = итог + ":" + две_цифры(секунд % 60) }
    вернуть итог
}

функ две_цифры(ч: цел) -> стр {
    если ч < 10 { вернуть "0" + стр(ч) }
    вернуть стр(ч)
}
