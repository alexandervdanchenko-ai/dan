/// Стандартная библиотека Дана: запросы HTTP и HTTPS.
///
///     подключить "http"
///     пусть ответ = http.получить("https://example.com/")!
///     вывод(ответ.код)                  // 200
///     вывод(ответ.текст())
///
/// Запрос выполняет библиотека libcurl (Linux, macOS) или WinHTTP (Windows);
/// настройки прокси-сервера системы учитываются. Неудачный запрос (сервер не
/// найден, нет соединения, истекло время) - ошибка-значение, которую нужно
/// обработать. Ответ сервера с любым кодом, в том числе 404 и 500, - это
/// ответ, а не ошибка: код проверяется методом успешно() или полем код.

подключить "json"

общий тип Ответ {
    код: цел                       // 200 - успешно, 404 - не найдено, ...
    заголовки: {стр: стр}          // имена заголовков строчными буквами: "content-type"
    данные: байты                  // тело ответа как есть
}

/// Тело ответа как текст (в кодировке UTF-8)
общий функ Ответ.текст() -> стр {
    вернуть стр(сам.данные)
}

/// Код 200-299: запрос выполнен
общий функ Ответ.успешно() -> лог {
    вернуть сам.код >= 200 и сам.код <= 299
}

/// Тело ответа, разобранное как JSON
общий функ Ответ.как_json() -> json.Значение! {
    вернуть json.разобрать(стр(сам.данные))
}

общий функ Ответ.заголовок(имя: стр) -> стр? {
    вернуть сам.заголовки.найти(имя.строчные())
}

/// Запрос с любым методом ("GET", "POST", "PUT", "DELETE", ...), заголовками и телом
общий функ запрос(метод: стр, адрес: стр, заголовки: {стр: стр}, тело: байты, секунд: цел) -> Ответ! {
    перем строки: [стр] = []
    для имя в заголовки { строки.добавить(имя + ": " + заголовки[имя]) }
    пусть полный = закодировать_адрес(адрес)
    перем части: [байты] = []
    если пусть ч = сетевой_запрос(метод.прописные(), полный, строки, тело, секунд) {
        части = ч
    } иначе ошибка о {
        вернуть ошибка(адрес + о[полный.длина..о.длина - 1])     // в сообщении - адрес, как его записал человек
    }
    перем код = 0
    перем полученные: {стр: стр} = {}
    перем первая = истина
    для строка в стр(части[0]).разбить("\n") {
        если первая {
            код = разобрать_цел(строка) иначе 0
            первая = ложь
        } иначе если строка != "" {
            пусть н = строка.найти(": ")
            если н > 0 {
                пусть имя = строка[0..н - 1]
                пусть значение = строка[н + 2..строка.длина - 1]
                если полученные.содержит(имя) {
                    // повторяющиеся заголовки соединяются через запятую, как велит RFC 9110
                    полученные[имя] = полученные[имя] + ", " + значение
                } иначе {
                    полученные[имя] = значение
                }
            }
        }
    }
    вернуть Ответ(код, полученные, части[1])
}

/// GET: загрузить страницу или данные
общий функ получить(адрес: стр) -> Ответ! {
    вернуть запрос("GET", адрес, {}, байты(""), 60)
}

/// Текст по адресу; код ответа, отличный от 200-299, - ошибка
общий функ получить_текст(адрес: стр) -> стр! {
    пусть о = получить(адрес)!
    если не о.успешно() { вернуть ошибка(адрес + ": сервер ответил кодом " + стр(о.код)) }
    вернуть о.текст()
}

/// Скачать файл по адресу и сохранить его на диск
общий функ скачать(адрес: стр, путь: стр) -> ! {
    пусть о = получить(адрес)!
    если не о.успешно() { вернуть ошибка(адрес + ": сервер ответил кодом " + стр(о.код)) }
    записать(путь, о.данные)
}

/// POST: отправить текст с указанным типом содержимого
общий функ отправить(адрес: стр, тело: стр, тип_содержимого: стр) -> Ответ! {
    вернуть запрос("POST", адрес, {"Content-Type": тип_содержимого}, байты(тело), 60)
}

/// POST: отправить значение JSON
общий функ отправить_json(адрес: стр, з: json.Значение) -> Ответ! {
    вернуть запрос("POST", адрес, {"Content-Type": "application/json; charset=utf-8"}, байты(json.записать(з)), 60)
}

/// POST: отправить поля формы, как это делает браузер
общий функ отправить_форму(адрес: стр, поля: {стр: стр}) -> Ответ! {
    перем пары: [стр] = []
    для имя в поля { пары.добавить(закодировать(имя) + "=" + закодировать(поля[имя])) }
    вернуть запрос("POST", адрес, {"Content-Type": "application/x-www-form-urlencoded"}, байты(пары.соединить("&")), 60)
}

/// Текст для части адреса: http.закодировать("Иванов И.И.") = "%D0%98%D0%B2...%20%D0%98.%D0%98."
общий функ закодировать(текст: стр) -> стр {
    перем части: [стр] = []
    пусть все = байты(текст)
    для н в 0..все.длина - 1 {
        пусть б = все[н]
        если (б >= 48 и б <= 57) или (б >= 65 и б <= 90) или (б >= 97 и б <= 122) или б == 45 или б == 46 или б == 95 или б == 126 {
            части.добавить(символ_по_коду(б))
        } иначе {
            части.добавить(процент(б))
        }
    }
    вернуть части.соединить("")
}

функ процент(б: цел) -> стр {
    пусть цифры = "0123456789ABCDEF"
    вернуть "%" + цифры[частное(б, 16)] + цифры[б % 16]
}

// Адрес с русскими буквами и пробелами превращается в допустимый: такие знаки
// в пути и параметрах записываются через %, остальные (/ ? & = и уже
// закодированные %XX) не меняются. Русское имя сервера (книга.рф) переводится
// в международную запись IDNA (xn--...), понятную любой сети.
функ закодировать_адрес(адрес: стр) -> стр {
    перем начало_пути = адрес.длина
    пусть схема = адрес.найти("://")
    если схема >= 0 {
        пусть остаток = адрес[схема + 3..адрес.длина - 1]
        пусть косая = остаток.найти("/")
        пусть вопрос = остаток.найти("?")
        перем н = остаток.длина
        если косая >= 0 { н = косая }
        если вопрос >= 0 и вопрос < н { н = вопрос }
        начало_пути = схема + 3 + н
    } иначе {
        начало_пути = 0
    }
    перем части: [стр] = []
    если схема >= 0 {
        части.добавить(адрес[0..схема + 2])
        части.добавить(международное_имя(адрес[схема + 3..начало_пути - 1]))
    }
    пусть все = байты(адрес[начало_пути..адрес.длина - 1])
    для н в 0..все.длина - 1 {
        пусть б = все[н]
        если б > 127 или б == 32 или б == 34 или б == 60 или б == 62 {
            части.добавить(процент(б))
        } иначе {
            части.добавить(символ_по_коду(б))
        }
    }
    вернуть части.соединить("")
}

// ---------- русские имена серверов: IDNA и Punycode (RFC 3490, RFC 3492) ----------

функ международное_имя(сервер: стр) -> стр {
    перем имя = сервер
    перем пользователь = ""
    перем порт = ""
    пусть собака = имя.найти("@")
    если собака >= 0 {
        пользователь = имя[0..собака]
        имя = имя[собака + 1..имя.длина - 1]
    }
    пусть двоеточие = имя.найти(":")
    если двоеточие >= 0 {
        порт = имя[двоеточие..имя.длина - 1]
        имя = имя[0..двоеточие - 1]
    }
    перем метки: [стр] = []
    для метка в имя.разбить(".") {
        если байты(метка).длина == метка.длина {
            метки.добавить(метка)
        } иначе {
            метки.добавить("xn--" + пуникод(метка.строчные()))
        }
    }
    вернуть пользователь + метки.соединить(".") + порт
}

функ цифра_пуникода(ц: цел) -> стр {
    если ц < 26 { вернуть символ_по_коду(97 + ц) }
    вернуть символ_по_коду(22 + ц)        // 26 -> "0"
}

функ поправка(разность: цел, точек: цел, первая: лог) -> цел {
    перем д = частное(разность, 2)
    если первая { д = частное(разность, 700) }
    д += частное(д, точек)
    перем к = 0
    пока д > 455 {                         // ((36 - 1) * 26) / 2
        д = частное(д, 35)
        к += 36
    }
    вернуть к + частное(36 * д, д + 38)
}

функ пуникод(метка: стр) -> стр {
    перем коды: [цел] = []
    для с в метка.символы() { коды.добавить(код_символа(с)) }
    перем вывод_: [стр] = []
    для к в коды {
        если к < 128 { вывод_.добавить(символ_по_коду(к)) }
    }
    пусть основных = вывод_.длина
    перем готово = основных
    если основных > 0 { вывод_.добавить("-") }
    перем н = 128
    перем разность = 0
    перем смещение = 72
    пока готово < коды.длина {
        перем наим = 1114112
        для к в коды {
            если к >= н и к < наим { наим = к }
        }
        разность += (наим - н) * (готово + 1)
        н = наим
        для к в коды {
            если к < н { разность += 1 }
            если к == н {
                перем q = разность
                перем шаг = 36
                пока истина {
                    перем порог = шаг - смещение
                    если шаг <= смещение { порог = 1 }
                    если шаг >= смещение + 26 { порог = 26 }
                    если q < порог { прервать }
                    вывод_.добавить(цифра_пуникода(порог + (q - порог) % (36 - порог)))
                    q = частное(q - порог, 36 - порог)
                    шаг += 36
                }
                вывод_.добавить(цифра_пуникода(q))
                смещение = поправка(разность, готово + 1, готово == основных)
                разность = 0
                готово += 1
            }
        }
        разность += 1
        н += 1
    }
    вернуть вывод_.соединить("")
}
