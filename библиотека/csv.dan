/// Стандартная библиотека Дана: таблицы в формате CSV (RFC 4180).
///
///     подключить "csv"
///     пусть строки = csv.разобрать(прочитать("список.csv"))!
///     для с в строки { вывод(с[0]) }
///     записать("итог.csv", csv.записать([["Имя", "Сумма"], ["Иванов", "100"]]))
///     записать("для_excel.csv", csv.записать_для_excel(строки))
///
/// Значения в кавычках могут содержать разделитель, кавычки (записываются
/// удвоенными: "") и переводы строк. Русский Excel сохраняет CSV с разделителем
/// «;», поэтому разобрать() определяет разделитель сам.

/// Строки таблицы; разделитель (запятая, точка с запятой или табуляция)
/// определяется по первой строке
общий функ разобрать(текст: стр) -> [[стр]]! {
    вернуть разобрать_с_разделителем(текст, угадать_разделитель(текст))
}

общий функ разобрать_с_разделителем(текст: стр, разделитель: стр) -> [[стр]]! {
    вернуть разобрать_csv(текст, разделитель)        // разбор выполняет среда выполнения
}

функ угадать_разделитель(текст: стр) -> стр {
    вернуть разделитель_csv(текст)
}

/// Текст CSV с запятой и переводами строк \r\n, как требует RFC 4180
общий функ записать(строки: [[стр]]) -> стр {
    вернуть записать_с_разделителем(строки, ",")
}

/// Текст для русского Excel: разделитель «;» и метка UTF-8 в начале, иначе Excel
/// показывает русские буквы неверно
общий функ записать_для_excel(строки: [[стр]]) -> стр {
    вернуть символ_по_коду(65279) + записать_с_разделителем(строки, ";")
}

общий функ записать_с_разделителем(строки: [[стр]], разделитель: стр) -> стр {
    // запись выполняет среда выполнения: один проход по каждому значению, без промежуточных строк
    вернуть записать_csv(строки, разделитель)
}
