// Стандартная библиотека Дана: таблицы в формате CSV (RFC 4180).
//
//     подключить "csv"
//     пусть строки = csv.разобрать(прочитать("список.csv"))!
//     для с в строки { вывод(с[0]) }
//     записать("итог.csv", csv.записать([["Имя", "Сумма"], ["Иванов", "100"]]))
//     записать("для_excel.csv", csv.записать_для_excel(строки))
//
// Значения в кавычках могут содержать разделитель, кавычки (записываются
// удвоенными: "") и переводы строк. Русский Excel сохраняет CSV с разделителем
// «;», поэтому разобрать() определяет разделитель сам.

// Строки таблицы; разделитель (запятая, точка с запятой или табуляция)
// определяется по первой строке
общий функ разобрать(текст: стр) -> [[стр]]! {
    вернуть разобрать_с_разделителем(текст, угадать_разделитель(текст))
}

общий функ разобрать_с_разделителем(текст: стр, разделитель: стр) -> [[стр]]! {
    если разделитель.длина != 1 или разделитель == "\"" или разделитель == "\n" {
        вернуть ошибка("разделитель CSV - один знак, кроме кавычки и перевода строки")
    }
    пусть знаки = текст.символы()
    перем строки: [[стр]] = []
    перем строка: [стр] = []
    перем поле: [стр] = []
    перем к = 0
    если знаки.длина > 0 и знаки[0] == символ_по_коду(65279) { к = 1 }        // метка UTF-8 от Excel
    перем номер_строки = 1
    пока к < знаки.длина {
        пусть з = знаки[к]
        если з == "\"" и поле.длина == 0 {
            // значение в кавычках
            перем закрыто = ложь
            пусть начало = номер_строки
            к += 1
            пока к < знаки.длина и не закрыто {
                если знаки[к] == "\"" {
                    если к + 1 < знаки.длина и знаки[к + 1] == "\"" {
                        поле.добавить("\"")
                        к += 2
                    } иначе {
                        закрыто = истина
                        к += 1
                    }
                } иначе {
                    если знаки[к] == "\n" { номер_строки += 1 }
                    поле.добавить(знаки[к])
                    к += 1
                }
            }
            если не закрыто {
                вернуть ошибка("CSV, строка " + стр(начало) + ": кавычка не закрыта")
            }
            если к < знаки.длина и знаки[к] != разделитель и знаки[к] != "\n" и знаки[к] != символ_по_коду(13) {
                вернуть ошибка("CSV, строка " + стр(номер_строки) + ": после закрывающей кавычки должен идти разделитель")
            }
            // пустое значение в кавычках ("") должно отличаться от отсутствия значения
            если поле.длина == 0 { поле.добавить("") }
        } иначе если з == разделитель {
            строка.добавить(поле.соединить(""))
            поле = []
            к += 1
        } иначе если з == "\n" или з == символ_по_коду(13) {
            // пустая строка файла - строка таблицы без значений
            если строка.длина > 0 или поле.длина > 0 { строка.добавить(поле.соединить("")) }
            строки.добавить(строка)
            строка = []
            поле = []
            если з == символ_по_коду(13) и к + 1 < знаки.длина и знаки[к + 1] == "\n" { к += 1 }
            к += 1
            номер_строки += 1
        } иначе {
            поле.добавить(з)
            к += 1
        }
    }
    если поле.длина > 0 или строка.длина > 0 {
        строка.добавить(поле.соединить(""))
        строки.добавить(строка)
    }
    вернуть строки
}

функ угадать_разделитель(текст: стр) -> стр {
    перем запятых = 0
    перем точек_с_запятой = 0
    перем табуляций = 0
    перем в_кавычках = ложь
    для з в текст.символы() {
        если з == "\"" {
            в_кавычках = не в_кавычках
        } иначе если не в_кавычках {
            если з == "\n" { прервать }
            если з == "," { запятых += 1 }
            если з == ";" { точек_с_запятой += 1 }
            если з == "\t" { табуляций += 1 }
        }
    }
    если точек_с_запятой > запятых и точек_с_запятой >= табуляций { вернуть ";" }
    если табуляций > запятых { вернуть "\t" }
    вернуть ","
}

// Текст CSV с запятой и переводами строк \r\n, как требует RFC 4180
общий функ записать(строки: [[стр]]) -> стр {
    вернуть записать_с_разделителем(строки, ",")
}

// Текст для русского Excel: разделитель «;» и метка UTF-8 в начале, иначе Excel
// показывает русские буквы неверно
общий функ записать_для_excel(строки: [[стр]]) -> стр {
    вернуть символ_по_коду(65279) + записать_с_разделителем(строки, ";")
}

общий функ записать_с_разделителем(строки: [[стр]], разделитель: стр) -> стр {
    перем ч: [стр] = []
    для строка в строки {
        перем поля: [стр] = []
        для поле в строка { поля.добавить(поле_csv(поле, разделитель)) }
        // строка из одного пустого значения отличается от пустой строки кавычками
        если строка.длина == 1 и строка[0] == "" { поля = ["\"\""] }
        ч.добавить(поля.соединить(разделитель))
        ч.добавить(символ_по_коду(13) + "\n")
    }
    вернуть ч.соединить("")
}

функ поле_csv(поле: стр, разделитель: стр) -> стр {
    если (поле.содержит(разделитель) или поле.содержит("\"") или поле.содержит("\n") или
        поле.содержит(символ_по_коду(13))) {
        вернуть "\"" + поле.заменить("\"", "\"\"") + "\""
    }
    вернуть поле
}
