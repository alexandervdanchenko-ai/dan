/// Стандартная библиотека Дана: сервер HTTP.
///
///     подключить "вебсервер"
///
///     функ ответить(з: вебсервер.Запрос) -> вебсервер.Ответ {
///         если з.путь == "/" { вернуть вебсервер.текст("Привет") }
///         если пусть п = з.шаблон("/дела/{номер}") { вернуть вебсервер.текст("дело " + п["номер"]) }
///         вернуть вебсервер.не_найдено()
///     }
///
///     пусть с = вебсервер.слушать("127.0.0.1", 8080)!
///     с.обслуживать(ответить)
///
/// Запросы обслуживают несколько задач сразу (поле работников, по умолчанию 8):
/// главная задача принимает соединения и раздаёт их работникам через канал.
/// Обработчик - обычная функция, которая получает Запрос и возвращает Ответ;
/// задачи получают копии его захваченных значений, поэтому гонок данных нет.
/// На каждое соединение - один запрос (Connection: close). Слишком длинные
/// заголовки и тело, неверный запрос и молчащий клиент получают ответ 400,
/// 413 или 408 без вызова обработчика.
///
/// Адрес "127.0.0.1" - только этот компьютер; "0.0.0.0" - все сети компьютера,
/// тогда сервер доступен другим компьютерам (их надо пускать осознанно).

подключить "json"

/// Запрос HTTP. Имена заголовков - строчными буквами: "content-type".
общий тип Запрос {
    метод: стр = ""                 // "GET", "POST", ...
    путь: стр = ""                  // путь без строки параметров, раскодированный: "/дела/1"
    строка_параметров: стр = ""     // всё после «?» как есть
    параметры: {стр: стр} = {}      // параметры из строки после «?», раскодированные
    заголовки: {стр: стр} = {}
    тело: байты = байты("")
    адрес: стр = ""                 // адрес IPv4 клиента: "127.0.0.1"
}

/// Ответ HTTP: код, заголовки и тело.
общий тип Ответ {
    код: цел = 200
    заголовки: {стр: стр} = {}
    тело: байты = байты("")
}

/// Сервер, который слушает порт. Поля после порта можно менять до обслуживать().
общий тип Сервер {
    слушатель: цел
    порт: цел
    работников: цел = 8             // задач, которые обслуживают запросы одновременно
    предел_запросов: цел = 0        // принять столько соединений и завершить работу; 0 - без предела
    наибольшие_заголовки: цел = 65536
    наибольшее_тело: цел = 10485760 // байтов; больше - ответ 413
    секунд: цел = 30                // сколько ждать данных клиента; дольше - ответ 408
}

/// Тело запроса как текст (UTF-8; неверные байты заменяются знаком U+FFFD)
общий функ Запрос.текст() -> стр {
    вернуть стр(сам.тело)
}

/// Тело запроса, разобранное как JSON
общий функ Запрос.как_json() -> json.Значение! {
    вернуть json.разобрать(стр(сам.тело))
}

общий функ Запрос.заголовок(имя: стр) -> стр? {
    вернуть сам.заголовки.найти(имя.строчные())
}

/// Значение параметра из строки после «?»
общий функ Запрос.параметр(имя: стр) -> стр? {
    вернуть сам.параметры.найти(имя)
}

/// Поля формы из тела (application/x-www-form-urlencoded), раскодированные
общий функ Запрос.форма() -> {стр: стр} {
    вернуть разобрать_параметры(стр(сам.тело))
}

/// Совпадение пути с шаблоном: "/дела/{номер}/файлы/{имя}" даёт {"номер": ..., "имя": ...};
/// ничего - путь не подходит. Части шаблона сравниваются целиком.
общий функ Запрос.шаблон(образец: стр) -> {стр: стр}? {
    пусть ч_пути = сам.путь.разбить("/")
    пусть ч_образца = образец.разбить("/")
    если ч_пути.длина != ч_образца.длина { вернуть ничего }
    перем найдено: {стр: стр} = {}
    для к в 0..ч_образца.длина - 1 {
        пусть о = ч_образца[к]
        если о.длина >= 2 и о.начинается("{") и о.оканчивается("}") {
            если ч_пути[к] == "" { вернуть ничего }
            найдено[о[1..о.длина - 2]] = ч_пути[к]
        } иначе если о != ч_пути[к] {
            вернуть ничего
        }
    }
    вернуть найдено
}

/// Тот же ответ с добавленным заголовком
общий функ Ответ.с_заголовком(имя: стр, значение: стр) -> Ответ {
    перем о = сам
    о.заголовки[имя] = значение
    вернуть о
}

/// Ответ с кодом, типом содержимого и телом
общий функ ответ(код: цел, тип_: стр, тело: байты) -> Ответ {
    вернуть Ответ(код = код, заголовки = {"Content-Type": тип_}, тело = тело)
}

/// Ответ 200 с текстом (text/plain, UTF-8)
общий функ текст(т: стр) -> Ответ {
    вернуть ответ(200, "text/plain; charset=utf-8", байты(т))
}

/// Ответ 200 со страницей HTML
общий функ html(т: стр) -> Ответ {
    вернуть ответ(200, "text/html; charset=utf-8", байты(т))
}

/// Ответ 200 со значением JSON
общий функ ответ_json(з: json.Значение) -> Ответ {
    вернуть ответ(200, "application/json; charset=utf-8", байты(json.записать(з)))
}

/// Ответ с кодом и коротким текстом: ошибка_http(403, "нет доступа")
общий функ ошибка_http(код: цел, т: стр) -> Ответ {
    вернуть ответ(код, "text/plain; charset=utf-8", байты(т))
}

общий функ не_найдено() -> Ответ {
    вернуть ошибка_http(404, "не найдено")
}

/// Ответ 303: браузер переходит по адресу (после отправки формы)
общий функ перенаправить(адрес: стр) -> Ответ {
    вернуть Ответ(код = 303, заголовки = {"Location": адрес}, тело = байты(""))
}

/// Файл из папки по пути запроса: файл(з, "сайт", "/статика/") для "/статика/стиль.css"
/// отдаёт "сайт/стиль.css". Пути с «..», «\» и «:» не выходят за папку: 404.
/// "/" в конце пути - файл index.html этой папки.
общий функ файл(з: Запрос, папка: стр, начало: стр) -> Ответ {
    если не з.путь.начинается(начало) { вернуть не_найдено() }
    перем имя = з.путь[начало.длина..з.путь.длина - 1]
    если имя == "" или имя.оканчивается("/") { имя += "index.html" }
    для часть в имя.разбить("/") {
        если часть == "" или часть == "." или часть == ".." { вернуть не_найдено() }
    }
    если имя.содержит("\\") или имя.содержит(":") { вернуть не_найдено() }
    пусть путь = папка + "/" + имя
    если не существует(путь) или это_папка(путь) { вернуть не_найдено() }
    вернуть ответ(200, тип_по_имени(имя), прочитать_байты(путь))
}

/// Тип содержимого по расширению имени файла
общий функ тип_по_имени(имя: стр) -> стр {
    пусть нм = имя.строчные()
    если нм.оканчивается(".html") или нм.оканчивается(".htm") { вернуть "text/html; charset=utf-8" }
    если нм.оканчивается(".css") { вернуть "text/css; charset=utf-8" }
    если нм.оканчивается(".js") или нм.оканчивается(".mjs") { вернуть "text/javascript; charset=utf-8" }
    если нм.оканчивается(".json") { вернуть "application/json; charset=utf-8" }
    если нм.оканчивается(".txt") или нм.оканчивается(".dan") или нм.оканчивается(".md") { вернуть "text/plain; charset=utf-8" }
    если нм.оканчивается(".svg") { вернуть "image/svg+xml" }
    если нм.оканчивается(".png") { вернуть "image/png" }
    если нм.оканчивается(".jpg") или нм.оканчивается(".jpeg") { вернуть "image/jpeg" }
    если нм.оканчивается(".gif") { вернуть "image/gif" }
    если нм.оканчивается(".webp") { вернуть "image/webp" }
    если нм.оканчивается(".ico") { вернуть "image/x-icon" }
    если нм.оканчивается(".wasm") { вернуть "application/wasm" }
    если нм.оканчивается(".pdf") { вернуть "application/pdf" }
    если нм.оканчивается(".zip") { вернуть "application/zip" }
    вернуть "application/octet-stream"
}

/// Слушать порт адреса IPv4 ("127.0.0.1" - только этот компьютер, "0.0.0.0" - все сети);
/// порт 0 - любой свободный, его номер - в поле порт.
общий функ слушать(адрес: стр, порт: цел) -> Сервер! {
    если порт < 0 или порт > 65535 { вернуть ошибка("порт " + стр(порт) + ": нужно число от 0 до 65535") }
    если не адрес_ipv4(адрес) { вернуть ошибка("адрес \"" + адрес + "\": нужен IPv4 из четырёх чисел от 0 до 255, например \"127.0.0.1\"") }
    пусть с = слушать_порт(порт, адрес)
    если с < 0 { вернуть ошибка(адрес + ":" + стр(порт) + ": порт занят или недоступен") }
    вернуть Сервер(слушатель = с, порт = порт_слушателя(с))
}

/// Запись IPv4: четыре числа от 0 до 255 через точку, без лишних нулей впереди
функ адрес_ipv4(т: стр) -> лог {
    пусть части = т.разбить(".")
    если части.длина != 4 { вернуть ложь }
    для ч в части {
        если ч.длина < 1 или ч.длина > 3 { вернуть ложь }
        для з в ч.символы() { если з < "0" или з > "9" { вернуть ложь } }
        если ч.длина > 1 и ч.начинается("0") { вернуть ложь }
        если пусть н = разобрать_цел(ч) { если н > 255 { вернуть ложь } } иначе ошибка о { вернуть ложь }
    }
    вернуть истина
}

/// Принимать соединения и отвечать на запросы. Работает, пока не принято
/// предел_запросов соединений (0 - всегда); затем ждёт работников и закрывает порт.
общий функ Сервер.обслуживать(обработчик: функ(Запрос) -> Ответ) {
    перем работников = сам.работников
    если работников < 1 { работников = 1 }
    пусть очередь: канал<цел> = канал(работников * 4)
    параллельно {
        для н в 1..работников { запустить работник(очередь, обработчик, сам) }
        перем принято = 0
        пока сам.предел_запросов == 0 или принято < сам.предел_запросов {
            пусть к = принять_соединение(сам.слушатель)
            если к < 0 { прервать }
            принято += 1
            очередь.отправить(к)
        }
        очередь.закрыть()
    }
    закрыть_соединение(сам.слушатель)
}

функ работник(очередь: канал<цел>, обработчик: функ(Запрос) -> Ответ, с: Сервер) {
    для к в очередь {
        обслужить(к, обработчик, с)
        закрыть_соединение(к)
    }
}

функ обслужить(к: цел, обработчик: функ(Запрос) -> Ответ, с: Сервер) {
    перем секунд = с.секунд
    если секунд < 0 { секунд = 0 }
    если секунд > 86400 { секунд = 86400 }
    ждать_соединение_не_дольше(к, секунд)
    перем данные = байты("")
    перем конец = -1
    перем просмотрено = 0
    пока конец < 0 {
        пусть часть = прочитать_соединение(к, 65536)
        если часть.длина == 0 {
            если данные.длина > 0 { отправить(к, ошибка_http(408, "запрос не получен целиком"), "") }
            вернуть
        }
        данные = данные + часть
        конец = конец_заголовков(данные, просмотрено)
        если данные.длина > 3 { просмотрено = данные.длина - 3 }
        если конец < 0 и данные.длина > с.наибольшие_заголовки {
            отправить(к, ошибка_http(431, "слишком длинные заголовки"), "")
            вернуть
        }
    }
    если конец > с.наибольшие_заголовки {
        отправить(к, ошибка_http(431, "слишком длинные заголовки"), "")
        вернуть
    }
    перем з = Запрос(адрес = адрес_соединения(к))
    перем строки: [стр] = []
    если конец > 0 { строки = стр(данные[0..конец - 1]).разбить("\r\n") }
    перем первая: [стр] = []
    если строки.длина > 0 { первая = строки[0].разбить(" ") }
    если первая.длина != 3 или не первая[2].начинается("HTTP/") или первая[0] == "" или не первая[1].начинается("/") {
        отправить(к, ошибка_http(400, "неверный запрос"), "")
        вернуть
    }
    з.метод = первая[0]
    пусть цель = первая[1]
    пусть вопрос = цель.найти("?")
    если вопрос >= 0 {
        з.путь = раскодировать(цель[0..вопрос - 1], ложь)
        если вопрос + 1 <= цель.длина - 1 { з.строка_параметров = цель[вопрос + 1..цель.длина - 1] }
        з.параметры = разобрать_параметры(з.строка_параметров)
    } иначе {
        з.путь = раскодировать(цель, ложь)
    }
    для н в 1..строки.длина - 1 {
        пусть строка = строки[н]
        пусть д = строка.найти(":")
        если д <= 0 {
            отправить(к, ошибка_http(400, "неверный заголовок"), з.метод)
            вернуть
        }
        перем значение = ""
        если д + 1 <= строка.длина - 1 { значение = строка[д + 1..строка.длина - 1].обрезать() }
        пусть имя = строка[0..д - 1].строчные()
        если пусть было = з.заголовки.найти(имя) { з.заголовки[имя] = было + ", " + значение } иначе { з.заголовки[имя] = значение }
    }
    если з.заголовки.содержит("transfer-encoding") {
        отправить(к, ошибка_http(411, "нужен заголовок Content-Length"), з.метод)
        вернуть
    }
    перем длина = 0
    если пусть д = з.заголовки.найти("content-length") {
        если пусть ч = разобрать_цел(д) { длина = ч } иначе ошибка о {
            отправить(к, ошибка_http(400, "неверный Content-Length"), з.метод)
            вернуть
        }
        если длина < 0 {
            отправить(к, ошибка_http(400, "неверный Content-Length"), з.метод)
            вернуть
        }
    }
    если длина > с.наибольшее_тело {
        отправить(к, ошибка_http(413, "слишком большое тело запроса"), з.метод)
        вернуть
    }
    перем тело = байты("")
    если данные.длина > конец + 4 { тело = данные[конец + 4..данные.длина - 1] }
    пока тело.длина < длина {
        пусть часть = прочитать_соединение(к, 65536)
        если часть.длина == 0 {
            отправить(к, ошибка_http(408, "тело запроса не получено целиком"), з.метод)
            вернуть
        }
        тело = тело + часть
    }
    если длина == 0 { тело = байты("") } иначе если тело.длина > длина { тело = тело[0..длина - 1] }
    з.тело = тело
    отправить(к, обработчик(з), з.метод)
}

/// Место «\r\n\r\n» в данных (поиск с номера от) или -1
функ конец_заголовков(б: байты, от: цел) -> цел {
    если б.длина < 4 { вернуть -1 }
    для н в от..б.длина - 4 {
        если б[н] == 13 и б[н + 1] == 10 и б[н + 2] == 13 и б[н + 3] == 10 { вернуть н }
    }
    вернуть -1
}

функ причина(код: цел) -> стр {
    если код == 200 { вернуть "OK" }
    если код == 201 { вернуть "Created" }
    если код == 204 { вернуть "No Content" }
    если код == 301 { вернуть "Moved Permanently" }
    если код == 302 { вернуть "Found" }
    если код == 303 { вернуть "See Other" }
    если код == 304 { вернуть "Not Modified" }
    если код == 400 { вернуть "Bad Request" }
    если код == 401 { вернуть "Unauthorized" }
    если код == 403 { вернуть "Forbidden" }
    если код == 404 { вернуть "Not Found" }
    если код == 405 { вернуть "Method Not Allowed" }
    если код == 408 { вернуть "Request Timeout" }
    если код == 411 { вернуть "Length Required" }
    если код == 413 { вернуть "Content Too Large" }
    если код == 429 { вернуть "Too Many Requests" }
    если код == 431 { вернуть "Request Header Fields Too Large" }
    если код == 500 { вернуть "Internal Server Error" }
    если код == 503 { вернуть "Service Unavailable" }
    вернуть "Status"
}

/// Знаки, которые нельзя пропускать в строку состояния и заголовки (разрыв ответа)
функ без_переводов(т: стр) -> стр {
    вернуть т.заменить("\r", " ").заменить("\n", " ")
}

функ отправить(к: цел, о: Ответ, метод: стр) {
    перем код = о.код
    если код < 100 или код > 999 { код = 500 }
    перем строки: [стр] = ["HTTP/1.1 " + стр(код) + " " + причина(код)]
    перем есть_тип = ложь
    для имя в о.заголовки {
        пусть нм = имя.строчные()
        если нм == "content-length" или нм == "connection" или нм == "transfer-encoding" { продолжить }
        если нм == "content-type" { есть_тип = истина }
        строки.добавить(без_переводов(имя) + ": " + без_переводов(о.заголовки[имя]))
    }
    если не есть_тип и о.тело.длина > 0 { строки.добавить("Content-Type: application/octet-stream") }
    строки.добавить("Content-Length: " + стр(о.тело.длина))
    строки.добавить("Connection: close")
    пусть голова = байты(строки.соединить("\r\n") + "\r\n\r\n")
    если метод == "HEAD" или код == 204 или код == 304 {
        записать_соединение(к, голова)
    } иначе {
        записать_соединение(к, голова + о.тело)
    }
}

функ цифра16(п: цел) -> цел {
    если п >= 48 и п <= 57 { вернуть п - 48 }
    если п >= 65 и п <= 70 { вернуть п - 55 }
    если п >= 97 и п <= 102 { вернуть п - 87 }
    вернуть -1
}

/// Раскодирование «%D0%BF» (и «+» как пробела в параметрах)
общий функ раскодировать(т: стр, плюс_пробел: лог) -> стр {
    если не т.содержит("%") и не (плюс_пробел и т.содержит("+")) { вернуть т }
    пусть б = байты(т)
    перем числа: [цел] = []
    перем н = 0
    пока н < б.длина {
        если б[н] == 37 и н + 2 < б.длина и цифра16(б[н + 1]) >= 0 и цифра16(б[н + 2]) >= 0 {
            пусть ч = цифра16(б[н + 1]) * 16 + цифра16(б[н + 2])
            // знак с кодом 0 не может входить в строку: вместо него U+FFFD
            если ч == 0 { для д в [239, 191, 189] { числа.добавить(д) } } иначе { числа.добавить(ч) }
            н += 3
        } иначе {
            если плюс_пробел и б[н] == 43 { числа.добавить(32) } иначе { числа.добавить(б[н]) }
            н += 1
        }
    }
    вернуть стр(байты(числа))
}

/// Параметры «а=1&б=2» в словарь (раскодированные; повторное имя - последнее значение)
общий функ разобрать_параметры(т: стр) -> {стр: стр} {
    перем итог: {стр: стр} = {}
    если т == "" { вернуть итог }
    для пара в т.разбить("&") {
        если пара == "" { продолжить }
        пусть р = пара.найти("=")
        если р < 0 {
            итог[раскодировать(пара, истина)] = ""
        } иначе если р == пара.длина - 1 {
            итог[раскодировать(пара[0..р - 1], истина)] = ""
        } иначе если р == 0 {
            итог[""] = раскодировать(пара[1..пара.длина - 1], истина)
        } иначе {
            итог[раскодировать(пара[0..р - 1], истина)] = раскодировать(пара[р + 1..пара.длина - 1], истина)
        }
    }
    вернуть итог
}
