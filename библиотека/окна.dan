/// Стандартная библиотека Дана: окна, кнопки, поля ввода, списки, рисование.
///
///     подключить "окна"
///     пусть окно = окна.создать("Счётчик", 300, 120)!
///     пусть надпись = окно.надпись("Нажатий: 0", 20, 20, 260, 25)
///     пусть кнопка = окно.кнопка("Нажать", 20, 60, 120, 32)
///     перем нажатий = 0
///     пока пусть событие = окно.ждать() {
///         выбор событие {
///             окна.Нажатие(э) {
///                 нажатий += 1
///                 надпись.задать_текст("Нажатий: " + стр(нажатий))
///             }
///             иначе {}
///         }
///     }
///
/// Программа сама ждёт событий (окно.ждать()) и разбирает их оператором
/// «выбор», поэтому всё, что она помнит, хранится в её обычных переменных.
/// Координаты и размеры - в точках экрана 96 точек на дюйм; на экранах
/// с большим разрешением окно увеличивается само. Окна работают в Windows;
/// в других системах окна.создать возвращает ошибку.

общий тип Окно { номер: цел }
общий тип Элемент { номер: цел }

/// Что произошло с окном
общий тип Событие {
    Нажатие(элемент: Элемент)                    // нажата кнопка
    Изменение(элемент: Элемент)                  // изменён текст поля, флажок, выбор в списке
    Мышь(элемент: Элемент, х: цел, у: цел)       // щелчок левой кнопкой мыши по холсту
    ПраваяМышь(элемент: Элемент, х: цел, у: цел) // щелчок правой кнопкой мыши по холсту
    Клавиша(элемент: Элемент, клавиша: стр)      // клавиша на холсте: "а", "Enter", "Esc", "Влево", "F1", ...
    Таймер                                       // прошло время, заданное окно.таймер(мс)
    Размер(ширина: цел, высота: цел)             // изменились размеры окна
    Закрытие                                     // окно закрыто; следующее окно.ждать() вернёт ничего
    Ожидание                                     // за время окно.ждать_не_дольше(мс) событий не было
}

// ---------- окно ----------

общий функ создать(заголовок: стр, ширина: цел, высота: цел) -> Окно! {
    пусть номер = окно_создать(заголовок, ширина, высота)!
    вернуть Окно(номер)
}

/// Следующее событие; ничего - окно закрыто
общий функ Окно.ждать() -> Событие? {
    пока истина {
        пусть с = окно_ждать(-1)
        пусть вид = с[0]
        если вид == "нет" { вернуть ничего }
        если пусть событие = событие_из(с) { вернуть событие }
    }
    вернуть ничего
}

/// То же, но ждать не дольше «мс» миллисекунд: если событий не было - Ожидание
общий функ Окно.ждать_не_дольше(мс: цел) -> Событие? {
    пусть с = окно_ждать(мс)
    если с[0] == "нет" { вернуть ничего }
    если с[0] == "ожидание" { вернуть Ожидание }
    если пусть событие = событие_из(с) { вернуть событие }
    вернуть Ожидание
}

функ событие_из(с: [стр]) -> Событие? {
    пусть вид = с[0]
    пусть э = Элемент(разобрать_цел(с[1]) иначе 0)
    пусть х = разобрать_цел(с[2]) иначе 0
    пусть у = разобрать_цел(с[3]) иначе 0
    если вид == "нажатие" { вернуть Нажатие(э) }
    если вид == "изменение" { вернуть Изменение(э) }
    если вид == "мышь" { вернуть Мышь(э, х, у) }
    если вид == "мышь_правая" { вернуть ПраваяМышь(э, х, у) }
    если вид == "клавиша" { вернуть Клавиша(э, с[4]) }
    если вид == "таймер" { вернуть Таймер }
    если вид == "размер" { вернуть Размер(х, у) }
    если вид == "закрытие" { вернуть Закрытие }
    вернуть ничего
}

общий функ Окно.закрыть() {
    окно_задать(сам.номер, "закрыть", "")
}

общий функ Окно.задать_заголовок(заголовок: стр) {
    окно_задать(сам.номер, "текст", заголовок)
}

общий функ Окно.задать_размер(ширина: цел, высота: цел) {
    окно_задать(сам.номер, "место", "0 0 " + стр(ширина) + " " + стр(высота))
}

/// Размер внутренней части окна: [ширина, высота]
общий функ Окно.размер() -> [цел] {
    перем р: [цел] = []
    для ч в окно_получить(сам.номер, "размер").разбить(" ") { р.добавить(разобрать_цел(ч) иначе 0) }
    вернуть р
}

/// Событие Таймер каждые «мс» миллисекунд; 0 - выключить
общий функ Окно.таймер(мс: цел) {
    окно_задать(сам.номер, "таймер", стр(мс))
}

// ---------- элементы ----------

общий функ Окно.кнопка(текст: стр, х: цел, у: цел, ширина: цел, высота: цел) -> Элемент {
    вернуть Элемент(окно_добавить(сам.номер, "кнопка", текст, х, у, ширина, высота))
}

общий функ Окно.надпись(текст: стр, х: цел, у: цел, ширина: цел, высота: цел) -> Элемент {
    вернуть Элемент(окно_добавить(сам.номер, "надпись", текст, х, у, ширина, высота))
}

/// Поле для ввода одной строки
общий функ Окно.поле(текст: стр, х: цел, у: цел, ширина: цел, высота: цел) -> Элемент {
    вернуть Элемент(окно_добавить(сам.номер, "поле", текст, х, у, ширина, высота))
}

/// Поле для пароля: вместо букв видны точки
общий функ Окно.поле_пароля(х: цел, у: цел, ширина: цел, высота: цел) -> Элемент {
    вернуть Элемент(окно_добавить(сам.номер, "пароль", "", х, у, ширина, высота))
}

/// Поле для текста из нескольких строк
общий функ Окно.многострочное_поле(текст: стр, х: цел, у: цел, ширина: цел, высота: цел) -> Элемент {
    вернуть Элемент(окно_добавить(сам.номер, "текст", текст, х, у, ширина, высота))
}

общий функ Окно.флажок(текст: стр, х: цел, у: цел, ширина: цел, высота: цел) -> Элемент {
    вернуть Элемент(окно_добавить(сам.номер, "флажок", текст, х, у, ширина, высота))
}

общий функ Окно.список(строки: [стр], х: цел, у: цел, ширина: цел, высота: цел) -> Элемент {
    пусть э = Элемент(окно_добавить(сам.номер, "список", "", х, у, ширина, высота))
    э.задать_строки(строки)
    вернуть э
}

/// Выпадающий список: виден выбранный вариант, остальные - по нажатию
общий функ Окно.выпадающий_список(строки: [стр], х: цел, у: цел, ширина: цел, высота: цел) -> Элемент {
    пусть э = Элемент(окно_добавить(сам.номер, "выпадающий", "", х, у, ширина, высота))
    э.задать_строки(строки)
    если строки.длина > 0 { э.выбрать(0) }
    вернуть э
}

/// Полоса выполнения от 0 до 100
общий функ Окно.полоса(х: цел, у: цел, ширина: цел, высота: цел) -> Элемент {
    вернуть Элемент(окно_добавить(сам.номер, "полоса", "", х, у, ширина, высота))
}

/// Холст: место для рисования; щелчки мыши и клавиши на нём - события
общий функ Окно.холст(х: цел, у: цел, ширина: цел, высота: цел) -> Элемент {
    вернуть Элемент(окно_добавить(сам.номер, "холст", "", х, у, ширина, высота))
}

// ---------- свойства элементов ----------

/// Текст надписи, кнопки или поля; у списка - выбранная строка ("" - ничего не выбрано)
общий функ Элемент.текст() -> стр {
    вернуть окно_получить(сам.номер, "текст")
}

общий функ Элемент.задать_текст(текст: стр) {
    окно_задать(сам.номер, "текст", текст)
}

общий функ Элемент.отмечен() -> лог {
    вернуть окно_получить(сам.номер, "отмечен") == "истина"
}

общий функ Элемент.отметить(да: лог) {
    окно_задать(сам.номер, "отмечен", если_да(да))
}

/// Номер выбранной строки списка (от 0); -1 - ничего не выбрано
общий функ Элемент.выбранный() -> цел {
    вернуть разобрать_цел(окно_получить(сам.номер, "выбран")) иначе -1
}

общий функ Элемент.выбрать(номер: цел) {
    окно_задать(сам.номер, "выбран", стр(номер))
}

общий функ Элемент.задать_строки(строки: [стр]) {
    окно_задать(сам.номер, "текст", строки.соединить("\n"))
}

/// Значение полосы выполнения: 0 - 100
общий функ Элемент.задать_значение(значение: цел) {
    окно_задать(сам.номер, "значение", стр(значение))
}

общий функ Элемент.сделать_доступным(да: лог) {
    окно_задать(сам.номер, "доступен", если_да(да))
}

общий функ Элемент.показать(да: лог) {
    окно_задать(сам.номер, "виден", если_да(да))
}

общий функ Элемент.переместить(х: цел, у: цел, ширина: цел, высота: цел) {
    окно_задать(сам.номер, "место", стр(х) + " " + стр(у) + " " + стр(ширина) + " " + стр(высота))
}

общий функ Элемент.задать_шрифт(размер: цел) {
    окно_задать(сам.номер, "шрифт", стр(размер))
}

/// Шрифт для текста программ и таблиц: все знаки одной ширины, поэтому столбцы
/// и отметки «^» под строкой стоят ровно (Consolas в Windows, моноширинный в браузере).
общий функ Элемент.задать_шрифт_кода(размер: цел) {
    окно_задать(сам.номер, "шрифт_кода", стр(размер))
}

общий функ Элемент.фокус() {
    окно_задать(сам.номер, "фокус", "")
}

/// Нажать кнопку из программы - так, как будто её нажал человек
/// (для автоматической проверки программ с окнами)
общий функ Элемент.нажать() {
    окно_задать(сам.номер, "нажать", "")
}

/// Ввести текст в поле так, как будто его напечатал человек (будет событие Изменение)
общий функ Элемент.ввести(текст: стр) {
    окно_задать(сам.номер, "ввести", текст)
}

/// Щелчок мышью по холсту и нажатие клавиши на нём - из программы
общий функ Элемент.щёлкнуть(х: цел, у: цел) {
    окно_задать(сам.номер, "щёлкнуть", стр(х) + " " + стр(у))
}

общий функ Элемент.нажать_клавишу(клавиша: стр) {
    окно_задать(сам.номер, "клавиша", клавиша)
}

функ если_да(да: лог) -> стр {
    если да { вернуть "1" }
    вернуть "0"
}

// ---------- рисование на холсте ----------

/// Цвет из красной, зелёной и синей составляющих (0 - 255)
общий функ цвет(к: цел, з: цел, с: цел) -> цел {
    вернуть к * 65536 + з * 256 + с
}

/// «Нет цвета»: фигура без заливки или без контура
общий функ без_цвета() -> цел {
    вернуть -1
}

общий функ чёрный() -> цел { вернуть 0 }
общий функ белый() -> цел { вернуть 16777215 }
общий функ красный() -> цел { вернуть 14423100 }
общий функ зелёный() -> цел { вернуть 2263842 }
общий функ синий() -> цел { вернуть 3302600 }
общий функ серый() -> цел { вернуть 8421504 }
общий функ жёлтый() -> цел { вернуть 16766720 }

общий функ Элемент.очистить(цвет_фона: цел) {
    окно_рисовать(сам.номер, "очистить", [цвет_фона], "")
}

общий функ Элемент.линия(х1: цел, у1: цел, х2: цел, у2: цел, цвет_линии: цел, толщина: цел) {
    окно_рисовать(сам.номер, "линия", [х1, у1, х2, у2, цвет_линии, -1, толщина], "")
}

общий функ Элемент.прямоугольник(х: цел, у: цел, ширина: цел, высота: цел, цвет_линии: цел, заливка: цел) {
    окно_рисовать(сам.номер, "прямоугольник", [х, у, ширина, высота, цвет_линии, заливка, 1], "")
}

общий функ Элемент.эллипс(х: цел, у: цел, ширина: цел, высота: цел, цвет_линии: цел, заливка: цел) {
    окно_рисовать(сам.номер, "эллипс", [х, у, ширина, высота, цвет_линии, заливка, 1], "")
}

общий функ Элемент.надпись_на(текст: стр, х: цел, у: цел, цвет_текста: цел, размер: цел) {
    окно_рисовать(сам.номер, "текст", [х, у, цвет_текста, размер], текст)
}

// ---------- сообщения и выбор файлов ----------

общий функ сообщение(заголовок: стр, текст: стр) {
    окно_сообщение(заголовок, текст, "сведения")
}

общий функ предупреждение(заголовок: стр, текст: стр) {
    окно_сообщение(заголовок, текст, "предупреждение")
}

общий функ сообщение_об_ошибке(заголовок: стр, текст: стр) {
    окно_сообщение(заголовок, текст, "ошибка")
}

/// Вопрос с кнопками «Да» и «Нет»: истина - «Да»
общий функ вопрос(заголовок: стр, текст: стр) -> лог {
    вернуть окно_сообщение(заголовок, текст, "вопрос") == 1
}

/// Выбор файла для открытия; фильтр: "Текст (*.txt)|*.txt|Все файлы|*.*" ("" - все файлы)
общий функ выбрать_файл(заголовок: стр, фильтр: стр) -> стр? {
    вернуть окно_файл("открыть", заголовок, фильтр)
}

общий функ файл_для_сохранения(заголовок: стр, фильтр: стр) -> стр? {
    вернуть окно_файл("сохранить", заголовок, фильтр)
}
