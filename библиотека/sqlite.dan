/// Стандартная библиотека Дана: база данных SQLite.
///
///     подключить "sqlite"
///     пусть база = sqlite.открыть("дела.db")!
///     база.выполнить("CREATE TABLE IF NOT EXISTS дела (номер TEXT, сумма INTEGER)", [])!
///     база.выполнить("INSERT INTO дела VALUES (?, ?)", [sqlite.Текст("А40-1/2026"), sqlite.Целое(150000)])!
///     для строка в база.выбрать("SELECT * FROM дела WHERE сумма > ?", [sqlite.Целое(1000)])! {
///         вывод(строка["номер"].как_стр() иначе "")
///     }
///
/// Значения подставляются в запрос только через параметры «?»: тогда текст,
/// полученный от человека, не может изменить сам запрос (внедрение SQL).

/// Значение ячейки таблицы
общий тип Значение {
    Пусто
    Целое(значение: цел)
    Число(значение: дроб)
    Текст(значение: стр)
    Байты(значение: байты)
}

общий функ Значение.как_цел() -> цел? {
    выбор сам {
        Целое(ч) { вернуть ч }
        иначе { вернуть ничего }
    }
}

общий функ Значение.как_дроб() -> дроб? {
    выбор сам {
        Целое(ч) { вернуть дроб(ч) }
        Число(ч) { вернуть ч }
        иначе { вернуть ничего }
    }
}

общий функ Значение.как_стр() -> стр? {
    выбор сам {
        Текст(т) { вернуть т }
        иначе { вернуть ничего }
    }
}

общий функ Значение.как_байты() -> байты? {
    выбор сам {
        Байты(б) { вернуть б }
        иначе { вернуть ничего }
    }
}

общий функ Значение.пусто() -> лог {
    выбор сам {
        Пусто { вернуть истина }
        иначе { вернуть ложь }
    }
}

/// Значение текстом, как его показала бы таблица: NULL - пустая строка
общий функ Значение.текст() -> стр {
    выбор сам {
        Пусто { вернуть "" }
        Целое(ч) { вернуть стр(ч) }
        Число(ч) { вернуть стр(ч) }
        Текст(т) { вернуть т }
        Байты(б) { вернуть стр(б) }
    }
}

общий тип База { номер: цел }

/// Итог запроса: имена столбцов, строки значений, число изменённых строк
/// и номер (rowid) последней добавленной строки
общий тип Итог {
    столбцы: [стр]
    строки: [[Значение]]
    изменено: цел
    последний_номер: цел
}

/// Открыть базу данных в файле; если файла нет, он создаётся
общий функ открыть(путь: стр) -> База! {
    пусть номер = база_открыть(путь)!
    вернуть База(номер)
}

/// База данных в памяти: исчезает при закрытии или завершении программы
общий функ в_памяти() -> База! {
    вернуть открыть(":memory:")
}

общий функ База.закрыть() {
    база_закрыть(сам.номер)
}

/// Выполнить запрос (или несколько через «;»); значения подставляются вместо «?»
общий функ База.выполнить(запрос: стр, параметры: [Значение]) -> Итог! {
    перем упакованные: [байты] = []
    для з в параметры { упакованные.добавить(упаковать(з)) }
    пусть части = база_выполнить(сам.номер, запрос, упакованные)!
    пусть шапка = стр(части[0])[1..стр(части[0]).длина - 1].разбить(" ")
    пусть число_столбцов = разобрать_цел(шапка[0]) иначе 0
    перем столбцы: [стр] = []
    для н в 1..число_столбцов { столбцы.добавить(стр(части[н])[1..стр(части[н]).длина - 1]) }
    перем строки: [[Значение]] = []
    если число_столбцов > 0 {
        перем н = 1 + число_столбцов
        пока н < части.длина {
            перем строка: [Значение] = []
            для к в 0..число_столбцов - 1 { строка.добавить(распаковать_значение(части[н + к])) }
            строки.добавить(строка)
            н += число_столбцов
        }
    }
    вернуть Итог(столбцы, строки, разобрать_цел(шапка[1]) иначе 0, разобрать_цел(шапка[2]) иначе 0)
}

/// Строки результата запроса SELECT в виде словарей «столбец - значение»
общий функ База.выбрать(запрос: стр, параметры: [Значение]) -> [{стр: Значение}]! {
    пусть итог = сам.выполнить(запрос, параметры)!
    перем результат: [{стр: Значение}] = []
    для строка в итог.строки {
        перем запись: {стр: Значение} = {}
        для к в 0..итог.столбцы.длина - 1 { запись[итог.столбцы[к]] = строка[к] }
        результат.добавить(запись)
    }
    вернуть результат
}

/// Первое значение первой строки (например, SELECT COUNT(*)); если строк нет - Пусто
общий функ База.значение(запрос: стр, параметры: [Значение]) -> Значение! {
    пусть итог = сам.выполнить(запрос, параметры)!
    если итог.строки.длина == 0 или итог.столбцы.длина == 0 { вернуть Пусто }
    вернуть итог.строки[0][0]
}

функ упаковать(з: Значение) -> байты {
    выбор з {
        Пусто { вернуть байты("n") }
        Целое(ч) { вернуть байты("i" + стр(ч)) }
        Число(ч) { вернуть байты("f" + стр(ч)) }
        Текст(т) { вернуть байты("t" + т) }
        Байты(б) { вернуть байты("b") + б }
    }
}

функ распаковать_значение(б: байты) -> Значение {
    пусть вид = б[0]
    если вид == 105 { вернуть Целое(разобрать_цел(стр(б)[1..стр(б).длина - 1]) иначе 0) }        // i
    если вид == 102 { вернуть Число(разобрать_дроб(стр(б)[1..стр(б).длина - 1]) иначе 0.0) }     // f
    если вид == 116 { вернуть Текст(стр(б[1..б.длина - 1])) }                                     // t
    если вид == 98 { вернуть Байты(б[1..б.длина - 1]) }                                            // b
    вернуть Пусто
}
