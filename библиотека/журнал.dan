/// Стандартная библиотека Дана: журнал работы программы.
///
///     подключить "журнал"
///
///     перем ж = журнал.в_поток_ошибок("сервер")
///     ж = ж.с_уровнем(журнал.уровень_из_среды("ЖУРНАЛ", журнал.СВЕДЕНИЯ()))
///     ж.сведения("запущен на порту 8080")
///     ж.предупреждение("медленный запрос", {"путь": "/дела", "мс": "1250"})
///
/// Строка журнала: время, уровень, источник и текст, затем поля имя=значение:
///
///     2026-11-10 14:05:09 СВЕДЕНИЯ сервер: запущен на порту 8080
///     2026-11-10 14:05:10 ПРЕДУПРЕЖДЕНИЕ сервер: медленный запрос путь=/дела мс=1250
///
/// Журнал в формате JSON (по объекту на строку, для программ сбора журналов) -
/// с_json(). Журнал - значение: его можно передать в функцию и в задачу; строки
/// из разных задач не перемешиваются внутри строки (каждая пишется одним вызовом).

подключить "json"

общий функ ОТЛАДКА() -> цел { вернуть 0 }
общий функ СВЕДЕНИЯ() -> цел { вернуть 1 }
общий функ ПРЕДУПРЕЖДЕНИЕ() -> цел { вернуть 2 }
общий функ ОШИБКА() -> цел { вернуть 3 }

общий тип Журнал {
    источник: стр
    путь: стр = ""             // "" - поток ошибок, иначе файл, в который дописываются строки
    уровень: цел = 1           // строки ниже этого уровня не пишутся
    json: лог = ложь
}

/// Журнал в поток ошибок (вывод_ошибки)
общий функ в_поток_ошибок(источник: стр) -> Журнал {
    вернуть Журнал(источник = источник)
}

/// Журнал в файл: строки дописываются в конец (файл создаётся при первой записи)
общий функ в_файл(путь: стр, источник: стр) -> Журнал {
    вернуть Журнал(источник = источник, путь = путь)
}

/// Тот же журнал с другим наименьшим уровнем: журнал.ОТЛАДКА() ... журнал.ОШИБКА()
общий функ Журнал.с_уровнем(уровень: цел) -> Журнал {
    перем ж = сам
    ж.уровень = уровень
    вернуть ж
}

/// Тот же журнал в формате JSON: {"время": ..., "уровень": ..., "источник": ..., "текст": ..., поля}
общий функ Журнал.с_json() -> Журнал {
    перем ж = сам
    ж.json = истина
    вернуть ж
}

/// Тот же журнал с другим источником (например, для части программы)
общий функ Журнал.с_источником(источник: стр) -> Журнал {
    перем ж = сам
    ж.источник = источник
    вернуть ж
}

/// Уровень из переменной среды: "отладка", "сведения", "предупреждение", "ошибка"
/// (или debug, info, warning, error; регистр не важен); нет переменной или другое значение - запасной
общий функ уровень_из_среды(имя: стр, запасной: цел) -> цел {
    пусть з = (переменная_среды(имя) иначе "").обрезать().строчные()
    если з == "отладка" или з == "debug" { вернуть 0 }
    если з == "сведения" или з == "info" { вернуть 1 }
    если з == "предупреждение" или з == "warning" или з == "warn" { вернуть 2 }
    если з == "ошибка" или з == "error" { вернуть 3 }
    вернуть запасной
}

функ название(уровень: цел) -> стр {
    если уровень <= 0 { вернуть "ОТЛАДКА" }
    если уровень == 1 { вернуть "СВЕДЕНИЯ" }
    если уровень == 2 { вернуть "ПРЕДУПРЕЖДЕНИЕ" }
    вернуть "ОШИБКА"
}

/// Время записи: 2026-11-10 14:05:09
общий функ время() -> стр {
    пусть с = сейчас()                         // 10.11.2026 14:05:09
    вернуть с[6..9] + "-" + с[3..4] + "-" + с[0..1] + с[10..с.длина - 1]
}

функ одной_строкой(т: стр) -> стр {
    вернуть т.заменить("\r\n", " ").заменить("\n", " ").заменить("\r", " ")
}

функ значение_поля(т: стр) -> стр {
    пусть о = одной_строкой(т)
    если о == "" или о.содержит(" ") или о.содержит("=") или о.содержит("\"") {
        вернуть "\"" + о.заменить("\\", "\\\\").заменить("\"", "\\\"") + "\""
    }
    вернуть о
}

/// Строка журнала (без перевода строки в конце), как её запишет запись()
общий функ Журнал.строка(уровень: цел, текст: стр, поля: {стр: стр}) -> стр {
    если сам.json {
        перем о: {стр: json.Значение} = {"время": json.Строка(время()), "уровень": json.Строка(название(уровень)),
            "источник": json.Строка(сам.источник), "текст": json.Строка(текст)}
        для имя в поля {
            если не о.содержит(имя) { о[имя] = json.Строка(поля[имя]) }
        }
        вернуть json.записать(json.Объект(о))
    }
    перем части: [стр] = [время() + " " + название(уровень) + " " + сам.источник + ": " + одной_строкой(текст)]
    для имя в поля { части.добавить(одной_строкой(имя).заменить(" ", "_") + "=" + значение_поля(поля[имя])) }
    вернуть части.соединить(" ")
}

/// Записать строку уровня (если уровень не ниже наименьшего)
общий функ Журнал.запись(уровень: цел, текст: стр, поля: {стр: стр}) {
    если уровень < сам.уровень { вернуть }
    пусть строка = сам.строка(уровень, текст, поля)
    если сам.путь == "" {
        вывод_ошибки(строка)
    } иначе {
        дописать(сам.путь, строка + "\n")
    }
}

общий функ Журнал.отладка(текст: стр) { сам.запись(0, текст, {}) }
общий функ Журнал.сведения(текст: стр) { сам.запись(1, текст, {}) }
общий функ Журнал.предупреждение(текст: стр) { сам.запись(2, текст, {}) }
общий функ Журнал.ошибка(текст: стр) { сам.запись(3, текст, {}) }

/// Те же записи с полями: ж.сведения_с("запрос", {"путь": з.путь, "код": "200"})
общий функ Журнал.отладка_с(текст: стр, поля: {стр: стр}) { сам.запись(0, текст, поля) }
общий функ Журнал.сведения_с(текст: стр, поля: {стр: стр}) { сам.запись(1, текст, поля) }
общий функ Журнал.предупреждение_с(текст: стр, поля: {стр: стр}) { сам.запись(2, текст, поля) }
общий функ Журнал.ошибка_с(текст: стр, поля: {стр: стр}) { сам.запись(3, текст, поля) }
