/// Стандартная библиотека Дана: локальные языковые модели (файлы GGUF) через llama.cpp.
///
///     подключить "модели"
///     пусть м = модели.загрузить("модель.gguf")!
///     вывод(м.ответ("Столица Франции - ", модели.жадная())!)
///     пусть чат = [модели.Сообщение("user", "Привет!")]
///     пусть поток = м.начать_чат(чат, модели.Выборка())!
///     пока истина {
///         пусть часть = поток.следующая()!
///         если часть == "" { прервать }
///         модели.напечатать(часть)
///     }
///     м.освободить()
///
/// Библиотека llama.cpp не собирается с программой, а загружается при первой
/// загрузке модели (порядок поиска - в spec.md, раздел «Модели»). Если её нет,
/// загрузить() возвращает ошибку с объяснением, что делать.

/// Как загрузить модель
общий тип Настройки {
    /// размер контекста в токенах (запрос и ответ вместе); 0 - как в модели
    контекст: цел = 4096
    /// число потоков; 0 - как у пула Дана (DAN_POTOKI или число ядер)
    потоки: цел = 0
    /// отображать файл модели в память (mmap): модель не копируется в память целиком
    отображать_файл: лог = истина
    /// не загружать модель больше стольких мегабайт; 0 - без предела
    предел_памяти_мб: цел = 0
}

/// Как выбирать следующий токен
общий тип Выборка {
    /// 0 - всегда самый вероятный токен (жадная выборка): ответ повторяется
    температура: дроб = 0.8
    /// выбирать из стольких самых вероятных токенов; 0 - из всех
    верх_к: цел = 40
    /// выбирать из самых вероятных токенов с суммой вероятностей не больше этой; 1 - из всех
    верх_п: дроб = 0.95
    /// зерно случайной выборки: одно зерно - один ответ; -1 - каждый раз разное
    зерно: цел = -1
    /// наибольшее число токенов ответа; 0 - до конца контекста
    максимум_токенов: цел = 256
    /// ответ кончается перед первой из этих строк (сама строка в ответ не входит)
    стоп: [стр] = []
}

/// Сообщение чата: роль («system», «user», «assistant») и текст
общий тип Сообщение {
    роль: стр
    текст: стр
}

общий тип Модель { номер: цел }

/// Ответ, который выдаётся по частям
общий тип Поток {
    номер: цел
    /// сколько токенов запроса модель посчитала заново; остальные взяты из кэша начала
    /// (у повторного запроса с тем же началом - только новые токены)
    посчитано_заново: цел = 0
}

/// Загрузить модель из файла GGUF с настройками по умолчанию
общий функ загрузить(путь: стр) -> Модель! {
    вернуть загрузить_с_настройками(путь, Настройки())
}

общий функ загрузить_с_настройками(путь: стр, н: Настройки) -> Модель! {
    пусть номер = модель_загрузить(путь, н.контекст, н.потоки, н.отображать_файл, н.предел_памяти_мб)!
    вернуть Модель(номер)
}

/// Выборка без случайности: всегда самый вероятный токен
общий функ жадная() -> Выборка {
    вернуть Выборка(температура = 0.0)
}

/// Освободить память модели; после этого модель использовать нельзя
общий функ Модель.освободить() {
    модель_освободить(сам.номер)
}

/// Начать ответ на запрос (текст подаётся модели как есть); части - Поток.следующая()
общий функ Модель.начать(запрос: стр, выб: Выборка) -> Поток! {
    пусть посчитано = модель_начать(сам.номер, запрос, выб.температура, выб.верх_к, выб.верх_п, выб.зерно,
        выб.максимум_токенов, выб.стоп)!
    вернуть Поток(сам.номер, посчитано)
}

/// Следующая часть ответа (слово или несколько букв); пустая строка - ответ закончен
общий функ Поток.следующая() -> стр! {
    вернуть модель_часть(сам.номер)
}

/// Весь оставшийся ответ
общий функ Поток.остаток() -> стр! {
    перем итог = ""
    пока истина {
        пусть часть = модель_часть(сам.номер)!
        если часть == "" { прервать }
        итог += часть
    }
    вернуть итог
}

/// Ответ на запрос целиком
общий функ Модель.ответ(запрос: стр, выб: Выборка) -> стр! {
    пусть поток = сам.начать(запрос, выб)!
    вернуть поток.остаток()
}

/// Ответ по частям: каждая часть передаётся функции, как только появится;
/// функция возвращает ложь, чтобы остановить ответ. Результат - весь ответ.
общий функ Модель.ответ_по_частям(запрос: стр, выб: Выборка, получатель: функ(стр) -> лог) -> стр! {
    пусть поток = сам.начать(запрос, выб)!
    перем итог = ""
    пока истина {
        пусть часть = поток.следующая()!
        если часть == "" { прервать }
        итог += часть
        если не получатель(часть) { прервать }
    }
    вернуть итог
}

/// Запрос по шаблону чата самой модели (из файла GGUF), с началом ответа помощника
общий функ Модель.запрос_чата(сообщения: [Сообщение]) -> стр! {
    перем части: [стр] = []
    для с в сообщения {
        части.добавить(с.роль)
        части.добавить(с.текст)
    }
    вернуть модель_чат(сам.номер, части, истина)
}

/// Начать ответ в чате
общий функ Модель.начать_чат(сообщения: [Сообщение], выб: Выборка) -> Поток! {
    пусть запрос = сам.запрос_чата(сообщения)!
    вернуть сам.начать(запрос, выб)
}

/// Ответ в чате целиком
общий функ Модель.чат(сообщения: [Сообщение], выб: Выборка) -> стр! {
    пусть поток = сам.начать_чат(сообщения, выб)!
    вернуть поток.остаток()
}

/// Сколько токенов модели занимает текст
общий функ Модель.число_токенов(текст: стр) -> цел! {
    вернуть модель_токенов(сам.номер, текст)
}

/// Вывести текст без перевода строки и сразу показать (части ответа по мере появления)
общий функ напечатать(текст: стр) {
    модель_напечатать(текст)
}
