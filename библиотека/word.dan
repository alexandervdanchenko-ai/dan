// Стандартная библиотека Дана: документы Word (.docx, Office Open XML).
//
//     подключить "word"
//     // новый документ
//     word.создать("письмо.docx", [
//         word.заголовок("Уведомление", 1),
//         word.абзац("Сообщаем, что заказ готов."),
//         word.таблица([["Товар", "Количество"], ["Книга", "2"]])
//     ])!
//     // текст существующего документа
//     пусть д = word.открыть("договор.docx")!
//     вывод(д.текст())
//     // заполнение шаблона с полями {{имя}}
//     word.заполнить("шаблон.docx", "готовый.docx", {"имя": "Иванов И.И.", "дата": "26.10.2026"})!
//
// Документ .docx - это zip-архив с файлами XML; модуль читает и пишет их
// модулем xml, без Word и других программ.

подключить "xml"

// ---------- создание ----------

// Абзац и его оформление. Размер шрифта - в пунктах (0 - как во всём документе),
// выравнивание - "по_левому", "по_центру", "по_правому" или "по_ширине"
// ("" - как во всём документе), отступ первой строки - в сантиметрах.
общий тип Абзац {
    текст: стр
    жирный: лог = ложь
    курсив: лог = ложь
    подчёркнутый: лог = ложь
    размер: цел = 0
    шрифт: стр = ""
    выравнивание: стр = ""
    отступ_первой_строки: дроб = -1.0
}

// Часть документа
общий тип Блок {
    Текст(абзац: Абзац)
    Заголовок(текст: стр, уровень: цел)
    Таблица(строки: [[стр]], жирная_шапка: лог)
    РазрывСтраницы
}

// Оформление всего документа: шрифт, размер в пунктах, междустрочный
// интервал (1.0 - одинарный, 1.5 - полуторный), отступ первой строки
// абзацев в сантиметрах, выравнивание абзацев и поля страницы A4 в миллиметрах
общий тип Оформление {
    шрифт: стр = "Times New Roman"
    размер: цел = 12
    интервал: дроб = 1.0
    отступ_первой_строки: дроб = 0.0
    выравнивание: стр = "по_левому"
    поле_слева: цел = 30
    поле_справа: цел = 15
    поле_сверху: цел = 20
    поле_снизу: цел = 20
}

общий функ абзац(текст: стр) -> Блок {
    вернуть Текст(Абзац(текст))
}

общий функ жирный(текст: стр) -> Блок {
    вернуть Текст(Абзац(текст, жирный = истина))
}

общий функ по_центру(текст: стр) -> Блок {
    вернуть Текст(Абзац(текст, выравнивание = "по_центру"))
}

общий функ оформленный(а: Абзац) -> Блок {
    вернуть Текст(а)
}

// Заголовок уровня 1-3 (стили «Заголовок 1» - «Заголовок 3»: попадают в оглавление Word)
общий функ заголовок(текст: стр, уровень: цел) -> Блок {
    вернуть Заголовок(текст, уровень)
}

// Таблица с рамками; первая строка - шапка, она выделяется жирным
общий функ таблица(строки: [[стр]]) -> Блок {
    вернуть Таблица(строки, истина)
}

общий функ разрыв_страницы() -> Блок {
    вернуть РазрывСтраницы
}

// Документ из блоков с оформлением по умолчанию (Times New Roman 12, одинарный интервал)
общий функ создать(путь: стр, блоки: [Блок]) -> ! {
    записать(путь, документ(блоки, Оформление()))
}

общий функ создать_с_оформлением(путь: стр, блоки: [Блок], оф: Оформление) -> ! {
    если оф.размер < 1 или оф.размер > 400 { вернуть ошибка("размер шрифта должен быть от 1 до 400 пунктов") }
    записать(путь, документ(блоки, оф))
}

// Байты файла .docx (например, чтобы отправить его по почте, не записывая на диск)
общий функ документ(блоки: [Блок], оф: Оформление) -> байты {
    перем ч: [стр] = []
    ч.добавить("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n")
    ч.добавить("<w:document xmlns:w=\"" + пространство_w() + "\" xmlns:r=\"" + пространство_r() + "\"><w:body>")
    перем последний_таблица = ложь
    для б в блоки {
        выбор б {
            Текст(а) { ч.добавить(абзац_xml(а, "")) }
            Заголовок(т, у) {
                пусть ур = если_вне(у, 1, 3)
                ч.добавить(абзац_xml(Абзац(т), "Heading" + стр(ур)))
            }
            Таблица(строки, шапка) { ч.добавить(таблица_xml(строки, шапка)) }
            РазрывСтраницы { ч.добавить("<w:p><w:r><w:br w:type=\"page\"/></w:r></w:p>") }
        }
        выбор б {
            Таблица(_, _) { последний_таблица = истина }
            иначе { последний_таблица = ложь }
        }
    }
    если последний_таблица { ч.добавить("<w:p/>") }      // Word требует абзац после таблицы в конце
    ч.добавить("<w:sectPr><w:pgSz w:w=\"11906\" w:h=\"16838\"/><w:pgMar w:top=\"" + стр(мм(оф.поле_сверху)))
    ч.добавить("\" w:right=\"" + стр(мм(оф.поле_справа)) + "\" w:bottom=\"" + стр(мм(оф.поле_снизу)))
    ч.добавить("\" w:left=\"" + стр(мм(оф.поле_слева)) + "\" w:header=\"709\" w:footer=\"709\" w:gutter=\"0\"/>")
    ч.добавить("</w:sectPr></w:body></w:document>")
    вернуть собрать_архив([
        байты("[Content_Types].xml"), байты(типы_содержимого()),
        байты("_rels/.rels"), байты(связи_пакета()),
        байты("word/_rels/document.xml.rels"), байты(связи_документа()),
        байты("word/document.xml"), байты(ч.соединить("")),
        байты("word/styles.xml"), байты(стили(оф)),
        байты("docProps/core.xml"), байты(свойства_пакета())
    ])
}

функ если_вне(ч: цел, от: цел, до: цел) -> цел {
    если ч < от { вернуть от }
    если ч > до { вернуть до }
    вернуть ч
}

// миллиметры и сантиметры в двадцатых долях пункта (единица разметки Word)
функ мм(м: цел) -> цел {
    вернуть округлить(дроб(м) * 1440.0 / 25.4)
}

функ см(с: дроб) -> цел {
    вернуть округлить(с * 1440.0 / 2.54)
}

функ выравнивание_xml(вид: стр) -> стр {
    если вид == "по_центру" { вернуть "center" }
    если вид == "по_правому" { вернуть "right" }
    если вид == "по_ширине" { вернуть "both" }
    вернуть "left"
}

// Каждая строка текста (через "\n") - отдельный абзац с тем же оформлением;
// табуляции записываются знаком <w:tab/>
функ абзац_xml(а: Абзац, стиль: стр) -> стр {
    перем свойства: [стр] = []
    если стиль != "" { свойства.добавить("<w:pStyle w:val=\"" + стиль + "\"/>") }
    если а.отступ_первой_строки >= 0.0 {
        свойства.добавить("<w:ind w:firstLine=\"" + стр(см(а.отступ_первой_строки)) + "\"/>")
    }
    если а.выравнивание != "" { свойства.добавить("<w:jc w:val=\"" + выравнивание_xml(а.выравнивание) + "\"/>") }
    перем начало_абзаца = "<w:p>"
    если свойства.длина > 0 { начало_абзаца = "<w:p><w:pPr>" + свойства.соединить("") + "</w:pPr>" }
    перем оформление: [стр] = []
    если а.шрифт != "" {
        пусть ш = xml.экранировать_атрибут(а.шрифт)
        оформление.добавить("<w:rFonts w:ascii=\"" + ш + "\" w:hAnsi=\"" + ш + "\" w:cs=\"" + ш + "\"/>")
    }
    если а.жирный { оформление.добавить("<w:b/><w:bCs/>") }
    если а.курсив { оформление.добавить("<w:i/><w:iCs/>") }
    если а.подчёркнутый { оформление.добавить("<w:u w:val=\"single\"/>") }
    если а.размер > 0 {
        оформление.добавить("<w:sz w:val=\"" + стр(а.размер * 2) + "\"/><w:szCs w:val=\"" + стр(а.размер * 2) + "\"/>")
    }
    пусть начало_прогона = если_пусто(оформление)
    перем ч: [стр] = []
    для строка в а.текст.разбить("\n") {
        ч.добавить(начало_абзаца)
        если строка != "" {
            ч.добавить(начало_прогона)
            пусть куски = строка.разбить("\t")
            для к в 0..куски.длина - 1 {
                если к > 0 { ч.добавить("<w:tab/>") }
                если куски[к] != "" {
                    ч.добавить("<w:t xml:space=\"preserve\">" + xml.экранировать(куски[к]) + "</w:t>")
                }
            }
            ч.добавить("</w:r>")
        }
        ч.добавить("</w:p>")
    }
    вернуть ч.соединить("")
}

функ если_пусто(оформление: [стр]) -> стр {
    если оформление.длина == 0 { вернуть "<w:r>" }
    вернуть "<w:r><w:rPr>" + оформление.соединить("") + "</w:rPr>"
}

функ таблица_xml(строки: [[стр]], шапка: лог) -> стр {
    перем столбцов = 1
    для с в строки {
        если с.длина > столбцов { столбцов = с.длина }
    }
    перем ч: [стр] = ["<w:tbl><w:tblPr><w:tblStyle w:val=\"TableGrid\"/><w:tblW w:w=\"5000\" w:type=\"pct\"/>"]
    ч.добавить("<w:tblLook w:val=\"04A0\"/></w:tblPr><w:tblGrid>")
    // ширина страницы A4 без полей по умолчанию около 9 000 двадцатых пункта
    для _ в 1..столбцов { ч.добавить("<w:gridCol w:w=\"" + стр(частное(9000, столбцов)) + "\"/>") }
    ч.добавить("</w:tblGrid>")
    для н в 0..строки.длина - 1 {
        ч.добавить("<w:tr>")
        для к в 0..столбцов - 1 {
            перем т = ""
            если к < строки[н].длина { т = строки[н][к] }
            ч.добавить("<w:tc><w:tcPr><w:tcW w:w=\"0\" w:type=\"auto\"/></w:tcPr>")
            ч.добавить(абзац_xml(Абзац(т, жирный = шапка и н == 0), ""))
            ч.добавить("</w:tc>")
        }
        ч.добавить("</w:tr>")
    }
    ч.добавить("</w:tbl>")
    вернуть ч.соединить("")
}

функ стили(оф: Оформление) -> стр {
    пусть ш = xml.экранировать_атрибут(оф.шрифт)
    пусть р = стр(оф.размер * 2)
    перем ч: [стр] = ["<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n"]
    ч.добавить("<w:styles xmlns:w=\"" + пространство_w() + "\"><w:docDefaults><w:rPrDefault><w:rPr>")
    ч.добавить("<w:rFonts w:ascii=\"" + ш + "\" w:hAnsi=\"" + ш + "\" w:eastAsia=\"" + ш + "\" w:cs=\"" + ш + "\"/>")
    ч.добавить("<w:sz w:val=\"" + р + "\"/><w:szCs w:val=\"" + р + "\"/><w:lang w:val=\"ru-RU\" w:eastAsia=\"en-US\" w:bidi=\"ar-SA\"/>")
    ч.добавить("</w:rPr></w:rPrDefault><w:pPrDefault><w:pPr>")
    ч.добавить("<w:spacing w:after=\"0\" w:line=\"" + стр(округлить(оф.интервал * 240.0)) + "\" w:lineRule=\"auto\"/>")
    если оф.отступ_первой_строки > 0.0 {
        ч.добавить("<w:ind w:firstLine=\"" + стр(см(оф.отступ_первой_строки)) + "\"/>")
    }
    ч.добавить("<w:jc w:val=\"" + выравнивание_xml(оф.выравнивание) + "\"/>")
    ч.добавить("</w:pPr></w:pPrDefault></w:docDefaults>")
    ч.добавить("<w:style w:type=\"paragraph\" w:default=\"1\" w:styleId=\"Normal\"><w:name w:val=\"Normal\"/><w:qFormat/></w:style>")
    для у в 1..3 {
        пусть размер = стр(оф.размер * 2 + (4 - у) * 4)
        ч.добавить("<w:style w:type=\"paragraph\" w:styleId=\"Heading" + стр(у) + "\"><w:name w:val=\"heading " + стр(у))
        ч.добавить("\"/><w:basedOn w:val=\"Normal\"/><w:next w:val=\"Normal\"/><w:qFormat/><w:pPr><w:keepNext/>")
        ч.добавить("<w:spacing w:before=\"240\" w:after=\"120\"/><w:ind w:firstLine=\"0\"/><w:jc w:val=\"left\"/>")
        ч.добавить("<w:outlineLvl w:val=\"" + стр(у - 1) + "\"/></w:pPr><w:rPr><w:b/><w:bCs/>")
        ч.добавить("<w:sz w:val=\"" + размер + "\"/><w:szCs w:val=\"" + размер + "\"/></w:rPr></w:style>")
    }
    ч.добавить("<w:style w:type=\"table\" w:default=\"1\" w:styleId=\"TableNormal\"><w:name w:val=\"Normal Table\"/>")
    ч.добавить("<w:tblPr><w:tblInd w:w=\"0\" w:type=\"dxa\"/><w:tblCellMar><w:top w:w=\"0\" w:type=\"dxa\"/>")
    ч.добавить("<w:left w:w=\"108\" w:type=\"dxa\"/><w:bottom w:w=\"0\" w:type=\"dxa\"/><w:right w:w=\"108\" w:type=\"dxa\"/>")
    ч.добавить("</w:tblCellMar></w:tblPr></w:style>")
    ч.добавить("<w:style w:type=\"table\" w:styleId=\"TableGrid\"><w:name w:val=\"Table Grid\"/><w:basedOn w:val=\"TableNormal\"/>")
    ч.добавить("<w:pPr><w:ind w:firstLine=\"0\"/><w:jc w:val=\"left\"/></w:pPr><w:tblPr><w:tblBorders>")
    для сторона в ["top", "left", "bottom", "right", "insideH", "insideV"] {
        ч.добавить("<w:" + сторона + " w:val=\"single\" w:sz=\"4\" w:space=\"0\" w:color=\"auto\"/>")
    }
    ч.добавить("</w:tblBorders></w:tblPr></w:style></w:styles>")
    вернуть ч.соединить("")
}

функ пространство_w() -> стр {
    вернуть "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
}

функ пространство_r() -> стр {
    вернуть "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
}

функ типы_содержимого() -> стр {
    вернуть ("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
        "<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">" +
        "<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>" +
        "<Default Extension=\"xml\" ContentType=\"application/xml\"/>" +
        "<Override PartName=\"/word/document.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml\"/>" +
        "<Override PartName=\"/word/styles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml\"/>" +
        "<Override PartName=\"/docProps/core.xml\" ContentType=\"application/vnd.openxmlformats-package.core-properties+xml\"/>" +
        "</Types>")
}

функ связи_пакета() -> стр {
    вернуть ("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
        "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">" +
        "<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"word/document.xml\"/>" +
        "<Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/package/2006/relationships/metadata/core-properties\" Target=\"docProps/core.xml\"/>" +
        "</Relationships>")
}

функ связи_документа() -> стр {
    вернуть ("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
        "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">" +
        "<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" Target=\"styles.xml\"/>" +
        "</Relationships>")
}

функ свойства_пакета() -> стр {
    вернуть ("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>\n" +
        "<cp:coreProperties xmlns:cp=\"http://schemas.openxmlformats.org/package/2006/metadata/core-properties\" " +
        "xmlns:dc=\"http://purl.org/dc/elements/1.1/\"><dc:creator>Дан</dc:creator></cp:coreProperties>")
}

// ---------- чтение ----------

// Открытый документ: файлы архива и разобранный основной текст
общий тип Документ {
    файлы: [байты]
    тело: xml.Узел
}

общий функ открыть(путь: стр) -> Документ! {
    если не существует(путь) { вернуть ошибка("файл «" + путь + "» не найден") }
    вернуть из_байтов(прочитать_байты(путь))
}

общий функ из_байтов(данные: байты) -> Документ! {
    если данные.длина < 4 или данные[0] != 80 или данные[1] != 75 {
        вернуть ошибка("это не документ Word в формате .docx (старый формат .doc не поддерживается: " +
            "сохраните его в Word как .docx)")
    }
    пусть файлы = разобрать_архив(данные)
    пусть текст = файл_архива(файлы, "word/document.xml")
    если текст == ничего { вернуть ошибка("в архиве нет файла word/document.xml: это не документ Word") }
    пусть корень = xml.разобрать(текст иначе "")!
    вернуть Документ(файлы, корень)
}

функ файл_архива(файлы: [байты], имя: стр) -> стр? {
    перем к = 0
    пока к + 1 < файлы.длина {
        если стр(файлы[к]) == имя { вернуть стр(файлы[к + 1]) }
        к += 2
    }
    вернуть ничего
}

// Абзацы основного текста по порядку (абзацы внутри таблиц - в д.таблицы())
общий функ Документ.абзацы() -> [стр] {
    перем итог: [стр] = []
    если пусть тело = сам.тело.первый("w:body") {
        для у в тело.дети {
            если у.имя == "w:p" { итог.добавить(текст_абзаца(у)) }
        }
    }
    вернуть итог
}

// Таблицы: каждая - список строк, строка - список текстов ячеек
общий функ Документ.таблицы() -> [[[стр]]] {
    перем итог: [[[стр]]] = []
    для т в сам.тело.найти_все("w:tbl") { итог.добавить(строки_таблицы(т)) }
    вернуть итог
}

// Весь текст: абзацы через перевод строки, ячейки таблиц через табуляцию
общий функ Документ.текст() -> стр {
    перем ч: [стр] = []
    если пусть тело = сам.тело.первый("w:body") {
        для у в тело.дети {
            если у.имя == "w:p" {
                ч.добавить(текст_абзаца(у))
            } иначе если у.имя == "w:tbl" {
                для строка в строки_таблицы(у) { ч.добавить(строка.соединить("\t")) }
            }
        }
    }
    вернуть ч.соединить("\n")
}

функ строки_таблицы(т: xml.Узел) -> [[стр]] {
    перем строки: [[стр]] = []
    для тр в т.все("w:tr") {
        перем ячейки: [стр] = []
        для тц в тр.все("w:tc") {
            перем абзацы: [стр] = []
            для п в тц.все("w:p") { абзацы.добавить(текст_абзаца(п)) }
            ячейки.добавить(абзацы.соединить("\n"))
        }
        строки.добавить(ячейки)
    }
    вернуть строки
}

// Текст абзаца: <w:t>, табуляции, переносы строк; удалённый при правке текст пропускается
функ текст_абзаца(п: xml.Узел) -> стр {
    перем ч: [стр] = []
    перем стек: [xml.Узел] = [п]
    перем номера: [цел] = [0]
    пока стек.длина > 0 {
        пусть верх = стек.длина - 1
        пусть к = номера[верх]
        если к < стек[верх].дети.длина {
            номера[верх] = к + 1
            пусть у = стек[верх].дети[к]
            если у.имя == "w:t" {
                ч.добавить(у.весь_текст())
            } иначе если у.имя == "w:tab" {
                ч.добавить("\t")
            } иначе если (у.имя == "w:br" и у.атрибут("w:type") == ничего) или у.имя == "w:cr" {
                ч.добавить("\n")       // разрыв страницы или колонки - не перенос строки
            } иначе если у.имя != "" и у.имя != "w:del" и у.имя != "w:instrText" и у.имя != "w:p" {
                стек.добавить(у)
                номера.добавить(0)
            }
        } иначе {
            стек.удалить(верх)
            номера.удалить(верх)
        }
    }
    вернуть ч.соединить("")
}

// ---------- заполнение шаблона ----------

// Заменяет поля {{имя}} в тексте, колонтитулах и сносках документа значениями из
// словаря и записывает результат в новый файл. Поле может быть разорвано Word
// на несколько частей с разным оформлением - оно всё равно находится; значение
// получает оформление начала поля. Результат - имена полей шаблона, которых нет
// в словаре (они остаются в документе как есть).
общий функ заполнить(шаблон: стр, итог: стр, поля: {стр: стр}) -> [стр]! {
    если не существует(шаблон) { вернуть ошибка("файл «" + шаблон + "» не найден") }
    пусть данные = прочитать_байты(шаблон)
    если данные.длина < 4 или данные[0] != 80 или данные[1] != 75 {
        вернуть ошибка("«" + шаблон + "» - не документ Word в формате .docx")
    }
    пусть файлы = разобрать_архив(данные)
    перем новые: [байты] = []
    перем пропущено: [стр] = []
    перем к = 0
    пока к + 1 < файлы.длина {
        пусть имя = стр(файлы[к])
        если часть_с_текстом(имя) {
            пусть корень = xml.разобрать(стр(файлы[к + 1]))!
            пусть р = заполнить_узел(корень, поля)
            для н в р.пропущено {
                если не пропущено.содержит(н) { пропущено.добавить(н) }
            }
            новые.добавить(файлы[к])
            новые.добавить(байты(xml.записать_документ(р.узел)))
        } иначе {
            новые.добавить(файлы[к])
            новые.добавить(файлы[к + 1])
        }
        к += 2
    }
    записать(итог, собрать_архив(новые))
    вернуть пропущено
}

// Части документа, где могут быть поля: основной текст, колонтитулы, сноски
функ часть_с_текстом(имя: стр) -> лог {
    если имя == "word/document.xml" или имя == "word/footnotes.xml" или имя == "word/endnotes.xml" { вернуть истина }
    вернуть (имя.начинается("word/header") или имя.начинается("word/footer")) и имя.оканчивается(".xml")
}

тип Заполнено { узел: xml.Узел, пропущено: [стр] }

функ заполнить_узел(у: xml.Узел, поля: {стр: стр}) -> Заполнено {
    перем пропущено: [стр] = []
    если у.имя == "w:p" {
        пусть р = заменить_поля(тексты_абзаца(у), поля)
        если р.изменено {
            вернуть Заполнено(вставить_тексты(у, р.тексты, 0).узел, р.пропущено)
        }
        вернуть Заполнено(у, р.пропущено)
    }
    если у.имя == "" { вернуть Заполнено(у, пропущено) }
    перем дети: [xml.Узел] = []
    для ребёнок в у.дети {
        пусть з = заполнить_узел(ребёнок, поля)
        для н в з.пропущено { пропущено.добавить(н) }
        дети.добавить(з.узел)
    }
    вернуть Заполнено(xml.Узел(у.имя, у.атрибуты, дети), пропущено)
}

// Тексты элементов <w:t> абзаца по порядку (удалённый при правке текст не учитывается)
функ тексты_абзаца(у: xml.Узел) -> [стр] {
    перем итог: [стр] = []
    для р в у.дети {
        если р.имя == "w:t" {
            итог.добавить(р.весь_текст())
        } иначе если р.имя != "" и р.имя != "w:del" и р.имя != "w:p" {
            для т в тексты_абзаца(р) { итог.добавить(т) }
        }
    }
    вернуть итог
}

тип Замена { тексты: [стр], изменено: лог, пропущено: [стр] }

// Поля {{имя}} в текстах частей абзаца. Поле может начинаться в одной части и
// кончаться в другой: значение попадает в часть, где поле начинается, а
// остальные знаки поля удаляются из своих частей.
функ заменить_поля(тексты: [стр], поля: {стр: стр}) -> Замена {
    перем знаки: [стр] = []
    перем чьи: [цел] = []
    для н в 0..тексты.длина - 1 {
        для з в тексты[н].символы() {
            знаки.добавить(з)
            чьи.добавить(н)
        }
    }
    перем новые: [стр] = []
    перем новые_чьи: [цел] = []
    перем пропущено: [стр] = []
    перем изменено = ложь
    перем к = 0
    пока к < знаки.длина {
        если к + 1 < знаки.длина и знаки[к] == "{" и знаки[к + 1] == "{" {
            перем конец = -1
            перем м = к + 2
            пока м + 1 < знаки.длина и конец < 0 {
                если знаки[м] == "}" и знаки[м + 1] == "}" { конец = м }
                если знаки[м] == "{" и знаки[м + 1] == "{" { м = знаки.длина }     // вложенное начало - не поле
                м += 1
            }
            если конец > 0 {
                пусть имя = знаки[к + 2..конец - 1].соединить("").обрезать()
                если пусть значение = поля.найти(имя) {
                    новые.добавить(значение.заменить("\n", " "))
                    новые_чьи.добавить(чьи[к])
                    изменено = истина
                    к = конец + 2
                    продолжить
                }
                если имя != "" и не пропущено.содержит(имя) { пропущено.добавить(имя) }
            }
        }
        новые.добавить(знаки[к])
        новые_чьи.добавить(чьи[к])
        к += 1
    }
    перем части: [[стр]] = []
    для _ в тексты { части.добавить([]) }
    для н в 0..новые.длина - 1 { части[новые_чьи[н]].добавить(новые[н]) }
    перем итог: [стр] = []
    для ч в части { итог.добавить(ч.соединить("")) }
    вернуть Замена(итог, изменено, пропущено)
}

тип Вставка { узел: xml.Узел, номер: цел }

// Узел, в котором тексты <w:t> по порядку заменены новыми
функ вставить_тексты(у: xml.Узел, тексты: [стр], номер: цел) -> Вставка {
    если у.имя == "w:t" {
        перем атрибуты = у.атрибуты
        атрибуты["xml:space"] = "preserve"
        вернуть Вставка(xml.Узел("w:t", атрибуты, [xml.текст(тексты[номер])]), номер + 1)
    }
    если у.имя == "" или у.имя == "w:del" { вернуть Вставка(у, номер) }
    перем дети: [xml.Узел] = []
    перем н = номер
    для р в у.дети {
        если р.имя == "w:p" и у.имя != "w:p" {
            дети.добавить(р)
        } иначе {
            пусть вст = вставить_тексты(р, тексты, н)
            дети.добавить(вст.узел)
            н = вст.номер
        }
    }
    вернуть Вставка(xml.Узел(у.имя, у.атрибуты, дети), н)
}
