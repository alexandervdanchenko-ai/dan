/// Стандартная библиотека Дана: электронная почта (SMTP, IMAP, MIME).
///
///     подключить "почта"
///     пусть ящик = почта.Ящик("ivanov@yandex.ru", "пароль приложения")
///     // отправка письма с вложением
///     почта.отправить(ящик, почта.Письмо(["petrov@mail.ru"], "Отчёт", "Добрый день! Отчёт во вложении.",
///                                        вложения = ["отчёт.pdf"]))!
///     // чтение новых писем
///     для номер в почта.новые(ящик)! {
///         пусть п = почта.получить(ящик, "INBOX", номер)!
///         вывод(п.от + ": " + п.тема)
///         п.сохранить_вложения("вложения")!
///     }
///
/// Почтовые службы требуют для программ отдельный «пароль приложения»,
/// который создаётся в настройках безопасности ящика (Яндекс, Mail.ru, Gmail).

/// Почтовый ящик. Серверы по умолчанию определяются по адресу ящика (Яндекс,
/// Mail.ru, Gmail, Рамблер; для других доменов - smtp.домен и imap.домен).
/// Защита: "ssl" (порты 465 и 993), "starttls" (обычно порт 587) или "нет"
/// (только для серверов внутри своей сети).
общий тип Ящик {
    адрес: стр
    пароль: стр
    имя: стр = ""
    пользователь: стр = ""
    smtp: стр = ""
    imap: стр = ""
    порт_smtp: цел = 0
    порт_imap: цел = 0
    защита: стр = "ssl"
}

/// Письмо. Получатели - адреса вида "petrov@mail.ru" или "Петров П.П. <petrov@mail.ru>";
/// вложения - пути к файлам; html - вариант текста с оформлением (необязателен).
общий тип Письмо {
    кому: [стр]
    тема: стр
    текст: стр
    копия: [стр] = []
    скрытая_копия: [стр] = []
    вложения: [стр] = []
    html: стр = ""
    ответить_на: стр = ""
}

общий тип Вложение {
    имя: стр
    вид: стр
    данные: байты
}

/// Полученное письмо: номер (UID в папке), заголовки, текст, вариант с
/// оформлением (html) и вложения
общий тип Полученное {
    номер: цел
    от: стр
    кому: стр
    копия: стр
    тема: стр
    дата: стр
    текст: стр
    html: стр
    вложения: [Вложение]
}

// ---------- серверы ----------

функ домен(адрес: стр) -> стр {
    пусть е = чистый_адрес(адрес)
    пусть к = е.найти("@")
    если к < 0 { вернуть "" }
    вернуть е[к + 1..е.длина - 1].строчные()
}

функ сервер(я: Ящик, вид: стр) -> стр {
    если вид == "smtp" и я.smtp != "" { вернуть я.smtp }
    если вид == "imap" и я.imap != "" { вернуть я.imap }
    пусть д = домен(я.адрес)
    если д == "yandex.ru" или д == "ya.ru" или д == "yandex.com" { вернуть вид + ".yandex.ru" }
    если д == "mail.ru" или д == "bk.ru" или д == "inbox.ru" или д == "list.ru" или д == "internet.ru" {
        вернуть вид + ".mail.ru"
    }
    если д == "gmail.com" или д == "googlemail.com" { вернуть вид + ".gmail.com" }
    если д == "rambler.ru" или д == "lenta.ru" или д == "ro.ru" { вернуть вид + ".rambler.ru" }
    вернуть вид + "." + д
}

функ адрес_сервера(я: Ящик, вид: стр, порт: цел) -> стр {
    перем схема = вид + "s"
    перем п = порт
    если я.защита != "ssl" { схема = вид }
    если п == 0 {
        если вид == "smtp" {
            п = 465
            если я.защита != "ssl" { п = 587 }
        } иначе {
            п = 993
            если я.защита != "ssl" { п = 143 }
        }
    }
    вернуть схема + "://" + сервер(я, вид) + ":" + стр(п)
}

функ пользователь(я: Ящик) -> стр {
    если я.пользователь != "" { вернуть я.пользователь }
    вернуть чистый_адрес(я.адрес)
}

/// "Петров П.П. <petrov@mail.ru>" -> "petrov@mail.ru"
общий функ чистый_адрес(адрес: стр) -> стр {
    пусть н = адрес.найти("<")
    если н >= 0 {
        пусть к = адрес.найти(">")
        если к > н { вернуть адрес[н + 1..к - 1].обрезать() }
    }
    вернуть адрес.обрезать()
}

// ---------- отправка ----------

общий функ отправить(я: Ящик, п: Письмо) -> ! {
    если я.защита != "ssl" и я.защита != "starttls" и я.защита != "нет" {
        вернуть ошибка("защита соединения: \"ssl\", \"starttls\" или \"нет\"")
    }
    пусть данные = собрать(я, п)!
    перем получатели: [стр] = []
    для а в п.кому { получатели.добавить("<" + чистый_адрес(а) + ">") }
    для а в п.копия { получатели.добавить("<" + чистый_адрес(а) + ">") }
    для а в п.скрытая_копия { получатели.добавить("<" + чистый_адрес(а) + ">") }
    если получатели.длина == 0 { вернуть ошибка("у письма нет получателей") }
    почтовый_запрос(адрес_сервера(я, "smtp", я.порт_smtp), пользователь(я), я.пароль,
        "<" + чистый_адрес(я.адрес) + ">", получатели, данные, "",
        я.защита == "starttls", 300)!
}

/// Письмо в формате MIME (RFC 5322): заголовки, текст и вложения
общий функ собрать(я: Ящик, п: Письмо) -> байты! {
    перем ч: [стр] = []
    перем от = чистый_адрес(я.адрес)
    если я.имя != "" { от = слово_заголовка(я.имя) + " <" + от + ">" }
    ч.добавить("From: " + от)
    если п.кому.длина > 0 { ч.добавить("To: " + адреса_заголовка(п.кому)) }
    если п.копия.длина > 0 { ч.добавить("Cc: " + адреса_заголовка(п.копия)) }
    если п.ответить_на != "" { ч.добавить("Reply-To: " + адреса_заголовка([п.ответить_на])) }
    ч.добавить("Subject: " + слово_заголовка(п.тема))
    ч.добавить("Date: " + дата_для_письма())
    ч.добавить("Message-ID: <" + хеш(дата_для_письма() + п.тема + стр(метка_времени()))[0..23] + "@" + домен(я.адрес) + ">")
    ч.добавить("MIME-Version: 1.0")
    пусть граница = "=_dan_" + хеш(п.текст + стр(метка_времени()))[0..15]
    пусть текст_часть = часть_текста(п.текст, п.html, граница + "a")
    если п.вложения.длина == 0 {
        для с в текст_часть { ч.добавить(с) }
    } иначе {
        ч.добавить("Content-Type: multipart/mixed; boundary=\"" + граница + "\"")
        ч.добавить("")
        ч.добавить("--" + граница)
        для с в текст_часть { ч.добавить(с) }
        для путь в п.вложения {
            если не существует(путь) { вернуть ошибка("вложение «" + путь + "» не найдено") }
            пусть имя = имя_файла(путь)
            ч.добавить("--" + граница)
            ч.добавить("Content-Type: " + тип_файла(имя) + "; name=\"" + слово_заголовка(имя) + "\"")
            ч.добавить("Content-Disposition: attachment; filename=\"" + слово_заголовка(имя) + "\"")
            ч.добавить("Content-Transfer-Encoding: base64")
            ч.добавить("")
            ч.добавить(в_base64(прочитать_байты(путь), 76))
        }
        ч.добавить("--" + граница + "--")
    }
    вернуть байты(ч.соединить(символ_по_коду(13) + "\n") + символ_по_коду(13) + "\n")
}

// Текст письма (и его вариант html) в виде строк части MIME
функ часть_текста(текст: стр, html: стр, граница: стр) -> [стр] {
    перем ч: [стр] = []
    если html == "" {
        ч.добавить("Content-Type: text/plain; charset=utf-8")
        ч.добавить("Content-Transfer-Encoding: base64")
        ч.добавить("")
        ч.добавить(в_base64(байты(текст), 76))
        вернуть ч
    }
    ч.добавить("Content-Type: multipart/alternative; boundary=\"" + граница + "\"")
    ч.добавить("")
    ч.добавить("--" + граница)
    ч.добавить("Content-Type: text/plain; charset=utf-8")
    ч.добавить("Content-Transfer-Encoding: base64")
    ч.добавить("")
    ч.добавить(в_base64(байты(текст), 76))
    ч.добавить("--" + граница)
    ч.добавить("Content-Type: text/html; charset=utf-8")
    ч.добавить("Content-Transfer-Encoding: base64")
    ч.добавить("")
    ч.добавить(в_base64(байты(html), 76))
    ч.добавить("--" + граница + "--")
    вернуть ч
}

/// Значение заголовка с русскими буквами: =?UTF-8?B?...?= частями не длиннее 75 знаков (RFC 2047)
общий функ слово_заголовка(с: стр) -> стр {
    перем простой = истина
    для з в с.символы() {
        если код_символа(з) > 126 или код_символа(з) < 32 или з == "\"" { простой = ложь }
    }
    если простой { вернуть с }
    перем слова: [стр] = []
    перем кусок = ""
    перем байтов = 0
    для з в с.символы() {
        пусть б = байты(з).длина
        если байтов + б > 45 {
            слова.добавить("=?UTF-8?B?" + в_base64(кусок) + "?=")
            кусок = ""
            байтов = 0
        }
        кусок = кусок + з
        байтов += б
    }
    если кусок != "" { слова.добавить("=?UTF-8?B?" + в_base64(кусок) + "?=") }
    вернуть слова.соединить(" ")
}

функ адреса_заголовка(адреса: [стр]) -> стр {
    перем ч: [стр] = []
    для а в адреса {
        пусть н = а.найти("<")
        если н > 0 {
            пусть имя = а[0..н - 1].обрезать().заменить("\"", "")
            ч.добавить(слово_заголовка(имя) + " <" + чистый_адрес(а) + ">")
        } иначе {
            ч.добавить(чистый_адрес(а))
        }
    }
    вернуть ч.соединить(", ")
}

функ имя_файла(путь: стр) -> стр {
    перем имя = путь
    для разделитель в ["/", "\\"] {
        пусть части = имя.разбить(разделитель)
        имя = части[части.длина - 1]
    }
    вернуть имя
}

функ тип_файла(имя: стр) -> стр {
    пусть н = имя.строчные()
    если н.оканчивается(".pdf") { вернуть "application/pdf" }
    если н.оканчивается(".docx") { вернуть "application/vnd.openxmlformats-officedocument.wordprocessingml.document" }
    если н.оканчивается(".xlsx") { вернуть "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }
    если н.оканчивается(".doc") { вернуть "application/msword" }
    если н.оканчивается(".xls") { вернуть "application/vnd.ms-excel" }
    если н.оканчивается(".zip") { вернуть "application/zip" }
    если н.оканчивается(".txt") { вернуть "text/plain; charset=utf-8" }
    если н.оканчивается(".csv") { вернуть "text/csv; charset=utf-8" }
    если н.оканчивается(".jpg") или н.оканчивается(".jpeg") { вернуть "image/jpeg" }
    если н.оканчивается(".png") { вернуть "image/png" }
    если н.оканчивается(".html") или н.оканчивается(".htm") { вернуть "text/html; charset=utf-8" }
    вернуть "application/octet-stream"
}

// ---------- чтение ----------

/// Номера (UID) писем папки, подходящих под условие поиска IMAP:
/// "ALL" - все, "UNSEEN" - непрочитанные, "FROM \"ivanov\"", "SINCE 01-Oct-2026", "SUBJECT \"отчёт\""
общий функ найти(я: Ящик, папка: стр, условие: стр) -> [цел]! {
    пусть ответ = стр(почтовый_запрос(адрес_сервера(я, "imap", я.порт_imap) + "/" + путь_папки(папка),
        пользователь(я), я.пароль, "", [], байты(""), "UID SEARCH CHARSET UTF-8 " + условие,
        я.защита == "starttls", 120)!)
    перем номера: [цел] = []
    для строка в ответ.разбить("\n") {
        пусть с = строка.обрезать()
        если с.начинается("* SEARCH") {
            для слово в с.разбить(" ") {
                если пусть н = разобрать_цел(слово) { номера.добавить(н) }
            }
        }
    }
    вернуть номера
}

/// Непрочитанные письма папки «Входящие»
общий функ новые(я: Ящик) -> [цел]! {
    вернуть найти(я, "INBOX", "UNSEEN")!
}

/// Письмо по номеру (UID); после чтения сервер отмечает его прочитанным
общий функ получить(я: Ящик, папка: стр, номер: цел) -> Полученное! {
    пусть данные = почтовый_запрос(адрес_сервера(я, "imap", я.порт_imap) + "/" + путь_папки(папка) + ";UID=" + стр(номер),
        пользователь(я), я.пароль, "", [], байты(""), "", я.защита == "starttls", 300)!
    пусть п = разобрать(данные)
    вернуть Полученное(номер, п.от, п.кому, п.копия, п.тема, п.дата, п.текст, п.html, п.вложения)
}

/// Имена папок ящика (русские имена раскодируются)
общий функ папки(я: Ящик) -> [стр]! {
    пусть ответ = стр(почтовый_запрос(адрес_сервера(я, "imap", я.порт_imap) + "/", пользователь(я), я.пароль, "", [],
        байты(""), "LIST \"\" \"*\"", я.защита == "starttls", 120)!)
    перем итог: [стр] = []
    для строка в ответ.разбить("\n") {
        пусть с = строка.обрезать()
        если не с.начинается("* LIST") { продолжить }
        // * LIST (\HasNoChildren) "/" "INBOX" - имя в конце строки, возможно в кавычках
        перем имя = ""
        если с.оканчивается("\"") {
            пусть знаки = с.символы()
            перем к = знаки.длина - 2
            пока к >= 0 и знаки[к] != "\"" { к -= 1 }
            имя = знаки[к + 1..знаки.длина - 2].соединить("")
        } иначе {
            пусть части = с.разбить(" ")
            имя = части[части.длина - 1]
        }
        итог.добавить(из_utf7(имя))
    }
    вернуть итог
}

// Имя папки в адресе: модифицированный UTF-7 (RFC 3501) и %-запись
функ путь_папки(папка: стр) -> стр {
    перем ч: [стр] = []
    для з в в_utf7(папка).символы() {
        если з == " " {
            ч.добавить("%20")
        } иначе если з == "%" {
            ч.добавить("%25")
        } иначе если з == "?" {
            ч.добавить("%3F")
        } иначе если з == "#" {
            ч.добавить("%23")
        } иначе {
            ч.добавить(з)
        }
    }
    вернуть ч.соединить("")
}

// Русские буквы в имени папки IMAP: &...- с UTF-16 в Base64 (знак / заменён на ,)
функ в_utf7(с: стр) -> стр {
    перем ч: [стр] = []
    перем кодовые: [цел] = []
    для з в с.символы() {
        пусть к = код_символа(з)
        если к >= 32 и к < 127 {
            если кодовые.длина > 0 {
                ч.добавить(блок_utf7(кодовые))
                кодовые = []
            }
            если з == "&" { ч.добавить("&-") } иначе { ч.добавить(з) }
        } иначе {
            кодовые.добавить(к)
        }
    }
    если кодовые.длина > 0 { ч.добавить(блок_utf7(кодовые)) }
    вернуть ч.соединить("")
}

функ блок_utf7(кодовые: [цел]) -> стр {
    перем б: [цел] = []
    для к в кодовые {
        если к > 65535 {
            пусть сдвиг = к - 65536
            пусть старший = 55296 + частное(сдвиг, 1024)
            пусть младший = 56320 + сдвиг % 1024
            для е в [старший, младший] {
                б.добавить(частное(е, 256))
                б.добавить(е % 256)
            }
        } иначе {
            б.добавить(частное(к, 256))
            б.добавить(к % 256)
        }
    }
    вернуть "&" + в_base64(байты(б)).заменить("/", ",").заменить("=", "") + "-"
}

функ из_utf7(с: стр) -> стр {
    если не с.содержит("&") { вернуть с }
    перем ч: [стр] = []
    пусть знаки = с.символы()
    перем к = 0
    пока к < знаки.длина {
        если знаки[к] != "&" {
            ч.добавить(знаки[к])
            к += 1
            продолжить
        }
        перем конец = к + 1
        пока конец < знаки.длина и знаки[конец] != "-" { конец += 1 }
        если конец == к + 1 {
            ч.добавить("&")
        } иначе {
            перем запись = знаки[к + 1..конец - 1].соединить("").заменить(",", "/")
            пока запись.длина % 4 != 0 { запись = запись + "=" }
            если пусть б = из_base64(запись) {
                перем н = 0
                пока н + 1 < б.длина {
                    перем е = б[н] * 256 + б[н + 1]
                    н += 2
                    если е >= 55296 и е < 56320 и н + 1 < б.длина {
                        пусть младший = б[н] * 256 + б[н + 1]
                        е = 65536 + (е - 55296) * 1024 + (младший - 56320)
                        н += 2
                    }
                    ч.добавить(символ_по_коду(е))
                }
            }
        }
        к = конец + 1
    }
    вернуть ч.соединить("")
}

/// Письмо из данных в формате MIME (например, из файла .eml)
общий функ разобрать(данные: байты) -> Полученное {
    пусть события = разобрать_письмо(данные)
    перем от = ""
    перем кому = ""
    перем копия = ""
    перем тема = ""
    перем отправлено = ""
    перем текст = ""
    перем html = ""
    перем вложения: [Вложение] = []
    перем к = 0
    пока к < события.длина {
        если стр(события[к]) == "з" {
            пусть имя = стр(события[к + 1])
            пусть значение = стр(события[к + 2])
            если имя == "from" { от = значение }
            если имя == "to" { кому = значение }
            если имя == "cc" { копия = значение }
            если имя == "subject" { тема = значение }
            если имя == "date" { отправлено = значение }
            к += 3
        } иначе {
            пусть вид_части = стр(события[к + 1])
            пусть файл = стр(события[к + 2])
            пусть расположение = стр(события[к + 3])
            пусть содержимое = события[к + 4]
            если файл == "" и расположение != "attachment" и вид_части == "text/plain" и текст == "" {
                текст = стр(содержимое)
            } иначе если файл == "" и расположение != "attachment" и вид_части == "text/html" и html == "" {
                html = стр(содержимое)
            } иначе если файл != "" или расположение == "attachment" {
                перем имя = файл
                если имя == "" { имя = "вложение" + стр(вложения.длина + 1) }
                вложения.добавить(Вложение(имя, вид_части, содержимое))
            }
            к += 5
        }
    }
    вернуть Полученное(0, от, кому, копия, тема, отправлено, текст, html, вложения)
}

/// Сохраняет вложения письма в папку; результат - пути сохранённых файлов.
/// Имена, которые вывели бы файл за пределы папки, заменяются безопасными.
общий функ Полученное.сохранить_вложения(папка: стр) -> [стр]! {
    создать_папку(папка)
    перем пути: [стр] = []
    перем занятые: [стр] = []
    для вл в сам.вложения {
        перем имя = имя_файла(вл.имя)
        для з в [":", "*", "?", "\"", "<", ">", "|"] { имя = имя.заменить(з, "_") }
        если имя == "" или имя == "." или имя == ".." { имя = "вложение" }
        перем итог = имя
        перем н = 2
        пока занятые.содержит(итог.строчные()) {
            итог = стр(н) + "_" + имя
            н += 1
        }
        занятые.добавить(итог.строчные())
        пусть путь = папка + "/" + итог
        записать(путь, вл.данные)
        пути.добавить(путь)
    }
    вернуть пути
}
