/// Стандартная библиотека Дана: документы PDF.
///
///     подключить "pdf"
///     // новый документ: русские буквы, переносы строк, таблицы, номера страниц
///     pdf.создать("справка.pdf", [
///         pdf.заголовок("Справка", 1),
///         pdf.абзац("Выдана Иванову И.И. в том, что он действительно работает в организации."),
///         pdf.таблица([["Месяц", "Сумма"], ["Сентябрь", "65 000"], ["Октябрь", "65 000"]])
///     ])!
///     // текст существующего документа: по строке на страницу
///     для страница в pdf.страницы("договор.pdf")! { вывод(страница) }
///
/// Документ набирается шрифтом TrueType, установленным в системе (Times New
/// Roman в Windows и macOS, Liberation Serif или DejaVu Serif в Linux); в файл
/// встраиваются только нужные знаки шрифта.

// ---------- чтение ----------

/// Текст страниц документа (строки страницы - через перевод строки)
общий функ страницы(путь: стр) -> [стр]! {
    если не существует(путь) { вернуть ошибка("файл «" + путь + "» не найден") }
    вернуть текст_pdf(прочитать_байты(путь))
}

общий функ страницы_из_байтов(данные: байты) -> [стр]! {
    вернуть текст_pdf(данные)
}

// ---------- создание ----------

/// Абзац. Размер шрифта - в пунктах (0 - как во всём документе), выравнивание -
/// "по_левому", "по_центру", "по_правому" или "по_ширине" ("" - как во всём документе).
общий тип Абзац {
    текст: стр
    жирный: лог = ложь
    размер: дроб = 0.0
    выравнивание: стр = ""
}

общий тип Блок {
    Текст(абзац: Абзац)
    Заголовок(текст: стр, уровень: цел)
    Таблица(строки: [[стр]], шапка: лог)
    РазрывСтраницы
}

/// Оформление документа. Шрифты - пути к файлам .ttf ("" - найти шрифт системы),
/// размер в пунктах, интервал - множитель высоты строки, отступ первой строки -
/// в сантиметрах, поля страницы A4 - в миллиметрах.
общий тип Оформление {
    шрифт: стр = ""
    жирный_шрифт: стр = ""
    размер: дроб = 12.0
    интервал: дроб = 1.2
    отступ_первой_строки: дроб = 0.0
    выравнивание: стр = "по_левому"
    поле_слева: цел = 30
    поле_справа: цел = 15
    поле_сверху: цел = 20
    поле_снизу: цел = 20
    номера_страниц: лог = истина
}

общий функ абзац(с: стр) -> Блок {
    вернуть Текст(Абзац(с))
}

общий функ жирный(с: стр) -> Блок {
    вернуть Текст(Абзац(с, жирный = истина))
}

общий функ по_центру(с: стр) -> Блок {
    вернуть Текст(Абзац(с, выравнивание = "по_центру"))
}

общий функ оформленный(а: Абзац) -> Блок {
    вернуть Текст(а)
}

общий функ заголовок(с: стр, уровень: цел) -> Блок {
    вернуть Заголовок(с, уровень)
}

/// Таблица с рамками; первая строка - шапка: жирная и повторяется на каждой странице
общий функ таблица(строки: [[стр]]) -> Блок {
    вернуть Таблица(строки, истина)
}

общий функ разрыв_страницы() -> Блок {
    вернуть РазрывСтраницы
}

общий функ создать(путь: стр, блоки: [Блок]) -> ! {
    записать(путь, документ(блоки, Оформление())!)
}

общий функ создать_с_оформлением(путь: стр, блоки: [Блок], оф: Оформление) -> ! {
    записать(путь, документ(блоки, оф)!)
}

// Шрифт системы: сначала с засечками (как в документах), затем без них
функ найти_шрифт(полужирный: лог) -> стр {
    перем пути: [стр] = []
    если полужирный {
        пути = ["C:/Windows/Fonts/timesbd.ttf", "/System/Library/Fonts/Supplemental/Times New Roman Bold.ttf",
            "/Library/Fonts/Times New Roman Bold.ttf",
            "/usr/share/fonts/truetype/liberation/LiberationSerif-Bold.ttf",
            "/usr/share/fonts/liberation-serif/LiberationSerif-Bold.ttf",
            "/usr/share/fonts/TTF/LiberationSerif-Bold.ttf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf", "/usr/share/fonts/TTF/DejaVuSerif-Bold.ttf",
            "C:/Windows/Fonts/arialbd.ttf", "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"]
    } иначе {
        пути = ["C:/Windows/Fonts/times.ttf", "/System/Library/Fonts/Supplemental/Times New Roman.ttf",
            "/Library/Fonts/Times New Roman.ttf",
            "/usr/share/fonts/truetype/liberation/LiberationSerif-Regular.ttf",
            "/usr/share/fonts/liberation-serif/LiberationSerif-Regular.ttf",
            "/usr/share/fonts/TTF/LiberationSerif-Regular.ttf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf", "/usr/share/fonts/TTF/DejaVuSerif.ttf",
            "C:/Windows/Fonts/arial.ttf", "/System/Library/Fonts/Supplemental/Arial.ttf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"]
    }
    для п в пути {
        если существует(п) { вернуть п }
    }
    вернуть ""
}

функ пункты(мм: цел) -> дроб {
    вернуть дроб(мм) * 72.0 / 25.4
}

// Команда вывода текста для собрать_pdf (знаки табуляции и перевода строки заменяются пробелом)
функ т(шрифт: цел, размер: дроб, обводка: лог, x: дроб, y: дроб, с: стр) -> стр {
    перем ж = "0"
    если обводка { ж = "1" }
    пусть чистый = с.заменить("\t", " ").заменить("\n", " ").заменить(символ_по_коду(13), " ")
    вернуть "T\t" + стр(шрифт) + "\t" + стр(размер) + "\t" + ж + "\t" + стр(x) + "\t" + стр(y) + "\t" + чистый
}

// Строки абзаца шириной не больше заданной; слово длиннее строки делится по знакам
функ строки_текста(исходный: стр, шрифт: цел, размер: дроб, ширина: дроб, отступ: дроб) -> [стр] {
    перем итог: [стр] = []
    перем строка = ""
    перем доступно = ширина - отступ
    для слово в исходный.разбить(" ") {
        если слово == "" { продолжить }
        перем кандидат = слово
        если строка != "" { кандидат = строка + " " + слово }
        если ширина_pdf(шрифт, кандидат, размер) <= доступно {
            строка = кандидат
            продолжить
        }
        если строка != "" {
            итог.добавить(строка)
            доступно = ширина
            строка = ""
        }
        // слово не помещается в целую строку: делится по знакам
        перем кусок = ""
        для з в слово.символы() {
            если кусок != "" и ширина_pdf(шрифт, кусок + з, размер) > доступно {
                итог.добавить(кусок)
                доступно = ширина
                кусок = ""
            }
            кусок = кусок + з
        }
        строка = кусок
    }
    если строка != "" или итог.длина == 0 { итог.добавить(строка) }
    вернуть итог
}

// Ряд таблицы: команды рисования относительно верха ряда (y = 0) и его высота
тип Ряд { команды: [стр], высота: дроб }

функ ряд_таблицы(значения: [стр], столбцов: цел, ф: цел, размер: дроб, высота_строки: дроб, слева: дроб,
    ширины: [дроб], обводка: лог) -> Ряд {
    пусть поле = 3.0
    перем ячейки: [[стр]] = []
    перем строк_в_ряду = 1
    для к в 0..столбцов - 1 {
        перем текст_ячейки = ""
        если к < значения.длина { текст_ячейки = значения[к] }
        перем части: [стр] = []
        для абз в текст_ячейки.разбить("\n") {
            для с в строки_текста(абз, ф, размер, ширины[к] - 2.0 * поле, 0.0) { части.добавить(с) }
        }
        если части.длина > строк_в_ряду { строк_в_ряду = части.длина }
        ячейки.добавить(части)
    }
    пусть высота = дроб(строк_в_ряду) * высота_строки + 2.0 * поле
    перем команды: [стр] = []
    перем x = слева
    для к в 0..столбцов - 1 {
        команды.добавить("R\t" + стр(x) + "\t" + стр(-высота) + "\t" + стр(ширины[к]) + "\t" + стр(высота) + "\t0.5")
        перем базовая = -поле - размер * 0.85
        для с в ячейки[к] {
            команды.добавить(т(ф, размер, обводка, x + поле, базовая, с))
            базовая -= высота_строки
        }
        x += ширины[к]
    }
    вернуть Ряд(команды, высота)
}

// Ширина столбцов по их содержимому: узкие столбцы (номера, суммы) не занимают
// лишнего места, длинный текст получает остальное
функ ширины_столбцов(строки: [[стр]], столбцов: цел, обычный: цел, жирный_ш: цел, шапка: лог, размер: дроб,
    ширина: дроб) -> [дроб] {
    перем нужно: [дроб] = []
    для к в 0..столбцов - 1 {
        перем наибольшая = 12.0
        для н в 0..строки.длина - 1 {
            если к < строки[н].длина {
                перем ф = обычный
                если шапка и н == 0 { ф = жирный_ш }
                для абз в строки[н][к].разбить("\n") {
                    пусть ш = ширина_pdf(ф, абз, размер) + 6.0
                    если ш > наибольшая { наибольшая = ш }
                }
            }
        }
        нужно.добавить(наибольшая)
    }
    перем всего = 0.0
    для ш в нужно { всего += ш }
    перем итог: [дроб] = []
    если всего <= ширина {
        // всё помещается: свободное место делится пропорционально
        для ш в нужно { итог.добавить(ш * ширина / всего) }
        вернуть итог
    }
    // не помещается: столбцы уже средней ширины остаются как есть, остальные делят остаток
    пусть средняя = ширина / дроб(столбцов)
    перем узкие = 0.0
    перем широкие = 0.0
    для ш в нужно {
        если ш <= средняя { узкие += ш } иначе { широкие += ш }
    }
    для ш в нужно {
        если ш <= средняя {
            итог.добавить(ш)
        } иначе {
            итог.добавить(ш * (ширина - узкие) / широкие)
        }
    }
    вернуть итог
}

// Команда, сдвинутая по высоте: к координате y (третье поле) прибавляется сдвиг
функ сдвинуть(команда: стр, сдвиг: дроб) -> стр {
    пусть поля = команда.разбить("\t")
    перем номер = 5             // текст: T, шрифт, размер, обводка, x, y
    если поля[0] == "R" { номер = 2 }
    перем итог = поля
    итог[номер] = стр((разобрать_дроб(поля[номер]) иначе 0.0) + сдвиг)
    вернуть итог.соединить("\t")
}

/// Байты документа PDF
общий функ документ(блоки: [Блок], оф: Оформление) -> байты! {
    перем путь_шрифта = оф.шрифт
    если путь_шрифта == "" { путь_шрифта = найти_шрифт(ложь) }
    если путь_шрифта == "" {
        вернуть ошибка("не найден шрифт TrueType с русскими буквами; укажите файл .ttf: " +
            "pdf.Оформление(шрифт = \"путь/к/шрифту.ttf\")")
    }
    пусть обычный = шрифт_pdf(путь_шрифта)!
    перем жирный_ш = обычный
    перем искусственный = истина         // жирный шрифт рисуется обводкой обычного
    перем путь_жирного = оф.жирный_шрифт
    если путь_жирного == "" и оф.шрифт == "" { путь_жирного = найти_шрифт(истина) }
    если путь_жирного != "" {
        жирный_ш = шрифт_pdf(путь_жирного)!
        искусственный = ложь
    }
    если оф.размер < 1.0 или оф.размер > 200.0 { вернуть ошибка("размер шрифта должен быть от 1 до 200 пунктов") }
    пусть ширина_страницы = 595.28
    пусть высота_страницы = 841.89
    пусть слева = пункты(оф.поле_слева)
    пусть справа = ширина_страницы - пункты(оф.поле_справа)
    пусть верх = высота_страницы - пункты(оф.поле_сверху)
    пусть низ = пункты(оф.поле_снизу)
    пусть ширина = справа - слева
    если ширина < 50.0 или верх - низ < 50.0 { вернуть ошибка("поля листы слишком велики") }
    перем листы: [стр] = []
    перем команды: [стр] = []
    перем y = верх
    для блок в блоки {
        выбор блок {
            РазрывСтраницы {
                листы.добавить(команды.соединить("\n"))
                команды = []
                y = верх
            }
            Таблица(строки, шапка) {
                если строки.длина == 0 { продолжить }
                перем столбцов = 1
                для с в строки {
                    если с.длина > столбцов { столбцов = с.длина }
                }
                пусть ширины = ширины_столбцов(строки, столбцов, обычный, жирный_ш, шапка, оф.размер, ширина)
                пусть высота_строки = оф.размер * оф.интервал
                y -= оф.размер * 0.3
                перем ряд_шапки = Ряд([], 0.0)
                для н в 0..строки.длина - 1 {
                    пусть жирная = шапка и н == 0
                    перем ф = обычный
                    если жирная { ф = жирный_ш }
                    пусть ряд = ряд_таблицы(строки[н], столбцов, ф, оф.размер, высота_строки, слева, ширины,
                        жирная и искусственный)
                    если н == 0 и шапка { ряд_шапки = ряд }
                    если y - ряд.высота < низ и y < верх {
                        листы.добавить(команды.соединить("\n"))
                        команды = []
                        y = верх
                        // шапка таблицы повторяется на новой странице
                        если шапка и н > 0 {
                            для к в ряд_шапки.команды { команды.добавить(сдвинуть(к, y)) }
                            y -= ряд_шапки.высота
                        }
                    }
                    для к в ряд.команды { команды.добавить(сдвинуть(к, y)) }
                    y -= ряд.высота
                }
                y -= оф.размер * 0.5
            }
            иначе {
                // абзац или заголовок
                перем а = Абзац("")
                перем перед = 0.0
                перем после = 0.0
                перем отступ = оф.отступ_первой_строки * 72.0 / 2.54
                выбор блок {
                    Текст(абз) { а = абз }
                    Заголовок(текст_заголовка, уровень) {
                        перем множитель = 1.15
                        если уровень <= 1 { множитель = 1.5 }
                        если уровень == 2 { множитель = 1.3 }
                        а = Абзац(текст_заголовка, жирный = истина, размер = оф.размер * множитель, выравнивание = "по_левому")
                        перед = оф.размер * 0.8
                        после = оф.размер * 0.4
                        отступ = 0.0
                    }
                    иначе {}
                }
                перем размер = а.размер
                если размер <= 0.0 { размер = оф.размер }
                перем выравнивание = а.выравнивание
                если выравнивание == "" { выравнивание = оф.выравнивание }
                если выравнивание == "по_центру" или выравнивание == "по_правому" { отступ = 0.0 }
                перем ф = обычный
                если а.жирный { ф = жирный_ш }
                пусть обводка = а.жирный и искусственный
                пусть высота_строки = размер * оф.интервал
                если y < верх { y -= перед }
                для абз в а.текст.разбить("\n") {
                    пусть строки = строки_текста(абз, ф, размер, ширина, отступ)
                    для н в 0..строки.длина - 1 {
                        если y - высота_строки < низ {
                            листы.добавить(команды.соединить("\n"))
                            команды = []
                            y = верх
                        }
                        пусть базовая = y - размер * 0.85
                        перем x = слева
                        если н == 0 { x += отступ }
                        пусть с = строки[н]
                        пусть занято = ширина_pdf(ф, с, размер)
                        пусть свободно = справа - x - занято
                        если выравнивание == "по_центру" {
                            команды.добавить(т(ф, размер, обводка, x + свободно / 2.0, базовая, с))
                        } иначе если выравнивание == "по_правому" {
                            команды.добавить(т(ф, размер, обводка, x + свободно, базовая, с))
                        } иначе если выравнивание == "по_ширине" и н < строки.длина - 1 и с.содержит(" ") {
                            // слова раздвигаются до правого края; последняя строка - по левому
                            пусть слова = с.разбить(" ")
                            перем слов_ширина = 0.0
                            для сл в слова { слов_ширина += ширина_pdf(ф, сл, размер) }
                            пусть промежуток = (справа - x - слов_ширина) / дроб(слова.длина - 1)
                            перем позиция = x
                            для сл в слова {
                                команды.добавить(т(ф, размер, обводка, позиция, базовая, сл))
                                позиция += ширина_pdf(ф, сл, размер) + промежуток
                            }
                        } иначе {
                            команды.добавить(т(ф, размер, обводка, x, базовая, с))
                        }
                        y -= высота_строки
                    }
                }
                y -= после
            }
        }
    }
    листы.добавить(команды.соединить("\n"))
    если оф.номера_страниц и листы.длина > 1 {
        перем с_номерами: [стр] = []
        для н в 0..листы.длина - 1 {
            пусть номер = стр(н + 1)
            пусть р = оф.размер * 0.8
            пусть x = слева + (ширина - ширина_pdf(обычный, номер, р)) / 2.0
            с_номерами.добавить(листы[н] + "\n" + т(обычный, р, ложь, x, низ / 2.0, номер))
        }
        листы = с_номерами
    }
    вернуть собрать_pdf(листы, ширина_страницы, высота_страницы)
}
