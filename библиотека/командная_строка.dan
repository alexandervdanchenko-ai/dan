/// Стандартная библиотека Дана: разбор значений командной строки.
///
///     подключить "командная_строка"
///
///     перем о = командная_строка.описание("сводка", "Сводка по файлам отчётов")
///     о = о.флаг("подробно", "п", "печатать каждую строку")
///     о = о.параметр("вывод", "в", "файл для итога", "итог.txt")
///     о = о.остальные("файлы", "файлы отчётов")
///     если пусть а = о.разобрать(аргументы()) {
///         если а.нужна_справка {
///             вывод(о.справка())
///             завершить(0)
///         }
///         для файл в а.остальные { ... }
///         если а.флаг("подробно") { ... }
///         пусть путь = а.значение("вывод")
///     } иначе ошибка е {
///         вывод_ошибки(е)              // текст ошибки и подсказка про --справка
///         завершить(2)
///     }
///
/// Запись ключей - как у привычных программ: --подробно и -п; --вывод=итог.txt,
/// --вывод итог.txt, -в итог.txt и -витог.txt; несколько кратких флагов вместе: -пк;
/// всё после «--» - позиционные значения, даже если начинается с «-» (например, -5);
/// «-» само по себе - тоже значение (обычно «стандартный ввод»).
/// Ошибка разбора - значение с понятным текстом: неизвестный ключ, ключ без значения,
/// пропущенное обязательное или лишнее значение.

общий тип Описание {
    программа: стр
    о_программе: стр = ""
    ключи: [Ключ] = []
    позиционные: [Позиционный] = []
    остальные_имя: стр = ""          // "" - лишние позиционные значения - ошибка
    остальные_справка: стр = ""
}

тип Ключ {
    имя: стр
    кратко: стр                      // одна буква или ""
    справка: стр
    со_значением: лог
    по_умолчанию: стр
    обязательный: лог
}

тип Позиционный {
    имя: стр
    справка: стр
    обязательный: лог
    по_умолчанию: стр
}

/// Итог разбора: флаги, значения ключей и позиционные значения по именам.
общий тип Аргументы {
    флаги: {стр: лог} = {}
    значения: {стр: стр} = {}
    заданы: {стр: лог} = {}          // ключи и позиционные, заданные в командной строке
    остальные: [стр] = []            // позиционные значения сверх описанных
    нужна_справка: лог = ложь        // было --справка или -h: остальное не проверялось
}

/// Описание программы: имя (для строки «Запуск:») и одна-две фразы о ней
общий функ описание(программа: стр, о_программе: стр) -> Описание {
    вернуть Описание(программа = программа, о_программе = о_программе)
}

функ верное_имя(имя: стр) -> лог {
    если имя.длина == 0 или имя.начинается("-") или имя.содержит("=") или имя.содержит(" ") { вернуть ложь }
    вернуть истина
}

функ Описание.с_ключом(к: Ключ) -> Описание {
    если не верное_имя(к.имя) {
        утвердить(ложь, "имя ключа «" + к.имя + "»: нужно непустое имя без пробелов, «=» и «-» в начале")
    }
    если к.кратко.длина > 1 или к.кратко == "-" или к.кратко == "=" или к.кратко == " " {
        утвердить(ложь, "краткое имя ключа «" + к.кратко + "»: нужна одна буква или пустая строка")
    }
    для было в сам.ключи {
        если было.имя == к.имя или (к.кратко != "" и было.кратко == к.кратко) {
            утвердить(ложь, "ключ «" + к.имя + "» описан дважды")
        }
    }
    если к.имя == "справка" или к.кратко == "h" { утвердить(ложь, "ключи --справка и -h заняты: они печатают справку") }
    перем о = сам
    о.ключи.добавить(к)
    вернуть о
}

/// Ключ без значения: --имя или -к; а.флаг(имя) - истина, если задан
общий функ Описание.флаг(имя: стр, кратко: стр, справка: стр) -> Описание {
    вернуть сам.с_ключом(Ключ(имя, кратко, справка, ложь, "", ложь))
}

/// Ключ со значением и значением по умолчанию: --имя=значение
общий функ Описание.параметр(имя: стр, кратко: стр, справка: стр, по_умолчанию: стр) -> Описание {
    вернуть сам.с_ключом(Ключ(имя, кратко, справка, истина, по_умолчанию, ложь))
}

/// Ключ со значением, без которого программа не запускается
общий функ Описание.обязательный(имя: стр, кратко: стр, справка: стр) -> Описание {
    вернуть сам.с_ключом(Ключ(имя, кратко, справка, истина, "", истина))
}

функ Описание.с_позиционным(п: Позиционный) -> Описание {
    если не верное_имя(п.имя) { утвердить(ложь, "имя значения «" + п.имя + "»: нужно непустое имя без пробелов") }
    если сам.остальные_имя != "" { утвердить(ложь, "значение «" + п.имя + "» описано после остальных: остальные - последние") }
    для было в сам.позиционные {
        если было.имя == п.имя { утвердить(ложь, "значение «" + п.имя + "» описано дважды") }
        если не было.обязательный и п.обязательный {
            утвердить(ложь, "обязательное значение «" + п.имя + "» после необязательного «" + было.имя + "»")
        }
    }
    перем о = сам
    о.позиционные.добавить(п)
    вернуть о
}

/// Обязательное значение по порядку: сводка отчёт.txt
общий функ Описание.позиционный(имя: стр, справка: стр) -> Описание {
    вернуть сам.с_позиционным(Позиционный(имя, справка, истина, ""))
}

/// Необязательное значение по порядку (после обязательных)
общий функ Описание.необязательный(имя: стр, справка: стр, по_умолчанию: стр) -> Описание {
    вернуть сам.с_позиционным(Позиционный(имя, справка, ложь, по_умолчанию))
}

/// Все прочие значения по порядку - в а.остальные (их может и не быть)
общий функ Описание.остальные(имя: стр, справка: стр) -> Описание {
    если не верное_имя(имя) { утвердить(ложь, "имя значений «" + имя + "»: нужно непустое имя без пробелов") }
    перем о = сам
    о.остальные_имя = имя
    о.остальные_справка = справка
    вернуть о
}

функ Описание.найти_ключ(имя: стр) -> цел {
    для н в 0..сам.ключи.длина - 1 { если сам.ключи[н].имя == имя { вернуть н } }
    вернуть -1
}

функ Описание.найти_краткий(буква: стр) -> цел {
    для н в 0..сам.ключи.длина - 1 { если сам.ключи[н].кратко == буква { вернуть н } }
    вернуть -1
}

функ Описание.ошибка(т: стр) -> стр {
    вернуть сам.программа + ": " + т + " (справка: " + сам.программа + " --справка)"
}

/// Разобрать значения командной строки (обычно аргументы())
общий функ Описание.разобрать(значения: [стр]) -> Аргументы! {
    перем а = Аргументы()
    для к в сам.ключи {
        если к.со_значением { а.значения[к.имя] = к.по_умолчанию } иначе { а.флаги[к.имя] = ложь }
    }
    для п в сам.позиционные { а.значения[п.имя] = п.по_умолчанию }
    перем по_порядку: [стр] = []
    перем только_значения = ложь
    перем н = 0
    пока н < значения.длина {
        пусть з = значения[н]
        н += 1
        если только_значения или з == "-" или не з.начинается("-") {
            по_порядку.добавить(з)
            продолжить
        }
        если з == "--" {
            только_значения = истина
            продолжить
        }
        если з == "--справка" или з == "-h" или з == "--help" {
            а.нужна_справка = истина
            вернуть а
        }
        если з.начинается("--") {
            перем имя = з[2..з.длина - 1]
            перем значение = ""
            перем есть_значение = ложь
            пусть р = имя.найти("=")
            если р >= 0 {
                если р + 1 <= имя.длина - 1 { значение = имя[р + 1..имя.длина - 1] }
                если р == 0 { имя = "" } иначе { имя = имя[0..р - 1] }
                есть_значение = истина
            }
            пусть номер = сам.найти_ключ(имя)
            если номер < 0 { вернуть ошибка(сам.ошибка("неизвестный ключ --" + имя)) }
            пусть к = сам.ключи[номер]
            если к.со_значением {
                если не есть_значение {
                    если н >= значения.длина { вернуть ошибка(сам.ошибка("после --" + имя + " нужно значение")) }
                    значение = значения[н]
                    н += 1
                }
                а.значения[имя] = значение
            } иначе {
                если есть_значение { вернуть ошибка(сам.ошибка("ключ --" + имя + " не принимает значения")) }
                а.флаги[имя] = истина
            }
            а.заданы[имя] = истина
            продолжить
        }
        // краткие ключи: -п, -пк, -в файл, -вфайл
        пусть буквы = з[1..з.длина - 1].символы()
        перем б = 0
        пока б < буквы.длина {
            пусть номер = сам.найти_краткий(буквы[б])
            если номер < 0 { вернуть ошибка(сам.ошибка("неизвестный ключ -" + буквы[б])) }
            пусть к = сам.ключи[номер]
            если к.со_значением {
                перем значение = ""
                если б + 1 < буквы.длина {
                    значение = буквы[б + 1..буквы.длина - 1].соединить("")
                } иначе {
                    если н >= значения.длина { вернуть ошибка(сам.ошибка("после -" + буквы[б] + " нужно значение")) }
                    значение = значения[н]
                    н += 1
                }
                а.значения[к.имя] = значение
                а.заданы[к.имя] = истина
                прервать
            }
            а.флаги[к.имя] = истина
            а.заданы[к.имя] = истина
            б += 1
        }
    }
    для к в сам.ключи {
        если к.обязательный и не а.заданы.содержит(к.имя) {
            вернуть ошибка(сам.ошибка("нужен ключ --" + к.имя))
        }
    }
    для п в 0..по_порядку.длина - 1 {
        если п < сам.позиционные.длина {
            а.значения[сам.позиционные[п].имя] = по_порядку[п]
            а.заданы[сам.позиционные[п].имя] = истина
        } иначе если сам.остальные_имя != "" {
            а.остальные.добавить(по_порядку[п])
        } иначе {
            вернуть ошибка(сам.ошибка("лишнее значение «" + по_порядку[п] + "»"))
        }
    }
    для п в сам.позиционные {
        если п.обязательный и не а.заданы.содержит(п.имя) {
            вернуть ошибка(сам.ошибка("нужно значение «" + п.имя + "»"))
        }
    }
    вернуть а
}

/// Текст справки: строка запуска, описание, значения и ключи
общий функ Описание.справка() -> стр {
    перем запуск = "Запуск: " + сам.программа
    если сам.ключи.длина > 0 { запуск += " [ключи]" }
    для п в сам.позиционные {
        если п.обязательный { запуск += " " + п.имя } иначе { запуск += " [" + п.имя + "]" }
    }
    если сам.остальные_имя != "" { запуск += " [" + сам.остальные_имя + " ...]" }
    перем строки: [стр] = [запуск]
    если сам.о_программе != "" {
        строки.добавить("")
        строки.добавить(сам.о_программе)
    }
    перем левые: [стр] = []
    перем правые: [стр] = []
    для п в сам.позиционные {
        левые.добавить(п.имя)
        перем т = п.справка
        если не п.обязательный и п.по_умолчанию != "" { т += " (по умолчанию: " + п.по_умолчанию + ")" }
        правые.добавить(т)
    }
    если сам.остальные_имя != "" {
        левые.добавить(сам.остальные_имя + " ...")
        правые.добавить(сам.остальные_справка)
    }
    пусть значений = левые.длина
    для к в сам.ключи {
        перем л = ""
        если к.кратко != "" { л = "-" + к.кратко + ", " } иначе { л = "    " }
        л += "--" + к.имя
        если к.со_значением { л += " ЗНАЧЕНИЕ" }
        левые.добавить(л)
        перем т = к.справка
        если к.обязательный { т += " (обязательно)" } иначе если к.со_значением и к.по_умолчанию != "" {
            т += " (по умолчанию: " + к.по_умолчанию + ")"
        }
        правые.добавить(т)
    }
    левые.добавить("-h, --справка")
    правые.добавить("показать эту справку")
    перем ширина = 0
    для л в левые { если л.длина > ширина { ширина = л.длина } }
    для н в 0..левые.длина - 1 {
        если н == 0 и значений > 0 {
            строки.добавить("")
            строки.добавить("Значения:")
        }
        если н == значений {
            строки.добавить("")
            строки.добавить("Ключи:")
        }
        строки.добавить("  " + левые[н] + " ".повторить(ширина - левые[н].длина + 2) + правые[н])
    }
    вернуть строки.соединить("\n")
}

/// Задан ли флаг (для неописанного имени - ошибка выполнения)
общий функ Аргументы.флаг(имя: стр) -> лог {
    если пусть ф = сам.флаги.найти(имя) { вернуть ф }
    утвердить(ложь, "флаг «" + имя + "» не описан")
    вернуть ложь
}

/// Значение ключа или позиционного значения (заданное или по умолчанию)
общий функ Аргументы.значение(имя: стр) -> стр {
    если пусть з = сам.значения.найти(имя) { вернуть з }
    утвердить(ложь, "значение «" + имя + "» не описано")
    вернуть ""
}

/// Было ли значение задано в командной строке (а не взято по умолчанию)
общий функ Аргументы.задан(имя: стр) -> лог {
    вернуть сам.заданы.содержит(имя)
}

/// Значение как целое число: ошибка-значение с именем ключа, если это не число
общий функ Аргументы.цел(имя: стр) -> цел! {
    пусть з = сам.значение(имя)
    если пусть ч = разобрать_цел(з) { вернуть ч }
    вернуть ошибка(имя + ": нужно целое число, а не «" + з + "»")
}

/// Значение как дробное число (допускается запятая)
общий функ Аргументы.дроб(имя: стр) -> дроб! {
    пусть з = сам.значение(имя)
    если пусть ч = разобрать_дроб(з) { вернуть ч }
    вернуть ошибка(имя + ": нужно число, а не «" + з + "»")
}
