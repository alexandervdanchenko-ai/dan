/// Стандартная библиотека Дана: собственный движок языковых моделей на Дане (файлы GGUF).
///
///     подключить "нейро"
///     пусть м = нейро.загрузить("модель.gguf")!
///     вывод(м.ответ("Столица Франции - ", нейро.жадная())!)
///     пусть токены = м.разбить("Привет, мир!")          // [1, 15043, ...] как в llama.cpp
///     вывод(м.текст(токены))
///
/// В отличие от модуля «модели» (он вызывает библиотеку llama.cpp), здесь всё
/// написано на Дане: чтение файла GGUF через массив_из_файла (файл отображается
/// в память, не читается целиком), токенизатор по словарю из файла, проход
/// модели архитектуры llama (Llama, Mistral, TinyLlama, Qwen2) на векторных
/// ядрах языка (матвек, матвек_q8, софтмакс, нормировать_скв) и выборка токена.
/// Файл недоверенный: любой испорченный размер или смещение даёт ошибку-значение.

// ======================================================================
// Файл GGUF
// ======================================================================

/// Значение ключа GGUF (метаданные модели)
общий тип Значение {
    Целое(значение: цел)
    Дробное(значение: дроб)
    Логическое(значение: лог)
    Текст(значение: стр)
    Целые(значения: [цел])
    Дробные(значения: [дроб])
    Тексты(значения: [стр])
    /// массив массивов (в моделях не встречается): только длина
    Вложенное(длина: цел)
}

/// Тензор из таблицы файла
общий тип Тензор {
    имя: стр
    /// размеры как в GGUF: первый - длина строки (ne0)
    размеры: [цел]
    /// тип GGML: 0 - F32, 1 - F16, 8 - Q8_0, 12 - Q4_K и т.д.
    вид: цел
    /// смещение данных от начала файла
    смещение: цел
    байтов: цел
    элементов: цел
}

/// Прочитанный файл GGUF: ключи и таблица тензоров (сами веса не читаются)
общий тип Файл {
    путь: стр
    версия: цел
    ключи: {стр: Значение}
    тензоры: [Тензор]
    номера: {стр: цел}
    начало_данных: цел
    размер: цел
}

тип Прочитанное {
    значение: Значение
    конец: цел
}

тип Строка_ {
    текст: стр
    конец: цел
}

функ хватает(д: массив<байт>, п: цел, н: цел) -> лог {
    вернуть п >= 0 и н >= 0 и п <= д.длина и н <= д.длина - п
}

функ у16(д: массив<байт>, п: цел) -> цел {
    вернуть д[п] + д[п + 1] * 256
}

функ у32(д: массив<байт>, п: цел) -> цел {
    вернуть д[п] + д[п + 1] * 256 + д[п + 2] * 65536 + д[п + 3] * 16777216
}

/// 64-битное целое без знака; больше 2^63 - 1 не бывает в правильном файле
функ у64(д: массив<байт>, п: цел) -> цел! {
    если д[п + 7] >= 128 {
        вернуть ошибка("число " + шестнадцатеричная(байты(д[п..п + 7])) + " на месте " + стр(п) + " слишком большое")
    }
    перем з = 0
    перем к = 7
    пока к >= 0 {
        з = з * 256 + д[п + к]
        к -= 1
    }
    вернуть з
}

функ ц32(д: массив<байт>, п: цел) -> цел {
    пусть з = у32(д, п)
    если з >= 2147483648 { вернуть з - 4294967296 }
    вернуть з
}

функ д32(д: массив<байт>, п: цел) -> дроб {
    вернуть массив(дроб32, байты(д[п..п + 3]))[0]
}

функ обрезан(что: стр, п: цел) -> стр {
    вернуть "файл обрезан: " + что + " на месте " + стр(п) + " выходит за конец файла"
}

функ строка_gguf(д: массив<байт>, п: цел) -> Строка_! {
    если не хватает(д, п, 8) { вернуть ошибка(обрезан("длина строки", п)) }
    пусть длина = у64(д, п)!
    если не хватает(д, п + 8, длина) {
        вернуть ошибка(обрезан("строка длиной " + стр(длина) + " байт", п))
    }
    если длина == 0 { вернуть Строка_("", п + 8) }
    вернуть Строка_(стр(байты(д[п + 8..п + 7 + длина])), п + 8 + длина)
}

/// размер значения простого типа GGUF в байтах (строка - 0: длина своя)
функ размер_значения(вид: цел) -> цел {
    выбор вид {
        0, 1, 7 { вернуть 1 }
        2, 3 { вернуть 2 }
        4, 5, 6 { вернуть 4 }
        10, 11, 12 { вернуть 8 }
        иначе { вернуть 0 }
    }
}

функ простое_значение(д: массив<байт>, п: цел, вид: цел) -> Прочитанное! {
    если вид == 8 {
        пусть с = строка_gguf(д, п)!
        вернуть Прочитанное(Текст(с.текст), с.конец)
    }
    пусть н = размер_значения(вид)
    если н == 0 { вернуть ошибка("неизвестный тип значения " + стр(вид) + " на месте " + стр(п)) }
    если не хватает(д, п, н) { вернуть ошибка(обрезан("значение", п)) }
    выбор вид {
        0 { вернуть Прочитанное(Целое(д[п]), п + 1) }
        1 {
            перем з = д[п]
            если з >= 128 { з -= 256 }
            вернуть Прочитанное(Целое(з), п + 1)
        }
        2 { вернуть Прочитанное(Целое(у16(д, п)), п + 2) }
        3 {
            перем з = у16(д, п)
            если з >= 32768 { з -= 65536 }
            вернуть Прочитанное(Целое(з), п + 2)
        }
        4 { вернуть Прочитанное(Целое(у32(д, п)), п + 4) }
        5 { вернуть Прочитанное(Целое(ц32(д, п)), п + 4) }
        6 { вернуть Прочитанное(Дробное(д32(д, п)), п + 4) }
        7 { вернуть Прочитанное(Логическое(д[п] != 0), п + 1) }
        10, 11 { вернуть Прочитанное(Целое(у64(д, п)!), п + 8) }
        иначе { вернуть Прочитанное(Дробное(массив(дроб, байты(д[п..п + 7]))[0]), п + 8) }
    }
}

функ значение_gguf(д: массив<байт>, п: цел, вид: цел, глубина: цел) -> Прочитанное! {
    если вид != 9 { вернуть простое_значение(д, п, вид) }
    если не хватает(д, п, 12) { вернуть ошибка(обрезан("заголовок массива", п)) }
    пусть вид_эл = у32(д, п)
    пусть число = у64(д, п + 4)!
    перем поз = п + 12
    пусть остаток = д.длина - поз
    перем наименьший = размер_значения(вид_эл)
    если вид_эл == 8 { наименьший = 8 }
    если вид_эл == 9 { наименьший = 12 }
    если наименьший == 0 { вернуть ошибка("неизвестный тип элементов массива " + стр(вид_эл) + " на месте " + стр(п)) }
    если число > частное(остаток, наименьший) {
        вернуть ошибка("неверная длина массива " + стр(число) + " на месте " + стр(п) + ": в файле меньше данных")
    }
    если вид_эл == 9 {
        если глубина > 4 { вернуть ошибка("слишком глубоко вложенные массивы на месте " + стр(п)) }
        для к в 1..число {
            пусть э = значение_gguf(д, поз, 9, глубина + 1)!
            поз = э.конец
        }
        вернуть Прочитанное(Вложенное(число), поз)
    }
    если вид_эл == 8 {
        перем тексты: [стр] = []
        для к в 1..число {
            пусть с = строка_gguf(д, поз)!
            тексты.добавить(с.текст)
            поз = с.конец
        }
        вернуть Прочитанное(Тексты(тексты), поз)
    }
    если вид_эл == 6 или вид_эл == 12 {
        перем дробные: [дроб] = []
        если число > 0 {
            пусть шаг = размер_значения(вид_эл)
            если вид_эл == 6 {
                для з в массив(дроб32, байты(д[поз..поз + число * 4 - 1])) { дробные.добавить(з) }
            } иначе {
                для з в массив(дроб, байты(д[поз..поз + число * 8 - 1])) { дробные.добавить(з) }
            }
            поз += число * шаг
        }
        вернуть Прочитанное(Дробные(дробные), поз)
    }
    перем целые: [цел] = []
    если вид_эл == 5 {
        для к в 1..число {
            целые.добавить(ц32(д, поз))
            поз += 4
        }
        вернуть Прочитанное(Целые(целые), поз)
    }
    для к в 1..число {
        пусть э = простое_значение(д, поз, вид_эл)!
        выбор э.значение {
            Целое(з) { целые.добавить(з) }
            Логическое(л) {
                перем з = 0
                если л { з = 1 }
                целые.добавить(з)
            }
            иначе { }
        }
        поз = э.конец
    }
    вернуть Прочитанное(Целые(целые), поз)
}

/// [число элементов в блоке, байтов в блоке] типа тензора GGML; [0, 0] - неизвестный тип
функ размер_блока(вид: цел) -> [цел] {
    выбор вид {
        0 { вернуть [1, 4] }
        1 { вернуть [1, 2] }
        2 { вернуть [32, 18] }
        3 { вернуть [32, 20] }
        6 { вернуть [32, 22] }
        7 { вернуть [32, 24] }
        8 { вернуть [32, 34] }
        9 { вернуть [32, 36] }
        10 { вернуть [256, 84] }
        11 { вернуть [256, 110] }
        12 { вернуть [256, 144] }
        13 { вернуть [256, 176] }
        14 { вернуть [256, 210] }
        15 { вернуть [256, 292] }
        16 { вернуть [256, 66] }
        17 { вернуть [256, 74] }
        18 { вернуть [256, 98] }
        19 { вернуть [256, 50] }
        20 { вернуть [32, 18] }
        21 { вернуть [256, 110] }
        22 { вернуть [256, 82] }
        23 { вернуть [256, 136] }
        24 { вернуть [1, 1] }
        25 { вернуть [1, 2] }
        26 { вернуть [1, 4] }
        27, 28 { вернуть [1, 8] }
        29 { вернуть [256, 56] }
        30 { вернуть [1, 2] }
        34 { вернуть [256, 54] }
        35 { вернуть [256, 66] }
        39 { вернуть [32, 17] }
        40 { вернуть [64, 36] }
        41 { вернуть [128, 18] }
        42 { вернуть [64, 18] }
        43 { вернуть [1, 1] }
        иначе { вернуть [0, 0] }
    }
}

/// Имя типа тензора GGML (как в llama.cpp)
функ имя_вида(вид: цел) -> стр {
    пусть имена = ["F32", "F16", "Q4_0", "Q4_1", "", "", "Q5_0", "Q5_1", "Q8_0", "Q8_1", "Q2_K", "Q3_K", "Q4_K",
        "Q5_K", "Q6_K", "Q8_K", "IQ2_XXS", "IQ2_XS", "IQ3_XXS", "IQ1_S", "IQ4_NL", "IQ3_S", "IQ2_S", "IQ4_XS", "I8",
        "I16", "I32", "I64", "F64", "IQ1_M", "BF16", "", "", "", "TQ1_0", "TQ2_0", "", "", "", "MXFP4", "NVFP4",
        "Q1_0", "Q2_0", "F8_E4M3"]
    если вид >= 0 и вид < имена.длина и имена[вид] != "" { вернуть имена[вид] }
    вернуть "тип " + стр(вид)
}

/// Прочитать заголовок, ключи и таблицу тензоров файла GGUF (версии 2 и 3).
/// Файл отображается в память, веса не читаются. Любое нарушение формата -
/// ошибка-значение «файл ... не подходит: причина».
общий функ открыть_gguf(путь: стр) -> Файл! {
    если не существует(путь) { вернуть ошибка("файл «" + путь + "» не найден") }
    если ошибка о = проверить_размер(путь) { вернуть ошибка("файл «" + путь + "» не подходит: " + о) }
    пусть д = массив_из_файла(байт, путь)!
    если пусть ф = разобрать_gguf(д, путь) {
        вернуть ф
    } иначе ошибка о {
        вернуть ошибка("файл «" + путь + "» не подходит: " + о)
    }
}

функ проверить_размер(путь: стр) -> ! {
    если размер_файла(путь) == 0 { вернуть ошибка("файл пустой") }
}

функ разобрать_gguf(д: массив<байт>, путь: стр) -> Файл! {
    если д.длина < 24 { вернуть ошибка("это не файл GGUF: в нём меньше 24 байт") }
    если д[0] != 71 или д[1] != 71 или д[2] != 85 или д[3] != 70 {
        вернуть ошибка("это не файл GGUF: нет подписи «GGUF» в начале")
    }
    пусть версия = у32(д, 4)
    если версия != 2 и версия != 3 {
        вернуть ошибка("версия формата GGUF " + стр(версия) + " не поддерживается (нужна 2 или 3)")
    }
    пусть число_тензоров = у64(д, 8)!
    пусть число_ключей = у64(д, 16)!
    // каждый ключ занимает не меньше 13 байт, каждый тензор - не меньше 28
    если число_ключей > частное(д.длина, 13) { вернуть ошибка("неверное число ключей: " + стр(число_ключей)) }
    если число_тензоров > частное(д.длина, 28) { вернуть ошибка("неверное число тензоров: " + стр(число_тензоров)) }
    перем п = 24
    перем ключи: {стр: Значение} = {}
    для к в 1..число_ключей {
        пусть имя = строка_gguf(д, п)!
        п = имя.конец
        если не хватает(д, п, 4) { вернуть ошибка(обрезан("тип значения ключа «" + имя.текст + "»", п)) }
        пусть вид = у32(д, п)
        пусть з = значение_gguf(д, п + 4, вид, 0)!
        если ключи.содержит(имя.текст) { вернуть ошибка("ключ «" + имя.текст + "» повторяется") }
        ключи[имя.текст] = з.значение
        п = з.конец
    }
    перем выравнивание = 32
    если пусть зв = ключи.найти("general.alignment") {
        выбор зв {
            Целое(ч) { выравнивание = ч }
            иначе { вернуть ошибка("general.alignment - не целое число") }
        }
        если выравнивание <= 0 или выравнивание > 1048576 или выравнивание % 8 != 0 {
            вернуть ошибка("неверное выравнивание данных: " + стр(выравнивание))
        }
    }
    перем тензоры: [Тензор] = []
    перем номера: {стр: цел} = {}
    для к в 1..число_тензоров {
        пусть имя = строка_gguf(д, п)!
        п = имя.конец
        если не хватает(д, п, 4) { вернуть ошибка(обрезан("тензор «" + имя.текст + "»", п)) }
        пусть измерений = у32(д, п)
        если измерений < 1 или измерений > 4 {
            вернуть ошибка("у тензора «" + имя.текст + "» неверное число измерений: " + стр(измерений))
        }
        п += 4
        если не хватает(д, п, измерений * 8 + 12) { вернуть ошибка(обрезан("тензор «" + имя.текст + "»", п)) }
        перем размеры: [цел] = []
        перем элементов = 1
        для н в 1..измерений {
            пусть р = у64(д, п)!
            если р <= 0 или р > 1_000_000_000_000 или элементов > частное(1_000_000_000_000_000, р) {
                вернуть ошибка("у тензора «" + имя.текст + "» неверный размер " + стр(р))
            }
            размеры.добавить(р)
            элементов *= р
            п += 8
        }
        пусть вид = у32(д, п)
        пусть блок = размер_блока(вид)
        если блок[0] == 0 { вернуть ошибка("неизвестный тип тензора «" + имя.текст + "»: " + стр(вид)) }
        если размеры[0] % блок[0] != 0 {
            вернуть ошибка("длина строки тензора «" + имя.текст + "» (" + стр(размеры[0]) + ") не делится на блок " + стр(блок[0]))
        }
        пусть смещение = у64(д, п + 4)!
        п += 12
        если смещение % выравнивание != 0 {
            вернуть ошибка("смещение тензора «" + имя.текст + "» не выровнено: " + стр(смещение))
        }
        если номера.содержит(имя.текст) { вернуть ошибка("тензор «" + имя.текст + "» повторяется") }
        номера[имя.текст] = тензоры.длина
        тензоры.добавить(Тензор(имя.текст, размеры, вид, смещение, частное(элементов, блок[0]) * блок[1], элементов))
    }
    пусть начало = частное(п + выравнивание - 1, выравнивание) * выравнивание
    если начало > д.длина и тензоры.длина > 0 { вернуть ошибка(обрезан("начало данных", начало)) }
    перем итог: [Тензор] = []
    для т в тензоры {
        если т.смещение > д.длина - начало или т.байтов > д.длина - начало - т.смещение {
            вернуть ошибка("данные тензора «" + т.имя + "» (" + стр(т.байтов) + " байт со смещения " + стр(т.смещение) +
                ") выходят за конец файла")
        }
        итог.добавить(Тензор(т.имя, т.размеры, т.вид, начало + т.смещение, т.байтов, т.элементов))
    }
    вернуть Файл(путь, версия, ключи, итог, номера, начало, д.длина)
}

/// Целое значение ключа или ничего
общий функ Файл.целое(ключ: стр) -> цел? {
    если пусть з = сам.ключи.найти(ключ) {
        выбор з {
            Целое(ч) { вернуть ч }
            Логическое(л) {
                если л { вернуть 1 }
                вернуть 0
            }
            иначе { вернуть ничего }
        }
    }
    вернуть ничего
}

/// Дробное значение ключа (целое тоже подходит) или ничего
функ Файл.дробное(ключ: стр) -> дроб? {
    если пусть з = сам.ключи.найти(ключ) {
        выбор з {
            Дробное(ч) { вернуть ч }
            Целое(ч) { вернуть дроб(ч) }
            иначе { вернуть ничего }
        }
    }
    вернуть ничего
}

функ Файл.логическое(ключ: стр) -> лог? {
    если пусть з = сам.ключи.найти(ключ) {
        выбор з {
            Логическое(л) { вернуть л }
            Целое(ч) { вернуть ч != 0 }
            иначе { вернуть ничего }
        }
    }
    вернуть ничего
}

общий функ Файл.текст(ключ: стр) -> стр? {
    если пусть з = сам.ключи.найти(ключ) {
        выбор з {
            Текст(т) { вернуть т }
            иначе { вернуть ничего }
        }
    }
    вернуть ничего
}

общий функ Файл.тексты(ключ: стр) -> [стр] {
    если пусть з = сам.ключи.найти(ключ) {
        выбор з {
            Тексты(т) { вернуть т }
            иначе { }
        }
    }
    вернуть []
}

функ Файл.дробные(ключ: стр) -> [дроб] {
    если пусть з = сам.ключи.найти(ключ) {
        выбор з {
            Дробные(т) { вернуть т }
            иначе { }
        }
    }
    вернуть []
}

функ Файл.целые(ключ: стр) -> [цел] {
    если пусть з = сам.ключи.найти(ключ) {
        выбор з {
            Целые(т) { вернуть т }
            иначе { }
        }
    }
    вернуть []
}

/// Тензор по имени или ничего
общий функ Файл.тензор(имя: стр) -> Тензор? {
    если пусть н = сам.номера.найти(имя) { вернуть сам.тензоры[н] }
    вернуть ничего
}

// ======================================================================
// Токенизатор
// ======================================================================

/// Словарь модели и правила разбиения текста на токены (по ключам tokenizer.ggml.* файла)
общий тип Словарь {
    /// «llama» - SentencePiece (части с оценками), «gpt2» - BPE с байтами и слияниями
    модель: стр
    /// tokenizer.ggml.pre: правило предварительного разбиения BPE («qwen2», «llama-bpe», «gpt-2»)
    предразбиение: стр
    /// то же, сведённое к одному из поддерживаемых: «qwen2», «llama3», «gpt2» («» - SentencePiece)
    правило: стр
    тексты: [стр]
    оценки: [дроб]
    /// вид токена: 1 - обычный, 2 - неизвестный, 3 - служебный, 4 - заданный пользователем, 5 - неиспользуемый, 6 - байт
    виды: [цел]
    номера: {стр: цел}
    /// служебные токены, которые ищутся в тексте как есть (длинные раньше)
    служебные: [цел]
    /// ранги слияний BPE: «левая правая» -> номер
    слияния: {стр: цел}
    начало: цел = -1
    конец: цел = -1
    неизвестный: цел = -1
    добавлять_начало: лог = ложь
    добавлять_конец: лог = ложь
    пробел_в_начале: лог = ложь
    /// токены конца ответа (конец текста, конец хода)
    конечные: [цел]
    /// токен для каждого байта (SentencePiece: <0xXX>); -1 - нет
    токен_байта: [цел]
    /// BPE: знак, которым записан каждый байт, и обратно
    знак_байта: [стр]
    байт_знака: {стр: цел}
}

/// знаки, которыми GPT-2 записывает байты (bytes_to_unicode)
функ знаки_байтов() -> [стр] {
    перем знаки: [стр] = []
    перем следующий = 256
    для б в 0..255 {
        если (б >= 33 и б <= 126) или (б >= 161 и б <= 172) или (б >= 174 и б <= 255) {
            знаки.добавить(символ_по_коду(б))
        } иначе {
            знаки.добавить(символ_по_коду(следующий))
            следующий += 1
        }
    }
    вернуть знаки
}

функ шестн2(б: цел) -> стр {
    пусть цифры = "0123456789ABCDEF"
    вернуть цифры[частное(б, 16)] + цифры[б % 16]
}

функ конечный_текст(т: стр) -> лог {
    пусть известные = ["<|eot_id|>", "<|eot|>", "<|im_end|>", "<|end|>", "<|return|>", "<|call|>", "<end_of_turn>",
        "<|endoftext|>", "</s>", "<|eom_id|>", "<EOT>", "_<EOT>", "[EOT]", "[EOS]", "<|end_of_text|>", "<end_of_utterance>",
        "<｜end▁of▁sentence｜>"]
    вернуть известные.содержит(т)
}

/// Словарь из ключей файла GGUF
общий функ словарь_из(ф: Файл) -> Словарь! {
    пусть модель = ф.текст("tokenizer.ggml.model") иначе ""
    если модель != "llama" и модель != "gpt2" {
        вернуть ошибка("токенизатор «" + модель + "» не поддерживается: нужен «llama» (SentencePiece) или «gpt2» (BPE)")
    }
    пусть тексты = ф.тексты("tokenizer.ggml.tokens")
    если тексты.длина == 0 { вернуть ошибка("в файле нет словаря (tokenizer.ggml.tokens)") }
    перем оценки = ф.дробные("tokenizer.ggml.scores")
    если оценки.длина == 0 {
        для к в 1..тексты.длина { оценки.добавить(0.0) }
    }
    перем виды = ф.целые("tokenizer.ggml.token_type")
    если виды.длина == 0 {
        для к в 1..тексты.длина { виды.добавить(1) }
    }
    если оценки.длина != тексты.длина или виды.длина != тексты.длина {
        вернуть ошибка("длины tokenizer.ggml.tokens, scores и token_type различаются")
    }
    перем номера: {стр: цел} = {}
    для н в 0..тексты.длина - 1 {
        номера[тексты[н]] = н
    }
    перем конечные: [цел] = []
    для н в 0..тексты.длина - 1 {
        если конечный_текст(тексты[н]) {
            конечные.добавить(н)
            если виды[н] != 3 { виды[н] = 3 }
        }
    }
    // служебные токены по убыванию длины (при равной длине - по номеру)
    перем служебные: [цел] = []
    для н в 0..тексты.длина - 1 {
        если (виды[н] == 2 или виды[н] == 3 или виды[н] == 4) и тексты[н] != "" { служебные.добавить(н) }
    }
    служебные = служебные.упорядочить_по(функ(н: цел) = -тексты[н].длина * 10_000_000 + н)
    пусть пред_ = ф.текст("tokenizer.ggml.pre") иначе "default"
    перем правило = ""
    если модель == "gpt2" {
        если ["qwen2", "deepseek-r1-qwen", "kormo", "f2llmv2", "stablelm2", "hunyuan", "solar-open"].содержит(пред_) {
            правило = "qwen2"
        } иначе если ["llama3", "llama-v3", "llama-bpe", "falcon3", "falcon-h1", "midm-2.0", "jina-v5-nano", "lfm2"].содержит(пред_) {
            правило = "llama3"
        } иначе если ["gpt-2", "gpt2", "mpt", "olmo", "jais", "trillion", "granite-docling"].содержит(пред_) {
            правило = "gpt2"
        } иначе {
            вернуть ошибка("предварительное разбиение BPE «" + пред_ + "» пока не поддерживается (есть qwen2, llama-bpe, gpt-2)")
        }
    }
    перем сл = Словарь(модель, пред_, правило, тексты, оценки, виды, номера, служебные, {},
        конечные = конечные, токен_байта = [], знак_байта = [], байт_знака = {})
    если модель == "llama" {
        сл.начало = 1
        сл.конец = 2
        сл.неизвестный = 0
        сл.добавлять_начало = истина
        сл.пробел_в_начале = истина
        перем тб: [цел] = []
        для б в 0..255 {
            тб.добавить(номера.получить("<0x" + шестн2(б) + ">", -1))
        }
        сл.токен_байта = тб
    } иначе {
        сл.начало = 11
        сл.конец = 11
        пусть знаки = знаки_байтов()
        перем обратно: {стр: цел} = {}
        перем тб: [цел] = []
        для б в 0..255 {
            обратно[знаки[б]] = б
            тб.добавить(номера.получить(знаки[б], -1))
        }
        сл.знак_байта = знаки
        сл.байт_знака = обратно
        сл.токен_байта = тб
        перем слияния: {стр: цел} = {}
        пусть список = ф.тексты("tokenizer.ggml.merges")
        для н в 0..список.длина - 1 {
            если не слияния.содержит(список[н]) { слияния[список[н]] = н }
        }
        сл.слияния = слияния
        // как в llama.cpp: модели Llama 3 добавляют начало, Qwen2 - нет
        если правило == "llama3" { сл.добавлять_начало = истина }
    }
    если пусть ч = ф.целое("tokenizer.ggml.bos_token_id") { сл.начало = ч }
    если пусть ч = ф.целое("tokenizer.ggml.eos_token_id") { сл.конец = ч }
    если пусть ч = ф.целое("tokenizer.ggml.unknown_token_id") { сл.неизвестный = ч }
    если пусть л = ф.логическое("tokenizer.ggml.add_bos_token") { сл.добавлять_начало = л }
    если пусть л = ф.логическое("tokenizer.ggml.add_eos_token") { сл.добавлять_конец = л }
    если пусть л = ф.логическое("tokenizer.ggml.add_space_prefix") { сл.пробел_в_начале = л }
    для ключ в ["tokenizer.ggml.eos_token_id", "tokenizer.ggml.eot_token_id", "tokenizer.ggml.eom_token_id"] {
        если пусть ч = ф.целое(ключ) {
            если ч >= 0 и ч < тексты.длина и не сл.конечные.содержит(ч) { сл.конечные.добавить(ч) }
        }
    }
    если сл.начало >= тексты.длина или сл.конец >= тексты.длина {
        вернуть ошибка("номер токена начала или конца за пределами словаря")
    }
    если сл.конечные.длина == 0 и сл.конец >= 0 { сл.конечные.добавить(сл.конец) }
    вернуть сл
}

// ---------- очередь слияний (куча: больший приоритет, при равном - меньший левый) ----------

тип Куча {
    приоритет: [дроб]
    левый: [цел]
    правый: [цел]
    длина_: [цел]
}

функ куча_выше(к: Куча, а: цел, б: цел) -> лог {
    если к.приоритет[а] != к.приоритет[б] { вернуть к.приоритет[а] > к.приоритет[б] }
    вернуть к.левый[а] < к.левый[б]
}

функ куча_обмен(к: Куча, а: цел, б: цел) -> Куча {
    перем н = к
    пусть п = н.приоритет[а]
    н.приоритет[а] = н.приоритет[б]
    н.приоритет[б] = п
    пусть л = н.левый[а]
    н.левый[а] = н.левый[б]
    н.левый[б] = л
    пусть пр = н.правый[а]
    н.правый[а] = н.правый[б]
    н.правый[б] = пр
    пусть д = н.длина_[а]
    н.длина_[а] = н.длина_[б]
    н.длина_[б] = д
    вернуть н
}

функ куча_добавить(к: Куча, приоритет: дроб, левый: цел, правый: цел, длина: цел) -> Куча {
    перем н = к
    н.приоритет.добавить(приоритет)
    н.левый.добавить(левый)
    н.правый.добавить(правый)
    н.длина_.добавить(длина)
    перем м = н.левый.длина - 1
    пока м > 0 {
        пусть родитель = частное(м - 1, 2)
        если не куча_выше(н, м, родитель) { прервать }
        н = куча_обмен(н, м, родитель)
        м = родитель
    }
    вернуть н
}

функ куча_снять(к: Куча) -> Куча {
    перем н = к
    пусть последний = н.левый.длина - 1
    н = куча_обмен(н, 0, последний)
    н.приоритет.удалить(последний)
    н.левый.удалить(последний)
    н.правый.удалить(последний)
    н.длина_.удалить(последний)
    перем м = 0
    пусть всего = н.левый.длина
    пока истина {
        перем лучший = м
        пусть л = 2 * м + 1
        пусть п = 2 * м + 2
        если л < всего и куча_выше(н, л, лучший) { лучший = л }
        если п < всего и куча_выше(н, п, лучший) { лучший = п }
        если лучший == м { прервать }
        н = куча_обмен(н, м, лучший)
        м = лучший
    }
    вернуть н
}

/// Части после слияний: начало и длина каждой части в знаках слова, по порядку
тип Слитое {
    начала: [цел]
    длины: [цел]
}

функ текст_части(знаки: [стр], начало: цел, длина: цел) -> стр {
    если длина == 1 { вернуть знаки[начало] }
    вернуть знаки[начало..начало + длина - 1].соединить("")
}

/// приоритет слияния двух соседних частей; ничего - соединения нет
функ приоритет_слияния(сл: Словарь, левая: стр, правая: стр) -> дроб? {
    если сл.модель == "llama" {
        если пусть н = сл.номера.найти(левая + правая) { вернуть сл.оценки[н] }
        вернуть ничего
    }
    если пусть р = сл.слияния.найти(левая + " " + правая) { вернуть -дроб(р) }
    вернуть ничего
}

функ слить(сл: Словарь, знаки: [стр]) -> Слитое {
    пусть н = знаки.длина
    перем начала: [цел] = []
    перем длины: [цел] = []
    перем пред: [цел] = []
    перем след: [цел] = []
    для к в 0..н - 1 {
        начала.добавить(к)
        длины.добавить(1)
        пред.добавить(к - 1)
        если к == н - 1 { след.добавить(-1) } иначе { след.добавить(к + 1) }
    }
    перем к_ = Куча([], [], [], [])
    для к в 1..н - 1 {
        если пусть п = приоритет_слияния(сл, знаки[к - 1], знаки[к]) {
            к_ = куча_добавить(к_, п, к - 1, к, 2)
        }
    }
    пока к_.левый.длина > 0 {
        пусть л = к_.левый[0]
        пусть п = к_.правый[0]
        пусть размер = к_.длина_[0]
        к_ = куча_снять(к_)
        если длины[л] == 0 или длины[п] == 0 или длины[л] + длины[п] != размер { продолжить }
        длины[л] += длины[п]
        длины[п] = 0
        след[л] = след[п]
        если след[п] >= 0 { пред[след[п]] = л }
        // новые пары слева и справа
        для сторона в [0, 1] {
            перем а = пред[л]
            перем б = л
            если сторона == 1 {
                а = л
                б = след[л]
            }
            если а >= 0 и б >= 0 {
                пусть та = текст_части(знаки, начала[а], длины[а])
                пусть тб = текст_части(знаки, начала[б], длины[б])
                если пусть пр = приоритет_слияния(сл, та, тб) {
                    к_ = куча_добавить(к_, пр, а, б, длины[а] + длины[б])
                }
            }
        }
    }
    перем итог_н: [цел] = []
    перем итог_д: [цел] = []
    если н > 0 {
        перем к = 0
        пока к != -1 {
            итог_н.добавить(начала[к])
            итог_д.добавить(длины[к])
            к = след[к]
        }
    }
    вернуть Слитое(итог_н, итог_д)
}

/// SentencePiece: текст (со «▁» вместо пробелов) в токены. Слитые части всегда есть в словаре
/// (сливаются только пары, которые в нём есть); одиночный знак не из словаря - его байтами.
функ разбить_spm(сл: Словарь, текст_: стр) -> [цел] {
    пусть знаки = текст_.символы()
    пусть с = слить(сл, знаки)
    перем итог: [цел] = []
    для н в 0..с.начала.длина - 1 {
        пусть т = текст_части(знаки, с.начала[н], с.длины[н])
        если пусть номер = сл.номера.найти(т) {
            итог.добавить(номер)
        } иначе {
            для б в числа_байтов(байты(т)) {
                пусть ид = сл.токен_байта[б]
                если ид >= 0 { итог.добавить(ид) } иначе если сл.неизвестный >= 0 { итог.добавить(сл.неизвестный) }
            }
        }
    }
    вернуть итог
}

// ---------- классы знаков Юникода для предварительного разбиения BPE ----------
// Приближение \p{L} и \p{N}: основные алфавиты (латиница, кириллица, греческий, армянский,
// иврит, арабский, деванагари, тайский, грузинский, японский, корейский, китайский).

функ буква(к: цел) -> лог {
    если к < 128 { вернуть (к >= 65 и к <= 90) или (к >= 97 и к <= 122) }
    если к < 768 {
        вернуть (к == 170 или к == 181 или к == 186 или (к >= 192 и к <= 705 и к != 215 и к != 247) или
            (к >= 710 и к <= 721) или (к >= 736 и к <= 740) или к == 748 или к == 750)
    }
    если к < 880 { вернуть ложь }
    если к <= 1023 { вернуть к != 885 и к != 894 и к != 900 и к != 901 и к != 903 и к != 1014 }
    если к <= 1327 { вернуть не (к >= 1154 и к <= 1161) }
    если к >= 1329 и к <= 1415 { вернуть к <= 1366 или к >= 1377 }
    если к >= 1488 и к <= 1514 { вернуть истина }
    если к >= 1568 и к <= 1610 { вернуть истина }
    если к >= 1649 и к <= 1747 { вернуть истина }
    если к >= 2308 и к <= 2361 { вернуть истина }
    если к >= 3585 и к <= 3632 { вернуть истина }
    если к >= 4256 и к <= 4351 { вернуть к != 4347 }
    если к >= 7680 и к <= 8191 { вернуть истина }
    если к >= 12353 и к <= 12438 { вернуть истина }
    если к >= 12449 и к <= 12538 { вернуть истина }
    если к >= 13312 и к <= 19903 { вернуть истина }
    если к >= 19968 и к <= 40959 { вернуть истина }
    если к >= 44032 и к <= 55203 { вернуть истина }
    если к >= 63744 и к <= 64255 { вернуть истина }
    если к >= 65313 и к <= 65338 { вернуть истина }
    если к >= 65345 и к <= 65370 { вернуть истина }
    вернуть ложь
}

функ цифра_юникода(к: цел) -> лог {
    если к >= 48 и к <= 57 { вернуть истина }
    если к < 178 { вернуть ложь }
    вернуть (к == 178 или к == 179 или к == 185 или (к >= 188 и к <= 190) или (к >= 1632 и к <= 1641) или
        (к >= 1776 и к <= 1785) или (к >= 2406 и к <= 2415) или к == 8304 или (к >= 8308 и к <= 8313) или
        (к >= 8320 и к <= 8329) или (к >= 8528 и к <= 8585) или (к >= 9312 и к <= 9371) или
        (к >= 65296 и к <= 65305))
}

функ пробельный(к: цел) -> лог {
    вернуть ((к >= 9 и к <= 13) или к == 32 или к == 133 или к == 160 или к == 5760 или (к >= 8192 и к <= 8202) или
        к == 8232 или к == 8233 или к == 8239 или к == 8287 или к == 12288)
}

/// класс знака: 0 - нет знака (за концом), 1 - буква, 2 - цифра, 3 - пробельный, 4 - прочий
функ класс_знака(коды: [цел], п: цел) -> цел {
    если п < 0 или п >= коды.длина { вернуть 0 }
    пусть к = коды[п]
    если буква(к) { вернуть 1 }
    если цифра_юникода(к) { вернуть 2 }
    если пробельный(к) { вернуть 3 }
    вернуть 4
}

функ строчная_латинская(к: цел) -> цел {
    если к >= 65 и к <= 90 { вернуть к + 32 }
    вернуть к
}

/// Предварительное разбиение текста на слова для BPE (как unicode_regex_split_custom_* в llama.cpp):
/// «qwen2» - цифры по одной, «llama3» - цифры по три, иначе - правило GPT-2. Результат - длины слов в знаках.
функ предразбить(коды: [цел], правило: стр) -> [цел] {
    перем длины: [цел] = []
    пусть н = коды.длина
    перем п = 0
    перем было = 0
    пусть гпт = правило != "qwen2" и правило != "llama3"
    пока п < н {
        пусть к = коды[п]
        пусть кл = класс_знака(коды, п)
        // 's 't 're 've 'm 'll 'd
        если к == 39 и п + 1 < н {
            перем сл1 = коды[п + 1]
            если не гпт { сл1 = строчная_латинская(сл1) }
            если сл1 == 115 или сл1 == 116 или сл1 == 109 или сл1 == 100 {
                п += 2
                длины.добавить(п - было)
                было = п
                продолжить
            }
            если п + 2 < н {
                перем сл2 = коды[п + 2]
                если не гпт { сл2 = строчная_латинская(сл2) }
                если (сл1 == 114 и сл2 == 101) или (сл1 == 118 и сл2 == 101) или (сл1 == 108 и сл2 == 108) {
                    п += 3
                    длины.добавить(п - было)
                    было = п
                    продолжить
                }
            }
        }
        если гпт {
            перем кл2 = кл
            если к == 32 { кл2 = класс_знака(коды, п + 1) }
            если кл2 == 1 или кл2 == 2 или кл2 == 4 {
                если к == 32 { п += 1 }
                пока класс_знака(коды, п) == кл2 { п += 1 }
                длины.добавить(п - было)
                было = п
                продолжить
            }
        } иначе {
            // [^\r\n\p{L}\p{N}]?\p{L}+
            если не (к == 13 или к == 10 или кл == 2) {
                если кл == 1 или класс_знака(коды, п + 1) == 1 {
                    п += 1
                    пока класс_знака(коды, п) == 1 { п += 1 }
                    длины.добавить(п - было)
                    было = п
                    продолжить
                }
            }
            если кл == 2 {
                перем начало = п
                если правило == "qwen2" {
                    п += 1
                } иначе {
                    пока класс_знака(коды, п) == 2 {
                        п += 1
                        если п - начало >= 3 {
                            длины.добавить(п - было)
                            было = п
                            начало = п
                        }
                    }
                }
                если п > было {
                    длины.добавить(п - было)
                    было = п
                }
                продолжить
            }
            // <пробел>?[^\s\p{L}\p{N}]+[\r\n]*
            перем кл2 = кл
            если к == 32 { кл2 = класс_знака(коды, п + 1) }
            если кл2 == 4 {
                если к == 32 { п += 1 }
                пока класс_знака(коды, п) == 4 { п += 1 }
                пока п < н и (коды[п] == 13 или коды[п] == 10) { п += 1 }
                длины.добавить(п - было)
                было = п
                продолжить
            }
        }
        перем пробелов = 0
        перем конец_строки = 0
        пока класс_знака(коды, п + пробелов) == 3 {
            пусть к2 = коды[п + пробелов]
            если не гпт и (к2 == 13 или к2 == 10) { конец_строки = п + пробелов + 1 }
            пробелов += 1
        }
        если конец_строки > 0 {
            п = конец_строки
        } иначе если пробелов > 1 и п + пробелов < н {
            п += пробелов - 1
        } иначе если пробелов > 0 {
            п += пробелов
        } иначе {
            п += 1
        }
        длины.добавить(п - было)
        было = п
    }
    вернуть длины
}

/// BPE: кусок текста без служебных токенов в токены
функ разбить_bpe(сл: Словарь, текст_: стр) -> [цел] {
    пусть знаки_текста = текст_.символы()
    перем коды: [цел] = []
    для з в знаки_текста { коды.добавить(код_символа(з)) }
    пусть длины = предразбить(коды, сл.правило)
    перем итог: [цел] = []
    перем п = 0
    для д в длины {
        // слово байтами, каждый байт - своим знаком
        перем знаки: [стр] = []
        для б в числа_байтов(байты(знаки_текста[п..п + д - 1].соединить(""))) { знаки.добавить(сл.знак_байта[б]) }
        п += д
        // Llama 3: слово, которое целиком есть в словаре, не разбивается (ignore_merges)
        если сл.правило == "llama3" {
            если пусть целое_ = сл.номера.найти(знаки.соединить("")) {
                итог.добавить(целое_)
                продолжить
            }
        }
        пусть с = слить(сл, знаки)
        для н в 0..с.начала.длина - 1 {
            пусть т = текст_части(знаки, с.начала[н], с.длины[н])
            если пусть номер = сл.номера.найти(т) {
                итог.добавить(номер)
            } иначе {
                для з в т.символы() {
                    если пусть номер_ = сл.номера.найти(з) { итог.добавить(номер_) }
                }
            }
        }
    }
    вернуть итог
}

/// Кусок текста: либо обычный текст, либо найденный в нём служебный токен
тип Кусок {
    текст: стр
    токен: цел
}

/// Разделить текст по служебным токенам (как tokenizer_st_partition в llama.cpp)
функ разделить_служебные(сл: Словарь, текст_: стр, служебные_: лог) -> [Кусок] {
    перем куски = [Кусок(текст_, -1)]
    для ид в сл.служебные {
        // без разбора служебных частей ищутся только заданные пользователем токены
        если не служебные_ и сл.виды[ид] != 4 { продолжить }
        пусть т = сл.тексты[ид]
        если не текст_.содержит(т) { продолжить }
        перем новые: [Кусок] = []
        для к в куски {
            если к.токен >= 0 {
                новые.добавить(к)
                продолжить
            }
            перем остаток = к.текст
            пока истина {
                пусть место = остаток.найти(т)
                если место < 0 {
                    если остаток != "" { новые.добавить(Кусок(остаток, -1)) }
                    прервать
                }
                если место > 0 { новые.добавить(Кусок(остаток[0..место - 1], -1)) }
                новые.добавить(Кусок("", ид))
                пусть дальше = место + т.длина
                если дальше >= остаток.длина {
                    остаток = ""
                } иначе {
                    остаток = остаток[дальше..остаток.длина - 1]
                }
            }
        }
        куски = новые
    }
    вернуть куски
}

/// Разбить текст на токены, как llama_tokenize в llama.cpp: служебные части текста («<|im_start|>»
/// и т.п.) становятся своими токенами, если служебные_ = истина; начало (BOS) добавляется, если
/// так задано в модели и добавить_начало = истина.
общий функ Словарь.разбить_текст(текст_: стр, добавить_начало: лог, служебные_: лог) -> [цел] {
    перем итог: [цел] = []
    если добавить_начало и сам.добавлять_начало и сам.начало >= 0 { итог.добавить(сам.начало) }
    перем куски: [Кусок] = []
    если текст_ != "" { куски = разделить_служебные(сам, текст_, служебные_) }
    перем после_служебного = истина
    для к в куски {
        если к.токен >= 0 {
            итог.добавить(к.токен)
            после_служебного = истина
            продолжить
        }
        если сам.модель == "llama" {
            перем т = к.текст
            если сам.пробел_в_начале и после_служебного { т = " " + т }
            для ид в разбить_spm(сам, т.заменить(" ", "▁")) { итог.добавить(ид) }
        } иначе {
            для ид в разбить_bpe(сам, к.текст) { итог.добавить(ид) }
        }
        после_служебного = ложь
    }
    если добавить_начало и сам.добавлять_конец и сам.конец >= 0 { итог.добавить(сам.конец) }
    вернуть итог
}

/// Байты токена (без служебных токенов, если служебные_ = ложь), как llama_token_to_piece
функ Словарь.байты_токена(ид: цел, служебные_: лог) -> байты {
    если ид < 0 или ид >= сам.тексты.длина { вернуть байты("") }
    пусть вид = сам.виды[ид]
    пусть т = сам.тексты[ид]
    если вид == 2 или вид == 3 {
        если служебные_ { вернуть байты(т) }
        вернуть байты("")
    }
    если вид == 4 { вернуть байты(т) }
    если вид == 6 {
        если т.длина == 6 и т.начинается("<0x") {
            если пусть б = из_шестнадцатеричной_(т[3..4]) { вернуть байты([б]) }
        }
        вернуть байты(т)
    }
    если сам.модель == "llama" { вернуть байты(т.заменить("▁", " ")) }
    перем числа: [цел] = []
    для з в т.символы() {
        если пусть б = сам.байт_знака.найти(з) {
            числа.добавить(б)
        } иначе {
            для б2 в числа_байтов(байты(з)) { числа.добавить(б2) }
        }
    }
    вернуть байты(числа)
}

функ из_шестнадцатеричной_(т: стр) -> цел? {
    пусть цифры = "0123456789ABCDEF"
    пусть с = т.прописные()
    пусть а = цифры.найти(с[0])
    пусть б = цифры.найти(с[1])
    если а < 0 или б < 0 { вернуть ничего }
    вернуть а * 16 + б
}

/// Текст токенов (служебные токены пропускаются)
функ Словарь.текст_токенов(токены: [цел]) -> стр {
    перем б = байты("")
    для ид в токены { б = б + сам.байты_токена(ид, ложь) }
    вернуть стр(б)
}


// ======================================================================
// Веса
// ======================================================================

/// Матрица весов: строк по столбцов чисел в одном из видов, которые умеют ядра языка
тип Вес {
    /// вид GGML: 0 - дроб32, 1 - дроб16, 8 - Q8_0 (8 бит блоками по 32); 2 - Q4_0, 12 - Q4_K, 13 - Q5_K,
    /// 14 - Q6_K (байты блоков как в файле, в поле к8)
    вид: цел
    строк: цел
    столбцов: цел
    ф32: массив<дроб32>
    ф16: массив<дроб16>
    к8: массив<байт>
}

/// Матрица на вектор на всех ядрах
функ Вес.умножить(х: массив<дроб32>) -> массив<дроб32> {
    выбор сам.вид {
        8 { вернуть матвек_q8(сам.к8, х) }
        12 { вернуть матвек_q4k(сам.к8, х) }
        14 { вернуть матвек_q6k(сам.к8, х) }
        13 { вернуть матвек_q5k(сам.к8, х) }
        2 { вернуть матвек_q4_0(сам.к8, х) }
        1 { вернуть матвек(сам.ф16, х) }
        иначе { вернуть матвек(сам.ф32, х) }
    }
}

/// Байтов в строке весов
функ Вес.байт_строки() -> цел {
    выбор сам.вид {
        0 { вернуть сам.столбцов * 4 }
        1 { вернуть сам.столбцов * 2 }
        8 { вернуть частное(сам.столбцов, 32) * 34 }
        2 { вернуть частное(сам.столбцов, 32) * 18 }
        12 { вернуть частное(сам.столбцов, 256) * 144 }
        13 { вернуть частное(сам.столбцов, 256) * 176 }
        иначе { вернуть частное(сам.столбцов, 256) * 210 }
    }
}

/// Строки с первой по первая + строк - 1 (без копирования)
функ Вес.строки(первая: цел, строк: цел) -> Вес {
    перем р = сам
    р.строк = строк
    выбор сам.вид {
        0 { р.ф32 = сам.ф32[первая * сам.столбцов..(первая + строк) * сам.столбцов - 1] }
        1 { р.ф16 = сам.ф16[первая * сам.столбцов..(первая + строк) * сам.столбцов - 1] }
        иначе {
            пусть б = сам.байт_строки()
            р.к8 = сам.к8[первая * б..(первая + строк) * б - 1]
        }
    }
    вернуть р
}

/// Сколько байтов весов на поток умножается на все векторы пакета, пока они в кэше процессора
/// (переменная окружения DAN_NEYRO_KUSOK - для замеров и проверки). 4 МБ на поток - кусок в общем
/// кэше третьего уровня: на EPYC 9V74 (4 потока) запрос так читается быстрее всего, куски меньше
/// проигрывают на вызовах ядер и переводе векторов в 8 бит (замеры/результаты.md)
функ байт_куска_на_поток() -> цел {
    если пусть з = переменная_среды("DAN_NEYRO_KUSOK") {
        если пусть ч = разобрать_цел(з) { если ч > 0 { вернуть ч } }
    }
    вернуть 4_194_304
}

/// Матрица на несколько векторов. Веса читаются из памяти кусками строк: кусок умножается на все
/// векторы, пока лежит в кэше процессора, поэтому память читается один раз на пакет, а не на каждый
/// вектор. Каждое число результата побитно то же, что у умножить (строки считаются независимо).
функ Вес.умножить_пакет(хи: [массив<дроб32>], кусок: цел) -> [массив<дроб32>] {
    если хи.длина == 1 { вернуть [сам.умножить(хи[0])] }
    пусть строк_куска = мин(сам.строк, макс(1, частное(кусок * число_потоков(), сам.байт_строки())))
    перем части: [[массив<дроб32>]] = []
    перем строка = 0
    пока строка < сам.строк {
        пусть н = мин(строк_куска, сам.строк - строка)
        пусть кус = сам.строки(строка, н)
        перем ч: [массив<дроб32>] = []
        для х в хи { ч.добавить(кус.умножить(х)) }
        части.добавить(ч)
        строка += н
    }
    если части.длина == 1 { вернуть части[0] }
    перем р: [массив<дроб32>] = []
    для т в 0..хи.длина - 1 {
        перем у = массив(дроб32, сам.строк)
        перем о = 0
        для ч в части {
            пусть кус = ч[т]
            для j в 0..кус.длина - 1 { у[о + j] = кус[j] }
            о += кус.длина
        }
        р.добавить(у)
    }
    вернуть р
}

/// Данные тензора как они лежат в файле: байты и тот же кусок в половинной точности (для масштабов блоков)
тип Сырые {
    б: массив<байт>
    п: массив<дроб16>
}

функ сырые_тензора(путь: стр, т: Тензор) -> Сырые! {
    пусть б = массив_из_файла(байт, путь, т.смещение, т.байтов)!
    перем п = массив(дроб16, 0)
    если т.байтов % 2 == 0 и т.смещение % 2 == 0 {
        п = массив_из_файла(дроб16, путь, т.смещение, частное(т.байтов, 2))!
    }
    вернуть Сырые(б, п)
}

функ знаковый8(б: цел) -> цел {
    если б >= 128 { вернуть б - 256 }
    вернуть б
}

/// масштаб и сдвиг блока K-квантов (get_scale_min_k4 в llama.cpp): [масштаб, сдвиг]
функ масштаб_k4(с: массив<байт>, о: цел, j: цел) -> [цел] {
    если j < 4 { вернуть [с[о + j] % 64, с[о + j + 4] % 64] }
    вернуть [с[о + j + 4] % 16 + частное(с[о + j - 4], 64) * 16, частное(с[о + j + 4], 16) + частное(с[о + j], 64) * 16]
}

/// Развернуть блоки тензора с первый_ по первый_ + блоков - 1 в числа дроб32 (как dequantize_row_* в llama.cpp)
функ развернуть_блоки(т: Тензор, с: Сырые, первый_: цел, блоков: цел) -> массив<дроб32> {
    пусть рб = размер_блока(т.вид)
    пусть в_блоке = рб[0]
    пусть байт_блока = рб[1]
    перем р_ = массив(дроб32, блоков * в_блоке)
    пусть д = с.б
    пусть п = с.п
    для бл в 0..блоков - 1 {
        пусть о = (первый_ + бл) * байт_блока
        пусть h = частное(о, 2)
        пусть у = бл * в_блоке
        выбор т.вид {
            0 { }
            30 {
                // BF16: старшие 16 бит числа дроб32
                пусть з = д[о] + д[о + 1] * 256
                пусть знак = частное(з, 32768)
                пусть пор = частное(з, 128) % 256
                пусть ман = з % 128
                перем ч = 0.0
                если пор == 0 {
                    ч = дроб(ман) / 128.0 * 2.0 ^ (-126)
                } иначе если пор == 255 {
                    ч = 0.0                           // бесконечность и не-число в весах не бывают
                } иначе {
                    ч = (1.0 + дроб(ман) / 128.0) * 2.0 ^ (пор - 127)
                }
                если знак == 1 { ч = -ч }
                р_[у] = ч
            }
            2 {
                пусть дл = п[h]
                для j в 0..15 {
                    пусть б = д[о + 2 + j]
                    р_[у + j] = дроб(б % 16 - 8) * дл
                    р_[у + j + 16] = дроб(частное(б, 16) - 8) * дл
                }
            }
            3 {
                пусть дл = п[h]
                пусть м = п[h + 1]
                для j в 0..15 {
                    пусть б = д[о + 4 + j]
                    р_[у + j] = дроб(б % 16) * дл + м
                    р_[у + j + 16] = дроб(частное(б, 16)) * дл + м
                }
            }
            6, 7 {
                перем нач = 6
                перем дл = п[h]
                перем м = 0.0
                перем сдвиг = 16
                если т.вид == 7 {
                    нач = 8
                    м = п[h + 1]
                    сдвиг = 0
                }
                пусть qh = д[о + нач - 4] + д[о + нач - 3] * 256 + д[о + нач - 2] * 65536 + д[о + нач - 1] * 16777216
                перем бит = 1
                для j в 0..15 {
                    пусть б = д[о + нач + j]
                    перем х0 = б % 16
                    перем х1 = частное(б, 16)
                    если частное(qh, бит) % 2 == 1 { х0 += 16 }
                    если частное(qh, бит * 65536) % 2 == 1 { х1 += 16 }
                    если т.вид == 7 {
                        р_[у + j] = дроб(х0) * дл + м
                        р_[у + j + 16] = дроб(х1) * дл + м
                    } иначе {
                        р_[у + j] = дроб(х0 - сдвиг) * дл          // без «+ 0.0»: -0.0 остаётся -0.0, как в ggml
                        р_[у + j + 16] = дроб(х1 - сдвиг) * дл
                    }
                    бит *= 2
                }
            }
            8 {
                пусть дл = п[h]
                для j в 0..31 {
                    р_[у + j] = дроб(знаковый8(д[о + 2 + j])) * дл
                }
            }
            12, 13 {
                пусть дл = п[h]
                пусть мин_ = п[h + 1]
                перем q = о + 16
                если т.вид == 13 { q = о + 48 }
                перем is = 0
                перем u1 = 1
                для j в 0..3 {
                    пусть с1 = масштаб_k4(д, о + 4, is)
                    пусть с2 = масштаб_k4(д, о + 4, is + 1)
                    пусть д1 = дл * дроб(с1[0])
                    пусть м1 = мин_ * дроб(с1[1])
                    пусть д2 = дл * дроб(с2[0])
                    пусть м2 = мин_ * дроб(с2[1])
                    для l в 0..31 {
                        пусть б = д[q + l]
                        перем х0 = б % 16
                        перем х1 = частное(б, 16)
                        если т.вид == 13 {
                            пусть hb = д[о + 16 + l]
                            если частное(hb, u1) % 2 == 1 { х0 += 16 }
                            если частное(hb, u1 * 2) % 2 == 1 { х1 += 16 }
                        }
                        р_[у + j * 64 + l] = д1 * дроб(х0) - м1
                        р_[у + j * 64 + 32 + l] = д2 * дроб(х1) - м2
                    }
                    q += 32
                    is += 2
                    u1 *= 4
                }
            }
            14 {
                пусть дл = п[h + 104]
                для н в 0..1 {
                    пусть ql = о + н * 64
                    пусть qh = о + 128 + н * 32
                    пусть sc = о + 192 + н * 8
                    для l в 0..31 {
                        пусть is = частное(l, 16)
                        пусть а = д[ql + l]
                        пусть б = д[ql + l + 32]
                        пусть ч = д[qh + l]
                        пусть q1 = а % 16 + (ч % 4) * 16 - 32
                        пусть q2 = б % 16 + (частное(ч, 4) % 4) * 16 - 32
                        пусть q3 = частное(а, 16) + (частное(ч, 16) % 4) * 16 - 32
                        пусть q4 = частное(б, 16) + частное(ч, 64) * 16 - 32
                        пусть база = у + н * 128
                        р_[база + l] = дл * дроб(знаковый8(д[sc + is])) * дроб(q1)
                        р_[база + l + 32] = дл * дроб(знаковый8(д[sc + is + 2])) * дроб(q2)
                        р_[база + l + 64] = дл * дроб(знаковый8(д[sc + is + 4])) * дроб(q3)
                        р_[база + l + 96] = дл * дроб(знаковый8(д[sc + is + 6])) * дроб(q4)
                    }
                }
            }
            иначе { }
        }
    }
    вернуть р_
}

/// Можно ли развернуть тензор этого вида
функ вид_поддерживается(вид: цел) -> лог {
    вернуть [0, 1, 2, 3, 6, 7, 8, 12, 13, 14, 30].содержит(вид)
}

/// Строки тензора с первой по первая + строк - 1 числами дроб32
функ строки_тензора(путь: стр, т: Тензор, первая: цел, строк: цел) -> массив<дроб32>! {
    пусть столбцов = т.размеры[0]
    если т.вид == 0 {
        вернуть массив_из_файла(дроб32, путь, т.смещение + первая * столбцов * 4, строк * столбцов)
    }
    если т.вид == 1 {
        вернуть в_дроб32(массив_из_файла(дроб16, путь, т.смещение + первая * столбцов * 2, строк * столбцов)!)
    }
    пусть рб = размер_блока(т.вид)
    пусть блоков_в_строке = частное(столбцов, рб[0])
    если вид_ядра(т.вид) {
        // ядро языка разворачивает только нужные строки: те же числа, что dequantize_row_* ggml
        пусть байт_строки = блоков_в_строке * рб[1]
        пусть б = массив_из_файла(байт, путь, т.смещение + первая * байт_строки, строк * байт_строки)!
        выбор т.вид {
            12 { вернуть из_q4k(б) }
            14 { вернуть из_q6k(б) }
            13 { вернуть из_q5k(б) }
            иначе { вернуть из_q4_0(б) }
        }
    }
    пусть с = сырые_тензора(путь, т)!
    вернуть развернуть_блоки(т, с, первая * блоков_в_строке, строк * блоков_в_строке)
}

/// Есть ли у языка ядра для весов этого вида (Q4_0, Q4_K, Q5_K, Q6_K): такие веса не разворачиваются
функ вид_ядра(вид: цел) -> лог {
    вернуть вид == 2 или вид == 12 или вид == 13 или вид == 14
}

/// Вектор (одномерный тензор, нормировка или сдвиг) числами дроб32
функ вектор_тензора(путь: стр, ф: Файл, имя: стр, длина: цел) -> массив<дроб32>! {
    если пусть т = ф.тензор(имя) {
        если т.элементов != длина {
            вернуть ошибка("у тензора «" + имя + "» " + стр(т.элементов) + " чисел, а нужно " + стр(длина))
        }
        если не вид_поддерживается(т.вид) { вернуть ошибка("тип " + имя_вида(т.вид) + " тензора «" + имя + "» не поддерживается") }
        вернуть строки_тензора(путь, т, 0, частное(т.элементов, т.размеры[0]))
    }
    вернуть ошибка("в файле нет тензора «" + имя + "»")
}

/// Матрица весов: строк - выходов, столбцов - входов
функ вес_тензора(путь: стр, ф: Файл, имя: стр, столбцов: цел, строк: цел, точные: лог) -> Вес! {
    пусть т = ф.тензор(имя) иначе Тензор("", [], -1, 0, 0, 0)
    если т.вид < 0 { вернуть ошибка("в файле нет тензора «" + имя + "»") }
    если т.размеры.длина != 2 или т.размеры[0] != столбцов или т.размеры[1] != строк {
        вернуть ошибка("у тензора «" + имя + "» размеры " + стр(т.размеры) + ", а нужно [" + стр(столбцов) + ", " + стр(строк) + "]")
    }
    если не вид_поддерживается(т.вид) { вернуть ошибка("тип " + имя_вида(т.вид) + " тензора «" + имя + "» пока не поддерживается") }
    пусть пусто32 = массив(дроб32, 0)
    пусть пусто16 = массив(дроб16, 0)
    пусть пусто8 = массив(байт, 0)
    если т.вид == 0 {
        вернуть Вес(0, строк, столбцов, массив_из_файла(дроб32, путь, т.смещение, т.элементов)!, пусто16, пусто8)
    }
    если т.вид == 1 {
        вернуть Вес(1, строк, столбцов, пусто32, массив_из_файла(дроб16, путь, т.смещение, т.элементов)!, пусто8)
    }
    если т.вид == 8 {
        вернуть Вес(8, строк, столбцов, пусто32, пусто16, массив_из_файла(байт, путь, т.смещение, т.байтов)!)
    }
    если вид_ядра(т.вид) и не точные {
        // Q4_0, Q4_K, Q5_K, Q6_K считаются своими ядрами прямо из отображённого файла, без копии
        вернуть Вес(т.вид, строк, столбцов, пусто32, пусто16, массив_из_файла(байт, путь, т.смещение, т.байтов)!)
    }
    // прочие виды разворачиваются при загрузке: точно (дроб32) или в 8 бит (Q8_0, вчетверо меньше памяти)
    пусть с = сырые_тензора(путь, т)!
    пусть рб = размер_блока(т.вид)
    пусть блоков_в_строке = частное(столбцов, рб[0])
    если точные или столбцов % 32 != 0 {
        вернуть Вес(0, строк, столбцов, развернуть_блоки(т, с, 0, строк * блоков_в_строке), пусто16, пусто8)
    }
    пусть байт_строки = частное(столбцов, 32) * 34
    перем к8 = массив(байт, строк * байт_строки)
    пусть часть = мин(строк, макс(1, частное(1_048_576, столбцов)))
    перем строка = 0
    пока строка < строк {
        пусть н = мин(часть, строк - строка)
        пусть кв = квантовать_q8(развернуть_блоки(т, с, строка * блоков_в_строке, н * блоков_в_строке))
        пусть начало = строка * байт_строки
        для к в 0..кв.длина - 1 {
            к8[начало + к] = кв[к]
        }
        строка += н
    }
    вернуть Вес(8, строк, столбцов, пусто32, пусто16, к8)
}

// ======================================================================
// Модель
// ======================================================================

/// Как загрузить модель
общий тип Настройки {
    /// размер контекста в токенах (запрос и ответ вместе); 0 - как в модели
    контекст: цел = 2048
    /// ложь - веса Q4_0, Q4_K, Q5_K, Q6_K считаются своими ядрами как есть, а виды без ядер (Q4_1, Q5_0,
    /// Q5_1, BF16) разворачиваются при загрузке в Q8_0; истина - все эти виды разворачиваются точно в дроб32
    /// (в 4-8 раз больше памяти)
    точные_веса: лог = ложь
    /// ложь - кэш ключей и значений в половинной точности (дроб16, вдвое меньше памяти, как f16 в llama.cpp);
    /// истина - в дроб32
    точный_кэш: лог = ложь
}

/// Слой трансформера
тип Слой {
    норма_внимания: массив<дроб32>
    запрос: Вес
    ключ: Вес
    значение: Вес
    выход: Вес
    /// сдвиги запроса, ключа и значения (у Qwen2); пустые - нет
    сдвиг_запроса: массив<дроб32>
    сдвиг_ключа: массив<дроб32>
    сдвиг_значения: массив<дроб32>
    норма_ffn: массив<дроб32>
    затвор: Вес
    вверх: Вес
    вниз: Вес
}

/// Загруженная модель (веса отображены из файла в память)
общий тип Модель {
    путь: стр
    файл: Файл
    словарь: Словарь
    архитектура: стр
    ширина: цел
    слоёв: цел
    голов: цел
    голов_кв: цел
    ширина_головы: цел
    ширина_ffn: цел
    размер_словаря: цел
    контекст: цел
    эпсилон: дроб
    основание_rope: дроб
    масштаб_rope: дроб
    измерений_rope: цел
    /// 0 - поворот соседних пар (llama), 2 - половин (neox, Qwen2)
    вид_rope: цел
    множители_rope: массив<дроб32>
    встраивание: Тензор
    норма_выхода: массив<дроб32>
    выход: Вес
    слои: [Слой]
    /// кэш ключей и значений в дроб32 (иначе - в дроб16)
    точный_кэш: лог = ложь
    /// байты встраивания, отображённые из файла (для видов, которые разворачивает ядро языка); пустые - нет
    встр_байты: массив<байт> = массив(байт, 0)
    /// байтов весов на поток в куске пакетного умножения (Вес.умножить_пакет)
    кусок: цел = 4_194_304
}

/// Загрузить модель с настройками по умолчанию
общий функ загрузить(путь: стр) -> Модель! {
    вернуть загрузить_с_настройками(путь, Настройки())
}

функ нужно_целое(ф: Файл, ключ: стр) -> цел! {
    если пусть ч = ф.целое(ключ) {
        если ч <= 0 или ч > 100_000_000 { вернуть ошибка("неверное значение " + ключ + ": " + стр(ч)) }
        вернуть ч
    }
    вернуть ошибка("в файле нет ключа " + ключ)
}

/// Загрузить модель архитектуры llama или qwen2 из файла GGUF
общий функ загрузить_с_настройками(путь: стр, н: Настройки) -> Модель! {
    пусть ф = открыть_gguf(путь)!
    если пусть м = собрать_модель(ф, н) {
        вернуть м
    } иначе ошибка о {
        вернуть ошибка("модель «" + путь + "» не загружена: " + о)
    }
}

функ собрать_модель(ф: Файл, н: Настройки) -> Модель! {
    пусть путь = ф.путь
    пусть арх = ф.текст("general.architecture") иначе ""
    пусть известные = ["llama", "mistral", "qwen2"]
    если не известные.содержит(арх) {
        вернуть ошибка("архитектура «" + арх + "» не поддерживается (есть llama, mistral, qwen2)")
    }
    пусть сл = словарь_из(ф)!
    пусть ширина = нужно_целое(ф, арх + ".embedding_length")!
    пусть слоёв = нужно_целое(ф, арх + ".block_count")!
    пусть голов = нужно_целое(ф, арх + ".attention.head_count")!
    перем голов_кв = голов
    если пусть ч = ф.целое(арх + ".attention.head_count_kv") { голов_кв = ч }
    если голов_кв <= 0 или голов % голов_кв != 0 { вернуть ошибка("число голов (" + стр(голов) + ") не делится на число голов ключей (" + стр(голов_кв) + ")") }
    если ширина % голов != 0 { вернуть ошибка("ширина не делится на число голов") }
    перем шг = частное(ширина, голов)
    если пусть ч = ф.целое(арх + ".attention.key_length") { шг = ч }
    если шг <= 0 или шг % 2 != 0 { вернуть ошибка("неверная ширина головы " + стр(шг)) }
    пусть ffn = нужно_целое(ф, арх + ".feed_forward_length")!
    перем изм = шг
    если пусть ч = ф.целое(арх + ".rope.dimension_count") { изм = ч }
    если изм <= 0 или изм > шг или изм % 2 != 0 { вернуть ошибка("неверное число измерений поворота " + стр(изм)) }
    перем контекст = н.контекст
    перем обучение = 2048
    если пусть ч = ф.целое(арх + ".context_length") { обучение = ч }
    если контекст <= 0 { контекст = обучение }
    если контекст > 1_048_576 { вернуть ошибка("слишком большой контекст " + стр(контекст)) }
    пусть эпс = ф.дробное(арх + ".attention.layer_norm_rms_epsilon") иначе 0.00001
    пусть основание = ф.дробное(арх + ".rope.freq_base") иначе 10000.0
    перем масштаб = 1.0
    пусть вид_масштаба = ф.текст(арх + ".rope.scaling.type") иначе "none"
    если вид_масштаба == "linear" {
        пусть множ = ф.дробное(арх + ".rope.scaling.factor") иначе 1.0
        если множ > 0.0 { масштаб = 1.0 / множ }
    } иначе если вид_масштаба != "none" {
        вернуть ошибка("растяжение поворота «" + вид_масштаба + "» не поддерживается")
    }
    перем вид_rope = 0
    если арх == "qwen2" { вид_rope = 2 }
    пусть словарь_н = сл.тексты.длина
    пусть встр = ф.тензор("token_embd.weight") иначе Тензор("", [], -1, 0, 0, 0)
    если встр.вид < 0 { вернуть ошибка("в файле нет тензора «token_embd.weight»") }
    если встр.размеры.длина != 2 или встр.размеры[0] != ширина или встр.размеры[1] != словарь_н {
        вернуть ошибка("у тензора «token_embd.weight» размеры " + стр(встр.размеры) + ", а нужно [" + стр(ширина) + ", " + стр(словарь_н) + "]")
    }
    если не вид_поддерживается(встр.вид) { вернуть ошибка("тип " + имя_вида(встр.вид) + " тензора встраивания не поддерживается") }
    перем встр_байты = массив(байт, 0)
    если встр.вид == 8 или вид_ядра(встр.вид) {
        встр_байты = массив_из_файла(байт, путь, встр.смещение, встр.байтов)!
    }
    пусть кв = голов_кв * шг
    пусть т = н.точные_веса
    перем слои: [Слой] = []
    для с в 0..слоёв - 1 {
        пусть п = "blk." + стр(с) + "."
        перем сдв_з = массив(дроб32, 0)
        перем сдв_к = массив(дроб32, 0)
        перем сдв_зн = массив(дроб32, 0)
        если ф.тензор(п + "attn_q.bias") != ничего {
            сдв_з = вектор_тензора(путь, ф, п + "attn_q.bias", голов * шг)!
            сдв_к = вектор_тензора(путь, ф, п + "attn_k.bias", кв)!
            сдв_зн = вектор_тензора(путь, ф, п + "attn_v.bias", кв)!
        }
        слои.добавить(Слой(
            вектор_тензора(путь, ф, п + "attn_norm.weight", ширина)!,
            вес_тензора(путь, ф, п + "attn_q.weight", ширина, голов * шг, т)!,
            вес_тензора(путь, ф, п + "attn_k.weight", ширина, кв, т)!,
            вес_тензора(путь, ф, п + "attn_v.weight", ширина, кв, т)!,
            вес_тензора(путь, ф, п + "attn_output.weight", голов * шг, ширина, т)!,
            сдв_з, сдв_к, сдв_зн,
            вектор_тензора(путь, ф, п + "ffn_norm.weight", ширина)!,
            вес_тензора(путь, ф, п + "ffn_gate.weight", ширина, ffn, т)!,
            вес_тензора(путь, ф, п + "ffn_up.weight", ширина, ffn, т)!,
            вес_тензора(путь, ф, п + "ffn_down.weight", ffn, ширина, т)!))
    }
    перем выход_имя = "output.weight"
    если ф.тензор(выход_имя) == ничего { выход_имя = "token_embd.weight" }   // общие веса встраивания и выхода
    перем множители = массив(дроб32, 0)
    если ф.тензор("rope_freqs.weight") != ничего {
        множители = вектор_тензора(путь, ф, "rope_freqs.weight", частное(изм, 2))!
    }
    вернуть Модель(путь, ф, сл, арх, ширина, слоёв, голов, голов_кв, шг, ffn, словарь_н, контекст, эпс, основание, масштаб,
        изм, вид_rope, множители, встр, вектор_тензора(путь, ф, "output_norm.weight", ширина)!,
        вес_тензора(путь, ф, выход_имя, ширина, словарь_н, т)!, слои, н.точный_кэш, встр_байты, байт_куска_на_поток())
}

// ======================================================================
// Проход модели
// ======================================================================

/// Состояние разговора с моделью: токены в кэше ключей и значений и логиты последнего шага
общий тип Сеанс {
    токены: [цел]
    /// кэш в дроб32 (Настройки.точный_кэш) по слоям и головам ключей: номер слой * голов_кв + голова,
    /// внутри - [позиция][ширина головы]; при кэше в половинной точности пустые
    ключи: [массив<дроб32>]
    значения: [массив<дроб32>]
    /// логиты после последнего токена (по одному на токен словаря)
    логиты: массив<дроб32>
    /// состояние генератора случайных чисел выборки
    случайное_: цел = 1
    /// ошибка последнего шага ("" - нет); после ошибки сеанс не меняется
    ошибка: стр = ""
    /// кэш в половинной точности (по умолчанию), устроен так же, как ключи и значения
    ключи16: [массив<дроб16>] = []
    значения16: [массив<дроб16>] = []
}

/// Ошибка-значение, если последний шаг сеанса не выполнен
общий функ Сеанс.проверить() -> ! {
    если сам.ошибка != "" { вернуть ошибка(сам.ошибка) }
}

/// Новый пустой сеанс (кэш на весь контекст модели; память выделяется по мере заполнения)
общий функ Модель.сеанс() -> Сеанс {
    перем ключи: [массив<дроб32>] = []
    перем значения: [массив<дроб32>] = []
    перем ключи16: [массив<дроб16>] = []
    перем значения16: [массив<дроб16>] = []
    для к в 1..сам.слоёв * сам.голов_кв {
        если сам.точный_кэш {
            ключи.добавить(массив(дроб32, сам.контекст * сам.ширина_головы))
            значения.добавить(массив(дроб32, сам.контекст * сам.ширина_головы))
        } иначе {
            ключи16.добавить(массив(дроб16, сам.контекст * сам.ширина_головы))
            значения16.добавить(массив(дроб16, сам.контекст * сам.ширина_головы))
        }
    }
    вернуть Сеанс([], ключи, значения, массив(дроб32, 0), ключи16 = ключи16, значения16 = значения16)
}

/// Повернуть векторы голов (RoPE) на позицию: кос и син - по паре измерений
функ повернуть(х: массив<дроб32>, голов: цел, шг: цел, изм: цел, вид: цел, кос: [дроб], син: [дроб]) -> массив<дроб32> {
    перем р = х
    пусть пол = частное(изм, 2)
    для г в 0..голов - 1 {
        пусть о = г * шг
        для j в 0..пол - 1 {
            перем а = о + 2 * j
            перем б = а + 1
            если вид == 2 {
                а = о + j
                б = о + j + пол
            }
            пусть х0 = х[а]
            пусть х1 = х[б]
            р[а] = х0 * кос[j] - х1 * син[j]
            р[б] = х0 * син[j] + х1 * кос[j]
        }
    }
    вернуть р
}

/// cos и sin углов поворота для позиции (как rope_cache_init в ggml: угол умножается на шаг в дроб32)
функ углы(м: Модель, поз: цел) -> [[дроб]] {
    пусть пол = частное(м.измерений_rope, 2)
    перем угол = массив(дроб32, 1, дроб(поз))
    перем шаг = массив(дроб32, 1)
    шаг[0] = м.основание_rope ^ (-2.0 / дроб(м.измерений_rope))
    перем кос: [дроб] = []
    перем син: [дроб] = []
    для j в 0..пол - 1 {
        перем т = угол[0]
        если м.множители_rope.длина > 0 { т = т / м.множители_rope[j] }
        т = т * м.масштаб_rope
        перем к1 = массив(дроб32, 2)
        к1[0] = косинус(т)
        к1[1] = синус(т)
        кос.добавить(к1[0])
        син.добавить(к1[1])
        угол[0] = угол[0] * шаг[0]
    }
    вернуть [кос, син]
}

функ сложить_сдвиг(х: массив<дроб32>, сдвиг: массив<дроб32>) -> массив<дроб32> {
    если сдвиг.длина == 0 { вернуть х }
    вернуть прибавить_кратное(х, 1.0, сдвиг)
}

/// Вектор встраивания токена
функ Модель.встраивание_токена(ид: цел) -> массив<дроб32>! {
    пусть вид = сам.встраивание.вид
    если сам.встр_байты.длина > 0 {
        пусть рб = размер_блока(вид)
        пусть б = частное(сам.ширина, рб[0]) * рб[1]
        пусть строка = сам.встр_байты[ид * б..ид * б + б - 1]
        выбор вид {
            8 { вернуть из_q8(строка) }
            12 { вернуть из_q4k(строка) }
            14 { вернуть из_q6k(строка) }
            13 { вернуть из_q5k(строка) }
            иначе { вернуть из_q4_0(строка) }
        }
    }
    вернуть строки_тензора(сам.путь, сам.встраивание, ид, 1)
}

/// число для кэша в половинной точности: больше наибольшего (65504) по модулю - наибольшее
функ в_половинный(х: дроб) -> дроб {
    если х > 65504.0 { вернуть 65504.0 }
    если х < -65504.0 { вернуть -65504.0 }
    вернуть х
}

/// Внимание одного токена в позиции поз по кэшу слоя л: результат - голов * ширина головы чисел
функ Модель.внимание(н: Сеанс, л: цел, поз: цел, q: массив<дроб32>) -> массив<дроб32> {
    пусть шг = сам.ширина_головы
    пусть нкв = сам.голов_кв
    пусть группа = частное(сам.голов, нкв)
    пусть масштаб = 1.0 / корень(дроб(шг))
    пусть длина = поз + 1
    перем внимание = массив(дроб32, сам.голов * шг)
    для гкв в 0..нкв - 1 {
        пусть номер = л * нкв + гкв
        // вероятности голов группы - строками одной матрицы: значения группы умножаются одним матмат
        перем вер_группы = массив(дроб32, группа * длина)
        для гг в 0..группа - 1 {
            пусть г = гкв * группа + гг
            перем оценки = массив(дроб32, 0)
            если сам.точный_кэш {
                оценки = матвек(н.ключи[номер][0..длина * шг - 1], q[г * шг..г * шг + шг - 1])
            } иначе {
                оценки = матвек(н.ключи16[номер][0..длина * шг - 1], q[г * шг..г * шг + шг - 1])
            }
            для т в 0..поз { оценки[т] = оценки[т] * масштаб }
            пусть вер = софтмакс(оценки)
            пусть о = гг * длина
            для т в 0..поз { вер_группы[о + т] = вер[т] }
        }
        перем зн = массив(дроб32, 0)
        если сам.точный_кэш {
            зн = н.значения[номер][0..длина * шг - 1]
        } иначе {
            зн = в_дроб32(н.значения16[номер][0..длина * шг - 1])
        }
        пусть о = матмат(вер_группы, зн, длина)
        пусть начало = гкв * группа * шг
        для j в 0..группа * шг - 1 { внимание[начало + j] = о[j] }
    }
    вернуть внимание
}

/// Проход пакета токенов (номера проверены, все помещаются в контекст): кэш пополняется, логиты -
/// после последнего токена. Матрицы весов умножаются на векторы всех токенов пакета сразу
/// (Вес.умножить_пакет), остальное считается по токенам так же, как при подаче по одному, поэтому
/// числа те же.
функ Модель.проход(с: Сеанс, иды: [цел]) -> Сеанс {
    перем н = с
    н.ошибка = ""
    пусть п0 = н.токены.длина
    пусть т_ = иды.длина
    перем хи: [массив<дроб32>] = []
    для ид в иды {
        если пусть х0 = сам.встраивание_токена(ид) {
            хи.добавить(х0)
        } иначе ошибка о {
            // не «вернуть с»: с после «перем н = с» не используется, поэтому кэш переходит к н без копии
            н.ошибка = о
            вернуть н
        }
    }
    пусть шг = сам.ширина_головы
    пусть нкв = сам.голов_кв
    перем уги: [[[дроб]]] = []
    для т в 0..т_ - 1 { уги.добавить(углы(сам, п0 + т)) }
    для л в 0..сам.слоёв - 1 {
        пусть сл = сам.слои[л]
        перем хн: [массив<дроб32>] = []
        для х в хи { хн.добавить(нормировать_скв(х, сл.норма_внимания, сам.эпсилон)) }
        пусть запросы = сл.запрос.умножить_пакет(хн, сам.кусок)
        пусть ключи_ = сл.ключ.умножить_пакет(хн, сам.кусок)
        пусть значения_ = сл.значение.умножить_пакет(хн, сам.кусок)
        перем повёрнутые: [массив<дроб32>] = []
        для т в 0..т_ - 1 {
            пусть уг = уги[т]
            повёрнутые.добавить(повернуть(сложить_сдвиг(запросы[т], сл.сдвиг_запроса), сам.голов, шг, сам.измерений_rope,
                сам.вид_rope, уг[0], уг[1]))
            пусть k = повернуть(сложить_сдвиг(ключи_[т], сл.сдвиг_ключа), нкв, шг, сам.измерений_rope,
                сам.вид_rope, уг[0], уг[1])
            пусть v = сложить_сдвиг(значения_[т], сл.сдвиг_значения)
            пусть поз = п0 + т
            для г в 0..нкв - 1 {
                пусть номер = л * нкв + г
                если сам.точный_кэш {
                    для j в 0..шг - 1 {
                        н.ключи[номер][поз * шг + j] = k[г * шг + j]
                        н.значения[номер][поз * шг + j] = v[г * шг + j]
                    }
                } иначе {
                    для j в 0..шг - 1 {
                        н.ключи16[номер][поз * шг + j] = в_половинный(k[г * шг + j])
                        н.значения16[номер][поз * шг + j] = в_половинный(v[г * шг + j])
                    }
                }
            }
        }
        перем внимания: [массив<дроб32>] = []
        для т в 0..т_ - 1 { внимания.добавить(сам.внимание(н, л, п0 + т, повёрнутые[т])) }
        пусть выходы = сл.выход.умножить_пакет(внимания, сам.кусок)
        перем хн2: [массив<дроб32>] = []
        для т в 0..т_ - 1 {
            хи[т] = прибавить_кратное(хи[т], 1.0, выходы[т])
            хн2.добавить(нормировать_скв(хи[т], сл.норма_ffn, сам.эпсилон))
        }
        пусть затворы = сл.затвор.умножить_пакет(хн2, сам.кусок)
        пусть вверх = сл.вверх.умножить_пакет(хн2, сам.кусок)
        перем акт: [массив<дроб32>] = []
        для т в 0..т_ - 1 {
            пусть затв = затворы[т]
            перем вв = вверх[т]
            для j в 0..вв.длина - 1 {
                пусть з = затв[j]
                вв[j] = з / (1.0 + экспонента(-з)) * вв[j]
            }
            акт.добавить(вв)
        }
        пусть вниз = сл.вниз.умножить_пакет(акт, сам.кусок)
        для т в 0..т_ - 1 { хи[т] = прибавить_кратное(хи[т], 1.0, вниз[т]) }
    }
    пусть хк = нормировать_скв(хи[т_ - 1], сам.норма_выхода, сам.эпсилон)
    н.логиты = сам.выход.умножить(хк)
    для ид в иды { н.токены.добавить(ид) }
    вернуть н
}

/// Почему токен нельзя подать в позицию поз ("" - можно)
функ Модель.нельзя_подать(ид: цел, поз: цел) -> стр {
    если ид < 0 или ид >= сам.размер_словаря { вернуть "нет токена с номером " + стр(ид) }
    если поз >= сам.контекст {
        вернуть "контекст модели заполнен: " + стр(сам.контекст) + " токенов; увеличьте Настройки.контекст"
    }
    вернуть ""
}

/// Подать модели один токен: кэш пополняется, в сеансе - логиты следующего токена. Если токен
/// подать нельзя (нет такого номера, контекст заполнен), сеанс не меняется, а в поле «ошибка» -
/// причина (проверка - с.проверить()). Сеанс передаётся и возвращается без копирования кэша,
/// если писать с = м.подать(с, ид).
общий функ Модель.подать(с: Сеанс, ид: цел) -> Сеанс {
    // сеанс переходит в н, а из н - в проход без копирования кэша (с дальше не используется)
    перем н = с
    пусть почему = сам.нельзя_подать(ид, н.токены.длина)
    если почему != "" {
        н.ошибка = почему
        вернуть н
    }
    н = сам.проход(н, [ид])
    вернуть н
}

/// Строки тензора с первой по первая + строк - 1 числами дроб32 (веса разворачиваются как в llama.cpp)
общий функ Файл.числа(имя: стр, первая: цел, строк: цел) -> массив<дроб32>! {
    пусть т = сам.тензор(имя) иначе Тензор("", [], -1, 0, 0, 0)
    если т.вид < 0 { вернуть ошибка("в файле нет тензора «" + имя + "»") }
    если не вид_поддерживается(т.вид) { вернуть ошибка("тип " + имя_вида(т.вид) + " тензора «" + имя + "» не поддерживается") }
    пусть всего = частное(т.элементов, т.размеры[0])
    если первая < 0 или строк <= 0 или первая > всего - строк {
        вернуть ошибка("у тензора «" + имя + "» " + стр(всего) + " строк, а нужны строки с " + стр(первая) + " по " + стр(первая + строк - 1))
    }
    вернуть строки_тензора(сам.путь, т, первая, строк)
}

// ======================================================================
// Выборка и ответ
// ======================================================================

/// Как выбирать следующий токен (те же поля, что у модели.Выборка)
общий тип Выборка {
    /// 0 - всегда самый вероятный токен (жадная выборка)
    температура: дроб = 0.8
    /// выбирать из стольких самых вероятных токенов; 0 - из всех
    верх_к: цел = 40
    /// из самых вероятных токенов с суммой вероятностей не меньше этой; 1 - из всех
    верх_п: дроб = 0.95
    /// зерно случайной выборки: одно зерно - один ответ; -1 - каждый раз разное
    зерно: цел = -1
    /// наибольшее число токенов ответа; 0 - до конца контекста
    максимум_токенов: цел = 256
    /// ответ кончается перед первой из этих строк (сама строка в ответ не входит)
    стоп: [стр] = []
}

/// Выборка без случайности: всегда самый вероятный токен
общий функ жадная() -> Выборка {
    вернуть Выборка(температура = 0.0)
}

/// Номер наибольшего логита (при равенстве - меньший номер)
общий функ наибольший(логиты: массив<дроб32>) -> цел {
    перем лучший = 0
    перем значение = логиты[0]
    для к в 1..логиты.длина - 1 {
        если логиты[к] > значение {
            значение = логиты[к]
            лучший = к
        }
    }
    вернуть лучший
}

/// следующее состояние генератора (Парк - Миллер, MINSTD)
функ случайное_следующее(с: цел) -> цел {
    вернуть с * 48271 % 2147483647
}

/// Начальное состояние генератора по зерну (-1 - по часам)
общий функ начальное_состояние(зерно: цел) -> цел {
    перем з = зерно
    если з < 0 { з = цел(метка_времени() * 1000.0) }
    вернуть з % 2147483646 + 1
}

тип Выбор {
    токен: цел
    состояние: цел
}

/// Выбрать токен по логитам: верх_к, затем верх_п (по вероятностям без температуры), затем
/// температура и случайный выбор (как цепочка выборки в модуле «модели»)
функ выбрать_токен(логиты: массив<дроб32>, выб: Выборка, состояние: цел) -> Выбор {
    если выб.температура <= 0.0 { вернуть Выбор(наибольший(логиты), состояние) }
    пусть н = логиты.длина
    // кандидаты по убыванию логита
    перем кандидаты: [цел] = []
    если выб.верх_к > 0 и выб.верх_к < н {
        пусть к = выб.верх_к
        для ид в 0..н - 1 {
            пусть л = логиты[ид]
            если кандидаты.длина == к и л <= логиты[кандидаты[к - 1]] { продолжить }
            перем место = кандидаты.длина
            пока место > 0 и логиты[кандидаты[место - 1]] < л { место -= 1 }
            кандидаты.вставить(место, ид)
            если кандидаты.длина > к { кандидаты.удалить(к) }
        }
    } иначе {
        перем все: [цел] = []
        для ид в 0..н - 1 { все.добавить(ид) }
        кандидаты = все.упорядочить_по(функ(ид: цел) = -логиты[ид])
    }
    пусть наиб = логиты[кандидаты[0]]
    // верх_п по вероятностям без температуры
    если выб.верх_п < 1.0 {
        перем сумма_ = 0.0
        перем веса: [дроб] = []
        для ид в кандидаты {
            пусть в_ = экспонента(логиты[ид] - наиб)
            веса.добавить(в_)
            сумма_ += в_
        }
        перем накоплено = 0.0
        перем оставить = кандидаты.длина
        для к в 0..веса.длина - 1 {
            накоплено += веса[к] / сумма_
            если накоплено >= выб.верх_п {
                оставить = к + 1
                прервать
            }
        }
        кандидаты = кандидаты[0..оставить - 1]
    }
    перем веса: [дроб] = []
    перем сумма_ = 0.0
    для ид в кандидаты {
        пусть в_ = экспонента((логиты[ид] - наиб) / выб.температура)
        веса.добавить(в_)
        сумма_ += в_
    }
    пусть новое = случайное_следующее(состояние)
    пусть порог = дроб(новое - 1) / 2147483646.0 * сумма_
    перем накоплено = 0.0
    для к в 0..веса.длина - 1 {
        накоплено += веса[к]
        если накоплено > порог { вернуть Выбор(кандидаты[к], новое) }
    }
    вернуть Выбор(кандидаты[кандидаты.длина - 1], новое)
}

/// Выбрать следующий токен по логитам сеанса; результат - [токен, новое состояние генератора]
общий функ выбрать(логиты: массив<дроб32>, выб: Выборка, состояние: цел) -> [цел] {
    пусть в_ = выбрать_токен(логиты, выб, состояние)
    вернуть [в_.токен, в_.состояние]
}

/// Разбить текст на токены как llama.cpp (llama_tokenize с add_special и parse_special)
общий функ Модель.разбить(текст_: стр) -> [цел] {
    вернуть сам.словарь.разбить_текст(текст_, истина, истина)
}

/// Текст токенов (служебные пропускаются)
общий функ Модель.текст(токены: [цел]) -> стр {
    вернуть сам.словарь.текст_токенов(токены)
}

/// Сколько токенов модели в тексте (без токена начала, как в модуле «модели»)
общий функ Модель.число_токенов(текст_: стр) -> цел {
    вернуть сам.словарь.разбить_текст(текст_, ложь, истина).длина
}

/// Сколько токенов запроса подаётся одним пакетом
функ токенов_в_пакете() -> цел {
    вернуть 256
}

/// Подать модели несколько токенов подряд. Токены идут пакетами (матрицы весов читаются из памяти
/// один раз на пакет), результат тот же, что у подачи по одному. Если очередной токен подать нельзя,
/// поданы токены до него, а в поле «ошибка» - причина.
общий функ Модель.подать_все(с: Сеанс, токены: [цел]) -> Сеанс {
    перем н = с
    перем пакет: [цел] = []
    перем почему = ""
    для ид в токены {
        почему = сам.нельзя_подать(ид, н.токены.длина + пакет.длина)
        если почему != "" { прервать }
        пакет.добавить(ид)
        если пакет.длина == токенов_в_пакете() {
            н = сам.проход(н, пакет)
            если н.ошибка != "" { вернуть н }
            пакет = []
        }
    }
    если пакет.длина > 0 {
        н = сам.проход(н, пакет)
        если н.ошибка != "" { вернуть н }
    }
    н.ошибка = почему
    вернуть н
}

/// сколько байтов в конце не составляют целого знака UTF-8
функ незаконченных_байт(б: [цел]) -> цел {
    перем к = б.длина - 1
    перем назад = 0
    пока к >= 0 и назад < 4 {
        пусть х = б[к]
        если х < 128 { вернуть 0 }
        если х >= 192 {
            перем нужно = 2
            если х >= 224 { нужно = 3 }
            если х >= 240 { нужно = 4 }
            если б.длина - к < нужно { вернуть б.длина - к }
            вернуть 0
        }
        к -= 1
        назад += 1
    }
    вернуть 0
}

/// Ответ по частям: каждая часть (целые знаки) передаётся функции, как только появится; функция
/// возвращает ложь, чтобы остановить ответ. Результат - весь ответ.
общий функ Модель.ответ_по_частям(запрос: стр, выб: Выборка, получатель: функ(стр) -> лог) -> стр! {
    если не (выб.температура >= 0.0 и выб.температура <= 100.0) или не (выб.верх_п > 0.0 и выб.верх_п <= 1.0) или выб.верх_к < 0 {
        вернуть ошибка("неверные параметры выборки: температура от 0 до 100, верх_п больше 0 и не больше 1, верх_к не меньше 0")
    }
    пусть токены = сам.разбить(запрос)
    если токены.длина == 0 { вернуть ошибка("пустой запрос к модели") }
    если токены.длина >= сам.контекст {
        вернуть ошибка("запрос длиннее контекста модели: " + стр(токены.длина) + " токенов при контексте " + стр(сам.контекст) +
            "; увеличьте размер контекста (Настройки.контекст)")
    }
    // сеанс - в своей переменной, а не в поле записи: так «с = сам.подать(с, ...)» не копирует кэш
    перем с = сам.сеанс()
    с = сам.подать_все(с, токены)
    с.проверить()!
    перем ответ = ""
    перем отдано = 0
    перем байты_: [цел] = []
    перем состояние = начальное_состояние(выб.зерно)
    перем конец = ложь
    перем порождено = 0
    перем наибольшая_стоп = 0
    для ст в выб.стоп { наибольшая_стоп = макс(наибольшая_стоп, ст.длина) }
    пока не конец {
        если выб.максимум_токенов > 0 и порождено >= выб.максимум_токенов { прервать }
        пусть в_ = выбрать_токен(с.логиты, выб, состояние)
        состояние = в_.состояние
        порождено += 1
        если сам.словарь.конечные.содержит(в_.токен) { прервать }
        для б в числа_байтов(сам.словарь.байты_токена(в_.токен, ложь)) { байты_.добавить(б) }
        пусть хвост = незаконченных_байт(байты_)
        если байты_.длина > хвост {
            ответ += стр(байты(байты_[0..байты_.длина - хвост - 1]))
            байты_ = байты_[байты_.длина - хвост..байты_.длина - 1]
            если хвост == 0 { байты_ = [] }
        }
        // стоп-строки: ответ кончается перед первой найденной
        перем стоп_место = -1
        для ст в выб.стоп {
            если ст != "" {
                пусть м_ = ответ.найти(ст)
                если м_ >= 0 и (стоп_место < 0 или м_ < стоп_место) { стоп_место = м_ }
            }
        }
        если стоп_место >= 0 {
            перем обрезанный = ""
            если стоп_место > 0 { обрезанный = ответ[0..стоп_место - 1] }
            ответ = обрезанный
            конец = истина
        }
        // отдать готовую часть (без хвоста, который может оказаться началом стоп-строки)
        перем готово = ответ.длина
        если не конец и наибольшая_стоп > 1 { готово = макс(отдано, ответ.длина - наибольшая_стоп + 1) }
        если готово > отдано {
            пусть часть = ответ[отдано..готово - 1]
            отдано = готово
            если не получатель(часть) { вернуть ответ[0..отдано - 1] }
        }
        если конец { прервать }
        если с.токены.длина >= сам.контекст {
            вернуть ошибка("контекст модели заполнен во время ответа: " + стр(сам.контекст) + " токенов")
        }
        с = сам.подать(с, в_.токен)
        с.проверить()!
    }
    если ответ.длина > отдано {
        пусть часть = ответ[отдано..ответ.длина - 1]
        отдано = ответ.длина
        получатель(часть)
    }
    вернуть ответ
}

/// Ответ на запрос целиком (запрос подаётся модели как есть)
общий функ Модель.ответ(запрос: стр, выб: Выборка) -> стр! {
    вернуть сам.ответ_по_частям(запрос, выб, функ(ч: стр) = истина)
}

// ---------- шаблоны чата ----------

/// Сообщение чата: роль («system», «user», «assistant») и текст
общий тип Сообщение {
    роль: стр
    текст: стр
}

/// вид шаблона чата по тексту шаблона из файла (как llm_chat_detect_template в llama.cpp)
функ вид_шаблона(ш: стр) -> стр {
    пусть имена = ["chatml", "llama2", "llama2-sys", "llama2-sys-bos", "llama2-sys-strip", "mistral-v1", "mistral-v3",
        "mistral-v3-tekken", "mistral-v7", "phi3", "falcon3", "zephyr", "gemma", "llama3", "glmedge"]
    если имена.содержит(ш) { вернуть ш }
    если ш.содержит("<|im_start|>") {
        если ш.содержит("<|im_sep|>") или ш.содержит("<end_of_utterance>") { вернуть "" }
        вернуть "chatml"
    }
    если ш.начинается("mistral") или ш.содержит("[INST]") {
        если ш.содержит("[SYSTEM_PROMPT]") { вернуть "mistral-v7" }
        если ш.содержит("' [INST] ' + system_message") или ш.содержит("[AVAILABLE_TOOLS]") {
            если ш.содержит(" [INST]") { вернуть "mistral-v1" }
            если ш.содержит("\"[INST]\"") { вернуть "mistral-v3-tekken" }
            вернуть "mistral-v3"
        }
        если ш.содержит("content.strip()") { вернуть "llama2-sys-strip" }
        если ш.содержит("bos_token + '[INST]") { вернуть "llama2-sys-bos" }
        если ш.содержит("<<SYS>>") { вернуть "llama2-sys" }
        вернуть "llama2"
    }
    если ш.содержит("<|assistant|>") и ш.содержит("<|end|>") { вернуть "phi3" }
    если ш.содержит("[gMASK]<sop>") { вернуть "" }
    если ш.содержит("<|assistant|>") и ш.содержит("<|user|>") {
        если ш.содержит("<|tool_declare|>") { вернуть "" }
        если ш.содержит("</s>") { вернуть "falcon3" }
        вернуть "glmedge"
    }
    если ш.содержит("<|{{ item['role'] }}|>") { вернуть "" }
    если ш.содержит("<|user|>") и ш.содержит("<|endoftext|>") { вернуть "zephyr" }
    если ш.содержит("bos_token + message['role']") { вернуть "" }
    если ш.содержит("<start_of_turn>") { вернуть "gemma" }
    если ш.содержит("<|start_header_id|>") и ш.содержит("<|end_header_id|>") { вернуть "llama3" }
    вернуть ""
}

/// Запрос по шаблону чата самой модели (tokenizer.chat_template) с началом ответа помощника
общий функ Модель.запрос_чата(сообщения: [Сообщение]) -> стр! {
    пусть ш = сам.файл.текст("tokenizer.chat_template") иначе "chatml"
    пусть вид = вид_шаблона(ш)
    если вид == "" {
        вернуть ошибка("шаблон чата модели не знаком движку; соберите запрос сами и передайте его в м.ответ")
    }
    перем т = ""
    если вид == "chatml" {
        для с в сообщения { т += "<|im_start|>" + с.роль + "\n" + с.текст + "<|im_end|>\n" }
        вернуть т + "<|im_start|>assistant\n"
    }
    если вид == "mistral-v7" {
        для с в сообщения {
            если с.роль == "system" {
                т += "[SYSTEM_PROMPT] " + с.текст + "[/SYSTEM_PROMPT]"
            } иначе если с.роль == "user" {
                т += "[INST] " + с.текст + "[/INST]"
            } иначе {
                т += " " + с.текст + "</s>"
            }
        }
        вернуть т
    }
    если вид.начинается("mistral") {
        перем ведущий = ""
        если вид == "mistral-v1" { ведущий = " " }
        перем замыкающий = " "
        если вид == "mistral-v3-tekken" { замыкающий = "" }
        перем внутри = ложь
        для с в сообщения {
            если не внутри {
                т += ведущий + "[INST]" + замыкающий
                внутри = истина
            }
            если с.роль == "system" {
                т += с.текст + "\n\n"
            } иначе если с.роль == "user" {
                т += с.текст + ведущий + "[/INST]"
            } иначе {
                перем текст_ = с.текст
                если вид == "mistral-v3" { текст_ = текст_.обрезать() }
                т += замыкающий + текст_ + "</s>"
                внутри = ложь
            }
        }
        вернуть т
    }
    если вид.начинается("llama2") {
        т = "[INST] "
        перем внутри = истина
        для с в сообщения {
            перем текст_ = с.текст
            если вид == "llama2-sys-strip" { текст_ = текст_.обрезать() }
            если не внутри {
                внутри = истина
                если вид == "llama2-sys-bos" { т += "<s>[INST] " } иначе { т += "[INST] " }
            }
            если с.роль == "system" {
                если вид == "llama2" { т += текст_ + "\n" } иначе { т += "<<SYS>>\n" + текст_ + "\n<</SYS>>\n\n" }
            } иначе если с.роль == "user" {
                т += текст_ + " [/INST]"
            } иначе {
                т += текст_ + "</s>"
                внутри = ложь
            }
        }
        вернуть т
    }
    если вид == "phi3" {
        для с в сообщения { т += "<|" + с.роль + "|>\n" + с.текст + "<|end|>\n" }
        вернуть т + "<|assistant|>\n"
    }
    если вид == "falcon3" {
        для с в сообщения { т += "<|" + с.роль + "|>\n" + с.текст + "\n" }
        вернуть т + "<|assistant|>\n"
    }
    если вид == "glmedge" {
        для с в сообщения { т += "<|" + с.роль + "|>\n" + с.текст }
        вернуть т + "<|assistant|>"
    }
    если вид == "zephyr" {
        для с в сообщения { т += "<|" + с.роль + "|>\n" + с.текст + "<|endoftext|>\n" }
        вернуть т + "<|assistant|>\n"
    }
    если вид == "gemma" {
        перем система = ""
        для с в сообщения {
            если с.роль == "system" {
                система += с.текст.обрезать()
                продолжить
            }
            перем роль = с.роль
            если роль == "assistant" { роль = "model" }
            т += "<start_of_turn>" + роль + "\n"
            если система != "" и роль != "model" {
                т += система + "\n\n"
                система = ""
            }
            т += с.текст.обрезать() + "<end_of_turn>\n"
        }
        вернуть т + "<start_of_turn>model\n"
    }
    для с в сообщения {
        т += "<|start_header_id|>" + с.роль + "<|end_header_id|>\n\n" + с.текст.обрезать() + "<|eot_id|>"
    }
    вернуть т + "<|start_header_id|>assistant<|end_header_id|>\n\n"
}

/// Ответ в чате целиком
общий функ Модель.чат(сообщения: [Сообщение], выб: Выборка) -> стр! {
    пусть запрос = сам.запрос_чата(сообщения)!
    вернуть сам.ответ(запрос, выб)
}

/// Ответ в чате по частям (каждая часть - получателю)
общий функ Модель.чат_по_частям(сообщения: [Сообщение], выб: Выборка, получатель: функ(стр) -> лог) -> стр! {
    пусть запрос = сам.запрос_чата(сообщения)!
    вернуть сам.ответ_по_частям(запрос, выб, получатель)
}
