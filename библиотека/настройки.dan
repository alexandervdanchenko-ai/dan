/// Стандартная библиотека Дана: файлы настроек TOML, YAML и JSON.
///
///     подключить "настройки"
///     подключить "json"
///
///     пусть н = настройки.загрузить("сервер.toml")!      // по расширению: .toml, .yaml, .yml, .json
///     пусть порт = настройки.найти(н, "сервер.порт").как_цел() иначе 8080
///     для имя в настройки.найти(н, "пользователи").элементы() { ... }
///
/// Итог разбора - json.Значение (раздел 11.20 spec.md): таблицы и словари -
/// объекты, массивы и списки - массивы; даты и время TOML - строки как записаны.
/// Ошибка в файле - ошибка-значение с номером строки: «строка 3: ключ «порт» уже задан».
///
/// TOML - версии 1.0 целиком. YAML - то, что пишут в файлах настроек: словари и
/// списки отступами, `ключ: значение`, `- элемент`, строки в кавычках и без,
/// блоки `|` и `>`, записи `[а, б]` и `{а: 1}` в одну строку, комментарии `#`;
/// числа, логические значения и null - по схеме YAML 1.2 (поэтому `no` и `yes` -
/// строки). Ссылки `&` и `*`, теги `!` и несколько документов в файле - ошибка.

подключить "json"

/// Итог разбора части текста: значение и место, где разбор остановился
тип Итог {
    з: json.Значение
    н: цел
}

/// Разобрать файл по расширению имени
общий функ загрузить(путь: стр) -> json.Значение! {
    если не существует(путь) { вернуть ошибка("файл \"" + путь + "\": файла нет") }
    пусть т = прочитать(путь)
    пусть рз = путь.строчные()
    перем итог = json.Пусто
    если рз.оканчивается(".toml") {
        если пусть з = toml(т) { итог = з } иначе ошибка о { вернуть ошибка("файл \"" + путь + "\": " + о) }
    } иначе если рз.оканчивается(".yaml") или рз.оканчивается(".yml") {
        если пусть з = yaml(т) { итог = з } иначе ошибка о { вернуть ошибка("файл \"" + путь + "\": " + о) }
    } иначе если рз.оканчивается(".json") {
        если пусть з = json.разобрать(т) { итог = з } иначе ошибка о { вернуть ошибка("файл \"" + путь + "\": " + о) }
    } иначе {
        вернуть ошибка("файл \"" + путь + "\": неизвестный вид настроек, нужно расширение .toml, .yaml, .yml или .json")
    }
    вернуть итог
}

/// Значение по пути через точку: найти(н, "сервер.порт"), найти(н, "пользователи.0.имя");
/// нет такого - json.Пусто
общий функ найти(з: json.Значение, путь: стр) -> json.Значение {
    если путь == "" { вернуть з }
    перем т = з
    для часть в путь.разбить(".") {
        выбор т {
            json.Объект(п) { т = п.получить(часть, json.Пусто) }
            json.Массив(э) {
                если пусть н = разобрать_цел(часть) {
                    если н >= 0 и н < э.длина { т = э[н] } иначе { вернуть json.Пусто }
                } иначе ошибка о {
                    вернуть json.Пусто
                }
            }
            иначе { вернуть json.Пусто }
        }
    }
    вернуть т
}

// ---------- общее ----------

функ номер_строки(с: [стр], н: цел) -> цел {
    перем строка = 1
    перем к = 0
    пока к < н и к < с.длина {
        если с[к] == "\n" { строка += 1 }
        к += 1
    }
    вернуть строка
}

функ ошибка_в(с: [стр], н: цел, т: стр) -> стр {
    вернуть "строка " + стр(номер_строки(с, н)) + ": " + т
}

функ цифра(з: стр) -> лог {
    вернуть з >= "0" и з <= "9"
}

функ цифра16(з: стр) -> цел {
    пусть к = код_символа(з)
    если к >= 48 и к <= 57 { вернуть к - 48 }
    если к >= 65 и к <= 70 { вернуть к - 55 }
    если к >= 97 и к <= 102 { вернуть к - 87 }
    вернуть -1
}

/// Целое из цифр по основанию 2, 8 или 16 (без знака и подчёркиваний)
функ целое_по_основанию(цифры: стр, основание: цел) -> цел! {
    если цифры == "" { вернуть ошибка("нет цифр") }
    перем итог = 0
    для з в цифры.символы() {
        пусть д = цифра16(з)
        если д < 0 или д >= основание { вернуть ошибка("неверная цифра «" + з + "»") }
        если итог > (9223372036854775807 - д) / основание { вернуть ошибка("число не помещается в цел") }
        итог = итог * основание + д
    }
    вернуть итог
}

/// Десятичное целое: необязательный знак и цифры
функ десятичное(т: стр) -> лог {
    перем с = т
    если с.начинается("+") или с.начинается("-") { если с.длина == 1 { вернуть ложь } иначе { с = с[1..с.длина - 1] } }
    если с == "" { вернуть ложь }
    для з в с.символы() { если не цифра(з) { вернуть ложь } }
    вернуть истина
}

/// Дробная запись: [+-] цифры [. цифры] [e [+-] цифры], хотя бы одна цифра до или после точки
функ дробная(т: стр, точка_без_цифр: лог) -> лог {
    перем с = т.символы()
    перем к = 0
    если к < с.длина и (с[к] == "+" или с[к] == "-") { к += 1 }
    перем до = 0
    пока к < с.длина и цифра(с[к]) {
        к += 1
        до += 1
    }
    перем после = 0
    перем есть_точка = ложь
    если к < с.длина и с[к] == "." {
        есть_точка = истина
        к += 1
        пока к < с.длина и цифра(с[к]) {
            к += 1
            после += 1
        }
    }
    если до == 0 и после == 0 { вернуть ложь }
    если есть_точка и не точка_без_цифр и (до == 0 или после == 0) { вернуть ложь }
    перем есть_степень = ложь
    если к < с.длина и (с[к] == "e" или с[к] == "E") {
        есть_степень = истина
        к += 1
        если к < с.длина и (с[к] == "+" или с[к] == "-") { к += 1 }
        перем цифр = 0
        пока к < с.длина и цифра(с[к]) {
            к += 1
            цифр += 1
        }
        если цифр == 0 { вернуть ложь }
    }
    вернуть к == с.длина и (есть_точка или есть_степень)
}

/// Положить значение по пути в дерево объектов. Режим: 0 - значение (ключ не должен быть задан),
/// 1 - таблица (объект, создаётся, если нет), 2 - новый элемент массива таблиц.
/// Массив на пути (массив таблиц) - переход в его последний элемент.
функ положить(у: json.Значение, путь: [стр], к: цел, з: json.Значение, режим: цел) -> json.Значение! {
    перем поля: {стр: json.Значение} = {}
    выбор у {
        json.Объект(п) { поля = п }
        иначе { вернуть ошибка("«" + путь[0..к - 1].соединить(".") + "» - не таблица") }
    }
    пусть имя = путь[к]
    пусть было = поля.получить(имя, json.Пусто)
    пусть есть = поля.содержит(имя)
    если к == путь.длина - 1 {
        если режим == 0 {
            если есть { вернуть ошибка("ключ «" + путь.соединить(".") + "» уже задан") }
            поля[имя] = з
        } иначе если режим == 1 {
            если не есть {
                поля[имя] = json.Объект({})
            } иначе {
                выбор было {
                    json.Объект(_) { }
                    иначе { вернуть ошибка("«" + путь.соединить(".") + "» уже задан не таблицей") }
                }
            }
        } иначе {
            если не есть {
                поля[имя] = json.Массив([json.Объект({})])
            } иначе {
                выбор было {
                    json.Массив(э) {
                        перем элементы = э
                        элементы.добавить(json.Объект({}))
                        поля[имя] = json.Массив(элементы)
                    }
                    иначе { вернуть ошибка("«" + путь.соединить(".") + "» уже задан не массивом таблиц") }
                }
            }
        }
        вернуть json.Объект(поля)
    }
    если не есть {
        поля[имя] = положить(json.Объект({}), путь, к + 1, з, режим)!
    } иначе {
        выбор было {
            json.Объект(_) { поля[имя] = положить(было, путь, к + 1, з, режим)! }
            json.Массив(э) {
                если э.длина == 0 { вернуть ошибка("«" + путь[0..к].соединить(".") + "» - пустой массив, а не таблица") }
                перем элементы = э
                элементы[элементы.длина - 1] = положить(элементы[элементы.длина - 1], путь, к + 1, з, режим)!
                поля[имя] = json.Массив(элементы)
            }
            иначе { вернуть ошибка("«" + путь[0..к].соединить(".") + "» уже задан не таблицей") }
        }
    }
    вернуть json.Объект(поля)
}

// ---------- TOML ----------

функ пробелы(с: [стр], н: цел) -> цел {
    перем к = н
    пока к < с.длина и (с[к] == " " или с[к] == "\t") { к += 1 }
    вернуть к
}

/// Пропустить пробелы, комментарии и переводы строк (внутри массива и между записями)
функ пустое(с: [стр], н: цел) -> цел {
    перем к = н
    пока к < с.длина {
        пусть з = с[к]
        если з == " " или з == "\t" или з == "\n" или з == "\r" {
            к += 1
        } иначе если з == "#" {
            пока к < с.длина и с[к] != "\n" { к += 1 }
        } иначе {
            прервать
        }
    }
    вернуть к
}

/// После записи - только пробелы и комментарий до конца строки
функ конец_строки(с: [стр], н: цел) -> цел! {
    перем к = пробелы(с, н)
    если к < с.длина и с[к] == "#" {
        пока к < с.длина и с[к] != "\n" {
            пусть код = код_символа(с[к])
            если код < 32 и код != 9 и не (с[к] == "\r" и к + 1 < с.длина и с[к + 1] == "\n") {
                вернуть ошибка(ошибка_в(с, к, "управляющий знак в комментарии"))
            }
            к += 1
        }
    }
    если к < с.длина и с[к] == "\r" и к + 1 < с.длина и с[к + 1] == "\n" { к += 1 }
    если к < с.длина и с[к] != "\n" {
        вернуть ошибка(ошибка_в(с, к, "после значения ожидался конец строки, а не «" + с[к] + "»"))
    }
    вернуть к
}

функ простой_ключ(з: стр) -> лог {
    если цифра(з) или з == "_" или з == "-" { вернуть истина }
    если (з >= "a" и з <= "z") или (з >= "A" и з <= "Z") { вернуть истина }
    пусть к = код_символа(з)
    вернуть к >= 192 и к != 215 и к != 247 и не (к >= 8192 и к <= 8303)    // буквы, кроме ×, ÷ и знаков препинания
}

/// Ключ: части через точку, каждая - простая или в кавычках
функ ключ(с: [стр], н: цел) -> [стр]! {
    перем части: [стр] = []
    перем к = пробелы(с, н)
    пока истина {
        если к >= с.длина { вернуть ошибка(ошибка_в(с, к, "ожидался ключ")) }
        если с[к] == "\"" или с[к] == "'" {
            если к + 2 < с.длина и с[к + 1] == с[к] и с[к + 2] == с[к] {
                вернуть ошибка(ошибка_в(с, к, "ключ не может быть многострочной строкой"))
            }
            пусть рз = строка_toml(с, к)!
            выбор рз.з {
                json.Строка(т) { части.добавить(т) }
                иначе { }
            }
            к = рз.н
        } иначе {
            перем ч: [стр] = []
            пока к < с.длина и простой_ключ(с[к]) {
                ч.добавить(с[к])
                к += 1
            }
            если ч.длина == 0 { вернуть ошибка(ошибка_в(с, к, "ожидался ключ, а найдено «" + с[к] + "»")) }
            части.добавить(ч.соединить(""))
        }
        к = пробелы(с, к)
        если к < с.длина и с[к] == "." {
            к = пробелы(с, к + 1)
        } иначе {
            прервать
        }
    }
    // место конца ключа - последний элемент, номером
    части.добавить(стр(к))
    вернуть части
}

функ отделить_место(части: [стр]) -> Итог {
    вернуть Итог(json.Массив(части[0..части.длина - 2].преобразовать(функ(ч) = json.Строка(ч))),
        разобрать_цел(части[части.длина - 1]) иначе 0)
}

функ как_путь(з: json.Значение) -> [стр] {
    перем итог: [стр] = []
    для э в з.элементы() { итог.добавить(э.как_стр() иначе "") }
    вернуть итог
}

/// Знак по записи \uXXXX или \UXXXXXXXX
функ знак_по_коду(с: [стр], н: цел, цифр: цел) -> стр! {
    если н + цифр > с.длина { вернуть ошибка(ошибка_в(с, н, "неполная запись \\u")) }
    перем код = 0
    для к в 0..цифр - 1 {
        пусть д = цифра16(с[н + к])
        если д < 0 { вернуть ошибка(ошибка_в(с, н, "в записи \\u нужны шестнадцатеричные цифры")) }
        код = код * 16 + д
    }
    если код == 0 или код > 1114111 или (код >= 55296 и код <= 57343) {
        вернуть ошибка(ошибка_в(с, н, "недопустимый код знака " + стр(код)))
    }
    вернуть символ_по_коду(код)
}

/// Строка TOML: "...", '...', """...""" или '''...'''
функ строка_toml(с: [стр], н: цел) -> Итог! {
    пусть кавычка = с[н]
    пусть буквальная = кавычка == "'"
    перем к = н + 1
    перем многострочная = ложь
    если к + 1 < с.длина и с[к] == кавычка и с[к + 1] == кавычка {
        многострочная = истина
        к += 2
        // перевод строки сразу после открывающих кавычек не входит в строку
        если к < с.длина и с[к] == "\n" {
            к += 1
        } иначе если к + 1 < с.длина и с[к] == "\r" и с[к + 1] == "\n" {
            к += 2
        }
    }
    перем ч: [стр] = []
    пока истина {
        если к >= с.длина { вернуть ошибка(ошибка_в(с, н, "строка не закрыта")) }
        пусть з = с[к]
        если з == кавычка {
            если не многострочная { вернуть Итог(json.Строка(ч.соединить("")), к + 1) }
            если к + 2 < с.длина и с[к + 1] == кавычка и с[к + 2] == кавычка {
                // до двух кавычек перед закрывающими входят в строку
                перем лишних = 0
                пока лишних < 2 и к + 3 + лишних < с.длина и с[к + 3 + лишних] == кавычка { лишних += 1 }
                для _ в 1..лишних { ч.добавить(кавычка) }
                вернуть Итог(json.Строка(ч.соединить("")), к + 3 + лишних)
            }
            ч.добавить(з)
            к += 1
            продолжить
        }
        если з == "\n" и не многострочная { вернуть ошибка(ошибка_в(с, к, "строка не закрыта до конца строки")) }
        пусть код = код_символа(з)
        если (код < 32 и з != "\t" и з != "\n" и з != "\r") или код == 127 {
            вернуть ошибка(ошибка_в(с, к, "управляющий знак в строке: запишите его через \\u"))
        }
        если з == "\r" и не (к + 1 < с.длина и с[к + 1] == "\n") {
            вернуть ошибка(ошибка_в(с, к, "одиночный знак \\r в строке"))
        }
        если з == "\\" и не буквальная {
            если к + 1 >= с.длина { вернуть ошибка(ошибка_в(с, к, "строка не закрыта")) }
            пусть д = с[к + 1]
            если д == "n" { ч.добавить("\n") } иначе если д == "t" { ч.добавить("\t") }
            иначе если д == "r" { ч.добавить("\r") } иначе если д == "\"" { ч.добавить("\"") }
            иначе если д == "\\" { ч.добавить("\\") } иначе если д == "b" { ч.добавить(символ_по_коду(8)) }
            иначе если д == "f" { ч.добавить(символ_по_коду(12)) }
            иначе если д == "e" { ч.добавить(символ_по_коду(27)) }
            иначе если д == "u" {
                ч.добавить(знак_по_коду(с, к + 2, 4)!)
                к += 6
                продолжить
            } иначе если д == "U" {
                ч.добавить(знак_по_коду(с, к + 2, 8)!)
                к += 10
                продолжить
            } иначе если многострочная и (д == " " или д == "\t" или д == "\n" или д == "\r") {
                // «\» в конце строки: пропустить пробелы и переводы строк до следующего знака
                перем м = к + 1
                пока м < с.длина и (с[м] == " " или с[м] == "\t") { м += 1 }
                если м < с.длина и с[м] != "\n" и с[м] != "\r" {
                    вернуть ошибка(ошибка_в(с, к, "после \\ в конце строки не может быть текста"))
                }
                пока м < с.длина и (с[м] == " " или с[м] == "\t" или с[м] == "\n" или с[м] == "\r") { м += 1 }
                к = м
                продолжить
            } иначе {
                вернуть ошибка(ошибка_в(с, к, "неизвестная запись \\" + д))
            }
            к += 2
            продолжить
        }
        ч.добавить(з)
        к += 1
    }
    вернуть Итог(json.Пусто, к)
}

/// Убрать подчёркивания между цифрами: 1_000 -> 1000
функ без_подчёркиваний(с: [стр], н: цел, т: стр) -> стр! {
    если не т.содержит("_") { вернуть т }
    пусть з = т.символы()
    для к в 0..з.длина - 1 {
        если з[к] == "_" {
            если к == 0 или к == з.длина - 1 или цифра16(з[к - 1]) < 0 или цифра16(з[к + 1]) < 0 {
                вернуть ошибка(ошибка_в(с, н, "«_» в числе - только между цифрами: " + т))
            }
        }
    }
    вернуть т.заменить("_", "")
}

функ похоже_на_дату(т: стр) -> лог {
    пусть з = т.символы()
    если з.длина >= 10 и цифра(з[0]) и цифра(з[3]) и з[4] == "-" и з[7] == "-" { вернуть истина }
    вернуть з.длина >= 5 и цифра(з[0]) и цифра(з[1]) и з[2] == ":"
}

функ число_toml(с: [стр], н: цел, слово: стр) -> json.Значение! {
    если слово == "inf" или слово == "+inf" { вернуть json.Число(1.0 / 0.0) }
    если слово == "-inf" { вернуть json.Число(-1.0 / 0.0) }
    если слово == "nan" или слово == "+nan" или слово == "-nan" { вернуть json.Число(0.0 / 0.0) }
    если слово.начинается("0x") или слово.начинается("0o") или слово.начинается("0b") {
        перем основание = 16
        если слово.начинается("0o") { основание = 8 }
        если слово.начинается("0b") { основание = 2 }
        пусть цифры = без_подчёркиваний(с, н, слово[2..слово.длина - 1])!
        если пусть ч = целое_по_основанию(цифры, основание) { вернуть json.Целое(ч) } иначе ошибка о {
            вернуть ошибка(ошибка_в(с, н, слово + ": " + о))
        }
    }
    пусть т = без_подчёркиваний(с, н, слово)!
    перем без_знака = т
    если т.начинается("+") или т.начинается("-") { без_знака = т[1..т.длина - 1] }
    если без_знака.длина > 1 и без_знака.начинается("0") и цифра(без_знака[1]) {
        вернуть ошибка(ошибка_в(с, н, "число с нулём впереди: " + слово))
    }
    если десятичное(т) {
        если пусть ч = разобрать_цел(т.заменить("+", "")) { вернуть json.Целое(ч) } иначе ошибка о {
            вернуть ошибка(ошибка_в(с, н, "число не помещается в цел: " + слово))
        }
    }
    если дробная(т, ложь) {
        если пусть д = разобрать_дроб(т.заменить("+", "")) { вернуть json.Число(д) } иначе ошибка о {
            // не число: ниже - ошибка или строка
        }
    }
    вернуть ошибка(ошибка_в(с, н, "неизвестное значение «" + слово + "»"))
}

функ значение_toml(с: [стр], н: цел) -> Итог! {
    если н >= с.длина { вернуть ошибка(ошибка_в(с, н, "ожидалось значение")) }
    пусть з = с[н]
    если з == "\"" или з == "'" { вернуть строка_toml(с, н) }
    если з == "[" {
        перем элементы: [json.Значение] = []
        перем к = пустое(с, н + 1)
        пока истина {
            если к >= с.длина { вернуть ошибка(ошибка_в(с, н, "массив не закрыт")) }
            если с[к] == "]" { вернуть Итог(json.Массив(элементы), к + 1) }
            пусть рз = значение_toml(с, к)!
            элементы.добавить(рз.з)
            к = пустое(с, рз.н)
            если к < с.длина и с[к] == "," {
                к = пустое(с, к + 1)
            } иначе если к < с.длина и с[к] != "]" {
                вернуть ошибка(ошибка_в(с, к, "в массиве ожидалась «,» или «]»"))
            }
        }
    }
    если з == "{" {
        перем таблица = json.Объект({})
        перем закрытые: {стр: лог} = {}
        перем к = пробелы(с, н + 1)
        если к < с.длина и с[к] == "}" { вернуть Итог(таблица, к + 1) }
        пока истина {
            пусть рз = отделить_место(ключ(с, к)!)
            пусть путь = как_путь(рз.з)
            к = пробелы(с, рз.н)
            если к >= с.длина или с[к] != "=" { вернуть ошибка(ошибка_в(с, к, "после ключа ожидался знак «=»")) }
            пусть зн = значение_toml(с, пробелы(с, к + 1))!
            для д в 1..путь.длина - 1 {
                если закрытые.содержит(путь[0..д - 1].соединить(символ_по_коду(1))) {
                    вернуть ошибка(ошибка_в(с, к, "ключ «" + путь[0..д - 1].соединить(".") + "» уже задан значением"))
                }
            }
            закрытые[путь.соединить(символ_по_коду(1))] = истина
            если пусть т = положить(таблица, путь, 0, зн.з, 0) { таблица = т } иначе ошибка о {
                вернуть ошибка(ошибка_в(с, к, о))
            }
            к = пробелы(с, зн.н)
            если к < с.длина и с[к] == "," {
                к = пробелы(с, к + 1)
            } иначе если к < с.длина и с[к] == "}" {
                вернуть Итог(таблица, к + 1)
            } иначе {
                вернуть ошибка(ошибка_в(с, к, "во встроенной таблице ожидалась «,» или «}» (перевод строки внутри «{ }» не допускается)"))
            }
        }
    }
    // слово до пробела, запятой, скобки, комментария или конца строки
    перем ч: [стр] = []
    перем к = н
    пока к < с.длина и с[к] != " " и с[к] != "\t" и с[к] != "," и с[к] != "]" и с[к] != "}" и с[к] != "#" и с[к] != "\n" и с[к] != "\r" {
        ч.добавить(с[к])
        к += 1
    }
    перем слово = ч.соединить("")
    если слово == "true" { вернуть Итог(json.Логическое(истина), к) }
    если слово == "false" { вернуть Итог(json.Логическое(ложь), к) }
    если слово == "" { вернуть ошибка(ошибка_в(с, н, "ожидалось значение")) }
    если похоже_на_дату(слово) {
        // дата и время через пробел: 1979-05-27 07:32:00
        если слово.длина == 10 и к + 3 < с.длина и с[к] == " " и цифра(с[к + 1]) и цифра(с[к + 2]) и с[к + 3] == ":" {
            ч.добавить("T")
            к += 1
            пока к < с.длина и с[к] != " " и с[к] != "\t" и с[к] != "," и с[к] != "]" и с[к] != "}" и с[к] != "#" и с[к] != "\n" и с[к] != "\r" {
                ч.добавить(с[к])
                к += 1
            }
            слово = ч.соединить("")
        }
        для зн в слово.символы() {
            если не (цифра(зн) или зн == "-" или зн == ":" или зн == "." или зн == "T" или зн == "t" или зн == "Z" или зн == "z" или зн == "+") {
                вернуть ошибка(ошибка_в(с, н, "неверная запись даты или времени «" + слово + "»"))
            }
        }
        вернуть Итог(json.Строка(слово), к)
    }
    вернуть Итог(число_toml(с, н, слово)!, к)
}

функ строка_пути(путь: [стр]) -> стр {
    вернуть путь.соединить(символ_по_коду(1))
}

/// Разобрать текст TOML
общий функ toml(текст: стр) -> json.Значение! {
    пусть с = текст.символы()
    перем корень = json.Объект({})
    перем текущая: [стр] = []
    перем явные: {стр: лог} = {}           // таблицы [а.б]
    перем закрытые: {стр: лог} = {}        // ключи со значениями (встроенные таблицы и массивы тоже)
    перем неявные: {стр: лог} = {}         // таблицы, созданные ключами через точку
    перем массивы: {стр: лог} = {}         // массивы таблиц [[а]]
    перем к = пустое(с, 0)
    пока к < с.длина {
        если с[к] == "[" {
            пусть массив_таблиц = к + 1 < с.длина и с[к + 1] == "["
            перем начало = к + 1
            если массив_таблиц { начало = к + 2 }
            пусть рз = отделить_место(ключ(с, начало)!)
            пусть путь = как_путь(рз.з)
            перем м = рз.н
            если массив_таблиц {
                если м + 1 >= с.длина или с[м] != "]" или с[м + 1] != "]" { вернуть ошибка(ошибка_в(с, м, "ожидалось «]]»")) }
                м += 2
            } иначе {
                если м >= с.длина или с[м] != "]" { вернуть ошибка(ошибка_в(с, м, "ожидалось «]»")) }
                м += 1
            }
            пусть имя = строка_пути(путь)
            для д в 1..путь.длина {
                если закрытые.содержит(строка_пути(путь[0..д - 1])) {
                    вернуть ошибка(ошибка_в(с, к, "«" + путь[0..д - 1].соединить(".") + "» уже задан значением"))
                }
            }
            если массив_таблиц {
                если явные.содержит(имя) или неявные.содержит(имя) {
                    вернуть ошибка(ошибка_в(с, к, "«" + путь.соединить(".") + "» уже задан таблицей, а не массивом таблиц"))
                }
                если пусть т = положить(корень, путь, 0, json.Пусто, 2) { корень = т } иначе ошибка о {
                    вернуть ошибка(ошибка_в(с, к, о))
                }
                массивы[имя] = истина
                // новый элемент: всё, что было задано внутри прежнего, к нему не относится
                пусть начало_имени = имя + символ_по_коду(1)
                для словарь_ в [0, 1, 2, 3] {
                    перем удалить: [стр] = []
                    если словарь_ == 0 { для п в явные { если п.начинается(начало_имени) { удалить.добавить(п) } } }
                    если словарь_ == 1 { для п в закрытые { если п.начинается(начало_имени) { удалить.добавить(п) } } }
                    если словарь_ == 2 { для п в неявные { если п.начинается(начало_имени) { удалить.добавить(п) } } }
                    если словарь_ == 3 { для п в массивы { если п.начинается(начало_имени) { удалить.добавить(п) } } }
                    для п в удалить {
                        если словарь_ == 0 { явные.удалить(п) }
                        если словарь_ == 1 { закрытые.удалить(п) }
                        если словарь_ == 2 { неявные.удалить(п) }
                        если словарь_ == 3 { массивы.удалить(п) }
                    }
                }
            } иначе {
                если явные.содержит(имя) { вернуть ошибка(ошибка_в(с, к, "таблица [" + путь.соединить(".") + "] объявлена дважды")) }
                если неявные.содержит(имя) {
                    вернуть ошибка(ошибка_в(с, к, "таблица [" + путь.соединить(".") + "] уже задана ключами через точку"))
                }
                если массивы.содержит(имя) {
                    вернуть ошибка(ошибка_в(с, к, "«" + путь.соединить(".") + "» - массив таблиц, нужно [[" + путь.соединить(".") + "]]"))
                }
                если пусть т = положить(корень, путь, 0, json.Пусто, 1) { корень = т } иначе ошибка о {
                    вернуть ошибка(ошибка_в(с, к, о))
                }
                явные[имя] = истина
            }
            текущая = путь
            к = конец_строки(с, м)!
        } иначе {
            пусть рз = отделить_место(ключ(с, к)!)
            пусть ключ_ = как_путь(рз.з)
            перем м = пробелы(с, рз.н)
            если м >= с.длина или с[м] != "=" { вернуть ошибка(ошибка_в(с, м, "после ключа ожидался знак «=»")) }
            пусть зн = значение_toml(с, пробелы(с, м + 1))!
            перем полный = текущая.копия()
            для ч в ключ_ { полный.добавить(ч) }
            для д в текущая.длина + 1..полный.длина - 1 {
                пусть п = строка_пути(полный[0..д - 1])
                если закрытые.содержит(п) {
                    вернуть ошибка(ошибка_в(с, к, "ключ «" + полный[0..д - 1].соединить(".") + "» уже задан значением"))
                }
                если явные.содержит(п) или массивы.содержит(п) {
                    вернуть ошибка(ошибка_в(с, к, "таблица «" + полный[0..д - 1].соединить(".") + "» уже объявлена в другом месте"))
                }
                неявные[п] = истина
            }
            если пусть т = положить(корень, полный, 0, зн.з, 0) { корень = т } иначе ошибка о {
                вернуть ошибка(ошибка_в(с, к, о))
            }
            закрытые[строка_пути(полный)] = истина
            к = конец_строки(с, зн.н)!
        }
        к = пустое(с, к)
    }
    вернуть корень
}

// ---------- YAML ----------

/// Строка YAML: отступ, содержимое без комментария и номер строки файла
тип Строка {
    отступ: цел
    текст: стр
    номер: цел
}

/// Место комментария « #» вне кавычек или -1
функ место_комментария(т: стр) -> цел {
    перем в_кавычке = ""
    перем к = 0
    пусть з = т.символы()
    пока к < з.длина {
        пусть с = з[к]
        если в_кавычке == "" {
            если с == "#" и (к == 0 или з[к - 1] == " " или з[к - 1] == "\t") { вернуть к }
            если (с == "\"" или с == "'") и (к == 0 или з[к - 1] == " " или з[к - 1] == "[" или з[к - 1] == "{" или з[к - 1] == "," или з[к - 1] == ":" или з[к - 1] == "-") {
                в_кавычке = с
            }
        } иначе если с == "\\" и в_кавычке == "\"" {
            к += 1
        } иначе если с == в_кавычке {
            если с == "'" и к + 1 < з.длина и з[к + 1] == "'" { к += 1 } иначе { в_кавычке = "" }
        }
        к += 1
    }
    вернуть -1
}

функ без_комментария(т: стр) -> стр {
    пусть м = место_комментария(т)
    если м < 0 { вернуть т.обрезать() }
    если м == 0 { вернуть "" }
    вернуть т[0..м - 1].обрезать()
}

функ ошибка_yaml(номер: цел, т: стр) -> стр {
    вернуть "строка " + стр(номер) + ": " + т
}

/// Место «:» ключа (за ним пробел или конец) вне кавычек и скобок или -1
функ место_двоеточия(т: стр) -> цел {
    пусть з = т.символы()
    если з.длина == 0 { вернуть -1 }
    перем к = 0
    если з[0] == "\"" или з[0] == "'" {
        // ключ в кавычках
        к = 1
        пока к < з.длина {
            если з[0] == "\"" и з[к] == "\\" {
                к += 2
                продолжить
            }
            если з[к] == з[0] {
                если з[0] == "'" и к + 1 < з.длина и з[к + 1] == "'" {
                    к += 2
                    продолжить
                }
                прервать
            }
            к += 1
        }
        к += 1
        если к < з.длина и з[к] == ":" и (к + 1 == з.длина или з[к + 1] == " ") { вернуть к }
        вернуть -1
    }
    если з[0] == "[" или з[0] == "{" { вернуть -1 }
    пока к < з.длина {
        если з[к] == ":" и (к + 1 == з.длина или з[к + 1] == " " или з[к + 1] == "\t") { вернуть к }
        к += 1
    }
    вернуть -1
}

функ элемент_списка(т: стр) -> лог {
    вернуть т == "-" или т.начинается("- ") или т.начинается("-\t")
}

/// Строка в кавычках YAML: "..." с записями \ или '...' с удвоенной ''
функ кавычки_yaml(т: стр, номер: цел) -> Итог! {
    пусть з = т.символы()
    пусть кавычка = з[0]
    перем ч: [стр] = []
    перем к = 1
    пока к < з.длина {
        пусть с = з[к]
        если кавычка == "'" {
            если с == "'" {
                если к + 1 < з.длина и з[к + 1] == "'" {
                    ч.добавить("'")
                    к += 2
                    продолжить
                }
                вернуть Итог(json.Строка(ч.соединить("")), к + 1)
            }
            ч.добавить(с)
            к += 1
            продолжить
        }
        если с == "\"" { вернуть Итог(json.Строка(ч.соединить("")), к + 1) }
        если с == "\\" и к + 1 < з.длина {
            пусть д = з[к + 1]
            если д == "n" { ч.добавить("\n") } иначе если д == "t" { ч.добавить("\t") }
            иначе если д == "r" { ч.добавить("\r") } иначе если д == "\"" { ч.добавить("\"") }
            иначе если д == "\\" { ч.добавить("\\") } иначе если д == "/" { ч.добавить("/") }
            иначе если д == "0" { вернуть ошибка(ошибка_yaml(номер, "знак с кодом 0 не может входить в строку")) }
            иначе если д == " " { ч.добавить(" ") }
            иначе если д == "u" или д == "x" или д == "U" {
                перем цифр = 4
                если д == "x" { цифр = 2 }
                если д == "U" { цифр = 8 }
                если пусть знак = знак_по_коду(з, к + 2, цифр) { ч.добавить(знак) } иначе ошибка о {
                    вернуть ошибка(ошибка_yaml(номер, "неверная запись \\" + д))
                }
                к += 2 + цифр
                продолжить
            } иначе {
                вернуть ошибка(ошибка_yaml(номер, "неизвестная запись \\" + д))
            }
            к += 2
            продолжить
        }
        ч.добавить(с)
        к += 1
    }
    вернуть ошибка(ошибка_yaml(номер, "строка в кавычках не закрыта"))
}

/// Простое значение YAML без кавычек: null, логическое, число или строка (схема YAML 1.2)
функ простое_yaml(т: стр, номер: цел) -> json.Значение! {
    если т == "" или т == "~" или т == "null" или т == "Null" или т == "NULL" { вернуть json.Пусто }
    если т == "true" или т == "True" или т == "TRUE" { вернуть json.Логическое(истина) }
    если т == "false" или т == "False" или т == "FALSE" { вернуть json.Логическое(ложь) }
    если т.начинается("&") или т.начинается("*") { вернуть ошибка(ошибка_yaml(номер, "ссылки & и * не поддерживаются")) }
    если т.начинается("!") { вернуть ошибка(ошибка_yaml(номер, "теги ! не поддерживаются")) }
    если т.начинается("@") или т.начинается("`") {
        вернуть ошибка(ошибка_yaml(номер, "значение не может начинаться с «" + т[0] + "»: возьмите его в кавычки"))
    }
    если десятичное(т) {
        если пусть ч = разобрать_цел(т.заменить("+", "")) { вернуть json.Целое(ч) } иначе ошибка о { вернуть json.Строка(т) }
    }
    если т.начинается("0x") или т.начинается("0o") {
        перем основание = 16
        если т.начинается("0o") { основание = 8 }
        если пусть ч = целое_по_основанию(т[2..т.длина - 1], основание) { вернуть json.Целое(ч) } иначе ошибка о {
            // не число по основанию: значение - строка
        }
    }
    если т == ".inf" или т == "+.inf" или т == ".Inf" или т == ".INF" { вернуть json.Число(1.0 / 0.0) }
    если т == "-.inf" или т == "-.Inf" или т == "-.INF" { вернуть json.Число(-1.0 / 0.0) }
    если т == ".nan" или т == ".NaN" или т == ".NAN" { вернуть json.Число(0.0 / 0.0) }
    если дробная(т, истина) {
        если пусть д = разобрать_дроб(т.заменить("+", "")) { вернуть json.Число(д) } иначе ошибка о {
            // не число: ниже - ошибка или строка
        }
    }
    вернуть json.Строка(т)
}

/// Значение в одну строку: в кавычках, [список], {словарь} или простое
функ строчное_yaml(т: стр, номер: цел) -> json.Значение! {
    если т.начинается("\"") или т.начинается("'") {
        пусть рз = кавычки_yaml(т, номер)!
        если рз.н < т.символы().длина {
            вернуть ошибка(ошибка_yaml(номер, "после строки в кавычках лишний текст «" + т[рз.н..т.длина - 1] + "»"))
        }
        вернуть рз.з
    }
    если т.начинается("[") или т.начинается("{") {
        пусть з = т.символы()
        пусть рз = поток_yaml(з, 0, номер)!
        перем к = рз.н
        пока к < з.длина и (з[к] == " " или з[к] == "\t") { к += 1 }
        если к < з.длина { вернуть ошибка(ошибка_yaml(номер, "лишний текст после «" + з[0] + "...»")) }
        вернуть рз.з
    }
    если т.начинается("|") или т.начинается(">") {
        вернуть ошибка(ошибка_yaml(номер, "блок «" + т[0] + "» должен начинаться на строке ключа или «-»"))
    }
    вернуть простое_yaml(т, номер)
}

/// Записи [а, б] и {а: 1, б: 2} (с вложенными)
функ поток_yaml(з: [стр], н: цел, номер: цел) -> Итог! {
    пусть открыта = з[н]
    перем закрыта = "]"
    если открыта == "{" { закрыта = "}" }
    перем к = н + 1
    перем элементы: [json.Значение] = []
    перем поля: {стр: json.Значение} = {}
    пока истина {
        пока к < з.длина и (з[к] == " " или з[к] == "\t") { к += 1 }
        если к >= з.длина { вернуть ошибка(ошибка_yaml(номер, "запись «" + открыта + "» не закрыта в той же строке")) }
        если з[к] == закрыта {
            если открыта == "[" { вернуть Итог(json.Массив(элементы), к + 1) }
            вернуть Итог(json.Объект(поля), к + 1)
        }
        // ключ (для словаря) или значение
        перем имя = ""
        если открыта == "{" {
            перем ч: [стр] = []
            если з[к] == "\"" или з[к] == "'" {
                пусть рз = кавычки_yaml(з[к..з.длина - 1].соединить(""), номер)!
                имя = рз.з.как_стр() иначе ""
                к += рз.н
            } иначе {
                пока к < з.длина и з[к] != ":" и з[к] != "," и з[к] != "}" {
                    ч.добавить(з[к])
                    к += 1
                }
                имя = ч.соединить("").обрезать()
            }
            пока к < з.длина и (з[к] == " " или з[к] == "\t") { к += 1 }
            если к >= з.длина или з[к] != ":" { вернуть ошибка(ошибка_yaml(номер, "в записи {...} после ключа нужно «:»")) }
            к += 1
            пока к < з.длина и (з[к] == " " или з[к] == "\t") { к += 1 }
            если поля.содержит(имя) { вернуть ошибка(ошибка_yaml(номер, "ключ «" + имя + "» уже задан")) }
        }
        перем значение = json.Пусто
        если к < з.длина и (з[к] == "[" или з[к] == "{") {
            пусть рз = поток_yaml(з, к, номер)!
            значение = рз.з
            к = рз.н
        } иначе если к < з.длина и (з[к] == "\"" или з[к] == "'") {
            пусть рз = кавычки_yaml(з[к..з.длина - 1].соединить(""), номер)!
            значение = рз.з
            к += рз.н
        } иначе {
            перем ч: [стр] = []
            пока к < з.длина и з[к] != "," и з[к] != закрыта {
                ч.добавить(з[к])
                к += 1
            }
            значение = простое_yaml(ч.соединить("").обрезать(), номер)!
        }
        если открыта == "[" { элементы.добавить(значение) } иначе { поля[имя] = значение }
        пока к < з.длина и (з[к] == " " или з[к] == "\t") { к += 1 }
        если к < з.длина и з[к] == "," { к += 1 } иначе если к < з.длина и з[к] != закрыта {
            вернуть ошибка(ошибка_yaml(номер, "в записи «" + открыта + "» ожидалась «,» или «" + закрыта + "»"))
        }
    }
    вернуть Итог(json.Пусто, к)
}

/// Блок | или > : строки с отступом больше родительского
функ блок_yaml(сырые: [стр], строки: [Строка], н: цел, отступ_родителя: цел, знак: стр) -> Итог! {
    // н - номер следующей содержательной строки; блок берётся из сырых строк файла
    перем вид = знак[0]
    перем хвост = "обрезать"            // одна \n в конце
    если знак.содержит("-") { хвост = "убрать" }
    если знак.содержит("+") { хвост = "оставить" }
    перем первая_сырая = 0
    если н > 0 { первая_сырая = строки[н - 1].номер }     // номер строки с ключом (с 1) = место следующей сырой
    перем отступ = -1
    перем ч: [стр] = []
    перем к = первая_сырая
    пока к < сырые.длина {
        пусть с = сырые[к]
        перем пробелов = 0
        пока пробелов < с.длина и с[пробелов] == " " { пробелов += 1 }
        если с.обрезать() == "" {
            ч.добавить("")
            к += 1
            продолжить
        }
        если пробелов <= отступ_родителя { прервать }
        если отступ < 0 { отступ = пробелов }
        если пробелов < отступ { прервать }
        ч.добавить(с[отступ..с.длина - 1])
        к += 1
    }
    // пустые строки в конце блока
    перем конец_пустых = 0
    пока ч.длина > 0 и ч[ч.длина - 1] == "" {
        ч.удалить(ч.длина - 1)
        конец_пустых += 1
    }
    перем текст = ""
    если вид == "|" {
        текст = ч.соединить("\n")
    } иначе {
        // > : строки одного абзаца соединяются пробелом, пустая строка - перевод строки
        перем части: [стр] = []
        перем предыдущая_пустая = истина
        для с в ч {
            если с == "" {
                части.добавить("\n")
                предыдущая_пустая = истина
            } иначе {
                если не предыдущая_пустая и (части.длина > 0) { части.добавить(" ") }
                части.добавить(с)
                предыдущая_пустая = ложь
            }
        }
        текст = части.соединить("")
    }
    если ч.длина > 0 {
        если хвост == "обрезать" { текст += "\n" }
        если хвост == "оставить" { текст += "\n" + "\n".повторить(конец_пустых) }
    }
    // следующая содержательная строка - первая, номер которой больше прочитанных
    перем следующая = н
    пока следующая < строки.длина и строки[следующая].номер <= к { следующая += 1 }
    вернуть Итог(json.Строка(текст), следующая)
}

/// Значение после «ключ:» или «-»: в той же строке или блоком ниже
функ после_метки(сырые: [стр], строки: [Строка], н: цел, остаток: стр, отступ: цел, номер: цел,
                  список_на_том_же: лог) -> Итог! {
    если остаток.начинается("|") или остаток.начинается(">") {
        пусть знак = остаток.обрезать()
        если знак.длина > 3 { вернуть ошибка(ошибка_yaml(номер, "после «" + знак[0] + "» допускаются только «-» или «+»")) }
        вернуть блок_yaml(сырые, строки, н, отступ, знак)
    }
    если остаток != "" { вернуть Итог(строчное_yaml(остаток, номер)!, н) }
    если н < строки.длина и строки[н].отступ > отступ { вернуть узел_yaml(сырые, строки, н, строки[н].отступ) }
    если список_на_том_же и н < строки.длина и строки[н].отступ == отступ и элемент_списка(строки[н].текст) {
        вернуть узел_yaml(сырые, строки, н, отступ)
    }
    вернуть Итог(json.Пусто, н)
}

функ узел_yaml(сырые: [стр], строки_: [Строка], н_: цел, отступ: цел) -> Итог! {
    перем строки = строки_
    перем н = н_
    пусть первая = строки[н]
    если элемент_списка(первая.текст) {
        перем элементы: [json.Значение] = []
        пока н < строки.длина и строки[н].отступ == отступ и элемент_списка(строки[н].текст) {
            пусть с = строки[н]
            перем остаток = ""
            если с.текст.длина > 1 { остаток = с.текст[2..с.текст.длина - 1].обрезать() }
            если остаток != "" и (место_двоеточия(остаток) >= 0 или элемент_списка(остаток)) {
                // «- ключ: значение»: словарь (или список), который начинается в этой строке
                пусть сдвиг = с.текст.длина - остаток.длина
                строки[н] = Строка(с.отступ + сдвиг, остаток, с.номер)
                пусть рз = узел_yaml(сырые, строки, н, с.отступ + сдвиг)!
                элементы.добавить(рз.з)
                строки[н] = с
                н = рз.н
            } иначе {
                пусть рз = после_метки(сырые, строки, н + 1, остаток, отступ, с.номер, ложь)!
                элементы.добавить(рз.з)
                н = рз.н
            }
        }
        если н < строки.длина и строки[н].отступ > отступ {
            вернуть ошибка(ошибка_yaml(строки[н].номер, "неверный отступ"))
        }
        вернуть Итог(json.Массив(элементы), н)
    }
    если место_двоеточия(первая.текст) < 0 {
        // одно значение (например, весь документ - строка)
        пусть з = строчное_yaml(первая.текст, первая.номер)!
        если н + 1 < строки.длина и строки[н + 1].отступ > отступ {
            вернуть ошибка(ошибка_yaml(строки[н + 1].номер, "неверный отступ или «:» после ключа без пробела"))
        }
        вернуть Итог(з, н + 1)
    }
    перем поля: {стр: json.Значение} = {}
    пока н < строки.длина и строки[н].отступ == отступ {
        пусть с = строки[н]
        если элемент_списка(с.текст) { вернуть ошибка(ошибка_yaml(с.номер, "элемент списка «-» среди ключей словаря")) }
        пусть д = место_двоеточия(с.текст)
        если д < 0 { вернуть ошибка(ошибка_yaml(с.номер, "ожидалось «ключ: значение»")) }
        перем имя = с.текст[0..д - 1].обрезать()
        если имя.начинается("\"") или имя.начинается("'") {
            имя = кавычки_yaml(имя, с.номер)!.з.как_стр() иначе ""
        } иначе если имя.начинается("?") {
            вернуть ошибка(ошибка_yaml(с.номер, "сложные ключи «?» не поддерживаются"))
        }
        если поля.содержит(имя) { вернуть ошибка(ошибка_yaml(с.номер, "ключ «" + имя + "» уже задан")) }
        перем остаток = ""
        если д + 1 < с.текст.длина { остаток = с.текст[д + 1..с.текст.длина - 1].обрезать() }
        пусть рз = после_метки(сырые, строки, н + 1, остаток, отступ, с.номер, истина)!
        поля[имя] = рз.з
        н = рз.н
    }
    если н < строки.длина и строки[н].отступ > отступ {
        вернуть ошибка(ошибка_yaml(строки[н].номер, "неверный отступ"))
    }
    вернуть Итог(json.Объект(поля), н)
}

/// Разобрать текст YAML (то, что пишут в файлах настроек)
общий функ yaml(текст: стр) -> json.Значение! {
    пусть сырые = текст.заменить("\r\n", "\n").разбить("\n")
    перем строки: [Строка] = []
    перем документ_начат = ложь
    для к в 0..сырые.длина - 1 {
        пусть с = сырые[к]
        перем пробелов = 0
        пока пробелов < с.длина и с[пробелов] == " " { пробелов += 1 }
        если пробелов < с.длина и с[пробелов] == "\t" {
            вернуть ошибка(ошибка_yaml(к + 1, "отступ табуляцией: в YAML отступы - только пробелы"))
        }
        пусть т = без_комментария(с)
        если т == "" { продолжить }
        если пробелов == 0 и (т == "---" или т.начинается("--- ")) {
            если документ_начат или строки.длина > 0 {
                вернуть ошибка(ошибка_yaml(к + 1, "несколько документов в одном файле не поддерживаются"))
            }
            документ_начат = истина
            если т != "---" {
                строки.добавить(Строка(4, т[4..т.длина - 1].обрезать(), к + 1))
            }
            продолжить
        }
        если пробелов == 0 и (т == "..." ) { прервать }
        если пробелов == 0 и т.начинается("%") { вернуть ошибка(ошибка_yaml(к + 1, "указания % не поддерживаются")) }
        строки.добавить(Строка(пробелов, т, к + 1))
    }
    если строки.длина == 0 { вернуть json.Пусто }
    пусть рз = узел_yaml(сырые, строки, 0, строки[0].отступ)!
    если рз.н < строки.длина { вернуть ошибка(ошибка_yaml(строки[рз.н].номер, "неверный отступ")) }
    вернуть рз.з
}
